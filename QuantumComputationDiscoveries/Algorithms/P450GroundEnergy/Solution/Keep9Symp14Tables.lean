/-- Boolean XOR of the first `n ≤ 153` shared symplectic steps on plane `k` at `(rcOpt, x)`. -/
def sp14StepXorBool (k : Fin 14) (rcOpt : Option (Fin 126)) (x : Fin (2 ^ 5)) :
    (n : ℕ) → n ≤ 153 → Bool
  | 0, _ => false
  | m + 1, hm =>
      let mFin : Fin 153 := ⟨m, hm⟩
      let prev := sp14StepXorBool k rcOpt x m (Nat.le_of_succ_le hm)
      if sp14StepW mFin k then
        let a := match rcOpt with
          | some rc => sp14StepA mFin rc
          | none => false
        let b := match rcOpt with
          | some rc => sp14StepB mFin rc
          | none => false
        let c := extCol24Bool (sp14StepC mFin) x
        let d := extCol24Bool (sp14StepD mFin) x
        xor prev (xor a c && xor b d)
      else prev

/-- Full `153`-step shared symplectic Boolean output for plane `k : Fin 14` on `(rcOpt, x)`. -/
def sp14EvalBool (k : Fin 14) (rcOpt : Option (Fin 126)) (x : Fin (2 ^ 5)) : Bool :=
  let rd := match rcOpt with
    | some rc => sp14RowDiag k rc
    | none => false
  let cd := extCol24Bool (sp14ColDiag k) x
  xor (xor rd cd) (sp14StepXorBool k rcOpt x 153 le_rfl)

/-- Bounded Boolean quantifier over `0 .. n - 1` for kernel certificate checks. -/
def allLt14Data : ℕ → (ℕ → Bool) → Bool
  | 0, _ => true
  | n + 1, f => f n && allLt14Data n f

theorem allLt14Data_spec {f : ℕ → Bool} :
    ∀ {n : ℕ}, allLt14Data n f = true → ∀ i, i < n → f i = true
  | 0, _, _, hi => absurd hi (Nat.not_lt_zero _)
  | n + 1, h, i, hi => by
      rw [allLt14Data, Bool.and_eq_true] at h
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | rfl
      · exact allLt14Data_spec h.2 i hlt
      · exact h.1

/-- Strict natural-number forcing combinator for kernel reduction. -/
def withForced14Nat {α : Type*} (n : ℕ) (k : ℕ → α) : α :=
  match n with
  | 0 => k 0
  | m + 1 => k (m + 1)

/-- Tail-recursive list forcing accumulator for kernel reduction. -/
def forceNatList14K {α : Type*} : List ℕ → List ℕ → (List ℕ → α) → α
  | [], acc, k => OuterWeights.revK acc [] k
  | x :: xs, acc, k => withForced14Nat x (fun y ↦ forceNatList14K xs (y :: acc) k)

/-- Strict `List ℕ` forcing combinator for kernel reduction. -/
def withForced14NatList {α : Type*} (xs : List ℕ) (k : List ℕ → α) : α :=
  forceNatList14K xs [] k

/-- Alternating-bit parity helper over `n` pairs (`v, v / 4, ...`). -/
def parStep4_14 : ℕ → ℕ → Bool → Bool
  | 0, _, acc => acc
  | n + 1, v, acc => parStep4_14 n (v / 4) (xor acc (v.testBit 0))

/-- Extend a `30`-bit column mask `m` to `32` bits with even/odd parities at bits `30, 31`. -/
def extMask32_14 (m : ℕ) : ℕ :=
  (m % 2 ^ 30) |||
    (cond (parStep4_14 15 m false) (2 ^ 30) 0) |||
    (cond (parStep4_14 15 (m / 2) false) (2 ^ 31) 0)

/-- Broadcast a Boolean across all `32` bits (`2^32 - 1` or `0`). -/
def bcast32_14 (b : Bool) : ℕ := cond b (2 ^ 32 - 1) 0

/-- Safe list lookup returning `0` out of bounds. -/
def nthZero14 : List ℕ → ℕ → ℕ
  | x :: _, 0 => x
  | _ :: xs, k + 1 => nthZero14 xs k
  | [], _ => 0

/-- Check that every step mask `w` has bit `p % 14` set. -/
def checkPivot14List : List ℕ → List ℕ → Bool
  | w :: ws, p :: ps => w.testBit (p % 14) && checkPivot14List ws ps
  | [], [] => true
  | _, _ => false

/-- Masked bitwise XOR of `t` into list entries selected by `w`. -/
def xorMask14List (w t : ℕ) : List ℕ → ℕ → List ℕ
  | [], _ => []
  | x :: xs, k => (if w.testBit k then x ^^^ t else x) :: xorMask14List w t xs (k + 1)

/-- Initialize `32`-bit plane accumulators for row `r`. -/
def initRowAccs32_14 (r : ℕ) : List ℕ → List ℕ → List ℕ
  | rd :: rds, cd32 :: cds =>
      withForced14Nat (bcast32_14 (rd.testBit r) ^^^ cd32) fun v ↦
        v :: initRowAccs32_14 r rds cds
  | _, _ => []

/-- Accumulate `153` symplectic outer-product steps across all `14` `32`-bit plane words at `r`. -/
def row32AllLoop_14 (r : ℕ) :
    List ℕ → List ℕ → List ℕ → List ℕ → List ℕ → List ℕ → List ℕ
  | accs, a :: as, b :: bs, c32 :: cs, d32 :: ds, w :: ws =>
      withForced14Nat ((bcast32_14 (a.testBit r) ^^^ c32) &&&
          (bcast32_14 (b.testBit r) ^^^ d32)) fun t ↦
        withForced14NatList (xorMask14List w t accs 0) fun accs' ↦
          row32AllLoop_14 r accs' as bs cs ds ws
  | accs, _, _, _, _, _ => accs

/-- Evaluate all `14` `32`-bit plane words for row `r`. -/
def evalAllPlanesRow32_14 (r : ℕ) : List ℕ :=
  row32AllLoop_14 r
    (initRowAccs32_14 r keep9RowDiagMasks.toList (keep9ColDiagMasks.toList.map extMask32_14))
    keep9StepAMasks.toList keep9StepBMasks.toList
    (keep9StepCMasks.toList.map extMask32_14) (keep9StepDMasks.toList.map extMask32_14)
    keep9StepWMasks.toList

/-- Accumulate `none` (`rc ∈ {126, 127}`, hot wires `= 0`) `32`-bit output for plane `k`. -/
def none32Loop_14 (k : ℕ) : ℕ → List ℕ → List ℕ → List ℕ → ℕ
  | acc, c32 :: cs, d32 :: ds, w :: ws =>
      withForced14Nat (if w.testBit k then acc ^^^ (c32 &&& d32) else acc) fun acc' ↦
        none32Loop_14 k acc' cs ds ws
  | acc, _, _, _ => acc

/-- Kernel row checker verifying `30` packed `(alt_5, keep_9)` entries, exact Walker-alias bin
weights, and `32`-bit parity extensions (`x = 30, 31`) across all `14` planes at row `r`. -/
def checkKeep9InnerRow (r : ℕ) (pRow : Array ℕ) : Bool :=
  OuterWeights.withForcedList pRow.toList fun pList ↦
  OuterWeights.withForcedList (OuterWeights.unpackAltPairs 32 30 512 pList 0) fun pairs ↦
  withForced14NatList (evalAllPlanesRow32_14 r) fun rowWords ↦
  Nat.beq pList.length 30 &&
  OuterWeights.allWithIdx (fun j raw ↦
    Nat.blt (raw % 32) 30 && Nat.blt raw 16384 &&
    RankReducedPrepMid.checkRowWordsAt j raw rowWords 0) pList 0 &&
  OuterWeights.allWithIdx (fun b raw ↦
    Nat.beq ((raw / 32) % 512 + OuterWeights.sumAltPairs b pairs)
      (OuterWeights.natAbsOffset (OuterWeights.innerWeightAt r b))) pList 0 &&
  allLt14Data 14 (fun k ↦
    Nat.beq (nthZero14 rowWords k) (extMask32_14 (nthZero14 rowWords k)))

