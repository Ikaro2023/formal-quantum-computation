theorem revK_eq_14data {α β : Type*} (xs acc : List α) (k : List α → β) :
    OuterWeights.revK xs acc k = k (xs.reverse ++ acc) := by
  induction xs generalizing acc with
  | nil => simp [OuterWeights.revK]
  | cons x xs ih => simp [OuterWeights.revK, ih, List.append_assoc]

theorem withForcedList_eq_14data {α β : Type*} (xs : List α) (k : List α → β) :
    OuterWeights.withForcedList xs k = k xs := by
  simp [OuterWeights.withForcedList, revK_eq_14data]

theorem withForced14Nat_eq {α : Type*} (n : ℕ) (k : ℕ → α) :
    withForced14Nat n k = k n := by
  cases n <;> rfl

theorem forceNatList14K_eq {α : Type*} :
    ∀ (xs acc : List ℕ) (k : List ℕ → α),
      forceNatList14K xs acc k = k (acc.reverse ++ xs)
  | [], acc, k => by simp [forceNatList14K, revK_eq_14data]
  | x :: xs, acc, k => by
      simp [forceNatList14K, withForced14Nat_eq, forceNatList14K_eq xs (x :: acc),
        List.append_assoc]

theorem withForced14NatList_eq {α : Type*} (xs : List ℕ) (k : List ℕ → α) :
    withForced14NatList xs k = k xs := by
  simp [withForced14NatList, forceNatList14K_eq]

theorem array_toList_drop_succ_14 (arr : Array ℕ) {i : ℕ} (hi : i < arr.size) :
    arr.toList.drop i = arr.getD i 0 :: arr.toList.drop (i + 1) := by
  have hiL : i < arr.toList.length := hi
  rw [List.drop_eq_getElem_cons hiL]
  simp [Array.getD, hi]

theorem nthZero14_eq_drop_zero :
    ∀ (xs : List ℕ) (k : ℕ), nthZero14 xs k = nthZero14 (xs.drop k) 0
  | [], _ => by simp [nthZero14]
  | _ :: _, 0 => rfl
  | _ :: xs, k + 1 => nthZero14_eq_drop_zero xs k

theorem nthZero14_toList (arr : Array ℕ) {k : ℕ} (hk : k < arr.size) :
    nthZero14 arr.toList k = arr.getD k 0 := by
  rw [nthZero14_eq_drop_zero, array_toList_drop_succ_14 arr hk]
  rfl

theorem nthZero14_map (f : ℕ → ℕ) :
    ∀ (xs : List ℕ) {k : ℕ}, k < xs.length → nthZero14 (xs.map f) k = f (nthZero14 xs k)
  | [], _, hk => absurd hk (Nat.not_lt_zero _)
  | _ :: _, 0, _ => rfl
  | _ :: xs, _ + 1, hk => nthZero14_map f xs (Nat.lt_of_succ_lt_succ hk)

theorem nthZero14_ofFn :
    ∀ {n : ℕ} (f : Fin n → ℕ) (k : Fin n), nthZero14 (List.ofFn f) k.val = f k
  | 0, _, k => Fin.elim0 k
  | _ + 1, f, k => by
      rw [List.ofFn_succ]
      refine Fin.cases rfl (fun k' ↦ nthZero14_ofFn (fun i ↦ f i.succ) k') k

/-- Folded XOR range helper `f off ^^^ ... ^^^ f (off + m - 1)`. -/
def foldRangeXor14 (f : ℕ → ℕ) (off : ℕ) : ℕ → ℕ
  | 0 => 0
  | m + 1 => foldRangeXor14 f off m ^^^ f (off + m)

theorem foldRangeXor14_succ_left (f : ℕ → ℕ) (off : ℕ) :
    ∀ m : ℕ, foldRangeXor14 f off (m + 1) = f off ^^^ foldRangeXor14 f (off + 1) m
  | 0 => by simp [foldRangeXor14]
  | m + 1 => by
      rw [foldRangeXor14, foldRangeXor14_succ_left f off m, Nat.xor_assoc,
        show off + (m + 1) = off + 1 + m by omega]
      rfl

theorem testBit_bcast32_14 (a : Bool) (x : Fin (2 ^ 5)) :
    (bcast32_14 a).testBit x.val = a := by
  cases a
  · exact Nat.zero_testBit x.val
  · change (2 ^ 32 - 1).testBit x.val = true
    rw [Nat.testBit_two_pow_sub_one, decide_eq_true (show x.val < 32 from x.isLt)]

theorem sumAltPairs_unpackInner_14 (b : ℕ) (xs : List ℕ) (j : ℕ) :
    OuterWeights.sumAltPairs b (OuterWeights.unpackAltPairs 32 30 512 xs j) =
      OuterWeights.sumWithIdx (OuterWeights.innerAltTerm b) xs j := by
  induction xs generalizing j with
  | nil => rfl
  | cons raw rest ih =>
    simp only [OuterWeights.unpackAltPairs, OuterWeights.sumAltPairs, OuterWeights.sumWithIdx,
      ih, OuterWeights.innerAltTerm]
    cases Nat.beq (cond (Nat.blt (raw % 32) 30) (raw % 32) j) b <;> simp

theorem cond_blt_14 {α : Type*} (x y : ℕ) (t e : α) :
    cond (Nat.blt x y) t e = if x < y then t else e := by
  by_cases h : x < y
  · rw [show Nat.blt x y = true from Nat.blt_eq.mpr h]
    simp [h]
  · rw [show Nat.blt x y = false from Bool.eq_false_iff.mpr (mt Nat.blt_eq.mp h)]
    simp [h]

theorem cond_beq_14 {α : Type*} (x y : ℕ) (t e : α) :
    cond (Nat.beq x y) t e = if x = y then t else e := by
  by_cases h : x = y
  · simp [h]
  · rw [show Nat.beq x y = false from Bool.eq_false_iff.mpr (mt Nat.beq_eq.mp h)]
    simp [h]

theorem keep9InnerAliasTable_bin_sum (rc : Fin 126) (b : Fin 30) :
    (∑ j : Fin 30, if j = b then (keep9InnerAliasTable rc j).keep else 0) +
      (∑ j : Fin 30,
        if (keep9InnerAliasTable rc j).alt = b then 512 - (keep9InnerAliasTable rc j).keep
        else 0) =
      OuterWeights.innerTargetWeight rc b := by
  have hrow := checkKeep9InnerRow_of_rc rc
  unfold checkKeep9InnerRow at hrow
  simp only [withForcedList_eq_14data, withForced14NatList_eq, Array.length_toList,
    Bool.and_eq_true, Nat.beq_eq] at hrow
  obtain ⟨⟨⟨hsz, _⟩, hbin⟩, _⟩ := hrow
  set pRow := keep9InnerAliasPacked.getD rc.val #[]
  have hb : b.val < pRow.size := by
    rw [hsz]
    exact b.isLt
  have h := OuterWeights.allWithIdx_array_getD hbin hb 0
  simp only [Nat.beq_eq, sumAltPairs_unpackInner_14, OuterWeights.natAbsOffset_eq,
    OuterWeights.innerWeightAt] at h
  have h1 : (∑ j : Fin 30, if j = b then (keep9InnerAliasTable rc j).keep else 0) =
      ((pRow.getD b.val 0) / 32) % 512 := by
    simp [Finset.sum_ite_eq', keep9InnerAliasTable, AliasTableEngine.unpackPackedEntry, pRow]
  have h2 : OuterWeights.sumWithIdx (OuterWeights.innerAltTerm b.val) pRow.toList 0 =
      ∑ j : Fin 30,
        if (keep9InnerAliasTable rc j).alt = b then 512 - (keep9InnerAliasTable rc j).keep
        else 0 := by
    rw [OuterWeights.sumWithIdx_array_eq_fin_sum (OuterWeights.innerAltTerm b.val) pRow 0 hsz]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    simp only [OuterWeights.innerAltTerm, cond_blt_14, cond_beq_14, keep9InnerAliasTable,
      Fin.ext_iff, AliasTableEngine.unpackPackedEntry_alt_val, pRow]
    unfold AliasTableEngine.unpackPackedEntry
    simp
  rw [h1, ← h2]
  exact h

theorem isValidAliasTableKeep9InnerAliasTable (rc : Fin 126) :
    CoherentAlias.IsValidAliasTable 30 9 (OuterWeights.innerTargetWeight rc)
      (fun x ↦ (keep9InnerAliasTable rc x).alt)
      (fun x ↦ (keep9InnerAliasTable rc x).keep) := by
  refine ⟨fun x ↦ Nat.le_of_lt (keep9InnerAliasTable_keep_lt rc x), fun i ↦ ?_⟩
  rw [Finset.sum_add_distrib]
  exact keep9InnerAliasTable_bin_sum rc i

theorem isValidAliasTableKeep9InnerAliasTable_mantissa (rc : Fin 126) :
    CoherentAlias.IsValidAliasTable 30 9 (fun b ↦ (innerMantissaFlat rc b).natAbs)
      (fun x ↦ (keep9InnerAliasTable rc x).alt)
      (fun x ↦ (keep9InnerAliasTable rc x).keep) := by
  have hw : (fun b ↦ (innerMantissaFlat rc b).natAbs) = OuterWeights.innerTargetWeight rc :=
    funext fun b ↦ (RankReducedPrepMid.innerTargetWeight_eq_innerMantissaFlat_natAbs rc b).symm
  rw [hw]
  exact isValidAliasTableKeep9InnerAliasTable rc

theorem parStep4_14_even_eq (m : ℕ) :
    ∀ (rem k : ℕ) (hk : k + rem = 15),
      parStep4_14 rem (m / 2 ^ (2 * k))
          (evenColParityPrefix (fun y ↦ m.testBit y.val) k (by omega)) =
        evenColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl
  | 0, k, hk => by
      have hk15 : k = 15 := by omega
      subst hk15
      rfl
  | rem + 1, k, hk => by
      dsimp only [parStep4_14]
      have h0 : (m / 2 ^ (2 * k)).testBit 0 = m.testBit (2 * k) := by
        rw [← Nat.shiftRight_eq_div_pow, Nat.testBit_shiftRight, Nat.add_zero]
      have hdiv : (m / 2 ^ (2 * k)) / 4 = m / 2 ^ (2 * (k + 1)) := by
        rw [Nat.div_div_eq_div_mul, show (4 : ℕ) = 2 ^ 2 from rfl, ← pow_add,
          show 2 * k + 2 = 2 * (k + 1) by omega]
      have hstep : xor (evenColParityPrefix (fun y ↦ m.testBit y.val) k (by omega))
          (m.testBit (2 * k)) =
          evenColParityPrefix (fun y ↦ m.testBit y.val) (k + 1) (by omega) := rfl
      rw [h0, hdiv, hstep]
      exact parStep4_14_even_eq m rem (k + 1) (by omega)

theorem parStep4_14_odd_eq (m : ℕ) :
    ∀ (rem k : ℕ) (hk : k + rem = 15),
      parStep4_14 rem (m / 2 ^ (2 * k + 1))
          (oddColParityPrefix (fun y ↦ m.testBit y.val) k (by omega)) =
        oddColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl
  | 0, k, hk => by
      have hk15 : k = 15 := by omega
      subst hk15
      rfl
  | rem + 1, k, hk => by
      dsimp only [parStep4_14]
      have h0 : (m / 2 ^ (2 * k + 1)).testBit 0 = m.testBit (2 * k + 1) := by
        rw [← Nat.shiftRight_eq_div_pow, Nat.testBit_shiftRight, Nat.add_zero]
      have hdiv : (m / 2 ^ (2 * k + 1)) / 4 = m / 2 ^ (2 * (k + 1) + 1) := by
        rw [Nat.div_div_eq_div_mul, show (4 : ℕ) = 2 ^ 2 from rfl, ← pow_add,
          show (2 * k + 1) + 2 = 2 * (k + 1) + 1 by omega]
      have hstep : xor (oddColParityPrefix (fun y ↦ m.testBit y.val) k (by omega))
          (m.testBit (2 * k + 1)) =
          oddColParityPrefix (fun y ↦ m.testBit y.val) (k + 1) (by omega) := rfl
      rw [h0, hdiv, hstep]
      exact parStep4_14_odd_eq m rem (k + 1) (by omega)

theorem testBit_cond_two_pow_lt_14 {b : Bool} {p i : ℕ} (hi : i < p) :
    (cond b (2 ^ p) 0).testBit i = false := by
  cases b
  · exact Nat.zero_testBit i
  · dsimp only [cond]
    rw [Nat.testBit_two_pow]
    exact decide_eq_false (by omega)

theorem testBit_extMask32_14 (m : ℕ) (x : Fin (2 ^ 5)) :
    (extMask32_14 m).testBit x.val = extCol24Bool (fun y ↦ m.testBit y.val) x := by
  have hev : parStep4_14 15 m false =
      evenColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl := by
    simpa only [Nat.mul_zero, pow_zero, Nat.div_one, evenColParityPrefix] using
      parStep4_14_even_eq m 15 0 rfl
  have hod : parStep4_14 15 (m / 2) false =
      oddColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl := by
    simpa only [Nat.mul_zero, Nat.zero_add, pow_one, oddColParityPrefix] using
      parStep4_14_odd_eq m 15 0 rfl
  dsimp only [extMask32_14, extCol24Bool, evenColParity30, oddColParity30]
  rw [hev, hod, Nat.testBit_or, Nat.testBit_or, Nat.testBit_mod_two_pow]
  split_ifs with hx h30
  · rw [decide_eq_true hx, Bool.true_and, testBit_cond_two_pow_lt_14 hx,
      testBit_cond_two_pow_lt_14 (show x.val < 31 by omega), Bool.or_false, Bool.or_false]
  · rw [h30, decide_eq_false (by decide : ¬ 30 < 30), Bool.false_and, Bool.false_or]
    cases evenColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl <;>
      cases oddColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl <;> decide
  · have h31 : x.val = 31 := by
      have := x.isLt
      omega
    rw [h31, decide_eq_false (by decide : ¬ 31 < 30), Bool.false_and, Bool.false_or]
    cases evenColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl <;>
      cases oddColParityPrefix (fun y ↦ m.testBit y.val) 15 le_rfl <;> decide

theorem xorMask14List_ofFn (w t : ℕ) :
    ∀ {n : ℕ} (f : Fin n → ℕ) (p : ℕ),
      xorMask14List w t (List.ofFn f) p =
        List.ofFn (fun i : Fin n ↦ if w.testBit (p + i.val) then f i ^^^ t else f i)
  | 0, _, _ => rfl
  | _ + 1, f, p => by
      rw [List.ofFn_succ, xorMask14List, xorMask14List_ofFn w t (fun i ↦ f i.succ) (p + 1),
        List.ofFn_succ]
      refine congrArg₂ List.cons (by simp) (congrArg List.ofFn (funext fun i ↦ ?_))
      dsimp only [Fin.val_succ]
      rw [show p + 1 + i.val = p + (i.val + 1) by omega]

/-- Single `32`-bit step term for row `r`, plane `k`, and step `idx`. -/
def row32StepTerm_14 (r : ℕ) (k : Fin 14) (idx : ℕ) : ℕ :=
  if (keep9StepWMasks.getD idx 0).testBit k.val then
    (bcast32_14 ((keep9StepAMasks.getD idx 0).testBit r) ^^^
        extMask32_14 (keep9StepCMasks.getD idx 0)) &&&
      (bcast32_14 ((keep9StepBMasks.getD idx 0).testBit r) ^^^
        extMask32_14 (keep9StepDMasks.getD idx 0))
  else 0

/-- Full `32`-bit evaluated plane word at row `r` and plane `k : Fin 14`. -/
def evalRow32AtNat_14 (r : ℕ) (k : Fin 14) : ℕ :=
  bcast32_14 ((keep9RowDiagMasks.getD k.val 0).testBit r) ^^^
    extMask32_14 (keep9ColDiagMasks.getD k.val 0) ^^^
    foldRangeXor14 (row32StepTerm_14 r k) 0 153

/-- Single `32`-bit `none` step term (`rc ∈ {126, 127}`) at plane `k` and step `idx`. -/
def none32StepTerm_14 (k : Fin 14) (idx : ℕ) : ℕ :=
  if (keep9StepWMasks.getD idx 0).testBit k.val then
    extMask32_14 (keep9StepCMasks.getD idx 0) &&& extMask32_14 (keep9StepDMasks.getD idx 0)
  else 0

theorem initRowAccs32_14_eq_ofFn (r : ℕ) :
    ∀ (n p : ℕ), p + n = 14 →
      initRowAccs32_14 r (keep9RowDiagMasks.toList.drop p)
        ((keep9ColDiagMasks.toList.drop p).map extMask32_14) =
      List.ofFn (fun i : Fin n ↦
        bcast32_14 ((keep9RowDiagMasks.getD (p + i.val) 0).testBit r) ^^^
          extMask32_14 (keep9ColDiagMasks.getD (p + i.val) 0))
  | 0, p, hp => by
      have hp14 : p = 14 := by omega
      subst hp14
      have hrd : keep9RowDiagMasks.toList.length = 14 := keep9RowDiagMasks_size
      rw [List.drop_eq_nil_of_le (by omega)]
      rfl
  | n + 1, p, hp => by
      have hlt : p < 14 := by omega
      rw [array_toList_drop_succ_14 keep9RowDiagMasks
          (lt_of_lt_of_eq hlt keep9RowDiagMasks_size.symm),
        array_toList_drop_succ_14 keep9ColDiagMasks
          (lt_of_lt_of_eq hlt keep9ColDiagMasks_size.symm), List.map_cons]
      dsimp only [initRowAccs32_14]
      rw [withForced14Nat_eq, initRowAccs32_14_eq_ofFn r n (p + 1) (by omega), List.ofFn_succ]
      refine congrArg₂ List.cons (by simp) (congrArg List.ofFn (funext fun i ↦ ?_))
      dsimp only [Fin.val_succ]
      rw [show p + 1 + i.val = p + (i.val + 1) by omega]

theorem row32AllLoop_14_eq (r : ℕ) :
    ∀ (cnt off : ℕ) (f : Fin 14 → ℕ), off + cnt = 153 →
      row32AllLoop_14 r (List.ofFn f)
        (keep9StepAMasks.toList.drop off) (keep9StepBMasks.toList.drop off)
        ((keep9StepCMasks.toList.drop off).map extMask32_14)
        ((keep9StepDMasks.toList.drop off).map extMask32_14)
        (keep9StepWMasks.toList.drop off) =
      List.ofFn (fun k : Fin 14 ↦ f k ^^^ foldRangeXor14 (row32StepTerm_14 r k) off cnt)
  | 0, off, f, hob => by
      have hoff : off = 153 := by omega
      subst hoff
      have ha : keep9StepAMasks.toList.length = 153 := keep9StepAMasks_size
      rw [List.drop_eq_nil_of_le (by omega)]
      dsimp only [row32AllLoop_14, foldRangeXor14]
      simp only [Nat.xor_zero]
  | m + 1, off, f, hob => by
      have hlt : off < 153 := by omega
      rw [array_toList_drop_succ_14 keep9StepAMasks
          (lt_of_lt_of_eq hlt keep9StepAMasks_size.symm),
        array_toList_drop_succ_14 keep9StepBMasks
          (lt_of_lt_of_eq hlt keep9StepBMasks_size.symm),
        array_toList_drop_succ_14 keep9StepCMasks
          (lt_of_lt_of_eq hlt keep9StepCMasks_size.symm),
        array_toList_drop_succ_14 keep9StepDMasks
          (lt_of_lt_of_eq hlt keep9StepDMasks_size.symm),
        array_toList_drop_succ_14 keep9StepWMasks
          (lt_of_lt_of_eq hlt keep9StepWMasks_size.symm),
        List.map_cons, List.map_cons]
      dsimp only [row32AllLoop_14]
      rw [withForced14Nat_eq, withForced14NatList_eq, xorMask14List_ofFn]
      have hacc : (fun k : Fin 14 ↦
          if (keep9StepWMasks.getD off 0).testBit (0 + k.val) then
            f k ^^^ ((bcast32_14 ((keep9StepAMasks.getD off 0).testBit r) ^^^
                extMask32_14 (keep9StepCMasks.getD off 0)) &&&
              (bcast32_14 ((keep9StepBMasks.getD off 0).testBit r) ^^^
                extMask32_14 (keep9StepDMasks.getD off 0)))
          else f k) = (fun k : Fin 14 ↦ f k ^^^ row32StepTerm_14 r k off) := by
        funext k
        rw [Nat.zero_add]
        dsimp only [row32StepTerm_14]
        split_ifs <;> simp
      rw [hacc, row32AllLoop_14_eq r m (off + 1) _ (by omega)]
      congr 1
      funext k
      rw [Nat.xor_assoc, ← foldRangeXor14_succ_left]

theorem evalAllPlanesRow32_14_eq_ofFn (r : ℕ) :
    evalAllPlanesRow32_14 r = List.ofFn (evalRow32AtNat_14 r) := by
  have hinit : initRowAccs32_14 r keep9RowDiagMasks.toList
      (keep9ColDiagMasks.toList.map extMask32_14) =
      List.ofFn (fun i : Fin 14 ↦
        bcast32_14 ((keep9RowDiagMasks.getD i.val 0).testBit r) ^^^
          extMask32_14 (keep9ColDiagMasks.getD i.val 0)) := by
    simpa only [List.drop_zero, Nat.zero_add] using initRowAccs32_14_eq_ofFn r 14 0 rfl
  have hloop := row32AllLoop_14_eq r 153 0
    (fun i : Fin 14 ↦
      bcast32_14 ((keep9RowDiagMasks.getD i.val 0).testBit r) ^^^
        extMask32_14 (keep9ColDiagMasks.getD i.val 0)) rfl
  simp only [List.drop_zero] at hloop
  dsimp only [evalAllPlanesRow32_14]
  rw [hinit, hloop]
  rfl

theorem none32Loop_14_eq (k : Fin 14) :
    ∀ (cnt off acc : ℕ), off + cnt = 153 →
      none32Loop_14 k.val acc
        ((keep9StepCMasks.toList.drop off).map extMask32_14)
        ((keep9StepDMasks.toList.drop off).map extMask32_14)
        (keep9StepWMasks.toList.drop off) =
      acc ^^^ foldRangeXor14 (none32StepTerm_14 k) off cnt
  | 0, off, acc, hob => by
      have hoff : off = 153 := by omega
      subst hoff
      have hc : keep9StepCMasks.toList.length = 153 := keep9StepCMasks_size
      rw [List.drop_eq_nil_of_le (by omega), foldRangeXor14, Nat.xor_zero]
      rfl
  | m + 1, off, acc, hob => by
      have hlt : off < 153 := by omega
      rw [array_toList_drop_succ_14 keep9StepCMasks
          (lt_of_lt_of_eq hlt keep9StepCMasks_size.symm),
        array_toList_drop_succ_14 keep9StepDMasks
          (lt_of_lt_of_eq hlt keep9StepDMasks_size.symm),
        array_toList_drop_succ_14 keep9StepWMasks
          (lt_of_lt_of_eq hlt keep9StepWMasks_size.symm),
        List.map_cons, List.map_cons]
      dsimp only [none32Loop_14]
      rw [withForced14Nat_eq]
      have hacc : (if (keep9StepWMasks.getD off 0).testBit k.val then
          acc ^^^ (extMask32_14 (keep9StepCMasks.getD off 0) &&&
            extMask32_14 (keep9StepDMasks.getD off 0))
          else acc) = acc ^^^ none32StepTerm_14 k off := by
        dsimp only [none32StepTerm_14]
        split_ifs <;> simp
      rw [hacc, none32Loop_14_eq k m (off + 1) _ (by omega),
        Nat.xor_assoc, ← foldRangeXor14_succ_left]

theorem testBit_foldRangeXor14Row32 (rc : Fin 126) (k : Fin 14) (x : Fin (2 ^ 5)) :
    ∀ (m : ℕ) (hm : m ≤ 153),
      (foldRangeXor14 (row32StepTerm_14 rc.val k) 0 m).testBit x.val =
        sp14StepXorBool k (some rc) x m hm
  | 0, _ => Nat.zero_testBit x.val
  | m + 1, hm => by
      rw [foldRangeXor14, Nat.zero_add, Nat.testBit_xor,
        testBit_foldRangeXor14Row32 rc k x m (Nat.le_of_succ_le hm)]
      dsimp only [row32StepTerm_14, sp14StepXorBool]
      rw [show (keep9StepWMasks.getD m 0).testBit k.val = sp14StepW ⟨m, hm⟩ k from rfl]
      cases sp14StepW ⟨m, hm⟩ k
      · simp [Nat.zero_testBit]
      · unfold sp14StepA sp14StepB sp14StepC sp14StepD
        simp [Nat.testBit_and, Nat.testBit_xor, testBit_bcast32_14, testBit_extMask32_14]

theorem testBitEvalRow32AtNat_14 (rc : Fin 126) (k : Fin 14) (x : Fin (2 ^ 5)) :
    (evalRow32AtNat_14 rc.val k).testBit x.val = sp14EvalBool k (some rc) x := by
  dsimp only [evalRow32AtNat_14, sp14EvalBool]
  unfold sp14RowDiag sp14ColDiag
  rw [Nat.testBit_xor, Nat.testBit_xor, testBit_bcast32_14, testBit_extMask32_14,
    testBit_foldRangeXor14Row32]

theorem testBit_foldRangeXor14None32 (k : Fin 14) (x : Fin (2 ^ 5)) :
    ∀ (m : ℕ) (hm : m ≤ 153),
      (foldRangeXor14 (none32StepTerm_14 k) 0 m).testBit x.val =
        sp14StepXorBool k none x m hm
  | 0, _ => Nat.zero_testBit x.val
  | m + 1, hm => by
      rw [foldRangeXor14, Nat.zero_add, Nat.testBit_xor,
        testBit_foldRangeXor14None32 k x m (Nat.le_of_succ_le hm)]
      dsimp only [none32StepTerm_14, sp14StepXorBool]
      rw [show (keep9StepWMasks.getD m 0).testBit k.val = sp14StepW ⟨m, hm⟩ k from rfl]
      cases sp14StepW ⟨m, hm⟩ k
      · simp [Nat.zero_testBit]
      · unfold sp14StepC sp14StepD
        simp [Nat.testBit_and, testBit_extMask32_14]

theorem checkRowWordsAt_ofFn_14 {j raw : ℕ} :
    ∀ {n : ℕ} (f : Fin n → ℕ) (off : ℕ),
      RankReducedPrepMid.checkRowWordsAt j raw (List.ofFn f) off = true →
      ∀ i : Fin n, raw.testBit (off + i.val) = (f i).testBit j
  | 0, _, _, _, i => Fin.elim0 i
  | _ + 1, f, off, h, i => by
      rw [List.ofFn_succ, RankReducedPrepMid.checkRowWordsAt, Bool.and_eq_true, beq_iff_eq] at h
      refine Fin.cases ?_ (fun i' ↦ ?_) i
      · simpa only [Fin.val_zero, Nat.add_zero] using h.1
      · have hrec := checkRowWordsAt_ofFn_14 (fun t ↦ f t.succ) (off + 1) h.2 i'
        have hidx : off + 1 + i'.val = off + i'.succ.val := by
          dsimp
          omega
        rwa [hidx] at hrec

theorem sp14EvalRow32_lt30_eq (k : Fin 14) (rc : Fin 126) (j : Fin 30) :
    (evalRow32AtNat_14 rc.val k).testBit j.val = keep9InnerAliasBits rc j k := by
  have hrow := checkKeep9InnerRow_of_rc rc
  unfold checkKeep9InnerRow at hrow
  simp only [withForcedList_eq_14data, withForced14NatList_eq, Array.length_toList,
    Bool.and_eq_true, Nat.beq_eq] at hrow
  obtain ⟨⟨⟨hsz, hall⟩, _⟩, _⟩ := hrow
  set pRow := keep9InnerAliasPacked.getD rc.val #[]
  have hj : j.val < pRow.size := by
    rw [hsz]
    exact j.isLt
  have h := OuterWeights.allWithIdx_array_getD hall hj 0
  simp only [Bool.and_eq_true, Nat.blt_eq] at h
  obtain ⟨⟨hmod, _⟩, hbits⟩ := h
  set raw := pRow.getD j.val 0
  have hmod5 : raw % 2 ^ 5 < 30 := hmod
  rw [evalAllPlanesRow32_14_eq_ofFn] at hbits
  have hraw := checkRowWordsAt_ofFn_14 (evalRow32AtNat_14 rc.val) 0 hbits k
  rw [Nat.zero_add] at hraw
  rw [← hraw]
  symm
  dsimp only [keep9InnerAliasBits, keep9InnerAliasTable]
  by_cases hk5 : k.val < 5
  · simp only [hk5, ↓reduceIte, AliasTableEngine.unpackPackedEntry_alt_val]
    change (if raw % 2 ^ 5 < 30 then raw % 2 ^ 5 else j.val).testBit k.val = raw.testBit k.val
    rw [ite_eq_left hmod5, Nat.testBit_mod_two_pow, decide_eq_true hk5,
      Bool.true_and]
  · simp only [hk5, ↓reduceIte]
    change ((raw / 2 ^ 5) % 2 ^ 9).testBit (k.val - 5) = raw.testBit k.val
    have hsub : k.val - 5 < 9 := by omega
    rw [Nat.testBit_mod_two_pow, decide_eq_true hsub, Bool.true_and,
      ← Nat.shiftRight_eq_div_pow, Nat.testBit_shiftRight, show 5 + (k.val - 5) = k.val by omega]

theorem sp14EvalBool_some_eq (k : Fin 14) (rc : Fin 126) (x : Fin (2 ^ 5)) :
    sp14EvalBool k (some rc) x = extCol24Bool (fun y ↦ keep9InnerAliasBits rc y k) x := by
  have hrow := checkKeep9InnerRow_of_rc rc
  unfold checkKeep9InnerRow at hrow
  simp only [withForcedList_eq_14data, withForced14NatList_eq, Array.length_toList,
    Bool.and_eq_true, Nat.beq_eq] at hrow
  obtain ⟨_, hparAll⟩ := hrow
  have hpar := allLt14Data_spec hparAll k.val k.isLt
  rw [Nat.beq_eq, evalAllPlanesRow32_14_eq_ofFn, nthZero14_ofFn] at hpar
  rw [← testBitEvalRow32AtNat_14, hpar, testBit_extMask32_14]
  exact congrFun (congrArg extCol24Bool (funext fun y ↦ sp14EvalRow32_lt30_eq k rc y)) x

theorem sp14EvalBool_none_eq (k : Fin 14) (x : Fin (2 ^ 5)) :
    sp14EvalBool k none x = false := by
  have hok := checkNone14_ok
  rw [withForced14NatList_eq, withForced14NatList_eq, withForced14NatList_eq,
    withForced14NatList_eq] at hok
  have hk := allLt14Data_spec hok k.val k.isLt
  rw [Nat.beq_eq] at hk
  have hcdLen : k.val < keep9ColDiagMasks.toList.length :=
    lt_of_lt_of_eq k.isLt keep9ColDiagMasks_size.symm
  have hcdSz : k.val < keep9ColDiagMasks.size :=
    lt_of_lt_of_eq k.isLt keep9ColDiagMasks_size.symm
  have hcd : nthZero14 (keep9ColDiagMasks.toList.map extMask32_14) k.val =
      extMask32_14 (keep9ColDiagMasks.getD k.val 0) :=
    (nthZero14_map extMask32_14 keep9ColDiagMasks.toList hcdLen).trans
      (congrArg extMask32_14 (nthZero14_toList keep9ColDiagMasks hcdSz))
  rw [hcd] at hk
  have hloop := none32Loop_14_eq k 153 0 (extMask32_14 (keep9ColDiagMasks.getD k.val 0)) rfl
  simp only [List.drop_zero] at hloop
  rw [hloop] at hk
  have hbit := congrArg (fun n ↦ n.testBit x.val) hk
  rw [Nat.testBit_xor, testBit_extMask32_14, testBit_foldRangeXor14None32 k x 153 le_rfl,
    Nat.zero_testBit] at hbit
  unfold sp14EvalBool sp14ColDiag
  dsimp only
  rw [Bool.false_xor]
  exact hbit

theorem sp14EvalBool_eqKeep9Hot24BoolTable (k : Fin 14) (rc : Fin 128) (x : Fin (2 ^ 5)) :
    sp14EvalBool k (if h : rc.val < 126 then some ⟨rc.val, h⟩ else none) x =
      keep9Hot24BoolTable rc x k := by
  by_cases h : rc.val < 126
  · simp only [h, ↓reduceDIte, keep9Hot24BoolTable]
    exact sp14EvalBool_some_eq k ⟨rc.val, h⟩ x
  · simp only [h, ↓reduceDIte, keep9Hot24BoolTable]
    exact sp14EvalBool_none_eq k x

/-- Parametric `R`-step `14`-plane shared symplectic `GF(2)` QROM certificate (`126` active rows
`rc` × `30` columns `b`, `4 * R` `T` shared Toffoli core). -/
structure Symp14Spec (R : ℕ) where
  rowDiag : Fin 14 → Fin 126 → Bool
  colDiag : Fin 14 → Fin 30 → Bool
  stepA : Fin R → Fin 126 → Bool
  stepB : Fin R → Fin 126 → Bool
  stepC : Fin R → Fin 30 → Bool
  stepD : Fin R → Fin 30 → Bool
  stepW : Fin R → Fin 14 → Bool
  stepPivot : Fin R → Fin 14
  stepW_pivot : ∀ m : Fin R, stepW m (stepPivot m) = true

/-- Boolean XOR of the first `n ≤ R` shared symplectic steps of `S : Symp14Spec R` on plane `k`. -/
def Symp14Spec.stepXorBool {R : ℕ} (S : Symp14Spec R) (k : Fin 14)
    (rcOpt : Option (Fin 126)) (x : Fin (2 ^ 5)) : (n : ℕ) → n ≤ R → Bool
  | 0, _ => false
  | m + 1, hm =>
      let mFin : Fin R := ⟨m, hm⟩
      let prev := S.stepXorBool k rcOpt x m (Nat.le_of_succ_le hm)
      if S.stepW mFin k then
        let a := match rcOpt with
          | some rc => S.stepA mFin rc
          | none => false
        let b := match rcOpt with
          | some rc => S.stepB mFin rc
          | none => false
        let c := extCol24Bool (S.stepC mFin) x
        let d := extCol24Bool (S.stepD mFin) x
        xor prev (xor a c && xor b d)
      else prev

/-- Full `R`-step shared symplectic Boolean output of `S : Symp14Spec R` on plane `k`. -/
def Symp14Spec.evalBool {R : ℕ} (S : Symp14Spec R) (k : Fin 14)
    (rcOpt : Option (Fin 126)) (x : Fin (2 ^ 5)) : Bool :=
  let rd := match rcOpt with
    | some rc => S.rowDiag k rc
    | none => false
  let cd := extCol24Bool (S.colDiag k) x
  xor (xor rd cd) (S.stepXorBool k rcOpt x R le_rfl)

attribute [irreducible] keep9Hot24BoolTable sp14RowDiag sp14ColDiag sp14StepA sp14StepB
  sp14StepC sp14StepD sp14StepW

