/-- Packed `126 × 30` zero-`L1`-loss (`ε_in = 0`) `14`-bit `(alt : 5, keep : 9)` inner
Walker-alias entries co-optimized for `153` shared symplectic Toffoli steps. -/
def keep9InnerAliasPacked : Array (Array ℕ) :=
  (keep9InnerAliasPart0 ++ keep9InnerAliasPart1 ++ keep9InnerAliasPart2 ++
   keep9InnerAliasPart3 ++ keep9InnerAliasPart4 ++ keep9InnerAliasPart5 ++
   keep9InnerAliasPart6 ++ keep9InnerAliasPart7 ++ keep9InnerAliasPart8).toArray

theorem keep9InnerAliasPacked_size : keep9InnerAliasPacked.size = 126 := by decide +kernel

/-- Exact `ε_in = 0` Walker-alias entry `(alt, keep, ...)` for `(rc, b)`, unpacked from
`keep9InnerAliasPacked`. -/
def keep9InnerAliasTable (rc : Fin 126) (b : Fin 30) : OuterWeights.AliasEntry 30 :=
  AliasTableEngine.unpackPackedEntry 30 5 9
    ((keep9InnerAliasPacked.getD rc.val #[]).getD b.val 0) b

/-- `14`-bit QROM Boolean lookup `(alt : 5, keep : 9)` (`payBits = 0`) for
`keep9InnerAliasTable`. -/
def keep9InnerAliasBits (rc : Fin 126) (b : Fin 30) (k : Fin 14) : Bool :=
  if k.val < 5 then
    ((keep9InnerAliasTable rc b).alt.val).testBit k.val
  else
    ((keep9InnerAliasTable rc b).keep).testBit (k.val - 5)

theorem keep9InnerAliasTable_keep_lt (rc : Fin 126) (b : Fin 30) :
    (keep9InnerAliasTable rc b).keep < 512 :=
  AliasTableEngine.unpackPackedEntry_keep_lt 30 5 9 _ b

/-- `128 × 32 × 14` degree-`≤ 4` extended Boolean table (`extCol24Bool` on `rc < 126`, `false` on
one-body rows `126, 127`). -/
def keep9Hot24BoolTable (rc : Fin 128) (x : Fin (2 ^ 5)) (k : Fin 14) : Bool :=
  if h : rc.val < 126 then
    extCol24Bool (fun y ↦ keep9InnerAliasBits ⟨rc.val, h⟩ y k) x
  else false

theorem keep9Hot24BoolTable_of_lt {rc : Fin 128} {x : Fin (2 ^ 5)}
    (hc : rc.val < 126) (hx : x.val < 30) (k : Fin 14) :
    keep9Hot24BoolTable rc x k = keep9InnerAliasBits ⟨rc.val, hc⟩ ⟨x.val, hx⟩ k := by
  simp [keep9Hot24BoolTable, hc, extCol24Bool_of_lt _ hx]

theorem keep9Hot24BoolTable_of_ge {rc : Fin 128} (hc : 126 ≤ rc.val)
    (x : Fin (2 ^ 5)) (k : Fin 14) :
    keep9Hot24BoolTable rc x k = false := by
  have hn : ¬ rc.val < 126 := by omega
  simp [keep9Hot24BoolTable, hn]

theorem anfCoeffsKeep9Hot24BoolTable_30 (rc : Fin 128) (k : Fin 14) :
    SelectSwapQROM.anfCoeffs 5
      (fun x ↦ if keep9Hot24BoolTable rc x k then (1 : ZMod 2) else 0) ⟨30, by decide⟩ = 0 := by
  dsimp only [keep9Hot24BoolTable]
  by_cases h : rc.val < 126
  · simp only [h, ↓reduceDIte]
    have hc := col24Anf5_30 (fun y ↦ keep9InnerAliasBits ⟨rc.val, h⟩ y k)
    unfold col24Anf5 col24ZMod5 at hc
    exact hc
  · simp only [h, ↓reduceDIte]
    exact anfCoeffs_zero_local 5 ⟨30, by decide⟩

theorem anfCoeffsKeep9Hot24BoolTable_31 (rc : Fin 128) (k : Fin 14) :
    SelectSwapQROM.anfCoeffs 5
      (fun x ↦ if keep9Hot24BoolTable rc x k then (1 : ZMod 2) else 0) ⟨31, by decide⟩ = 0 := by
  dsimp only [keep9Hot24BoolTable]
  by_cases h : rc.val < 126
  · simp only [h, ↓reduceDIte]
    have hc := col24Anf5_31 (fun y ↦ keep9InnerAliasBits ⟨rc.val, h⟩ y k)
    unfold col24Anf5 col24ZMod5 at hc
    exact hc
  · simp only [h, ↓reduceDIte]
    exact anfCoeffs_zero_local 5 ⟨31, by decide⟩

