theorem writeReg_invol_of_invol_out8 {N k : ℕ} (r : QRegister k N)
    (g : BitAssignment k → BitAssignment k) (hg : Function.Involutive g) (γ : BitAssignment N) :
    Comparators.writeReg (Comparators.writeReg γ r (g (fun i ↦ γ (r i)))) r
        (g (fun i ↦ Comparators.writeReg γ r (g (fun j ↦ γ (r j))) (r i))) = γ := by
