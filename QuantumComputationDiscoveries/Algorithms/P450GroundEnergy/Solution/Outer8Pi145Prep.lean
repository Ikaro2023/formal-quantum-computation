/-- `15`-wire lower source `[off..off+13, off+47]` for the top `x₇` split. -/
def wHotTop15W0 {N : ℕ} (off : ℕ) (hN : off + 77 ≤ N) (i : Fin 15) : Wire N :=
  if i.val < 14 then ⟨off + i.val, by omega⟩ else ⟨off + 47, by omega⟩

/-- `15`-wire upper target `[off+32..off+45, off+48]` for the top `x₇` split. -/
def wHotTop15W1 {N : ℕ} (off : ℕ) (hN : off + 77 ≤ N) (i : Fin 15) : Wire N :=
  if i.val < 14 then ⟨off + 32 + i.val, by omega⟩ else ⟨off + 48, by omega⟩

/-- Disjointness certificate for the `15`-wire `x₇` W-state split. -/
theorem wSplit15Valid {N : ℕ} (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    WSplitValid (n := N) 15 ⟨7, by omega⟩
      (wHotTop15W0 off hN) (wHotTop15W1 off hN) ⟨off + 49, by omega⟩ where
  w0_inj i j h := by
    apply Fin.ext; simp only [wHotTop15W0, Fin.ext_iff] at h
    split_ifs at h <;> simp_all <;> omega
  w1_inj i j h := by
    apply Fin.ext; simp only [wHotTop15W1, Fin.ext_iff] at h
    split_ifs at h <;> simp_all <;> omega
  w01_ne i j h := by
    simp only [wHotTop15W0, wHotTop15W1, Fin.ext_iff] at h
    split_ifs at h <;> simp_all <;> omega
  ctrl_w0 i h := by
    have hv := congrArg Fin.val h; dsimp only [wHotTop15W0] at hv
    split_ifs at hv <;> (dsimp only at hv; omega)
  ctrl_w1 i h := by
    have hv := congrArg Fin.val h; dsimp only [wHotTop15W1] at hv
    split_ifs at hv <;> (dsimp only at hv; omega)
  q_ctrl h := by have := congrArg Fin.val h; try dsimp at this; omega
  q_w0 i h := by
    have hv := congrArg Fin.val h; dsimp only [wHotTop15W0] at hv
    split_ifs at hv <;> (dsimp only at hv; omega)
  q_w1 i h := by
    have hv := congrArg Fin.val h; dsimp only [wHotTop15W1] at hv
    split_ifs at hv <;> (dsimp only at hv; omega)

/-- `18`-CNOT fan-in from `off + 14 .. off + 31` into dummy wire `wRDum = off + 47`. -/
def cnot14To31Rev {N : ℕ} (off : ℕ) (hN : off + 77 ≤ N) : GroupUnary.RevCompute N :=
  cnotMaskRev ⟨off + 47, by omega⟩ 18 (QRegister.block (off + 14) 18 (by omega))
    (fun i h ↦ by have hv := congrArg Fin.val h; simp at hv; omega)
    (fun _ ↦ true)

/-- `1`-AND computation `wS01 = x₀ * x₁` into `off + 46`. -/
def s01Rev {N : ℕ} (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    GroupUnary.RevCompute N :=
  .andGate ⟨0, by omega⟩ ⟨1, by omega⟩ ⟨off + 46, by omega⟩
    (fun h ↦ by have := congrArg Fin.val h; dsimp at this; omega)
    (fun h ↦ by have := congrArg Fin.val h; try dsimp at this; omega)
    (fun h ↦ by have := congrArg Fin.val h; try dsimp at this; omega)

/-- Classical `45`-AND reversible reference for `wHot46` (uncomputed in `0 T`). -/
def wHot46Rev {N : ℕ} (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    GroupUnary.RevCompute N :=
  .seq
    (.seq
      (.seq
        (.seq
          (.seq
            (.seq (init4Rev off h12 hN)
              (splitRevLoop ⟨4, by omega⟩ 4 _ _ (wSplit4Valid off h12 hN).toWPairDisj))
            (splitRevLoop ⟨5, by omega⟩ 8 _ _ (wSplit8Valid off h12 hN).toWPairDisj))
          (splitRevLoop ⟨6, by omega⟩ 16 _ _ (wSplit16Valid off h12 hN).toWPairDisj))
        (cnot14To31Rev off hN))
      (splitRevLoop ⟨7, by omega⟩ 15 _ _ (wSplit15Valid off h12 hN).toWPairDisj))
    (s01Rev off h12 hN)

/-- `94-T` (`0 TOFF`) deterministic W-state `wHot46` forward router on `off .. off + 49`. -/
def wHot46FwdDyn {Var : Type} {N : ℕ} (v : Var) (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    DynamicCircuit Var N :=
  .seq
    (.seq
      (.seq
        (.seq
          (.seq
            (.seq (Lac2Folded184Select.revComputeDyn (init4Rev off h12 hN))
              (dWExpandDet1 v 4 ⟨4, by omega⟩ _ _ ⟨off + 49, by omega⟩
                (wSplit4Valid off h12 hN)))
            (dWExpandDet1 v 8 ⟨5, by omega⟩ _ _ ⟨off + 49, by omega⟩
              (wSplit8Valid off h12 hN)))
          (dWExpandDet1 v 16 ⟨6, by omega⟩ _ _ ⟨off + 49, by omega⟩
            (wSplit16Valid off h12 hN)))
        (Lac2Folded184Select.revComputeDyn (cnot14To31Rev off hN)))
      (dWExpandDet1 v 15 ⟨7, by omega⟩ _ _ ⟨off + 49, by omega⟩
        (wSplit15Valid off h12 hN)))
    (Lac2Folded184Select.revComputeDyn (s01Rev off h12 hN))

@[simp]
theorem count_wHot46FwdDyn_toff {Var : Type} {N : ℕ} (v : Var) (off : ℕ)
    (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    (wHot46FwdDyn v off h12 hN).count .TOFF = 0 := by
  simp [wHot46FwdDyn, DynamicCircuit.count]

@[simp]
theorem count_wHot46FwdDyn_t {Var : Type} {N : ℕ} (v : Var) (off : ℕ)
    (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    (wHot46FwdDyn v off h12 hN).count .T = 94 := by
  simp [wHot46FwdDyn, DynamicCircuit.count, init4Rev, cnot14To31Rev, s01Rev,
    GroupUnary.RevCompute.numAnd]

/-- Map `b : ZMod 2` to `0` or `1` in `ℕ`. -/
def bit01Nat (b : ZMod 2) : ℕ := if b = 1 then 1 else 0

theorem bit01Nat_le_one (b : ZMod 2) : bit01Nat b ≤ 1 := by
  dsimp [bit01Nat]; split_ifs <;> omega

theorem cswap_pow2_oneHot {N R : ℕ} (off : ℕ) (_h12 : 12 ≤ off) (h2R : off + 2 * R ≤ N)
    (ctrl : Wire N) (hctrl : ctrl.val < off)
    (β : BitAssignment N) (idx : Fin R)
    (hHot : ∀ k : ℕ, (hk : k < 2 * R) →
      β ⟨off + k, by omega⟩ = if k = idx.val then 1 else 0) :
    let w0 : Fin R → Wire N := fun i ↦ ⟨off + i.val, by omega⟩
    let w1 : Fin R → Wire N := fun i ↦ ⟨off + R + i.val, by omega⟩
    let β' := cswapRangeBits R ctrl w0 w1 β
    (∀ k : ℕ, (hk : k < 2 * R) →
      β' ⟨off + k, by omega⟩ = if k = idx.val + R * bit01Nat (β ctrl) then 1 else 0) ∧
    (∀ u : Wire N, (u.val < off ∨ off + 2 * R ≤ u.val) → β' u = β u) := by
  intro w0 w1 β'
  have hd : WPairDisj R ctrl w0 w1 :=
    { w0_inj := fun i j h ↦ Fin.ext (by have := congrArg Fin.val h; dsimp [w0] at this; omega)
      w1_inj := fun i j h ↦ Fin.ext (by have := congrArg Fin.val h; dsimp [w1] at this; omega)
      w01_ne := fun i j h ↦ by have := congrArg Fin.val h; dsimp [w0, w1] at this; omega
      ctrl_w0 := fun i h ↦ by have := congrArg Fin.val h; dsimp [w0] at this; omega
      ctrl_w1 := fun i h ↦ by have := congrArg Fin.val h; dsimp [w1] at this; omega }
  refine ⟨fun k hk ↦ ?_, fun u hu ↦ cswapRangeBits_other β
    (fun i he ↦ by have := congrArg Fin.val he; dsimp [w0] at this; omega)
    (fun i he ↦ by have := congrArg Fin.val he; dsimp [w1] at this; omega)⟩
  by_cases hkR : k < R
  · have hw0_eq : (⟨off + k, by omega⟩ : Wire N) = w0 ⟨k, hkR⟩ := rfl
    rw [hw0_eq]
    change cswapRangeBits R ctrl w0 w1 β (w0 ⟨k, hkR⟩) = _
    have hw1_k : w1 ⟨k, hkR⟩ = ⟨off + (R + k), by omega⟩ := Fin.ext (by dsimp [w1]; omega)
    rw [cswapRangeBits_w0 hd β ⟨k, hkR⟩, hHot k hk, hw1_k,
      hHot (R + k) (by omega), ite_eq_right (by omega : R + k ≠ idx.val)]
    rcases SelectSwapQROM.bit_cases (β ctrl) with hc | hc
    · simp [hc, bit01Nat, zero_ne_one]
    · simp only [hc, bit01Nat, ↓reduceIte, mul_one]
      exact (ite_eq_right (by omega : k ≠ idx.val + R)).symm
  · have hw1_eq : (⟨off + k, by omega⟩ : Wire N) = w1 ⟨k - R, by omega⟩ :=
      Fin.ext (by dsimp [w1]; omega)
    rw [hw1_eq]
    change cswapRangeBits R ctrl w0 w1 β (w1 ⟨k - R, by omega⟩) = _
    rw [cswapRangeBits_w1 hd β ⟨k - R, by omega⟩]
    have hhi0 : β (w1 ⟨k - R, by omega⟩) = 0 := by
      have hw1_k : w1 ⟨k - R, by omega⟩ = ⟨off + (R + (k - R)), by omega⟩ :=
        Fin.ext (by dsimp [w1]; omega)
      rw [hw1_k, hHot (R + (k - R)) (by omega), ite_eq_right (by omega : R + (k - R) ≠ idx.val)]
    have hlo : β (w0 ⟨k - R, by omega⟩) = if k - R = idx.val then 1 else 0 :=
      hHot (k - R) (by omega)
    rw [hlo, hhi0]
    rcases SelectSwapQROM.bit_cases (β ctrl) with hc | hc
    · simp only [hc, bit01Nat, zero_ne_one, ↓reduceIte, mul_zero, add_zero]
      exact (ite_eq_right (by omega : k ≠ idx.val)).symm
    · simp only [hc, bit01Nat, ↓reduceIte, mul_one]
      by_cases hkeq : k - R = idx.val
      · rw [ite_eq_left hkeq, ite_eq_left (by omega)]
      · rw [ite_eq_right hkeq, ite_eq_right (by omega)]

/-- Upper `6`-bit quotient index `⌊x / 4⌋` extracted from wires `2..7`. -/
def q6Val {N : ℕ} (h8 : 8 ≤ N) (β : BitAssignment N) : ℕ :=
  bit01Nat (β ⟨2, by omega⟩) + 2 * bit01Nat (β ⟨3, by omega⟩) +
    4 * bit01Nat (β ⟨4, by omega⟩) + 8 * bit01Nat (β ⟨5, by omega⟩) +
    16 * bit01Nat (β ⟨6, by omega⟩) + 32 * bit01Nat (β ⟨7, by omega⟩)

theorem q6Val_lt_64 {N : ℕ} (h8 : 8 ≤ N) (β : BitAssignment N) :
    q6Val h8 β < 64 := by
  have b2 := bit01Nat_le_one (β ⟨2, by omega⟩)
  have b3 := bit01Nat_le_one (β ⟨3, by omega⟩)
  have b4 := bit01Nat_le_one (β ⟨4, by omega⟩)
  have b5 := bit01Nat_le_one (β ⟨5, by omega⟩)
  have b6 := bit01Nat_le_one (β ⟨6, by omega⟩)
  have b7 := bit01Nat_le_one (β ⟨7, by omega⟩)
  dsimp [q6Val]; omega

theorem q6Val_eq_localIdx_div4 {N : ℕ} (h8 : 8 ≤ N) (β : BitAssignment N) :
    q6Val h8 β =
      (Comparators.localIdx (QRegister.block 0 8 h8) β).val / 4 := by
  let x := Comparators.localIdx (QRegister.block 0 8 h8) β
  have hxlt : x.val < 256 := x.isLt
  have hbit (k : ℕ) (hk : k < 8) :
      bit01Nat (β ⟨k, by omega⟩) = x.val / 2 ^ k % 2 := by
    let kf : Fin 8 := ⟨k, hk⟩
    have hb : basisBits 8 x kf = β ⟨k, by omega⟩ := by
      change basisBits 8 ((basisBits 8).symm _) kf = _
      rw [Comparators.basisBits_basisBitsEquiv_symm]
      congr 1; ext; simp [kf]
    rw [← hb, basisBits_eq_div_mod 8 x kf]
    dsimp [bit01Nat, kf]
    rcases Nat.mod_two_eq_zero_or_one (x.val / 2 ^ k) with hm | hm <;> simp [hm]
  have h2 := hbit 2 (by decide); have h3 := hbit 3 (by decide); have h4 := hbit 4 (by decide)
  have h5 := hbit 5 (by decide); have h6 := hbit 6 (by decide); have h7 := hbit 7 (by decide)
  dsimp only [q6Val] at *
  rw [h2, h3, h4, h5, h6, h7]
  omega

theorem revCompute_fwdBits_seq {N : ℕ} (a b : GroupUnary.RevCompute N)
    (β : BitAssignment N) :
    b.fwdBits (a.fwdBits β) = (a.seq b).fwdBits β := rfl

theorem wHot46_equiv_and_spec {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N)
    (S : BitAssignment N → Bool)
    (hClean50 : ∀ β, S β = true → ∀ j : Fin 50, β ⟨off + j.val, by omega⟩ = 0) :
    EquivRev v S (wHot46Rev off h12 hN) (wHot46FwdDyn v off h12 hN) ∧
    ∀ β, S β = true →
      let γ := (wHot46Rev off h12 hN).fwdBits β
      (∀ u : Wire N, (u.val < off ∨ off + 50 ≤ u.val) → γ u = β u) ∧
      γ ⟨off + 46, by omega⟩ = β ⟨0, by omega⟩ * β ⟨1, by omega⟩ ∧
      ∀ i : Fin 46,
        γ ⟨off + i.val, by omega⟩ =
          if i = DyadicXMeasPrepOut13.effGroup
              ((Comparators.localIdx (QRegister.block 0 8 (by omega)) β).val / 4) then 1
          else 0 := by
  let w4_0 : Fin 4 → Wire N := fun i ↦ ⟨off + i.val, by omega⟩
  let w4_1 : Fin 4 → Wire N := fun i ↦ ⟨off + 4 + i.val, by omega⟩
  let w8_0 : Fin 8 → Wire N := fun i ↦ ⟨off + i.val, by omega⟩
  let w8_1 : Fin 8 → Wire N := fun i ↦ ⟨off + 8 + i.val, by omega⟩
  let w16_0 : Fin 16 → Wire N := fun i ↦ ⟨off + i.val, by omega⟩
  let w16_1 : Fin 16 → Wire N := fun i ↦ ⟨off + 16 + i.val, by omega⟩
  let p0 := init4Rev off h12 hN
  let p1 := splitRevLoop (N := N) ⟨4, by omega⟩ 4 w4_0 w4_1 (wSplit4Valid off h12 hN).toWPairDisj
  let p2 := splitRevLoop (N := N) ⟨5, by omega⟩ 8 w8_0 w8_1 (wSplit8Valid off h12 hN).toWPairDisj
  let p3 := splitRevLoop (N := N) ⟨6, by omega⟩ 16 w16_0 w16_1
    (wSplit16Valid off h12 hN).toWPairDisj
  let p4 := cnot14To31Rev (N := N) off hN
  let p5 := splitRevLoop (N := N) ⟨7, by omega⟩ 15 (wHotTop15W0 off hN) (wHotTop15W1 off hN)
    (wSplit15Valid off h12 hN).toWPairDisj
  let p6 := s01Rev (N := N) off h12 hN
  have hStep0 (β : BitAssignment N) (hS : S β = true) :
      p0.validOn β = true ∧
      (∀ k : ℕ, (hk : k < 50) →
        (p0.fwdBits β) ⟨off + k, by omega⟩ =
          if k = bit01Nat (β ⟨2, by omega⟩) + 2 * bit01Nat (β ⟨3, by omega⟩) then 1 else 0) ∧
      (∀ u : Wire N, (u.val < off ∨ off + 50 ≤ u.val) → p0.fwdBits β u = β u) := by
    have hc (k : ℕ) (hk : k < 50) : β ⟨off + k, by omega⟩ = 0 := hClean50 β hS ⟨k, hk⟩
    have hv0 : p0.validOn β = true := by
      simp [p0, init4Rev, GroupUnary.RevCompute.validOn, hc 3 (by decide)]
    let c0 : Wire N := ⟨2, by omega⟩
    let c1 : Wire N := ⟨3, by omega⟩
    let h0 : Wire N := ⟨off, by omega⟩
    let h1 : Wire N := ⟨off + 1, by omega⟩
    let h2 : Wire N := ⟨off + 2, by omega⟩
    let h3 : Wire N := ⟨off + 3, by omega⟩
    have hc0 : β h0 = 0 := by simpa only [h0, add_zero] using hc 0 (by decide)
    have hc1 : β h1 = 0 := hc 1 (by decide)
    have hc2 : β h2 = 0 := hc 2 (by decide)
    have hc3 : β h3 = 0 := hc 3 (by decide)
    have hne (a b : Wire N) (hab : a.val ≠ b.val) : a ≠ b := fun h ↦ hab (congrArg Fin.val h)
    set g1 := Function.update β h3 (β h3 + β c0 * β c1)
    set g2 := Function.update g1 h2 (g1 h2 + g1 c1)
    set g3 := Function.update g2 h2 (g2 h2 + g2 h3)
    set g4 := Function.update g3 h1 (g3 h1 + g3 c0)
    set g5 := Function.update g4 h1 (g4 h1 + g4 h3)
    set g6 := Function.update g5 h0 (g5 h0 + 1)
    set g7 := Function.update g6 h0 (g6 h0 + g6 c0)
    set g8 := Function.update g7 h0 (g7 h0 + g7 h2)
    have hg_eq : p0.fwdBits β = g8 := rfl
    have hg1 : g1 = Function.update β h3 (β c0 * β c1) := by
      dsimp only [g1]; rw [hc3, zero_add]
    have hg2 : g2 = Function.update g1 h2 (β c1) := by
      dsimp only [g2]; rw [hg1, Function.update_of_ne (hne h2 h3 (by dsimp [h2, h3]; omega)),
        Function.update_of_ne (hne c1 h3 (by dsimp [c1, h3]; omega)), hc2, zero_add]
    have hg3 : g3 = Function.update g2 h2 (β c1 + β c0 * β c1) := by
      dsimp only [g3]; rw [hg2, Function.update_self,
        Function.update_of_ne (hne h3 h2 (by dsimp [h3, h2]; omega)), hg1, Function.update_self]
    have hg4 : g4 = Function.update g3 h1 (β c0) := by
      dsimp only [g4]; rw [hg3, Function.update_of_ne (hne h1 h2 (by dsimp [h1, h2]; omega)),
        Function.update_of_ne (hne c0 h2 (by dsimp [c0, h2]; omega)),
        hg2, Function.update_of_ne (hne h1 h2 (by dsimp [h1, h2]; omega)),
        Function.update_of_ne (hne c0 h2 (by dsimp [c0, h2]; omega)),
        hg1, Function.update_of_ne (hne h1 h3 (by dsimp [h1, h3]; omega)),
        Function.update_of_ne (hne c0 h3 (by dsimp [c0, h3]; omega)), hc1, zero_add]
    have hg5 : g5 = Function.update g4 h1 (β c0 + β c0 * β c1) := by
      dsimp only [g5]; rw [hg4, Function.update_self,
        Function.update_of_ne (hne h3 h1 (by dsimp [h3, h1]; omega)),
        hg3, Function.update_of_ne (hne h3 h2 (by dsimp [h3, h2]; omega)),
        hg2, Function.update_of_ne (hne h3 h2 (by dsimp [h3, h2]; omega)),
        hg1, Function.update_self]
    have hg6 : g6 = Function.update g5 h0 1 := by
      dsimp only [g6]; rw [hg5, Function.update_of_ne (hne h0 h1 (by dsimp [h0, h1]; omega)),
        hg4, Function.update_of_ne (hne h0 h1 (by dsimp [h0, h1]; omega)),
        hg3, Function.update_of_ne (hne h0 h2 (by dsimp [h0, h2]; omega)),
        hg2, Function.update_of_ne (hne h0 h2 (by dsimp [h0, h2]; omega)),
        hg1, Function.update_of_ne (hne h0 h3 (by dsimp [h0, h3]; omega)), hc0, zero_add]
    have hg7 : g7 = Function.update g6 h0 (1 + β c0) := by
      dsimp only [g7]; rw [hg6, Function.update_self,
        Function.update_of_ne (hne c0 h0 (by dsimp [c0, h0]; omega)),
        hg5, Function.update_of_ne (hne c0 h1 (by dsimp [c0, h1]; omega)),
        hg4, Function.update_of_ne (hne c0 h1 (by dsimp [c0, h1]; omega)),
        hg3, Function.update_of_ne (hne c0 h2 (by dsimp [c0, h2]; omega)),
        hg2, Function.update_of_ne (hne c0 h2 (by dsimp [c0, h2]; omega)),
        hg1, Function.update_of_ne (hne c0 h3 (by dsimp [c0, h3]; omega))]
    have hg8 : g8 = Function.update g7 h0 (1 + β c0 + (β c1 + β c0 * β c1)) := by
      dsimp only [g8]; rw [hg7, Function.update_self,
        Function.update_of_ne (hne h2 h0 (by dsimp [h2, h0]; omega)),
        hg6, Function.update_of_ne (hne h2 h0 (by dsimp [h2, h0]; omega)),
        hg5, Function.update_of_ne (hne h2 h1 (by dsimp [h2, h1]; omega)),
        hg4, Function.update_of_ne (hne h2 h1 (by dsimp [h2, h1]; omega)),
        hg3, Function.update_self]
    have hg_other (w : Wire N) (hw0 : w ≠ h0) (hw1 : w ≠ h1) (hw2 : w ≠ h2) (hw3 : w ≠ h3) :
        g8 w = β w := by
      rw [hg8, Function.update_of_ne hw0, hg7, Function.update_of_ne hw0,
        hg6, Function.update_of_ne hw0, hg5, Function.update_of_ne hw1,
        hg4, Function.update_of_ne hw1, hg3, Function.update_of_ne hw2,
        hg2, Function.update_of_ne hw2, hg1, Function.update_of_ne hw3]
    refine ⟨hv0, fun k hk ↦ ?_, fun u hu ↦ ?_⟩
    · rw [hg_eq]
      by_cases hk4 : k < 4
      · interval_cases k
        · rw [show (⟨off + 0, by omega⟩ : Wire N) = h0 from rfl, hg8, Function.update_self]
          rcases SelectSwapQROM.bit_cases (β c0) with hb2 | hb2 <;>
            rcases SelectSwapQROM.bit_cases (β c1) with hb3 | hb3 <;>
            simp [c0, c1, hb2, hb3, bit01Nat]
        · rw [show (⟨off + 1, by omega⟩ : Wire N) = h1 from rfl,
            hg8, Function.update_of_ne (hne h1 h0 (by dsimp [h1, h0]; omega)),
            hg7, Function.update_of_ne (hne h1 h0 (by dsimp [h1, h0]; omega)),
            hg6, Function.update_of_ne (hne h1 h0 (by dsimp [h1, h0]; omega)),
            hg5, Function.update_self]
          rcases SelectSwapQROM.bit_cases (β c0) with hb2 | hb2 <;>
            rcases SelectSwapQROM.bit_cases (β c1) with hb3 | hb3 <;>
            simp [c0, c1, hb2, hb3, bit01Nat]
        · rw [show (⟨off + 2, by omega⟩ : Wire N) = h2 from rfl,
            hg8, Function.update_of_ne (hne h2 h0 (by dsimp [h2, h0]; omega)),
            hg7, Function.update_of_ne (hne h2 h0 (by dsimp [h2, h0]; omega)),
            hg6, Function.update_of_ne (hne h2 h0 (by dsimp [h2, h0]; omega)),
            hg5, Function.update_of_ne (hne h2 h1 (by dsimp [h2, h1]; omega)),
            hg4, Function.update_of_ne (hne h2 h1 (by dsimp [h2, h1]; omega)),
            hg3, Function.update_self]
          rcases SelectSwapQROM.bit_cases (β c0) with hb2 | hb2 <;>
            rcases SelectSwapQROM.bit_cases (β c1) with hb3 | hb3 <;>
            simp [c0, c1, hb2, hb3, bit01Nat]
        · rw [show (⟨off + 3, by omega⟩ : Wire N) = h3 from rfl,
            hg8, Function.update_of_ne (hne h3 h0 (by dsimp [h3, h0]; omega)),
            hg7, Function.update_of_ne (hne h3 h0 (by dsimp [h3, h0]; omega)),
            hg6, Function.update_of_ne (hne h3 h0 (by dsimp [h3, h0]; omega)),
            hg5, Function.update_of_ne (hne h3 h1 (by dsimp [h3, h1]; omega)),
            hg4, Function.update_of_ne (hne h3 h1 (by dsimp [h3, h1]; omega)),
            hg3, Function.update_of_ne (hne h3 h2 (by dsimp [h3, h2]; omega)),
            hg2, Function.update_of_ne (hne h3 h2 (by dsimp [h3, h2]; omega)),
            hg1, Function.update_self]
          rcases SelectSwapQROM.bit_cases (β c0) with hb2 | hb2 <;>
            rcases SelectSwapQROM.bit_cases (β c1) with hb3 | hb3 <;>
            simp [c0, c1, hb2, hb3, bit01Nat]
      · rw [hg_other _ (hne _ h0 (by dsimp [h0]; omega)) (hne _ h1 (by dsimp [h1]; omega))
            (hne _ h2 (by dsimp [h2]; omega)) (hne _ h3 (by dsimp [h3]; omega))]
        have b2 := bit01Nat_le_one (β ⟨2, by omega⟩)
        have b3 := bit01Nat_le_one (β ⟨3, by omega⟩)
        rw [hc k hk, eq_comm]
        exact ite_eq_right (by omega)
    · rw [hg_eq]
      exact hg_other u (hne u h0 (by dsimp [h0]; omega)) (hne u h1 (by dsimp [h1]; omega))
        (hne u h2 (by dsimp [h2]; omega)) (hne u h3 (by dsimp [h3]; omega))
  let q01 := p0.seq p1
  let q02 := q01.seq p2
  let q03 := q02.seq p3
  let q04 := q03.seq p4
  let q05 := q04.seq p5
  let S1 : BitAssignment N → Bool := fun γ ↦ S (p0.invBits γ)
  let S2 : BitAssignment N → Bool := fun γ ↦ S (q01.invBits γ)
  let S3 : BitAssignment N → Bool := fun γ ↦ S (q02.invBits γ)
  let S4 : BitAssignment N → Bool := fun γ ↦ S (q03.invBits γ)
  let S5 : BitAssignment N → Bool := fun γ ↦ S (q04.invBits γ)
  let S6 : BitAssignment N → Bool := fun γ ↦ S (q05.invBits γ)
  have hChain (β : BitAssignment N) (hS : S β = true) :
      let β0 := p0.fwdBits β
      let β1 := p1.fwdBits β0
      let β2 := p2.fwdBits β1
      let β3 := p3.fwdBits β2
      let β4 := p4.fwdBits β3
      let β5 := p5.fwdBits β4
      let β6 := p6.fwdBits β5
      InvWSplitDet 4 w4_0 w4_1 ⟨off + 49, by omega⟩ β0 ∧
      InvWSplitDet 8 w8_0 w8_1 ⟨off + 49, by omega⟩ β1 ∧
      InvWSplitDet 16 w16_0 w16_1 ⟨off + 49, by omega⟩ β2 ∧
      p4.validOn β3 = true ∧
      InvWSplitDet 15 (wHotTop15W0 off hN) (wHotTop15W1 off hN) ⟨off + 49, by omega⟩ β4 ∧
      p6.validOn β5 = true ∧
      (∀ u : Wire N, (u.val < off ∨ off + 50 ≤ u.val) → β6 u = β u) ∧
      β6 ⟨off + 46, by omega⟩ = β ⟨0, by omega⟩ * β ⟨1, by omega⟩ ∧
      ∀ i : Fin 46,
        β6 ⟨off + i.val, by omega⟩ =
          if i = DyadicXMeasPrepOut13.effGroup
              ((Comparators.localIdx (QRegister.block 0 8 (by omega)) β).val / 4) then 1
          else 0 := by
    intro β0 β1 β2 β3 β4 β5 β6
    obtain ⟨_, h0_hot, h0_out⟩ := hStep0 β hS
    set idx0 : ℕ := bit01Nat (β ⟨2, by omega⟩) + 2 * bit01Nat (β ⟨3, by omega⟩)
    have hidx0_lt : idx0 < 4 := by
      have := bit01Nat_le_one (β ⟨2, by omega⟩); have := bit01Nat_le_one (β ⟨3, by omega⟩); omega
    have hInv1 : InvWSplitDet 4 w4_0 w4_1 ⟨off + 49, by omega⟩ β0 := by
      dsimp only [InvWSplitDet, β0, w4_0, w4_1]
      refine ⟨?_, fun i ↦ ?_, ⟨idx0, hidx0_lt⟩, ?_, fun i hi ↦ ?_⟩
      · rw [h0_hot 49 (by decide), ite_eq_right (by omega : 49 ≠ idx0)]
      · have hw : (⟨off + 4 + i.val, by omega⟩ : Wire N) = ⟨off + (4 + i.val), by omega⟩ :=
          Fin.ext (by dsimp; omega)
        rw [hw, h0_hot (4 + i.val) (by omega), ite_eq_right (by omega : 4 + i.val ≠ idx0)]
      · rw [h0_hot idx0 (by omega), ite_eq_left rfl]
      · have hne : i.val ≠ idx0 := fun he ↦ hi (Fin.ext he)
        rw [h0_hot i.val (by omega), ite_eq_right hne]
    have hf1 := (splitRevLoop_spec ⟨4, by omega⟩ 4 w4_0 w4_1 (wSplit4Valid off h12 hN).toWPairDisj
      β0 hInv1.2.1).2
    obtain ⟨h1_8, h1_out⟩ := cswap_pow2_oneHot off h12 (by omega) ⟨4, by omega⟩ (by dsimp; omega)
      β0 ⟨idx0, hidx0_lt⟩ (fun k hk ↦ h0_hot k (by omega))
    have hβ0_4 : β0 ⟨4, by omega⟩ = β ⟨4, by omega⟩ :=
      h0_out ⟨4, by omega⟩ (Or.inl (by dsimp; omega))
    set idx1 : ℕ := idx0 + 4 * bit01Nat (β ⟨4, by omega⟩)
    have hidx1_lt : idx1 < 8 := by have := bit01Nat_le_one (β ⟨4, by omega⟩); omega
    have h1_hot (k : ℕ) (hk : k < 50) : β1 ⟨off + k, by omega⟩ = if k = idx1 then 1 else 0 := by
      dsimp only [β1]; rw [hf1]
      by_cases hk8 : k < 8
      · simpa [hβ0_4, idx1] using h1_8 k hk8
      · rw [h1_out ⟨off + k, by omega⟩ (Or.inr (by dsimp; omega))]
        dsimp only [β0]
        rw [h0_hot k hk, ite_eq_right (by omega : k ≠ idx1), ite_eq_right (by omega : k ≠ idx0)]
    have h1_ext (u : Wire N) (hu : u.val < off ∨ off + 50 ≤ u.val) : β1 u = β u := by
      dsimp only [β1]; rw [hf1, h1_out u (hu.imp id (by omega))]; exact h0_out u hu
    have hInv2 : InvWSplitDet 8 w8_0 w8_1 ⟨off + 49, by omega⟩ β1 := by
      dsimp only [InvWSplitDet, w8_0, w8_1]
      refine ⟨?_, fun i ↦ ?_, ⟨idx1, hidx1_lt⟩, ?_, fun i hi ↦ ?_⟩
      · rw [h1_hot 49 (by decide), ite_eq_right (by omega : 49 ≠ idx1)]
      · have hw : (⟨off + 8 + i.val, by omega⟩ : Wire N) = ⟨off + (8 + i.val), by omega⟩ :=
          Fin.ext (by dsimp; omega)
        rw [hw, h1_hot (8 + i.val) (by omega), ite_eq_right (by omega : 8 + i.val ≠ idx1)]
      · rw [h1_hot idx1 (by omega), ite_eq_left rfl]
      · have hne : i.val ≠ idx1 := fun he ↦ hi (Fin.ext he)
        rw [h1_hot i.val (by omega), ite_eq_right hne]
    have hf2 := (splitRevLoop_spec ⟨5, by omega⟩ 8 w8_0 w8_1 (wSplit8Valid off h12 hN).toWPairDisj
      β1 hInv2.2.1).2
    obtain ⟨h2_16, h2_out⟩ := cswap_pow2_oneHot off h12 (by omega) ⟨5, by omega⟩ (by dsimp; omega)
      β1 ⟨idx1, hidx1_lt⟩ (fun k hk ↦ h1_hot k (by omega))
    have hβ1_5 : β1 ⟨5, by omega⟩ = β ⟨5, by omega⟩ :=
      h1_ext ⟨5, by omega⟩ (Or.inl (by dsimp; omega))
    set idx2 : ℕ := idx1 + 8 * bit01Nat (β ⟨5, by omega⟩)
    have hidx2_lt : idx2 < 16 := by have := bit01Nat_le_one (β ⟨5, by omega⟩); omega
    have h2_hot (k : ℕ) (hk : k < 50) : β2 ⟨off + k, by omega⟩ = if k = idx2 then 1 else 0 := by
      dsimp only [β2]; rw [hf2]
      by_cases hk16 : k < 16
      · simpa [hβ1_5, idx2] using h2_16 k hk16
      · rw [h2_out ⟨off + k, by omega⟩ (Or.inr (by dsimp; omega)), h1_hot k hk,
          ite_eq_right (by omega : k ≠ idx2), ite_eq_right (by omega : k ≠ idx1)]
    have h2_ext (u : Wire N) (hu : u.val < off ∨ off + 50 ≤ u.val) : β2 u = β u := by
      dsimp only [β2]; rw [hf2, h2_out u (hu.imp id (by omega)), h1_ext u hu]
    have hInv3 : InvWSplitDet 16 w16_0 w16_1 ⟨off + 49, by omega⟩ β2 := by
      dsimp only [InvWSplitDet, w16_0, w16_1]
      refine ⟨?_, fun i ↦ ?_, ⟨idx2, hidx2_lt⟩, ?_, fun i hi ↦ ?_⟩
      · rw [h2_hot 49 (by decide), ite_eq_right (by omega : 49 ≠ idx2)]
      · have hw : (⟨off + 16 + i.val, by omega⟩ : Wire N) = ⟨off + (16 + i.val), by omega⟩ :=
          Fin.ext (by dsimp; omega)
        rw [hw, h2_hot (16 + i.val) (by omega), ite_eq_right (by omega : 16 + i.val ≠ idx2)]
      · rw [h2_hot idx2 (by omega), ite_eq_left rfl]
