theorem cr_lift_sub {Var : Type} [Fintype Var] [DecidableEq Var] {N k m s : ℕ}
    [NeZero (2 ^ N)] {v : Var} {rAct : QRegister k N} {rSub : QRegister m k} {rScr : QRegister s N}
    {U : Unitary (2 ^ m)} {P : DynamicCircuit Var N}
    (h : Solution.CleanDyn.CleanRealizes v (rAct.compose rSub) rScr U P) :
    Solution.CleanDyn.CleanRealizes v rAct rScr (rSub.embedUnitary U) P := by
  simpa only [Solution.CleanDyn.CleanRealizes, QRegister.embedUnitary_compose] using h

theorem cr_sbss_of {Var : Type} [Fintype Var] [DecidableEq Var] {N k s : ℕ}
    [NeZero (2 ^ N)] {v : Var} {rAct : QRegister k N} {rScr : QRegister s N}
    {U : Unitary (2 ^ k)} {P : DynamicCircuit Var N}
