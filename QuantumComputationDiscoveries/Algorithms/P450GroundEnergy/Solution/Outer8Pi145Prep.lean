/-- Retained `4` bit positions `[2, 3, 6, 7]` of `alt` (dropping invariant bits `0, 1, 4, 5`). -/
def ret4Idx : Fin 4 → Fin 8
  | ⟨0, _⟩ => 2
  | ⟨1, _⟩ => 3
  | ⟨2, _⟩ => 6
  | ⟨3, _⟩ => 7

/-- Cast `(pi145OuterTable y).alt` from `Fin 184` into `Fin (2 ^ 8)`. -/
abbrev altFin256 (y : Fin 184) : Fin (2 ^ 8) :=
  ⟨(pi145OuterTable y).alt.val, by have := (pi145OuterTable y).alt.isLt; omega⟩

/-- Guard bit `1 + x₇ * x₆ + a₃ * a₂` enabling `4`-bit CSWAP iff `mk = 0` on `y < 184`. -/
def cswapGuardBit (x : BitAssignment 8) (a : BitAssignment 4) : ZMod 2 :=
  1 + x 7 * x 6 + a 3 * a 2

/-- Computable post-CSWAP `8`-bit `rXo` state on `(x, a)` swapping `[2, 3, 6, 7]`. -/
def postCswapXoBits (x : BitAssignment 8) (a : BitAssignment 4) (i : Fin 8) : ZMod 2 :=
  if cswapGuardBit x a = 1 then
    match i.val with
    | 2 => a 0
    | 3 => a 1
    | 6 => a 2
    | 7 => a 3
    | _ => x i
  else x i

