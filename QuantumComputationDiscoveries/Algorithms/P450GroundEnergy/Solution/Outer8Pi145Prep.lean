/-- `1`-AND reversible `mux2` (`dst := a + s * (a + b)` when `dst = 0`), preserving `s, a, b`. -/
def mux2Rev {N : ℕ} (s a b dst : Wire N)
    (hab : a ≠ b) (hsb : s ≠ b) (hsd : s ≠ dst) (hbd : b ≠ dst) (had : a ≠ dst) :
    GroupUnary.RevCompute N :=
  .seq (.cnot a b hab)
    (.seq (.andGate s b dst hsb hsd hbd)
      (.seq (.cnot a b hab) (.cnot a dst had)))

@[simp]
theorem numAnd_mux2Rev {N : ℕ} (s a b dst : Wire N)
    (hab : a ≠ b) (hsb : s ≠ b) (hsd : s ≠ dst) (hbd : b ≠ dst) (had : a ≠ dst) :
    (mux2Rev s a b dst hab hsb hsd hbd had).numAnd = 1 := rfl

/-- `1`-AND reversible `notAnd` (`dst := (1 + s) * a` when `dst = 0`), preserving `s, a`. -/
def notAndRev {N : ℕ} (s a dst : Wire N) (hsa : s ≠ a) (hsd : s ≠ dst) (had : a ≠ dst) :
    GroupUnary.RevCompute N :=
  .seq (.x s) (.seq (.andGate s a dst hsa hsd had) (.x s))

@[simp]
theorem numAnd_notAndRev {N : ℕ} (s a dst : Wire N)
    (hsa : s ≠ a) (hsd : s ≠ dst) (had : a ≠ dst) :
    (notAndRev s a dst hsa hsd had).numAnd = 1 := rfl

theorem notAndRev_spec {N : ℕ} (s a dst : Wire N)
    (hsa : s ≠ a) (hsd : s ≠ dst) (had : a ≠ dst)
    (β : BitAssignment N) (hd0 : β dst = 0) :
    (notAndRev s a dst hsa hsd had).validOn β = true ∧
      (notAndRev s a dst hsa hsd had).fwdBits β =
        Function.update β dst ((1 + β s) * β a) := by
  have hv : (notAndRev s a dst hsa hsd had).validOn β = true := by
    simp [notAndRev, GroupUnary.RevCompute.validOn, GroupUnary.RevCompute.fwdBits,
      Function.update_of_ne hsd.symm, hd0]
  refine ⟨hv, ?_⟩
  funext u
  dsimp only [notAndRev, GroupUnary.RevCompute.fwdBits]
  by_cases hud : u = dst
  · subst hud
    simp only [Function.update_of_ne hsd.symm, Function.update_self, Function.update_of_ne hsa.symm,
      hd0, zero_add]
    ring
  · rw [Function.update_of_ne hud]
    by_cases hus : u = s
    · subst hus
      simp only [Function.update_self, Function.update_of_ne hsd]
      rcases SelectSwapQROM.bit_cases (β u) with hb | hb <;> simp [hb]
    · simp [Function.update_of_ne hus, Function.update_of_ne hud]

/-- `10`-AND reversible `pktKeepSel` multiplexer writing `pktKeepSel10` into `off + 76`. -/
def pktMux10Rev {N : ℕ} (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    GroupUnary.RevCompute N :=
  let kp (i : Fin 10) : Wire N := ⟨off + 50 + (keepPerm10 i).val,
    by have := (keepPerm10 i).isLt; omega⟩
  let q (j : Fin 4) : Wire N := ⟨8 + j.val, by omega⟩
  let u (j : Fin 10) : Wire N := ⟨off + 67 + j.val, by omega⟩
  have hkp_ne (i1 i2 : Fin 10) (h : i1 ≠ i2) : kp i1 ≠ kp i2 := by
    intro he; have hv := congrArg Fin.val he; dsimp [kp] at hv
    have hp : keepPerm10 i1 = keepPerm10 i2 := Fin.ext (by omega)
    exact h (keepPerm10Reg.wires.injective hp)
  have hq_kp (j : Fin 4) (i : Fin 10) : q j ≠ kp i := by
    intro he; have hv := congrArg Fin.val he
    have := (keepPerm10 i).isLt; dsimp [q, kp] at hv; omega
  have hq_u (j : Fin 4) (m : Fin 10) : q j ≠ u m := by
    intro he; have hv := congrArg Fin.val he; dsimp [q, u] at hv; omega
  have hkp_u (i : Fin 10) (m : Fin 10) : kp i ≠ u m := by
    intro he; have hv := congrArg Fin.val he
    have := (keepPerm10 i).isLt; dsimp [kp, u] at hv; omega
  have hu_ne (m1 m2 : Fin 10) (h : m1 ≠ m2) : u m1 ≠ u m2 := by
    intro he; have hv := congrArg Fin.val he; dsimp [u] at hv; exact h (Fin.ext (by omega))
  .seq (mux2Rev (q 0) (kp 9) (kp 8) (u 0) (hkp_ne 9 8 (by decide)) (hq_kp 0 8) (hq_u 0 0)
        (hkp_u 8 0) (hkp_u 9 0))
    (.seq (mux2Rev (q 1) (u 0) (kp 7) (u 1) (hkp_u 7 0).symm (hq_kp 1 7) (hq_u 1 1)
          (hkp_u 7 1) (hu_ne 0 1 (by decide)))
      (.seq (mux2Rev (q 2) (u 1) (kp 6) (u 2) (hkp_u 6 1).symm (hq_kp 2 6) (hq_u 2 2)
            (hkp_u 6 2) (hu_ne 1 2 (by decide)))
        (.seq (mux2Rev (q 0) (kp 5) (kp 4) (u 3) (hkp_ne 5 4 (by decide)) (hq_kp 0 4) (hq_u 0 3)
              (hkp_u 4 3) (hkp_u 5 3))
          (.seq (mux2Rev (q 1) (u 3) (kp 3) (u 4) (hkp_u 3 3).symm (hq_kp 1 3) (hq_u 1 4)
                (hkp_u 3 4) (hu_ne 3 4 (by decide)))
            (.seq (mux2Rev (q 0) (kp 2) (kp 1) (u 5) (hkp_ne 2 1 (by decide)) (hq_kp 0 1)
                  (hq_u 0 5) (hkp_u 1 5) (hkp_u 2 5))
              (.seq (notAndRev (q 0) (kp 0) (u 6) (hq_kp 0 0) (hq_u 0 6) (hkp_u 0 6))
                (.seq (mux2Rev (q 1) (u 5) (u 6) (u 7) (hu_ne 5 6 (by decide)) (hq_u 1 6)
                      (hq_u 1 7) (hu_ne 6 7 (by decide)) (hu_ne 5 7 (by decide)))
                  (.seq (mux2Rev (q 2) (u 4) (u 7) (u 8) (hu_ne 4 7 (by decide)) (hq_u 2 7)
                        (hq_u 2 8) (hu_ne 7 8 (by decide)) (hu_ne 4 8 (by decide)))
                    (mux2Rev (q 3) (u 2) (u 8) (u 9) (hu_ne 2 8 (by decide)) (hq_u 3 8)
                      (hq_u 3 9) (hu_ne 8 9 (by decide)) (hu_ne 2 9 (by decide)))))))))))

@[simp]
theorem numAnd_pktMux10Rev {N : ℕ} (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    (pktMux10Rev off h12 hN).numAnd = 10 := rfl

/-- `25`-AND (`100 T`, `0 TOFF`) reversible `keep:10 + pktMux10` program on `off .. off + 76`. -/
def pKeepMux25 {N : ℕ} (outerTable : Fin 184 → OuterWeights.AliasEntry 184)
    (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) : GroupUnary.RevCompute N :=
  have hHotScr : (QRegister.block (n := N) off 46 (by omega)).DisjointWires
      (QRegister.block (n := N) (off + 50) 17 (by omega)) :=
    QRegister.block_disjoint_of_le (n := N) off 46 (off + 50) 17 (by omega) (by omega) (by omega)
  .seq
    (DyadicXMeasPrepOut13.pairedLac4Loop
      (QRegister.block off 46 (by omega)) ⟨0, by omega⟩ ⟨1, by omega⟩ ⟨off + 46, by omega⟩
      (QRegister.block (off + 50) 17 (by omega)) hHotScr
      (fun j h ↦ by have hv := congrArg Fin.val h; simp at hv; omega)
      (fun j h ↦ by have hv := congrArg Fin.val h; simp at hv; omega)
      (fun j h ↦ by have hv := congrArg Fin.val h; simp at hv; omega)
      (DyadicXMeasPrepOut13.keepColBool outerTable) 5 le_rfl)
    (pktMux10Rev off h12 hN)

@[simp]
theorem numAnd_pKeepMux25 {N : ℕ} (outerTable : Fin 184 → OuterWeights.AliasEntry 184)
    (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    (pKeepMux25 outerTable off h12 hN).numAnd = 25 := by
  simp [pKeepMux25, GroupUnary.RevCompute.numAnd]

/-! ## Section 2: `RevDisjRange`, One-Hot Mask Sums & Subregister Helpers -/

/-- Map `Bool` to `ZMod 2` (`false ↦ 0`, `true ↦ 1`). -/
def b2z (b : Bool) : ZMod 2 := if b then 1 else 0

/-- Syntactic wire-disjointness of `p` from wire range `[lo, hi)`. -/
def RevDisjRange (lo hi : ℕ) {N : ℕ} : GroupUnary.RevCompute N → Prop
  | .id => True
  | .x q => q.val < lo ∨ hi ≤ q.val
  | .cnot c t _ => (c.val < lo ∨ hi ≤ c.val) ∧ (t.val < lo ∨ hi ≤ t.val)
  | .andGate c1 c2 a _ _ _ =>
      (c1.val < lo ∨ hi ≤ c1.val) ∧ (c2.val < lo ∨ hi ≤ c2.val) ∧ (a.val < lo ∨ hi ≤ a.val)
  | .seq p1 p2 => RevDisjRange lo hi p1 ∧ RevDisjRange lo hi p2

theorem revDisjRange_inv_fwd_preserve {N : ℕ} {lo hi : ℕ} {p : GroupUnary.RevCompute N}
    (hp : RevDisjRange lo hi p) :
    (∀ γ w, lo ≤ w.val ∧ w.val < hi → p.fwdBits γ w = γ w ∧ p.invBits γ w = γ w) ∧
    (∀ γ₁ γ₂, (∀ u : Wire N, (u.val < lo ∨ hi ≤ u.val) → γ₁ u = γ₂ u) →
      ∀ u : Wire N, (u.val < lo ∨ hi ≤ u.val) → p.invBits γ₁ u = p.invBits γ₂ u) := by
  induction p with
  | id => exact ⟨fun _ _ _ ↦ ⟨rfl, rfl⟩, fun _ _ h u hu ↦ h u hu⟩
  | x q =>
      have hne {w : Wire N} (hw : lo ≤ w.val ∧ w.val < hi) : w ≠ q :=
        fun he ↦ by subst he; rcases hp with h1 | h2 <;> omega
      refine ⟨fun γ w hw ↦ ⟨Function.update_of_ne (hne hw) _ _, Function.update_of_ne (hne hw) _ _⟩,
        fun γ₁ γ₂ h u hu ↦ ?_⟩
      dsimp [GroupUnary.RevCompute.invBits]
      by_cases huq : u = q
      · subst huq; simp [h u hp]
      · simp [Function.update_of_ne huq, h u hu]
  | cnot c t _ =>
      have hne {w : Wire N} (hw : lo ≤ w.val ∧ w.val < hi) : w ≠ t :=
        fun he ↦ by subst he; rcases hp.2 with h1 | h2 <;> omega
      refine ⟨fun γ w hw ↦ ⟨Function.update_of_ne (hne hw) _ _, Function.update_of_ne (hne hw) _ _⟩,
        fun γ₁ γ₂ h u hu ↦ ?_⟩
      dsimp [GroupUnary.RevCompute.invBits]
      by_cases hut : u = t
      · subst hut; simp [h u hp.2, h c hp.1]
      · simp [Function.update_of_ne hut, h u hu]
  | andGate c1 c2 a _ _ _ =>
      have hne {w : Wire N} (hw : lo ≤ w.val ∧ w.val < hi) : w ≠ a :=
        fun he ↦ by subst he; rcases hp.2.2 with h1 | h2 <;> omega
      refine ⟨fun γ w hw ↦ ⟨Function.update_of_ne (hne hw) _ _, Function.update_of_ne (hne hw) _ _⟩,
        fun γ₁ γ₂ h u hu ↦ ?_⟩
      dsimp [GroupUnary.RevCompute.invBits]
      by_cases hua : u = a
      · subst hua; simp [h u hp.2.2, h c1 hp.1, h c2 hp.2.1]
      · simp [Function.update_of_ne hua, h u hu]
  | seq p1 p2 ih1 ih2 =>
      obtain ⟨hf1, hi1⟩ := ih1 hp.1
      obtain ⟨hf2, hi2⟩ := ih2 hp.2
      refine ⟨fun γ w hw ↦ ⟨(hf2 _ w hw).1.trans (hf1 _ w hw).1,
        (hf1 _ w hw).2.trans (hf2 _ w hw).2⟩, fun γ₁ γ₂ h u hu ↦ ?_⟩
      exact hi1 _ _ (hi2 γ₁ γ₂ h) u hu

theorem revDisjRange_cnotMaskRev {N : ℕ} (lo hi : ℕ) (tgt : Wire N)
    (htgt : tgt.val < lo ∨ hi ≤ tgt.val) :
    ∀ (M : ℕ) (rSrc : QRegister M N) (hne : ∀ i, rSrc i ≠ tgt) (mask : Fin M → Bool),
      (∀ i : Fin M, (rSrc i).val < lo ∨ hi ≤ (rSrc i).val) →
      RevDisjRange lo hi (cnotMaskRev tgt M rSrc hne mask)
  | 0, _, _, _, _ => trivial
  | M + 1, rSrc, hne, mask, hsrc => by
      dsimp only [cnotMaskRev, RevDisjRange]
      refine ⟨?_, revDisjRange_cnotMaskRev lo hi tgt htgt M _ _ _
        fun j ↦ hsrc (Fin.castLE (Nat.le_succ M) j)⟩
      split_ifs
      · exact ⟨hsrc ⟨M, Nat.lt_succ_self M⟩, htgt⟩
      · trivial

theorem revDisjRange_splitRevLoop {N : ℕ} (lo hi : ℕ) (ctrl : Wire N)
    (hctrl : ctrl.val < lo ∨ hi ≤ ctrl.val) :
    ∀ (R : ℕ) (w0 w1 : Fin R → Wire N) (hd : WPairDisj R ctrl w0 w1),
      (∀ i, (w0 i).val < lo ∨ hi ≤ (w0 i).val) →
      (∀ i, (w1 i).val < lo ∨ hi ≤ (w1 i).val) →
      RevDisjRange lo hi (splitRevLoop ctrl R w0 w1 hd)
  | 0, _, _, _, _, _ => trivial
  | R + 1, _, _, _, hw0, hw1 =>
      ⟨⟨⟨hctrl, hw0 0, hw1 0⟩, ⟨hw1 0, hw0 0⟩⟩,
        revDisjRange_splitRevLoop lo hi ctrl hctrl R _ _ _
          (fun i ↦ hw0 i.succ) (fun i ↦ hw1 i.succ)⟩

theorem revDisjRange_of_usesOnly {N : ℕ} (lo hi : ℕ) {p : GroupUnary.RevCompute N}
    (hp : p.UsesOnly {w : Wire N | w.val < lo ∨ hi ≤ w.val}) :
    RevDisjRange lo hi p := by
  induction p with
  | id => trivial
  | x q => exact hp
  | cnot c t _ => exact hp
  | andGate c1 c2 a _ _ _ => exact hp
  | seq p1 p2 ih1 ih2 => exact ⟨ih1 hp.1, ih2 hp.2⟩

theorem revDisjRange_pairedLac4Loop {N P : ℕ} (lo hi : ℕ)
    (rHot : QRegister 46 N) (wX0 wX1 wS01 : Wire N) (rScr : QRegister (3 * P + 2) N)
    (hHotScr : rHot.DisjointWires rScr)
    (h0 : ∀ j, wX0 ≠ rScr j) (h1 : ∀ j, wX1 ≠ rScr j) (h01 : ∀ j, wS01 ≠ rScr j)
    (cols : Fin (2 * P) → Fin 184 → Bool)
    (hHot : ∀ i, (rHot i).val < lo ∨ hi ≤ (rHot i).val)
    (hx0 : wX0.val < lo ∨ hi ≤ wX0.val) (hx1 : wX1.val < lo ∨ hi ≤ wX1.val)
    (hs01 : wS01.val < lo ∨ hi ≤ wS01.val)
    (hScr : ∀ j, (rScr j).val < lo ∨ hi ≤ (rScr j).val)
    (m : ℕ) (hm : m ≤ P) :
    RevDisjRange lo hi
      (DyadicXMeasPrepOut13.pairedLac4Loop rHot wX0 wX1 wS01 rScr hHotScr h0 h1 h01 cols m hm) :=
  revDisjRange_of_usesOnly lo hi
    (DyadicXMeasPrepOut13.usesOnly_pairedLac4Loop rHot wX0 wX1 wS01 rScr hHotScr h0 h1 h01 cols
      hHot hx0 hx1 hs01 hScr m hm)

/-- Generic ket formula for `rSub.embedUnitary U` when `U` permutes computational basis kets. -/
theorem embedUnitary_ketPerm_mulVec_ket {N k : ℕ} (rSub : QRegister k N)
    (U : Unitary (2 ^ k)) (f : BitAssignment k → BitAssignment k)
    (hU : ∀ γ : BitAssignment k, U.1.mulVec (SelectSwapQROM.ket γ) = SelectSwapQROM.ket (f γ))
    (β : BitAssignment N) :
    (rSub.embedUnitary U).1.mulVec (SelectSwapQROM.ket β) =
      SelectSwapQROM.ket (Comparators.writeReg β rSub (f (fun i ↦ β (rSub i)))) := by
  rw [QRegister.embedUnitary_val, Comparators.embedMatrix_mulVec_ket]
  have hcol (l : Fin (2 ^ k)) :
      U.1 l (Comparators.localIdx rSub β) =
        (U.1.mulVec (SelectSwapQROM.ket (fun i ↦ β (rSub i)))) l := by
    change U.1 l _ = (U.1.mulVec (basisState (Comparators.localIdx rSub β))) l
    simp [basisState]
  simp_rw [hcol, hU (fun i ↦ β (rSub i))]
  rw [Finset.sum_eq_single ((basisBits k).symm (f (fun i ↦ β (rSub i))))]
  · simp only [SelectSwapQROM.ket, basisState, Pi.single_eq_same, one_smul,
      SelectSwapQROM.basisBits_symm]
  · intro l _ hl; simp [SelectSwapQROM.ket, basisState, Pi.single_eq_of_ne hl]
  · simp

theorem parityPhaseTable_zmod2 :
    ∀ (b : ℕ) (T : ℕ → (Fin b → Bool)) (m : Fin (2 ^ b)) (idx : ℕ),
      ((if SelectSwapQROM.parityPhaseTable b T m idx then 1 else 0) : ZMod 2) =
        ∑ j : Fin b, basisBits b m j * (if T idx j then 1 else 0)
  | 0, _, _, _ => by simp [SelectSwapQROM.parityPhaseTable]
  | b + 1, T, m, idx => by
      let T_lo : ℕ → (Fin b → Bool) := fun q j ↦ T q (Fin.castLE (Nat.le_succ b) j)
      let iLast : Fin (b + 1) := ⟨b, Nat.lt_succ_self b⟩
      have hxor (u v : Bool) :
          ((if xor u v then 1 else 0) : ZMod 2) =
            (if u then 1 else 0) + (if v then 1 else 0) := by
        cases u <;> cases v <;> decide
      rw [Fin.sum_univ_castSucc, SelectSwapQROM.parityPhaseTable]
      by_cases hm : m.val < 2 ^ b
      · simp only [hm, ↓reduceDIte]
        rw [parityPhaseTable_zmod2 b T_lo ⟨m.val, hm⟩ idx]
        have hlast0 : basisBits (b + 1) m iLast = 0 := by
          rw [basisBits_eq_testBit, Nat.testBit_lt_two_pow hm]; rfl
        have hlo (j : Fin b) :
            basisBits b ⟨m.val, hm⟩ j = basisBits (b + 1) m (Fin.castSucc j) := by
          rw [basisBits_eq_testBit, basisBits_eq_testBit]; rfl
        rw [show Fin.last b = iLast from rfl, hlast0, zero_mul, add_zero]
        exact Finset.sum_congr rfl fun j _ ↦ by rw [hlo j]; rfl
      · simp only [hm, ↓reduceDIte]
        rw [hxor,
          parityPhaseTable_zmod2 b T_lo ⟨m.val - 2 ^ b, by
            have hm2 : m.val < 2 * 2 ^ b := by simpa [pow_succ'] using m.isLt
            omega⟩ idx]
        have hm2 : m.val < 2 * 2 ^ b := by simpa [pow_succ'] using m.isLt
        have hm_eq : m.val = (m.val - 2 ^ b) + 2 ^ b := by omega
        have hlast1 : basisBits (b + 1) m iLast = 1 := by
          rw [basisBits_eq_div_mod]
          have hle : 1 ≤ m.val / 2 ^ b :=
            (Nat.le_div_iff_mul_le (Nat.two_pow_pos b)).mpr (by omega)
          have hlt : m.val / 2 ^ b < 2 :=
            (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos b)).mpr hm2
          have hdiv : m.val / 2 ^ b = 1 := by omega
          simp [iLast, hdiv]
        have hlo (j : Fin b) :
            basisBits b ⟨m.val - 2 ^ b, by omega⟩ j =
              basisBits (b + 1) m (Fin.castSucc j) := by
          rw [basisBits_eq_div_mod, basisBits_eq_div_mod]
          dsimp only [Fin.val_castSucc]
          have hpow : 2 ^ b = 2 ^ j.val * (2 * 2 ^ (b - 1 - j.val)) := by
            have hj : j.val < b := j.isLt
            calc 2 ^ b = 2 ^ (j.val + 1 + (b - 1 - j.val)) := by congr 1; omega
              _ = 2 ^ j.val * (2 * 2 ^ (b - 1 - j.val)) := by ring
          have hm_eq2 : m.val = (m.val - 2 ^ b) + 2 ^ j.val * (2 * 2 ^ (b - 1 - j.val)) := by
            rw [← hpow]; exact hm_eq
          have hdiv : m.val / 2 ^ j.val =
              (m.val - 2 ^ b) / 2 ^ j.val + 2 * 2 ^ (b - 1 - j.val) := by
            conv_lhs => rw [hm_eq2]
            exact Nat.add_mul_div_left (m.val - 2 ^ b) (2 * 2 ^ (b - 1 - j.val))
              (Nat.two_pow_pos j.val)
          rw [hdiv, Nat.add_mul_mod_self_left]
        rw [show Fin.last b = iLast from rfl, hlast1, one_mul, add_comm]
        congr 1
        exact Finset.sum_congr rfl fun j _ ↦ by rw [hlo j]; rfl

theorem diagScalar_mul_predProj {N : ℕ} (U : Unitary (2 ^ N))
    (f : BitAssignment N → ℂ)
    (hU : ∀ γ, U.1.mulVec (SelectSwapQROM.ket γ) = f γ • SelectSwapQROM.ket γ)
    (S : BitAssignment N → Bool) :
    U.1 * GroupUnary.predProj S = GroupUnary.predProj S * U.1 := by
  apply SelectSwapQROM.matrix_ext_ket; intro γ
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, predProj_mulVec_ket, hU,
    Matrix.mulVec_smul, predProj_mulVec_ket]
  by_cases hS : S γ = true
  · rw [ite_eq_left hS, hU]
  · rw [ite_eq_right hS, Matrix.mulVec_zero, smul_zero]

theorem cleanUnloadsSet_empty_of_cleanRealizesSet_inv {Var : Type} [Fintype Var]
    [DecidableEq Var] {N : ℕ} [NeZero (2 ^ N)] {v : Var} {S : Finset (Wire N)}
    {W : Unitary (2 ^ N)} {P : DynamicCircuit Var N}
    (h : SelectSwapQROM.CleanRealizesSet v S W⁻¹ P)
    (hComm : W.1 * SelectSwapQROM.zeroProjOn S = SelectSwapQROM.zeroProjOn S * W.1) :
    SelectSwapQROM.CleanUnloadsSet v S ∅ W 1 P := by
  have hAdj : SelectSwapQROM.zeroProjOn S * W.1ᴴ = W.1ᴴ * SelectSwapQROM.zeroProjOn S := by
    simpa only [conjTranspose_mul, SelectSwapQROM.zeroProjOn_conjTranspose] using
      congrArg conjTranspose hComm
  have hW (Ψ : QCAssertion Var (2 ^ N)) :
      SelectSwapQROM.restrictZeroSet (qcWpQAssign W Ψ) S =
        qcWpQAssign W (SelectSwapQROM.restrictZeroSet Ψ S) := by
    funext σ; apply Subtype.ext
    simp only [SelectSwapQROM.restrictZeroSet_coe, qcWpQAssign, qcQAssignObsMap,
      Observable.conj_coe, Unitary.coe_star, Matrix.star_eq_conjTranspose, conj_conj, hAdj]
  refine ⟨h.1, h.2.1, fun Θ hΘ ↦ ?_,
    fun Θ ↦ by simpa only [Finset.sdiff_empty] using h.2.2.2 Θ⟩
  rw [hW, h.2.2.1 Θ hΘ, ← hW, qc_wp_qAssign_comp, inv_mul_cancel]

