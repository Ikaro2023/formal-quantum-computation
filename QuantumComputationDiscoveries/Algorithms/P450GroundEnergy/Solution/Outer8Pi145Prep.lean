      x % 4 = bit01Nat (β ⟨0, by omega⟩) + 2 * bit01Nat (β ⟨1, by omega⟩) ∧
      basisBits 4 ⟨c,
          by have := (Comparators.localIdx (QRegister.block 8 4 h12) β).isLt; omega⟩ =
        fun j : Fin 4 ↦ β ⟨8 + j.val, by omega⟩ := by
