theorem nat_eq_of_div_pow2_mod_eq :
    ∀ (n a b : ℕ), a < 2 ^ n → b < 2 ^ n →
      (∀ k < n, a / 2 ^ k % 2 = b / 2 ^ k % 2) → a = b
  | 0, a, b, ha, hb, _ => by omega
  | n + 1, a, b, ha, hb, h => by
    have h0 := h 0 (Nat.zero_lt_succ n)
    have ih := nat_eq_of_div_pow2_mod_eq n (a / 2) (b / 2)
      (by rw [pow_succ'] at ha; omega) (by rw [pow_succ'] at hb; omega)
      (fun k hk ↦ by
        have hk1 := h (k + 1) (Nat.succ_lt_succ hk)
        simpa only [pow_succ', ← Nat.div_div_eq_div_mul] using hk1)
    omega

theorem localIdx12_split_of_ge {N : ℕ} (h12 : 12 ≤ N) (β : BitAssignment N) :
