  have hx_lt : x < 256 := xFin.isLt
  have hc_lt : c < 16 := cFin.isLt
  have hb12 (k : ℕ) (hk : k < 12) : bit01Nat (β ⟨k, by omega⟩) = idx12 / 2 ^ k % 2 := by
    have hb : basisBits 12 idx12Fin ⟨k, hk⟩ = β ⟨k, by omega⟩ :=
      (congrFun (Comparators.basisBits_basisBitsEquiv_symm
        (fun i ↦ β (QRegister.block 0 12 h12 i))) ⟨k, hk⟩).trans (by simp)
    have hidx : idx12 = idx12Fin.val := rfl
    rw [← hb, basisBits_eq_div_mod, hidx]; dsimp only [bit01Nat]
    rcases Nat.mod_two_eq_zero_or_one (idx12Fin.val / 2 ^ k) with hm | hm <;> simp [hm]
  have hbx (k : ℕ) (hk : k < 8) : bit01Nat (β ⟨k, by omega⟩) = x / 2 ^ k % 2 := by
    have hb : basisBits 8 xFin ⟨k, hk⟩ = β ⟨k, by omega⟩ :=
      (congrFun (Comparators.basisBits_basisBitsEquiv_symm
        (fun i ↦ β (QRegister.block 0 8 (by omega) i))) ⟨k, hk⟩).trans (by simp)
    have hx : x = xFin.val := rfl
    rw [← hb, basisBits_eq_div_mod, hx]; dsimp only [bit01Nat]
    rcases Nat.mod_two_eq_zero_or_one (xFin.val / 2 ^ k) with hm | hm <;> simp [hm]
  have hbc (j : ℕ) (hj : j < 4) : bit01Nat (β ⟨8 + j, by omega⟩) = c / 2 ^ j % 2 := by
    have hb : basisBits 4 cFin ⟨j, hj⟩ = β ⟨8 + j, by omega⟩ :=
      (congrFun (Comparators.basisBits_basisBitsEquiv_symm
        (fun i ↦ β (QRegister.block 8 4 h12 i))) ⟨j, hj⟩).trans (by simp)
    have hc : c = cFin.val := rfl
    rw [← hb, basisBits_eq_div_mod, hc]; dsimp only [bit01Nat]
    rcases Nat.mod_two_eq_zero_or_one (cFin.val / 2 ^ j) with hm | hm <;> simp [hm]
  have hsplit : idx12 = x + 256 * c :=
    nat_eq_of_div_pow2_mod_eq 12 idx12 (x + 256 * c) h12_lt (by omega) fun k hk ↦ by
      by_cases hk8 : k < 8
      · rw [← hb12 k hk, hbx k hk8]
        interval_cases k <;> omega
      · rw [← hb12 k hk]
        have heq : (⟨k, by omega⟩ : Wire N) = ⟨8 + (k - 8), by omega⟩ := Fin.ext (by dsimp; omega)
        rw [heq, hbc (k - 8) (by omega)]
        interval_cases k <;> omega
  have hx0 := hbx 0 (by decide); have hx1 := hbx 1 (by decide)
  refine ⟨h12_lt, by omega, by omega, by omega, ?_⟩
  have hc_eq : (⟨c, by have := cFin.isLt; omega⟩ : Fin (2 ^ 4)) = cFin := Fin.ext rfl
  rw [hc_eq]
  exact (Comparators.basisBits_basisBitsEquiv_symm _).trans
    (by funext j; simp)

/-! ### `24-T` (`12`-Active, `3`-Scratch) Guarded `4`-Bit CSWAP (`cswap15Dyn`) -/

/-- Involutive `12`-bit map swapping `(2↔8, 3↔9, 6↔10, 7↔11)` when
guard `1 + x₇ * x₆ + a₃ * a₂ = 1`. -/
def cswap12Bits (γ : BitAssignment 12) : BitAssignment 12 :=
  let en : ZMod 2 := 1 + γ 7 * γ 6 + γ 11 * γ 10
  if en = 1 then
    fun w ↦
      match w.val with
      | 2 => γ 8
      | 3 => γ 9
      | 6 => γ 10
      | 7 => γ 11
      | 8 => γ 2
      | 9 => γ 3
      | 10 => γ 6
      | 11 => γ 7
      | _ => γ w
  else γ

theorem cswap12Bits_guard_inv (γ : BitAssignment 12) :
    cswap12Bits γ 7 * cswap12Bits γ 6 = γ 7 * γ 6 ∧
      cswap12Bits γ 11 * cswap12Bits γ 10 = γ 11 * γ 10 := by
  dsimp only [cswap12Bits]
  rcases SelectSwapQROM.bit_cases (γ 7) with x7 | x7 <;>
    rcases SelectSwapQROM.bit_cases (γ 6) with x6 | x6 <;>
    rcases SelectSwapQROM.bit_cases (γ 11) with a3 | a3 <;>
    rcases SelectSwapQROM.bit_cases (γ 10) with a2 | a2 <;>
    simp [x7, x6, a3, a2]

theorem cswap12Bits_involutive : Function.Involutive cswap12Bits := by
  intro γ
  obtain ⟨hp1, hp2⟩ := cswap12Bits_guard_inv γ
  have hen_eq : (1 + cswap12Bits γ 7 * cswap12Bits γ 6 +
      cswap12Bits γ 11 * cswap12Bits γ 10) =
      (1 + γ 7 * γ 6 + γ 11 * γ 10) := by
    rw [hp1, hp2]
  have houter : cswap12Bits (cswap12Bits γ) =
      if (1 + cswap12Bits γ 7 * cswap12Bits γ 6 +
          cswap12Bits γ 11 * cswap12Bits γ 10 : ZMod 2) = 1 then
        fun w ↦
          match w.val with
          | 2 => cswap12Bits γ 8 | 3 => cswap12Bits γ 9
          | 6 => cswap12Bits γ 10 | 7 => cswap12Bits γ 11
          | 8 => cswap12Bits γ 2 | 9 => cswap12Bits γ 3
          | 10 => cswap12Bits γ 6 | 11 => cswap12Bits γ 7
          | _ => cswap12Bits γ w
      else cswap12Bits γ := rfl
  rw [houter, hen_eq]
  by_cases hen : (1 + γ 7 * γ 6 + γ 11 * γ 10 : ZMod 2) = 1
  · rw [ite_eq_left hen]; funext w
    fin_cases w <;> (dsimp only [cswap12Bits]; rw [ite_eq_left hen]; rfl)
  · rw [ite_eq_right hen]; unfold cswap12Bits; dsimp only; rw [ite_eq_right hen]

/-- Pure `12`-qubit unitary executing `cswap12Bits`. -/
noncomputable def cswap12Unitary : Unitary (2 ^ 12) :=
  (BijectiveBitMap.ofInvolutive cswap12Bits cswap12Bits_involutive).toUnitary

theorem cswap12Unitary_mul_self : cswap12Unitary * cswap12Unitary = 1 := by
  apply Subtype.ext; apply SelectSwapQROM.matrix_ext_ket; intro γ
  change (cswap12Unitary.1 * cswap12Unitary.1).mulVec _ = (1 : Matrix _ _ ℂ).mulVec _
  rw [Matrix.one_mulVec, ← Matrix.mulVec_mulVec]
  dsimp only [cswap12Unitary]
  rw [BijectiveBitMap.toUnitary_mulVec_ket, BijectiveBitMap.toUnitary_mulVec_ket]
  exact congrArg SelectSwapQROM.ket (cswap12Bits_involutive γ)

/-- `4-T` (`0 TOFF`) single-pair Fredkin gate controlled on wire `13` using clean ancilla `14`. -/
def fredkinPair15Dyn {Var : Type} (v : Var) (a b : Wire 15)
    (hab : a ≠ b) (h13b : (13 : Wire 15) ≠ b)
    (hb14 : b ≠ 14) (ha14 : a ≠ 14) : DynamicCircuit Var 15 :=
  let pAnd : GroupUnary.RevCompute 15 :=
    .andGate 13 b 14 h13b (by decide) hb14
  .seq (.circuit (Circuit.CNOT a b hab))
    (.seq (Lac2Folded184Select.revComputeDyn pAnd)
      (.seq (.circuit (Circuit.CNOT 14 a ha14.symm))
        (.seq (Lac2Folded184Select.revUncomputeDyn v pAnd)
          (.circuit (Circuit.CNOT a b hab)))))

/-- `2`-AND (`8-T`) guard computation `12 := x₇ * x₆`, `13 := 1 + x₇ * x₆ + a₃ * a₂`. -/
def guard2Rev : GroupUnary.RevCompute 15 :=
  .seq (.andGate 7 6 12 (by decide) (by decide) (by decide))
    (.seq (.andGate 11 10 13 (by decide) (by decide) (by decide))
      (.seq (.cnot 12 13 (by decide)) (.x 13)))

theorem guard2Rev_fwdBits (γ : BitAssignment 15) :
    (∀ u : Wire 15, u.val < 12 → guard2Rev.fwdBits γ u = γ u) ∧
    guard2Rev.fwdBits γ 12 = γ 12 + γ 7 * γ 6 ∧
    guard2Rev.fwdBits γ 13 =
      γ 13 + γ 11 * γ 10 + (γ 12 + γ 7 * γ 6) + 1 ∧
    guard2Rev.fwdBits γ 14 = γ 14 := by
  dsimp only [guard2Rev, GroupUnary.RevCompute.fwdBits]
  refine ⟨fun u hu ↦ ?_, ?_, ?_, ?_⟩
  · have hu13 : u ≠ 13 := fun h ↦ by subst u; omega
    have hu12 : u ≠ 12 := fun h ↦ by subst u; omega
    rw [Function.update_of_ne hu13, Function.update_of_ne hu13,
      Function.update_of_ne hu13, Function.update_of_ne hu12]
  · rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
      Function.update_of_ne (by decide), Function.update_self]
  · rw [Function.update_self, Function.update_self,
      Function.update_of_ne (by decide : (12 : Wire 15) ≠ 13),
      Function.update_self, Function.update_self,
      Function.update_of_ne (by decide : (13 : Wire 15) ≠ 12),
      Function.update_of_ne (by decide : (11 : Wire 15) ≠ 12),
      Function.update_of_ne (by decide : (10 : Wire 15) ≠ 12)]
  · rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
      Function.update_of_ne (by decide), Function.update_of_ne (by decide)]

/-- `24-T` (`0 TOFF`, `12` active + `3` scratch = `15` wires) guarded `4`-bit CSWAP circuit. -/
def cswap15Dyn {Var : Type} (v : Var) : DynamicCircuit Var 15 :=
  let f (j : Fin 4) : DynamicCircuit Var 15 :=
    fredkinPair15Dyn v ⟨(ret4Idx j).val, by have := (ret4Idx j).isLt; omega⟩
      ⟨8 + j.val, by omega⟩
      (fun h ↦ by have hv := congrArg Fin.val h; have hj := (ret4Idx j).isLt; dsimp at hv; omega)
      (fun h ↦ by have := congrArg Fin.val h; try dsimp at this; omega)
      (fun h ↦ by have := congrArg Fin.val h; try dsimp at this; omega)
      (fun h ↦ by have hv := congrArg Fin.val h; have hj := (ret4Idx j).isLt; dsimp at hv; omega)
  .seq
    (.seq
      (.seq
        (.seq (.seq (Lac2Folded184Select.revComputeDyn guard2Rev) (f 0)) (f 1))
        (f 2))
      (f 3))
    (Lac2Folded184Select.revUncomputeDyn v guard2Rev)

@[simp]
theorem countCswap15Dyn_toff {Var : Type} (v : Var) :
    (cswap15Dyn v).count .TOFF = 0 := by
  simp [cswap15Dyn, fredkinPair15Dyn, guard2Rev, DynamicCircuit.count]

@[simp]
theorem countCswap15Dyn_t {Var : Type} (v : Var) :
    (cswap15Dyn v).count .T = 24 := by
  simp [cswap15Dyn, fredkinPair15Dyn, guard2Rev, DynamicCircuit.count,
    GroupUnary.RevCompute.numAnd]

/-- Classical `15`-wire Fredkin bit involution controlled by wire `13` swapping `a` and `b`. -/
def fredkinBits15 (a b : Wire 15) (β : BitAssignment 15) : BitAssignment 15 :=
  let d := β 13 * (β a + β b)
  Function.update (Function.update β a (β a + d)) b (β b + d)

theorem fredkinBits15_invol {a b : Wire 15} (hab : a ≠ b)
    (ha13 : a ≠ 13) (hb13 : b ≠ 13) :
    Function.Involutive (fredkinBits15 a b) := by
  intro β; funext w
  dsimp only [fredkinBits15]
  let d := β 13 * (β a + β b)
  have h13 : (Function.update (Function.update β a (β a + d)) b (β b + d)) 13 = β 13 := by
    rw [Function.update_of_ne hb13.symm, Function.update_of_ne ha13.symm]
  have ha : (Function.update (Function.update β a (β a + d)) b (β b + d)) a = β a + d := by
    rw [Function.update_of_ne hab, Function.update_self]
  have hb : (Function.update (Function.update β a (β a + d)) b (β b + d)) b = β b + d := by
    rw [Function.update_self]
  rw [h13, ha, hb]
  have hsum : (β a + d) + (β b + d) = β a + β b := by
    dsimp only [d]
    rcases SelectSwapQROM.bit_cases (β 13) with h1 | h1 <;>
      rcases SelectSwapQROM.bit_cases (β a) with h2 | h2 <;>
      rcases SelectSwapQROM.bit_cases (β b) with h3 | h3 <;>
      (rw [h1, h2, h3]; decide)
  rw [hsum]
  by_cases hwb : w = b
  · subst w; rw [Function.update_self]
    change β b + d + d = β b
    rw [add_assoc, zmod2_add_self, add_zero]
  · by_cases hwa : w = a
    · subst w; rw [Function.update_of_ne hab, Function.update_self]
      change β a + d + d = β a
      rw [add_assoc, zmod2_add_self, add_zero]
    · simp only [Function.update_of_ne hwb, Function.update_of_ne hwa]

theorem fredkinBits15_of_zero {a b : Wire 15} {γ : BitAssignment 15}
    (h0 : γ 13 = 0) : fredkinBits15 a b γ = γ := by
  funext w; dsimp only [fredkinBits15]
  rw [h0, zero_mul, add_zero, add_zero]
  by_cases hwb : w = b
  · subst w; rw [Function.update_self]
  · by_cases hwa : w = a
    · subst w; rw [Function.update_of_ne hwb, Function.update_self]
    · rw [Function.update_of_ne hwb, Function.update_of_ne hwa]

theorem fredkinBits15_apply_of_one (a b : Wire 15) {γ : BitAssignment 15}
    (h1 : γ 13 = 1) (w : Wire 15) :
    fredkinBits15 a b γ w =
      if w = b then γ a else if w = a then γ b else γ w := by
  dsimp only [fredkinBits15]
  have hsw1 : γ a + (γ a + γ b) = γ b := by rw [← add_assoc, zmod2_add_self, zero_add]
  have hsw2 : γ b + (γ a + γ b) = γ a := by
    rw [add_comm (γ a) (γ b), ← add_assoc, zmod2_add_self, zero_add]
  rw [h1, one_mul, hsw1, hsw2]
  by_cases hwb : w = b
  · subst w; simp only [↓reduceIte, Function.update_self]
  · by_cases hwa : w = a
    · subst w; simp only [hwb, ↓reduceIte, Function.update_of_ne hwb, Function.update_self]
    · simp only [hwb, hwa, ↓reduceIte, Function.update_of_ne hwb, Function.update_of_ne hwa]

/-- Bijective bit-assignment map for running `p` in reverse (`fwd := p.invBits`). -/
def bijectiveBitMapOfRevUncompute {N : ℕ} (p : GroupUnary.RevCompute N) :
    BijectiveBitMap N where
  fwd := p.invBits
  inv := p.fwdBits
  inv_fwd := p.fwdBits_invBits
  fwd_inv := p.invBits_fwdBits

theorem toUnitary_bijectiveBitMapOfRevUncompute {N : ℕ} (p : GroupUnary.RevCompute N) :
    (bijectiveBitMapOfRevUncompute p).toUnitary = (p.toCircuit.eval)⁻¹ := by
  apply eq_inv_of_mul_eq_one_left
  rw [← BijectiveBitMap.toUnitary_ofRevCompute, BijectiveBitMap.toUnitary_seq]
  apply Subtype.ext; apply SelectSwapQROM.matrix_ext_ket; intro β
  rw [BijectiveBitMap.toUnitary_mulVec_ket]
  change _ = (1 : Matrix _ _ ℂ).mulVec _
  rw [Matrix.one_mulVec]
  dsimp only [BijectiveBitMap.compBitMap, BijectiveBitMap.ofRevCompute,
    bijectiveBitMapOfRevUncompute]
  rw [p.invBits_fwdBits]

theorem bijectiveTransRealizes_ofRevUncomputeBij {Var : Type} [Fintype Var] [DecidableEq Var]
    {N : ℕ} (v : Var) (p : GroupUnary.RevCompute N) (S : BitAssignment N → Bool)
    (hval : ∀ β, S (p.fwdBits β) = true → p.validOn β = true) :
    BijectiveTransRealizes v S (bijectiveBitMapOfRevUncompute p)
      (Lac2Folded184Select.revUncomputeDyn v p) := by
  unfold BijectiveTransRealizes
  rw [toUnitary_bijectiveBitMapOfRevUncompute]
  have hpre : S = fun γ ↦ (fun ξ ↦ S (p.fwdBits ξ)) (p.invBits γ) := by
    funext γ; dsimp only; rw [p.fwdBits_invBits]
  exact (TransRealizes.uncomputeDyn v p (fun ξ ↦ S (p.fwdBits ξ)) hval).congr_pred hpre.symm rfl

theorem bijectiveTransRealizesFredkinPair15Dyn {Var : Type} [Fintype Var]
    [DecidableEq Var] (v : Var) (a b : Wire 15)
    (hab : a ≠ b) (ha13 : a ≠ 13) (hb13 : b ≠ 13)
    (ha14 : a ≠ 14) (hb14 : b ≠ 14)
    (S : BitAssignment 15 → Bool) (h14 : ∀ β, S β = true → β 14 = 0) :
    BijectiveTransRealizes v S
      (BijectiveBitMap.ofInvolutive (fredkinBits15 a b) (fredkinBits15_invol hab ha13 hb13))
      (fredkinPair15Dyn v a b hab hb13.symm hb14 ha14) := by
  have h13_14 : (13 : Wire 15) ≠ 14 := by decide
  let pCnot : GroupUnary.RevCompute 15 := .cnot a b hab
  let pAnd : GroupUnary.RevCompute 15 := .andGate 13 b 14 hb13.symm h13_14 hb14
  let pMid : GroupUnary.RevCompute 15 := .cnot 14 a ha14.symm
  have hc1 : (.circuit (Circuit.CNOT a b hab) : DynamicCircuit Var 15) =
      Lac2Folded184Select.revComputeDyn pCnot := rfl
  have hc2 : (.circuit (Circuit.CNOT 14 a ha14.symm) : DynamicCircuit Var 15) =
      Lac2Folded184Select.revComputeDyn pMid := rfl
  let m1 := BijectiveBitMap.ofRevCompute pCnot
  let m2 := BijectiveBitMap.ofRevCompute pAnd
  let m3 := BijectiveBitMap.ofRevCompute pMid
  let m4 := bijectiveBitMapOfRevUncompute pAnd
  let m5 := BijectiveBitMap.ofRevCompute pCnot
  let S1 : BitAssignment 15 → Bool := fun γ ↦ S (m1.inv γ)
  let S2 : BitAssignment 15 → Bool := fun γ ↦ S1 (m2.inv γ)
  let S3 : BitAssignment 15 → Bool := fun γ ↦ S2 (m3.inv γ)
  let S4 : BitAssignment 15 → Bool := fun γ ↦ S3 (m4.inv γ)
  have b1 := BijectiveTransRealizes.ofRevComputeBij v pCnot S (fun _ _ ↦ rfl)
  have b2 := BijectiveTransRealizes.ofRevComputeBij v pAnd S1 fun γ hγ ↦ by
    simp only [pAnd, GroupUnary.RevCompute.validOn, beq_iff_eq]
    have h0 := h14 (pCnot.invBits γ) hγ
    dsimp only [pCnot, GroupUnary.RevCompute.invBits] at h0
    rwa [Function.update_of_ne hb14.symm] at h0
  have b3 := BijectiveTransRealizes.ofRevComputeBij v pMid S2 (fun _ _ ↦ rfl)
  have b4 := bijectiveTransRealizes_ofRevUncomputeBij v pAnd S3 fun ξ hξ ↦ by
    simp only [pAnd, GroupUnary.RevCompute.validOn, beq_iff_eq]
    have h0 := h14 (pCnot.invBits (pAnd.invBits (pMid.invBits (pAnd.fwdBits ξ)))) hξ
    dsimp only [pCnot, pAnd, pMid, GroupUnary.RevCompute.fwdBits,
      GroupUnary.RevCompute.invBits] at h0
    rw [Function.update_of_ne hb14.symm, Function.update_self,
      Function.update_of_ne ha14.symm, Function.update_of_ne ha13.symm,
      Function.update_of_ne hab.symm, Function.update_self,
      Function.update_of_ne h13_14, Function.update_of_ne hb14,
      add_assoc, zmod2_add_self, add_zero] at h0
    exact h0
  have b5 := BijectiveTransRealizes.ofRevComputeBij v pCnot S4 (fun _ _ ↦ rfl)
  have hFwdEq (β : BitAssignment 15) (hS : S β = true) :
      (m1.compBitMap (m2.compBitMap (m3.compBitMap (m4.compBitMap m5)))).fwd β =
        fredkinBits15 a b β := by
    have h0 := h14 β hS
    let ν1 := Function.update β b (β b + β a)
    let ν2 := Function.update ν1 14 (ν1 14 + ν1 13 * ν1 b)
    let ν3 := Function.update ν2 a (ν2 a + ν2 14)
    let ν4 := Function.update ν3 14 (ν3 14 + ν3 13 * ν3 b)
    have hν2_14 : ν2 14 = β 13 * (β a + β b) := by
      dsimp only [ν2, ν1]
      rw [Function.update_self, Function.update_of_ne hb14.symm,
        Function.update_of_ne hb13.symm, Function.update_self, h0, zero_add, add_comm (β b) (β a)]
    have hν3_a : ν3 a = β a + β 13 * (β a + β b) := by
      dsimp only [ν3]; rw [Function.update_self, hν2_14]
      dsimp only [ν2, ν1]; rw [Function.update_of_ne ha14, Function.update_of_ne hab]
    have hν4_14 : ν4 14 = 0 := by
      dsimp only [ν4]
      rw [Function.update_self]
      dsimp only [ν3]
      rw [Function.update_of_ne ha14.symm, Function.update_of_ne ha13.symm,
        Function.update_of_ne hab.symm, hν2_14]
      dsimp only [ν2, ν1]
      rw [Function.update_of_ne h13_14, Function.update_of_ne hb14,
        Function.update_of_ne hb13.symm, Function.update_self, add_comm (β b) (β a),
        zmod2_add_self]
    have hν4_a : ν4 a = β a + β 13 * (β a + β b) := by
      dsimp only [ν4]; rw [Function.update_of_ne ha14, hν3_a]
    have hν4_b : ν4 b = β b + β a := by
      dsimp only [ν4, ν3, ν2, ν1]
      rw [Function.update_of_ne hb14, Function.update_of_ne hab.symm,
        Function.update_of_ne hb14, Function.update_self]
    funext w
    change Function.update ν4 b (ν4 b + ν4 a) w = fredkinBits15 a b β w
    dsimp only [fredkinBits15]
    by_cases hwb : w = b
    · subst w
      rw [Function.update_self, Function.update_self, hν4_b, hν4_a,
        add_assoc (β b), ← add_assoc (β a), zmod2_add_self, zero_add]
    · rw [Function.update_of_ne hwb, Function.update_of_ne hwb]
      by_cases hwa : w = a
      · subst w; rw [Function.update_self, hν4_a]
      · rw [Function.update_of_ne hwa]
        by_cases hw14 : w = 14
        · subst w; rw [hν4_14, h0]
        · dsimp only [ν4, ν3, ν2, ν1]
          rw [Function.update_of_ne hw14, Function.update_of_ne hwa,
            Function.update_of_ne hw14, Function.update_of_ne hwb]
  dsimp only [fredkinPair15Dyn]
  rw [hc1, hc2]
  exact (b1.seqBijTrans (b2.seqBijTrans (b3.seqBijTrans (b4.seqBijTrans b5)))).congr_fwd hFwdEq

theorem cleanRealizesCswap15Dyn {Var : Type} [Fintype Var] [DecidableEq Var] (v : Var) :
    Solution.CleanDyn.CleanRealizes v
      (QRegister.block 0 12 (by decide) : QRegister 12 15)
      (QRegister.block 12 3 (by decide) : QRegister 3 15)
      cswap12Unitary
      (cswap15Dyn v) := by
  let rAct12 : QRegister 12 15 := QRegister.block 0 12 (by decide)
  let rMain2 : QRegister 3 15 := QRegister.block 12 3 (by decide)
  let S0 : BitAssignment 15 → Bool := fun β ↦ decide (∀ j : Fin 3, β (rMain2 j) = 0)
  have hvG (β : BitAssignment 15) (hS : S0 β = true) : guard2Rev.validOn β = true := by
    have hc := of_decide_eq_true hS
    have h12 : β 12 = 0 := hc 0
    have h13 : β 13 = 0 := hc 1
    dsimp only [guard2Rev, GroupUnary.RevCompute.validOn, GroupUnary.RevCompute.fwdBits]
    rw [Function.update_of_ne (by decide : (13 : Wire 15) ≠ 12), h12, h13]
    decide
  have bG := BijectiveTransRealizes.ofRevComputeBij v guard2Rev S0 hvG
  let mF (j : Fin 4) := BijectiveBitMap.ofInvolutive
    (fredkinBits15 ⟨(ret4Idx j).val, by have := (ret4Idx j).isLt; omega⟩
      ⟨8 + j.val, by omega⟩)
    (fredkinBits15_invol
