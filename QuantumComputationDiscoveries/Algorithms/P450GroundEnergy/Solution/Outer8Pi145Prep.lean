    simp only [Function.update_of_ne (hne 15 (by decide) (by decide)),
      Function.update_of_ne (hne 14 (by decide) (by decide)),
      Function.update_of_ne (hne 13 (by decide) (by decide)),
      Function.update_of_ne (hne 12 (by decide) (by decide))]
  refine ⟨rfl, hfw β, fun u hu ↦ ?_, ?_, ?_, ?_, ?_⟩
  · have h := hfw (alt4CopyRev.invBits β) u hu
    rw [alt4CopyRev.fwdBits_invBits] at h; exact h.symm
  · simp [alt4CopyRev, GroupUnary.RevCompute.fwdBits]
  · simp [alt4CopyRev, GroupUnary.RevCompute.fwdBits]
  · simp [alt4CopyRev, GroupUnary.RevCompute.fwdBits]
