theorem zmod2_add_self (x : ZMod 2) : x + x = 0 :=
  CharTwo.add_self_eq_zero x

theorem qreg_block_apply {n : ℕ} (off w : ℕ) (h : off + w ≤ n) (i : Fin w) :
    QRegister.block off w h i = ⟨off + i.val, by omega⟩ :=
  Fin.ext rfl

theorem predProj_mulVec_ket {N : ℕ} (S : BitAssignment N → Bool) (β : BitAssignment N) :
    (GroupUnary.predProj S).mulVec (SelectSwapQROM.ket β) =
      if S β then SelectSwapQROM.ket β else 0 := by
  dsimp [GroupUnary.predProj, SelectSwapQROM.ket, basisState]
  rw [Matrix.diagonal_mulVec_single, SelectSwapQROM.basisBits_symm]
  split_ifs <;> simp

theorem basisOutcomeProjector_zero_eq_predProj {k N : ℕ} (r : QRegister k N) :
    r.basisOutcomeProjector 0 =
      GroupUnary.predProj (fun β ↦ decide (∀ i : Fin k, β (r i) = 0)) := by
  rw [Solution.XMeasCircuit.basisOutcomeProjector_zero_eq_cleanFinsetProj]
  ext i j
  simp only [Solution.XMeasCircuit.cleanFinsetProj, GroupUnary.predProj, Matrix.diagonal_apply,
    QRegister.mem_image, forall_exists_index, forall_apply_eq_imp_iff]
  by_cases hij : i = j <;> simp [hij]

theorem restrictAssertionToZeroAncilla_eq_restrictPred {Var : Type} [Fintype Var]
    {k N : ℕ} (r : QRegister k N) (Θ : QCAssertion Var (2 ^ N)) :
    restrictAssertionToZeroAncilla Θ r =
      GroupUnary.restrictPred (fun β ↦ decide (∀ i : Fin k, β (r i) = 0)) Θ := by
  funext σ; apply Subtype.ext
  simp [basisOutcomeProjector_zero_eq_predProj]

theorem restrictPred_restrictPred {Var : Type} [Fintype Var] {N : ℕ}
    (S₁ S₂ : BitAssignment N → Bool) (Θ : QCAssertion Var (2 ^ N)) :
    GroupUnary.restrictPred S₁ (GroupUnary.restrictPred S₂ Θ) =
      GroupUnary.restrictPred (fun β ↦ S₁ β && S₂ β) Θ := by
  funext σ; apply Subtype.ext
  simp [conj_conj, GroupUnary.predProj_mul]

theorem ketPerm_mul_predProj {N : ℕ} (V : Unitary (2 ^ N))
    (f : BitAssignment N → BitAssignment N)
    (hV : ∀ β, V.1.mulVec (SelectSwapQROM.ket β) = SelectSwapQROM.ket (f β))
    (S₁ S₂ : BitAssignment N → Bool) (hS : ∀ β, S₁ β = S₂ (f β)) :
    V.1 * GroupUnary.predProj S₁ = GroupUnary.predProj S₂ * V.1 := by
  apply SelectSwapQROM.matrix_ext_ket; intro β
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, predProj_mulVec_ket, hV,
    predProj_mulVec_ket, ← hS β]
  by_cases hs : S₁ β = true
  · rw [ite_eq_left hs, ite_eq_left hs, hV]
  · rw [ite_eq_right hs, ite_eq_right hs, Matrix.mulVec_zero]

/-- Subspace-restricted `0-TOFF` unitary transition contract from `S_pre` to `S_post`. -/
structure TransRealizes {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (S_pre S_post : BitAssignment N → Bool) (U : Unitary (2 ^ N))
    (P : DynamicCircuit Var N) : Prop where
  toff_zero : P.count .TOFF = 0
  map_proj : U.1 * GroupUnary.predProj S_pre = GroupUnary.predProj S_post * U.1
  update_self : ∀ Θ : QCAssertion Var (2 ^ N),
    (∀ σ val, Θ (Function.update σ v val) = Θ σ) →
    ∀ σ val, wp P.compile Θ (Function.update σ v val) = wp P.compile Θ σ
  wp_eq : ∀ Θ : QCAssertion Var (2 ^ N),
    (∀ σ val, Θ (Function.update σ v val) = Θ σ) →
    GroupUnary.restrictPred S_pre (wp P.compile Θ) =
      GroupUnary.restrictPred S_pre (qcWpQAssign U Θ)

theorem TransRealizes.map_proj_adj {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    {v : Var} {S_pre S_post : BitAssignment N → Bool} {U : Unitary (2 ^ N)}
    {P : DynamicCircuit Var N} (h : TransRealizes v S_pre S_post U P) :
    GroupUnary.predProj S_pre * U.1ᴴ = U.1ᴴ * GroupUnary.predProj S_post := by
  have h' := congrArg conjTranspose h.map_proj
  simpa [conjTranspose_mul, GroupUnary.predProj_conjTranspose] using h'

theorem TransRealizes.clean_post {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    {v : Var} {S_pre S_post : BitAssignment N → Bool} {U : Unitary (2 ^ N)}
    {P : DynamicCircuit Var N} (h : TransRealizes v S_pre S_post U P)
    (Θ : QCAssertion Var (2 ^ N)) :
    GroupUnary.restrictPred S_pre (wp P.compile (GroupUnary.restrictPred S_post Θ)) =
      GroupUnary.restrictPred S_pre (wp P.compile Θ) := by
  apply GroupUnary.wp_restrictPred_of_wp_compl_eq_zero P S_pre S_post _ Θ
  intro σ
  have hwp := congrFun
    (h.wp_eq (GroupUnary.constPredObs (fun β ↦ !S_post β)) (fun _ _ ↦ rfl)) σ
  rw [congrArg Subtype.val hwp]
  simp only [GroupUnary.restrictPred_coe, qcWpQAssign, qcQAssignObsMap, Observable.conj_coe,
    Unitary.coe_star, Matrix.star_eq_conjTranspose, GroupUnary.constPredObs, conj_conj]
  have hdisj : GroupUnary.predProj S_post * GroupUnary.predProj (fun β ↦ !S_post β) = 0 := by
    rw [GroupUnary.predProj_mul]; ext i j
    simp only [GroupUnary.predProj, Matrix.diagonal_apply, Matrix.zero_apply]
    by_cases hij : i = j
    · subst hij; by_cases hS : S_post (basisBits N i) = true <;> simp [hS]
    · simp [hij]
  have hmat0 : GroupUnary.predProj S_pre * (U.1ᴴ *
      GroupUnary.predProj (fun β ↦ !S_post β)) = 0 := by
    rw [← Matrix.mul_assoc, h.map_proj_adj, Matrix.mul_assoc, hdisj, Matrix.mul_zero]
  rw [hmat0]
  apply HermitianMat.ext; simp

theorem TransRealizes.identity {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (S : BitAssignment N → Bool) :
    TransRealizes v S S 1 (.identity : DynamicCircuit Var N) where
  toff_zero := rfl
  map_proj := by simp
  update_self Θ hΘ σ val := hΘ σ val
  wp_eq Θ _ := by funext σ; apply Subtype.ext; simp [qcWpQAssign, qcQAssignObsMap]

theorem TransRealizes.congr_pred {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    {v : Var} {S₁ S₁' S₂ S₂' : BitAssignment N → Bool} {U : Unitary (2 ^ N)}
    {P : DynamicCircuit Var N} (h₁ : S₁ = S₁') (h₂ : S₂ = S₂')
    (h : TransRealizes v S₁ S₂ U P) : TransRealizes v S₁' S₂' U P := by
  subst h₁ h₂; exact h

theorem TransRealizes.congr_unitary {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    {v : Var} {S_pre S_post : BitAssignment N → Bool} {U₁ U₂ : Unitary (2 ^ N)}
    {P : DynamicCircuit Var N}
    (hmap₂ : U₂.1 * GroupUnary.predProj S_pre = GroupUnary.predProj S_post * U₂.1)
    (heq : U₁.1 * GroupUnary.predProj S_pre = U₂.1 * GroupUnary.predProj S_pre)
    (h : TransRealizes v S_pre S_post U₁ P) :
    TransRealizes v S_pre S_post U₂ P where
  toff_zero := h.toff_zero
  map_proj := hmap₂
  update_self := h.update_self
  wp_eq Θ hΘ := by
    rw [h.wp_eq Θ hΘ]
    have hadj : GroupUnary.predProj S_pre * U₁.1ᴴ = GroupUnary.predProj S_pre * U₂.1ᴴ := by
      have h' := congrArg conjTranspose heq
      simpa [conjTranspose_mul, GroupUnary.predProj_conjTranspose] using h'
    funext σ; apply Subtype.ext
    simp only [GroupUnary.restrictPred_coe, qcWpQAssign, qcQAssignObsMap, Observable.conj_coe,
      Unitary.coe_star, Matrix.star_eq_conjTranspose, conj_conj]
    exact congrArg (fun X ↦ (Θ σ).1.conj X) hadj

theorem TransRealizes.seq {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    {v : Var} {S₁ S₂ S₃ : BitAssignment N → Bool} {U₁ U₂ : Unitary (2 ^ N)}
    {P₁ P₂ : DynamicCircuit Var N}
    (h₁ : TransRealizes v S₁ S₂ U₁ P₁) (h₂ : TransRealizes v S₂ S₃ U₂ P₂) :
    TransRealizes v S₁ S₃ (U₂ * U₁) (P₁.seq P₂) where
  toff_zero := by simp [h₁.toff_zero, h₂.toff_zero]
  map_proj := by
    change U₂.1 * U₁.1 * GroupUnary.predProj S₁ = GroupUnary.predProj S₃ * (U₂.1 * U₁.1)
    rw [Matrix.mul_assoc, h₁.map_proj, ← Matrix.mul_assoc, h₂.map_proj, Matrix.mul_assoc]
  update_self Θ hΘ σ val := h₁.update_self (wp P₂.compile Θ) (h₂.update_self Θ hΘ) σ val
  wp_eq Θ hΘ := by
    change GroupUnary.restrictPred S₁ (wp P₁.compile (wp P₂.compile Θ)) = _
    rw [← h₁.clean_post, h₂.wp_eq Θ hΘ, h₁.clean_post,
      h₁.wp_eq (qcWpQAssign U₂ Θ) (fun σ val ↦ by simp [qcWpQAssign, hΘ σ val]), qc_wp_qAssign_comp]

theorem TransRealizes.of_circuit {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) {S_pre S_post : BitAssignment N → Bool} (c : Circuit N)
    (htoff : c.count .TOFF = 0)
    (hmap : c.eval.1 * GroupUnary.predProj S_pre = GroupUnary.predProj S_post * c.eval.1) :
    TransRealizes v S_pre S_post c.eval (.circuit c) where
  toff_zero := htoff
  map_proj := hmap
  update_self Θ hΘ σ val := by simp [qcWpQAssign, hΘ σ val]
  wp_eq _ _ := by simp only [DynamicCircuit.compile_circuit, DynamicCircuit.qc_wp_circuit_compile]

theorem toCircuit_eval_mul_predProj {N : ℕ} (p : GroupUnary.RevCompute N)
    (S : BitAssignment N → Bool) :
    p.toCircuit.eval.1 * GroupUnary.predProj S =
      GroupUnary.predProj (fun γ ↦ S (p.invBits γ)) * p.toCircuit.eval.1 := by
  apply SelectSwapQROM.matrix_ext_ket; intro β
  have hket : SelectSwapQROM.ket = GroupUnary.ket (N := N) := rfl
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, predProj_mulVec_ket, hket,
    p.toCircuit_mulVec_ket, ← hket, predProj_mulVec_ket, p.invBits_fwdBits]
  by_cases hS : S β = true <;> simp [hS, p.toCircuit_mulVec_ket]

theorem toCircuit_eval_inv_mul_predProj {N : ℕ} (p : GroupUnary.RevCompute N)
    (S : BitAssignment N → Bool) :
    (p.toCircuit.eval⁻¹).1 * GroupUnary.predProj (fun γ ↦ S (p.invBits γ)) =
      GroupUnary.predProj S * (p.toCircuit.eval⁻¹).1 := by
  have h1 : (p.toCircuit.eval⁻¹).1 * p.toCircuit.eval.1 = 1 :=
    congrArg Subtype.val (inv_mul_cancel p.toCircuit.eval)
  have h2 : p.toCircuit.eval.1 * (p.toCircuit.eval⁻¹).1 = 1 :=
    congrArg Subtype.val (mul_inv_cancel p.toCircuit.eval)
  calc (p.toCircuit.eval⁻¹).1 * GroupUnary.predProj (fun γ ↦ S (p.invBits γ))
      = (p.toCircuit.eval⁻¹).1 *
          (GroupUnary.predProj (fun γ ↦ S (p.invBits γ)) * p.toCircuit.eval.1) *
          (p.toCircuit.eval⁻¹).1 := by
        rw [Matrix.mul_assoc _ _ (p.toCircuit.eval⁻¹).1,
          Matrix.mul_assoc (GroupUnary.predProj _), h2, Matrix.mul_one]
    _ = ((p.toCircuit.eval⁻¹).1 * p.toCircuit.eval.1) *
          (GroupUnary.predProj S * (p.toCircuit.eval⁻¹).1) := by
        rw [← toCircuit_eval_mul_predProj]
        simp only [Matrix.mul_assoc]
    _ = GroupUnary.predProj S * (p.toCircuit.eval⁻¹).1 := by rw [h1, Matrix.one_mul]

theorem revCompute_eval_inv_mulVec_ket {N : ℕ} (p : GroupUnary.RevCompute N)
    (ξ : BitAssignment N) :
    (p.toCircuit.eval⁻¹).1.mulVec (GroupUnary.ket ξ) =
      GroupUnary.ket (p.invBits ξ) := by
  have hinv : (p.toCircuit.eval⁻¹).1 * p.toCircuit.eval.1 = 1 :=
    congrArg Subtype.val (inv_mul_cancel p.toCircuit.eval)
  have h1 : (p.toCircuit.eval⁻¹).1.mulVec
      (p.toCircuit.eval.1.mulVec (GroupUnary.ket (p.invBits ξ))) =
      GroupUnary.ket (p.invBits ξ) := by
    rw [Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec]
  rwa [p.toCircuit_mulVec_ket, p.fwdBits_invBits] at h1

theorem inv_eq_self_of_mul_self {d : ℕ} (U : Unitary d) (h : U * U = 1) : U⁻¹ = U :=
  (eq_inv_of_mul_eq_one_left h).symm

theorem conjTranspose_eq_self_of_mul_self {d : ℕ} (U : Unitary d) (h : U * U = 1) :
    U.1ᴴ = U.1 := by
  have h1 : U.1ᴴ * (U.1 * U.1) = U.1ᴴ := by
    have hv : U.1 * U.1 = 1 := congrArg Subtype.val h
    rw [hv, Matrix.mul_one]
  have h2 : U.1ᴴ * U.1 = 1 := by simpa [Matrix.star_eq_conjTranspose] using (SetLike.coe_mem U).1
  rw [← Matrix.mul_assoc, h2, Matrix.one_mul] at h1
  exact h1.symm

theorem revCompute_mul_self_of_fwdBits_invol {N : ℕ} (p : GroupUnary.RevCompute N)
    (h : ∀ β, p.fwdBits (p.fwdBits β) = β) :
    p.toCircuit.eval * p.toCircuit.eval = 1 := by
  apply Subtype.ext; apply SelectSwapQROM.matrix_ext_ket; intro β
  have hket : SelectSwapQROM.ket = GroupUnary.ket (N := N) := rfl
  change (p.toCircuit.eval.1 * p.toCircuit.eval.1).mulVec _ = (1 : Operator _).mulVec _
  rw [hket, ← Matrix.mulVec_mulVec, p.toCircuit_mulVec_ket, p.toCircuit_mulVec_ket, h,
    Matrix.one_mulVec]

theorem TransRealizes.computeDyn {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (p : GroupUnary.RevCompute N) (S : BitAssignment N → Bool)
    (hval : ∀ β, S β = true → p.validOn β = true) :
    TransRealizes v S (fun γ ↦ S (p.invBits γ)) p.toCircuit.eval
      (Lac2Folded184Select.revComputeDyn p) := by
  induction p generalizing S with
  | id => exact TransRealizes.identity v S
  | x q =>
      refine ⟨rfl, toCircuit_eval_mul_predProj (.x q) S,
        fun Θ hΘ σ val ↦ by simp [Lac2Folded184Select.revComputeDyn, qcWpQAssign, hΘ σ val],
        fun _ _ ↦ by
          simp only [Lac2Folded184Select.revComputeDyn, DynamicCircuit.compile_circuit,
            DynamicCircuit.qc_wp_circuit_compile, GroupUnary.RevCompute.toCircuit]⟩
  | cnot c t h =>
      refine ⟨rfl, toCircuit_eval_mul_predProj (.cnot c t h) S,
        fun Θ hΘ σ val ↦ by simp [Lac2Folded184Select.revComputeDyn, qcWpQAssign, hΘ σ val],
        fun _ _ ↦ by
          simp only [Lac2Folded184Select.revComputeDyn, DynamicCircuit.compile_circuit,
            DynamicCircuit.qc_wp_circuit_compile, GroupUnary.RevCompute.toCircuit]⟩
  | andGate c₁ c₂ anc h₁₂ h₁a h₂a =>
      have hS_eq : S = fun β ↦ S β && decide (∀ i : Fin 1, β (QRegister.singleton anc i) = 0) := by
        funext β
        by_cases hS : S β = true
        · have hall : ∀ i : Fin 1, β (QRegister.singleton anc i) = 0 :=
            fun _ ↦ beq_iff_eq.mp (hval β hS)
          rw [hS, Bool.true_and, eq_comm, decide_eq_true_iff]
          exact hall
        · rw [Bool.eq_false_iff.mpr hS, Bool.false_and]
      have hR (Φ : QCAssertion Var (2 ^ N)) :
          GroupUnary.restrictPred S Φ =
            GroupUnary.restrictPred S
              (restrictAssertionToZeroAncilla Φ (QRegister.singleton anc)) := by
        rw [restrictAssertionToZeroAncilla_eq_restrictPred, restrictPred_restrictPred, ← hS_eq]
      refine ⟨by simp [Lac2Folded184Select.revComputeDyn],
        toCircuit_eval_mul_predProj (.andGate c₁ c₂ anc h₁₂ h₁a h₂a) S,
        fun Θ hΘ σ val ↦ by
          simp [Lac2Folded184Select.revComputeDyn, DynamicCircuit.andCompute, qcWpQAssign,
            hΘ σ val],
        fun Θ _ ↦ ?_⟩
      rw [hR, Lac2Folded184Select.revComputeDyn,
        DynamicCircuit.qc_wp_andCompute c₁ c₂ anc h₁₂ h₁a h₂a Θ, ← hR]
      rfl
  | seq p₁ p₂ ih₁ ih₂ =>
      have hv₁ : ∀ β, S β = true → p₁.validOn β = true :=
        fun β hS ↦ (Bool.and_eq_true _ _).mp (hval β hS) |>.1
      have hv₂ : ∀ γ, S (p₁.invBits γ) = true → p₂.validOn γ = true := by
        intro γ hγ
        have h := (Bool.and_eq_true _ _).mp (hval (p₁.invBits γ) hγ) |>.2
        rwa [p₁.fwdBits_invBits] at h
      exact (ih₁ S hv₁).seq (ih₂ (fun γ ↦ S (p₁.invBits γ)) hv₂)

theorem TransRealizes.uncomputeDyn {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (p : GroupUnary.RevCompute N) (S : BitAssignment N → Bool)
    (hval : ∀ β, S β = true → p.validOn β = true) :
    TransRealizes v (fun γ ↦ S (p.invBits γ)) S (p.toCircuit.eval)⁻¹
      (Lac2Folded184Select.revUncomputeDyn v p) := by
  induction p generalizing S with
  | id =>
      simpa [Lac2Folded184Select.revUncomputeDyn, GroupUnary.RevCompute.toCircuit,
        GroupUnary.RevCompute.invBits] using TransRealizes.identity v S
  | x q =>
      have hinv : (GroupUnary.RevCompute.x q).toCircuit.eval⁻¹ =
          (GroupUnary.RevCompute.x q).toCircuit.eval :=
        inv_eq_self_of_mul_self _ (revCompute_mul_self_of_fwdBits_invol (.x q) fun β ↦ by
          funext w
          by_cases hw : w = q
          · subst hw; simp [GroupUnary.RevCompute.fwdBits, add_assoc]
          · simp [GroupUnary.RevCompute.fwdBits, Function.update_of_ne hw])
      refine ⟨rfl, toCircuit_eval_inv_mul_predProj (.x q) S,
        fun Θ hΘ σ val ↦ by simp [Lac2Folded184Select.revUncomputeDyn, qcWpQAssign, hΘ σ val],
        fun _ _ ↦ by
          rw [hinv]
          simp only [Lac2Folded184Select.revUncomputeDyn, DynamicCircuit.compile_circuit,
            DynamicCircuit.qc_wp_circuit_compile, GroupUnary.RevCompute.toCircuit]⟩
  | cnot c t h =>
      have hinv : (GroupUnary.RevCompute.cnot c t h).toCircuit.eval⁻¹ =
          (GroupUnary.RevCompute.cnot c t h).toCircuit.eval :=
        inv_eq_self_of_mul_self _ (revCompute_mul_self_of_fwdBits_invol (.cnot c t h) fun β ↦ by
          funext w
          by_cases hw : w = t
          · subst hw
            simp [GroupUnary.RevCompute.fwdBits, Function.update_of_ne h, add_assoc]
          · simp [GroupUnary.RevCompute.fwdBits, Function.update_of_ne hw])
      refine ⟨rfl, toCircuit_eval_inv_mul_predProj (.cnot c t h) S,
        fun Θ hΘ σ val ↦ by simp [Lac2Folded184Select.revUncomputeDyn, qcWpQAssign, hΘ σ val],
        fun _ _ ↦ by
          rw [hinv]
          simp only [Lac2Folded184Select.revUncomputeDyn, DynamicCircuit.compile_circuit,
            DynamicCircuit.qc_wp_circuit_compile, GroupUnary.RevCompute.toCircuit]⟩
  | andGate c₁ c₂ anc h₁₂ h₁a h₂a =>
      let p : GroupUnary.RevCompute N := .andGate c₁ c₂ anc h₁₂ h₁a h₂a
      have hT_sq : p.toCircuit.eval * p.toCircuit.eval = 1 :=
        revCompute_mul_self_of_fwdBits_invol p fun β ↦ by
          funext w
          by_cases hw : w = anc
          · subst hw
            simp [p, GroupUnary.RevCompute.fwdBits, Function.update_of_ne h₁a,
              Function.update_of_ne h₂a, add_assoc]
          · simp [p, GroupUnary.RevCompute.fwdBits, Function.update_of_ne hw]
      have hT_inv : p.toCircuit.eval⁻¹ = p.toCircuit.eval :=
        inv_eq_self_of_mul_self p.toCircuit.eval hT_sq
      have hT_herm : p.toCircuit.eval.1ᴴ = p.toCircuit.eval.1 :=
        conjTranspose_eq_self_of_mul_self p.toCircuit.eval hT_sq
      have hSP₀ : GroupUnary.predProj S *
          (QRegister.singleton anc).basisOutcomeProjector 0 = GroupUnary.predProj S := by
        rw [basisOutcomeProjector_zero_eq_predProj, GroupUnary.predProj_mul]
        congr 1; funext β
        by_cases hS : S β = true
        · have hall : ∀ i : Fin 1, β (QRegister.singleton anc i) = 0 :=
            fun _ ↦ beq_iff_eq.mp (hval β hS)
          rw [hS, Bool.true_and, decide_eq_true_iff]
          exact hall
        · rw [Bool.eq_false_iff.mpr hS, Bool.false_and]
      have hSpre : GroupUnary.predProj (fun γ ↦ S (p.invBits γ)) =
          (p.toCircuit.eval.1 * GroupUnary.predProj S) *
            ((QRegister.singleton anc).basisOutcomeProjector 0 * p.toCircuit.eval.1ᴴ) := by
        have hm := toCircuit_eval_mul_predProj p S
        have hsq : p.toCircuit.eval.1 * p.toCircuit.eval.1 = 1 := congrArg Subtype.val hT_sq
        calc GroupUnary.predProj (fun γ ↦ S (p.invBits γ))
            = GroupUnary.predProj (fun γ ↦ S (p.invBits γ)) *
                (p.toCircuit.eval.1 * p.toCircuit.eval.1) := by rw [hsq, Matrix.mul_one]
          _ = (p.toCircuit.eval.1 * GroupUnary.predProj S) * p.toCircuit.eval.1 := by
                rw [← Matrix.mul_assoc, ← hm]
          _ = p.toCircuit.eval.1 *
                (GroupUnary.predProj S * (QRegister.singleton anc).basisOutcomeProjector 0) *
                p.toCircuit.eval.1ᴴ := by rw [hSP₀, hT_herm]
          _ = (p.toCircuit.eval.1 * GroupUnary.predProj S) *
                ((QRegister.singleton anc).basisOutcomeProjector 0 * p.toCircuit.eval.1ᴴ) := by
                simp only [Matrix.mul_assoc]
      refine ⟨by simp [Lac2Folded184Select.revUncomputeDyn],
        toCircuit_eval_inv_mul_predProj p S,
        fun Θ _ σ val ↦ DynamicCircuit.wp_andUncompute_update_self v c₁ c₂ anc h₁₂ Θ σ val,
        fun Θ hΘ ↦ ?_⟩
      funext σ; apply Subtype.ext
      have hUn := open DynamicCircuit in
        qc_wp_toffoli_andUncompute_of_update_eq
          v c₁ c₂ anc h₁₂ h₁a h₂a Θ hΘ
      have h1 : (GroupUnary.restrictPred (fun γ ↦ S (p.invBits γ))
            (wp (Lac2Folded184Select.revUncomputeDyn v p).compile Θ) σ).1 =
          (restrictAssertionToZeroAncilla
            (qcWpQAssign (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval
              (wp (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile Θ))
            (QRegister.singleton anc) σ).1.conj
              (p.toCircuit.eval.1 * GroupUnary.predProj S) := by
        change (wp (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile Θ σ).1.conj
              (GroupUnary.predProj (fun γ ↦ S (p.invBits γ))) =
            (restrictAssertionToZeroAncilla
              (qcWpQAssign p.toCircuit.eval
                (wp (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile Θ))
              (QRegister.singleton anc) σ).1.conj
                (p.toCircuit.eval.1 * GroupUnary.predProj S)
        simp only [restrictAssertionToZeroAncilla_coe, qcWpQAssign, qcQAssignObsMap,
          Observable.conj_coe, Unitary.coe_star, Matrix.star_eq_conjTranspose, conj_conj]
        exact congrArg
          (fun X ↦ (wp (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile Θ σ).1.conj X) hSpre
      change (GroupUnary.restrictPred (fun γ ↦ S (p.invBits γ))
            (wp (Lac2Folded184Select.revUncomputeDyn v p).compile Θ) σ).1 =
          (GroupUnary.restrictPred (fun γ ↦ S (p.invBits γ))
            (qcWpQAssign p.toCircuit.eval⁻¹ Θ) σ).1
      rw [h1, congrArg (fun A : QCAssertion Var (2 ^ N) ↦ (A σ).1) hUn]
      simp only [restrictAssertionToZeroAncilla_coe, GroupUnary.restrictPred_coe, qcWpQAssign,
        qcQAssignObsMap, Observable.conj_coe, Unitary.coe_star, Matrix.star_eq_conjTranspose,
        conj_conj, hT_inv, hT_herm]
      refine congrArg (fun X ↦ (Θ σ).1.conj X) ?_
      rw [Matrix.mul_assoc, hSP₀, toCircuit_eval_mul_predProj p S]
  | seq p₁ p₂ ih₁ ih₂ =>
      have hv₁ : ∀ β, S β = true → p₁.validOn β = true :=
        fun β hS ↦ (Bool.and_eq_true _ _).mp (hval β hS) |>.1
      have hv₂ : ∀ γ, S (p₁.invBits γ) = true → p₂.validOn γ = true := by
        intro γ hγ
        have h := (Bool.and_eq_true _ _).mp (hval (p₁.invBits γ) hγ) |>.2
        rwa [p₁.fwdBits_invBits] at h
      have hseq := (ih₂ (fun γ ↦ S (p₁.invBits γ)) hv₂).seq (ih₁ S hv₁)
      have hpred : (fun δ ↦ S (p₁.invBits (p₂.invBits δ))) =
          (fun δ ↦ S ((p₁.seq p₂).invBits δ)) := rfl
      have hunit : p₁.toCircuit.eval⁻¹ * p₂.toCircuit.eval⁻¹ = (p₁.seq p₂).toCircuit.eval⁻¹ := by
        rw [← _root_.mul_inv_rev]; rfl
      rw [hpred, hunit] at hseq
      exact hseq

theorem cleanRealizes_of_transRealizes {Var : Type} [Fintype Var] [DecidableEq Var]
    {N k s : ℕ} {v : Var} (rAct : QRegister k N) (rScr : QRegister s N)
    (hdisj : rAct.DisjointWires rScr) {U : Unitary (2 ^ k)} {P : DynamicCircuit Var N}
    (h : TransRealizes v
      (fun β ↦ decide (∀ j : Fin s, β (rScr j) = 0))
      (fun β ↦ decide (∀ j : Fin s, β (rScr j) = 0))
      (rAct.embedUnitary U) P) :
    Solution.CleanDyn.CleanRealizes v rAct rScr U P :=
  Solution.CleanDyn.CleanRealizes.mk_of_disjoint v rAct rScr hdisj U P h.toff_zero h.update_self
    fun Θ hΘ ↦ by
      rw [restrictAssertionToZeroAncilla_eq_restrictPred,
        restrictAssertionToZeroAncilla_eq_restrictPred]
      exact h.wp_eq Θ hΘ

/-- Bijective bit-assignment transformation on `N` wires with explicit forward and inverse maps. -/
structure BijectiveBitMap (N : ℕ) where
  fwd : BitAssignment N → BitAssignment N
  inv : BitAssignment N → BitAssignment N
  inv_fwd : Function.LeftInverse inv fwd
  fwd_inv : Function.RightInverse inv fwd

/-- Sequential composition `m1` followed by `m2` of bijective bit-assignment maps. -/
def BijectiveBitMap.compBitMap {N : ℕ} (m1 m2 : BijectiveBitMap N) :
    BijectiveBitMap N where
  fwd β := m2.fwd (m1.fwd β)
  inv β := m1.inv (m2.inv β)
  inv_fwd β := by dsimp only; rw [m2.inv_fwd (m1.fwd β), m1.inv_fwd β]
  fwd_inv β := by dsimp only; rw [m1.fwd_inv (m2.inv β), m2.fwd_inv β]

/-- Bijective bit-assignment map built from an involutive bit map `f`. -/
def BijectiveBitMap.ofInvolutive {N : ℕ} (f : BitAssignment N → BitAssignment N)
    (hf : Function.Involutive f) : BijectiveBitMap N where
  fwd := f
  inv := f
  inv_fwd := hf
  fwd_inv := hf

/-- Bijective bit-assignment map induced by a reversible `RevCompute` program `p`. -/
def BijectiveBitMap.ofRevCompute {N : ℕ} (p : GroupUnary.RevCompute N) :
    BijectiveBitMap N where
  fwd := p.fwdBits
  inv := p.invBits
  inv_fwd := p.invBits_fwdBits
  fwd_inv := p.fwdBits_invBits

/-- Basis-index permutation on `Fin (2 ^ N)` induced by `m`. -/
noncomputable def BijectiveBitMap.toPerm {N : ℕ} (m : BijectiveBitMap N) :
    Equiv.Perm (Fin (2 ^ N)) :=
  (basisBits N).trans
    ((Equiv.mk m.fwd m.inv m.inv_fwd m.fwd_inv).trans (basisBits N).symm)

/-- Permutation unitary on `2 ^ N` basis states induced by `m`. -/
noncomputable def BijectiveBitMap.toUnitary {N : ℕ} (m : BijectiveBitMap N) :
    Unitary (2 ^ N) :=
  Operator.permutationUnitary m.toPerm

theorem BijectiveBitMap.toPerm_symm_apply {N : ℕ} (m : BijectiveBitMap N)
    (β : BitAssignment N) :
    m.toPerm ((basisBits N).symm β) = (basisBits N).symm (m.fwd β) := by
  simp [BijectiveBitMap.toPerm]

theorem BijectiveBitMap.toUnitary_mulVec_ket {N : ℕ} (m : BijectiveBitMap N)
    (β : BitAssignment N) :
    m.toUnitary.1.mulVec (SelectSwapQROM.ket β) = SelectSwapQROM.ket (m.fwd β) := by
  change (Operator.permutationUnitary m.toPerm).1 *ᵥ Pi.single ((basisBits N).symm β) 1 =
    Pi.single ((basisBits N).symm (m.fwd β)) 1
  rw [Operator.permutationUnitary_mulVec_single, m.toPerm_symm_apply]

theorem BijectiveBitMap.toUnitary_seq {N : ℕ} (m1 m2 : BijectiveBitMap N) :
    m2.toUnitary * m1.toUnitary = (m1.compBitMap m2).toUnitary := by
  apply Subtype.ext; apply SelectSwapQROM.matrix_ext_ket; intro β
  change (m2.toUnitary.1 * m1.toUnitary.1).mulVec _ = (m1.compBitMap m2).toUnitary.1.mulVec _
  rw [← Matrix.mulVec_mulVec, m1.toUnitary_mulVec_ket, m2.toUnitary_mulVec_ket,
    (m1.compBitMap m2).toUnitary_mulVec_ket]
  rfl

theorem BijectiveBitMap.toUnitary_mul_predProj {N : ℕ} (m : BijectiveBitMap N)
    (S : BitAssignment N → Bool) :
    m.toUnitary.1 * GroupUnary.predProj S =
      GroupUnary.predProj (fun γ ↦ S (m.inv γ)) * m.toUnitary.1 :=
  ketPerm_mul_predProj m.toUnitary m.fwd m.toUnitary_mulVec_ket S (fun γ ↦ S (m.inv γ))
    fun β ↦ by rw [m.inv_fwd]

theorem BijectiveBitMap.toUnitary_ofRevCompute {N : ℕ} (p : GroupUnary.RevCompute N) :
    (BijectiveBitMap.ofRevCompute p).toUnitary = p.toCircuit.eval := by
  apply Subtype.ext; apply SelectSwapQROM.matrix_ext_ket; intro β
  rw [(BijectiveBitMap.ofRevCompute p).toUnitary_mulVec_ket,
    show SelectSwapQROM.ket β = GroupUnary.ket β from rfl, p.toCircuit_mulVec_ket]
  rfl

/-- Subspace `TransRealizes` specialization to the permutation unitary of `m`. -/
def BijectiveTransRealizes {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (S : BitAssignment N → Bool) (m : BijectiveBitMap N)
    (P : DynamicCircuit Var N) : Prop :=
  TransRealizes v S (fun γ ↦ S (m.inv γ)) m.toUnitary P

theorem BijectiveTransRealizes.congr_fwd {Var : Type} [Fintype Var] [DecidableEq Var]
    {N : ℕ} {v : Var} {S : BitAssignment N → Bool} {m1 m2 : BijectiveBitMap N}
    {P : DynamicCircuit Var N}
    (hfwd : ∀ β, S β = true → m1.fwd β = m2.fwd β)
    (h : BijectiveTransRealizes v S m1 P) :
    BijectiveTransRealizes v S m2 P := by
  unfold BijectiveTransRealizes at *
  have hpost : (fun γ ↦ S (m1.inv γ)) = (fun γ ↦ S (m2.inv γ)) := by
    funext γ; rw [Bool.eq_iff_iff]; constructor
    · intro h1
      have heq := hfwd (m1.inv γ) h1; rw [m1.fwd_inv] at heq
      have hinv := congrArg m2.inv heq; rw [m2.inv_fwd] at hinv; rwa [← hinv] at h1
    · intro h2
      have heq := (hfwd (m2.inv γ) h2).symm; rw [m2.fwd_inv] at heq
      have hinv := congrArg m1.inv heq; rw [m1.inv_fwd] at hinv; rwa [← hinv] at h2
  have hmat : m1.toUnitary.1 * GroupUnary.predProj S =
      m2.toUnitary.1 * GroupUnary.predProj S := by
    apply SelectSwapQROM.matrix_ext_ket; intro β
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, predProj_mulVec_ket]
    by_cases hS : S β = true
    · simp only [hS, ↓reduceIte, m1.toUnitary_mulVec_ket, m2.toUnitary_mulVec_ket, hfwd β hS]
    · simp [hS]
  exact (h.congr_pred rfl hpost).congr_unitary (m2.toUnitary_mul_predProj S) hmat

theorem BijectiveTransRealizes.seqBijTrans {Var : Type} [Fintype Var] [DecidableEq Var]
    {N : ℕ} {v : Var} {S : BitAssignment N → Bool} {m1 m2 : BijectiveBitMap N}
    {P1 P2 : DynamicCircuit Var N}
    (h1 : BijectiveTransRealizes v S m1 P1)
    (h2 : BijectiveTransRealizes v (fun γ ↦ S (m1.inv γ)) m2 P2) :
    BijectiveTransRealizes v S (m1.compBitMap m2) (.seq P1 P2) := by
  unfold BijectiveTransRealizes at *
  have hSeq := h1.seq h2
  rwa [BijectiveBitMap.toUnitary_seq m1 m2] at hSeq

theorem BijectiveTransRealizes.ofRevComputeBij {Var : Type} [Fintype Var] [DecidableEq Var]
    {N : ℕ} (v : Var) (p : GroupUnary.RevCompute N) (S : BitAssignment N → Bool)
    (hval : ∀ β, S β = true → p.validOn β = true) :
    BijectiveTransRealizes v S (BijectiveBitMap.ofRevCompute p)
      (Lac2Folded184Select.revComputeDyn p) := by
  unfold BijectiveTransRealizes
  rw [BijectiveBitMap.toUnitary_ofRevCompute]
  exact TransRealizes.computeDyn v p S hval

theorem BijectiveTransRealizes.to_transRealizes_revCompute
    {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    {v : Var} {S : BitAssignment N → Bool} {m : BijectiveBitMap N}
    {P : DynamicCircuit Var N} (p : GroupUnary.RevCompute N)
    (h : BijectiveTransRealizes v S m P)
    (hfwd : ∀ β, S β = true → m.fwd β = p.fwdBits β) :
    TransRealizes v S (fun γ ↦ S (p.invBits γ)) p.toCircuit.eval P := by
  have h' : BijectiveTransRealizes v S (BijectiveBitMap.ofRevCompute p) P := h.congr_fwd hfwd
  unfold BijectiveTransRealizes at h'
  rwa [BijectiveBitMap.toUnitary_ofRevCompute] at h'

/-- Run `cPre`, measure wire `q` into `v`, and conditionally run `cFixTrue` when `σ v ≠ 0`. -/
def measureZ1AndBranch {Var : Type} {n : ℕ} (v : Var) (q : Wire n)
    (cPre cFixTrue : Circuit n) : DynamicCircuit Var n :=
  .seq (.circuit cPre)
    (.seq (.measure v (QRegister.singleton q))
      (qcQIf (fun σ ↦ σ v) (.circuit cFixTrue) .identity))

theorem star_sqrtHalf_eq : star SelectSwapQROM.sqrtHalf = SelectSwapQROM.sqrtHalf := by
  unfold SelectSwapQROM.sqrtHalf
  exact Complex.conj_ofReal _

theorem conj_sqrtHalf_add_self {d : ℕ} (A : HermitianMat (Fin d) ℂ)
    (M : Matrix (Fin d) (Fin d) ℂ) :
    A.conj (SelectSwapQROM.sqrtHalf • M)ᴴ + A.conj (SelectSwapQROM.sqrtHalf • M)ᴴ =
      A.conj Mᴴ := by
  ext1
  simp only [HermitianMat.mat_add, conj_apply_mat, conjTranspose_conjTranspose,
    conjTranspose_smul, star_sqrtHalf_eq, Matrix.smul_mul, Matrix.mul_smul]
  match_scalars
  linear_combination (2 : ℂ) * SelectSwapQROM.sqrtHalf_mul_sqrtHalf

theorem wp_measureZ1AndBranch_apply_assertion {Var : Type} [Finite Var] [DecidableEq Var]
    {n : ℕ} (v : Var) (q : Wire n) (cPre cFixTrue : Circuit n)
    (Θ : QCAssertion Var (2 ^ n)) (σ : Store Var) :
    let P₀ := (QRegister.singleton q).basisOutcomeProjector 0
    let P₁ := (QRegister.singleton q).basisOutcomeProjector 1
    let L₀ := P₀ * cPre.eval.1
    let L₁ := cFixTrue.eval.1 * P₁ * cPre.eval.1
    (wp (measureZ1AndBranch v q cPre cFixTrue).compile Θ σ).1 =
      (Θ (Function.update σ v 0)).1.conj L₀ᴴ +
        (Θ (Function.update σ v 1)).1.conj L₁ᴴ := by
  cases nonempty_fintype Var
  intro P₀ P₁ L₀ L₁
  have hmeas_apply :
      (wp (.qSeq (QProg.measureRegister v (QRegister.singleton q))
          (qcQIf (fun σ'' ↦ σ'' v) cFixTrue.compile .skip)) Θ σ).1 =
        (Θ (Function.update σ v 0)).1.conj P₀ᴴ +
          ((Θ (Function.update σ v 1)).1.conj cFixTrue.eval.1ᴴ).conj P₁ᴴ := by
    have hsubst0 : σ.subst v 0 = Function.update σ v 0 := by
      funext y; simp [Store.subst, Function.update]
    have hsubst1 : σ.subst v 1 = Function.update σ v 1 := by
      funext y; simp [Store.subst, Function.update]
    simp only [wp_qSeq, wp_qIf, wp_skip, qc_wp_qMeasure', QProg.measureRegister,
      qc_wp_qMeasure_apply, qc_qMeasure_obs_map_coe,
      QCAssertion.subst_apply]
    change ∑ o : Fin 2, _ = _
    rw [Fin.sum_univ_two]
    simp [qc_qMeasure_outcome_herm_eq_conj, hsubst0, hsubst1,
      qcWpQAssign, qcQAssignObsMap, Observable.conj_coe, Unitary.coe_star,
      Matrix.star_eq_conjTranspose, QRegister.computationalBasisMeasurement_apply, P₀, P₁]
  change (wp cPre.compile
      (wp (.qSeq (QProg.measureRegister v (QRegister.singleton q))
        (qcQIf (fun σ'' ↦ σ'' v) cFixTrue.compile .skip)) Θ) σ).1 = _
  rw [DynamicCircuit.qc_wp_circuit_compile]
  simp only [qcWpQAssign, qcQAssignObsMap, Observable.conj_coe, Unitary.coe_star,
    Matrix.star_eq_conjTranspose]
  rw [hmeas_apply, map_add, conj_conj, conj_conj, conj_conj]
  dsimp only [L₀, L₁]
  simp only [Matrix.mul_assoc, conjTranspose_mul]

theorem BijectiveTransRealizes.of_measureZ1AndBranch
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    (v : Var) (q : Wire n) (cPre cFixTrue : Circuit n)
    (htoffPre : cPre.count .TOFF = 0) (htoffFix : cFixTrue.count .TOFF = 0)
    (S : BitAssignment n → Bool) (m : BijectiveBitMap n)
    (hL0 : ∀ β : BitAssignment n, S β = true →
      ((QRegister.singleton q).basisOutcomeProjector 0 * cPre.eval.1).mulVec
        (SelectSwapQROM.ket β) = SelectSwapQROM.sqrtHalf • SelectSwapQROM.ket (m.fwd β))
    (hL1 : ∀ β : BitAssignment n, S β = true →
      (cFixTrue.eval.1 * (QRegister.singleton q).basisOutcomeProjector 1 *
        cPre.eval.1).mulVec (SelectSwapQROM.ket β) =
          SelectSwapQROM.sqrtHalf • SelectSwapQROM.ket (m.fwd β)) :
    BijectiveTransRealizes v S m (measureZ1AndBranch v q cPre cFixTrue) where
  toff_zero := by
    simp [measureZ1AndBranch, DynamicCircuit.count, DynamicCircuit.identity, htoffPre, htoffFix]
  map_proj := m.toUnitary_mul_predProj S
  update_self Θ _ σ val := by
    apply Subtype.ext
    rw [wp_measureZ1AndBranch_apply_assertion, wp_measureZ1AndBranch_apply_assertion,
      Function.update_idem, Function.update_idem]
  wp_eq Θ hΘ := by
    let P₀ := (QRegister.singleton q).basisOutcomeProjector 0
    let P₁ := (QRegister.singleton q).basisOutcomeProjector 1
    let L₀ := P₀ * cPre.eval.1
    let L₁ := cFixTrue.eval.1 * P₁ * cPre.eval.1
    have hMat0 : L₀ * GroupUnary.predProj S =
        SelectSwapQROM.sqrtHalf • (m.toUnitary.1 * GroupUnary.predProj S) := by
      apply SelectSwapQROM.matrix_ext_ket; intro β
      rw [Matrix.smul_mulVec, ← Matrix.mulVec_mulVec (SelectSwapQROM.ket β) L₀,
        ← Matrix.mulVec_mulVec (SelectSwapQROM.ket β) m.toUnitary.1, predProj_mulVec_ket]
      by_cases hS : S β = true
      · rw [ite_eq_left hS, hL0 β hS, m.toUnitary_mulVec_ket]
      · rw [ite_eq_right hS, Matrix.mulVec_zero, Matrix.mulVec_zero, smul_zero]
    have hMat1 : L₁ * GroupUnary.predProj S =
        SelectSwapQROM.sqrtHalf • (m.toUnitary.1 * GroupUnary.predProj S) := by
      apply SelectSwapQROM.matrix_ext_ket; intro β
      rw [Matrix.smul_mulVec, ← Matrix.mulVec_mulVec (SelectSwapQROM.ket β) L₁,
        ← Matrix.mulVec_mulVec (SelectSwapQROM.ket β) m.toUnitary.1, predProj_mulVec_ket]
      by_cases hS : S β = true
      · rw [ite_eq_left hS, hL1 β hS, m.toUnitary_mulVec_ket]
      · rw [ite_eq_right hS, Matrix.mulVec_zero, Matrix.mulVec_zero, smul_zero]
    have hAdj0 : GroupUnary.predProj S * (P₀ * cPre.eval.1)ᴴ =
        (SelectSwapQROM.sqrtHalf • (m.toUnitary.1 * GroupUnary.predProj S))ᴴ := by
      have h := congrArg conjTranspose hMat0
      rwa [conjTranspose_mul, GroupUnary.predProj_conjTranspose] at h
    have hAdj1 : GroupUnary.predProj S * (cFixTrue.eval.1 * P₁ * cPre.eval.1)ᴴ =
        (SelectSwapQROM.sqrtHalf • (m.toUnitary.1 * GroupUnary.predProj S))ᴴ := by
      have h := congrArg conjTranspose hMat1
      rwa [conjTranspose_mul, GroupUnary.predProj_conjTranspose] at h
    have hAdjU : GroupUnary.predProj S * m.toUnitary.1ᴴ =
        (m.toUnitary.1 * GroupUnary.predProj S)ᴴ := by
      rw [conjTranspose_mul, GroupUnary.predProj_conjTranspose]
    funext σ; apply Subtype.ext
    simp only [GroupUnary.restrictPred_coe, wp_measureZ1AndBranch_apply_assertion,
      hΘ σ 0, hΘ σ 1, map_add, conj_conj,
      qcWpQAssign, qcQAssignObsMap, Observable.conj_coe, Unitary.coe_star,
      Matrix.star_eq_conjTranspose, hAdjU]
    rw [hAdj0, hAdj1]
    exact conj_sqrtHalf_add_self (Θ σ).1 (m.toUnitary.1 * GroupUnary.predProj S)

/-- `2-T` W-state pair splitter `ctrlH (a, b) ;; CNOT b a`. -/
def wSplitPair {n : ℕ} (a b : Wire n) (hab : a ≠ b) : Circuit n :=
  CoherentAlias.ctrlH.onRegister (QRegister.pair a b hab) ;;ᶜ Circuit.CNOT b a hab.symm

@[simp]
theorem wSplitPair_count_toff {n : ℕ} (a b : Wire n) (hab : a ≠ b) :
    (wSplitPair a b hab).count .TOFF = 0 := by
  simp [wSplitPair]

@[simp]
theorem wSplitPair_count_t {n : ℕ} (a b : Wire n) (hab : a ≠ b) :
    (wSplitPair a b hab).count .T = 2 := by
  simp [wSplitPair]

theorem ket_ctrlH_pair {n : ℕ} (a b : Wire n) (hab : a ≠ b)
    (β : BitAssignment n) :
    (CoherentAlias.ctrlH.onRegister (QRegister.pair a b hab)).eval.1.mulVec
      (SelectSwapQROM.ket β) =
      if β a = 1 then (Circuit.H b).eval.1.mulVec (SelectSwapQROM.ket β)
      else SelectSwapQROM.ket β := by
  have hev : (CoherentAlias.ctrlH.onRegister (QRegister.pair a b hab)).eval.1 =
      (QRegister.pair a b hab).embedMatrix
        (CoherentAlias.predCtrlMatrix (fun c : Fin (2 ^ 1) ↦ c.val == 1) Qubit.H.1) := by
    rw [Circuit.eval_onRegister, CoherentAlias.eval_ctrlH]; rfl
  have hp : ∀ x : ZMod 2,
      (((basisBits 1).symm (fun _ ↦ x) : Fin (2 ^ 1)).val == 1) = decide (x = 1) := by decide
  have hket : SelectSwapQROM.ket = CoherentAlias.ket (n := n) := rfl
  rw [hev]
  change ((QRegister.pair a b hab).embedMatrix _ *ᵥ CoherentAlias.ket β) = _
  rw [CoherentAlias.ket_embed_predCtrlMatrix (m := 1) (n := n) (QRegister.pair a b hab)
    (fun c : Fin (2 ^ 1) ↦ c.val == 1) Qubit.H.1 β]
  have hc0 : (fun i : Fin 1 ↦
      β (((QRegister.pair a b hab).compose (QRegister.block 0 1 (by omega))) i)) =
      fun _ ↦ β a := by
    funext i; fin_cases i; rfl
  have hl : (QRegister.pair a b hab) (Fin.last 1) = b := rfl
  rw [hc0, hp (β a), hl, ← hket]
  by_cases h1 : β a = 1
  · simp [h1]; rfl
  · simp [h1]

theorem ket_wSplitPair_zero_zero {n : ℕ} (a b : Wire n) (hab : a ≠ b)
    (β : BitAssignment n) (ha : β a = 0) (hb : β b = 0) :
    (wSplitPair a b hab).eval.1.mulVec (SelectSwapQROM.ket β) = SelectSwapQROM.ket β := by
  rw [wSplitPair, SelectSwapQROM.eval_seq_mulVec, ket_ctrlH_pair a b hab β, ha,
    ite_eq_right zero_ne_one, SelectSwapQROM.ket_CNOT, hb, add_zero, Function.update_eq_self]

theorem ket_wSplitPair_one_zero {n : ℕ} (a b : Wire n) (hab : a ≠ b)
    (β : BitAssignment n) (ha : β a = 1) (hb : β b = 0) :
    (wSplitPair a b hab).eval.1.mulVec (SelectSwapQROM.ket β) =
      SelectSwapQROM.sqrtHalf • SelectSwapQROM.ket β +
        SelectSwapQROM.sqrtHalf •
          SelectSwapQROM.ket (Function.update (Function.update β a 0) b 1) := by
  have hupd0 : Function.update β b 0 = β := by
    rw [← hb]; exact Function.update_eq_self b β
  rw [wSplitPair, SelectSwapQROM.eval_seq_mulVec, ket_ctrlH_pair a b hab β, ha,
    ite_eq_left rfl, SelectSwapQROM.ket_H, hb]
  simp only [SelectSwapQROM.bitSign, ↓reduceIte, one_smul, hupd0,
    Matrix.mulVec_add, Matrix.mulVec_smul, smul_add]
  have hc0 : (Circuit.CNOT b a hab.symm).eval.1.mulVec (SelectSwapQROM.ket β) =
      SelectSwapQROM.ket β := by
    rw [SelectSwapQROM.ket_CNOT, hb, add_zero, Function.update_eq_self]
  have hc1 : (Circuit.CNOT b a hab.symm).eval.1.mulVec
      (SelectSwapQROM.ket (Function.update β b 1)) =
      SelectSwapQROM.ket (Function.update (Function.update β a 0) b 1) := by
    rw [SelectSwapQROM.ket_CNOT, Function.update_of_ne hab, Function.update_self, ha,
      SelectSwapQROM.one_add_one_zmod2, Function.update_comm hab.symm 1 0 β]
  rw [hc0, hc1]

/-- `3`-CNOT (`0 T`, `0 TOFF`) swap gate between wires `a` and `b`. -/
def swap3Circ {n : ℕ} (a b : Wire n) (hab : a ≠ b) : Circuit n :=
  Circuit.CNOT a b hab ;;ᶜ Circuit.CNOT b a hab.symm ;;ᶜ Circuit.CNOT a b hab

@[simp]
theorem swap3Circ_count_toff {n : ℕ} (a b : Wire n) (hab : a ≠ b) :
    (swap3Circ a b hab).count .TOFF = 0 := by simp [swap3Circ]

@[simp]
theorem swap3Circ_count_t {n : ℕ} (a b : Wire n) (hab : a ≠ b) :
    (swap3Circ a b hab).count .T = 0 := by simp [swap3Circ]

theorem ket_swap3Circ {n : ℕ} (a b : Wire n) (hab : a ≠ b) (β : BitAssignment n) :
    (swap3Circ a b hab).eval.1.mulVec (SelectSwapQROM.ket β) =
      SelectSwapQROM.ket (Function.update (Function.update β a (β b)) b (β a)) := by
  rw [swap3Circ, SelectSwapQROM.eval_seq_mulVec, SelectSwapQROM.eval_seq_mulVec,
    SelectSwapQROM.ket_CNOT, SelectSwapQROM.ket_CNOT, SelectSwapQROM.ket_CNOT]
  congr 1; funext u
  by_cases hua : u = a
  · subst hua
    simp only [Function.update_of_ne hab, Function.update_of_ne hab.symm, Function.update_self]
    rcases SelectSwapQROM.bit_cases (β u) with h1 | h1 <;>
      rcases SelectSwapQROM.bit_cases (β b) with h2 | h2 <;> simp_all
  · by_cases hub : u = b
    · subst hub
      simp only [Function.update_self, Function.update_of_ne hab, Function.update_of_ne hab.symm]
      rcases SelectSwapQROM.bit_cases (β a) with h1 | h1 <;>
        rcases SelectSwapQROM.bit_cases (β u) with h2 | h2 <;> simp_all
    · simp [Function.update_of_ne hua, Function.update_of_ne hub]

/-- Sequential composition of `R` circuits indexed by `Fin R`. -/
def wSeqFin {n : ℕ} : (R : ℕ) → (Fin R → Circuit n) → Circuit n
  | 0, _ => .identity
  | R + 1, cs => cs 0 ;;ᶜ wSeqFin R (fun i ↦ cs i.succ)

theorem wSeqFin_count_eq_zero {n a : ℕ} (g : PrimitiveGate a) :
    ∀ (R : ℕ) (cs : Fin R → Circuit n),
      (∀ i, (cs i).count g = 0) → (wSeqFin R cs).count g = 0
  | 0, _, _ => rfl
  | R + 1, cs, h0 => by
      simp [wSeqFin, h0 0, wSeqFin_count_eq_zero g R (fun i ↦ cs i.succ) (fun i ↦ h0 i.succ)]

theorem wSeqFin_count_const {n a : ℕ} (g : PrimitiveGate a) (c : ℕ) :
    ∀ (R : ℕ) (cs : Fin R → Circuit n),
      (∀ i, (cs i).count g = c) → (wSeqFin R cs).count g = c * R
  | 0, _, _ => by simp [wSeqFin]
  | R + 1, cs, hc => by
      simp only [wSeqFin, Circuit.count_seq, hc 0,
        wSeqFin_count_const g c R (fun i ↦ cs i.succ) (fun i ↦ hc i.succ)]
      ring

theorem ket_wSplitSeq_all_zero {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n) (hab : ∀ i, a i ≠ b i) (β : BitAssignment n),
      (∀ i, β (a i) = 0) → (∀ i, β (b i) = 0) →
      (wSeqFin R (fun i ↦ wSplitPair (a i) (b i) (hab i))).eval.1.mulVec
        (SelectSwapQROM.ket β) = SelectSwapQROM.ket β
  | 0, _, _, _, β, _, _ => Matrix.one_mulVec (SelectSwapQROM.ket β)
  | R + 1, a, b, hab, β, ha, hb => by
      rw [wSeqFin, SelectSwapQROM.eval_seq_mulVec,
        ket_wSplitPair_zero_zero (a 0) (b 0) (hab 0) β (ha 0) (hb 0)]
      exact ket_wSplitSeq_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
        (fun i ↦ hab i.succ) β (fun i ↦ ha i.succ) (fun i ↦ hb i.succ)

theorem ket_wSplitSeq_oneHot {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n)
      (_ha_inj : Function.Injective a) (_hb_inj : Function.Injective b)
      (hab_ne : ∀ i j, a i ≠ b j)
      (β : BitAssignment n) (iStar : Fin R),
      (∀ i, β (b i) = 0) →
      β (a iStar) = 1 →
      (∀ i, i ≠ iStar → β (a i) = 0) →
      (wSeqFin R (fun i ↦ wSplitPair (a i) (b i) (hab_ne i i))).eval.1.mulVec
        (SelectSwapQROM.ket β) =
        SelectSwapQROM.sqrtHalf • SelectSwapQROM.ket β +
          SelectSwapQROM.sqrtHalf •
            SelectSwapQROM.ket (Function.update (Function.update β (a iStar) 0) (b iStar) 1)
  | 0, _, _, _, _, _, _, iStar, _, _, _ => Fin.elim0 iStar
  | R + 1, a, b, ha_inj, hb_inj, hab_ne, β, iStar, hb0, ha1, ha0 => by
      rw [wSeqFin, SelectSwapQROM.eval_seq_mulVec]
      cases iStar using Fin.cases with
      | zero =>
          rw [ket_wSplitPair_one_zero (a 0) (b 0) (hab_ne 0 0) β ha1 (hb0 0),
            Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul]
          have hz_stay := ket_wSplitSeq_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (fun i ↦ hab_ne i.succ i.succ) β
            (fun i ↦ ha0 i.succ (Fin.succ_ne_zero i)) (fun i ↦ hb0 i.succ)
          let βm := Function.update (Function.update β (a 0) 0) (b 0) 1
          have hz_move := ket_wSplitSeq_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (fun i ↦ hab_ne i.succ i.succ) βm
            (fun i ↦ by
              dsimp only [βm]
              rw [Function.update_of_ne (hab_ne i.succ 0),
                Function.update_of_ne (ha_inj.ne (Fin.succ_ne_zero i))]
              exact ha0 i.succ (Fin.succ_ne_zero i))
            (fun i ↦ by
              dsimp only [βm]
              rw [Function.update_of_ne (hb_inj.ne (Fin.succ_ne_zero i)),
                Function.update_of_ne (hab_ne 0 i.succ).symm]
              exact hb0 i.succ)
          rw [hz_stay, hz_move]
      | succ k =>
          rw [ket_wSplitPair_zero_zero (a 0) (b 0) (hab_ne 0 0) β
            (ha0 0 (Fin.succ_ne_zero k).symm) (hb0 0)]
          exact ket_wSplitSeq_oneHot R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (ha_inj.comp (Fin.succ_injective R)) (hb_inj.comp (Fin.succ_injective R))
            (fun i j ↦ hab_ne i.succ j.succ) β k
            (fun i ↦ hb0 i.succ) ha1
            (fun i hik ↦ ha0 i.succ (fun he ↦ hik (Fin.succ_inj.mp he)))

theorem ket_cnotToTargetSeq {n : ℕ} :
    ∀ (R : ℕ) (src : Fin R → Wire n) (tgt : Wire n) (hne : ∀ i, src i ≠ tgt)
      (β : BitAssignment n),
      (wSeqFin R (fun i ↦ Circuit.CNOT (src i) tgt (hne i))).eval.1.mulVec
        (SelectSwapQROM.ket β) =
        SelectSwapQROM.ket (Function.update β tgt (β tgt + ∑ i : Fin R, β (src i)))
  | 0, _, _, _, β => by
      simp only [wSeqFin, Finset.univ_eq_empty, Finset.sum_empty, add_zero, Function.update_eq_self]
      exact Matrix.one_mulVec (SelectSwapQROM.ket β)
  | R + 1, src, tgt, hne, β => by
      rw [wSeqFin, SelectSwapQROM.eval_seq_mulVec, SelectSwapQROM.ket_CNOT]
      let β₁ := Function.update β tgt (β tgt + β (src 0))
      rw [ket_cnotToTargetSeq R (fun i ↦ src i.succ) tgt (fun i ↦ hne i.succ) β₁]
      congr 1
      have hsum : (∑ i : Fin R, β₁ (src i.succ)) = ∑ i : Fin R, β (src i.succ) :=
        Finset.sum_congr rfl fun i _ ↦ Function.update_of_ne (hne i.succ) _ _
      dsimp only [β₁]
      rw [Function.update_self, hsum, Function.update_idem, add_assoc, Fin.sum_univ_succ]

theorem ket_swap3Seq_all_zero {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n) (hab : ∀ i, a i ≠ b i) (β : BitAssignment n),
      (∀ i, β (a i) = 0) → (∀ i, β (b i) = 0) →
      (wSeqFin R (fun i ↦ swap3Circ (a i) (b i) (hab i))).eval.1.mulVec
        (SelectSwapQROM.ket β) = SelectSwapQROM.ket β
  | 0, _, _, _, β, _, _ => Matrix.one_mulVec (SelectSwapQROM.ket β)
  | R + 1, a, b, hab, β, ha, hb => by
      rw [wSeqFin, SelectSwapQROM.eval_seq_mulVec, ket_swap3Circ, ha 0, hb 0]
      have hself : Function.update (Function.update β (a 0) 0) (b 0) 0 = β := by
        funext u
        by_cases h1 : u = b 0
        · subst h1; simp [hb 0]
        · by_cases h2 : u = a 0
          · subst h2; simp [Function.update_of_ne h1, ha 0]
          · simp [Function.update_of_ne h1, Function.update_of_ne h2]
      rw [hself]
      exact ket_swap3Seq_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
        (fun i ↦ hab i.succ) β (fun i ↦ ha i.succ) (fun i ↦ hb i.succ)

theorem ket_swap3Seq_single {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n)
      (_ha_inj : Function.Injective a) (_hb_inj : Function.Injective b)
      (hab_ne : ∀ i j, a i ≠ b j)
      (β : BitAssignment n) (iStar : Fin R),
      (∀ i, i ≠ iStar → β (a i) = 0) →
      (∀ i, i ≠ iStar → β (b i) = 0) →
      (wSeqFin R (fun i ↦ swap3Circ (a i) (b i) (hab_ne i i))).eval.1.mulVec
        (SelectSwapQROM.ket β) =
        SelectSwapQROM.ket
          (Function.update (Function.update β (a iStar) (β (b iStar))) (b iStar) (β (a iStar)))
  | 0, _, _, _, _, _, _, iStar, _, _ => Fin.elim0 iStar
  | R + 1, a, b, ha_inj, hb_inj, hab_ne, β, iStar, ha0, hb0 => by
      rw [wSeqFin, SelectSwapQROM.eval_seq_mulVec]
      cases iStar using Fin.cases with
      | zero =>
          rw [ket_swap3Circ]
          let β' := Function.update (Function.update β (a 0) (β (b 0))) (b 0) (β (a 0))
          exact ket_swap3Seq_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (fun i ↦ hab_ne i.succ i.succ) β'
            (fun i ↦ by
              dsimp only [β']
              rw [Function.update_of_ne (hab_ne i.succ 0),
                Function.update_of_ne (ha_inj.ne (Fin.succ_ne_zero i))]
              exact ha0 i.succ (Fin.succ_ne_zero i))
            (fun i ↦ by
              dsimp only [β']
              rw [Function.update_of_ne (hb_inj.ne (Fin.succ_ne_zero i)),
                Function.update_of_ne (hab_ne 0 i.succ).symm]
              exact hb0 i.succ (Fin.succ_ne_zero i))
      | succ k =>
          rw [ket_swap3Circ, ha0 0 (Fin.succ_ne_zero k).symm, hb0 0 (Fin.succ_ne_zero k).symm]
          have hself : Function.update (Function.update β (a 0) 0) (b 0) 0 = β := by
            funext u
            by_cases h1 : u = b 0
            · subst h1; simp [hb0 0 (Fin.succ_ne_zero k).symm]
            · by_cases h2 : u = a 0
              · subst h2; simp [Function.update_of_ne h1, ha0 0 (Fin.succ_ne_zero k).symm]
              · simp [Function.update_of_ne h1, Function.update_of_ne h2]
          rw [hself]
          exact ket_swap3Seq_single R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (ha_inj.comp (Fin.succ_injective R)) (hb_inj.comp (Fin.succ_injective R))
            (fun i j ↦ hab_ne i.succ j.succ) β k
            (fun i hik ↦ ha0 i.succ (fun he ↦ hik (Fin.succ_inj.mp he)))
            (fun i hik ↦ hb0 i.succ (fun he ↦ hik (Fin.succ_inj.mp he)))

/-- Pairwise disjointness of `ctrl`, `w0`, and `w1`. -/
structure WPairDisj {n : ℕ} (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n) : Prop where
  /-- Injectivity of `w0`. -/
  w0_inj : Function.Injective w0
  /-- Injectivity of `w1`. -/
  w1_inj : Function.Injective w1
  /-- Disjointness between `w0` and `w1`. -/
  w01_ne : ∀ i j, w0 i ≠ w1 j
  /-- Disjointness between `ctrl` and `w0`. -/
  ctrl_w0 : ∀ i, ctrl ≠ w0 i
  /-- Disjointness between `ctrl` and `w1`. -/
  ctrl_w1 : ∀ i, ctrl ≠ w1 i

/-- Pairwise disjointness of `ctrl`, `w0`, `w1`, and `qEnc`. -/
structure WSplitValid {n : ℕ} (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n)
    (qEnc : Wire n) : Prop extends WPairDisj R ctrl w0 w1 where
  /-- Disjointness between `qEnc` and `ctrl`. -/
  q_ctrl : qEnc ≠ ctrl
  /-- Disjointness between `qEnc` and `w0`. -/
  q_w0 : ∀ i, qEnc ≠ w0 i
  /-- Disjointness between `qEnc` and `w1`. -/
  q_w1 : ∀ i, qEnc ≠ w1 i

/-- Classical controlled-swap bit map on `R` wire pairs `(w0 i, w1 i)` controlled by `ctrl`. -/
noncomputable def cswapRangeBits {n : ℕ} (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n)
    (γ : BitAssignment n) : BitAssignment n :=
  if γ ctrl = 1 then
    fun w ↦
      if h0 : ∃ i : Fin R, w = w0 i then γ (w1 h0.choose)
      else if h1 : ∃ i : Fin R, w = w1 i then γ (w0 h1.choose)
      else γ w
  else γ

theorem cswapRangeBits_w0 {n R : ℕ} {ctrl : Wire n} {w0 w1 : Fin R → Wire n}
    (hd : WPairDisj R ctrl w0 w1) (γ : BitAssignment n) (i : Fin R) :
    cswapRangeBits R ctrl w0 w1 γ (w0 i) = if γ ctrl = 1 then γ (w1 i) else γ (w0 i) := by
  dsimp only [cswapRangeBits]
  by_cases hc : γ ctrl = 1
  · rw [ite_eq_left hc, ite_eq_left hc]
    have h0 : ∃ k : Fin R, w0 i = w0 k := ⟨i, rfl⟩
    rw [dite_eq_left h0]
    exact congrArg (fun k ↦ γ (w1 k)) (hd.w0_inj h0.choose_spec).symm
  · rw [ite_eq_right hc, ite_eq_right hc]

theorem cswapRangeBits_w1 {n R : ℕ} {ctrl : Wire n} {w0 w1 : Fin R → Wire n}
    (hd : WPairDisj R ctrl w0 w1) (γ : BitAssignment n) (i : Fin R) :
    cswapRangeBits R ctrl w0 w1 γ (w1 i) = if γ ctrl = 1 then γ (w0 i) else γ (w1 i) := by
  dsimp only [cswapRangeBits]
  by_cases hc : γ ctrl = 1
  · rw [ite_eq_left hc, ite_eq_left hc]
    have hn0 : ¬ ∃ k : Fin R, w1 i = w0 k := fun ⟨k, hk⟩ ↦ hd.w01_ne k i hk.symm
    have h1 : ∃ k : Fin R, w1 i = w1 k := ⟨i, rfl⟩
    rw [dite_eq_right hn0, dite_eq_left h1]
    exact congrArg (fun k ↦ γ (w0 k)) (hd.w1_inj h1.choose_spec).symm
  · rw [ite_eq_right hc, ite_eq_right hc]

theorem cswapRangeBits_other {n R : ℕ} {ctrl : Wire n} {w0 w1 : Fin R → Wire n}
    (γ : BitAssignment n) {w : Wire n}
    (hw0 : ∀ i, w ≠ w0 i) (hw1 : ∀ i, w ≠ w1 i) :
    cswapRangeBits R ctrl w0 w1 γ w = γ w := by
  dsimp only [cswapRangeBits]
  by_cases hc : γ ctrl = 1
  · rw [ite_eq_left hc, dite_eq_right (fun ⟨i, hi⟩ ↦ hw0 i hi),
      dite_eq_right (fun ⟨i, hi⟩ ↦ hw1 i hi)]
  · rw [ite_eq_right hc]

theorem cswapRangeBits_involutive {n R : ℕ} {ctrl : Wire n} {w0 w1 : Fin R → Wire n}
    (hd : WPairDisj R ctrl w0 w1) :
    Function.Involutive (cswapRangeBits R ctrl w0 w1) := by
  intro γ
  let γ' := cswapRangeBits R ctrl w0 w1 γ
  have hctrl : γ' ctrl = γ ctrl := cswapRangeBits_other γ hd.ctrl_w0 hd.ctrl_w1
  funext w
  by_cases h0 : ∃ i : Fin R, w = w0 i
  · obtain ⟨i, rfl⟩ := h0
    change cswapRangeBits R ctrl w0 w1 γ' (w0 i) = γ (w0 i)
    rw [cswapRangeBits_w0 hd γ' i, hctrl]
    dsimp only [γ']
    rw [cswapRangeBits_w0 hd γ i, cswapRangeBits_w1 hd γ i]
    split_ifs <;> rfl
  · by_cases h1 : ∃ i : Fin R, w = w1 i
    · obtain ⟨i, rfl⟩ := h1
      change cswapRangeBits R ctrl w0 w1 γ' (w1 i) = γ (w1 i)
      rw [cswapRangeBits_w1 hd γ' i, hctrl]
      dsimp only [γ']
      rw [cswapRangeBits_w0 hd γ i, cswapRangeBits_w1 hd γ i]
      split_ifs <;> rfl
    · have hw0 : ∀ i, w ≠ w0 i := fun i he ↦ h0 ⟨i, he⟩
      have hw1 : ∀ i, w ≠ w1 i := fun i he ↦ h1 ⟨i, he⟩
      exact (cswapRangeBits_other γ' hw0 hw1).trans (cswapRangeBits_other γ hw0 hw1)

/-- Precondition for deterministic W-state range expansion `dWExpandDet1`. -/
def InvWSplitDet {n : ℕ} (R : ℕ) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (γ : BitAssignment n) : Prop :=
  γ qEnc = 0 ∧ (∀ i : Fin R, γ (w1 i) = 0) ∧
    ∃ iStar : Fin R, γ (w0 iStar) = 1 ∧ ∀ i : Fin R, i ≠ iStar → γ (w0 i) = 0

/-- `2 * R`-`T` (`0 TOFF`) deterministic W-state controlled range swap on `R` wire pairs. -/
def dWExpandDet1 {Var : Type} {n : ℕ} (v : Var) (R : ℕ) (ctrl : Wire n)
    (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValid R ctrl w0 w1 qEnc) : DynamicCircuit Var n :=
  let cPre : Circuit n :=
    wSeqFin R (fun i ↦ wSplitPair (w0 i) (w1 i) (hv.w01_ne i i)) ;;ᶜ
      wSeqFin R (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) ;;ᶜ
      Circuit.CNOT ctrl qEnc hv.q_ctrl.symm
  let cFixTrue : Circuit n :=
    Circuit.X qEnc ;;ᶜ
      wSeqFin R (fun i ↦ swap3Circ (w0 i) (w1 i) (hv.w01_ne i i))
  measureZ1AndBranch v qEnc cPre cFixTrue

@[simp]
theorem dWExpandDet1_count_toff {Var : Type} {n : ℕ} (v : Var) (R : ℕ) (ctrl : Wire n)
    (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValid R ctrl w0 w1 qEnc) :
    (dWExpandDet1 v R ctrl w0 w1 qEnc hv).count .TOFF = 0 := by
  dsimp only [dWExpandDet1, measureZ1AndBranch, DynamicCircuit.count, DynamicCircuit.identity]
  have h1 := wSeqFin_count_eq_zero .TOFF R
    (fun i ↦ wSplitPair (w0 i) (w1 i) (hv.w01_ne i i))
    (fun i ↦ wSplitPair_count_toff (w0 i) (w1 i) _)
  have h2 := wSeqFin_count_eq_zero .TOFF R
    (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) (fun _ ↦ rfl)
  have h3 := wSeqFin_count_eq_zero .TOFF R
    (fun i ↦ swap3Circ (w0 i) (w1 i) (hv.w01_ne i i))
    (fun i ↦ swap3Circ_count_toff (w0 i) (w1 i) _)
  simp [Circuit.count_seq, h1, h2, h3]

@[simp]
theorem dWExpandDet1_count_t {Var : Type} {n : ℕ} (v : Var) (R : ℕ) (ctrl : Wire n)
    (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValid R ctrl w0 w1 qEnc) :
    (dWExpandDet1 v R ctrl w0 w1 qEnc hv).count .T = 2 * R := by
  dsimp only [dWExpandDet1, measureZ1AndBranch, DynamicCircuit.count, DynamicCircuit.identity]
  have h1 := wSeqFin_count_const .T 2 R
    (fun i ↦ wSplitPair (w0 i) (w1 i) (hv.w01_ne i i))
    (fun i ↦ wSplitPair_count_t (w0 i) (w1 i) _)
  have h2 := wSeqFin_count_eq_zero .T R
    (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) (fun _ ↦ rfl)
  have h3 := wSeqFin_count_eq_zero .T R
    (fun i ↦ swap3Circ (w0 i) (w1 i) (hv.w01_ne i i))
    (fun i ↦ swap3Circ_count_t (w0 i) (w1 i) _)
  simp [Circuit.count_seq, h1, h2, h3]

theorem dWExpandDet1_bijectiveTransRealizes {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} (v : Var) (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValid R ctrl w0 w1 qEnc)
    (S : BitAssignment n → Bool)
    (hInv : ∀ β : BitAssignment n, S β = true → InvWSplitDet R w0 w1 qEnc β) :
    BijectiveTransRealizes v S
      (BijectiveBitMap.ofInvolutive (cswapRangeBits R ctrl w0 w1)
        (cswapRangeBits_involutive hv.toWPairDisj))
      (dWExpandDet1 v R ctrl w0 w1 qEnc hv) := by
  let cPre : Circuit n :=
    wSeqFin R (fun i ↦ wSplitPair (w0 i) (w1 i) (hv.w01_ne i i)) ;;ᶜ
      wSeqFin R (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) ;;ᶜ
      Circuit.CNOT ctrl qEnc hv.q_ctrl.symm
  let cFixTrue : Circuit n :=
    Circuit.X qEnc ;;ᶜ
      wSeqFin R (fun i ↦ swap3Circ (w0 i) (w1 i) (hv.w01_ne i i))
  have htoffPre : cPre.count .TOFF = 0 := by
    have h1 := wSeqFin_count_eq_zero .TOFF R
      (fun i ↦ wSplitPair (w0 i) (w1 i) (hv.w01_ne i i))
      (fun i ↦ wSplitPair_count_toff (w0 i) (w1 i) _)
    have h2 := wSeqFin_count_eq_zero .TOFF R
      (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) (fun _ ↦ rfl)
    simp [cPre, Circuit.count_seq, h1, h2]
  have htoffFix : cFixTrue.count .TOFF = 0 := by
    have h3 := wSeqFin_count_eq_zero .TOFF R
      (fun i ↦ swap3Circ (w0 i) (w1 i) (hv.w01_ne i i))
      (fun i ↦ swap3Circ_count_toff (w0 i) (w1 i) _)
    simp [cFixTrue, Circuit.count_seq, h3]
  have hBranch (β : BitAssignment n) (hS : S β = true) :
      ((QRegister.singleton qEnc).basisOutcomeProjector 0 * cPre.eval.1).mulVec
          (SelectSwapQROM.ket β) =
        SelectSwapQROM.sqrtHalf • SelectSwapQROM.ket (cswapRangeBits R ctrl w0 w1 β) ∧
      (cFixTrue.eval.1 * (QRegister.singleton qEnc).basisOutcomeProjector 1 *
        cPre.eval.1).mulVec (SelectSwapQROM.ket β) =
        SelectSwapQROM.sqrtHalf • SelectSwapQROM.ket (cswapRangeBits R ctrl w0 w1 β) := by
    obtain ⟨hq0, hw1_0, iStar, hw0_1, hw0_0⟩ := hInv β hS
    let βm := Function.update (Function.update β (w0 iStar) 0) (w1 iStar) 1
    have hcPre : cPre.eval.1.mulVec (SelectSwapQROM.ket β) =
        SelectSwapQROM.sqrtHalf • SelectSwapQROM.ket (Function.update β qEnc (β ctrl)) +
          SelectSwapQROM.sqrtHalf •
            SelectSwapQROM.ket (Function.update βm qEnc (1 + β ctrl)) := by
      dsimp only [cPre]
      rw [SelectSwapQROM.eval_seq_mulVec, SelectSwapQROM.eval_seq_mulVec,
        ket_wSplitSeq_oneHot R w0 w1 hv.w0_inj hv.w1_inj hv.w01_ne β iStar hw1_0 hw0_1 hw0_0,
        Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        ket_cnotToTargetSeq R w1 qEnc _ β,
        ket_cnotToTargetSeq R w1 qEnc _ βm,
        Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        SelectSwapQROM.ket_CNOT, SelectSwapQROM.ket_CNOT]
      have hsum_stay : (∑ i : Fin R, β (w1 i)) = 0 :=
        Finset.sum_eq_zero fun i _ ↦ hw1_0 i
      have hsum_move : (∑ i : Fin R, βm (w1 i)) = 1 := by
        rw [Finset.sum_eq_single iStar]
        · dsimp only [βm]; exact Function.update_self _ _ _
        · intro i _ hne
          dsimp only [βm]
          rw [Function.update_of_ne (hv.w1_inj.ne hne),
            Function.update_of_ne (hv.w01_ne iStar i).symm]
          exact hw1_0 i
        · intro habs; exact absurd (Finset.mem_univ iStar) habs
      have hq_βm : βm qEnc = 0 := by
        dsimp only [βm]
        rw [Function.update_of_ne (hv.q_w1 iStar), Function.update_of_ne (hv.q_w0 iStar)]
        exact hq0
      have hc_βm : βm ctrl = β ctrl := by
        dsimp only [βm]
        rw [Function.update_of_ne (hv.ctrl_w1 iStar), Function.update_of_ne (hv.ctrl_w0 iStar)]
      rw [hq0, hsum_stay, add_zero, hq_βm, hsum_move, zero_add,
        Function.update_self, Function.update_of_ne hv.q_ctrl.symm,
        Function.update_idem, zero_add,
        Function.update_self, Function.update_of_ne hv.q_ctrl.symm,
        hc_βm, Function.update_idem]
    have hTarget : SelectSwapQROM.ket (cswapRangeBits R ctrl w0 w1 β) =
        if β ctrl = 0 then SelectSwapQROM.ket β else SelectSwapQROM.ket βm := by
      rcases SelectSwapQROM.bit_cases (β ctrl) with hc0 | hc1
      · simp only [hc0, ↓reduceIte]
        congr 1; funext u; dsimp only [cswapRangeBits]; simp [hc0]
      · simp only [hc1, one_ne_zero, ↓reduceIte]
        congr 1; funext u
        by_cases hw_a : ∃ i : Fin R, u = w0 i
        · obtain ⟨i, rfl⟩ := hw_a
          rw [cswapRangeBits_w0 hv.toWPairDisj _ i, hc1, ite_eq_left rfl, hw1_0 i]
          dsimp only [βm]; rw [Function.update_of_ne (hv.w01_ne i iStar)]
          by_cases hi : i = iStar
          · subst hi; rw [Function.update_self]
          · rw [Function.update_of_ne (hv.w0_inj.ne hi), hw0_0 i hi]
        · by_cases hw_b : ∃ i : Fin R, u = w1 i
          · obtain ⟨i, rfl⟩ := hw_b
            rw [cswapRangeBits_w1 hv.toWPairDisj _ i, hc1, ite_eq_left rfl]
            dsimp only [βm]
            by_cases hi : i = iStar
            · subst hi; rw [Function.update_self]; exact hw0_1
            · rw [Function.update_of_ne (hv.w1_inj.ne hi),
                Function.update_of_ne (hv.w01_ne iStar i).symm, hw0_0 i hi, hw1_0 i]
          · rw [cswapRangeBits_other _ (fun i he ↦ hw_a ⟨i, he⟩) (fun i he ↦ hw_b ⟨i, he⟩)]
            dsimp only [βm]
            rw [Function.update_of_ne (fun he ↦ hw_b ⟨iStar, he⟩),
              Function.update_of_ne (fun he ↦ hw_a ⟨iStar, he⟩)]
    have hq_βm : βm qEnc = 0 := by
      dsimp only [βm]
      rw [Function.update_of_ne (hv.q_w1 iStar), Function.update_of_ne (hv.q_w0 iStar)]
      exact hq0
    have hSwap_β : (wSeqFin R (fun i ↦ swap3Circ (w0 i) (w1 i)
        (hv.w01_ne i i))).eval.1.mulVec (SelectSwapQROM.ket β) = SelectSwapQROM.ket βm := by
      rw [ket_swap3Seq_single R w0 w1 hv.w0_inj hv.w1_inj hv.w01_ne
        β iStar hw0_0 (fun i _ ↦ hw1_0 i)]
      dsimp only [βm]; rw [hw1_0 iStar, hw0_1]
    have hSwap_βm : (wSeqFin R (fun i ↦ swap3Circ (w0 i) (w1 i)
        (hv.w01_ne i i))).eval.1.mulVec (SelectSwapQROM.ket βm) = SelectSwapQROM.ket β := by
      rw [ket_swap3Seq_single R w0 w1 hv.w0_inj hv.w1_inj hv.w01_ne βm iStar
        (fun i hi ↦ by
          dsimp only [βm]
          rw [Function.update_of_ne (hv.w01_ne i iStar),
            Function.update_of_ne (hv.w0_inj.ne hi)]
          exact hw0_0 i hi)
        (fun i hi ↦ by
          dsimp only [βm]
          rw [Function.update_of_ne (hv.w1_inj.ne hi),
            Function.update_of_ne (hv.w01_ne iStar i).symm]
          exact hw1_0 i)]
      congr 1; funext u; dsimp only [βm]
      by_cases hua : u = w0 iStar
      · subst hua
        rw [Function.update_of_ne (hv.w01_ne iStar iStar),
          Function.update_self, Function.update_self, hw0_1]
      · by_cases hub : u = w1 iStar
        · subst hub
          rw [Function.update_self, Function.update_of_ne (hv.w01_ne iStar iStar),
            Function.update_self, hw1_0 iStar]
        · simp [Function.update_of_ne hua, Function.update_of_ne hub]
    have h11 : (1 : ZMod 2) + 1 = 0 := rfl
    have h1ne0 : (1 : ZMod 2) ≠ 0 := one_ne_zero
    have h0ne1 : (0 : ZMod 2) ≠ 1 := zero_ne_one
    constructor
    · rw [← Matrix.mulVec_mulVec, hcPre, hTarget, Matrix.mulVec_add,
        Matrix.mulVec_smul, Matrix.mulVec_smul,
        SelectSwapQROM.singleton_projector_zero_mulVec_ket,
        SelectSwapQROM.singleton_projector_zero_mulVec_ket]
      rcases SelectSwapQROM.bit_cases (β ctrl) with hc0 | hc1
      · simp only [hc0, add_zero, Function.update_self, h1ne0, ↓reduceIte, smul_zero, add_zero]
        rw [← hq0, Function.update_eq_self]
      · simp only [hc1, h11, Function.update_self, h1ne0, ↓reduceIte, smul_zero, zero_add]
        rw [← hq_βm, Function.update_eq_self]
    · rw [Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hcPre, hTarget,
        Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        SelectSwapQROM.singleton_projector_one_mulVec_ket,
        SelectSwapQROM.singleton_projector_one_mulVec_ket]
      rcases SelectSwapQROM.bit_cases (β ctrl) with hc0 | hc1
      · simp only [hc0, add_zero, Function.update_self, h0ne1, ↓reduceIte,
          smul_zero, zero_add, cFixTrue, Matrix.mulVec_smul, SelectSwapQROM.eval_seq_mulVec,
          SelectSwapQROM.ket_X, Function.update_idem, h11]
        rw [← hq_βm, Function.update_eq_self, hSwap_βm]
      · simp only [hc1, h11, Function.update_self, h0ne1, h1ne0, ↓reduceIte,
          smul_zero, add_zero, cFixTrue, Matrix.mulVec_smul, SelectSwapQROM.eval_seq_mulVec,
          SelectSwapQROM.ket_X, Function.update_idem]
        rw [← hq0, Function.update_eq_self, hSwap_β]
  exact BijectiveTransRealizes.of_measureZ1AndBranch v qEnc cPre cFixTrue htoffPre htoffFix S
    (BijectiveBitMap.ofInvolutive (cswapRangeBits R ctrl w0 w1)
      (cswapRangeBits_involutive hv.toWPairDisj))
    (fun β hS ↦ (hBranch β hS).1) (fun β hS ↦ (hBranch β hS).2)

/-! ### `EquivRev`, `splitRevLoop`, `cnotMaskRev` & `(N, off)`-Parametric `wHot46` + `pKeepMux25` -/

/-- Equivalence between dynamic circuit `P` and reversible `p` on input predicate `S`. -/
def EquivRev {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (S : BitAssignment N → Bool)
    (p : GroupUnary.RevCompute N) (P : DynamicCircuit Var N) : Prop :=
  (∀ β, S β = true → p.validOn β = true) ∧
    ∃ m : BijectiveBitMap N,
      BijectiveTransRealizes v S m P ∧
      ∀ β, S β = true → m.fwd β = p.fwdBits β

theorem EquivRev.ofRevCompute {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (S : BitAssignment N → Bool) (p : GroupUnary.RevCompute N)
    (hval : ∀ β, S β = true → p.validOn β = true) :
    EquivRev v S p (Lac2Folded184Select.revComputeDyn p) :=
  ⟨hval, BijectiveBitMap.ofRevCompute p, BijectiveTransRealizes.ofRevComputeBij v p S hval,
    fun _ _ ↦ rfl⟩

theorem EquivRev.seq {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    {v : Var} {S : BitAssignment N → Bool}
    {p1 p2 : GroupUnary.RevCompute N} {P1 P2 : DynamicCircuit Var N}
    (h1 : EquivRev v S p1 P1)
    (h2 : EquivRev v (fun γ ↦ S (p1.invBits γ)) p2 P2) :
    EquivRev v S (p1.seq p2) (P1.seq P2) := by
  obtain ⟨hv1, m1, htr1, hfwd1⟩ := h1
  obtain ⟨hv2, m2, htr2, hfwd2⟩ := h2
  have htr1' : BijectiveTransRealizes v S (BijectiveBitMap.ofRevCompute p1) P1 :=
    htr1.congr_fwd hfwd1
  refine ⟨fun β hS ↦ Bool.and_eq_true_iff.mpr ⟨hv1 β hS, ?_⟩,
    (BijectiveBitMap.ofRevCompute p1).compBitMap m2, htr1'.seqBijTrans htr2, fun β hS ↦ ?_⟩
  · have hγ : S (p1.invBits (p1.fwdBits β)) = true := by rwa [p1.invBits_fwdBits]
    exact hv2 (p1.fwdBits β) hγ
  · have hγ : S (p1.invBits (p1.fwdBits β)) = true := by rwa [p1.invBits_fwdBits]
    exact hfwd2 (p1.fwdBits β) hγ

/-- `R`-pair (`R` ANDs) classical reversible controlled-swap splitter matching `dWExpandDet1`. -/
def splitRevLoop {N : ℕ} (ctrl : Wire N) :
    (R : ℕ) → (w0 w1 : Fin R → Wire N) → WPairDisj R ctrl w0 w1 → GroupUnary.RevCompute N
  | 0, _, _, _ => .id
  | R + 1, w0, w1, hd =>
      .seq
        (.seq
          (.andGate ctrl (w0 0) (w1 0) (hd.ctrl_w0 0) (hd.ctrl_w1 0) (hd.w01_ne 0 0))
          (.cnot (w1 0) (w0 0) (hd.w01_ne 0 0).symm))
        (splitRevLoop ctrl R (fun i ↦ w0 i.succ) (fun i ↦ w1 i.succ)
          ⟨hd.w0_inj.comp (Fin.succ_injective R), hd.w1_inj.comp (Fin.succ_injective R),
            fun i j ↦ hd.w01_ne i.succ j.succ,
            fun i ↦ hd.ctrl_w0 i.succ, fun i ↦ hd.ctrl_w1 i.succ⟩)

@[simp]
theorem numAnd_splitRevLoop {N : ℕ} (ctrl : Wire N) :
    ∀ (R : ℕ) (w0 w1 : Fin R → Wire N) (hd : WPairDisj R ctrl w0 w1),
      (splitRevLoop ctrl R w0 w1 hd).numAnd = R
  | 0, _, _, _ => rfl
  | R + 1, w0, w1, hd => by
      simp only [splitRevLoop, GroupUnary.RevCompute.numAnd,
        numAnd_splitRevLoop ctrl R (fun i ↦ w0 i.succ) (fun i ↦ w1 i.succ)]
      omega

theorem splitRevLoop_spec {N : ℕ} (ctrl : Wire N) :
    ∀ (R : ℕ) (w0 w1 : Fin R → Wire N) (hd : WPairDisj R ctrl w0 w1) (β : BitAssignment N),
      (∀ i : Fin R, β (w1 i) = 0) →
      (splitRevLoop ctrl R w0 w1 hd).validOn β = true ∧
        (splitRevLoop ctrl R w0 w1 hd).fwdBits β = cswapRangeBits R ctrl w0 w1 β
  | 0, w0, w1, _, β, _ => by
      refine ⟨rfl, ?_⟩
      funext u; dsimp only [splitRevLoop, GroupUnary.RevCompute.fwdBits, cswapRangeBits]
      by_cases hc : β ctrl = 1
      · rw [ite_eq_left hc, dite_eq_right (fun ⟨i, _⟩ ↦ Fin.elim0 i),
          dite_eq_right (fun ⟨i, _⟩ ↦ Fin.elim0 i)]
      · rw [ite_eq_right hc]
  | R + 1, w0, w1, hd, β, hw1 => by
      let hd' : WPairDisj R ctrl (fun i ↦ w0 i.succ) (fun i ↦ w1 i.succ) :=
        ⟨hd.w0_inj.comp (Fin.succ_injective R), hd.w1_inj.comp (Fin.succ_injective R),
          fun i j ↦ hd.w01_ne i.succ j.succ,
          fun i ↦ hd.ctrl_w0 i.succ, fun i ↦ hd.ctrl_w1 i.succ⟩
      let p0 : GroupUnary.RevCompute N :=
        .seq (.andGate ctrl (w0 0) (w1 0) (hd.ctrl_w0 0) (hd.ctrl_w1 0) (hd.w01_ne 0 0))
          (.cnot (w1 0) (w0 0) (hd.w01_ne 0 0).symm)
      have hv0 : p0.validOn β = true := by
        simp [p0, GroupUnary.RevCompute.validOn, hw1 0]
      let β₁ := p0.fwdBits β
      have hβ1_w0 : β₁ (w0 0) = if β ctrl = 1 then β (w1 0) else β (w0 0) := by
        dsimp only [β₁, p0, GroupUnary.RevCompute.fwdBits]
        rw [Function.update_self, Function.update_of_ne (hd.w01_ne 0 0),
          Function.update_self, hw1 0, zero_add]
        rcases SelectSwapQROM.bit_cases (β ctrl) with hc | hc <;>
          rcases SelectSwapQROM.bit_cases (β (w0 0)) with ha | ha <;> simp [hc, ha]
      have hβ1_w1 : β₁ (w1 0) = if β ctrl = 1 then β (w0 0) else β (w1 0) := by
        dsimp only [β₁, p0, GroupUnary.RevCompute.fwdBits]
        rw [Function.update_of_ne (hd.w01_ne 0 0).symm, Function.update_self, hw1 0, zero_add]
        rcases SelectSwapQROM.bit_cases (β ctrl) with hc | hc <;>
          rcases SelectSwapQROM.bit_cases (β (w0 0)) with ha | ha <;> simp [hc, ha]
      have hβ1_other {u : Wire N} (hu0 : u ≠ w0 0) (hu1 : u ≠ w1 0) : β₁ u = β u := by
        dsimp only [β₁, p0, GroupUnary.RevCompute.fwdBits]
        rw [Function.update_of_ne hu0, Function.update_of_ne hu1]
      have hw1_tail (i : Fin R) : β₁ (w1 i.succ) = 0 := by
        rw [hβ1_other (hd.w01_ne 0 i.succ).symm (hd.w1_inj.ne (Fin.succ_ne_zero i))]
        exact hw1 i.succ
      obtain ⟨hv_t, hf_t⟩ := splitRevLoop_spec ctrl R _ _ hd' β₁ hw1_tail
      refine ⟨Bool.and_eq_true_iff.mpr ⟨hv0, hv_t⟩, ?_⟩
      change (splitRevLoop ctrl R _ _ hd').fwdBits β₁ = cswapRangeBits (R + 1) ctrl w0 w1 β
      rw [hf_t]
      have hctrl : β₁ ctrl = β ctrl := hβ1_other (hd.ctrl_w0 0) (hd.ctrl_w1 0)
      funext u
      by_cases h0 : ∃ k : Fin (R + 1), u = w0 k
      · obtain ⟨k, rfl⟩ := h0
        rw [cswapRangeBits_w0 hd β k]
        cases k using Fin.cases with
        | zero =>
            rw [cswapRangeBits_other β₁
              (fun i ↦ hd.w0_inj.ne (Fin.succ_ne_zero i).symm)
              (fun i ↦ hd.w01_ne 0 i.succ), hβ1_w0]
        | succ i =>
            change cswapRangeBits R ctrl (fun j ↦ w0 j.succ) (fun j ↦ w1 j.succ) β₁
                (w0 i.succ) = _
            rw [cswapRangeBits_w0 hd' β₁ i, hctrl,
              hβ1_other (hd.w01_ne 0 i.succ).symm (hd.w1_inj.ne (Fin.succ_ne_zero i)),
              hβ1_other (hd.w0_inj.ne (Fin.succ_ne_zero i)) (hd.w01_ne i.succ 0)]
      · by_cases h1 : ∃ k : Fin (R + 1), u = w1 k
        · obtain ⟨k, rfl⟩ := h1
          rw [cswapRangeBits_w1 hd β k]
          cases k using Fin.cases with
          | zero =>
              rw [cswapRangeBits_other β₁
                (fun i ↦ (hd.w01_ne i.succ 0).symm)
                (fun i ↦ hd.w1_inj.ne (Fin.succ_ne_zero i).symm), hβ1_w1]
          | succ i =>
              change cswapRangeBits R ctrl (fun j ↦ w0 j.succ) (fun j ↦ w1 j.succ) β₁
                  (w1 i.succ) = _
              rw [cswapRangeBits_w1 hd' β₁ i, hctrl,
                hβ1_other (hd.w0_inj.ne (Fin.succ_ne_zero i)) (hd.w01_ne i.succ 0),
                hβ1_other (hd.w01_ne 0 i.succ).symm (hd.w1_inj.ne (Fin.succ_ne_zero i))]
        · have hu0 (k : Fin (R + 1)) : u ≠ w0 k := fun he ↦ h0 ⟨k, he⟩
          have hu1 (k : Fin (R + 1)) : u ≠ w1 k := fun he ↦ h1 ⟨k, he⟩
          rw [cswapRangeBits_other β₁ (fun i ↦ hu0 i.succ) (fun i ↦ hu1 i.succ),
            cswapRangeBits_other β hu0 hu1, hβ1_other (hu0 0) (hu1 0)]

theorem EquivRev.ofDWExpandDet1 {Var : Type} [Fintype Var] [DecidableEq Var] {N : ℕ}
    (v : Var) (R : ℕ) (ctrl : Wire N) (w0 w1 : Fin R → Wire N) (qEnc : Wire N)
    (hv : WSplitValid R ctrl w0 w1 qEnc) (S : BitAssignment N → Bool)
    (hInv : ∀ β, S β = true → InvWSplitDet R w0 w1 qEnc β) :
    EquivRev v S (splitRevLoop ctrl R w0 w1 hv.toWPairDisj)
      (dWExpandDet1 v R ctrl w0 w1 qEnc hv) :=
  ⟨fun β hS ↦ (splitRevLoop_spec ctrl R w0 w1 hv.toWPairDisj β (hInv β hS).2.1).1,
    BijectiveBitMap.ofInvolutive (cswapRangeBits R ctrl w0 w1)
      (cswapRangeBits_involutive hv.toWPairDisj),
    dWExpandDet1_bijectiveTransRealizes v R ctrl w0 w1 qEnc hv S hInv,
    fun β hS ↦ (splitRevLoop_spec ctrl R w0 w1 hv.toWPairDisj β (hInv β hS).2.1).2.symm⟩

/-- `0`-AND masked CNOT fan-in XORing `∑ i, if mask i then β (rSrc i) else 0` into `tgt`. -/
def cnotMaskRev {N : ℕ} (tgt : Wire N) :
    (M : ℕ) → (rSrc : QRegister M N) → (∀ i : Fin M, rSrc i ≠ tgt) → (Fin M → Bool) →
      GroupUnary.RevCompute N
  | 0, _, _, _ => .id
  | M + 1, rSrc, hne, mask =>
      let iLast : Fin (M + 1) := ⟨M, Nat.lt_succ_self M⟩
      let emb := Fin.castLEEmb (Nat.le_succ M)
      .seq
        (if mask iLast then .cnot (rSrc iLast) tgt (hne iLast) else .id)
        (cnotMaskRev tgt M (rSrc.subregister emb)
          (fun j ↦ hne (Fin.castLE (Nat.le_succ M) j))
          (fun j ↦ mask (Fin.castLE (Nat.le_succ M) j)))

@[simp]
theorem numAnd_cnotMaskRev {N M : ℕ} (tgt : Wire N) (rSrc : QRegister M N)
    (hne : ∀ i : Fin M, rSrc i ≠ tgt) (mask : Fin M → Bool) :
    (cnotMaskRev tgt M rSrc hne mask).numAnd = 0 := by
  induction M with
  | zero => rfl
  | succ M ih =>
      simp only [cnotMaskRev, GroupUnary.RevCompute.numAnd]
      have h0 : (if mask ⟨M, Nat.lt_succ_self M⟩ then
          GroupUnary.RevCompute.cnot (rSrc ⟨M, Nat.lt_succ_self M⟩) tgt
            (hne ⟨M, Nat.lt_succ_self M⟩)
          else .id).numAnd = 0 := by split_ifs <;> rfl
      rw [h0, ih (rSrc.subregister (Fin.castLEEmb (Nat.le_succ M)))
        (fun j ↦ hne (Fin.castLE (Nat.le_succ M) j))
        (fun j ↦ mask (Fin.castLE (Nat.le_succ M) j))]

theorem cnotMaskRev_spec {N M : ℕ} (tgt : Wire N) (rSrc : QRegister M N)
    (hne : ∀ i : Fin M, rSrc i ≠ tgt) (mask : Fin M → Bool) (β : BitAssignment N) :
    (cnotMaskRev tgt M rSrc hne mask).validOn β = true ∧
      (cnotMaskRev tgt M rSrc hne mask).fwdBits β =
        Function.update β tgt (β tgt + ∑ i : Fin M, if mask i then β (rSrc i) else 0) := by
  induction M generalizing β with
  | zero =>
      simp [cnotMaskRev, GroupUnary.RevCompute.validOn, GroupUnary.RevCompute.fwdBits]
  | succ M ih =>
      let iLast : Fin (M + 1) := ⟨M, Nat.lt_succ_self M⟩
      let emb := Fin.castLEEmb (Nat.le_succ M)
      let p0 : GroupUnary.RevCompute N :=
        if mask iLast then .cnot (rSrc iLast) tgt (hne iLast) else .id
      have hv0 : p0.validOn β = true := by dsimp [p0]; split_ifs <;> rfl
      have hf0 : p0.fwdBits β =
          Function.update β tgt (β tgt + if mask iLast then β (rSrc iLast) else 0) := by
        dsimp [p0]
        by_cases hm : mask iLast = true
        · simp [hm, GroupUnary.RevCompute.fwdBits]
        · simp [hm, GroupUnary.RevCompute.fwdBits]
      obtain ⟨hvt, hft⟩ := ih (rSrc.subregister emb)
        (fun j ↦ hne (Fin.castLE (Nat.le_succ M) j))
        (fun j ↦ mask (Fin.castLE (Nat.le_succ M) j)) (p0.fwdBits β)
      refine ⟨Bool.and_eq_true_iff.mpr ⟨hv0, hvt⟩, ?_⟩
      change (cnotMaskRev tgt M (rSrc.subregister emb) _ _).fwdBits (p0.fwdBits β) = _
      rw [hft, hf0]
      have hsum : (∑ j : Fin M, if mask (Fin.castLE (Nat.le_succ M) j) then
          (Function.update β tgt (β tgt + if mask iLast then β (rSrc iLast) else 0))
            ((rSrc.subregister emb) j) else 0) =
          ∑ j : Fin M, if mask (Fin.castLE (Nat.le_succ M) j) then
            β (rSrc (Fin.castLE (Nat.le_succ M) j)) else 0 := by
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        change (if mask (Fin.castLE (Nat.le_succ M) j) then
          Function.update β tgt _ (rSrc (Fin.castLE (Nat.le_succ M) j)) else 0) = _
        rw [Function.update_of_ne (hne (Fin.castLE (Nat.le_succ M) j))]
      rw [Function.update_self, hsum, Function.update_idem, add_assoc]
      congr 2
      rw [Fin.sum_univ_castSucc, add_comm]
      rfl

/-- `1`-AND initial `4`-way one-hot decoder on `(x₂, x₃)` into `off .. off + 3`. -/
def init4Rev {N : ℕ} (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    GroupUnary.RevCompute N :=
  let c0 : Wire N := ⟨2, by omega⟩
  let c1 : Wire N := ⟨3, by omega⟩
  let h0 : Wire N := ⟨off, by omega⟩
  let h1 : Wire N := ⟨off + 1, by omega⟩
  let h2 : Wire N := ⟨off + 2, by omega⟩
  let h3 : Wire N := ⟨off + 3, by omega⟩
  .seq (.andGate c0 c1 h3
          (fun h ↦ by have := congrArg Fin.val h; dsimp [c0, c1] at this; omega)
          (fun h ↦ by have := congrArg Fin.val h; dsimp [c0, h3] at this; omega)
          (fun h ↦ by have := congrArg Fin.val h; dsimp [c1, h3] at this; omega))
    (.seq (.cnot c1 h2 (fun h ↦ by have := congrArg Fin.val h; dsimp [c1, h2] at this; omega))
      (.seq (.cnot h3 h2 (fun h ↦ by have := congrArg Fin.val h; dsimp [h3, h2] at this; omega))
        (.seq (.cnot c0 h1 (fun h ↦ by have := congrArg Fin.val h; dsimp [c0, h1] at this; omega))
          (.seq (.cnot h3 h1 (fun h ↦ by have := congrArg Fin.val h; dsimp [h3, h1] at this; omega))
            (.seq (.x h0)
              (.seq (.cnot c0 h0
                  (fun h ↦ by have := congrArg Fin.val h; dsimp [c0, h0] at this; omega))
                (.cnot h2 h0
                  (fun h ↦ by have := congrArg Fin.val h; dsimp [h2, h0] at this; omega))))))))

/-- Disjointness certificate for the `4`-wire `x₄` W-state split. -/
theorem wSplit4Valid {N : ℕ} (off : ℕ) (h12 : 12 ≤ off) (hN : off + 77 ≤ N) :
    WSplitValid (n := N) 4 ⟨4, by omega⟩
      (fun i : Fin 4 ↦ ⟨off + i.val, by omega⟩)
      (fun i : Fin 4 ↦ ⟨off + 4 + i.val, by omega⟩)
      ⟨off + 49, by omega⟩ where
  w0_inj i j h := Fin.ext (by have := congrArg Fin.val h; try dsimp at this; omega)
  w1_inj i j h := Fin.ext (by have := congrArg Fin.val h; try dsimp at this; omega)
  w01_ne i j h := by have := congrArg Fin.val h; try dsimp at this; omega
  ctrl_w0 i h := by have := congrArg Fin.val h; try dsimp at this; omega
  ctrl_w1 i h := by have := congrArg Fin.val h; try dsimp at this; omega
  q_ctrl h := by have := congrArg Fin.val h; try dsimp at this; omega
  q_w0 i h := by have := congrArg Fin.val h; try dsimp at this; omega
  q_w1 i h := by have := congrArg Fin.val h; try dsimp at this; omega

