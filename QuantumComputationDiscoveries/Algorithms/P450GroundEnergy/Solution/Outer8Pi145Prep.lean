theorem alt4CopyRev_spec (β : BitAssignment 103) :
    alt4CopyRev.validOn β = true ∧
      (∀ u : Wire 103, (u.val < 12 ∨ 16 ≤ u.val) → alt4CopyRev.fwdBits β u = β u) ∧
      (∀ u : Wire 103, (u.val < 12 ∨ 16 ≤ u.val) → alt4CopyRev.invBits β u = β u) ∧
      alt4CopyRev.fwdBits β ⟨12, by decide⟩ = β ⟨12, by decide⟩ + β ⟨93, by decide⟩ ∧
      alt4CopyRev.fwdBits β ⟨13, by decide⟩ = β ⟨13, by decide⟩ + β ⟨94, by decide⟩ ∧
      alt4CopyRev.fwdBits β ⟨14, by decide⟩ =
        β ⟨14, by decide⟩ + β ⟨92, by decide⟩ + β ⟨101, by decide⟩ ∧
      alt4CopyRev.fwdBits β ⟨15, by decide⟩ =
        β ⟨15, by decide⟩ + β ⟨92, by decide⟩ + β ⟨102, by decide⟩ := by
  have hfw (ξ : BitAssignment 103) (u : Wire 103) (hu : u.val < 12 ∨ 16 ≤ u.val) :
      alt4CopyRev.fwdBits ξ u = ξ u := by
    dsimp only [alt4CopyRev, GroupUnary.RevCompute.fwdBits]
    have hne (t : ℕ) (ht1 : 12 ≤ t) (ht2 : t < 16) : u ≠ ⟨t, by omega⟩ :=
