/-- `9`-wire Grover-`184` subregister (`0..8`) inside `nonAlt13Loc`, borrowing `kLoc 0` as the
9th Grover qubit while `kLoc` is in `|0^4⟩`. -/
def nonAltXoAuxReg : QRegister 9 13 :=
  QRegister.block 0 9 (by decide)

/-- `4`-wire packet-coin subregister (`8..11`) inside `nonAlt13Loc`. -/
def nonAltKReg : QRegister 4 13 :=
  QRegister.block 8 4 (by decide)

