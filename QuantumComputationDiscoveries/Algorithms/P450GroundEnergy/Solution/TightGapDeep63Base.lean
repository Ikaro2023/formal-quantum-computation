  · exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true
  · exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true

private lemma evalOneModeKey_comp {α β : Type} (f : α → β)
    (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ) (gb : List ℕ) (sGb : ℕ)
    (k : Bool → ℕ → ℕ → α) :
    evalOneModeKey iw29 sumIw29 sumPos sumNeg gb sGb (fun a b c ↦ f (k a b c)) =
      f (evalOneModeKey iw29 sumIw29 sumPos sumNeg gb sGb k) := by
  unfold evalOneModeKey; dsimp only; simp only [strictNat_eq]
  split_ifs <;> rfl

private def DiagMValid (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    (mw : ℕ × ℕ) (p : ℕ) : Prop :=
  p < 58 ∧
    (mw.1 : ℝ) - 50000000000 ≤ diagModeLists uFn iwRow p * 100000 ∧
    diagModeLists uFn iwRow p * 100000 ≤ (mw.1 : ℝ) + (mw.2 : ℝ) - 50000000000

private lemma buildDiagMIvsCPS_sound (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    {iw29 : List ℕ} {sumIw29 sumPos sumNeg : ℕ}
    (hiw29 : iw29 = getRow29Go 29 iwRow) (hsumIw : sumIw29 = sumList iw29)
    (hsumPos : sumPos = sumList ((List.range 29).map (mPosFn iwRow)))
    (hsumNeg : sumNeg = sumList ((List.range 29).map (mNegFn iwRow))) :
    ∀ (dgs : KeyGList) (ps : List ℕ) (acc : PairList) (accPs : List ℕ),
      List.Forall₂ (fun e q ↦ DiagGEntryValid uFn q e) (keyGToList dgs) ps →
      List.Forall₂ (DiagMValid uFn iwRow) (pairToList acc).reverse accPs →
      ∀ (P : Bool → PairList → Prop),
        (∀ (ok : Bool) (res : PairList),
          (ok = true →
            List.Forall₂ (DiagMValid uFn iwRow) (pairToList res) (accPs ++ ps)) →
          P ok res) →
        buildDiagMIvsCPS iw29 sumIw29 sumPos sumNeg dgs acc P
  | .nil, ps, acc, accPs, hdgs, hacc, P, hk => by
    cases hdgs
    simp only [buildDiagMIvsCPS, revPairListCPS_eq]
    exact hk true _ fun _ ↦ by
      rw [pairToList_rev, pairToList, List.append_nil, List.append_nil]
      exact hacc
  | .cons _ gb sGb rest, ps, acc, accPs, hdgs, hacc, P, hk => by
    cases hdgs with
    | @cons _ p _ ps' hhd htl =>
      obtain ⟨hp, hgb, hsGb⟩ := hhd
      unfold buildDiagMIvsCPS
      refine evalOneModeKey_sound uFn iwRow hiw29 hsumIw hsumPos hsumNeg hgb hsGb _
        fun ok lo5 w5 hm ↦ ?_
      cases ok with
      | false => exact hk false .nil fun h ↦ absurd h Bool.false_ne_true
      | true =>
        simp only [↓reduceIte]
        have hmv : DiagMValid uFn iwRow (lo5, w5) p := by
          refine ⟨hp, ?_⟩
          rw [diagModeLists_of_lt uFn iwRow hp]
          exact hm rfl
        have hacc' : List.Forall₂ (DiagMValid uFn iwRow)
            (pairToList (.cons lo5 w5 acc)).reverse (accPs ++ [p]) := by
          simp only [pairToList, List.reverse_cons]
          exact forall2_append hacc (.cons hmv .nil)
        refine buildDiagMIvsCPS_sound uFn iwRow hiw29 hsumIw hsumPos hsumNeg
          rest ps' (.cons lo5 w5 acc) (accPs ++ [p]) htl hacc' P fun ok2 res h2 ↦
            hk ok2 res fun hok2 ↦ ?_
        exact forall2_append_assoc (h2 hok2)

private lemma buildDiagMIvsCPS_comp {α β : Type} (f : α → β)
    (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ) :
    ∀ (dgs : KeyGList) (acc : PairList) (k : Bool → PairList → α),
      buildDiagMIvsCPS iw29 sumIw29 sumPos sumNeg dgs acc (fun a b ↦ f (k a b)) =
        f (buildDiagMIvsCPS iw29 sumIw29 sumPos sumNeg dgs acc k)
  | .nil, _, _ => by simp [buildDiagMIvsCPS, revPairListCPS_eq]
  | .cons _ gb sGb rest, acc, k => by
    unfold buildDiagMIvsCPS
    rw [← evalOneModeKey_comp f]
    refine cps3_congr _ fun ok lo5 w5 ↦ ?_
    split_ifs
    · exact buildDiagMIvsCPS_comp f iw29 sumIw29 sumPos sumNeg rest _ k
    · rfl

private def ActiveIvValid (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    (ent : ℕ × ℕ × ℕ) : Prop :=
  (ent.2.1 : ℝ) - 125000000 ≤ keyModeLists uFn iwRow ent.1 * 250 ∧
  keyModeLists uFn iwRow ent.1 * 250 ≤ (ent.2.1 : ℝ) + (ent.2.2 : ℝ) - 125000000

private lemma buildActiveM2IvsCPS_sound (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    {iw29 : List ℕ} {sumIw29 sumPos sumNeg : ℕ}
    (hiw29 : iw29 = getRow29Go 29 iwRow) (hsumIw : sumIw29 = sumList iw29)
    (hsumPos : sumPos = sumList ((List.range 29).map (mPosFn iwRow)))
    (hsumNeg : sumNeg = sumList ((List.range 29).map (mNegFn iwRow))) :
    ∀ (ags : KeyGList) (acc : IvList) (cnt : ℕ),
      (∀ e ∈ keyGToList ags, KeyGEntryValid uFn e) →
      (∀ t ∈ (ivToList acc).reverse, ActiveIvValid uFn iwRow t) →
      ∀ (P : Bool → IvList → ℕ → Prop),
        (∀ (ok : Bool) (res : IvList) (cnt' : ℕ),
          (ok = true → ∀ t ∈ ivToList res, ActiveIvValid uFn iwRow t) →
          P ok res cnt') →
        buildActiveM2IvsCPS iw29 sumIw29 sumPos sumNeg ags acc cnt P
  | .nil, acc, cnt, _, hacc, P, hk => by
    simp only [buildActiveM2IvsCPS, revIvListCPS_eq]
    exact hk true _ cnt fun _ t ht ↦ by
      rw [ivToList_rev, ivToList, List.append_nil] at ht
      exact hacc t ht
  | .cons key gb sGb rest, acc, cnt, hags, hacc, P, hk => by
    obtain ⟨hp, hq, hgb, hsGb⟩ := hags (key, gb, sGb) List.mem_cons_self
    have hrest : ∀ e ∈ keyGToList rest, KeyGEntryValid uFn e :=
      fun e he ↦ hags e (List.mem_cons_of_mem _ he)
    unfold buildActiveM2IvsCPS
    refine evalOneModeKey_sound uFn iwRow hiw29 hsumIw hsumPos hsumNeg hgb hsGb _
      fun ok lo5 w5 hm ↦ ?_
    cases ok with
    | false => exact hk false .nil 0 fun h ↦ absurd h Bool.false_ne_true
    | true =>
      simp only [↓reduceIte, strictNat_eq, Nat.add_eq, Nat.sub_eq, nat_div_def]
      obtain ⟨hm_lo, hm_hi⟩ := hm rfl
      set lo3 := lo5 / 400
      set hi3 := (lo5 + w5 + 399) / 400
      have hlo_hi3 : lo3 ≤ hi3 :=
        Nat.div_le_div_right (by omega : lo5 ≤ lo5 + w5 + 399)
      have hkm : keyModeLists uFn iwRow key =
          modeValLists uFn iwRow ⟨key / 64, hp⟩ ⟨key % 64, hq⟩ := by
        unfold keyModeLists; simp [hp, hq]
      have hiv : ActiveIvValid uFn iwRow (key, lo3, hi3 - lo3) := by
        unfold ActiveIvValid
        dsimp only
        rw [hkm, Nat.cast_sub hlo_hi3]
        have hf := nat_div_le_real (n := lo5) (d := 400)
        have hc := real_le_nat_cdiv (n := lo5 + w5) (d := 400) (k := 399) (by decide)
        rw [Nat.cast_add] at hc
        constructor <;> linarith
      refine buildActiveM2IvsCPS_sound uFn iwRow hiw29 hsumIw hsumPos hsumNeg
        rest (.cons key lo3 (hi3 - lo3) acc) (cnt + 1) hrest
        (fun t ht ↦ ?_) P hk
      simp only [ivToList, List.reverse_cons, List.mem_append, List.mem_singleton] at ht
      rcases ht with ht0 | rfl
      · exact hacc t ht0
      · exact hiv

private lemma buildActiveM2IvsCPS_comp {α β : Type} (f : α → β)
    (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ) :
    ∀ (ags : KeyGList) (acc : IvList) (cnt : ℕ) (k : Bool → IvList → ℕ → α),
      buildActiveM2IvsCPS iw29 sumIw29 sumPos sumNeg ags acc cnt (fun a b c ↦ f (k a b c)) =
        f (buildActiveM2IvsCPS iw29 sumIw29 sumPos sumNeg ags acc cnt k)
  | .nil, _, _, _ => by simp [buildActiveM2IvsCPS, revIvListCPS_eq]
  | .cons _ gb sGb rest, acc, cnt, k => by
    unfold buildActiveM2IvsCPS
    rw [← evalOneModeKey_comp f]
    refine cps3_congr _ fun ok lo5 w5 ↦ ?_
    split_ifs
    · simp only [strictNat_eq]
      exact buildActiveM2IvsCPS_comp f iw29 sumIw29 sumPos sumNeg rest _ _ k
    · rfl

private def KeyIvTreeSound (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ) : KeyIvTree → Prop
  | .empty => True
  | .node l nk lo w rt =>
    ActiveIvValid uFn iwRow (nk, lo, w) ∧
    KeyIvTreeSound uFn iwRow l ∧ KeyIvTreeSound uFn iwRow rt

private lemma buildIvTreeFastCPS_succ_succ_cons {α : Type}
    (fuel n nk lo w : ℕ) (rest : IvList) (k : KeyIvTree → IvList → α) :
    buildIvTreeFastCPS (fuel + 1) (n + 1) (.cons nk lo w rest) k =
      if Nat.beq (n + 1) 1 then
        k (.node .empty nk lo w .empty) rest
      else
        strictNat (Nat.div (n + 1) 2) fun half ↦
        strictNat (Nat.sub (Nat.sub (n + 1) 1) half) fun rLen ↦
        buildIvTreeFastCPS fuel half (.cons nk lo w rest) fun lTree midAndRight ↦
        match midAndRight with
        | .nil => k lTree .nil
        | .cons nk' lo' w' rightXs =>
          buildIvTreeFastCPS fuel rLen rightXs fun rTree remXs ↦
            k (.node lTree nk' lo' w' rTree) remXs := rfl

private lemma buildIvTreeFastCPS_sound (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ) :
    ∀ (fuel n : ℕ) (xs : IvList),
      (∀ t ∈ ivToList xs, ActiveIvValid uFn iwRow t) →
      ∀ (P : KeyIvTree → IvList → Prop),
        (∀ (tree : KeyIvTree) (rem : IvList),
          KeyIvTreeSound uFn iwRow tree →
          (∀ t ∈ ivToList rem, ActiveIvValid uFn iwRow t) →
          P tree rem) →
        buildIvTreeFastCPS fuel n xs P
  | 0, _, xs, hxs, _, hk => hk .empty xs trivial hxs
  | _ + 1, 0, xs, hxs, _, hk => hk .empty xs trivial hxs
  | _ + 1, _ + 1, .nil, hxs, _, hk => hk .empty .nil trivial hxs
  | fuel + 1, n + 1, .cons nk lo w rest, hxs, P, hk => by
    rw [buildIvTreeFastCPS_succ_succ_cons]
    by_cases h1 : Nat.beq (n + 1) 1 = true
    · simp only [h1, ↓reduceIte]
      exact hk _ rest ⟨hxs (nk, lo, w) List.mem_cons_self, trivial, trivial⟩
        fun t ht ↦ hxs t (List.mem_cons_of_mem _ ht)
    · simp only [h1, Bool.false_eq_true, ↓reduceIte, strictNat_eq]
      refine buildIvTreeFastCPS_sound uFn iwRow fuel (Nat.div (n + 1) 2)
        (.cons nk lo w rest) hxs _ fun lT mid hlT hmid ↦ ?_
      cases mid with
      | nil => exact hk lT .nil hlT hmid
      | cons nk' lo' w' rightXs =>
        refine buildIvTreeFastCPS_sound uFn iwRow fuel
          (Nat.sub (Nat.sub (n + 1) 1) (Nat.div (n + 1) 2)) rightXs
          (fun t ht ↦ hmid t (List.mem_cons_of_mem _ ht)) _ fun rT remXs hrT hrem ↦ ?_
        exact hk (.node lT nk' lo' w' rT) remXs
          ⟨hmid (nk', lo', w') List.mem_cons_self, hlT, hrT⟩ hrem

private lemma buildIvTreeFastCPS_comp {α β : Type} (f : α → β) :
    ∀ (fuel n : ℕ) (xs : IvList) (k : KeyIvTree → IvList → α),
      buildIvTreeFastCPS fuel n xs (fun a b ↦ f (k a b)) =
        f (buildIvTreeFastCPS fuel n xs k)
  | 0, _, _, _ => rfl
  | _ + 1, 0, _, _ => rfl
  | _ + 1, _ + 1, .nil, _ => rfl
  | fuel + 1, n + 1, .cons nk lo w rest, k => by
    rw [buildIvTreeFastCPS_succ_succ_cons, buildIvTreeFastCPS_succ_succ_cons]
    by_cases h1 : Nat.beq (n + 1) 1 = true
    · simp only [h1, ↓reduceIte]
    · simp only [h1, Bool.false_eq_true, ↓reduceIte, strictNat_eq]
      rw [← buildIvTreeFastCPS_comp f fuel]
      refine cps2_congr _ fun lT mid ↦ ?_
      cases mid with
      | nil => rfl
      | cons nk' lo' w' rightXs =>
        exact buildIvTreeFastCPS_comp f fuel _ rightXs _

private lemma lookupKeyIv_sound {uFn : ℕ → Fin 58 → ℝ} {iwRow : List ℕ} :
    ∀ {tree : KeyIvTree}, KeyIvTreeSound uFn iwRow tree →
      ∀ (qk : ℕ) (P : Bool → ℕ → ℕ → Prop),
        (∀ (ok : Bool) (lo w : ℕ),
          (ok = true → ActiveIvValid uFn iwRow (qk, lo, w)) → P ok lo w) →
        lookupKeyIv tree qk P
  | .empty, _, _, _, hk => hk false 0 0 fun h ↦ absurd h Bool.false_ne_true
  | .node l nk lo w rt, ⟨hiv, hl, hrt⟩, qk, P, hk => by
    unfold lookupKeyIv
    by_cases heq : Nat.beq qk nk = true
    · rw [ite_eq_left heq]
      have hqn : qk = nk := Nat.beq_eq.mp heq
      subst hqn
      exact hk true lo w fun _ ↦ hiv
    · rw [ite_eq_right heq]
      split_ifs
      · exact lookupKeyIv_sound hl qk P hk
      · exact lookupKeyIv_sound hrt qk P hk

private lemma lookupKeyIv_comp {α β : Type} (f : α → β) :
    ∀ (tree : KeyIvTree) (qk : ℕ) (k : Bool → ℕ → ℕ → α),
      lookupKeyIv tree qk (fun a b c ↦ f (k a b c)) = f (lookupKeyIv tree qk k)
  | .empty, _, _ => rfl
  | .node l nk _ _ rt, qk, k => by
    unfold lookupKeyIv
    split_ifs
    · rfl
    · exact lookupKeyIv_comp f l qk k
    · exact lookupKeyIv_comp f rt qk k

/-! ### `linRefDeltaGo`, `evalTermCPS`, `evalMQuadsGo`, and `modesLoopGo` -/

private def sextetOccCountNat (p : ℕ) : ℕ :=
  (if p < 33 then 1 else 0) + (if p < 30 then 1 else 0)

private lemma sum_sextetOccCountNat_58 :
    (∑ p ∈ Finset.range 58, sextetOccCountNat p) = 63 := by decide

private lemma linRefDeltaGo_sound (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ) :
    ∀ (rem p : ℕ) (wts dPs dNs : List ℕ) (mIvs : PairList),
      p + rem ≤ 58 →
      wts.length = rem → dPs.length = rem → dNs.length = rem →
      List.Forall₂ (DiagMValid uFn iwRow) (pairToList mIvs)
        ((List.range rem).map (p + ·)) →
      ∀ (sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 : ℕ)
        (sdpR refR refOffR deltaR : ℝ),
        (sdpLo : ℝ) - (sdpOff10 : ℝ) * 100000 ≤ sdpR * 10000 →
        sdpR * 10000 ≤ (sdpLo : ℝ) + (sdpW : ℝ) - (sdpOff10 : ℝ) * 100000 →
        (refLo : ℝ) - refOffR ≤ refR * 100000 →
        refR * 100000 ≤ (refLo : ℝ) + (refW : ℝ) - refOffR →
        (pos_3 : ℝ) - (neg2 : ℝ) ≤ deltaR * 100000 →
        deltaR * 100000 ≤ (pos_3 : ℝ) - (neg2 : ℝ) + (rad2 : ℝ) →
        ∀ (P : Bool → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Prop),
          (∀ (ok : Bool) (sdpLo' sdpW' sdpOff10' refLo' refW' pos_3' neg2' rad2' : ℕ),
            (ok = true →
              let sdpTot := sdpR + ∑ i ∈ Finset.range rem,
                (wts.getD i 0 : ℝ) * diagModeLists uFn iwRow (p + i)
              let refTot := refR + ∑ i ∈ Finset.range rem,
                (sextetOccCountNat (p + i) : ℝ) * diagModeLists uFn iwRow (p + i)
              let refOffTot := refOffR + ∑ i ∈ Finset.range rem,
                (sextetOccCountNat (p + i) : ℝ) * 50000000000
              let deltaTot := deltaR + ∑ i ∈ Finset.range rem,
                ((dPs.getD i 0 : ℝ) - (dNs.getD i 0 : ℝ)) *
                  diagModeLists uFn iwRow (p + i)
              (sdpLo' : ℝ) - (sdpOff10' : ℝ) * 100000 ≤ sdpTot * 10000 ∧
              sdpTot * 10000 ≤ (sdpLo' : ℝ) + (sdpW' : ℝ) - (sdpOff10' : ℝ) * 100000 ∧
              (refLo' : ℝ) - refOffTot ≤ refTot * 100000 ∧
              refTot * 100000 ≤ (refLo' : ℝ) + (refW' : ℝ) - refOffTot ∧
              (pos_3' : ℝ) - (neg2' : ℝ) ≤ deltaTot * 100000 ∧
              deltaTot * 100000 ≤ (pos_3' : ℝ) - (neg2' : ℝ) + (rad2' : ℝ)) →
            P ok sdpLo' sdpW' sdpOff10' refLo' refW' pos_3' neg2' rad2') →
          linRefDeltaGo p wts dPs dNs mIvs sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 P
  | 0, p, wts, dPs, dNs, mIvs, _, hw, _, _, hm,
      sdpLo, sdpW, sdpOff10, refLo, refW, pos_3, neg2, rad2,
      sdpR, refR, refOffR, deltaR, hs1, hs2, hr1, hr2, hd1, hd2, P, hk => by
    cases wts with
    | cons _ _ => simp at hw
    | nil =>
      cases mIvs with
      | cons _ _ _ => cases hm
      | nil =>
        unfold linRefDeltaGo
        exact hk true sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 fun _ ↦ by
          dsimp only
          simp only [Finset.range_zero, Finset.sum_empty, add_zero]
          exact ⟨hs1, hs2, hr1, hr2, hd1, hd2⟩
  | rem + 1, p, wts, dPs, dNs, mIvs, hbd, hw, hdP, hdN, hm,
      sdpLo, sdpW, sdpOff10, refLo, refW, pos_3, neg2, rad2,
      sdpR, refR, refOffR, deltaR, hs1, hs2, hr1, hr2, hd1, hd2, P, hk => by
    cases wts with
    | nil => simp at hw
    | cons wt wts' =>
      cases dPs with
      | nil => simp at hdP
      | cons dP dPs' =>
        cases dNs with
        | nil => simp at hdN
        | cons dN dNs' =>
          cases mIvs with
          | nil =>
            rw [List.range_succ_eq_map, List.map_cons] at hm; cases hm
          | cons ml mw mRest =>
            rw [List.range_succ_eq_map, List.map_cons, List.map_map, add_zero] at hm
            cases hm with
            | cons hhd htl =>
              have hmap_tl : List.map ((p + ·) ∘ Nat.succ) (List.range rem) =
                  List.map (p + 1 + ·) (List.range rem) :=
                List.map_congr_left fun j _ ↦ by change p + (j + 1) = p + 1 + j; omega
              rw [hmap_tl] at htl
              obtain ⟨_, hm_lo, hm_hi⟩ := hhd
              dsimp only at hm_lo hm_hi
              unfold linRefDeltaGo
              dsimp only
              simp only [strictNat_eq, Nat.add_eq, Nat.mul_eq, Nat.sub_eq, nat_div_def]
              set ml1 := ml / 10
              set mh1 := (ml + mw + 9) / 10
              have hml_mh : ml1 ≤ mh1 :=
                Nat.div_le_div_right (by omega : ml ≤ ml + mw + 9)
              set M := diagModeLists uFn iwRow p
              have hml1_lo : (ml1 : ℝ) - 5000000000 ≤ M * 10000 := by
                have hf := nat_div_le_real (n := ml) (d := 10)
                linarith
              have hmh1_hi : M * 10000 ≤ (ml1 : ℝ) + ((mh1 - ml1 : ℕ) : ℝ) - 5000000000 := by
                rw [Nat.cast_sub hml_mh]
                have hc := real_le_nat_cdiv (n := ml + mw) (d := 10) (k := 9) (by decide)
                rw [Nat.cast_add] at hc
                linarith
              have hwt_nn : (0 : ℝ) ≤ (wt : ℝ) := Nat.cast_nonneg wt
              have hs1' : ((sdpLo + wt * ml1 : ℕ) : ℝ) -
                  ((sdpOff10 + wt * 50000 : ℕ) : ℝ) * 100000 ≤ (sdpR + (wt : ℝ) * M) * 10000 := by
                push_cast; nlinarith
              have hs2' : (sdpR + (wt : ℝ) * M) * 10000 ≤
                  ((sdpLo + wt * ml1 : ℕ) : ℝ) + ((sdpW + wt * (mh1 - ml1) : ℕ) : ℝ) -
                    ((sdpOff10 + wt * 50000 : ℕ) : ℝ) * 100000 := by
                push_cast; nlinarith
              have hocc_eq : ((if Nat.blt p 33 then 1 else 0) + (if Nat.blt p 30 then 1 else 0)) =
                  sextetOccCountNat p := by
                unfold sextetOccCountNat; simp [Nat.blt_eq]
              rw [hocc_eq]
              have hocc_nn : (0 : ℝ) ≤ (sextetOccCountNat p : ℝ) := Nat.cast_nonneg _
              have hr1' : ((refLo + sextetOccCountNat p * ml : ℕ) : ℝ) -
                  (refOffR + (sextetOccCountNat p : ℝ) * 50000000000) ≤
                  (refR + (sextetOccCountNat p : ℝ) * M) * 100000 := by
                push_cast; nlinarith
              have hr2' : (refR + (sextetOccCountNat p : ℝ) * M) * 100000 ≤
                  ((refLo + sextetOccCountNat p * ml : ℕ) : ℝ) +
                    ((refW + sextetOccCountNat p * mw : ℕ) : ℝ) -
                    (refOffR + (sextetOccCountNat p : ℝ) * 50000000000) := by
                push_cast; nlinarith
              have hdP_nn : (0 : ℝ) ≤ (dP : ℝ) := Nat.cast_nonneg dP
              have hdN_nn : (0 : ℝ) ≤ (dN : ℝ) := Nat.cast_nonneg dN
              have hd1' : ((pos_3 + (dP * ml + dN * 50000000000) : ℕ) : ℝ) -
                  ((neg2 + (dP * 50000000000 + dN * (ml + mw)) : ℕ) : ℝ) ≤
                  (deltaR + ((dP : ℝ) - (dN : ℝ)) * M) * 100000 := by
                push_cast; nlinarith
              have hd2' : (deltaR + ((dP : ℝ) - (dN : ℝ)) * M) * 100000 ≤
                  ((pos_3 + (dP * ml + dN * 50000000000) : ℕ) : ℝ) -
                    ((neg2 + (dP * 50000000000 + dN * (ml + mw)) : ℕ) : ℝ) +
                    ((rad2 + (dP + dN) * mw : ℕ) : ℝ) := by
                push_cast; nlinarith
              refine linRefDeltaGo_sound uFn iwRow rem (p + 1) wts' dPs' dNs' mRest
                (by omega) (by simp at hw; omega) (by simp at hdP; omega) (by simp at hdN; omega)
                htl _ _ _ _ _ _ _ _
                (sdpR + (wt : ℝ) * M)
                (refR + (sextetOccCountNat p : ℝ) * M)
                (refOffR + (sextetOccCountNat p : ℝ) * 50000000000)
                (deltaR + ((dP : ℝ) - (dN : ℝ)) * M)
                hs1' hs2' hr1' hr2' hd1' hd2' P
                fun ok' sL sW sO rL rW dPo dNe dRa hrec ↦
                  hk ok' sL sW sO rL rW dPo dNe dRa fun hok' ↦ ?_
              obtain ⟨g1, g2, g3, g4, g5, g6⟩ := hrec hok'
              have hsdp_eq : sdpR + (wt : ℝ) * M +
                  (∑ i ∈ Finset.range rem,
                    (wts'.getD i 0 : ℝ) * diagModeLists uFn iwRow (p + 1 + i)) =
                  sdpR + ∑ i ∈ Finset.range (rem + 1),
                    ((wt :: wts').getD i 0 : ℝ) * diagModeLists uFn iwRow (p + i) := by
                rw [Finset.sum_range_succ']
                simp only [List.getD_cons_zero, List.getD_cons_succ, add_zero]
                have hs : (∑ k ∈ Finset.range rem,
                    (wts'.getD k 0 : ℝ) * diagModeLists uFn iwRow (p + 1 + k)) =
                    ∑ k ∈ Finset.range rem,
                      (wts'.getD k 0 : ℝ) * diagModeLists uFn iwRow (p + (k + 1)) :=
                  Finset.sum_congr rfl fun k _ ↦ by
                    rw [show p + 1 + k = p + (k + 1) by omega]
                rw [hs]; dsimp [M]; ring
              have href_eq : refR + (sextetOccCountNat p : ℝ) * M +
                  (∑ i ∈ Finset.range rem,
                    (sextetOccCountNat (p + 1 + i) : ℝ) *
                      diagModeLists uFn iwRow (p + 1 + i)) =
                  refR + ∑ i ∈ Finset.range (rem + 1),
                    (sextetOccCountNat (p + i) : ℝ) * diagModeLists uFn iwRow (p + i) := by
                rw [Finset.sum_range_succ', add_zero]
                have hs : (∑ k ∈ Finset.range rem,
                    (sextetOccCountNat (p + 1 + k) : ℝ) *
                      diagModeLists uFn iwRow (p + 1 + k)) =
                    ∑ k ∈ Finset.range rem,
                      (sextetOccCountNat (p + (k + 1)) : ℝ) *
                        diagModeLists uFn iwRow (p + (k + 1)) :=
                  Finset.sum_congr rfl fun k _ ↦ by
                    rw [show p + 1 + k = p + (k + 1) by omega]
                rw [hs]; dsimp [M]; ring
              have hroff_eq : refOffR + (sextetOccCountNat p : ℝ) * 50000000000 +
                  (∑ i ∈ Finset.range rem, (sextetOccCountNat (p + 1 + i) : ℝ) * 50000000000) =
                  refOffR + ∑ i ∈ Finset.range (rem + 1),
                    (sextetOccCountNat (p + i) : ℝ) * 50000000000 := by
                rw [Finset.sum_range_succ', add_zero]
                have hs : (∑ k ∈ Finset.range rem,
                    (sextetOccCountNat (p + 1 + k) : ℝ) * 50000000000) =
                    ∑ k ∈ Finset.range rem,
                      (sextetOccCountNat (p + (k + 1)) : ℝ) * 50000000000 :=
                  Finset.sum_congr rfl fun k _ ↦ by
                    rw [show p + 1 + k = p + (k + 1) by omega]
                rw [hs]; ring
              have hdel_eq : deltaR + ((dP : ℝ) - (dN : ℝ)) * M +
                  (∑ i ∈ Finset.range rem,
                    ((dPs'.getD i 0 : ℝ) - (dNs'.getD i 0 : ℝ)) *
                      diagModeLists uFn iwRow (p + 1 + i)) =
                  deltaR + ∑ i ∈ Finset.range (rem + 1),
                    (((dP :: dPs').getD i 0 : ℝ) - ((dN :: dNs').getD i 0 : ℝ)) *
                      diagModeLists uFn iwRow (p + i) := by
                rw [Finset.sum_range_succ']
                simp only [List.getD_cons_zero, List.getD_cons_succ, add_zero]
                have hs : (∑ k ∈ Finset.range rem,
                    ((dPs'.getD k 0 : ℝ) - (dNs'.getD k 0 : ℝ)) *
                      diagModeLists uFn iwRow (p + 1 + k)) =
                    ∑ k ∈ Finset.range rem,
                      ((dPs'.getD k 0 : ℝ) - (dNs'.getD k 0 : ℝ)) *
                        diagModeLists uFn iwRow (p + (k + 1)) :=
                  Finset.sum_congr rfl fun k _ ↦ by
                    rw [show p + 1 + k = p + (k + 1) by omega]
                rw [hs]; dsimp [M]; ring
              dsimp only at g1 g2 g3 g4 g5 g6 ⊢
              rw [hsdp_eq] at g1 g2
              rw [href_eq, hroff_eq] at g3 g4
              rw [hdel_eq] at g5 g6
              exact ⟨g1, g2, g3, g4, g5, g6⟩

private lemma linRefDeltaGo_comp {α β : Type} (f : α → β) :
    ∀ (p : ℕ) (wts dPs dNs : List ℕ) (mIvs : PairList)
      (sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 : ℕ)
      (k : Bool → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → α),
      linRefDeltaGo p wts dPs dNs mIvs sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2
        (fun a1 a2 a3 a4 a5 a6 a7 a8 a9 ↦ f (k a1 a2 a3 a4 a5 a6 a7 a8 a9)) =
      f (linRefDeltaGo p wts dPs dNs mIvs sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 k)
  | _, [], _, _, .nil, _, _, _, _, _, _, _, _, _ => rfl
  | _, [], _, _, .cons _ _ _, _, _, _, _, _, _, _, _, _ => rfl
  | _, _ :: _, [], _, _, _, _, _, _, _, _, _, _, _ => rfl
  | _, _ :: _, _ :: _, [], _, _, _, _, _, _, _, _, _, _ => rfl
  | _, _ :: _, _ :: _, _ :: _, .nil, _, _, _, _, _, _, _, _, _ => rfl
  | p, _ :: wts, _ :: dPs, _ :: dNs, .cons _ _ mRest,
      _, _, _, _, _, _, _, _, k => by
    unfold linRefDeltaGo
    dsimp only
    simp only [strictNat_eq]
    exact linRefDeltaGo_comp f _ wts dPs dNs mRest _ _ _ _ _ _ _ _ k

private lemma evalTermCPS_any (refLo refW pos_3 neg2 rad2 : ℕ)
    (P : Bool → ℕ → ℕ → Prop) (hk : ∀ (ok : Bool) (p_3 n_3 : ℕ), P ok p_3 n_3) :
    evalTermCPS refLo refW pos_3 neg2 rad2 P := by
  unfold evalTermCPS; dsimp only; simp only [strictNat_eq]
  split_ifs
  · exact hk _ _ _
  · exact normPN_sound _ _ _ fun _ _ _ ↦ hk _ _ _
  · exact hk _ _ _

private lemma evalTermCPS_sound {refLo refW pos_3 neg2 rad2 : ℕ} {S0 deltaM : ℝ}
    (hS0_lo : (refLo : ℝ) - 3150000000000 ≤ S0 * 100000)
    (hS0_hi : S0 * 100000 ≤ (refLo : ℝ) + (refW : ℝ) - 3150000000000)
    (hD_lo : (pos_3 : ℝ) - (neg2 : ℝ) ≤ deltaM * 100000)
    (hD_hi : deltaM * 100000 ≤ (pos_3 : ℝ) - (neg2 : ℝ) + (rad2 : ℝ))
    (P : Bool → ℕ → ℕ → Prop)
    (hk : ∀ (ok : Bool) (p_3 n_3 : ℕ),
      (ok = true → ((deepNormSq : ℝ) * S0 ^ 2 + 2 * S0 * deltaM) / 10 ≤ (p_3 : ℝ) - (n_3 : ℝ)) →
      P ok p_3 n_3) :
    evalTermCPS refLo refW pos_3 neg2 rad2 P := by
  unfold evalTermCPS
  refine strictNat_bind fun amax0 hamax0 ↦ ?_
  refine strictNat_bind fun amax100 hamax100 ↦ ?_
  refine strictNat_bind fun sq0U10 hsq0U10 ↦ ?_
  refine strictNat_bind fun sSq0U10 hsSq0U10 ↦ ?_
  refine strictNat_bind fun bdp hbdp ↦ ?_
  by_cases hguard : (Nat.ble 3050000000000 refLo && Nat.ble neg2 bdp) = true
  · rw [ite_eq_left hguard]
    have hbleS : Nat.ble 3050000000000 refLo = true := (Bool.and_eq_true_iff.mp hguard).1
    have hbleD : Nat.ble neg2 bdp = true := (Bool.and_eq_true_iff.mp hguard).2
    have href_le : 3050000000000 ≤ refLo := Nat.le_of_ble_eq_true hbleS
    have hbdp_le : neg2 ≤ bdp := Nat.le_of_ble_eq_true hbleD
    refine strictNat_bind fun s0Lo hs0Lo ↦ ?_
    refine strictNat_bind fun s0Hi hs0Hi ↦ ?_
    refine strictNat_bind fun s0W hs0W ↦ ?_
    refine strictNat_bind fun dlLo hdlLo ↦ ?_
    refine strictNat_bind fun dlHi hdlHi ↦ ?_
    refine strictNat_bind fun dlW hdlW ↦ ?_
    refine strictNat_bind fun cS hcS ↦ ?_
    refine strictNat_bind fun cD hcD ↦ ?_
    refine strictNat_bind fun mS hmS ↦ ?_
    refine strictNat_bind fun mD hmD ↦ ?_
    refine strictNat_bind fun radSD hradSD ↦ ?_
    refine strictNat_bind fun pSD hpSD ↦ ?_
    refine strictNat_bind fun nSD hnSD ↦ ?_
    simp only [Nat.add_eq, Nat.mul_eq, nat_div_def] at hamax0 hamax100 hsq0U10 hsSq0U10
    simp only [Nat.add_eq, Nat.sub_eq, nat_div_def] at hbdp hs0Lo hs0Hi hs0W hdlLo hdlHi
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq] at hdlW hcS hcD hmS hmD hradSD
    simp only [Nat.add_eq, Nat.mul_eq] at hpSD hnSD
    have habs0 : |S0 * 100000| ≤ (amax0 : ℝ) := by
      have hm1 : (absDiffNat refLo 3150000000000 : ℝ) ≤ (amax0 : ℝ) := by
        rw [hamax0]; exact_mod_cast le_maxNat_left _ _
      have hm2 : (absDiffNat (refLo + refW) 3150000000000 : ℝ) ≤ (amax0 : ℝ) := by
        rw [hamax0]; exact_mod_cast le_maxNat_right _ _
      rw [absDiffNat_cast] at hm1 hm2
      rw [Nat.cast_add] at hm2
      simp only [Nat.cast_ofNat] at hm1 hm2
      have h1b : -|(refLo : ℝ) - 3150000000000| ≤ (refLo : ℝ) - 3150000000000 :=
        neg_abs_le ((refLo : ℝ) - 3150000000000)
      have h2a : (refLo : ℝ) + (refW : ℝ) - 3150000000000 ≤
          |(refLo : ℝ) + (refW : ℝ) - 3150000000000| :=
        le_abs_self ((refLo : ℝ) + (refW : ℝ) - 3150000000000)
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    have habs100 : |S0 * 100| ≤ (amax100 : ℝ) := by
      have hc : (amax0 : ℝ) ≤ (amax100 : ℝ) * 1000 := by
        rw [hamax100]
        exact real_le_nat_cdiv (n := amax0) (d := 1000) (k := 999) (by decide)
      have heq : |S0 * 100000| = |S0 * 100| * 1000 := by
        rw [show S0 * 100000 = (S0 * 100) * 1000 by ring, abs_mul,
          abs_of_pos (show (0 : ℝ) < 1000 by norm_num)]
      linarith
    have hsq100 : (S0 * 100) ^ 2 ≤ ((amax100 * amax100 : ℕ) : ℝ) := by
      rw [← sq_abs (S0 * 100), Nat.cast_mul, ← sq]
      exact pow_le_pow_left₀ (abs_nonneg _) habs100 2
    have hsq0 : S0 ^ 2 / 10 ≤ (sq0U10 : ℝ) := by
      have hc : ((amax100 * amax100 : ℕ) : ℝ) ≤ (sq0U10 : ℝ) * 100000 := by
        rw [hsq0U10]
        exact real_le_nat_cdiv (n := amax100 * amax100) (d := 100000) (k := 99999) (by decide)
      have hsq_eq : (S0 * 100) ^ 2 = S0 ^ 2 * 10000 := by ring
      linarith
    have hsSq0 : (deepNormSq : ℝ) * S0 ^ 2 / 10 ≤ (sSq0U10 : ℝ) := by
      rw [hsSq0U10, Nat.cast_mul]
      have hnn : (0 : ℝ) ≤ (deepNormSq : ℝ) := Nat.cast_nonneg _
      have hm := mul_le_mul_of_nonneg_left hsq0 hnn
      linarith
    have hs0_le : s0Lo ≤ s0Hi := by
      rw [hs0Lo, hs0Hi]
      exact Nat.div_le_div_right
        (by omega : refLo - 3050000000000 ≤ refLo + refW - 3050000000000 + 999)
    have hdl_le : dlLo ≤ dlHi := by
      rw [hdlLo, hdlHi]
      exact Nat.div_le_div_right (by omega : bdp - neg2 ≤ bdp + rad2 - neg2 + 99999)
    have hs0_iv_lo : (s0Lo : ℝ) - 100000000 ≤ S0 * 100 := by
      have hf : (s0Lo : ℝ) * 1000 ≤ ((refLo - 3050000000000 : ℕ) : ℝ) := by
        rw [hs0Lo]
        exact nat_div_le_real (n := refLo - 3050000000000) (d := 1000)
      rw [Nat.cast_sub href_le] at hf
      simp only [Nat.cast_ofNat] at hf
      linarith
    have hs0_iv_hi : S0 * 100 ≤ (s0Lo : ℝ) + (s0W : ℝ) - 100000000 := by
      rw [hs0W, Nat.cast_sub hs0_le]
      have hc : ((refLo + refW - 3050000000000 : ℕ) : ℝ) ≤ (s0Hi : ℝ) * 1000 := by
        rw [hs0Hi]
        exact real_le_nat_cdiv (n := refLo + refW - 3050000000000) (d := 1000) (k := 999)
          (by decide)
      have hsub : ((refLo + refW - 3050000000000 : ℕ) : ℝ) =
          (refLo : ℝ) + (refW : ℝ) - 3050000000000 := by
        rw [Nat.cast_sub (by omega : 3050000000000 ≤ refLo + refW), Nat.cast_add]
        norm_num
      rw [hsub] at hc
      linarith
    have hdl_iv_lo : (dlLo : ℝ) - 2000000000 ≤ deltaM := by
      have hf : (dlLo : ℝ) * 100000 ≤ ((bdp - neg2 : ℕ) : ℝ) := by
        rw [hdlLo]
        exact nat_div_le_real (n := bdp - neg2) (d := 100000)
      rw [Nat.cast_sub hbdp_le, hbdp] at hf
      simp only [Nat.cast_add, Nat.cast_ofNat] at hf
      linarith
    have hdl_iv_hi : deltaM ≤ (dlLo : ℝ) + (dlW : ℝ) - 2000000000 := by
      rw [hdlW, Nat.cast_sub hdl_le]
      have hc : ((bdp + rad2 - neg2 : ℕ) : ℝ) ≤ (dlHi : ℝ) * 100000 := by
        rw [hdlHi]
        exact real_le_nat_cdiv (n := bdp + rad2 - neg2) (d := 100000) (k := 99999) (by decide)
      have hsub : ((bdp + rad2 - neg2 : ℕ) : ℝ) =
          200000000000000 + (pos_3 : ℝ) + (rad2 : ℝ) - (neg2 : ℝ) := by
        rw [Nat.cast_sub (by omega : neg2 ≤ bdp + rad2), hbdp]
        push_cast; ring
      rw [hsub] at hc
      linarith
    obtain ⟨_, hprod_hi⟩ := centered_prod_rad_bound (X := S0 * 100) (Y := deltaM)
      (c1 := cS) (zz1 := 200000000) (w1 := s0W) (c2 := cD) (zz2 := 4000000000) (w2 := dlW)
      (by rw [hcS]; push_cast; linarith)
      (by rw [hcS]; push_cast; linarith)
      (by rw [hcD]; push_cast; linarith)
      (by rw [hcD]; push_cast; linarith)
    have hpSD_diff : (pSD : ℝ) - (nSD : ℝ) =
        ((cS : ℝ) * (cD : ℝ) + 200000000 * 4000000000) -
          (4000000000 * (cS : ℝ) + 200000000 * (cD : ℝ)) +
          ((s0W : ℝ) * (absDiffNat cD 4000000000 : ℝ) +
            (absDiffNat cS 200000000 : ℝ) * (dlW : ℝ) + (s0W : ℝ) * (dlW : ℝ)) := by
      rw [hpSD, hnSD, hradSD, hmS, hmD]
      push_cast; ring
    have hsd_eq : 4 * ((S0 * 100) * deltaM) = 400 * (S0 * deltaM) := by ring
    have hgoal_eq : ((deepNormSq : ℝ) * S0 ^ 2 + 2 * S0 * deltaM) / 10 =
        (deepNormSq : ℝ) * S0 ^ 2 / 10 + (S0 * deltaM) / 5 := by ring
    push_cast at hprod_hi
    by_cases hpn : Nat.ble nSD pSD = true
    · rw [ite_eq_left hpn]
      refine strictNat_bind fun crossP hcrossP ↦ ?_
      refine strictNat_bind fun totP htotP ↦ ?_
      have hpn_le : nSD ≤ pSD := Nat.le_of_ble_eq_true hpn
      have hc : ((pSD - nSD : ℕ) : ℝ) ≤ (crossP : ℝ) * 2000 := by
        rw [hcrossP]
        simp only [Nat.add_eq, Nat.sub_eq, nat_div_def]
        exact real_le_nat_cdiv (n := pSD - nSD) (d := 2000) (k := 1999) (by decide)
      rw [Nat.cast_sub hpn_le] at hc
      refine hk true totP 0 fun _ ↦ ?_
      rw [htotP, Nat.add_eq, Nat.cast_add, Nat.cast_zero, sub_zero, hgoal_eq]
      linarith
    · rw [ite_eq_right hpn]
      refine strictNat_bind fun crossN hcrossN ↦ ?_
      have hnp_le : pSD ≤ nSD := by
        have : ¬(nSD ≤ pSD) := fun h ↦ hpn (Nat.ble_eq_true_of_le h); omega
      have hf : (crossN : ℝ) * 2000 ≤ ((nSD - pSD : ℕ) : ℝ) := by
        rw [hcrossN]
        simp only [Nat.sub_eq, nat_div_def]
        exact nat_div_le_real (n := nSD - pSD) (d := 2000)
      rw [Nat.cast_sub hnp_le] at hf
      refine normPN_sound sSq0U10 crossN (P true) fun p_3 n_3 heq ↦ hk true p_3 n_3 fun _ ↦ ?_
      rw [hgoal_eq]
      linarith
  · rw [ite_eq_right hguard]
    exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true

private lemma evalTermCPS_comp {α β : Type} (f : α → β)
    (refLo refW pos_3 neg2 rad2 : ℕ) (k : Bool → ℕ → ℕ → α) :
    evalTermCPS refLo refW pos_3 neg2 rad2 (fun a b c ↦ f (k a b c)) =
      f (evalTermCPS refLo refW pos_3 neg2 rad2 k) := by
  unfold evalTermCPS; dsimp only; simp only [strictNat_eq]
  split_ifs
  · rfl
  · exact normPN_comp f _ _ (k true)
  · rfl

private lemma lookupKeyIv_any :
    ∀ (tree : KeyIvTree) (qk : ℕ) (P : Bool → ℕ → ℕ → Prop),
      (∀ (ok : Bool) (lo w : ℕ), P ok lo w) → lookupKeyIv tree qk P
  | .empty, _, _, hk => hk false 0 0
  | .node l nk _ _ rt, qk, P, hk => by
    unfold lookupKeyIv
    split_ifs
    · exact hk _ _ _
    · exact lookupKeyIv_any l qk P hk
    · exact lookupKeyIv_any rt qk P hk

private lemma evalMQuadsGo_any (m2Tree : KeyIvTree) :
    ∀ (qs : QuadList) (rawP rawN : ℕ) (P : Bool → ℕ → ℕ → Prop),
      (∀ (ok : Bool) (mqP mqN : ℕ), P ok mqP mqN) →
      evalMQuadsGo m2Tree qs rawP rawN P
  | .nil, rawP, rawN, P, hk => by
