          (List.zipWith Nat.add dw0NCert dw1NCert) quads
          (bvRow fragmentWeights ⟨min r.val 8, by omega⟩)
          nModes cStart blkIw 0 0 fun okM mdP mdN ↦
            okM && Nat.beq mdP expP && Nat.beq mdN expN
