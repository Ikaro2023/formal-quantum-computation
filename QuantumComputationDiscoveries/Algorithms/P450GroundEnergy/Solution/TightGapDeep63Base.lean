/-- Internal CIPSI certificate helper `strictBool`. -/
def strictBool {α : Type} (b : Bool) (k : Bool → α) : α :=
  Bool.casesOn b (k false) (k true)

/-- Internal CIPSI certificate helper `maxNat`. -/
def maxNat (a b : ℕ) : ℕ := if Nat.ble a b then b else a
/-- Internal CIPSI certificate helper `minNat`. -/
def minNat (a b : ℕ) : ℕ := if Nat.ble a b then a else b
/-- Internal CIPSI certificate helper `absDiffNat`. -/
def absDiffNat (a b : ℕ) : ℕ := if Nat.ble a b then Nat.sub b a else Nat.sub a b
/-- Internal CIPSI certificate helper `beqBool`. -/
def beqBool (a b : Bool) : Bool := if a then b else !b

/-- Internal CIPSI certificate helper `memNat`. -/
def memNat (w : ℕ) : List ℕ → Bool
  | [] => false
  | x :: xs => if Nat.beq w x then true else memNat w xs

/-- Internal CIPSI certificate helper `beqNatList`. -/
def beqNatList : List ℕ → List ℕ → Bool
  | [], [] => true
  | x :: xs, y :: ys => if Nat.beq x y then beqNatList xs ys else false
  | _, _ => false

/-- Internal CIPSI certificate helper `DetList`. -/
inductive DetList : Type
  /-- Constructor `nil` of `DetList`. -/
  | nil : DetList
  /-- Constructor `cons` of `DetList`. -/
  | cons : Bool → ℕ → List ℕ → DetList → DetList

/-- Internal CIPSI certificate helper `appendDetList`. -/
def appendDetList : DetList → DetList → DetList
  | .nil, ys => ys
  | .cons neg w fl xs, ys => .cons neg w fl (appendDetList xs ys)

/-- Internal CIPSI certificate helper `strictDetList`. -/
def strictDetList {α : Type} : DetList → (DetList → α) → α
  | .nil, k => k .nil
  | .cons neg w fl rest, k =>
    strictBool neg fun neg' ↦ strictNat w fun w' ↦ strictNatList fl fun fl' ↦
    strictDetList rest fun rest' ↦ k (.cons neg' w' fl' rest')

/-- Internal CIPSI certificate helper `QuadList`. -/
inductive QuadList : Type
  /-- Constructor `nil` of `QuadList`. -/
  | nil : QuadList
  /-- Constructor `cons` of `QuadList`. -/
  | cons : ℕ → ℕ → ℕ → ℕ → QuadList → QuadList

/-- Internal CIPSI certificate helper `appendQuadList`. -/
def appendQuadList : QuadList → QuadList → QuadList
  | .nil, ys => ys
  | .cons k1 k2 p m xs, ys => .cons k1 k2 p m (appendQuadList xs ys)

/-- Internal CIPSI certificate helper `revQuadListCPS`. -/
def revQuadListCPS {α : Type} : QuadList → QuadList → (QuadList → α) → α
  | .nil, acc, k => k acc
  | .cons k1 k2 p m rest, acc, k =>
    strictNat k1 fun k1' ↦ strictNat k2 fun k2' ↦
    strictNat p fun p' ↦ strictNat m fun m' ↦
      revQuadListCPS rest (.cons k1' k2' p' m' acc) k

/-- Internal CIPSI certificate helper `forceQuadListCPS`. -/
def forceQuadListCPS {α : Type} (qs : QuadList) (k : QuadList → α) : α :=
  revQuadListCPS qs .nil fun rev ↦ revQuadListCPS rev .nil k

/-- Internal CIPSI certificate helper `beqQuadList`. -/
def beqQuadList : QuadList → QuadList → Bool
  | .nil, .nil => true
  | .cons a1 b1 p1 m1 xs, .cons a2 b2 p2 m2 ys =>
    if Nat.beq a1 a2 && Nat.beq b1 b2 && Nat.beq p1 p2 && Nat.beq m1 m2 then
      beqQuadList xs ys
    else false
  | _, _ => false

/-- Internal CIPSI certificate helper `QuadAccTree`. -/
inductive QuadAccTree : Type
  /-- Constructor `empty` of `QuadAccTree`. -/
  | empty : QuadAccTree
  /-- Constructor `node` of `QuadAccTree`. -/
  | node : QuadAccTree → ℕ → ℕ → ℕ → QuadAccTree → QuadAccTree

/-- Internal CIPSI certificate helper `buildZeroQuadTreeCPS`. -/
def buildZeroQuadTreeCPS {α : Type} :
    ℕ → ℕ → List ℕ → (QuadAccTree → List ℕ → α) → α
  | 0, _, xs, k => k .empty xs
  | _ + 1, 0, xs, k => k .empty xs
  | _ + 1, _, [], k => k .empty []
  | fuel + 1, n, xs, k =>
    if Nat.beq n 1 then
      match xs with
      | [] => k .empty []
      | qk :: rest => strictNat qk fun qk' ↦ k (.node .empty qk' 0 0 .empty) rest
    else
      strictNat (Nat.div n 2) fun half ↦
      strictNat (Nat.sub (Nat.sub n 1) half) fun rLen ↦
      buildZeroQuadTreeCPS fuel half xs fun lTree midAndRight ↦
      match midAndRight with
      | [] => k lTree []
      | qk :: rightXs =>
        strictNat qk fun qk' ↦
        buildZeroQuadTreeCPS fuel rLen rightXs fun rTree remXs ↦
          k (.node lTree qk' 0 0 rTree) remXs

/-- Internal CIPSI certificate helper `addQuadTreeCPS`. -/
def addQuadTreeCPS {α : Type} (qk cP cN : ℕ) :
    QuadAccTree → (Bool → QuadAccTree → α) → α
  | .empty, k => k false .empty
  | .node l nk p m r, k =>
    if Nat.beq qk nk then
      strictNat (Nat.add p cP) fun p' ↦
      strictNat (Nat.add m cN) fun m' ↦
        k true (.node l nk p' m' r)
    else if Nat.blt qk nk then
      addQuadTreeCPS qk cP cN l fun ok l' ↦
        if ok then k true (.node l' nk p m r) else k false .empty
    else
      addQuadTreeCPS qk cP cN r fun ok r' ↦
        if ok then k true (.node l nk p m r') else k false .empty

/-- Internal CIPSI certificate helper `pushQuadTreeCPS`. -/
def pushQuadTreeCPS {α : Type} (k1 k2 cP cN : ℕ) (tree : QuadAccTree)
    (k : Bool → QuadAccTree → α) : α :=
  strictNat (if Nat.ble k1 k2 then Nat.add (Nat.mul 4096 k1) k2
             else Nat.add (Nat.mul 4096 k2) k1) fun qk ↦
  strictNat cP fun cp' ↦ strictNat cN fun cn' ↦
    addQuadTreeCPS qk cp' cn' tree k

/-- Internal CIPSI certificate helper `emitNonzeroQuadCPS`. -/
def emitNonzeroQuadCPS {α : Type} (qk p m : ℕ) (acc : QuadList) (k : QuadList → α) : α :=
  if Nat.beq p m then k acc
  else
    strictNat (Nat.div qk 4096) fun k1 ↦
    strictNat (Nat.mod qk 4096) fun k2 ↦
    if Nat.blt m p then
      strictNat (Nat.sub p m) fun d ↦ k (.cons k1 k2 d 0 acc)
    else
      strictNat (Nat.sub m p) fun d ↦ k (.cons k1 k2 0 d acc)

/-- Internal CIPSI certificate helper `flattenQuadTreeCPS`. -/
def flattenQuadTreeCPS {α : Type} : QuadAccTree → QuadList → (QuadList → α) → α
  | .empty, acc, k => k acc
  | .node l qk p m r, acc, k =>
    flattenQuadTreeCPS r acc fun acc1 ↦
    emitNonzeroQuadCPS qk p m acc1 fun acc2 ↦
      flattenQuadTreeCPS l acc2 k

