    [forceList_eq, getRotBlkChunk_eq r, Nat.mul_eq] at hcert
  have hdP_len : (List.zipWith Nat.add dw0PCert dw1PCert).length = 58 := by
    simp only [List.length_zipWith, dw0PCert_length, dw1PCert_length, Nat.min_self]
  have hdN_len : (List.zipWith Nat.add dw0NCert dw1NCert).length = 58 := by
    simp only [List.length_zipWith, dw0NCert_length, dw1NCert_length, Nat.min_self]
  set blkLeaves := (rotBlkLeavesCert.drop (29 * r.val)).take 29
  set fwRow := bvRow fragmentWeights ⟨min r.val 8, by omega⟩
  set blkIwFull := bvSlice innerWeights (14 * r.val) 14
  set blkIw := (blkIwFull.drop cStart).take nModes
  have hlen_blk : blkLeaves.length = 29 := by
    simp only [blkLeaves, List.length_take, List.length_drop, rotBlkLeavesCert_length]; omega
  refine block_modes_slice_of_tables activeKeysCert wTotCert
    (List.zipWith Nat.add dw0PCert dw1PCert)
    (List.zipWith Nat.add dw0NCert dw1NCert)
