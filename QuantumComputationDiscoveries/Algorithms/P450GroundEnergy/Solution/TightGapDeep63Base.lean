      refine cps2_congr _ fun m2Tree _ ↦ ?_
      rw [← linRefDeltaGo_comp f]
      refine cps9_congr _ fun ok1 sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 ↦ ?_
      rw [← evalTermCPS_comp f]
      refine cps3_congr _ fun ok2 p_3 n_3 ↦ ?_
      rw [← evalMQuadsGo_comp f]
      refine cps3_congr _ fun ok3 mqP mqN ↦ ?_
      split_ifs
      · rw [← accSignedIv_comp f]
        refine cps2_congr _ fun modeP modeN ↦ ?_
        rw [← normPN_comp f]
        refine cps2_congr _ fun frP' frN' ↦ ?_
        exact modesLoopGo_comp f diagGs activeGs wTot dTotP dTotN quads fwRow
          rem _ _ frP' frN' k
      · rfl

private lemma list_zipWith_add_getD :
    ∀ (xs ys : List ℕ), xs.length = ys.length →
      ∀ i : ℕ, (List.zipWith Nat.add xs ys).getD i 0 = xs.getD i 0 + ys.getD i 0
  | [], [], _, _ => by simp
  | _ :: _, [], h, _ => by simp at h
  | [], _ :: _, h, _ => by simp at h
  | _ :: _, _ :: _, _, 0 => by simp [Nat.add_eq]
  | _ :: xs, _ :: ys, h, i + 1 => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h
    simpa [List.zipWith_cons_cons] using list_zipWith_add_getD xs ys h i

private lemma evalQuadLists_eq_evalQuadList (r : Fin 9) (c : Fin 14)
    (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    (hkm : ∀ qk : ℕ, keyModeLists uFn iwRow qk = keyModeReal r c qk) :
    ∀ qs : QuadList, evalQuadLists uFn iwRow qs = evalQuadList r c qs
  | .nil => rfl
  | .cons k1 k2 p m rest => by
    simp only [evalQuadLists, evalQuadList, hkm k1, hkm k2,
      evalQuadLists_eq_evalQuadList r c uFn iwRow hkm rest]


private lemma someIvStrict_eq (lo w : ℕ) : someIvStrict lo w = .some lo w := by
  cases lo <;> cases w <;> rfl

private lemma evalOneModeKeyOpt_cases_aux (lo5 hi5 : ℕ) :
    Nat.casesOn lo5
      (Nat.casesOn hi5 (OptIv.some 0 0) (fun mh ↦ OptIv.some 0 (Nat.add mh 1)))
      (fun ml ↦
        let lo' := Nat.add ml 1
        let w' := Nat.sub hi5 lo'
        Nat.casesOn w' (OptIv.some lo' 0) (fun mw ↦ OptIv.some lo' (Nat.add mw 1))) =
    OptIv.some lo5 (Nat.sub hi5 lo5) := by
  cases lo5 with
  | zero =>
    change Nat.casesOn hi5 (OptIv.some 0 0) (fun mh ↦ OptIv.some 0 (Nat.add mh 1)) =
      OptIv.some 0 hi5
    cases hi5 <;> rfl
  | succ ml =>
    exact nat_cases_id (Nat.sub hi5 (Nat.add ml 1))
      (fun w ↦ OptIv.some (Nat.add ml 1) w)

private lemma evalOneModeKeyOpt_ite_aux {α : Type} (P1 P2 : Prop) [Decidable P1] [Decidable P2]
    (lo5 hi5 : ℕ) (k : Bool → ℕ → ℕ → α) :
    (match (if P1 then
              if P2 then
                Nat.casesOn lo5
                  (Nat.casesOn hi5 (OptIv.some 0 0) (fun mh ↦ OptIv.some 0 (Nat.add mh 1)))
                  (fun ml ↦
                    let lo' := Nat.add ml 1
                    let w' := Nat.sub hi5 lo'
                    Nat.casesOn w' (OptIv.some lo' 0) (fun mw ↦ OptIv.some lo' (Nat.add mw 1)))
              else OptIv.none
            else OptIv.none) with
     | .none => k false 0 0
     | .some l w => k true l w) =
    (if P1 then if P2 then k true lo5 (Nat.sub hi5 lo5) else k false 0 0 else k false 0 0) := by
  rw [evalOneModeKeyOpt_cases_aux]
  split_ifs <;> rfl

private lemma evalOneModeKeyOpt_eq {α : Type} (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ)
    (gb : List ℕ) (sGb : ℕ) (k : Bool → ℕ → ℕ → α) :
    (match evalOneModeKeyOpt iw29 sumIw29 sumPos sumNeg gb sGb with
     | .none => k false 0 0
     | .some lo5 w5 => k true lo5 w5) =
    evalOneModeKey iw29 sumIw29 sumPos sumNeg gb sGb k := by
  unfold evalOneModeKeyOpt
  conv_rhs => unfold evalOneModeKey; simp only [strictNat_eq]
  exact evalOneModeKeyOpt_ite_aux _ _ _ _ k

private lemma buildDiagMOpt_eq {α : Type} (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ) :
    ∀ (dgs : KeyGList) (acc : PairList) (k : Bool → PairList → α),
      (match buildDiagMOpt iw29 sumIw29 sumPos sumNeg dgs acc with
       | .none => k false .nil
       | .some dm => k true dm) =
      buildDiagMIvsCPS iw29 sumIw29 sumPos sumNeg dgs acc k
  | .nil, acc, k => by simp [buildDiagMOpt, buildDiagMIvsCPS, revPairListCPS_eq]
  | .cons _ gb sGb rest, acc, k => by
    unfold buildDiagMOpt buildDiagMIvsCPS
    rw [← evalOneModeKeyOpt_eq]
    cases evalOneModeKeyOpt iw29 sumIw29 sumPos sumNeg gb sGb with
    | none => rfl
    | some lo5 w5 =>
      simp only [↓reduceIte]
      exact buildDiagMOpt_eq iw29 sumIw29 sumPos sumNeg rest (.cons lo5 w5 acc) k

private lemma buildActM2Opt_eq {α : Type} (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ) :
    ∀ (ags : KeyGList) (acc : IvList) (cnt : ℕ) (k : Bool → IvList → ℕ → α),
      (match buildActM2Opt iw29 sumIw29 sumPos sumNeg ags acc cnt with
       | .none => k false .nil 0
       | .some ivs nAct => k true ivs nAct) =
      buildActiveM2IvsCPS iw29 sumIw29 sumPos sumNeg ags acc cnt k
  | .nil, acc, cnt, k => by simp [buildActM2Opt, buildActiveM2IvsCPS, revIvListCPS_eq]
  | .cons key gb sGb rest, acc, cnt, k => by
    unfold buildActM2Opt buildActiveM2IvsCPS
    rw [← evalOneModeKeyOpt_eq]
    cases evalOneModeKeyOpt iw29 sumIw29 sumPos sumNeg gb sGb with
    | none => rfl
    | some lo5 w5 =>
      simp only [someIvStrict_eq, strictNat_eq, ↓reduceIte]
      exact buildActM2Opt_eq iw29 sumIw29 sumPos sumNeg rest _ _ k

private lemma lookupKeyIvOpt_eq {α : Type} :
    ∀ (t : KeyIvTree) (qk : ℕ) (k : Bool → ℕ → ℕ → α),
      (match lookupKeyIvOpt t qk with
       | .none => k false 0 0
       | .some lo w => k true lo w) =
      lookupKeyIv t qk k
  | .empty, _, _ => rfl
  | .node l nk lo w r, qk, k => by
    unfold lookupKeyIvOpt lookupKeyIv
    by_cases h1 : Nat.beq qk nk = true
    · simp [h1]
    · simp only [Bool.eq_false_iff.mpr h1, Bool.cond_false, Bool.false_eq_true, ↓reduceIte]
      by_cases h2 : Nat.blt qk nk = true
      · simp only [h2, Bool.cond_true, ↓reduceIte]; exact lookupKeyIvOpt_eq l qk k
      · simp only [Bool.eq_false_iff.mpr h2, Bool.cond_false, Bool.false_eq_true, ↓reduceIte]
        exact lookupKeyIvOpt_eq r qk k

private lemma evalMQuadsFast_eq {α : Type} (m2Tree : KeyIvTree) :
    ∀ (qs : QuadList) (rawP rawN : ℕ) (k : Bool → ℕ → ℕ → α),
      (match evalMQuadsFast m2Tree qs rawP rawN with
       | .none => k false 0 0
       | .some mqP mqN => k true mqP mqN) =
      evalMQuadsGo m2Tree qs rawP rawN k
  | .nil, rawP, rawN, k => by
    unfold evalMQuadsFast evalMQuadsGo normPN
    simp only [strictNat_eq, someIvStrict_eq]
    split_ifs <;> rfl
  | .cons k1 k2 cP cN rest, rawP, rawN, k => by
    unfold evalMQuadsFast evalMQuadsGo
    rw [← lookupKeyIvOpt_eq m2Tree k1]
    cases lookupKeyIvOpt m2Tree k1 with
    | none =>
      dsimp only
      rw [← lookupKeyIvOpt_eq m2Tree k2]
      cases lookupKeyIvOpt m2Tree k2 <;> rfl
    | some l1 w1 =>
      dsimp only
      rw [← lookupKeyIvOpt_eq m2Tree k2]
      cases lookupKeyIvOpt m2Tree k2 with
      | none => rfl
      | some l2 w2 =>
        dsimp only
        simp only [Bool.and_self, ↓reduceIte, strictNat_eq]
        split_ifs <;> first | exact evalMQuadsFast_eq m2Tree rest _ _ k | rfl

private lemma modesLoopFast_eq {α : Type} (diagGs activeGs : KeyGList)
    (wTot dTotP dTotN : List ℕ) (quads : QuadList) (fwRow : List ℕ) :
    ∀ (rem cIdx : ℕ) (iwRows : List (List ℕ)) (frP frN : ℕ) (k : Bool → ℕ → ℕ → α),
      modesLoopFast diagGs activeGs wTot dTotP dTotN quads fwRow rem cIdx iwRows frP frN k =
        modesLoopGo diagGs activeGs wTot dTotP dTotN quads fwRow rem cIdx iwRows frP frN k
  | 0, _, _, _, _, _ => rfl
  | rem + 1, cIdx, iwRows, frP, frN, k => by
    unfold modesLoopFast modesLoopGo
    simp only [strictNat_eq, strictNatList_eq]
    rw [← buildDiagMOpt_eq]
    cases buildDiagMOpt (getRow29Go 29 (iwRows.headD []))
        (sumList (getRow29Go 29 (iwRows.headD [])))
        (sumList ((getRow29Go 29 (iwRows.headD [])).map
          fun x ↦ if Nat.ble 16384 x then Nat.sub x 16384 else 0))
        (sumList ((getRow29Go 29 (iwRows.headD [])).map
          fun x ↦ if Nat.ble 16384 x then 0 else Nat.sub 16384 x)) diagGs .nil with
    | none =>
      dsimp only
      rw [← buildActM2Opt_eq]
      cases buildActM2Opt (getRow29Go 29 (iwRows.headD []))
          (sumList (getRow29Go 29 (iwRows.headD [])))
          (sumList ((getRow29Go 29 (iwRows.headD [])).map
            fun x ↦ if Nat.ble 16384 x then Nat.sub x 16384 else 0))
          (sumList ((getRow29Go 29 (iwRows.headD [])).map
            fun x ↦ if Nat.ble 16384 x then 0 else Nat.sub 16384 x)) activeGs .nil 0 <;> rfl
    | some diagM =>
      dsimp only
      rw [← buildActM2Opt_eq]
      cases buildActM2Opt (getRow29Go 29 (iwRows.headD []))
          (sumList (getRow29Go 29 (iwRows.headD [])))
          (sumList ((getRow29Go 29 (iwRows.headD [])).map
            fun x ↦ if Nat.ble 16384 x then Nat.sub x 16384 else 0))
          (sumList ((getRow29Go 29 (iwRows.headD [])).map
            fun x ↦ if Nat.ble 16384 x then 0 else Nat.sub 16384 x)) activeGs .nil 0 with
      | none => rfl
      | some m2Ivs nAct =>
        dsimp only
        simp only [Bool.and_self, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
        apply congrArg; funext m2Tree _
        apply congrArg; funext ok1 sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2
        apply congrArg; funext ok2 p_3 n_3
        rw [← evalMQuadsFast_eq m2Tree quads 0 0]
        cases evalMQuadsFast m2Tree quads 0 0 with
        | none =>
          dsimp only
          simp only [Bool.and_false, Bool.false_eq_true, ↓reduceIte]
        | some mqP mqN =>
          dsimp only
          simp only [Bool.and_true]
          split_ifs with h12
          · apply congrArg; funext modeP modeN
            apply congrArg; funext frP' frN'
            exact modesLoopFast_eq diagGs activeGs wTot dTotP dTotN quads fwRow
              rem _ _ frP' frN' k
          · rfl

private lemma block_mode_of_tables
    (activeKeys wTot dTotP dTotN : List ℕ)
    (hw : wTot.length = 58) (hdP : dTotP.length = 58) (hdN : dTotN.length = 58)
    (quads : QuadList) (blkLeaves : List (List ℕ)) (iwRow : List ℕ) (uFn : ℕ → Fin 58 → ℝ)
    (hlen : blkLeaves.length = 29)
    (hblk : ∀ b < 29, List.Forall₂ ValidOrb5e8 (blkLeaves.getD b []) (List.ofFn (uFn b)))
    (fwRow : List ℕ) (cIdx expP expN : ℕ) (targetReal : ℝ)
    (htarget : modeListsReal uFn wTot dTotP dTotN quads (fwRow.getD cIdx 0) iwRow = targetReal)
    (hcert : (let colTree := buildOrbColTree 6 0 58 blkLeaves
      match buildDiagGsCol colTree 58 0 .nil, buildAllGsCol colTree activeKeys .nil with
      | .some diagGs, .some activeGs =>
        modesLoopFast diagGs activeGs wTot dTotP dTotN quads fwRow
          1 cIdx [iwRow] 0 0 fun okM mdP mdN ↦
            okM && Nat.beq mdP expP && Nat.beq mdN expN
      | _, _ => false) = true) :
    targetReal ≤ 10 * ((expP : ℝ) - (expN : ℝ)) := by
  simp -iota only at hcert
  set colTree := buildOrbColTree 6 0 58 blkLeaves
  have htree : OrbColTreeSound uFn colTree :=
    buildOrbColTree_sound hlen hblk 6 0 58 (by decide)
  cases hdG : buildDiagGsCol colTree 58 0 .nil with
  | none => rw [hdG] at hcert; exact absurd hcert Bool.false_ne_true
  | some diagGs =>
    cases haG : buildAllGsCol colTree activeKeys .nil with
    | none => rw [hdG, haG] at hcert; exact absurd hcert Bool.false_ne_true
    | some activeGs =>
      rw [hdG, haG] at hcert
      dsimp only at hcert
      rw [modesLoopFast_eq] at hcert
      have hdgs : List.Forall₂ (fun e q ↦ DiagGEntryValid uFn q e)
          (keyGToList diagGs) ((List.range 58).map (0 + ·)) :=
        buildDiagGsCol_sound htree 58 0 .nil [] .nil hdG
      have hags : ∀ e ∈ keyGToList activeGs, KeyGEntryValid uFn e :=
        buildAllGsCol_sound htree activeKeys .nil (by simp only [keyGToList, List.reverse_nil,
          List.not_mem_nil, IsEmpty.forall_iff, implies_true]) haG
      let fImp : Bool → Prop := fun b ↦ b = true → targetReal ≤ 10 * ((expP : ℝ) - (expN : ℝ))
      have hml := modesLoopGo_le uFn hdgs hags hw hdP hdN quads fwRow 1 cIdx [iwRow] 0 0
        (fun okM mdP mdN ↦ fImp (okM && Nat.beq mdP expP && Nat.beq mdN expN))
        fun okM mdP mdN hle0 hk ↦ by
          obtain ⟨hab, hbN⟩ := Bool.and_eq_true_iff.mp hk
          obtain ⟨hokM, hbP⟩ := Bool.and_eq_true_iff.mp hab
          have hP := Nat.beq_eq.mp hbP
          have hN := Nat.beq_eq.mp hbN
          subst hP hN
          have hle := hle0 hokM
          simp only [Finset.sum_range_one, add_zero, List.getD_cons_zero, htarget,
            Nat.cast_zero, sub_zero, zero_add] at hle
          linarith
      rw [modesLoopGo_comp fImp] at hml
      exact hml hcert

lemma block_mode_cert_sound (hcay : checkCayleyCertTop = true)
    (hb0 : checkRotBlkLeavesCert 0 87 = true)
    (hb1 : checkRotBlkLeavesCert 87 87 = true)
    (hb2 : checkRotBlkLeavesCert 174 87 = true)
    (r : Fin 9) (c : Fin 14) (expP expN : ℕ)
    (hcert : checkBlockModeCert r.val c.val expP expN = true) :
    cipsiModeReal r c ≤ 10 * ((expP : ℝ) - (expN : ℝ)) := by
  unfold checkBlockModeCert at hcert
  simp -iota only [strictNatList_eq] at hcert
  obtain ⟨quads, hfq, hquads_eval⟩ := forceQuadListCPS_eval quadsCert fun quads ↦
    forceList (getRotBlkChunk r.val) fun blkLeaves ↦
      match buildDiagGsCol (buildOrbColTree 6 0 58 blkLeaves) 58 0 .nil,
            buildAllGsCol (buildOrbColTree 6 0 58 blkLeaves) activeKeysCert .nil with
      | .some diagGs, .some activeGs =>
        modesLoopFast diagGs activeGs wTotCert
          (List.zipWith Nat.add dw0PCert dw1PCert)
          (List.zipWith Nat.add dw0NCert dw1NCert) quads
          (bvRow fragmentWeights ⟨min r.val 8, by omega⟩)
          1 c.val [bvRow innerWeights ⟨min (Nat.add (Nat.mul 14 r.val) c.val) 125, by omega⟩]
          0 0 fun okM mdP mdN ↦
            okM && Nat.beq mdP expP && Nat.beq mdN expN
      | _, _ => false
  replace hcert := hfq.symm.trans hcert
  simp -iota only
    [forceList_eq, getRotBlkChunk_eq r, Nat.add_eq, Nat.mul_eq] at hcert
  have hdP_len : (List.zipWith Nat.add dw0PCert dw1PCert).length = 58 := by
    simp only [List.length_zipWith, dw0PCert_length, dw1PCert_length, Nat.min_self]
  have hdN_len : (List.zipWith Nat.add dw0NCert dw1NCert).length = 58 := by
    simp only [List.length_zipWith, dw0NCert_length, dw1NCert_length, Nat.min_self]
  set blkLeaves := (rotBlkLeavesCert.drop (29 * r.val)).take 29
  set fwRow := bvRow fragmentWeights ⟨min r.val 8, by omega⟩
  set iwRow := bvRow innerWeights ⟨min (14 * r.val + c.val) 125, by omega⟩
  have hlen_blk : blkLeaves.length = 29 := by
    simp only [blkLeaves, List.length_take, List.length_drop, rotBlkLeavesCert_length]; omega
  refine block_mode_of_tables activeKeysCert wTotCert
    (List.zipWith Nat.add dw0PCert dw1PCert)
    (List.zipWith Nat.add dw0NCert dw1NCert)
    wTotCert_length hdP_len hdN_len quads blkLeaves iwRow (rBlkFn r) hlen_blk
    (fun _ hb ↦ rotBlk_row_valid hcay hb0 hb1 hb2 r hb) fwRow
    c.val expP expN (cipsiModeReal r c) ?_ hcert
  have hfw : fwRow.getD c.val 0 = deepFragOuterNat r c := fwRow_fragOuterNat r c
  have hiw (b : ℕ) : ((iwRow.getD b 16384 : ℝ) - 16384) = (deepInnerInt r c b : ℝ) :=
    oneIw_innerInt r c b
  have hmvl (p q : Fin 58) : modeValLists (rBlkFn r) iwRow p q = modeMatrix r c p q := by
    unfold modeValLists modeMatrix
    rw [← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl fun b _ ↦ ?_
    have hb_eq : rBlkFn r b.val = rLeafVec (leafEquiv (r, b)) := by
      unfold rBlkFn
      rw [show (⟨min b.val 28, by omega⟩ : Fin 29) = b from Fin.ext (Nat.min_eq_left (by omega))]
    rw [hiw b.val, hb_eq]
  have hdml (p : Fin 58) : diagModeLists (rBlkFn r) iwRow p.val = modeMatrix r c p p := by
    rw [diagModeLists_of_lt (rBlkFn r) iwRow p.isLt, hmvl p p]
  have hkml (qk : ℕ) : keyModeLists (rBlkFn r) iwRow qk = keyModeReal r c qk := by
    unfold keyModeLists keyModeReal
    by_cases hqk : qk / 64 < 58 ∧ qk % 64 < 58 <;> simp only [hqk, and_self, ↓reduceDIte, hmvl]
  have hshift : ((iwRow.getD 29 16384 : ℝ) - 16384) -
      (∑ b ∈ Finset.range 29, ((iwRow.getD b 16384 : ℝ) - 16384)) =
      (deepInnerShiftInt r c : ℝ) := by
    simp_rw [hiw]; rw [← Fin.sum_univ_eq_sum_range]; unfold deepInnerShiftInt; push_cast; rfl
  have hlin : (∑ p ∈ Finset.range 58, (wTotCert.getD p 0 : ℝ) * diagModeLists (rBlkFn r) iwRow p) =
      ∑ p : Fin 58, (wTotCert.getD p.val 0 : ℝ) * modeMatrix r c p p := by
    rw [← Fin.sum_univ_eq_sum_range]; exact Finset.sum_congr rfl fun p _ ↦ by rw [hdml p]
  have href : (∑ p ∈ Finset.range 58,
      (sextetOccCountNat p : ℝ) * diagModeLists (rBlkFn r) iwRow p) = sextetModeSD0 r c := by
    rw [← Fin.sum_univ_eq_sum_range]; unfold sextetModeSD0
    refine Finset.sum_congr rfl fun p _ ↦ by rw [hdml p]; unfold sextetOccCountNat; push_cast; rfl
  have hdelta : (∑ p ∈ Finset.range 58,
      (((List.zipWith Nat.add dw0PCert dw1PCert).getD p 0 : ℝ) -
        ((List.zipWith Nat.add dw0NCert dw1NCert).getD p 0 : ℝ)) *
        diagModeLists (rBlkFn r) iwRow p) =
      ∑ p : Fin 58,
        (((dw0PCert.getD p.val 0 : ℝ) + (dw1PCert.getD p.val 0 : ℝ)) -
          ((dw0NCert.getD p.val 0 : ℝ) + (dw1NCert.getD p.val 0 : ℝ))) *
          modeMatrix r c p p := by
    rw [← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl fun p _ ↦ ?_
    rw [hdml p,
      list_zipWith_add_getD dw0PCert dw1PCert (dw0PCert_length.trans dw1PCert_length.symm),
      list_zipWith_add_getD dw0NCert dw1NCert (dw0NCert_length.trans dw1NCert_length.symm),
      Nat.cast_add, Nat.cast_add]
  have hql : evalQuadLists (rBlkFn r) iwRow quads = evalQuadList r c quadsCert := by
    rw [evalQuadLists_eq_evalQuadList r c (rBlkFn r) iwRow hkml, hquads_eval r c]
  unfold modeListsReal cipsiModeReal
  dsimp only
  rw [hfw, hshift, hlin, href, hdelta, hql]
  push_cast; ring

private lemma list_getD_take {α : Type*} :
    ∀ (n : ℕ) (xs : List α) (d : α) {k : ℕ}, k < n → (xs.take n).getD k d = xs.getD k d
  | 0, _, _, _, hk => absurd hk (Nat.not_lt_zero _)
  | _ + 1, [], _, _, _ => rfl
  | _ + 1, _ :: _, _, 0, _ => rfl
  | n + 1, _ :: xs, d, k + 1, hk => list_getD_take n xs d (by omega)

private lemma list_getD_drop {α : Type*} :
    ∀ (m : ℕ) (xs : List α) (d : α) (k : ℕ), (xs.drop m).getD k d = xs.getD (m + k) d
  | 0, _, _, _ => by simp only [List.drop_zero, Nat.zero_add]
  | _ + 1, [], _, _ => rfl
  | m + 1, _ :: xs, d, k => by
    rw [List.drop_succ_cons, list_getD_drop m xs d k, Nat.succ_add]
    rfl

private lemma block_modes_slice_of_tables
    (activeKeys wTot dTotP dTotN : List ℕ)
    (hw : wTot.length = 58) (hdP : dTotP.length = 58) (hdN : dTotN.length = 58)
    (quads : QuadList) (blkLeaves blkIw : List (List ℕ)) (uFn : ℕ → Fin 58 → ℝ)
    (hlen : blkLeaves.length = 29)
    (hblk : ∀ b < 29, List.Forall₂ ValidOrb5e8 (blkLeaves.getD b []) (List.ofFn (uFn b)))
    (fwRow : List ℕ) (cStart nModes expP expN : ℕ) (targetReal : ℝ)
    (htarget : (∑ k ∈ Finset.range nModes,
      modeListsReal uFn wTot dTotP dTotN quads (fwRow.getD (cStart + k) 0) (blkIw.getD k [])) =
      targetReal)
    (hcert : (let colTree := buildOrbColTree 6 0 58 blkLeaves
      match buildDiagGsCol colTree 58 0 .nil, buildAllGsCol colTree activeKeys .nil with
      | .some diagGs, .some activeGs =>
        modesLoopFast diagGs activeGs wTot dTotP dTotN quads fwRow
          nModes cStart blkIw 0 0 fun okM mdP mdN ↦
            okM && Nat.beq mdP expP && Nat.beq mdN expN
      | _, _ => false) = true) :
