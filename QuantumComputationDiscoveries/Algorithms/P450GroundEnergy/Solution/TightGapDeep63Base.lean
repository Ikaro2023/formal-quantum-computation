    exact (fromOffset_cast_real _).symm
  · simp [hb]
lemma nat_div_le_real {n d : ℕ} : ((n / d : ℕ) : ℝ) * (d : ℝ) ≤ (n : ℝ) := by
  exact_mod_cast Nat.div_mul_le_self n d

private lemma real_le_nat_cdiv' {n d : ℕ} (hd : 0 < d) :
    (n : ℝ) ≤ (((n + (d - 1)) / d : ℕ) : ℝ) * (d : ℝ) := by
  have h1 := Nat.div_add_mod (n + (d - 1)) d
  have h2 := Nat.mod_lt (n + (d - 1)) hd
  have hle : n ≤ ((n + (d - 1)) / d) * d := by rw [mul_comm]; omega
  exact_mod_cast hle

private lemma mul_eq_one_symm {N : ℕ} {A B : Matrix (Fin N) (Fin N) ℝ} (h : A * B = 1) :
    B * A = 1 := by
  let f : (Fin N → ℝ) →ₗ[ℝ] (Fin N → ℝ) := Matrix.toLin' B
  have hinj : Function.Injective f := by
    intro u v huv
    have h1 : (A * B) *ᵥ u = (A * B) *ᵥ v := by
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
      exact congrArg (A *ᵥ ·) huv
    simpa [h] using h1
  have hsurj : Function.Surjective f := LinearMap.injective_iff_surjective.mp hinj
  have hvec (w : Fin N → ℝ) : (B * A) *ᵥ w = w := by
    obtain ⟨u, rfl⟩ := hsurj w
    change (B * A) *ᵥ (B *ᵥ u) = B *ᵥ u
    rw [Matrix.mulVec_mulVec, Matrix.mul_assoc, h, mul_one]
  ext i j
  have hij := congrFun (hvec (fun k ↦ if k = j then 1 else 0)) i
  simpa [mulVec, dotProduct, Matrix.one_apply] using hij

private lemma jwLinearMode_add {m k : ℕ} (emb : Fin m → Fin k) (u v : Fin m → ℝ) :
    jwLinearMode emb (u + v) = jwLinearMode emb u + jwLinearMode emb v := by
  simp only [jwLinearMode, Pi.add_apply, Complex.ofReal_add, add_smul, Finset.sum_add_distrib]

private lemma jwLinearMode_sub {m k : ℕ} (emb : Fin m → Fin k) (u v : Fin m → ℝ) :
    jwLinearMode emb (u - v) = jwLinearMode emb u - jwLinearMode emb v := by
  simp only [jwLinearMode, Pi.sub_apply, Complex.ofReal_sub, sub_smul, Finset.sum_sub_distrib]

private lemma jwLinearMode_smul {m k : ℕ} (emb : Fin m → Fin k) (c : ℝ) (u : Fin m → ℝ) :
    jwLinearMode emb (c • u) = (c : ℂ) • jwLinearMode emb u := by
  simp only [jwLinearMode, Pi.smul_apply, smul_eq_mul, Complex.ofReal_mul, mul_smul,
    Finset.smul_sum]

private lemma jwLinearMode_anticomm {m k : ℕ} (emb : Fin m → Fin k) (u v : Fin m → ℝ) :
    jwLinearMode emb u * jwLinearMode emb v + jwLinearMode emb v * jwLinearMode emb u = 0 := by
  have h1 := jwLinearMode_mul_self emb (u + v)
  rw [jwLinearMode_add, add_mul, mul_add, mul_add, jwLinearMode_mul_self, jwLinearMode_mul_self,
    zero_add, add_zero] at h1
  exact h1

private lemma orbitalReflection_conj_jwLinearMode_same {N : ℕ} {w : Fin N → ℝ}
    (hw : ∑ p : Fin N, w p ^ 2 = 1) (u : Fin N → ℝ) (σ : Fin 2) :
    orbitalReflection N w σ * jwLinearMode (fun p ↦ spinOrbital N p σ) u *
      orbitalReflection N w σ =
      jwLinearMode (fun p ↦ spinOrbital N p σ)
        (fun p ↦ u p - 2 * (∑ q : Fin N, w q * u q) * w p) := by
  set emb : Fin N → Fin (2 * N) := fun p ↦ spinOrbital N p σ
  set bw := jwLinearMode emb w
  set bu := jwLinearMode emb u
  set α : ℝ := ∑ q : Fin N, w q * u q
  have hemb :=
    QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.spinOrbital_injective N σ
  have hanti_wu : bwᴴ * bu + bu * bwᴴ = (α : ℂ) • 1 :=
    jwLinearMode_conjTranspose_anticomm hemb w u
  have hanti_ww : bwᴴ * bw + bw * bwᴴ = 1 := by
    have h := jwLinearMode_conjTranspose_anticomm hemb w w
    simp_rw [← sq] at h
    simpa [bw, hw] using h
  have hbw_bu : bw * bu = -(bu * bw) := eq_neg_of_add_eq_zero_left (jwLinearMode_anticomm emb w u)
  have hbw_Nw : bw * (bwᴴ * bw) = bw := by
    have hmul := congrArg (· * bw) hanti_ww
    rw [add_mul, one_mul, Matrix.mul_assoc bwᴴ bw bw, jwLinearMode_mul_self, mul_zero, zero_add]
      at hmul
    exact (Matrix.mul_assoc bw bwᴴ bw).symm.trans hmul
  have hNw_bu : (bwᴴ * bw) * bu = bu * (bwᴴ * bw) - (α : ℂ) • bw := by
    have h1 : bwᴴ * bu = (α : ℂ) • 1 - bu * bwᴴ := eq_sub_of_add_eq hanti_wu
    calc
      (bwᴴ * bw) * bu = bwᴴ * (bw * bu) := Matrix.mul_assoc _ _ _
      _ = -(bwᴴ * (bu * bw)) := by rw [hbw_bu, mul_neg]
      _ = -((bwᴴ * bu) * bw) := by rw [Matrix.mul_assoc]
      _ = -(((α : ℂ) • 1 - bu * bwᴴ) * bw) := by rw [h1]
      _ = bu * (bwᴴ * bw) - (α : ℂ) • bw := by
        rw [sub_mul, smul_mul_assoc, one_mul, Matrix.mul_assoc, neg_sub]
  have hR_sq : orbitalReflection N w σ * orbitalReflection N w σ = 1 :=
    orbitalReflection_mul_self N hw σ
  have hbw_R : bw * orbitalReflection N w σ = -bw := by
    rw [orbitalReflection, orbitalNumberOp_eq_jwLinearMode, mul_sub, mul_one, mul_smul_comm,
      hbw_Nw]
    ext i j
    simp only [Matrix.sub_apply, Matrix.smul_apply, Matrix.neg_apply, smul_eq_mul]
    ring
  have hR_bu : orbitalReflection N w σ * bu =
      bu * orbitalReflection N w σ + ((2 * α : ℝ) : ℂ) • bw := by
    rw [orbitalReflection, orbitalNumberOp_eq_jwLinearMode, sub_mul, one_mul, smul_mul_assoc,
      hNw_bu, mul_sub, mul_one, mul_smul_comm, smul_sub, smul_smul]
    ext i j
    simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul,
      Complex.ofReal_mul, Complex.ofReal_ofNat]
    ring
  have hu' : (fun p ↦ u p - 2 * α * w p) = u - (2 * α) • w := by
    ext p; simp [Pi.sub_apply, Pi.smul_apply, mul_assoc]
  rw [hR_bu, add_mul, Matrix.mul_assoc bu, hR_sq, mul_one, smul_mul_assoc, hbw_R, smul_neg,
    ← sub_eq_add_neg, hu', jwLinearMode_sub, jwLinearMode_smul]

private lemma orbitalReflection_conj_orbitalNumberOp_same {N : ℕ} {w : Fin N → ℝ}
    (hw : ∑ p : Fin N, w p ^ 2 = 1) (u : Fin N → ℝ) (σ : Fin 2) :
    orbitalReflection N w σ * orbitalNumberOp N u σ * orbitalReflection N w σ =
      orbitalNumberOp N (fun p ↦ u p - 2 * (∑ q : Fin N, w q * u q) * w p) σ := by
  have hR_sq := orbitalReflection_mul_self N hw σ
  have hR_conj := orbitalReflection_conjTranspose N w σ
  have hmode := orbitalReflection_conj_jwLinearMode_same hw u σ
  rw [orbitalNumberOp_eq_jwLinearMode N (fun p ↦ u p - 2 * (∑ q : Fin N, w q * u q) * w p) σ,
    ← hmode, Matrix.conjTranspose_mul, Matrix.conjTranspose_mul, hR_conj]
  calc
    orbitalReflection N w σ * orbitalNumberOp N u σ * orbitalReflection N w σ
      = orbitalReflection N w σ * (jwLinearMode (fun p ↦ spinOrbital N p σ) u)ᴴ *
          1 * jwLinearMode (fun p ↦ spinOrbital N p σ) u * orbitalReflection N w σ := by
        rw [orbitalNumberOp_eq_jwLinearMode]
        simp only [mul_one, Matrix.mul_assoc]
    _ = (orbitalReflection N w σ * ((jwLinearMode (fun p ↦ spinOrbital N p σ) u)ᴴ *
          orbitalReflection N w σ)) *
          (orbitalReflection N w σ * jwLinearMode (fun p ↦ spinOrbital N p σ) u *
            orbitalReflection N w σ) := by
        rw [← hR_sq]
        simp only [Matrix.mul_assoc]

private lemma spinOrbital_ne_of_spin_ne {N : ℕ} (p q : Fin N) {σ τ : Fin 2} (hστ : σ ≠ τ) :
    spinOrbital N p σ ≠ spinOrbital N q τ := by
  intro h
  have hv := congrArg Fin.val h
  dsimp [spinOrbital] at hv
  fin_cases σ <;> fin_cases τ
  · exact hστ rfl
  · dsimp at hv; omega
  · dsimp at hv; omega
  · exact hστ rfl

private lemma orbitalNumberOp_comm_diff {N : ℕ} (w u : Fin N → ℝ)
    {σ τ : Fin 2} (hστ : σ ≠ τ) :
    orbitalNumberOp N w σ * orbitalNumberOp N u τ =
      orbitalNumberOp N u τ * orbitalNumberOp N w σ := by
  set emb1 : Fin N → Fin (2 * N) := fun p ↦ spinOrbital N p σ
  set emb2 : Fin N → Fin (2 * N) := fun q ↦ spinOrbital N q τ
  set bw := jwLinearMode emb1 w
  set cu := jwLinearMode emb2 u
  have hbw_cu : bw * cu = -(cu * bw) := by
    apply eq_neg_of_add_eq_zero_left
    have h1 : bw * cu = ∑ p : Fin N, ∑ q : Fin N,
        ((w p : ℂ) * (u q : ℂ)) •
          (jwAnnihilate (2 * N) (emb1 p) * jwAnnihilate (2 * N) (emb2 q)) := by
      simp only [bw, cu, jwLinearMode, Finset.sum_mul, Finset.mul_sum, smul_mul_smul_comm]
      rw [Finset.sum_comm]
    have h2 : cu * bw = ∑ p : Fin N, ∑ q : Fin N,
        ((w p : ℂ) * (u q : ℂ)) •
          (jwAnnihilate (2 * N) (emb2 q) * jwAnnihilate (2 * N) (emb1 p)) := by
      have h2' : cu * bw = ∑ q : Fin N, ∑ p : Fin N,
          ((u q : ℂ) * (w p : ℂ)) •
            (jwAnnihilate (2 * N) (emb2 q) * jwAnnihilate (2 * N) (emb1 p)) := by
        simp only [bw, cu, jwLinearMode, Finset.sum_mul, Finset.mul_sum, smul_mul_smul_comm]
        rw [Finset.sum_comm]
      rw [h2', Finset.sum_comm]
      exact Finset.sum_congr rfl fun p _ ↦ Finset.sum_congr rfl fun q _ ↦ by
        rw [mul_comm (u q : ℂ) (w p : ℂ)]
    rw [h1, h2, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun p _ ↦ ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun q _ ↦ ?_
    rw [← smul_add, jwAnnihilate_anticomm, smul_zero]
  have hbwH_cu : bwᴴ * cu = -(cu * bwᴴ) := by
    apply eq_neg_of_add_eq_zero_left
    have hconj : bwᴴ = ∑ p : Fin N, (w p : ℂ) • (jwAnnihilate (2 * N) (emb1 p))ᴴ := by
      simp [bw, jwLinearMode, Matrix.conjTranspose_sum]
    have h1 : bwᴴ * cu = ∑ p : Fin N, ∑ q : Fin N,
        ((w p : ℂ) * (u q : ℂ)) •
          ((jwAnnihilate (2 * N) (emb1 p))ᴴ * jwAnnihilate (2 * N) (emb2 q)) := by
      rw [hconj]
      simp only [cu, jwLinearMode, Finset.sum_mul, Finset.mul_sum, smul_mul_smul_comm]
      rw [Finset.sum_comm]
    have h2 : cu * bwᴴ = ∑ p : Fin N, ∑ q : Fin N,
        ((w p : ℂ) * (u q : ℂ)) •
          (jwAnnihilate (2 * N) (emb2 q) * (jwAnnihilate (2 * N) (emb1 p))ᴴ) := by
      have h2' : cu * bwᴴ = ∑ q : Fin N, ∑ p : Fin N,
          ((u q : ℂ) * (w p : ℂ)) •
            (jwAnnihilate (2 * N) (emb2 q) * (jwAnnihilate (2 * N) (emb1 p))ᴴ) := by
        rw [hconj]
        simp only [cu, jwLinearMode, Finset.sum_mul, Finset.mul_sum, smul_mul_smul_comm]
        rw [Finset.sum_comm]
      rw [h2', Finset.sum_comm]
      exact Finset.sum_congr rfl fun p _ ↦ Finset.sum_congr rfl fun q _ ↦ by
        rw [mul_comm (u q : ℂ) (w p : ℂ)]
    rw [h1, h2, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun p _ ↦ ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun q _ ↦ ?_
    have hne : emb1 p ≠ emb2 q := spinOrbital_ne_of_spin_ne p q hστ
    rw [← smul_add, jwAnnihilate_conjTranspose_anticomm]
    simp only [hne, ↓reduceIte, smul_zero]
  have hNw_cu : (bwᴴ * bw) * cu = cu * (bwᴴ * bw) := by
    calc
      (bwᴴ * bw) * cu = bwᴴ * (bw * cu) := Matrix.mul_assoc _ _ _
      _ = -(bwᴴ * (cu * bw)) := by rw [hbw_cu, mul_neg]
      _ = -((bwᴴ * cu) * bw) := by rw [Matrix.mul_assoc]
      _ = cu * (bwᴴ * bw) := by rw [hbwH_cu, neg_mul, neg_neg, Matrix.mul_assoc]
  have hNw_cuH : (bwᴴ * bw) * cuᴴ = cuᴴ * (bwᴴ * bw) := by
    have h := congrArg Matrix.conjTranspose hNw_cu
    simp only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose] at h
    exact h.symm
  rw [orbitalNumberOp_eq_jwLinearMode N w σ, orbitalNumberOp_eq_jwLinearMode N u τ]
  change (bwᴴ * bw) * (cuᴴ * cu) = (cuᴴ * cu) * (bwᴴ * bw)
  rw [← Matrix.mul_assoc (bwᴴ * bw), hNw_cuH, Matrix.mul_assoc cuᴴ, hNw_cu, Matrix.mul_assoc]

private lemma orbitalReflection_comm_orbitalNumberOp_diff {N : ℕ} (w u : Fin N → ℝ)
    {σ τ : Fin 2} (hστ : σ ≠ τ) :
    orbitalReflection N w σ * orbitalNumberOp N u τ =
      orbitalNumberOp N u τ * orbitalReflection N w σ := by
  rw [orbitalReflection, sub_mul, mul_sub, one_mul, mul_one, smul_mul_assoc, mul_smul_comm,
    orbitalNumberOp_comm_diff w u hστ]

private noncomputable def householderMat {N : ℕ} (w : Fin N → ℝ) : Matrix (Fin N) (Fin N) ℝ :=
  1 - (2 : ℝ) • Matrix.vecMulVec w w

private lemma householderMat_transpose {N : ℕ} (w : Fin N → ℝ) :
    (householderMat w)ᵀ = householderMat w := by
  ext i j
  by_cases hij : i = j
  · subst hij; simp [householderMat, Matrix.vecMulVec_apply]
  · simp [householderMat, Matrix.vecMulVec_apply, hij, Ne.symm hij, mul_comm]

private lemma householderMat_mulVec {N : ℕ} (w u : Fin N → ℝ) :
    householderMat w *ᵥ u = fun p ↦ u p - 2 * (∑ q : Fin N, w q * u q) * w p := by
  ext p
  simp only [householderMat, mulVec, dotProduct, Matrix.sub_apply, Matrix.one_apply,
    Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]
  have h1 : (∑ q : Fin N, ((if p = q then (1 : ℝ) else 0) - 2 * (w p * w q)) * u q) =
      (∑ q : Fin N, if p = q then u q else 0) - 2 * w p * (∑ q : Fin N, w q * u q) := by
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun q _ ↦ ?_
    split_ifs with hpq <;> ring
  rw [h1]
  simp only [Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
  ring

private lemma householderMat_mul_self {N : ℕ} {w : Fin N → ℝ} (hw : ∑ p : Fin N, w p ^ 2 = 1) :
    householderMat w * householderMat w = 1 := by
  ext i j
  have hcol := congrFun (householderMat_mulVec w (fun p ↦ householderMat w p j)) i
  change (householderMat w * householderMat w) i j = _ at hcol
  rw [hcol]
  have hdot : (∑ q : Fin N, w q * householderMat w q j) = -w j := by
    have hterm : ∀ q : Fin N, w q * householderMat w q j =
        (if q = j then w q else 0) - 2 * w q ^ 2 * w j := by
      intro q
      simp only [householderMat, Matrix.sub_apply, Matrix.one_apply, Matrix.smul_apply,
        Matrix.vecMulVec_apply, smul_eq_mul]
      split_ifs with hqj <;> ring
    simp_rw [hterm, Finset.sum_sub_distrib]
    have hsum2 : (∑ q : Fin N, 2 * w q ^ 2 * w j) = 2 * (∑ q : Fin N, w q ^ 2) * w j := by
      rw [Finset.mul_sum, Finset.sum_mul]
    rw [hsum2, hw]
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    ring
  rw [hdot]
  simp only [householderMat, Matrix.sub_apply, Matrix.one_apply, Matrix.smul_apply,
    Matrix.vecMulVec_apply, smul_eq_mul]
  ring

private noncomputable def fermionHouseholder {N : ℕ} (w : Fin N → ℝ) : Operator (2 ^ (2 * N)) :=
  orbitalReflection N w 0 * orbitalReflection N w 1

private lemma orbitalReflection_comm_diff {N : ℕ} (w : Fin N → ℝ) :
    orbitalReflection N w 0 * orbitalReflection N w 1 =
      orbitalReflection N w 1 * orbitalReflection N w 0 := by
  have hc := orbitalNumberOp_comm_diff w w (show (0 : Fin 2) ≠ 1 by decide)
  rw [orbitalReflection, orbitalReflection]
  simp only [sub_mul, mul_sub, one_mul, mul_one, smul_mul_smul_comm, hc]
  ext i j
  simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
  ring

private lemma vecMulVec_isSymm {N : ℕ} (v : Fin N → ℝ) : (Matrix.vecMulVec v v).IsSymm := by
  ext i j
  simp [Matrix.vecMulVec_apply, mul_comm]

private lemma fermionHouseholder_comm_sector {N : ℕ} {w : Fin N → ℝ}
    (hw : ∑ p : Fin N, w p ^ 2 = 1) (η : ℕ) :
    fermionHouseholder w * electronSectorProjector (2 * N) η =
      electronSectorProjector (2 * N) η * fermionHouseholder w := by
  let thc₁ : THCFactorization N 0 := {
    h1eMod := Matrix.vecMulVec w w
    h1eMod_symm := vecMulVec_isSymm w
    chi := Fin.elim0
    chi_norm := fun μ ↦ Fin.elim0 μ
    zeta := 0
    zeta_symm := Matrix.isSymm_zero
  }
  let thc₂ : THCFactorization N 1 := {
    h1eMod := 0
    h1eMod_symm := Matrix.isSymm_zero
    chi := fun _ ↦ w
    chi_norm := fun _ ↦ hw
    zeta := fun _ _ ↦ 2
    zeta_symm := by ext i j; rfl
  }
  have hc1 := TightGapBase.thcHamiltonian_comm_electronSectorProjector thc₁ η
  have hc2 := TightGapBase.thcHamiltonian_comm_electronSectorProjector thc₂ η
  have hH1 : thcHamiltonian thc₁ = orbitalNumberOp N w 0 + orbitalNumberOp N w 1 := by
    simp [thcHamiltonian, thc₁, oneBodyHamiltonian_vecMulVec]
  have hH2 : thcHamiltonian thc₂ =
      (orbitalNumberOp N w 0 + orbitalNumberOp N w 1) +
        (2 : ℂ) • (orbitalNumberOp N w 0 * orbitalNumberOp N w 1) := by
    simp only [thcHamiltonian, thc₂, oneBodyHamiltonian_zero, zero_add, Fin.sum_univ_two,
      Fin.sum_univ_one, orbitalNumberOp_mul_self N hw 0, orbitalNumberOp_mul_self N hw 1,
      orbitalNumberOp_comm_diff w w (show (1 : Fin 2) ≠ 0 by decide)]
    ext i j
    simp only [Matrix.smul_apply, Matrix.add_apply, smul_eq_mul]
    norm_num
    ring
  have hFH : fermionHouseholder w =
      1 - (4 : ℂ) • thcHamiltonian thc₁ + (2 : ℂ) • thcHamiltonian thc₂ := by
    rw [hH1, hH2, fermionHouseholder, orbitalReflection, orbitalReflection]
    simp only [sub_mul, mul_sub, one_mul, mul_one, smul_mul_assoc, mul_smul_comm]
    ext i j
    simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
    ring
  rw [hFH]
  simp only [add_mul, sub_mul, one_mul, mul_add, mul_sub, mul_one,
    smul_mul_assoc, mul_smul_comm, hc1, hc2]

private lemma fermionHouseholder_props {N : ℕ} {w : Fin N → ℝ}
    (hw : ∑ p : Fin N, w p ^ 2 = 1) (η : ℕ) :
    (fermionHouseholder w)ᴴ = fermionHouseholder w ∧
    fermionHouseholder w * fermionHouseholder w = 1 ∧
    fermionHouseholder w * electronSectorProjector (2 * N) η =
      electronSectorProjector (2 * N) η * fermionHouseholder w ∧
    ∀ (u : Fin N → ℝ) (σ : Fin 2),
      (fermionHouseholder w)ᴴ * orbitalNumberOp N u σ * fermionHouseholder w =
        orbitalNumberOp N (householderMat w *ᵥ u) σ := by
  have hR0_sq := orbitalReflection_mul_self N hw 0
  have hR1_sq := orbitalReflection_mul_self N hw 1
  have hcomm := orbitalReflection_comm_diff w
  have hH : (fermionHouseholder w)ᴴ = fermionHouseholder w := by
    rw [fermionHouseholder, Matrix.conjTranspose_mul, orbitalReflection_conjTranspose,
      orbitalReflection_conjTranspose, hcomm.symm]
  have hsq : fermionHouseholder w * fermionHouseholder w = 1 := by
    calc
      (orbitalReflection N w 0 * orbitalReflection N w 1) *
          (orbitalReflection N w 0 * orbitalReflection N w 1)
        = orbitalReflection N w 0 * (orbitalReflection N w 1 * orbitalReflection N w 0) *
            orbitalReflection N w 1 := by simp only [Matrix.mul_assoc]
      _ = (orbitalReflection N w 0 * orbitalReflection N w 0) *
            (orbitalReflection N w 1 * orbitalReflection N w 1) := by
          rw [← hcomm]; simp only [Matrix.mul_assoc]
      _ = 1 := by rw [hR0_sq, hR1_sq, mul_one]
  refine ⟨hH, hsq, fermionHouseholder_comm_sector hw η, fun u σ ↦ ?_⟩
  rw [hH, fermionHouseholder, householderMat_mulVec]
  fin_cases σ
  · change (orbitalReflection N w 0 * orbitalReflection N w 1) * orbitalNumberOp N u 0 *
        (orbitalReflection N w 0 * orbitalReflection N w 1) =
      orbitalNumberOp N (fun p ↦ u p - 2 * (∑ q : Fin N, w q * u q) * w p) 0
    have hc1 := orbitalReflection_comm_orbitalNumberOp_diff w u (show (1 : Fin 2) ≠ 0 by decide)
    calc
      (orbitalReflection N w 0 * orbitalReflection N w 1) * orbitalNumberOp N u 0 *
          (orbitalReflection N w 0 * orbitalReflection N w 1)
        = orbitalReflection N w 0 * (orbitalReflection N w 1 * orbitalNumberOp N u 0) *
            orbitalReflection N w 0 * orbitalReflection N w 1 := by simp only [Matrix.mul_assoc]
      _ = orbitalReflection N w 0 * orbitalNumberOp N u 0 *
            (orbitalReflection N w 1 * orbitalReflection N w 0) * orbitalReflection N w 1 := by
          rw [hc1]; simp only [Matrix.mul_assoc]
      _ = (orbitalReflection N w 0 * orbitalNumberOp N u 0 * orbitalReflection N w 0) *
            (orbitalReflection N w 1 * orbitalReflection N w 1) := by
          rw [← hcomm]; simp only [Matrix.mul_assoc]
      _ = _ := by rw [hR1_sq, mul_one, orbitalReflection_conj_orbitalNumberOp_same hw u 0]
  · change (orbitalReflection N w 0 * orbitalReflection N w 1) * orbitalNumberOp N u 1 *
        (orbitalReflection N w 0 * orbitalReflection N w 1) =
      orbitalNumberOp N (fun p ↦ u p - 2 * (∑ q : Fin N, w q * u q) * w p) 1
    have hc0 := orbitalReflection_comm_orbitalNumberOp_diff w u (show (0 : Fin 2) ≠ 1 by decide)
    calc
      (orbitalReflection N w 0 * orbitalReflection N w 1) * orbitalNumberOp N u 1 *
          (orbitalReflection N w 0 * orbitalReflection N w 1)
        = orbitalReflection N w 0 * orbitalReflection N w 1 *
            (orbitalNumberOp N u 1 * orbitalReflection N w 0) * orbitalReflection N w 1 := by
          simp only [Matrix.mul_assoc]
      _ = (orbitalReflection N w 0 * orbitalReflection N w 1) *
            (orbitalReflection N w 0 * orbitalNumberOp N u 1) * orbitalReflection N w 1 := by
          rw [← hc0, Matrix.mul_assoc]
      _ = (orbitalReflection N w 0 * orbitalReflection N w 0) *
            (orbitalReflection N w 1 * orbitalNumberOp N u 1 * orbitalReflection N w 1) := by
          calc
            (orbitalReflection N w 0 * orbitalReflection N w 1) *
                (orbitalReflection N w 0 * orbitalNumberOp N u 1) * orbitalReflection N w 1
              = orbitalReflection N w 0 * (orbitalReflection N w 1 * orbitalReflection N w 0) *
                  orbitalNumberOp N u 1 * orbitalReflection N w 1 := by
                simp only [Matrix.mul_assoc]
            _ = (orbitalReflection N w 0 * orbitalReflection N w 0) *
                  (orbitalReflection N w 1 * orbitalNumberOp N u 1 * orbitalReflection N w 1) := by
                rw [← hcomm]; simp only [Matrix.mul_assoc]
      _ = _ := by rw [hR0_sq, one_mul, orbitalReflection_conj_orbitalNumberOp_same hw u 1]

private lemma row_eq_one_of_col_eq_one {N : ℕ} {Q : Matrix (Fin N) (Fin N) ℝ}
    (hQ : Qᵀ * Q = 1) (k : Fin N)
    (hcol : ∀ i : Fin N, Q i k = (1 : Matrix (Fin N) (Fin N) ℝ) i k) :
    ∀ j : Fin N, Q k j = (1 : Matrix (Fin N) (Fin N) ℝ) k j := by
  have hQ_right : Q * Qᵀ = 1 := mul_eq_one_symm hQ
  have hdiag : ∑ j : Fin N, (Q k j) ^ 2 = 1 := by
    have h := congrFun (congrFun hQ_right k) k
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply_eq, ← sq] at h
    exact h
  have hkk : Q k k = 1 := by simpa using hcol k
  have herase := (Finset.add_sum_erase Finset.univ (fun j ↦ (Q k j) ^ 2) (Finset.mem_univ k)).symm
  rw [hdiag, hkk, one_pow] at herase
  have hrest : ∑ j ∈ Finset.univ.erase k, (Q k j) ^ 2 = 0 := by linarith
  intro j
  by_cases hjk : j = k
  · subst hjk; simpa using hkk
  · have hmem : j ∈ Finset.univ.erase k := Finset.mem_erase.mpr ⟨hjk, Finset.mem_univ j⟩
    have hle := Finset.single_le_sum (fun x _ ↦ sq_nonneg (Q k x)) hmem
    have hsq0 : (Q k j) ^ 2 = 0 := le_antisymm (hle.trans hrest.le) (sq_nonneg _)
    have hj0 : Q k j = 0 := by nlinarith
    rw [hj0, Matrix.one_apply_ne (Ne.symm hjk)]

private lemma exists_fermionic_lift_aux {N : ℕ} (η : ℕ) :
    ∀ (m : ℕ), m ≤ N →
      ∀ (Q : Matrix (Fin N) (Fin N) ℝ),
        Qᵀ * Q = 1 →
        (∀ i j : Fin N, m ≤ i.val ∨ m ≤ j.val → Q i j = (1 : Matrix (Fin N) (Fin N) ℝ) i j) →
        ∃ U : Operator (2 ^ (2 * N)),
          Uᴴ * U = 1 ∧ U * Uᴴ = 1 ∧
          U * electronSectorProjector (2 * N) η = electronSectorProjector (2 * N) η * U ∧
          ∀ (u : Fin N → ℝ) (σ : Fin 2),
            Uᴴ * orbitalNumberOp N u σ * U = orbitalNumberOp N (Qᵀ *ᵥ u) σ
  | 0, _, Q, _, hfix => by
    have hQ1 : Q = 1 := by
      ext i j
      exact hfix i j (Or.inl (Nat.zero_le _))
    refine ⟨1, by simp, by simp, by simp, fun u σ ↦ ?_⟩
    subst hQ1
    simp
  | m + 1, hm, Q, hQ, hfix => by
    let k : Fin N := ⟨m, hm⟩
    by_cases hcol : ∀ i : Fin N, Q i k = (1 : Matrix (Fin N) (Fin N) ℝ) i k
    · have hrow := row_eq_one_of_col_eq_one hQ k hcol
      refine exists_fermionic_lift_aux η m (Nat.le_of_succ_le hm) Q hQ fun i j hij ↦ ?_
      rcases hij with hi | hj
      · rcases eq_or_lt_of_le hi with hik | hlt
        · have hik' : i = k := Fin.ext hik.symm
          subst hik'; exact hrow j
        · exact hfix i j (Or.inl hlt)
      · rcases eq_or_lt_of_le hj with hjk | hlt
        · have hjk' : j = k := Fin.ext hjk.symm
          subst hjk'; exact hcol i
        · exact hfix i j (Or.inr hlt)
    · rcases not_forall.mp hcol with ⟨i₀, hi₀⟩
      set e : Fin N → ℝ := fun i ↦ (1 : Matrix (Fin N) (Fin N) ℝ) i k
      set v : Fin N → ℝ := fun i ↦ Q i k - e i
      have hv_ne : v i₀ ≠ 0 := sub_ne_zero.mpr hi₀
      have hS_pos : 0 < ∑ i : Fin N, (v i) ^ 2 :=
        lt_of_lt_of_le (sq_pos_of_ne_zero hv_ne)
          (Finset.single_le_sum (fun x _ ↦ sq_nonneg (v x)) (Finset.mem_univ i₀))
      set S : ℝ := ∑ i : Fin N, (v i) ^ 2
      have hQ_col_norm : ∑ i : Fin N, (Q i k) ^ 2 = 1 := by
        have h := congrFun (congrFun hQ k) k
        simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply_eq, ← sq] at h
        exact h
      have he_norm : ∑ i : Fin N, (e i) ^ 2 = 1 := by
        simp only [e, Matrix.one_apply]
        rw [Finset.sum_eq_single k]
        · simp
        · intro i _ hik; simp [hik]
        · intro hk; exact (hk (Finset.mem_univ k)).elim
      have hdot_ce : ∑ i : Fin N, Q i k * e i = Q k k := by
        simp only [e, Matrix.one_apply]
        rw [Finset.sum_eq_single k]
        · simp
        · intro i _ hik; simp [hik]
        · intro hk; exact (hk (Finset.mem_univ k)).elim
      have hS_eq : S = 2 * (1 - Q k k) := by
        have hexp : S = (∑ i : Fin N, (Q i k) ^ 2) - 2 * (∑ i : Fin N, Q i k * e i) +
            (∑ i : Fin N, (e i) ^ 2) := by
          dsimp only [S, v]
          rw [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl fun i _ ↦ by ring
        rw [hexp, hQ_col_norm, hdot_ce, he_norm]
        ring
      set sS : ℝ := √S
      have hsS_sq : sS ^ 2 = S := Real.sq_sqrt hS_pos.le
      set w : Fin N → ℝ := fun i ↦ v i / sS
      have hw_norm : ∑ i : Fin N, (w i) ^ 2 = 1 := by
        have : (∑ i : Fin N, (w i) ^ 2) = S / (sS ^ 2) := by
          dsimp only [w, S]
          simp_rw [div_pow]
          rw [← Finset.sum_div]
        rw [this, hsS_sq, div_self hS_pos.ne']
      have hw_zero : ∀ i : Fin N, m + 1 ≤ i.val → w i = 0 := by
        intro i hi
        have hQi : Q i k = e i := hfix i k (Or.inl hi)
        simp [w, v, hQi]
      set Q' : Matrix (Fin N) (Fin N) ℝ := householderMat w * Q
      have hQ'_orth : Q'ᵀ * Q' = 1 := by
        calc
          Q'ᵀ * Q' = Qᵀ * (householderMat w)ᵀ * (householderMat w * Q) := by
            rw [Matrix.transpose_mul]
          _ = Qᵀ * (householderMat w * householderMat w) * Q := by
            rw [householderMat_transpose]; simp only [Matrix.mul_assoc]
          _ = 1 := by rw [householderMat_mul_self hw_norm, mul_one, hQ]
      have hQ'_col_k : ∀ i : Fin N, Q' i k = (1 : Matrix (Fin N) (Fin N) ℝ) i k := by
        intro i
        have hmul := congrFun (householderMat_mulVec w (fun q ↦ Q q k)) i
        change Q' i k = _ at hmul
        rw [hmul]
        have hwc : (∑ q : Fin N, w q * Q q k) = (1 - Q k k) / sS := by
          have h1 : (∑ q : Fin N, v q * Q q k) = 1 - Q k k := by
            have : (∑ q : Fin N, v q * Q q k) =
                (∑ q : Fin N, (Q q k) ^ 2) - (∑ q : Fin N, Q q k * e q) := by
              dsimp only [v]
              rw [← Finset.sum_sub_distrib]
              exact Finset.sum_congr rfl fun q _ ↦ by ring
            rw [this, hQ_col_norm, hdot_ce]
          dsimp only [w]
          simp_rw [div_mul_eq_mul_div]
          rw [← Finset.sum_div, h1]
        rw [hwc]
        dsimp only [w, v, e]
        have hcalc : Q i k - 2 * ((1 - Q k k) / sS) * ((Q i k - (1 : Matrix _ _ ℝ) i k) / sS) =
            Q i k - (2 * (1 - Q k k) / (sS ^ 2)) * (Q i k - (1 : Matrix _ _ ℝ) i k) := by ring
        rw [hcalc, hsS_sq, ← hS_eq, div_self hS_pos.ne', one_mul, sub_sub_cancel]
      have hQ'_fix_hi : ∀ i j : Fin N, m + 1 ≤ i.val ∨ m + 1 ≤ j.val →
          Q' i j = (1 : Matrix (Fin N) (Fin N) ℝ) i j := by
        intro i j hij
        have hmul := congrFun (householderMat_mulVec w (fun q ↦ Q q j)) i
        change Q' i j = _ at hmul
        rw [hmul]
        rcases hij with hi | hj
        · rw [hw_zero i hi, mul_zero, sub_zero]
          exact hfix i j (Or.inl hi)
        · have hdot0 : (∑ q : Fin N, w q * Q q j) = 0 := by
            have hcolj : ∀ q : Fin N, Q q j = (1 : Matrix (Fin N) (Fin N) ℝ) q j :=
              fun q ↦ hfix q j (Or.inr hj)
            simp_rw [hcolj, Matrix.one_apply]
            rw [Finset.sum_eq_single j]
            · simp [hw_zero j hj]
            · intro q _ hqj; simp [hqj]
            · intro h; exact (h (Finset.mem_univ j)).elim
          rw [hdot0, mul_zero, zero_mul, sub_zero]
          exact hfix i j (Or.inr hj)
      have hQ'_row_k := row_eq_one_of_col_eq_one hQ'_orth k hQ'_col_k
      have hQ'_fix_m : ∀ i j : Fin N, m ≤ i.val ∨ m ≤ j.val →
          Q' i j = (1 : Matrix (Fin N) (Fin N) ℝ) i j := by
        intro i j hij
        rcases hij with hi | hj
        · rcases eq_or_lt_of_le hi with hik | hlt
          · have hik' : i = k := Fin.ext hik.symm
            subst hik'; exact hQ'_row_k j
          · exact hQ'_fix_hi i j (Or.inl hlt)
        · rcases eq_or_lt_of_le hj with hjk | hlt
          · have hjk' : j = k := Fin.ext hjk.symm
            subst hjk'; exact hQ'_col_k i
          · exact hQ'_fix_hi i j (Or.inr hlt)
      obtain ⟨U', hU'1, hU'2, hU'sec, hU'conj⟩ :=
        exists_fermionic_lift_aux η m (Nat.le_of_succ_le hm) Q' hQ'_orth hQ'_fix_m
      obtain ⟨hFH_H, hFH_sq, hFH_sec, hFH_conj⟩ := fermionHouseholder_props hw_norm η
      refine ⟨fermionHouseholder w * U', ?_, ?_, ?_, fun u σ ↦ ?_⟩
      · rw [Matrix.conjTranspose_mul, hFH_H]
        calc
          U'ᴴ * fermionHouseholder w * (fermionHouseholder w * U')
            = U'ᴴ * (fermionHouseholder w * fermionHouseholder w) * U' := by
              simp only [Matrix.mul_assoc]
          _ = 1 := by rw [hFH_sq, mul_one, hU'1]
      · rw [Matrix.conjTranspose_mul, hFH_H]
        calc
          fermionHouseholder w * U' * (U'ᴴ * fermionHouseholder w)
            = fermionHouseholder w * (U' * U'ᴴ) * fermionHouseholder w := by
              simp only [Matrix.mul_assoc]
          _ = 1 := by rw [hU'2, mul_one, hFH_sq]
      · rw [Matrix.mul_assoc, hU'sec, ← Matrix.mul_assoc, hFH_sec, Matrix.mul_assoc]
      · have hQ_eq : Q = householderMat w * Q' := by
          dsimp only [Q']
          rw [← Matrix.mul_assoc, householderMat_mul_self hw_norm, one_mul]
        have hQT_mulVec : Qᵀ *ᵥ u = Q'ᵀ *ᵥ (householderMat w *ᵥ u) := by
          rw [hQ_eq, Matrix.transpose_mul, householderMat_transpose, Matrix.mulVec_mulVec]
        rw [Matrix.conjTranspose_mul]
        calc
          U'ᴴ * (fermionHouseholder w)ᴴ * orbitalNumberOp N u σ * (fermionHouseholder w * U')
            = U'ᴴ * ((fermionHouseholder w)ᴴ * orbitalNumberOp N u σ * fermionHouseholder w) *
                U' := by simp only [Matrix.mul_assoc]
          _ = orbitalNumberOp N (Qᵀ *ᵥ u) σ := by rw [hFH_conj, hU'conj, hQT_mulVec]

private lemma exists_fermionic_lift_of_orthogonal {N : ℕ} (η : ℕ) (Q : Matrix (Fin N) (Fin N) ℝ)
    (hQ : Qᵀ * Q = 1) :
    ∃ U : Operator (2 ^ (2 * N)),
      Uᴴ * U = 1 ∧ U * Uᴴ = 1 ∧
      U * electronSectorProjector (2 * N) η = electronSectorProjector (2 * N) η * U ∧
      ∀ (u : Fin N → ℝ) (σ : Fin 2),
        Uᴴ * orbitalNumberOp N u σ * U = orbitalNumberOp N (Qᵀ *ᵥ u) σ :=
  exists_fermionic_lift_aux η N le_rfl Q hQ fun i j hij ↦ by
    rcases hij with hi | hj
    · exact absurd i.isLt (not_lt.mpr hi)
    · exact absurd j.isLt (not_lt.mpr hj)

/-! ## Part 2: Rotated DF-THC Factorization & Hamiltonian Conjugation -/

/-- Internal Deep helper `rotVec`. -/
noncomputable def rotVec (Q : Matrix (Fin 58) (Fin 58) ℝ) (v : Fin 58 → ℝ) : Fin 58 → ℝ :=
  Qᵀ *ᵥ v

/-- Internal Deep helper `rotOneBodyVec`. -/
noncomputable def rotOneBodyVec (Q : Matrix (Fin 58) (Fin 58) ℝ)
    (ℓ : Fin 58) : Fin 58 → ℝ :=
  rotVec Q (oneBodyVector ℓ)

/-- Internal Deep helper `rotLeafVec`. -/
noncomputable def rotLeafVec (Q : Matrix (Fin 58) (Fin 58) ℝ) (μ : Fin 261) : Fin 58 → ℝ :=
  rotVec Q (leafVector μ)

lemma rotVec_norm_sq {Q : Matrix (Fin 58) (Fin 58) ℝ} (hQ_right : Q * Qᵀ = 1)
    {v : Fin 58 → ℝ} (hv : ∑ p : Fin 58, v p ^ 2 = 1) :
    ∑ j : Fin 58, (rotVec Q v j) ^ 2 = 1 := by
  have hdot : (rotVec Q v) ⬝ᵥ (rotVec Q v) = v ⬝ᵥ v := by
    calc
      (Qᵀ *ᵥ v) ⬝ᵥ (Qᵀ *ᵥ v) = ((Qᵀ *ᵥ v) ᵥ* Qᵀ) ⬝ᵥ v := Matrix.dotProduct_mulVec _ _ _
      _ = (Q *ᵥ (Qᵀ *ᵥ v)) ⬝ᵥ v := by rw [← Matrix.mulVec_transpose Qᵀ, Matrix.transpose_transpose]
      _ = ((Q * Qᵀ) *ᵥ v) ⬝ᵥ v := by rw [Matrix.mulVec_mulVec]
      _ = v ⬝ᵥ v := by rw [hQ_right, Matrix.one_mulVec]
  simpa only [dotProduct, ← sq] using hdot.trans (by simpa only [dotProduct, ← sq] using hv)

/-- Internal Deep helper `rotThc`. -/
noncomputable def rotThc (Q : Matrix (Fin 58) (Fin 58) ℝ) (hQ_right : Q * Qᵀ = 1) :
    THCFactorization 58 261 where
  h1eMod :=
    (∑ ℓ : Fin 58, oneBodyEigenvalue ℓ •
      Matrix.vecMulVec (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ)) +
    ∑ μ : Fin 261,
      (∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ) •
        Matrix.vecMulVec (rotLeafVec Q μ) (rotLeafVec Q μ)
  h1eMod_symm := by
    ext i j
    simp [Matrix.transpose_apply, Matrix.sum_apply, Matrix.vecMulVec_apply, mul_comm]
  chi μ := rotLeafVec Q μ
  chi_norm μ := rotVec_norm_sq hQ_right (dfthc.chi_norm μ)
  zeta := dfthc.zeta
  zeta_symm := dfthc.zeta_symm

private lemma conj_thcHamiltonian_rotThc {Q : Matrix (Fin 58) (Fin 58) ℝ} (hQ_right : Q * Qᵀ = 1)
    {U : Operator (2 ^ (2 * 58))} (hUU : U * Uᴴ = 1)
    (hconj : ∀ (u : Fin 58 → ℝ) (σ : Fin 2),
      Uᴴ * orbitalNumberOp 58 u σ * U = orbitalNumberOp 58 (Qᵀ *ᵥ u) σ) :
    Uᴴ * thcHamiltonian dfthc * U = thcHamiltonian (rotThc Q hQ_right) := by
  have hob_single (t : ℝ) (v : Fin 58 → ℝ) :
      Uᴴ * oneBodyHamiltonian (t • Matrix.vecMulVec v v) * U =
        oneBodyHamiltonian (t • Matrix.vecMulVec (rotVec Q v) (rotVec Q v)) := by
    rw [TightGapBase.oneBodyHamiltonian_smul_vecMulVec,
      TightGapBase.oneBodyHamiltonian_smul_vecMulVec,
      Fin.sum_univ_two, Fin.sum_univ_two,
      mul_smul_comm, smul_mul_assoc, mul_add, add_mul, hconj v 0, hconj v 1]
    rfl
  have h1e_dfthc : dfthc.h1eMod =
      (∑ ℓ : Fin 58, oneBodyEigenvalue ℓ • Matrix.vecMulVec (oneBodyVector ℓ) (oneBodyVector ℓ)) +
      ∑ μ : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ) •
          Matrix.vecMulVec (leafVector μ) (leafVector μ) := rfl
  have h1e_rot : (rotThc Q hQ_right).h1eMod =
      (∑ ℓ : Fin 58, oneBodyEigenvalue ℓ •
        Matrix.vecMulVec (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ)) +
      ∑ μ : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ) •
          Matrix.vecMulVec (rotLeafVec Q μ) (rotLeafVec Q μ) := rfl
  have h1a : Uᴴ * oneBodyHamiltonian
      (∑ ℓ : Fin 58, oneBodyEigenvalue ℓ • Matrix.vecMulVec (oneBodyVector ℓ) (oneBodyVector ℓ)) *
        U =
      oneBodyHamiltonian (∑ ℓ : Fin 58, oneBodyEigenvalue ℓ •
        Matrix.vecMulVec (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ)) := by
    rw [TightGapBase.oneBodyHamiltonian_sum, TightGapBase.oneBodyHamiltonian_sum,
      Finset.mul_sum, Finset.sum_mul]
    exact Finset.sum_congr rfl fun ℓ _ ↦ hob_single _ _
  have h1b : Uᴴ * oneBodyHamiltonian
      (∑ μ : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ) •
          Matrix.vecMulVec (leafVector μ) (leafVector μ)) * U =
      oneBodyHamiltonian (∑ μ : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ) •
          Matrix.vecMulVec (rotLeafVec Q μ) (rotLeafVec Q μ)) := by
    rw [TightGapBase.oneBodyHamiltonian_sum, TightGapBase.oneBodyHamiltonian_sum,
      Finset.mul_sum, Finset.sum_mul]
    exact Finset.sum_congr rfl fun μ _ ↦ hob_single _ _
  have h1 : Uᴴ * oneBodyHamiltonian dfthc.h1eMod * U =
      oneBodyHamiltonian (rotThc Q hQ_right).h1eMod := by
    rw [h1e_dfthc, h1e_rot, TightGapBase.oneBodyHamiltonian_add,
      TightGapBase.oneBodyHamiltonian_add, mul_add, add_mul, h1a, h1b]
  have hpair (u v : Fin 58 → ℝ) (σ τ : Fin 2) :
      Uᴴ * (orbitalNumberOp 58 u σ * orbitalNumberOp 58 v τ) * U =
        orbitalNumberOp 58 (rotVec Q u) σ * orbitalNumberOp 58 (rotVec Q v) τ := by
    calc
      Uᴴ * (orbitalNumberOp 58 u σ * orbitalNumberOp 58 v τ) * U
        = Uᴴ * orbitalNumberOp 58 u σ * 1 * orbitalNumberOp 58 v τ * U := by
          simp only [mul_one, Matrix.mul_assoc]
      _ = (Uᴴ * orbitalNumberOp 58 u σ * U) * (Uᴴ * orbitalNumberOp 58 v τ * U) := by
          rw [← hUU]; simp only [Matrix.mul_assoc]
      _ = _ := by rw [hconj u σ, hconj v τ]; rfl
  have h2sum :
      Uᴴ * (∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        (dfthc.zeta μ ν : ℂ) •
          (orbitalNumberOp 58 (dfthc.chi μ) σ * orbitalNumberOp 58 (dfthc.chi ν) τ)) * U =
      ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        ((rotThc Q hQ_right).zeta μ ν : ℂ) •
          (orbitalNumberOp 58 ((rotThc Q hQ_right).chi μ) σ *
            orbitalNumberOp 58 ((rotThc Q hQ_right).chi ν) τ) := by
    simp only [Finset.mul_sum, Finset.sum_mul, mul_smul_comm, smul_mul_assoc]
    refine Finset.sum_congr rfl fun σ _ ↦ Finset.sum_congr rfl fun τ _ ↦
      Finset.sum_congr rfl fun μ _ ↦ Finset.sum_congr rfl fun ν _ ↦ ?_
    have hchi_μ : dfthc.chi μ = leafVector μ := rfl
    have hchi_ν : dfthc.chi ν = leafVector ν := rfl
    have hrchi_μ : (rotThc Q hQ_right).chi μ = rotVec Q (leafVector μ) := rfl
    have hrchi_ν : (rotThc Q hQ_right).chi ν = rotVec Q (leafVector ν) := rfl
    have hzeta : (rotThc Q hQ_right).zeta μ ν = dfthc.zeta μ ν := rfl
    rw [hchi_μ, hchi_ν, hrchi_μ, hrchi_ν, hzeta, hpair]
  have h2 : Uᴴ * ((2 : ℂ)⁻¹ • ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        (dfthc.zeta μ ν : ℂ) •
          (orbitalNumberOp 58 (dfthc.chi μ) σ * orbitalNumberOp 58 (dfthc.chi ν) τ)) * U =
      (2 : ℂ)⁻¹ • ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        ((rotThc Q hQ_right).zeta μ ν : ℂ) •
          (orbitalNumberOp 58 ((rotThc Q hQ_right).chi μ) σ *
            orbitalNumberOp 58 ((rotThc Q hQ_right).chi ν) τ) := by
    rw [mul_smul_comm, smul_mul_assoc, h2sum]
  rw [thcHamiltonian, thcHamiltonian, mul_add, add_mul, h1, h2]

lemma state63_dfthc_of_rotThc {Q : Matrix (Fin 58) (Fin 58) ℝ}
    (hQ : Qᵀ * Q = 1) (hQ_right : Q * Qᵀ = 1)
    {ψ₀ : Fin (2 ^ (2 * 58)) → ℂ} {E : ℝ}
    (hproj₀ : electronSectorProjector (2 * 58) 63 *ᵥ ψ₀ = ψ₀)
    (hnorm₀ : ∑ i, Complex.normSq (ψ₀ i) = 1)
    (henergy₀ : (star ψ₀ ⬝ᵥ (thcHamiltonian (rotThc Q hQ_right) *ᵥ ψ₀)).re ≤ E) :
    ∃ ψ : Fin (2 ^ (2 * 58)) → ℂ,
      electronSectorProjector (2 * 58) 63 *ᵥ ψ = ψ ∧
      (∑ i, Complex.normSq (ψ i) = 1) ∧
      (star ψ ⬝ᵥ (thcHamiltonian dfthc *ᵥ ψ)).re ≤ E := by
  obtain ⟨U, hU1, hU2, hUsec, hUconj⟩ := exists_fermionic_lift_of_orthogonal 63 Q hQ
  let U_unit : 𝐔[Fin (2 ^ (2 * 58))] :=
    ⟨U, Matrix.mem_unitaryGroup_iff'.mpr hU1⟩
  refine ⟨U *ᵥ ψ₀, ?_, ?_, ?_⟩
  · rw [mulVec_mulVec, ← hUsec, ← mulVec_mulVec, hproj₀]
  · exact (sum_normSq_unitary_mulVec U_unit ψ₀).trans hnorm₀
  · have hH := conj_thcHamiltonian_rotThc hQ_right hU2 hUconj
    have hexp : star (U *ᵥ ψ₀) ⬝ᵥ (thcHamiltonian dfthc *ᵥ (U *ᵥ ψ₀)) =
        star ψ₀ ⬝ᵥ (thcHamiltonian (rotThc Q hQ_right) *ᵥ ψ₀) := by
      calc
        star (U *ᵥ ψ₀) ⬝ᵥ (thcHamiltonian dfthc *ᵥ (U *ᵥ ψ₀))
          = (star ψ₀ ᵥ* Uᴴ) ⬝ᵥ (thcHamiltonian dfthc *ᵥ (U *ᵥ ψ₀)) := by
              rw [Matrix.star_mulVec]
        _ = star ψ₀ ⬝ᵥ (Uᴴ *ᵥ (thcHamiltonian dfthc *ᵥ (U *ᵥ ψ₀))) :=
              (dotProduct_mulVec (star ψ₀) Uᴴ _).symm
        _ = star ψ₀ ⬝ᵥ ((Uᴴ * thcHamiltonian dfthc * U) *ᵥ ψ₀) := by
              simp only [mulVec_mulVec, Matrix.mul_assoc]
        _ = star ψ₀ ⬝ᵥ (thcHamiltonian (rotThc Q hQ_right) *ᵥ ψ₀) := by rw [hH]
    rw [hexp]
    exact henergy₀

/-- Internal Deep helper `rotDetEnergyReal`. -/
noncomputable def rotDetEnergyReal (Q : Matrix (Fin 58) (Fin 58) ℝ) (b : Fin
    (2 * 58) → Bool) :
    ℝ :=
  let obSum : ℝ := ∑ ℓ : Fin 58,
    (fromOffset ((oneBodyWeights.getChunk ℓ).toNat) : ℝ) *
      (occDot b 0 (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ) +
        occDot b 1 (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ))
  let fragSum : ℝ := ∑ r : Fin 9, ∑ c : Fin 14,
    let dOcc : Fin 29 → ℝ := fun b_idx ↦
      occDot b 0 (rotLeafVec Q (leafEquiv (r, b_idx))) (rotLeafVec Q (leafEquiv (r, b_idx))) +
      occDot b 1 (rotLeafVec Q (leafEquiv (r, b_idx))) (rotLeafVec Q (leafEquiv (r, b_idx)))
    let sD : ℝ := ∑ b_idx : Fin 29, (deepInnerInt r c b_idx.val : ℝ) * dOcc b_idx
    let exch : ℝ := ∑ b₁ : Fin 29, (deepInnerInt r c b₁.val : ℝ) *
      ∑ b₂ : Fin 29, (deepInnerInt r c b₂.val : ℝ) *
        (occDot b 0 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) *
          virtDot b 0 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) +
         occDot b 1 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) *
          virtDot b 1 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))))
    ((4 * (deepFragOuterNat r c : ℤ) * deepInnerShiftInt r c : ℤ) : ℝ) * sD +
      ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) * (sD * sD) +
      ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) * exch
  coefficientUnit * obSum + (coefficientUnit / (15360 ^ 2 : ℝ)) * fragSum

lemma re_thcHamiltonian_rotThc_detVec {Q : Matrix (Fin 58) (Fin 58) ℝ}
    (hQ_right : Q * Qᵀ = 1)
    (b : Fin (2 * 58) → Bool) :
    (star (detVec b) ⬝ᵥ (thcHamiltonian (rotThc Q hQ_right) *ᵥ detVec b)).re =
      rotDetEnergyReal Q b := by
  rw [re_thcHamiltonian_detVec_gen (rotThc Q hQ_right) oneBodyEigenvalue (rotOneBodyVec Q)
    (fun μ ↦ ∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ)
    rfl b]
  have hchi (μ : Fin 261) : (rotThc Q hQ_right).chi μ = rotLeafVec Q μ := rfl
  have hzeta (μ ν : Fin 261) :
      (rotThc Q hQ_right).zeta μ ν =
        ∑ r : Fin 9, ∑ c : Fin 14,
          fragmentVector r c μ * fragmentVector r c ν := by
    change (∑ r : Fin 9, ∑ c : Fin 14,
      vecMulVec (fragmentVector r c) (fragmentVector r c)) μ ν = _
    simp [Matrix.sum_apply, vecMulVec_apply]
  simp_rw [hchi, hzeta]
  have h1_frag :
      (∑ μ : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ) *
          (occDot b 0 (rotLeafVec Q μ) (rotLeafVec Q μ) +
            occDot b 1 (rotLeafVec Q μ) (rotLeafVec Q μ))) =
      ∑ r : Fin 9, ∑ c : Fin 14, ∑ b_idx : Fin 29,
        (fragmentShift r c * weight r c b_idx.castSucc) *
          (occDot b 0 (rotLeafVec Q (leafEquiv (r, b_idx)))
              (rotLeafVec Q (leafEquiv (r, b_idx))) +
            occDot b 1 (rotLeafVec Q (leafEquiv (r, b_idx)))
              (rotLeafVec Q (leafEquiv (r, b_idx)))) := by
    simp_rw [Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun r _ ↦ ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun c _ ↦ ?_
    simp_rw [mul_assoc]
    rw [← Finset.mul_sum, deep_sum_leafEquiv_fragmentVector, Finset.mul_sum]
  have h2_frag :
      (∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentVector r c μ * fragmentVector r c ν) *
          (occDot b σ (rotLeafVec Q μ) (rotLeafVec Q μ) *
              occDot b τ (rotLeafVec Q ν) (rotLeafVec Q ν) +
            if σ = τ then occDot b σ (rotLeafVec Q μ) (rotLeafVec Q ν) *
              virtDot b σ (rotLeafVec Q μ) (rotLeafVec Q ν) else 0)) =
      ∑ r : Fin 9, ∑ c : Fin 14, ∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
        (weight r c b₁.castSucc * weight r c b₂.castSucc) *
          ((occDot b 0 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₁))) +
              occDot b 1 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₁)))) *
            (occDot b 0 (rotLeafVec Q (leafEquiv (r, b₂))) (rotLeafVec Q (leafEquiv (r, b₂))) +
              occDot b 1 (rotLeafVec Q (leafEquiv (r, b₂))) (rotLeafVec Q (leafEquiv (r, b₂)))) +
            (occDot b 0 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) *
              virtDot b 0 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) +
             occDot b 1 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) *
              virtDot b 1 (rotLeafVec Q (leafEquiv (r, b₁)))
                (rotLeafVec Q (leafEquiv (r, b₂))))) := by
    rw [sum_prod_swap]
    have hspin (μ ν : Fin 261) :
        (∑ σ : Fin 2, ∑ τ : Fin 2,
          (∑ r : Fin 9, ∑ c : Fin 14, fragmentVector r c μ * fragmentVector r c ν) *
            (occDot b σ (rotLeafVec Q μ) (rotLeafVec Q μ) *
                occDot b τ (rotLeafVec Q ν) (rotLeafVec Q ν) +
              if σ = τ then occDot b σ (rotLeafVec Q μ) (rotLeafVec Q ν) *
                virtDot b σ (rotLeafVec Q μ) (rotLeafVec Q ν) else 0)) =
        ∑ r : Fin 9, ∑ c : Fin 14,
          (fragmentVector r c μ * fragmentVector r c ν) *
            ((occDot b 0 (rotLeafVec Q μ) (rotLeafVec Q μ) +
                occDot b 1 (rotLeafVec Q μ) (rotLeafVec Q μ)) *
              (occDot b 0 (rotLeafVec Q ν) (rotLeafVec Q ν) +
                occDot b 1 (rotLeafVec Q ν) (rotLeafVec Q ν)) +
              (occDot b 0 (rotLeafVec Q μ) (rotLeafVec Q ν) *
                  virtDot b 0 (rotLeafVec Q μ) (rotLeafVec Q ν) +
                occDot b 1 (rotLeafVec Q μ) (rotLeafVec Q ν) *
                  virtDot b 1 (rotLeafVec Q μ) (rotLeafVec Q ν))) := by
      simp_rw [← Finset.mul_sum]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun r _ ↦ ?_
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun c _ ↦ ?_
      congr 1
      have h01 : ((0 : Fin 2) = 1) = False := eq_false (by decide)
      have h10 : ((1 : Fin 2) = 0) = False := eq_false (by decide)
      simp only [Fin.sum_univ_two, Fin.isValue, h01, h10, ↓reduceIte]
      ring
    simp_rw [hspin]
    rw [sum_prod_swap]
    refine Finset.sum_congr rfl fun r _ ↦ Finset.sum_congr rfl fun c _ ↦ ?_
    let M : Fin 261 → Fin 261 → ℝ := fun μ ν ↦
      (occDot b 0 (rotLeafVec Q μ) (rotLeafVec Q μ) +
          occDot b 1 (rotLeafVec Q μ) (rotLeafVec Q μ)) *
        (occDot b 0 (rotLeafVec Q ν) (rotLeafVec Q ν) +
          occDot b 1 (rotLeafVec Q ν) (rotLeafVec Q ν)) +
        (occDot b 0 (rotLeafVec Q μ) (rotLeafVec Q ν) *
            virtDot b 0 (rotLeafVec Q μ) (rotLeafVec Q ν) +
          occDot b 1 (rotLeafVec Q μ) (rotLeafVec Q ν) *
            virtDot b 1 (rotLeafVec Q μ) (rotLeafVec Q ν))
    change (∑ μ : Fin 261, ∑ ν : Fin 261,
        (fragmentVector r c μ * fragmentVector r c ν) * M μ ν) =
      ∑ b₁ : Fin 29, ∑ b₂ : Fin 29, (weight r c b₁.castSucc * weight r c b₂.castSucc) *
        M (leafEquiv (r, b₁)) (leafEquiv (r, b₂))
    have hinner_ν (μ : Fin 261) :
        (∑ ν : Fin 261, (fragmentVector r c μ * fragmentVector r c ν) * M μ ν) =
          fragmentVector r c μ *
            ∑ b₂ : Fin 29, weight r c b₂.castSucc * M μ (leafEquiv (r, b₂)) := by
      simp_rw [mul_assoc]
      rw [← Finset.mul_sum, deep_sum_leafEquiv_fragmentVector]
    simp_rw [hinner_ν]
    rw [deep_sum_leafEquiv_fragmentVector]
    refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun b₂ _ ↦ by ring
  rw [h1_frag, h2_frag]
  unfold rotDetEnergyReal oneBodyEigenvalue
  simp_rw [deep_fragmentShift_mul_weight, deep_weight_mul_weight]
  have h1_ob :
      (∑ ℓ : Fin 58, (fromOffset ((oneBodyWeights.getChunk ℓ).toNat) : ℝ) * coefficientUnit *
        (occDot b 0 (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ) +
          occDot b 1 (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ))) =
      coefficientUnit * ∑ ℓ : Fin 58, (fromOffset ((oneBodyWeights.getChunk ℓ).toNat) : ℝ) *
        (occDot b 0 (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ) +
          occDot b 1 (rotOneBodyVec Q ℓ) (rotOneBodyVec Q ℓ)) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun ℓ _ ↦ by ring
  rw [h1_ob, add_assoc]
  refine congr_arg₂ (· + ·) rfl ?_
  rw [Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
  refine Finset.sum_congr rfl fun r _ ↦ ?_
  rw [Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
  refine Finset.sum_congr rfl fun c _ ↦ ?_
  let dOcc : Fin 29 → ℝ := fun b_idx ↦
    occDot b 0 (rotLeafVec Q (leafEquiv (r, b_idx))) (rotLeafVec Q (leafEquiv (r, b_idx))) +
    occDot b 1 (rotLeafVec Q (leafEquiv (r, b_idx))) (rotLeafVec Q (leafEquiv (r, b_idx)))
  let K : Fin 29 → Fin 29 → ℝ := fun b₁ b₂ ↦
    occDot b 0 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) *
      virtDot b 0 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) +
    occDot b 1 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂))) *
      virtDot b 1 (rotLeafVec Q (leafEquiv (r, b₁))) (rotLeafVec Q (leafEquiv (r, b₂)))
  let m : Fin 29 → ℝ := fun b_idx ↦ (deepInnerInt r c b_idx.val : ℝ)
  change (∑ b_idx : Fin 29,
      ((deepInnerShiftInt r c * deepInnerInt r c b_idx.val : ℤ) : ℝ) *
        (4 * (deepFragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) * dOcc b_idx) +
    2⁻¹ * (∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
      ((deepInnerInt r c b₁.val * deepInnerInt r c b₂.val : ℤ) : ℝ) *
        (4 * (deepFragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) *
        (dOcc b₁ * dOcc b₂ + K b₁ b₂)) =
    coefficientUnit / (15360 ^ 2 : ℝ) *
      (((4 * (deepFragOuterNat r c : ℤ) * deepInnerShiftInt r c : ℤ) : ℝ) *
          (∑ b_idx : Fin 29, m b_idx * dOcc b_idx) +
        ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
          ((∑ b_idx : Fin 29, m b_idx * dOcc b_idx) *
            (∑ b_idx : Fin 29, m b_idx * dOcc b_idx)) +
        ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
          (∑ b₁ : Fin 29, m b₁ * ∑ b₂ : Fin 29, m b₂ * K b₁ b₂))
  have hs1 :
      (∑ b_idx : Fin 29,
        ((deepInnerShiftInt r c * deepInnerInt r c b_idx.val : ℤ) : ℝ) *
          (4 * (deepFragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) * dOcc b_idx) =
      coefficientUnit / (15360 ^ 2 : ℝ) *
        (((4 * (deepFragOuterNat r c : ℤ) * deepInnerShiftInt r c : ℤ) : ℝ) *
          ∑ b_idx : Fin 29, m b_idx * dOcc b_idx) := by
    rw [Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun b_idx _ ↦ ?_
    simp only [m]; push_cast; ring
  have hs2 :
      2⁻¹ * (∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
        ((deepInnerInt r c b₁.val * deepInnerInt r c b₂.val : ℤ) : ℝ) *
          (4 * (deepFragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) *
          (dOcc b₁ * dOcc b₂ + K b₁ b₂)) =
      coefficientUnit / (15360 ^ 2 : ℝ) *
        (((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
          ((∑ b_idx : Fin 29, m b_idx * dOcc b_idx) * (∑ b_idx : Fin 29, m b_idx * dOcc b_idx)) +
        ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
          (∑ b₁ : Fin 29, m b₁ * ∑ b₂ : Fin 29, m b₂ * K b₁ b₂)) := by
    have hsq_sum :
        (∑ b_idx : Fin 29, m b_idx * dOcc b_idx) * (∑ b_idx : Fin 29, m b_idx * dOcc b_idx) =
          ∑ b₁ : Fin 29, ∑ b₂ : Fin 29, m b₁ * m b₂ * (dOcc b₁ * dOcc b₂) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun b₂ _ ↦ by ring
    have hexch_sum :
        (∑ b₁ : Fin 29, m b₁ * ∑ b₂ : Fin 29, m b₂ * K b₁ b₂) =
          ∑ b₁ : Fin 29, ∑ b₂ : Fin 29, m b₁ * m b₂ * K b₁ b₂ := by
      refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun b₂ _ ↦ by ring
    rw [hsq_sum, hexch_sum, mul_add]
    simp_rw [Finset.mul_sum]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun b₂ _ ↦ ?_
    simp only [m]; push_cast; ring
  rw [hs1, hs2]
  ring

/-! ## Part 3: Cayley Orthogonality & Column Residual Soundness -/

private lemma dotProduct_skew_self {N : ℕ} {K : Matrix (Fin N) (Fin N) ℝ} (hK : Kᵀ = -K)
    (w : Fin N → ℝ) : w ⬝ᵥ (K *ᵥ w) = 0 := by
  have h1 : w ⬝ᵥ (K *ᵥ w) = -(w ⬝ᵥ (K *ᵥ w)) := by
    calc
      w ⬝ᵥ (K *ᵥ w) = (w ᵥ* K) ⬝ᵥ w := Matrix.dotProduct_mulVec w K w
      _ = (Kᵀ *ᵥ w) ⬝ᵥ w := by rw [Matrix.mulVec_transpose]
      _ = ((-K) *ᵥ w) ⬝ᵥ w := by rw [hK]
      _ = -((K *ᵥ w) ⬝ᵥ w) := by rw [Matrix.neg_mulVec, neg_dotProduct]
      _ = -(w ⬝ᵥ (K *ᵥ w)) := by rw [dotProduct_comm]
  linarith

private lemma sq_le_sum_sq_one_add_skew {N : ℕ} {K : Matrix (Fin N) (Fin N) ℝ} (hK : Kᵀ = -K)
    (w : Fin N → ℝ) (i : Fin N) :
    (w i) ^ 2 ≤ ∑ p : Fin N, (((1 + K) *ᵥ w) p) ^ 2 := by
  have hdot : ∑ p : Fin N, w p * (K *ᵥ w) p = 0 := dotProduct_skew_self hK w
  have hexp : ∑ p : Fin N, (((1 + K) *ᵥ w) p) ^ 2 =
      (∑ p : Fin N, (w p) ^ 2) + 2 * (∑ p : Fin N, w p * (K *ᵥ w) p) +
        (∑ p : Fin N, ((K *ᵥ w) p) ^ 2) := by
    simp only [Matrix.add_mulVec, Matrix.one_mulVec, Pi.add_apply]
    rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun p _ ↦ by ring
  have hi : (w i) ^ 2 ≤ ∑ p : Fin N, (w p) ^ 2 :=
    Finset.single_le_sum (fun p _ ↦ sq_nonneg (w p)) (Finset.mem_univ i)
  have hK_nn : 0 ≤ ∑ p : Fin N, ((K *ᵥ w) p) ^ 2 :=
    Finset.sum_nonneg fun p _ ↦ sq_nonneg _
  linarith

private lemma exists_cayley_orthogonal {N : ℕ} (K : Matrix (Fin N) (Fin N) ℝ) (hK : Kᵀ = -K)
    (sgn : Fin N → Bool) :
    ∃ Q₀ Q : Matrix (Fin N) (Fin N) ℝ,
      Qᵀ * Q = 1 ∧ Q * Qᵀ = 1 ∧
      (∀ i j : Fin N, Q i j = (if sgn j then -1 else 1) * Q₀ i j) ∧
      (∀ j : Fin N, (1 + K) *ᵥ (fun i ↦ Q₀ i j) = fun i ↦ (1 - K) i j) := by
  let f : (Fin N → ℝ) →ₗ[ℝ] (Fin N → ℝ) := Matrix.toLin' (1 + K)
  have hinj : Function.Injective f := by
    intro u v huv
    have h0 : (1 + K) *ᵥ (u - v) = 0 := by
      have hsub : f (u - v) = 0 := by rw [map_sub, huv, sub_self]
      exact hsub
    ext i
    have hsq := sq_le_sum_sq_one_add_skew hK (u - v) i
    rw [h0] at hsq
    simp only [Pi.zero_apply, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow,
      Finset.sum_const_zero] at hsq
    have hsq0 : ((u - v) i) ^ 2 = 0 := le_antisymm hsq (sq_nonneg _)
    have hzero : (u - v) i = 0 := by nlinarith
    exact sub_eq_zero.mp hzero
  have hsurj : Function.Surjective f := LinearMap.injective_iff_surjective.mp hinj
  choose rCol hrCol using fun j : Fin N ↦ hsurj (fun i ↦ (1 : Matrix (Fin N) (Fin N) ℝ) i j)
  let R : Matrix (Fin N) (Fin N) ℝ := fun i j ↦ rCol j i
  have hR_right : (1 + K) * R = 1 := by
    ext i j
    exact congrFun (hrCol j) i
  have hR_left : R * (1 + K) = 1 := mul_eq_one_symm hR_right
  let Q₀ : Matrix (Fin N) (Fin N) ℝ := R * (1 - K)
  have hcomm_K : (1 + K) * (1 - K) = (1 - K) * (1 + K) := by
    simp only [add_mul, sub_mul, mul_add, mul_sub, one_mul, mul_one]
    abel
  have hcomm_R : (1 - K) * R = R * (1 - K) := by
    have h2 : (1 + K) * ((1 - K) * R) = 1 - K := by
      rw [← Matrix.mul_assoc, hcomm_K, Matrix.mul_assoc, hR_right, mul_one]
    calc
      (1 - K) * R = (R * (1 + K)) * ((1 - K) * R) := by rw [hR_left, one_mul]
      _ = R * ((1 + K) * ((1 - K) * R)) := Matrix.mul_assoc _ _ _
      _ = R * (1 - K) := by rw [h2]
  have h1pK_T : (1 + K)ᵀ = 1 - K := by
    rw [Matrix.transpose_add, Matrix.transpose_one, hK, sub_eq_add_neg]
  have h1mK_T : (1 - K)ᵀ = 1 + K := by
    rw [Matrix.transpose_sub, Matrix.transpose_one, hK, sub_neg_eq_add]
  have hRT_right : Rᵀ * (1 - K) = 1 := by
    rw [← h1pK_T, ← Matrix.transpose_mul, hR_right, Matrix.transpose_one]
  have hQ0_orth : Q₀ᵀ * Q₀ = 1 := by
    dsimp only [Q₀]
    rw [Matrix.transpose_mul, h1mK_T, ← hcomm_R]
    calc
      (1 + K) * Rᵀ * ((1 - K) * R)
        = (1 + K) * (Rᵀ * (1 - K)) * R := by simp only [Matrix.mul_assoc]
      _ = 1 := by rw [hRT_right, mul_one, hR_right]
  let Q : Matrix (Fin N) (Fin N) ℝ := fun i j ↦ (if sgn j then -1 else 1) * Q₀ i j
  have hQ_orth : Qᵀ * Q = 1 := by
    ext j₁ j₂
    have hsum : (Qᵀ * Q) j₁ j₂ =
        (if sgn j₁ then (-1 : ℝ) else 1) * (if sgn j₂ then (-1 : ℝ) else 1) *
          (Q₀ᵀ * Q₀) j₁ j₂ := by
      change (∑ i, ((if sgn j₁ then -1 else 1) * Q₀ i j₁) *
          ((if sgn j₂ then -1 else 1) * Q₀ i j₂)) =
        (if sgn j₁ then (-1 : ℝ) else 1) * (if sgn j₂ then (-1 : ℝ) else 1) *
          ∑ i, Q₀ i j₁ * Q₀ i j₂
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ ↦ by ring
    rw [hsum, hQ0_orth]
    by_cases hj : j₁ = j₂
    · subst hj
      cases sgn j₁ <;> simp
    · simp [Matrix.one_apply_ne hj]
  refine ⟨Q₀, Q, hQ_orth, mul_eq_one_symm hQ_orth, fun _ _ ↦ rfl, fun j ↦ ?_⟩
  ext i
  change ((1 + K) * (R * (1 - K))) i j = (1 - K) i j
  rw [← Matrix.mul_assoc, hR_right, one_mul]

private lemma orth_entry_abs_le_one {N : ℕ} {Q : Matrix (Fin N) (Fin N) ℝ} (hQ : Qᵀ * Q = 1)
    (i j : Fin N) : |Q i j| ≤ 1 := by
  have hdiag : ∑ p : Fin N, (Q p j) ^ 2 = 1 := by
    have h := congrFun (congrFun hQ j) j
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply_eq, ← sq] at h
    exact h
  have hle : (Q i j) ^ 2 ≤ 1 := by
    rw [← hdiag]
    exact Finset.single_le_sum (fun p _ ↦ sq_nonneg (Q p j)) (Finset.mem_univ i)
  exact abs_le.mpr ⟨by nlinarith, by nlinarith⟩

private lemma sumList_replicate : ∀ (n c : ℕ), sumList (List.replicate n c) = n * c
  | 0, _ => by simp [sumList_nil]
  | n + 1, c => by
    rw [List.replicate_succ, sumList_cons, sumList_replicate n c]
    simp only [Nat.add_eq]
    ring

private lemma sumList_eq_range : ∀ (xs : List ℕ),
    (sumList xs : ℝ) = ∑ k ∈ Finset.range xs.length, (xs.getD k 0 : ℝ)
  | [] => by simp [sumList_nil]
  | x :: xs => by
    rw [sumList_cons, List.length_cons, Finset.sum_range_succ']
    simp only [Nat.add_eq, Nat.cast_add, List.getD_cons_zero, List.getD_cons_succ,
      sumList_eq_range xs]
    ring

private lemma dotRaw_eq_range : ∀ (xs ys : List ℕ), xs.length = ys.length →
    (dotRaw xs ys : ℝ) = ∑ k ∈ Finset.range xs.length, (xs.getD k 0 : ℝ) * (ys.getD k 0 : ℝ)
  | [], [], _ => by simp [dotRaw_nil_left]
  | _ :: _, [], h => by simp at h
  | [], _ :: _, h => by simp at h
  | x :: xs, y :: ys, h => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h
    rw [dotRaw_cons, List.length_cons, Finset.sum_range_succ']
    simp only [Nat.add_eq, Nat.mul_eq, Nat.cast_add, Nat.cast_mul,
      List.getD_cons_zero, List.getD_cons_succ, dotRaw_eq_range xs ys h]
    ring

/-- Internal Deep certificate helper `cayleySK`. -/
def cayleySK : ℕ := 10000000
/-- Internal Deep certificate helper `cayleyKOff`. -/
def cayleyKOff : ℕ := 250000000
/-- Internal Deep certificate helper `cayleyTwoKOff`. -/
def cayleyTwoKOff : ℕ := 500000000
/-- Internal Deep certificate helper `cayleySQ14`. -/
def cayleySQ14 : ℕ := 100000000000000
/-- Internal Deep certificate helper `cayleyZQ14`. -/
def cayleyZQ14 : ℕ := 200000000000000
/-- Internal Deep certificate helper `cayleyTwoZQ14`. -/
def cayleyTwoZQ14 : ℕ := 400000000000000
/-- Internal Deep certificate helper `cayleyPosConst`. -/
def cayleyPosConst : ℕ := 2950000000000000000000000
/-- Internal Deep certificate helper `cayleyNegConst`. -/
def cayleyNegConst : ℕ := 27000000000000000000000
/-- Internal Deep certificate helper `cayleyDiagTerm`. -/
def cayleyDiagTerm : ℕ := 1000000000000000000000
/-- Internal Deep certificate helper `cayleyErr14`. -/
def cayleyErr14 : ℕ := 26
/-- Internal Deep certificate helper `cayleyErrSqBound`. -/
def cayleyErrSqBound : ℕ := 67600000000000000

private noncomputable def cayleyKMat (ks : List (List ℕ)) : Matrix (Fin 58) (Fin 58) ℝ :=
  fun i j ↦
    (((ks.getD i.val []).getD j.val 0 : ℝ) - ((ks.getD j.val []).getD i.val 0 : ℝ)) /
      (2 * (cayleySK : ℝ))

private lemma cayleyKMat_transpose (ks : List (List ℕ)) :
    (cayleyKMat ks)ᵀ = -cayleyKMat ks := by
  ext i j
  simp only [cayleyKMat, Matrix.transpose_apply, Matrix.neg_apply]
  ring


private lemma absDiffNat_sq (a b : ℕ) :
    ((absDiffNat a b : ℕ) : ℝ) ^ 2 = ((a : ℝ) - (b : ℝ)) ^ 2 := by
  unfold absDiffNat
  split_ifs with h
  · have hle := Nat.le_of_ble_eq_true h
    simp only [Nat.sub_eq, Nat.cast_sub hle]; ring
  · have hle : b ≤ a := by
      have : ¬(a ≤ b) := fun hle ↦ h (Nat.ble_eq_true_of_le hle); omega
    simp only [Nat.sub_eq, Nat.cast_sub hle]

/-- Internal Deep certificate helper `checkSkewRowIdx`. -/
def checkSkewRowIdx (ks : List (List ℕ)) (i : ℕ) : ℕ → List ℕ → Bool
  | _, [] => true
  | k, x :: xs =>
    Nat.beq (Nat.add x ((ks.getD k []).getD i 0)) cayleyTwoKOff &&
      checkSkewRowIdx ks i (Nat.add k 1) xs

private lemma checkSkewRowIdx_sound (ks : List (List ℕ)) (i : ℕ) :
    ∀ (k₀ : ℕ) (xs : List ℕ), checkSkewRowIdx ks i k₀ xs = true →
      ∀ idx < xs.length, xs.getD idx 0 + (ks.getD (k₀ + idx) []).getD i 0 = cayleyTwoKOff
  | _, [], _, _, hlt => by simp at hlt
  | k₀, x :: xs, hok, idx, hlt => by
    obtain ⟨h1, h2⟩ := Bool.and_eq_true_iff.mp hok
    cases idx with
    | zero =>
      simpa [Nat.add_eq] using Nat.beq_eq.mp h1
    | succ m =>
      have hm := checkSkewRowIdx_sound ks i (Nat.add k₀ 1) xs h2 m (by simpa using hlt)
      simpa [Nat.add_eq, Nat.add_assoc, Nat.add_comm 1 m] using hm

/-- Internal Deep certificate helper `checkSkewAllGo`. -/
def checkSkewAllGo (ks : List (List ℕ)) : ℕ → List (List ℕ) → Bool
  | _, [] => true
  | i, r :: rs =>
    Nat.beq r.length 58 && checkSkewRowIdx ks i 0 r &&
      checkSkewAllGo ks (Nat.add i 1) rs

private lemma checkSkewAllGo_sound (ks : List (List ℕ)) :
    ∀ (i₀ : ℕ) (rs : List (List ℕ)), checkSkewAllGo ks i₀ rs = true →
      ∀ a < rs.length, (rs.getD a []).length = 58 ∧
        ∀ b < 58, (rs.getD a []).getD b 0 + (ks.getD b []).getD (i₀ + a) 0 = cayleyTwoKOff
  | _, [], _, _, ha => by simp at ha
  | i₀, r :: rs, hok, a, ha => by
    obtain ⟨hab, hrest⟩ := Bool.and_eq_true_iff.mp hok
    obtain ⟨hlen, hrow⟩ := Bool.and_eq_true_iff.mp hab
    have hrlen : r.length = 58 := Nat.beq_eq.mp hlen
    cases a with
    | zero =>
      refine ⟨hrlen, fun b hb ↦ ?_⟩
      simpa using checkSkewRowIdx_sound ks i₀ 0 r hrow b (hrlen.symm ▸ hb)
    | succ m =>
      obtain ⟨hl, hs⟩ := checkSkewAllGo_sound ks (Nat.add i₀ 1) rs hrest m (by simpa using ha)
      refine ⟨hl, fun b hb ↦ ?_⟩
      simpa [Nat.add_eq, Nat.add_assoc, Nat.add_comm 1 m] using hs b hb

/-- Internal Deep certificate helper `prepKRows`. -/
def prepKRows : List (List ℕ) → List (List ℕ × ℕ)
  | [] => []
  | r :: rs =>
    strictNatList r fun rf ↦
    strictNat (Nat.add (Nat.mul cayleyZQ14 (sumList rf)) cayleyNegConst) fun nb ↦
      (rf, nb) :: prepKRows rs

private lemma prepKRows_eq : ∀ (rs : List (List ℕ)),
    prepKRows rs = rs.map (fun r ↦ (r, Nat.add (Nat.mul cayleyZQ14 (sumList r)) cayleyNegConst))
  | [] => rfl
  | r :: rs => by simp [prepKRows, strictNatList_eq, strictNat_eq, prepKRows_eq rs]

/-- Internal Deep certificate helper `cayleyColResSqGo`. -/
def cayleyColResSqGo (j kOffSumC : ℕ) (c14 : List ℕ) :
    ℕ → List (List ℕ × ℕ) → List ℕ → List ℕ → ℕ → ℕ
  | _, [], _, _, acc => acc
  | i, (uRow, negBase) :: prs, ci :: cs, uji :: ujs, acc =>
    let posR := Nat.add (Nat.add (dotRaw uRow c14) cayleyPosConst) (Nat.mul cayleySK ci)
    let neg0 := Nat.add (Nat.add negBase kOffSumC) (Nat.mul cayleySQ14 uji)
    let negR := if Nat.beq i j then Nat.add neg0 cayleyDiagTerm else neg0
    let r := absDiffNat posR negR
    strictNat (Nat.add acc (Nat.mul r r)) fun acc1 ↦
      cayleyColResSqGo j kOffSumC c14 (Nat.add i 1) prs cs ujs acc1
  | _, _, _, _, acc => acc

private lemma cayleyColResSqGo_eq (j kOffSumC : ℕ) (c14 : List ℕ) :
    ∀ (i₀ : ℕ) (prs : List (List ℕ × ℕ)) (cs ujs : List ℕ) (acc : ℕ),
      prs.length = cs.length → cs.length = ujs.length →
      (cayleyColResSqGo j kOffSumC c14 i₀ prs cs ujs acc : ℝ) =
        (acc : ℝ) + ∑ t ∈ Finset.range cs.length,
          (((dotRaw (prs.getD t ([], 0)).1 c14 : ℝ) + (cayleyPosConst : ℝ) +
              (cayleySK : ℝ) * (cs.getD t 0 : ℝ)) -
            (((prs.getD t ([], 0)).2 : ℝ) + (kOffSumC : ℝ) +
              (cayleySQ14 : ℝ) * (ujs.getD t 0 : ℝ) +
              if i₀ + t = j then (cayleyDiagTerm : ℝ) else 0)) ^ 2
  | _, [], [], [], acc, _, _ => by simp [cayleyColResSqGo]
  | _, _ :: _, [], _, _, h1, _ => by simp at h1
  | _, [], _ :: _, _, _, h1, _ => by simp at h1
  | _, _ :: _, _ :: _, [], _, _, h2 => by simp at h2
  | i₀, (uRow, negBase) :: prs, ci :: cs, uji :: ujs, acc, h1, h2 => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h1 h2
    unfold cayleyColResSqGo
    simp only [strictNat_eq]
    rw [cayleyColResSqGo_eq j kOffSumC c14 (Nat.add i₀ 1) prs cs ujs _ h1 h2]
    rw [List.length_cons, Finset.sum_range_succ']
    set posR := Nat.add (Nat.add (dotRaw uRow c14) cayleyPosConst) (Nat.mul cayleySK ci)
    set neg0 := Nat.add (Nat.add negBase kOffSumC) (Nat.mul cayleySQ14 uji)
    set negR := if Nat.beq i₀ j then Nat.add neg0 cayleyDiagTerm else neg0
    have hr2 : ((Nat.mul (absDiffNat posR negR) (absDiffNat posR negR) : ℕ) : ℝ) =
        ((posR : ℝ) - (negR : ℝ)) ^ 2 := by
      rw [Nat.mul_eq, Nat.cast_mul, ← sq, absDiffNat_sq]
    have hnegR : (negR : ℝ) = (negBase : ℝ) + (kOffSumC : ℝ) +
        (cayleySQ14 : ℝ) * (uji : ℝ) + if i₀ + 0 = j then (cayleyDiagTerm : ℝ) else 0 := by
      dsimp only [negR, neg0]
      by_cases hij : i₀ = j
      · subst hij; simp [Nat.add_eq, add_assoc]
      · cases hbeq : Nat.beq i₀ j with
        | true => exact absurd (Nat.beq_eq.mp hbeq) hij
        | false => simp [hij, Nat.add_eq, add_assoc]
    have hposR : (posR : ℝ) =
        (dotRaw uRow c14 : ℝ) + (cayleyPosConst : ℝ) + (cayleySK : ℝ) * (ci : ℝ) := by
      simp [posR, Nat.add_eq, Nat.mul_eq, add_assoc]
    have htail : (∑ x ∈ Finset.range cs.length,
        (((dotRaw (((uRow, negBase) :: prs).getD (x + 1) ([], 0)).1 c14 : ℝ) +
            (cayleyPosConst : ℝ) + (cayleySK : ℝ) * ((ci :: cs).getD (x + 1) 0 : ℝ)) -
          ((((uRow, negBase) :: prs).getD (x + 1) ([], 0)).2 + (kOffSumC : ℝ) +
            (cayleySQ14 : ℝ) * ((uji :: ujs).getD (x + 1) 0 : ℝ) +
            if i₀ + (x + 1) = j then (cayleyDiagTerm : ℝ) else 0)) ^ 2) =
        ∑ t ∈ Finset.range cs.length,
          (((dotRaw (prs.getD t ([], 0)).1 c14 : ℝ) + (cayleyPosConst : ℝ) +
              (cayleySK : ℝ) * (cs.getD t 0 : ℝ)) -
            (((prs.getD t ([], 0)).2 : ℝ) + (kOffSumC : ℝ) +
              (cayleySQ14 : ℝ) * (ujs.getD t 0 : ℝ) +
              if Nat.add i₀ 1 + t = j then (cayleyDiagTerm : ℝ) else 0)) ^ 2 := by
      refine Finset.sum_congr rfl fun t _ ↦ ?_
      simp [Nat.add_eq, Nat.add_assoc, Nat.add_comm 1 t]
    rw [htail]
    simp only [Nat.add_eq, Nat.cast_add, List.getD_cons_zero]
    rw [hr2, hposR, hnegR]
    ring

/-- Internal Deep certificate helper `checkDownscaleCayleyCol`. -/
def checkDownscaleCayleyCol (flipJ : Bool) : List ℕ → List ℕ → Bool
  | [], [] => true
  | x :: xs, certK :: cs =>
    let v14 := if flipJ then Nat.sub cayleyTwoZQ14 x else x
    let lo12 := Nat.div (Nat.sub v14 cayleyErr14) 100
    (if flipJ then Nat.ble x cayleyTwoZQ14 else true) &&
      Nat.ble cayleyErr14 v14 &&
      Nat.ble bScale lo12 &&
      Nat.ble lo12 (Nat.mul 3 bScale) &&
      Nat.beq lo12 certK &&
      checkDownscaleCayleyCol flipJ xs cs
  | _, _ => false

private lemma checkDownscaleCayleyCol_sound (flipJ : Bool) :
    ∀ {xs cs : List ℕ} {qs : List ℝ},
      List.Forall₂ (fun (x : ℕ) (q : ℝ) ↦
        |q| ≤ 1 ∧ |((x : ℝ) - (cayleyZQ14 : ℝ)) -
          (if flipJ then -q else q) * (cayleySQ14 : ℝ)| ≤ 26) xs qs →
      checkDownscaleCayleyCol flipJ xs cs = true →
      ValidZ2List cs (List.replicate cs.length 2) qs ∧ cs.length = xs.length
  | [], [], [], .nil, _ => ⟨.nil, rfl⟩
  | [], _ :: _, [], .nil, hok => by simp [checkDownscaleCayleyCol] at hok
  | _ :: _, [], _ :: _, .cons _ _, hok => by simp [checkDownscaleCayleyCol] at hok
  | x :: xs, certK :: cs, q :: qs, .cons ⟨hq_abs, hq_err⟩ htl, hok => by
    unfold checkDownscaleCayleyCol at hok
    obtain ⟨h12345, hrest⟩ := Bool.and_eq_true_iff.mp hok
    obtain ⟨h1234, hb_eq⟩ := Bool.and_eq_true_iff.mp h12345
    obtain ⟨h123, hb_hi⟩ := Bool.and_eq_true_iff.mp h1234
    obtain ⟨h12, hb_lo⟩ := Bool.and_eq_true_iff.mp h123
    obtain ⟨hb_flip, hb_err⟩ := Bool.and_eq_true_iff.mp h12
    obtain ⟨ih_v, ih_l⟩ := checkDownscaleCayleyCol_sound flipJ htl hrest
    set v14 := if flipJ then Nat.sub cayleyTwoZQ14 x else x
    set lo12 := Nat.div (Nat.sub v14 cayleyErr14) 100
    have hcert : lo12 = certK := Nat.beq_eq.mp hb_eq
    subst hcert
    have hv_ge : cayleyErr14 ≤ v14 := Nat.le_of_ble_eq_true hb_err
    have hlo_ge : bScale ≤ lo12 := Nat.le_of_ble_eq_true hb_lo
    have hlo_le : lo12 ≤ 3 * bScale := by simpa [Nat.mul_eq] using Nat.le_of_ble_eq_true hb_hi
    obtain ⟨herr_l, herr_r⟩ := abs_le.mp hq_err
    have hv14_bounds :
        (v14 : ℝ) - 26 ≤ q * (cayleySQ14 : ℝ) + (cayleyZQ14 : ℝ) ∧
        q * (cayleySQ14 : ℝ) + (cayleyZQ14 : ℝ) ≤ (v14 : ℝ) + 26 := by
      cases flipJ with
      | false =>
        simp only [v14, Bool.false_eq_true, ↓reduceIte] at herr_l herr_r ⊢
        exact ⟨by linarith, by linarith⟩
      | true =>
        have hx_le : x ≤ cayleyTwoZQ14 := Nat.le_of_ble_eq_true (by simpa using hb_flip)
        have hvR : (v14 : ℝ) = (cayleyTwoZQ14 : ℝ) - (x : ℝ) := by
          dsimp only [v14]; simp [Nat.sub_eq, Nat.cast_sub hx_le]
        simp only [↓reduceIte] at herr_l herr_r
        rw [hvR]
        simp only [cayleyTwoZQ14, cayleyZQ14, Nat.cast_ofNat] at herr_l herr_r ⊢
        exact ⟨by linarith, by linarith⟩
    have hdiv_lo : (lo12 : ℝ) * 100 ≤ ((v14 - 26 : ℕ) : ℝ) := by
      change (((v14 - 26) / 100 : ℕ) : ℝ) * 100 ≤ ((v14 - 26 : ℕ) : ℝ)
      exact nat_div_le_real
    have hdiv_hi : (v14 : ℝ) + 26 ≤ ((lo12 : ℝ) + 2) * 100 := by
      have h1 : v14 - 26 ≤ lo12 * 100 + 99 := by
        have hd := Nat.div_add_mod (v14 - 26) 100
        have hm := Nat.mod_lt (v14 - 26) (by decide : 0 < 100)
        have hl : lo12 = (v14 - 26) / 100 := rfl
        omega
      have h2 : v14 + 26 ≤ (lo12 + 2) * 100 := by
        simp only [cayleyErr14] at hv_ge; omega
      exact_mod_cast h2
    rw [Nat.cast_sub (by simpa [cayleyErr14] using hv_ge)] at hdiv_lo
    have hhd : ValidZ2 lo12 2 q := by
      refine ⟨hlo_ge, hlo_le, hq_abs, ?_, ?_⟩
      · simp only [cayleySQ14, cayleyZQ14, bScale, zOff2, Nat.cast_ofNat] at hv14_bounds hdiv_lo ⊢
        linarith
      · simp only [cayleySQ14, cayleyZQ14, bScale, zOff2, Nat.cast_ofNat] at hv14_bounds hdiv_hi ⊢
        linarith
    exact ⟨.cons hhd ih_v, by simp [ih_l]⟩

/-- Internal Deep certificate helper `checkCayleyColsGo`. -/
def checkCayleyColsGo (pKRs : List (List ℕ × ℕ)) :
    ℕ → List (List ℕ) → List (List ℕ) → List Bool → List (List ℕ) → Bool
  | 0, _, _, _, _ => true
  | rem + 1, qCol :: qRest, kRowJ :: kRest, flipJ :: fRest, certCol :: cRest =>
    strictNatList qCol fun c14 ↦
    strictNatList kRowJ fun uRowJ ↦
      Nat.beq c14.length 58 &&
        (strictNat (Nat.mul cayleyKOff (sumList c14)) fun kOffSumC ↦
          let rsq := cayleyColResSqGo (Nat.sub 58 (rem + 1)) kOffSumC c14 0 pKRs c14 uRowJ 0
          Nat.ble rsq cayleyErrSqBound &&
            checkDownscaleCayleyCol flipJ c14 certCol) &&
        checkCayleyColsGo pKRs rem qRest kRest fRest cRest
  | _ + 1, _, _, _, _ => false

/-- Certifies `cayleyKTable`, `cayleyQ14Table`, `cayleyFlipMask`, and `cayleyQ12Cert`. -/
def checkCayleyCert (flips : List Bool) (ks qs14 q12Cert : List (List ℕ)) : Bool :=
  forceList ks fun ksF ↦
  forceList qs14 fun qsF ↦
  forceList q12Cert fun certF ↦
    Nat.beq ksF.length 58 &&
      Nat.beq qsF.length 58 &&
      Nat.beq flips.length 58 &&
      Nat.beq certF.length 58 &&
      checkSkewAllGo ksF 0 ksF &&
      forceList (prepKRows ksF) fun pKRs ↦
        checkCayleyColsGo pKRs 58 qsF ksF flips certF

private lemma forall2_ofFn_of_getD {α β : Type*} {R : α → β → Prop}
    {N : ℕ} {xs : List α} (hlen : xs.length = N) (da : α) (f : Fin N → β)
    (h : ∀ i : Fin N, R (xs.getD i.val da) (f i)) :
    List.Forall₂ R xs (List.ofFn f) := by
  rw [List.forall₂_iff_get]
  refine ⟨by simp [hlen], fun k hk1 hk2 ↦ ?_⟩
  have hkN : k < N := by simpa using hk2
  simp only [List.get_eq_getElem, List.getElem_ofFn, ← list_getD_eq_getElem xs da hk1]
  exact h ⟨k, hkN⟩

private lemma cayley_single_col_sound {ks : List (List ℕ)} {flips : List Bool}
    (hskew : ∀ a < 58, (ks.getD a []).length = 58 ∧
      ∀ b < 58, (ks.getD a []).getD b 0 + (ks.getD b []).getD a 0 = cayleyTwoKOff)
    {Q₀ Q : Matrix (Fin 58) (Fin 58) ℝ} (hQ : Qᵀ * Q = 1)
    (hsgn : ∀ i j : Fin 58, Q i j = (if flips.getD j.val false then -1 else 1) * Q₀ i j)
    (hsol : ∀ j : Fin 58,
      (1 + cayleyKMat ks) *ᵥ (fun i ↦ Q₀ i j) = fun i ↦ (1 - cayleyKMat ks) i j)
    (ks_len : ks.length = 58) (j : Fin 58) (c14 certCol : List ℕ)
    (hc14_len : c14.length = 58)
    (hrsq : cayleyColResSqGo j.val (Nat.mul cayleyKOff (sumList c14)) c14 0
      (prepKRows ks) c14 (ks.getD j.val []) 0 ≤ cayleyErrSqBound)
    (hdown : checkDownscaleCayleyCol (flips.getD j.val false) c14 certCol = true) :
    ValidZ2List certCol (List.replicate 58 2) (List.ofFn fun i : Fin 58 ↦ Q i j) := by
  set K := cayleyKMat ks
  have hK := cayleyKMat_transpose ks
  have hK_entry (a b : Fin 58) :
      K a b = (((ks.getD a.val []).getD b.val 0 : ℝ) - (cayleyKOff : ℝ)) / (cayleySK : ℝ) := by
    have hs := (hskew a.val a.isLt).2 b.val b.isLt
    have hsR : ((ks.getD b.val []).getD a.val 0 : ℝ) =
        (cayleyTwoKOff : ℝ) - ((ks.getD a.val []).getD b.val 0 : ℝ) := by
      have : ((ks.getD a.val []).getD b.val 0 : ℝ) +
          ((ks.getD b.val []).getD a.val 0 : ℝ) = (cayleyTwoKOff : ℝ) := by exact_mod_cast hs
      linarith
    dsimp only [K, cayleyKMat]
    rw [hsR]
    simp only [cayleyTwoKOff, cayleyKOff, cayleySK, Nat.cast_ofNat]
    ring
  set cTil : Fin 58 → ℝ := fun k ↦ ((c14.getD k.val 0 : ℝ) - (cayleyZQ14 : ℝ)) / (cayleySQ14 : ℝ)
  set w : Fin 58 → ℝ := fun k ↦ cTil k - Q₀ k j
  have hp_len : (prepKRows ks).length = c14.length := by simp [prepKRows_eq, ks_len, hc14_len]
  have hu_len : c14.length = (ks.getD j.val []).length := by
    rw [hc14_len, (hskew j.val j.isLt).1]
  have hrsq_eq := cayleyColResSqGo_eq j.val (Nat.mul cayleyKOff (sumList c14)) c14 0
    (prepKRows ks) c14 (ks.getD j.val []) 0 hp_len hu_len
  rw [hc14_len, Nat.cast_zero, zero_add, ← Fin.sum_univ_eq_sum_range] at hrsq_eq
  have hrow_term (i : Fin 58) :
      (((dotRaw ((prepKRows ks).getD i.val ([], 0)).1 c14 : ℝ) + (cayleyPosConst : ℝ) +
          (cayleySK : ℝ) * (c14.getD i.val 0 : ℝ)) -
        (((prepKRows ks).getD i.val ([], 0)).2 +
          ((Nat.mul cayleyKOff (sumList c14) : ℕ) : ℝ) +
          (cayleySQ14 : ℝ) * ((ks.getD j.val []).getD i.val 0 : ℝ) +
          if 0 + i.val = j.val then (cayleyDiagTerm : ℝ) else 0)) =
      ((cayleySK : ℝ) * (cayleySQ14 : ℝ)) * (((1 + K) *ᵥ w) i) := by
    have hpr : (prepKRows ks).getD i.val ([], 0) =
        (ks.getD i.val [], Nat.add (Nat.mul cayleyZQ14 (sumList (ks.getD i.val [])))
          cayleyNegConst) := by
      rw [prepKRows_eq, list_getD_eq_getElem _ _ (by simp [ks_len, i.isLt]),
        List.getElem_map, ← list_getD_eq_getElem _ [] (by omega)]
    rw [hpr]
    have hu_i_len : (ks.getD i.val []).length = 58 := (hskew i.val i.isLt).1
    have hdot_i : (dotRaw (ks.getD i.val []) c14 : ℝ) =
        ∑ k : Fin 58, ((ks.getD i.val []).getD k.val 0 : ℝ) * (c14.getD k.val 0 : ℝ) := by
      rw [dotRaw_eq_range _ _ (hu_i_len.trans hc14_len.symm), hu_i_len,
        ← Fin.sum_univ_eq_sum_range]
    have hsum_ui : (sumList (ks.getD i.val []) : ℝ) =
        ∑ k : Fin 58, ((ks.getD i.val []).getD k.val 0 : ℝ) := by
      rw [sumList_eq_range, hu_i_len, ← Fin.sum_univ_eq_sum_range]
    have hsum_c : (sumList c14 : ℝ) = ∑ k : Fin 58, (c14.getD k.val 0 : ℝ) := by
      rw [sumList_eq_range, hc14_len, ← Fin.sum_univ_eq_sum_range]
    have hw_exp : ((1 + K) *ᵥ w) i = ((1 + K) *ᵥ cTil) i - (1 - K) i j := by
      change ((1 + K) *ᵥ (cTil - fun k ↦ Q₀ k j)) i = _
      rw [Matrix.mulVec_sub, Pi.sub_apply, congrFun (hsol j) i]
    have h1mK : (1 - K) i j = (if i = j then (1 : ℝ) else 0) + K j i := by
      have hkt := congrFun (congrFun hK j) i
      simp only [Matrix.transpose_apply, Matrix.neg_apply] at hkt
      change (1 : Matrix (Fin 58) (Fin 58) ℝ) i j - cayleyKMat ks i j =
        (if i = j then (1 : ℝ) else 0) + cayleyKMat ks j i
      simp only [Matrix.one_apply]
      linarith
    have h1pK_c : ((1 + K) *ᵥ cTil) i = cTil i + ∑ k : Fin 58, K i k * cTil k := by
      rw [Matrix.add_mulVec, Matrix.one_mulVec, Pi.add_apply]
      simp [mulVec, dotProduct]
    have hij_iff : (0 + i.val = j.val) ↔ (i = j) := by simp [Fin.ext_iff]
    rw [hw_exp, h1pK_c, h1mK, hK_entry j i]
    simp_rw [hK_entry i, cTil, hij_iff]
    simp only [Nat.add_eq, Nat.mul_eq, Nat.cast_add, Nat.cast_mul, hdot_i, hsum_ui, hsum_c]
    have hsum_prod :
        ((cayleySK : ℝ) * (cayleySQ14 : ℝ)) *
          (∑ k : Fin 58, (((ks.getD i.val []).getD k.val 0 : ℝ) - (cayleyKOff : ℝ)) /
            (cayleySK : ℝ) * (((c14.getD k.val 0 : ℝ) - (cayleyZQ14 : ℝ)) / (cayleySQ14 : ℝ))) =
        (∑ k : Fin 58, ((ks.getD i.val []).getD k.val 0 : ℝ) * (c14.getD k.val 0 : ℝ)) -
          (cayleyZQ14 : ℝ) * (∑ k : Fin 58, ((ks.getD i.val []).getD k.val 0 : ℝ)) -
          (cayleyKOff : ℝ) * (∑ k : Fin 58, (c14.getD k.val 0 : ℝ)) +
          58 * (cayleyKOff : ℝ) * (cayleyZQ14 : ℝ) := by
      rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
      have h58 : (58 : ℝ) * (cayleyKOff : ℝ) * (cayleyZQ14 : ℝ) =
          ∑ _ : Fin 58, (cayleyKOff : ℝ) * (cayleyZQ14 : ℝ) := by
        simp [Finset.sum_const, mul_assoc]
      rw [h58, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      simp only [cayleySK, cayleySQ14, Nat.cast_ofNat]
      ring
    rw [mul_sub, mul_add, hsum_prod]
    by_cases hij : i = j
    · simp only [hij, ↓reduceIte, cayleyPosConst, cayleyNegConst, cayleyDiagTerm, cayleySK,
        cayleySQ14, cayleyZQ14, cayleyKOff, Nat.cast_ofNat]
      linarith
    · simp only [hij, ↓reduceIte, cayleyPosConst, cayleyNegConst, cayleySK,
        cayleySQ14, cayleyZQ14, cayleyKOff, Nat.cast_ofNat]
      linarith
  have hsum_sq : (∑ i : Fin 58, (((cayleySK : ℝ) * (cayleySQ14 : ℝ)) * (((1 + K) *ᵥ w) i)) ^ 2) ≤
      (cayleyErrSqBound : ℝ) := by
    simp_rw [← hrow_term]
    rw [← hrsq_eq]
    exact_mod_cast hrsq
  have hclose_k (k : Fin 58) :
      |Q k j| ≤ 1 ∧ |((c14.getD k.val 0 : ℝ) - (cayleyZQ14 : ℝ)) -
        (if flips.getD j.val false then -Q k j else Q k j) * (cayleySQ14 : ℝ)| ≤ 26 := by
    refine ⟨orth_entry_abs_le_one hQ k j, ?_⟩
    have hwk := sq_le_sum_sq_one_add_skew hK w k
    have hfac : ∑ p : Fin 58, (((cayleySK : ℝ) * (cayleySQ14 : ℝ)) * (((1 + K) *ᵥ w) p)) ^ 2 =
        ((cayleySK : ℝ) * (cayleySQ14 : ℝ)) ^ 2 * ∑ p : Fin 58, (((1 + K) *ᵥ w) p) ^ 2 := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun p _ ↦ by ring
    rw [hfac] at hsum_sq
    have hwk2 : (w k * (cayleySQ14 : ℝ)) ^ 2 ≤ 26 ^ 2 := by
      simp only [cayleySK, cayleySQ14, cayleyErrSqBound, Nat.cast_ofNat] at hsum_sq ⊢
      nlinarith
    have hflipQ : (if flips.getD j.val false then -Q k j else Q k j) = Q₀ k j := by
      rw [hsgn k j]; cases flips.getD j.val false <;> simp
    rw [hflipQ]
    have hid : ((c14.getD k.val 0 : ℝ) - (cayleyZQ14 : ℝ)) - Q₀ k j * (cayleySQ14 : ℝ) =
        w k * (cayleySQ14 : ℝ) := by
      dsimp only [w, cTil]; simp only [cayleySQ14, Nat.cast_ofNat]; ring
    rw [hid]
    exact abs_le.mpr ⟨by nlinarith, by nlinarith⟩
  have hf2 := forall2_ofFn_of_getD
    (R := fun (x : ℕ) (q : ℝ) ↦ |q| ≤ 1 ∧ |((x : ℝ) - (cayleyZQ14 : ℝ)) -
      (if flips.getD j.val false then -q else q) * (cayleySQ14 : ℝ)| ≤ 26)
    hc14_len 0 (fun k : Fin 58 ↦ Q k j) hclose_k
  obtain ⟨hv, hcl⟩ := checkDownscaleCayleyCol_sound (flips.getD j.val false) hf2 hdown
  rwa [hcl, hc14_len] at hv

private lemma checkCayleyColsGo_sound {ks : List (List ℕ)} {flips : List Bool}
    (hskew : ∀ a < 58, (ks.getD a []).length = 58 ∧
      ∀ b < 58, (ks.getD a []).getD b 0 + (ks.getD b []).getD a 0 = cayleyTwoKOff)
    {Q₀ Q : Matrix (Fin 58) (Fin 58) ℝ} (hQ : Qᵀ * Q = 1)
    (hsgn : ∀ i j : Fin 58, Q i j = (if flips.getD j.val false then -1 else 1) * Q₀ i j)
    (hsol : ∀ j : Fin 58,
      (1 + cayleyKMat ks) *ᵥ (fun i ↦ Q₀ i j) = fun i ↦ (1 - cayleyKMat ks) i j)
    (ks_len : ks.length = 58)
    {repTwo : List ℕ} (hrep : repTwo = List.replicate 58 2)
    {colR : Fin 58 → List ℝ} (hcolR : ∀ j : Fin 58, colR j = List.ofFn fun i : Fin 58 ↦ Q i j) :
    ∀ (rem : ℕ) (hrem : rem ≤ 58) (qRest kRest : List (List ℕ))
      (fRest : List Bool) (cRest : List (List ℕ)),
      checkCayleyColsGo (prepKRows ks) rem qRest kRest fRest cRest = true →
      ∀ idx (hidx : idx < rem),
        kRest.getD idx [] = ks.getD (58 - rem + idx) [] →
        fRest.getD idx false = flips.getD (58 - rem + idx) false →
        ValidZ2List (cRest.getD idx []) repTwo (colR ⟨58 - rem + idx, by omega⟩)
  | 0, _, _, _, _, _, _, _, hidx, _, _ => by omega
  | rem + 1, hrem, qRest, kRest, fRest, cRest, hok, idx, hidx, hk_eq, hf_eq => by
    cases qRest with
    | nil => simp [checkCayleyColsGo] at hok
    | cons qCol qTail =>
      cases kRest with
      | nil => simp [checkCayleyColsGo] at hok
      | cons kRowJ kTail =>
        cases fRest with
        | nil => simp [checkCayleyColsGo] at hok
        | cons flipJ fTail =>
          cases cRest with
          | nil => simp [checkCayleyColsGo] at hok
          | cons certCol cTail =>
            unfold checkCayleyColsGo at hok
            simp only [strictNatList_eq, strictNat_eq] at hok
            obtain ⟨hcur, htail⟩ := Bool.and_eq_true_iff.mp hok
            obtain ⟨hclen, hrsq_down⟩ := Bool.and_eq_true_iff.mp hcur
            obtain ⟨hrsq, hdown⟩ := Bool.and_eq_true_iff.mp hrsq_down
            cases idx with
            | zero =>
              rw [List.getD_cons_zero, Nat.add_zero] at hk_eq hf_eq
              rw [List.getD_cons_zero]
              have hfin0 : (⟨58 - (rem + 1) + 0, by omega⟩ : Fin 58) =
                  ⟨58 - (rem + 1), by omega⟩ := Fin.ext (Nat.add_zero _)
              rw [hfin0, hrep, hcolR]
              rw [hk_eq] at hrsq
              rw [hf_eq] at hdown
              exact cayley_single_col_sound hskew hQ hsgn hsol ks_len
                ⟨58 - (rem + 1), by omega⟩ qCol certCol (Nat.beq_eq.mp hclen)
                (Nat.le_of_ble_eq_true hrsq) hdown
            | succ m =>
              have hj_eq : 58 - (rem + 1) + (m + 1) = 58 - rem + m := by omega
              have hk' : kTail.getD m [] = ks.getD (58 - rem + m) [] := by
                rw [← hj_eq, ← List.getD_cons_succ]; exact hk_eq
              have hf' : fTail.getD m false = flips.getD (58 - rem + m) false := by
                rw [← hj_eq, ← List.getD_cons_succ]; exact hf_eq
              have hres := checkCayleyColsGo_sound hskew hQ hsgn hsol ks_len hrep hcolR
                rem (by omega) qTail kTail fTail cTail htail m (by omega) hk' hf'
              have hfin : (⟨58 - (rem + 1) + (m + 1), by omega⟩ : Fin 58) =
                  ⟨58 - rem + m, by omega⟩ := Fin.ext hj_eq
              rw [List.getD_cons_succ, hfin]
              exact hres

lemma checkCayleyCert_sound {flips : List Bool} {ks qs14 q12Cert : List (List ℕ)}
    (hok : checkCayleyCert flips ks qs14 q12Cert = true) :
    ∃ Q : Matrix (Fin 58) (Fin 58) ℝ,
      Qᵀ * Q = 1 ∧ Q * Qᵀ = 1 ∧
      ∀ j : Fin 58,
        ValidZ2List (q12Cert.getD j.val []) (List.replicate 58 2)
          (List.ofFn fun i : Fin 58 ↦ Q i j) := by
  unfold checkCayleyCert at hok
  simp only [forceList_eq] at hok
  obtain ⟨h12345, hcols⟩ := Bool.and_eq_true_iff.mp hok
  obtain ⟨h1234, hskew_b⟩ := Bool.and_eq_true_iff.mp h12345
  obtain ⟨h123, _⟩ := Bool.and_eq_true_iff.mp h1234
  obtain ⟨h12, _⟩ := Bool.and_eq_true_iff.mp h123
  obtain ⟨hks_b, _⟩ := Bool.and_eq_true_iff.mp h12
  have hks_len : ks.length = 58 := Nat.beq_eq.mp hks_b
  have hskew_raw := checkSkewAllGo_sound ks 0 ks hskew_b
  have hskew : ∀ a < 58, (ks.getD a []).length = 58 ∧
      ∀ b < 58, (ks.getD a []).getD b 0 + (ks.getD b []).getD a 0 = cayleyTwoKOff := by
    intro a ha
    simpa using hskew_raw a (hks_len.symm ▸ ha)
  obtain ⟨Q₀, Q, hQ, hQ_right, hsgn, hsol⟩ :=
    exists_cayley_orthogonal (cayleyKMat ks) (cayleyKMat_transpose ks)
      (fun j : Fin 58 ↦ flips.getD j.val false)
  refine ⟨Q, hQ, hQ_right, fun j ↦ ?_⟩
  have hraw := checkCayleyColsGo_sound hskew hQ hsgn hsol hks_len rfl (fun _ ↦ rfl) 58 le_rfl
    qs14 ks flips q12Cert hcols j.val j.isLt (by simp) (by simp)
  have hfinj : (⟨58 - 58 + j.val, by omega⟩ : Fin 58) = j := Fin.ext (by simp)
  simpa only [hfinj] using hraw

/-! ## Part 4: `ValidOrb5e8`, `validOrb5e8_div10`, & Rotated Leaf Range Soundness -/

/-- Internal Deep certificate helper `cScaleHi`. -/
def cScaleHi : ℕ := 500000000
/-- Internal Deep certificate helper `cOffHi`. -/
def cOffHi : ℕ := 1000000000
/-- Internal Deep certificate helper `divRot5e8`. -/
def divRot5e8 : ℕ := 2000000000000000
/-- Internal Deep certificate helper `c234Scale2`. -/
def c234Scale2 : ℕ := 234000000000000000000000000

/-- Internal Deep helper `ValidOrb5e8`. -/
def ValidOrb5e8 (up : ℕ) (x : ℝ) : Prop :=
  499999900 ≤ up ∧ up ≤ 1500000100 ∧ |x| ≤ 1 ∧
    (up : ℝ) - (cOffHi : ℝ) ≤ x * (cScaleHi : ℝ) ∧
    x * (cScaleHi : ℝ) ≤ (up : ℝ) - (cOffHi : ℝ) + 2

/-- Internal Deep helper `ValidOrb5e7`. -/
def ValidOrb5e7 (up : ℕ) (x : ℝ) : Prop :=
  49999990 ≤ up ∧ up ≤ 150000010 ∧ |x| ≤ 1 ∧
    (up : ℝ) - (cOff : ℝ) ≤ x * (cScale : ℝ) ∧
    x * (cScale : ℝ) ≤ (up : ℝ) - (cOff : ℝ) + 2

lemma validOrb5e8_div10 {up : ℕ} {x : ℝ} (h : ValidOrb5e8 up x) :
    ValidOrb5e7 (Nat.div up 10) x := by
  rcases h with ⟨h1, h2, hx, hlo, hhi⟩
  change ValidOrb5e7 (up / 10) x
  have hd1 : 49999990 ≤ up / 10 := by omega
  have hd2 : up / 10 ≤ 150000010 := by omega
  have hdiv_lo : ((up / 10 : ℕ) : ℝ) * 10 ≤ (up : ℝ) :=
    nat_div_le_real (n := up) (d := 10)
  have hdiv_hi : (up : ℝ) ≤ ((up / 10 : ℕ) : ℝ) * 10 + 9 := by
    exact_mod_cast (show up ≤ (up / 10) * 10 + 9 by omega)
  refine ⟨hd1, hd2, hx, ?_, ?_⟩ <;>
    (simp only [cOffHi, cScaleHi, cOff, cScale, Nat.cast_ofNat] at hlo hhi ⊢; linarith)

/-- Certifies one rotated entry `realDot uR qR` against pre-certified `certLo` at `5e8` scale. -/
def checkRotEntry5e8 (ls colL : List ℕ) (su wu sumColL certLo : ℕ) : Bool :=
  let pos := Nat.add (dotRaw ls colL) c234Scale2
  let neg := Nat.mul zOff2 (Nat.add su sumColL)
  let rad := Nat.mul bScale (Nat.add wu 116)
  let nr := Nat.add neg rad
  let lo := Nat.div (Nat.sub pos nr) divRot5e8
  let hi := Nat.div (Nat.add (Nat.sub (Nat.add pos rad) neg) (Nat.sub divRot5e8 1)) divRot5e8
  Nat.ble nr pos && Nat.ble (Nat.sub hi lo) 2 &&
    Nat.ble 499999900 lo && Nat.ble lo 1500000100 && Nat.beq lo certLo

private lemma checkRotEntry5e8_sound {ls ws colL repTwo : List ℕ} {uR qR : List ℝ}
    {su wu sumColL certLo : ℕ}
    (hrep116 : sumList repTwo = 116)
    (hu : ValidZ2List ls ws uR) (hq : ValidZ2List colL repTwo qR)
    (hu_len : uR.length = 58) (hq_len : qR.length = 58)
    (hsu : su = sumList ls) (hwu : wu = sumList ws) (hsumQ : sumColL = sumList colL)
    (habs_dot : |realDot uR qR| ≤ 1)
    (hok : checkRotEntry5e8 ls colL su wu sumColL certLo = true) :
    ValidOrb5e8 certLo (realDot uR qR) := by
  subst hsu hwu hsumQ
  unfold checkRotEntry5e8 at hok
  obtain ⟨habcd, hbeq⟩ := Bool.and_eq_true_iff.mp hok
  obtain ⟨habc, hb4⟩ := Bool.and_eq_true_iff.mp habcd
  obtain ⟨hab, hb3⟩ := Bool.and_eq_true_iff.mp habc
  obtain ⟨hb1, hb2⟩ := Bool.and_eq_true_iff.mp hab
  have hcert := Nat.beq_eq.mp hbeq
  subst hcert
  obtain ⟨_, herr⟩ := dot_err_bound hu hq (hu_len.trans hq_len.symm)
  rw [hu_len, hrep116] at herr
  obtain ⟨herr_lo, herr_hi⟩ := abs_le.mp herr
  set pos := Nat.add (dotRaw ls colL) c234Scale2
  set neg := Nat.mul zOff2 (Nat.add (sumList ls) (sumList colL))
  set rad := Nat.mul bScale (Nat.add (sumList ws) 116)
  set nr := Nat.add neg rad
  set lo := Nat.div (Nat.sub pos nr) divRot5e8
  set hi := Nat.div (Nat.add (Nat.sub (Nat.add pos rad) neg) (Nat.sub divRot5e8 1)) divRot5e8
  have hle_nr : nr ≤ pos := Nat.le_of_ble_eq_true hb1
  have hle_neg : neg ≤ pos + rad := by simp only [nr, Nat.add_eq] at hle_nr; omega
  have hhi_lo_sub : hi - lo ≤ 2 := by simpa [Nat.sub_eq] using Nat.le_of_ble_eq_true hb2
  have hlo_ge : 499999900 ≤ lo := Nat.le_of_ble_eq_true hb3
  have hlo_le : lo ≤ 1500000100 := Nat.le_of_ble_eq_true hb4
  have hlo_le_hi : lo ≤ hi := by
    change (pos - nr) / divRot5e8 ≤ (pos + rad - neg + (divRot5e8 - 1)) / divRot5e8
    exact Nat.div_le_div_right (by simp only [nr, Nat.add_eq] at hle_nr ⊢; omega)
  have hhi_le : (hi : ℝ) ≤ (lo : ℝ) + 2 := by
    have : hi ≤ lo + 2 := by omega
    exact_mod_cast this
  have hposR : (pos : ℝ) = (dotRaw ls colL : ℝ) + 234 * (bScale : ℝ) ^ 2 := by
    simp only [pos, c234Scale2, bScale, Nat.add_eq]; push_cast; norm_num
  have hnegR : (neg : ℝ) = (zOff2 : ℝ) * ((sumList ls : ℝ) + (sumList colL : ℝ)) := by
    simp only [neg, Nat.mul_eq, Nat.add_eq]; push_cast; ring
  have hradR : (rad : ℝ) = (bScale : ℝ) * ((sumList ws : ℝ) + 116) := by
    simp only [rad, Nat.mul_eq, Nat.add_eq]; push_cast; ring
  refine ⟨hlo_ge, hlo_le, habs_dot, ?_, ?_⟩
  · have hf : (lo : ℝ) * (divRot5e8 : ℝ) ≤ ((Nat.sub pos nr : ℕ) : ℝ) :=
      nat_div_le_real (n := Nat.sub pos nr) (d := divRot5e8)
    simp only [Nat.sub_eq] at hf
    rw [Nat.cast_sub hle_nr] at hf
    have hnrR : (nr : ℝ) = (neg : ℝ) + (rad : ℝ) := by simp [nr, Nat.add_eq]
    rw [hnrR, hposR, hnegR, hradR] at hf
    simp only [divRot5e8, bScale, zOff2, cOffHi, cScaleHi, Nat.cast_ofNat] at herr_lo hf ⊢
    norm_num at herr_lo hf ⊢
    linarith
  · have hc : ((Nat.sub (Nat.add pos rad) neg : ℕ) : ℝ) ≤ (hi : ℝ) * (divRot5e8 : ℝ) :=
      real_le_nat_cdiv' (n := Nat.sub (Nat.add pos rad) neg) (by decide : 0 < divRot5e8)
    simp only [Nat.add_eq, Nat.sub_eq] at hc
    rw [Nat.cast_sub hle_neg, Nat.cast_add, hposR, hnegR, hradR] at hc
    simp only [divRot5e8, bScale, zOff2, cOffHi, cScaleHi, Nat.cast_ofNat] at herr_hi hc ⊢
    norm_num at herr_hi hc ⊢
    linarith

private lemma givensRealGo_sum_sq : ∀ (n : ℕ) (ks : List ℕ) (pref : ℝ),
    0 < n → ((givensRealGo n ks pref).map (fun x ↦ x ^ 2)).sum = pref ^ 2
  | 0, _, _, hn => by omega
  | 1, _, pref, _ => by simp [givensRealGo]
  | n + 2, [], pref, _ => by
    simp only [givensRealGo, List.map_cons, List.sum_cons,
      givensRealGo_sum_sq (n + 1) [] _ (by omega), Real.cos_zero, Real.sin_zero,
      mul_one, mul_zero]
    ring
  | n + 2, idx :: ks, pref, _ => by
    simp only [givensRealGo, List.map_cons, List.sum_cons,
      givensRealGo_sum_sq (n + 1) ks _ (by omega), mul_pow]
    have hcs := Real.cos_sq_add_sin_sq (π * (idx : ℝ) / 8192)
    nlinarith

private lemma abs_realDot_le_avg_sum_sq : ∀ (xs ys : List ℝ), xs.length = ys.length →
    2 * |realDot xs ys| ≤ (xs.map (fun x ↦ x ^ 2)).sum + (ys.map (fun y ↦ y ^ 2)).sum
  | [], [], _ => by simp [realDot]
  | _ :: _, [], h => by simp at h
  | [], _ :: _, h => by simp at h
  | x :: xs, y :: ys, h => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h
    have ih := abs_realDot_le_avg_sum_sq xs ys h
    have hxy : 2 * |x * y| ≤ x ^ 2 + y ^ 2 := by
      rcases le_total 0 (x * y) with h0 | h0
      · rw [abs_of_nonneg h0]; nlinarith [sq_nonneg (x - y)]
      · rw [abs_of_nonpos h0]; nlinarith [sq_nonneg (x + y)]
    simp only [realDot, List.map_cons, List.sum_cons]
    linarith [abs_add_le (x * y) (realDot xs ys)]

private lemma realDot_ofFn {N : ℕ} (u v : Fin N → ℝ) :
    realDot (List.ofFn u) (List.ofFn v) = ∑ i : Fin N, u i * v i := by
  induction N with
  | zero => simp [realDot]
  | succ m ih =>
    rw [List.ofFn_succ, List.ofFn_succ, realDot, Fin.sum_univ_succ, ih]

/-- Internal Deep certificate helper `prepQ12Cols`. -/
def prepQ12Cols : List (List ℕ) → List (List ℕ × ℕ)
  | [] => []
  | c :: cs =>
    strictNatList c fun cf ↦
    strictNat (sumList cf) fun sc ↦
      (cf, sc) :: prepQ12Cols cs

private lemma prepQ12Cols_eq : ∀ (cs : List (List ℕ)),
    prepQ12Cols cs = cs.map (fun c ↦ (c, sumList c))
  | [] => rfl
  | c :: cs => by simp [prepQ12Cols, strictNatList_eq, strictNat_eq, prepQ12Cols_eq cs]

/-- Internal Deep certificate helper `checkRotCols5e8`. -/
def checkRotCols5e8 (ls : List ℕ) (su wu : ℕ) :
    List (List ℕ × ℕ) → List ℕ → Bool
  | [], [] => true
  | (colL, sumColL) :: qcs, certLo :: certs =>
    checkRotEntry5e8 ls colL su wu sumColL certLo &&
      checkRotCols5e8 ls su wu qcs certs
  | _, _ => false

private lemma checkRotCols5e8_sound {ls ws repTwo : List ℕ} {uR : List ℝ}
    (hrep116 : sumList repTwo = 116)
    (hu : ValidZ2List ls ws uR) (hu_len : uR.length = 58)
    (hu_sq : (uR.map (fun x ↦ x ^ 2)).sum = 1)
    {qCols : List (List ℕ × ℕ)} {qMatR : List (List ℝ)} {certRow : List ℕ}
    (hfor : List.Forall₂ (fun (p : List ℕ × ℕ) (qR : List ℝ) ↦
      ValidZ2List p.1 repTwo qR ∧ p.2 = sumList p.1 ∧
        qR.length = 58 ∧ (qR.map (fun x ↦ x ^ 2)).sum = 1) qCols qMatR)
    (hok : checkRotCols5e8 ls (sumList ls) (sumList ws) qCols certRow = true) :
    List.Forall₂ ValidOrb5e8 certRow (qMatR.map (realDot uR)) := by
  induction hfor generalizing certRow with
  | nil =>
    cases certRow with
    | nil => exact .nil
    | cons _ _ => simp [checkRotCols5e8] at hok
  | @cons pq qR qcs qRest hhd htl ih =>
    rcases pq with ⟨colL, sumColL⟩
    rcases hhd with ⟨hq, hsumQ, hq_len, hq_sq⟩
    cases certRow with
    | nil => simp [checkRotCols5e8] at hok
    | cons certLo certs =>
      unfold checkRotCols5e8 at hok
      obtain ⟨h1, h2⟩ := Bool.and_eq_true_iff.mp hok
      have habs : |realDot uR qR| ≤ 1 := by
        have hbd := abs_realDot_le_avg_sum_sq uR qR (hu_len.trans hq_len.symm)
        linarith
      exact .cons (checkRotEntry5e8_sound hrep116 hu hq hu_len hq_len rfl rfl hsumQ habs h1)
        (ih h2)

/-- Internal Deep certificate helper `checkRotLeavesGo`. -/
def checkRotLeavesGo (qCols : List (List ℕ × ℕ)) :
    ℕ → List (List ℕ) → List (List ℕ) → Bool
  | 0, _, _ => true
  | rem + 1, aRow :: aRest, cRow :: cRest =>
    (givensCompactGo 58 aRow bScale bScale [] [] fun ls ws ↦
      strictNat (sumList ls) fun su ↦
      strictNat (sumList ws) fun wu ↦
        checkRotCols5e8 ls su wu qCols cRow) &&
      checkRotLeavesGo qCols rem aRest cRest
  | _ + 1, _, _ => false


private lemma checkRotLeavesGo_sound {repTwo : List ℕ} (hrep116 : sumList repTwo = 116)
    {qCols : List (List ℕ × ℕ)} {qMatR : List (List ℝ)}
    (hqCols : List.Forall₂ (fun (p : List ℕ × ℕ) (qR : List ℝ) ↦
      ValidZ2List p.1 repTwo qR ∧ p.2 = sumList p.1 ∧
        qR.length = 58 ∧ (qR.map (fun x ↦ x ^ 2)).sum = 1)
      qCols qMatR) :
    ∀ (rem : ℕ) (aRows cRows : List (List ℕ)),
      checkRotLeavesGo qCols rem aRows cRows = true →
      ∀ idx < rem,
        List.Forall₂ ValidOrb5e8 (cRows.getD idx [])
          (qMatR.map (realDot (givensRealGo 58 (aRows.getD idx []) 1)))
  | 0, _, _, _, _, hidx => by omega
  | rem + 1, [], _, hok, _, _ => by simp [checkRotLeavesGo] at hok
  | rem + 1, _ :: _, [], hok, _, _ => by simp [checkRotLeavesGo] at hok
  | rem + 1, aRow :: aRest, cRow :: cRest, hok, idx, hidx => by
    unfold checkRotLeavesGo at hok
    obtain ⟨hcur, htail⟩ := Bool.and_eq_true_iff.mp hok
    cases idx with
    | zero =>
      simp only [List.getD_cons_zero]
      let fImp : Bool → Prop := fun b ↦
        b = true → List.Forall₂ ValidOrb5e8 cRow
          (qMatR.map (realDot (givensRealGo 58 aRow 1)))
      have hg := givensCompactGo_valid aRow
        (fun ls ws ↦ fImp (strictNat (sumList ls) fun su ↦ strictNat (sumList ws) fun wu ↦
          checkRotCols5e8 ls su wu qCols cRow))
        fun ls ws hv hb ↦ by
          simp only [strictNat_eq] at hb
          exact checkRotCols5e8_sound hrep116 hv (givensRealGo_length 58 aRow 1)
            (by simpa using givensRealGo_sum_sq 58 aRow 1 (by decide)) hqCols hb
      rw [givensCompactGo_comp fImp] at hg
      exact hg hcur
    | succ m =>
      exact checkRotLeavesGo_sound hrep116 hqCols rem aRest cRest htail m (by omega)


/-- Internal Deep certificate helper `checkCayleyColsCnt`. -/
def checkCayleyColsCnt (pKRs : List (List ℕ × ℕ)) :
    ℕ → ℕ → List (List ℕ) → List (List ℕ) → List Bool → List (List ℕ) → Bool
  | 0, _, _, _, _, _ => true
  | _ + 1, 0, _, _, _, _ => true
  | cnt + 1, rem + 1, qCol :: qRest, kRowJ :: kRest, flipJ :: fRest, certCol :: cRest =>
    strictNatList qCol fun c14 ↦
    strictNatList kRowJ fun uRowJ ↦
      Nat.beq c14.length 58 &&
        (strictNat (Nat.mul cayleyKOff (sumList c14)) fun kOffSumC ↦
          let rsq := cayleyColResSqGo (Nat.sub 58 (rem + 1)) kOffSumC c14 0 pKRs c14 uRowJ 0
          Nat.ble rsq cayleyErrSqBound &&
            checkDownscaleCayleyCol flipJ c14 certCol) &&
        checkCayleyColsCnt pKRs cnt rem qRest kRest fRest cRest
  | _ + 1, _ + 1, _, _, _, _ => false

lemma checkCayleyColsGo_split (pKRs : List (List ℕ × ℕ)) :
    ∀ (a b : ℕ) (qs ks : List (List ℕ)) (fs : List Bool) (cs : List (List ℕ)),
      checkCayleyColsGo pKRs (a + b) qs ks fs cs =
        (checkCayleyColsCnt pKRs a (a + b) qs ks fs cs &&
          checkCayleyColsGo pKRs b (qs.drop a) (ks.drop a) (fs.drop a) (cs.drop a))
  | 0, _, _, _, _, _ => by simp [checkCayleyColsCnt]
  | a + 1, b, qs, ks, fs, cs => by
    have hab : a + 1 + b = (a + b) + 1 := by omega
    rw [hab]
    cases qs with
    | nil => simp [checkCayleyColsGo, checkCayleyColsCnt]
    | cons qCol qRest =>
      cases ks with
      | nil => simp [checkCayleyColsGo, checkCayleyColsCnt]
      | cons kRow kRest =>
        cases fs with
        | nil => simp [checkCayleyColsGo, checkCayleyColsCnt]
        | cons flipJ fRest =>
          cases cs with
          | nil => simp [checkCayleyColsGo, checkCayleyColsCnt]
          | cons certCol cRest =>
            simp only [checkCayleyColsGo, checkCayleyColsCnt, List.drop_succ_cons,
              strictNatList_eq, strictNat_eq, Bool.and_assoc]
            rw [checkCayleyColsGo_split pKRs a b qRest kRest fRest cRest]

/-- Internal Deep certificate helper `checkRotLeavesRange`. -/
def checkRotLeavesRange {m : ℕ} (q12Cert : List (List ℕ)) (angleTable : BitVec (m * 57 * 13))
    (certRows : List (List ℕ)) (start count : ℕ) : Bool :=
  forceList (prepQ12Cols q12Cert) fun qCols ↦
    checkRotLeavesGo qCols count (bvSlice angleTable start count) (certRows.drop start)

private lemma checkRotLeavesGo_split_append (qCols : List (List ℕ × ℕ)) :
    ∀ (a b : ℕ) (xs ys cRows : List (List ℕ)),
      xs.length = a →
      checkRotLeavesGo qCols (a + b) (xs ++ ys) cRows =
        (checkRotLeavesGo qCols a xs cRows &&
          checkRotLeavesGo qCols b ys (cRows.drop a))
  | 0, _, [], _, _, _ => by simp [checkRotLeavesGo]
  | _ + 1, _, [], _, _, hlen => by simp at hlen
  | a + 1, b, x :: xs, ys, [], hlen => by
    have hab : a + 1 + b = (a + b) + 1 := by omega
    rw [hab]; simp [checkRotLeavesGo]
  | a + 1, b, x :: xs, ys, cRow :: cRest, hlen => by
    have hab : a + 1 + b = (a + b) + 1 := by omega
    rw [hab]
    simp only [List.cons_append, checkRotLeavesGo, List.drop_succ_cons, Bool.and_assoc]
    rw [checkRotLeavesGo_split_append qCols a b xs ys cRest (by simpa using hlen)]

lemma checkRotLeavesRange_split {m : ℕ} (q12 : List (List ℕ))
    (ang : BitVec (m * 57 * 13)) (certs : List (List ℕ)) {s a b : ℕ} (hsa : s + a ≤ m)
    (h1 : checkRotLeavesRange q12 ang certs s a = true)
    (h2 : checkRotLeavesRange q12 ang certs (s + a) b = true) :
    checkRotLeavesRange q12 ang certs s (a + b) = true := by
  unfold checkRotLeavesRange at h1 h2 ⊢
  simp -iota only [forceList_eq] at h1 h2 ⊢
  have hd2 : (certs.drop s).drop a = certs.drop (s + a) := List.drop_drop
  rw [bvSlice_add, checkRotLeavesGo_split_append _ a b _ _ _ (bvSlice_length ang hsa), hd2]
  exact Bool.and_eq_true_iff.mpr ⟨h1, h2⟩

lemma checkRotLeavesRange_sound {m : ℕ} {Q : Matrix (Fin 58) (Fin 58) ℝ}
    (hQ : Qᵀ * Q = 1) {q12Cert : List (List ℕ)} (hq_len : q12Cert.length = 58)
    (hq : ∀ j : Fin 58, ValidZ2List (q12Cert.getD j.val []) (List.replicate 58 2)
      (List.ofFn fun i : Fin 58 ↦ Q i j))
    {angleTable : BitVec (m * 57 * 13)} {certRows : List (List ℕ)} {start count : ℕ}
    (hok : checkRotLeavesRange q12Cert angleTable certRows start count = true)
    {idx : ℕ} (hidx : idx < count) (hlt : start + idx < m) :
    List.Forall₂ ValidOrb5e8 (certRows.getD (start + idx) [])
      (List.ofFn (rotVec Q (givensLeaf 15 (fun q : Fin 58 ↦
        if h : q.val < 57 then (angleTable.getChunk₂ ⟨start + idx, hlt⟩ ⟨q.val, h⟩).toNat
        else 0)))) := by
  unfold checkRotLeavesRange at hok
  simp -iota only [forceList_eq] at hok
  have hrep116 : sumList (List.replicate 58 2) = 116 := by rw [sumList_replicate]
  have hqCols : List.Forall₂ (fun (p : List ℕ × ℕ) (qR : List ℝ) ↦
      ValidZ2List p.1 (List.replicate 58 2) qR ∧ p.2 = sumList p.1 ∧
        qR.length = 58 ∧ (qR.map (fun x ↦ x ^ 2)).sum = 1)
      (prepQ12Cols q12Cert)
      (List.ofFn fun j : Fin 58 ↦ List.ofFn fun i : Fin 58 ↦ Q i j) := by
    rw [prepQ12Cols_eq]
    refine forall2_ofFn_of_getD (by simp [hq_len]) ([], 0) _ fun j ↦ ?_
    have hj_lt : j.val < q12Cert.length := by omega
    have hget : (q12Cert.map fun c ↦ (c, sumList c)).getD j.val ([], 0) =
        (q12Cert.getD j.val [], sumList (q12Cert.getD j.val [])) := by
      rw [list_getD_eq_getElem _ _ (by simp [hj_lt]), List.getElem_map,
        ← list_getD_eq_getElem _ [] hj_lt]
    rw [hget]
    have hdiag : ∑ i : Fin 58, (Q i j) ^ 2 = 1 := by
      have h := congrFun (congrFun hQ j) j
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply_eq, ← sq] at h
      exact h
    refine ⟨hq j, rfl, List.length_ofFn, ?_⟩
    rw [List.map_ofFn, List.sum_ofFn]
    exact hdiag
  have hraw := checkRotLeavesGo_sound hrep116 hqCols count
    (bvSlice angleTable start count) (certRows.drop start) hok idx hidx
  have hc_drop : (certRows.drop start).getD idx [] = certRows.getD (start + idx) [] := by
    by_cases hclt : start + idx < certRows.length
    · rw [list_getD_eq_getElem _ [] (by simp; omega), List.getElem_drop,
        ← list_getD_eq_getElem _ [] hclt]
    · rw [list_getD_eq_default _ [] (by simp; omega),
        list_getD_eq_default _ [] (by omega)]
  rw [hc_drop, bvSlice_getD angleTable hidx hlt] at hraw
  set row := bvRow angleTable ⟨start + idx, hlt⟩
  have hu_eq : givensRealGo 58 row 1 =
      List.ofFn (givensLeaf 15 (fun q : Fin 58 ↦
        if h : q.val < 57 then (angleTable.getChunk₂ ⟨start + idx, hlt⟩ ⟨q.val, h⟩).toNat
        else 0)) := by
    refine List.ext_getElem (by simp [givensRealGo_length]) fun p hp1 hp2 ↦ ?_
    have hp58 : p < 58 := by simpa using hp2
    rw [← list_getD_eq_getElem _ 0 hp1, List.getElem_ofFn,
      givensRealGo_eq_givensLeaf row ⟨p, hp58⟩]
    congr 1; funext q
    rw [bvRow_getD]; split_ifs <;> simp
  have hmap_eq : ((List.ofFn fun j : Fin 58 ↦ List.ofFn fun i : Fin 58 ↦ Q i j).map
      (realDot (givensRealGo 58 row 1))) =
      List.ofFn (rotVec Q (givensLeaf 15 (fun q : Fin 58 ↦
        if h : q.val < 57 then (angleTable.getChunk₂ ⟨start + idx, hlt⟩ ⟨q.val, h⟩).toNat
        else 0))) := by
    rw [hu_eq, List.map_ofFn]
    refine congrArg List.ofFn (funext fun j ↦ ?_)
    simp only [Function.comp_apply, realDot_ofFn, rotVec, mulVec, dotProduct,
      Matrix.transpose_apply]
    exact Finset.sum_congr rfl fun i _ ↦ mul_comm _ _
  rwa [hmap_eq] at hraw

