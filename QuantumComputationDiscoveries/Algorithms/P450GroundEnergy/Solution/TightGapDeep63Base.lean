/-! ## Phase 3–5 Interval Soundness (`5e8` Rotated Scale) -/

lemma real_le_nat_cdiv {n d k : ℕ} (hk : k + 1 = d) :
    (n : ℝ) ≤ (((n + k) / d : ℕ) : ℝ) * (d : ℝ) := by
  have hd : 0 < d := by omega
  have hmod := Nat.div_add_mod (n + k) d
  have hlt := Nat.mod_lt (n + k) hd
  have hcomm : d * ((n + k) / d) = ((n + k) / d) * d := Nat.mul_comm _ _
  have hnat : n ≤ ((n + k) / d) * d := by omega
  exact_mod_cast hnat

lemma absDiffNat_cast (a b : ℕ) : (absDiffNat a b : ℝ) = |(a : ℝ) - (b : ℝ)| := by
  unfold absDiffNat
  split_ifs with h
  · have hle : a ≤ b := Nat.le_of_ble_eq_true h
    have hR : (a : ℝ) ≤ (b : ℝ) := Nat.cast_le.mpr hle
    rw [Nat.sub_eq, Nat.cast_sub hle, abs_of_nonpos (by linarith)]
    ring
  · have hle : b ≤ a := by
      have : ¬(a ≤ b) := fun h' ↦ h (Nat.ble_eq_true_of_le h'); omega
    have hR : (b : ℝ) ≤ (a : ℝ) := Nat.cast_le.mpr hle
    rw [Nat.sub_eq, Nat.cast_sub hle, abs_of_nonneg (by linarith)]

lemma le_maxNat_left (a b : ℕ) : a ≤ maxNat a b := by
  unfold maxNat; split_ifs with h
  · exact Nat.le_of_ble_eq_true h
  · exact le_rfl

lemma le_maxNat_right (a b : ℕ) : b ≤ maxNat a b := by
  unfold maxNat; split_ifs with h
  · exact le_rfl
  · have : ¬(a ≤ b) := fun h' ↦ h (Nat.ble_eq_true_of_le h'); omega

lemma normPN_sound (p n : ℕ) (P : ℕ → ℕ → Prop)
    (hk : ∀ p' n' : ℕ, (p' : ℝ) - (n' : ℝ) = (p : ℝ) - (n : ℝ) → P p' n') :
    normPN p n P := by
  unfold normPN; simp only [strictNat_eq]
  split_ifs with h
  · have hle : n ≤ p := Nat.le_of_ble_eq_true h
    exact hk _ _ (by rw [Nat.sub_eq, Nat.cast_sub hle]; ring)
  · have hle : p ≤ n := by
      have : ¬(n ≤ p) := fun h' ↦ h (Nat.ble_eq_true_of_le h'); omega
    exact hk _ _ (by rw [Nat.sub_eq, Nat.cast_sub hle]; ring)

lemma normPN_comp {α β : Type} (f : α → β) (p n : ℕ) (k : ℕ → ℕ → α) :
    normPN p n (fun a b ↦ f (k a b)) = f (normPN p n k) := by
  unfold normPN; simp only [strictNat_eq]; split_ifs <;> rfl

lemma accSignedIv_le {posA negA wPos wNeg off lo w : ℕ} {X : ℝ}
    (hlo : (lo : ℝ) - (off : ℝ) ≤ X) (hhi : X ≤ (lo : ℝ) + (w : ℝ) - (off : ℝ))
    (P : ℕ → ℕ → Prop)
    (hk : ∀ p' n' : ℕ,
      (posA : ℝ) - (negA : ℝ) + ((wPos : ℝ) - (wNeg : ℝ)) * X ≤ (p' : ℝ) - (n' : ℝ) → P p' n') :
    accSignedIv posA negA wPos wNeg off lo w P := by
  unfold accSignedIv
  simp only [strictNat_eq]
  split_ifs with hw hv1 hv2
  · have hw' : wNeg ≤ wPos := Nat.le_of_ble_eq_true hw
    have hv' : off ≤ lo + w := by simpa [Nat.add_eq] using Nat.le_of_ble_eq_true hv1
    refine normPN_sound _ _ P fun p' n' heq ↦ hk p' n' ?_
    rw [heq]
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, Nat.cast_add, Nat.cast_mul,
      Nat.cast_sub hw', Nat.cast_sub hv']
    have hwm : (0 : ℝ) ≤ (wPos : ℝ) - (wNeg : ℝ) := sub_nonneg.mpr (Nat.cast_le.mpr hw')
    nlinarith
  · have hw' : wNeg ≤ wPos := Nat.le_of_ble_eq_true hw
    have hv' : lo + w ≤ off := by
      have : ¬(off ≤ Nat.add lo w) := fun h ↦ hv1 (Nat.ble_eq_true_of_le h)
      simp only [Nat.add_eq] at this; omega
    refine normPN_sound _ _ P fun p' n' heq ↦ hk p' n' ?_
    rw [heq]
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, Nat.cast_add, Nat.cast_mul,
      Nat.cast_sub hw', Nat.cast_sub hv']
    have hwm : (0 : ℝ) ≤ (wPos : ℝ) - (wNeg : ℝ) := sub_nonneg.mpr (Nat.cast_le.mpr hw')
    nlinarith
  · have hw' : wPos ≤ wNeg := by
      have : ¬(wNeg ≤ wPos) := fun h ↦ hw (Nat.ble_eq_true_of_le h); omega
    have hv' : lo ≤ off := Nat.le_of_ble_eq_true hv2
    refine normPN_sound _ _ P fun p' n' heq ↦ hk p' n' ?_
    rw [heq]
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, Nat.cast_add, Nat.cast_mul,
      Nat.cast_sub hw', Nat.cast_sub hv']
    have hwm : (wPos : ℝ) - (wNeg : ℝ) ≤ 0 := sub_nonpos.mpr (Nat.cast_le.mpr hw')
    nlinarith
  · have hw' : wPos ≤ wNeg := by
      have : ¬(wNeg ≤ wPos) := fun h ↦ hw (Nat.ble_eq_true_of_le h); omega
    have hv' : off ≤ lo := by
      have : ¬(lo ≤ off) := fun h ↦ hv2 (Nat.ble_eq_true_of_le h); omega
    refine normPN_sound _ _ P fun p' n' heq ↦ hk p' n' ?_
    rw [heq]
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, Nat.cast_add, Nat.cast_mul,
      Nat.cast_sub hw', Nat.cast_sub hv']
    have hwm : (wPos : ℝ) - (wNeg : ℝ) ≤ 0 := sub_nonpos.mpr (Nat.cast_le.mpr hw')
    nlinarith

lemma accSignedIv_comp {α β : Type} (f : α → β) (posA negA wPos wNeg off lo w : ℕ)
    (k : ℕ → ℕ → α) :
    accSignedIv posA negA wPos wNeg off lo w (fun a b ↦ f (k a b)) =
      f (accSignedIv posA negA wPos wNeg off lo w k) := by
  unfold accSignedIv; simp only [strictNat_eq]
  split_ifs <;> exact normPN_comp f _ _ k

lemma centered_prod_rad_bound {c1 zz1 w1 c2 zz2 w2 : ℕ} {X Y : ℝ}
    (h1lo : (c1 : ℝ) - (zz1 : ℝ) - (w1 : ℝ) ≤ 2 * X)
    (h1hi : 2 * X ≤ (c1 : ℝ) - (zz1 : ℝ) + (w1 : ℝ))
    (h2lo : (c2 : ℝ) - (zz2 : ℝ) - (w2 : ℝ) ≤ 2 * Y)
    (h2hi : 2 * Y ≤ (c2 : ℝ) - (zz2 : ℝ) + (w2 : ℝ)) :
    let pA : ℝ := (c1 : ℝ) * (c2 : ℝ) + (zz1 : ℝ) * (zz2 : ℝ)
    let nA : ℝ := (zz2 : ℝ) * (c1 : ℝ) + (zz1 : ℝ) * (c2 : ℝ)
    let rad : ℝ := (w1 : ℝ) * (absDiffNat c2 zz2 : ℝ) +
      (absDiffNat c1 zz1 : ℝ) * (w2 : ℝ) + (w1 : ℝ) * (w2 : ℝ)
    pA - nA - rad ≤ 4 * (X * Y) ∧ 4 * (X * Y) ≤ pA - nA + rad := by
  intro pA nA rad
  set A1 : ℝ := (c1 : ℝ) - (zz1 : ℝ)
  set A2 : ℝ := (c2 : ℝ) - (zz2 : ℝ)
  set d1 : ℝ := 2 * X - A1
  set d2 : ℝ := 2 * Y - A2
  have hd1 : |d1| ≤ (w1 : ℝ) := abs_le.mpr ⟨by linarith, by linarith⟩
  have hd2 : |d2| ≤ (w2 : ℝ) := abs_le.mpr ⟨by linarith, by linarith⟩
  have hid : 4 * (X * Y) - (pA - nA) = d1 * A2 + A1 * d2 + d1 * d2 := by
    simp only [d1, d2, A1, A2, pA, nA]; ring
  have ht1 : |d1 * A2| ≤ (w1 : ℝ) * |A2| := by
    rw [abs_mul]; exact mul_le_mul_of_nonneg_right hd1 (abs_nonneg _)
  have ht2 : |A1 * d2| ≤ |A1| * (w2 : ℝ) := by
    rw [abs_mul]; exact mul_le_mul_of_nonneg_left hd2 (abs_nonneg _)
  have ht3 : |d1 * d2| ≤ (w1 : ℝ) * (w2 : ℝ) := by
    rw [abs_mul]; exact mul_le_mul hd1 hd2 (abs_nonneg _) (by positivity)
  have hrad : rad = (w1 : ℝ) * |A2| + |A1| * (w2 : ℝ) + (w1 : ℝ) * (w2 : ℝ) := by
    simp only [rad, absDiffNat_cast, A1, A2]
  have hsum : |4 * (X * Y) - (pA - nA)| ≤ rad := by
    rw [hid, hrad]
    linarith [abs_add_le (d1 * A2 + A1 * d2) (d1 * d2), abs_add_le (d1 * A2) (A1 * d2)]
  obtain ⟨hL, hR⟩ := abs_le.mp hsum
  exact ⟨by linarith, by linarith⟩

private lemma mulZIv_sound {z1 l1 w1 z2 l2 w2 divBy newOff : ℕ} {X Y : ℝ}
    (h1lo : (l1 : ℝ) - (z1 : ℝ) ≤ X) (h1hi : X ≤ (l1 : ℝ) + (w1 : ℝ) - (z1 : ℝ))
    (h2lo : (l2 : ℝ) - (z2 : ℝ) ≤ Y) (h2hi : Y ≤ (l2 : ℝ) + (w2 : ℝ) - (z2 : ℝ))
    (P : Bool → ℕ → ℕ → Prop)
    (hk : ∀ (ok : Bool) (lo w : ℕ),
      (ok = true →
        (lo : ℝ) - (newOff : ℝ) ≤ X * Y / (divBy : ℝ) ∧
        X * Y / (divBy : ℝ) ≤ (lo : ℝ) + (w : ℝ) - (newOff : ℝ)) →
      P ok lo w) :
    mulZIv z1 l1 w1 z2 l2 w2 divBy newOff P := by
  unfold mulZIv; simp only [strictNat_eq]
  split_ifs with hguard
  · obtain ⟨hble, hblt⟩ := Bool.and_eq_true_iff.mp hguard
    have hreq_le : Nat.add (Nat.add (Nat.mul (Nat.mul 2 z2) (Nat.add (Nat.mul 2 l1) w1))
        (Nat.mul (Nat.mul 2 z1) (Nat.add (Nat.mul 2 l2) w2)))
        (Nat.add (Nat.add (Nat.mul w1 (absDiffNat (Nat.add (Nat.mul 2 l2) w2) (Nat.mul 2 z2)))
          (Nat.mul (absDiffNat (Nat.add (Nat.mul 2 l1) w1) (Nat.mul 2 z1)) w2))
          (Nat.mul w1 w2)) ≤
      Nat.add (Nat.mul newOff (Nat.mul 4 divBy))
        (Nat.add (Nat.mul (Nat.add (Nat.mul 2 l1) w1) (Nat.add (Nat.mul 2 l2) w2))
          (Nat.mul (Nat.mul 2 z1) (Nat.mul 2 z2))) := Nat.le_of_ble_eq_true hble
    have hdiv4_pos : 0 < Nat.mul 4 divBy := Nat.blt_eq.mp hblt
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, nat_div_def] at hreq_le hdiv4_pos ⊢
    have hdiv_pos : 0 < divBy := by omega
    have hdivR : (0 : ℝ) < (divBy : ℝ) := Nat.cast_pos.mpr hdiv_pos
    set c1 := 2 * l1 + w1
    set zz1 := 2 * z1
    set c2 := 2 * l2 + w2
    set zz2 := 2 * z2
    set pA := c1 * c2 + zz1 * zz2
    set nA := zz2 * c1 + zz1 * c2
    set rad := w1 * absDiffNat c2 zz2 + absDiffNat c1 zz1 * w2 + w1 * w2
    set div4 := 4 * divBy
    set bp := newOff * div4 + pA
    set req := nA + rad
    have hnA_le : nA ≤ bp + rad := by omega
    set lo := (bp - req) / div4
    set hi := (bp + rad - nA + (div4 - 1)) / div4
    have hlo_hi : lo ≤ hi :=
      Nat.div_le_div_right (by omega : bp - req ≤ bp + rad - nA + (div4 - 1))
    obtain ⟨hprod_lo, hprod_hi⟩ := centered_prod_rad_bound (X := X) (Y := Y)
      (c1 := c1) (zz1 := zz1) (w1 := w1) (c2 := c2) (zz2 := zz2) (w2 := w2)
      (by simp only [c1, zz1]; push_cast; linarith)
      (by simp only [c1, zz1]; push_cast; linarith)
      (by simp only [c2, zz2]; push_cast; linarith)
      (by simp only [c2, zz2]; push_cast; linarith)
    refine hk true lo (hi - lo) fun _ ↦ ⟨?_, ?_⟩
    · rw [le_div_iff₀ hdivR]
      have hf := nat_div_le_real (n := bp - req) (d := div4)
      have hsub : ((bp - req : ℕ) : ℝ) = (bp : ℝ) - (req : ℝ) := Nat.cast_sub hreq_le
      have hbp : (bp : ℝ) - (req : ℝ) =
          4 * ((newOff : ℝ) * (divBy : ℝ)) + ((pA : ℝ) - (nA : ℝ) - (rad : ℝ)) := by
        simp only [bp, req, div4]; push_cast; ring
      have hlo4 : (lo : ℝ) * (div4 : ℝ) = 4 * ((lo : ℝ) * (divBy : ℝ)) := by
        simp only [div4]; push_cast; ring
      simp only [pA, nA, rad] at hbp
      push_cast at hbp
      linarith
    · rw [div_le_iff₀ hdivR, Nat.cast_sub hlo_hi]
      have hc : ((bp + rad - nA : ℕ) : ℝ) ≤ (hi : ℝ) * (div4 : ℝ) :=
        real_le_nat_cdiv (n := bp + rad - nA) (d := div4) (k := div4 - 1) (by omega)
      have hbp : ((bp + rad - nA : ℕ) : ℝ) =
          4 * ((newOff : ℝ) * (divBy : ℝ)) +
            (((c1 : ℝ) * c2 + zz1 * zz2) - (zz2 * c1 + zz1 * c2) +
              (w1 * absDiffNat c2 zz2 + absDiffNat c1 zz1 * w2 + w1 * w2)) := by
        rw [Nat.cast_sub hnA_le, Nat.cast_add]
        simp only [bp, div4, pA, nA, rad]; push_cast; ring
      have hhi4 : (hi : ℝ) * (div4 : ℝ) = 4 * ((hi : ℝ) * (divBy : ℝ)) := by
        simp only [div4]; push_cast; ring
      linarith
  · exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true

private lemma mulZIv_comp {α β : Type} (f : α → β) (z1 l1 w1 z2 l2 w2 divBy newOff : ℕ)
    (k : Bool → ℕ → ℕ → α) :
    mulZIv z1 l1 w1 z2 l2 w2 divBy newOff (fun a b c ↦ f (k a b c)) =
      f (mulZIv z1 l1 w1 z2 l2 w2 divBy newOff k) := by
  unfold mulZIv; simp only [strictNat_eq]; split_ifs <;> rfl

/-! ### `5 * 10 ^ 7`-Scale Leaf Orbital Bounds & One-Body Certificate Soundness -/
private lemma orb5e7_prod_err {up vq : ℕ} {x y : ℝ}
    (hu : ValidOrb5e7 up x) (hv : ValidOrb5e7 vq y) :
    |(x * (cScale : ℝ)) * (y * (cScale : ℝ)) -
      ((up : ℝ) - (cOff : ℝ)) * ((vq : ℝ) - (cOff : ℝ))| ≤ (err1 : ℝ) := by
  rcases hu with ⟨hu1, hu2, _, hulo, huhi⟩
  rcases hv with ⟨_, _, hvy, hvlo, hvhi⟩
  set A : ℝ := (up : ℝ) - (cOff : ℝ)
  set B : ℝ := (vq : ℝ) - (cOff : ℝ)
  set X : ℝ := x * (cScale : ℝ)
  set Y : ℝ := y * (cScale : ℝ)
  have hA : |A| ≤ 50000010 := by
    have r1 : (49999990 : ℝ) ≤ (up : ℝ) := by exact_mod_cast hu1
    have r2 : (up : ℝ) ≤ 150000010 := by exact_mod_cast hu2
    rw [abs_le]; constructor <;> (simp only [A, cOff, Nat.cast_ofNat]; linarith)
  have hY : |Y| ≤ 50000000 := by
    obtain ⟨hy1, hy2⟩ := abs_le.mp hvy
    rw [abs_le]; constructor <;> (simp only [Y, cScale, Nat.cast_ofNat]; linarith)
  have hdX : |X - A| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hdY : |Y - B| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hid : X * Y - A * B = (X - A) * Y + A * (Y - B) := by ring
  have h1 : |(X - A) * Y| ≤ 2 * 50000000 := by
    rw [abs_mul]; exact mul_le_mul hdX hY (abs_nonneg _) (by norm_num)
  have h2 : |A * (Y - B)| ≤ 50000010 * 2 := by
    rw [abs_mul]; exact mul_le_mul hA hdY (abs_nonneg _) (by norm_num)
  rw [hid]
  simp only [err1, Nat.cast_ofNat]
  linarith [abs_add_le ((X - A) * Y) (A * (Y - B))]

private lemma orb5_prod_err {up vq : ℕ} {x y : ℝ}
    (hu : ValidOrb5e7 up x) (hv : ValidOrb5e7 vq y) :
    |(x * 2500000) * (y * 2500000) -
      (((up / 20 : ℕ) : ℝ) - (cOff5 : ℝ)) * (((vq / 20 : ℕ) : ℝ) - (cOff5 : ℝ))| ≤
      (err5 : ℝ) := by
  rcases hu with ⟨hu1, hu2, _, hulo, huhi⟩
  rcases hv with ⟨_, _, hvy, hvlo, hvhi⟩
  have hu5a : 2499999 ≤ up / 20 := by omega
  have hu5b : up / 20 ≤ 7500000 := by omega
  set A5 : ℝ := ((up / 20 : ℕ) : ℝ) - (cOff5 : ℝ)
  set B5 : ℝ := ((vq / 20 : ℕ) : ℝ) - (cOff5 : ℝ)
  set X5 : ℝ := x * 2500000
  set Y5 : ℝ := y * 2500000
  have hA5 : |A5| ≤ 2500001 := by
    have r1 : (2499999 : ℝ) ≤ ((up / 20 : ℕ) : ℝ) := by exact_mod_cast hu5a
    have r2 : ((up / 20 : ℕ) : ℝ) ≤ 7500000 := by exact_mod_cast hu5b
    rw [abs_le]; constructor <;> (simp only [A5, cOff5, Nat.cast_ofNat]; linarith)
  have hY5 : |Y5| ≤ 2500000 := by
    obtain ⟨hy1, hy2⟩ := abs_le.mp hvy
    rw [abs_le]; constructor <;> (simp only [Y5]; linarith)
  have hdiv_u : ((up / 20 : ℕ) : ℝ) * 20 ≤ (up : ℝ) ∧
      (up : ℝ) ≤ ((up / 20 : ℕ) : ℝ) * 20 + 19 :=
    ⟨nat_div_le_real (n := up) (d := 20),
      by exact_mod_cast (show up ≤ (up / 20) * 20 + 19 by omega)⟩
  have hdiv_v : ((vq / 20 : ℕ) : ℝ) * 20 ≤ (vq : ℝ) ∧
      (vq : ℝ) ≤ ((vq / 20 : ℕ) : ℝ) * 20 + 19 :=
    ⟨nat_div_le_real (n := vq) (d := 20),
      by exact_mod_cast (show vq ≤ (vq / 20) * 20 + 19 by omega)⟩
  have hdX5 : |X5 - A5| ≤ 2 := by
    rw [abs_le]; constructor <;>
      (simp only [X5, A5, cOff5, cOff, cScale, Nat.cast_ofNat] at hulo huhi ⊢; linarith)
  have hdY5 : |Y5 - B5| ≤ 2 := by
    rw [abs_le]; constructor <;>
      (simp only [Y5, B5, cOff5, cOff, cScale, Nat.cast_ofNat] at hvlo hvhi ⊢; linarith)
  have hid : X5 * Y5 - A5 * B5 = (X5 - A5) * Y5 + A5 * (Y5 - B5) := by ring
  have h1 : |(X5 - A5) * Y5| ≤ 2 * 2500000 := by
    rw [abs_mul]; exact mul_le_mul hdX5 hY5 (abs_nonneg _) (by norm_num)
  have h2 : |A5 * (Y5 - B5)| ≤ 2500001 * 2 := by
    rw [abs_mul]; exact mul_le_mul hA5 hdY5 (abs_nonneg _) (by norm_num)
  rw [hid]
  simp only [err5, Nat.cast_ofNat]
  linarith [abs_add_le ((X5 - A5) * Y5) (A5 * (Y5 - B5))]


private lemma orb5e8_prod_err {up vq : ℕ} {x y : ℝ}
    (hu : ValidOrb5e8 up x) (hv : ValidOrb5e8 vq y) :
    |(x * (cScaleHi : ℝ)) * (y * (cScaleHi : ℝ)) -
      ((up : ℝ) - (cOffHi : ℝ)) * ((vq : ℝ) - (cOffHi : ℝ))| ≤ (errHi : ℝ) := by
  rcases hu with ⟨_, _, hx_abs, hulo, huhi⟩
  rcases hv with ⟨_, _, hy_abs, hvlo, hvhi⟩
  obtain ⟨hx1, hx2⟩ := abs_le.mp hx_abs
  obtain ⟨hy1, hy2⟩ := abs_le.mp hy_abs
  set A : ℝ := (up : ℝ) - (cOffHi : ℝ)
  set B : ℝ := (vq : ℝ) - (cOffHi : ℝ)
  set dA : ℝ := x * (cScaleHi : ℝ) - A
  set dB : ℝ := y * (cScaleHi : ℝ) - B
  have hdA : |dA| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hdB : |dB| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hA : |A| ≤ 500000002 :=
    abs_le.mpr ⟨by simp only [cScaleHi, Nat.cast_ofNat] at huhi; linarith,
                by simp only [cScaleHi, Nat.cast_ofNat] at hulo; linarith⟩
  have hB : |B| ≤ 500000002 :=
    abs_le.mpr ⟨by simp only [cScaleHi, Nat.cast_ofNat] at hvhi; linarith,
                by simp only [cScaleHi, Nat.cast_ofNat] at hvlo; linarith⟩
  have hid : (x * (cScaleHi : ℝ)) * (y * (cScaleHi : ℝ)) - A * B =
      dA * B + A * dB + dA * dB := by dsimp [dA, dB]; ring
  rw [hid]
  have h1 : |dA * B| ≤ 2 * 500000002 := by
    rw [abs_mul]; exact mul_le_mul hdA hB (abs_nonneg _) (by norm_num)
  have h2 : |A * dB| ≤ 500000002 * 2 := by
    rw [abs_mul]; exact mul_le_mul hA hdB (abs_nonneg _) (by norm_num)
  have h3 : |dA * dB| ≤ 2 * 2 := by
    rw [abs_mul]; exact mul_le_mul hdA hdB (abs_nonneg _) (by norm_num)
  have htri1 := abs_add_le (dA * B + A * dB) (dA * dB)
  have htri2 := abs_add_le (dA * B) (A * dB)
  simp only [errHi_eq, Nat.cast_ofNat]
  linarith
lemma forall2_append {α β : Type*} {R : α → β → Prop} :
    ∀ {l1 : List α} {l2 : List β} {r1 : List α} {r2 : List β},
      List.Forall₂ R l1 l2 → List.Forall₂ R r1 r2 → List.Forall₂ R (l1 ++ r1) (l2 ++ r2)
  | _, _, _, _, .nil, h2 => h2
  | _, _, _, _, .cons hd tl, h2 => .cons hd (forall2_append tl h2)

private lemma forall2_take {α β : Type*} {R : α → β → Prop} :
    ∀ (k : ℕ) {xs : List α} {ys : List β},
      List.Forall₂ R xs ys → List.Forall₂ R (xs.take k) (ys.take k)
  | 0, _, _, _ => .nil
  | _ + 1, _, _, .nil => .nil
  | k + 1, _ :: _, _ :: _, .cons hd tl => .cons hd (forall2_take k tl)

private lemma forall2_drop {α β : Type*} {R : α → β → Prop} :
    ∀ (k : ℕ) {xs : List α} {ys : List β},
      List.Forall₂ R xs ys → List.Forall₂ R (xs.drop k) (ys.drop k)
  | 0, _, _, h => h
  | _ + 1, _, _, .nil => .nil
  | k + 1, _ :: _, _ :: _, .cons _ tl => forall2_drop k tl

lemma forall2_getD {α β : Type*} {R : α → β → Prop} {xs : List α} {ys : List β}
    (h : List.Forall₂ R xs ys) (da : α) (db : β) :
    ∀ {i : ℕ}, i < ys.length → R (xs.getD i da) (ys.getD i db) := by
  induction h with
  | nil => intro _ hi; simp at hi
  | cons hd _ ih =>
    intro i hi
    cases i with
    | zero => exact hd
    | succ j => exact ih (by simpa using hi)


private lemma obOrbLoopCPS_sound :
    ∀ (fuel : ℕ) (wts ups : List ℕ) (uR : List ℝ) (dLo dHi : ℕ) (accR : ℝ),
      List.Forall₂ ValidOrb5e8 ups uR → uR.length = fuel → fuel ≤ wts.length →
      (dLo : ℝ) ≤ accR * 100000000 → accR * 100000000 ≤ (dHi : ℝ) →
      ∀ (P : ℕ → ℕ → Prop),
        (∀ lo hi : ℕ,
          (lo : ℝ) ≤ (accR + ∑ i ∈ Finset.range fuel,
              (wts.getD i 0 : ℝ) * (uR.getD i 0) ^ 2) * 100000000 →
          (accR + ∑ i ∈ Finset.range fuel,
              (wts.getD i 0 : ℝ) * (uR.getD i 0) ^ 2) * 100000000 ≤ (hi : ℝ) →
          P lo hi) →
        obOrbLoopCPS fuel wts ups dLo dHi P
  | 0, _, _, _, dLo, dHi, accR, _, _, _, hlo, hhi, P, hk => by
    simp only [obOrbLoopCPS]
    exact hk dLo dHi (by simpa using hlo) (by simpa using hhi)
  | fuel + 1, wts, ups, uR, dLo, dHi, accR, hu, hlen, hwlen, hlo, hhi, P, hk => by
    cases hu with
    | nil => simp at hlen
    | @cons up x ups' xsR hhd htl =>
      cases wts with
      | nil => simp at hwlen
      | cons wt wts' =>
        simp only [List.length_cons, Nat.add_right_cancel_iff] at hlen
        have hwlen' : fuel ≤ wts'.length := by simp at hwlen; omega
        unfold obOrbLoopCPS
        simp only [strictNat_eq]
        obtain ⟨herr_lo, herr_hi⟩ := abs_le.mp (orb5e8_prod_err hhd hhd)
        set mag := absDiffNat up cOffHi
        set sq := Nat.mul mag mag
        have hsqR : (sq : ℝ) = ((up : ℝ) - (cOffHi : ℝ)) * ((up : ℝ) - (cOffHi : ℝ)) := by
          simp only [sq, mag, Nat.mul_eq, Nat.cast_mul, absDiffNat_cast]
          exact abs_mul_abs_self _
        have hx2_eq : (x * (cScaleHi : ℝ)) * (x * (cScaleHi : ℝ)) =
            (x ^ 2 * 100000000) * 2500000000 := by
          simp only [cScaleHi, Nat.cast_ofNat]; ring
        rw [← hsqR, hx2_eq] at herr_lo herr_hi
        set slo := if Nat.ble errHi sq then Nat.div (Nat.sub sq errHi) 2500000000 else 0
        set shi := Nat.div (Nat.add (Nat.add sq errHi) 2499999999) 2500000000
        have hslo : (slo : ℝ) ≤ x ^ 2 * 100000000 := by
          dsimp only [slo]
          split_ifs with hble
          · have hle := Nat.le_of_ble_eq_true hble
            have hf := nat_div_le_real (n := sq - errHi) (d := 2500000000)
            simp only [nat_div_def, Nat.sub_eq]; rw [Nat.cast_sub hle] at hf; linarith
          · rw [Nat.cast_zero]; positivity
        have hshi : x ^ 2 * 100000000 ≤ (shi : ℝ) := by
          have hc := real_le_nat_cdiv (n := sq + errHi) (d := 2500000000)
            (k := 2499999999) (by decide)
          simp only [shi, nat_div_def, Nat.add_eq]; rw [Nat.cast_add] at hc; linarith
        have hwt_nn : (0 : ℝ) ≤ (wt : ℝ) := Nat.cast_nonneg wt
        have hdLo' : ((Nat.add dLo (Nat.mul wt slo) : ℕ) : ℝ) ≤
            (accR + (wt : ℝ) * x ^ 2) * 100000000 := by
          simp only [Nat.add_eq, Nat.mul_eq, Nat.cast_add, Nat.cast_mul]; nlinarith
        have hdHi' : (accR + (wt : ℝ) * x ^ 2) * 100000000 ≤
            ((Nat.add dHi (Nat.mul wt shi) : ℕ) : ℝ) := by
          simp only [Nat.add_eq, Nat.mul_eq, Nat.cast_add, Nat.cast_mul]; nlinarith
        refine obOrbLoopCPS_sound fuel wts' ups' xsR _ _ (accR + (wt : ℝ) * x ^ 2)
          htl hlen hwlen' hdLo' hdHi' P fun lo hi hL hH ↦ hk lo hi ?_ ?_
        · rw [Finset.sum_range_succ']
          simp only [List.getD_cons_zero, List.getD_cons_succ]; linarith
        · rw [Finset.sum_range_succ']
          simp only [List.getD_cons_zero, List.getD_cons_succ]; linarith

private lemma obOrbLoopCPS_comp {α β : Type} (f : α → β) :
    ∀ (fuel : ℕ) (wts ups : List ℕ) (dLo dHi : ℕ) (k : ℕ → ℕ → α),
      obOrbLoopCPS fuel wts ups dLo dHi (fun a b ↦ f (k a b)) =
        f (obOrbLoopCPS fuel wts ups dLo dHi k)
  | 0, _, _, _, _, _ => rfl
  | _ + 1, [], _, _, _, _ => rfl
  | _ + 1, _ :: _, [], _, _, _ => rfl
  | fuel + 1, _ :: wts, _ :: ups, _, _, k => by
    unfold obOrbLoopCPS; simp only [strictNat_eq]
    exact obOrbLoopCPS_comp f fuel wts ups _ _ k

private lemma obAllGo_le {wTot : List ℕ} (hwlen : 58 ≤ wTot.length) :
    ∀ (rem : ℕ) (rows : List (List ℕ)) (ws : List ℕ) (uFn : ℕ → Fin 58 → ℝ) (posA negA : ℕ),
      (∀ j < rem, List.Forall₂ ValidOrb5e8 (rows.getD j []) (List.ofFn (uFn j))) →
      ∀ (P : Bool → ℕ → ℕ → Prop),
        (∀ (ok : Bool) (p' n' : ℕ),
          (ok = true →
            (posA : ℝ) - (negA : ℝ) +
              (∑ j ∈ Finset.range rem,
                (fromOffset (ws.getD j 16384) : ℝ) *
                  (∑ p ∈ Finset.range 58,
                    (wTot.getD p 0 : ℝ) * ((List.ofFn (uFn j)).getD p 0) ^ 2)) *
                100000 ≤ (p' : ℝ) - (n' : ℝ)) →
          P ok p' n') →
        obAllGo rem rows ws wTot posA negA P
  | 0, _, _, _, posA, negA, _, P, hk => by
    simp only [obAllGo]; exact hk true posA negA fun _ ↦ by simp
  | rem + 1, rows, ws, uFn, posA, negA, hrows, P, hk => by
    unfold obAllGo
    rw [list_headD_eq_getD, list_headD_eq_getD]
    simp only [strictNatList_eq]
    have hu := hrows 0 (by omega)
    refine obOrbLoopCPS_sound 58 wTot (rows.getD 0 []) (List.ofFn (uFn 0)) 0 0 0
      hu List.length_ofFn hwlen (by norm_num) (by norm_num) _
      fun dLo dHi hdLo hdHi ↦ ?_
    rw [zero_add] at hdLo hdHi
    simp only [strictNat_eq]
    set S : ℝ := ∑ p ∈ Finset.range 58,
      (wTot.getD p 0 : ℝ) * ((List.ofFn (uFn 0)).getD p 0) ^ 2
    set dl5 := Nat.div dLo 1000
    set dh5 := Nat.div (Nat.add dHi 999) 1000
    have hdl5_raw : (dl5 : ℝ) ≤ S * 100000 := by
      have hf := nat_div_le_real (n := dLo) (d := 1000)
      simp only [dl5, nat_div_def]; linarith
    have hdl5 : (dl5 : ℝ) - ((0 : ℕ) : ℝ) ≤ S * 100000 := by
      rw [Nat.cast_zero, sub_zero]; exact hdl5_raw
    have hdh5_raw : S * 100000 ≤ (dh5 : ℝ) := by
      have hc := real_le_nat_cdiv (n := dHi) (d := 1000) (k := 999) (by decide)
      simp only [dh5, nat_div_def, Nat.add_eq]; push_cast at hc; linarith
    have hle5 : dl5 ≤ dh5 := Nat.cast_le.mp (hdl5_raw.trans hdh5_raw)
    have hdh5 : S * 100000 ≤ (dl5 : ℝ) + ((Nat.sub dh5 dl5 : ℕ) : ℝ) - ((0 : ℕ) : ℝ) := by
      simp only [Nat.sub_eq, Nat.cast_sub hle5, Nat.cast_zero, sub_zero]; linarith
    refine accSignedIv_le hdl5 hdh5 _ fun p1 n1 hacc ↦ ?_
    have hrows' : ∀ j < rem,
        List.Forall₂ ValidOrb5e8 (rows.tail.getD j []) (List.ofFn (uFn (j + 1))) := by
      intro j hj; rw [list_tail_getD]; exact hrows (j + 1) (by omega)
    refine obAllGo_le hwlen rem rows.tail ws.tail (fun j ↦ uFn (j + 1)) p1 n1 hrows' P
      fun ok2 p2 n2 hrec ↦ hk ok2 p2 n2 fun hok2 ↦ ?_
    have hr := hrec hok2
    rw [Finset.sum_range_succ']
    simp_rw [list_tail_getD] at hr
    have hfo : ((ws.getD 0 16384 : ℝ) - (16384 : ℝ)) = (fromOffset (ws.getD 0 16384) : ℝ) :=
      (fromOffset_cast_real _).symm
    simp only [Nat.cast_ofNat] at hacc
    rw [hfo] at hacc; linarith

private lemma obAllGo_comp {α β : Type} (f : α → β) :
    ∀ (rem : ℕ) (rows : List (List ℕ)) (ws wTot : List ℕ) (posA negA : ℕ)
      (k : Bool → ℕ → ℕ → α),
      obAllGo rem rows ws wTot posA negA (fun a b c ↦ f (k a b c)) =
        f (obAllGo rem rows ws wTot posA negA k)
  | 0, _, _, _, _, _, _ => rfl
  | rem + 1, rows, ws, wTot, posA, negA, k => by
    unfold obAllGo; simp only [strictNatList_eq]
    simp_rw [obAllGo_comp f rem]
    simp only [strictNat_eq, accSignedIv_comp]
    exact obOrbLoopCPS_comp f 58 wTot _ 0 0 _

lemma wTotCert_length : wTotCert.length = 58 := by decide

private lemma ob_cert_of_tables (wTot : List ℕ) (hwlen : 58 ≤ wTot.length)
    (obRows : List (List ℕ)) (obW : List ℕ) (uFn : ℕ → Fin 58 → ℝ)
    (hrows : ∀ j < 58, List.Forall₂ ValidOrb5e8 (obRows.getD j []) (List.ofFn (uFn j)))
    (obP obN : ℕ) (target : ℝ)
    (htarget : (∑ j ∈ Finset.range 58,
      (fromOffset (obW.getD j 16384) : ℝ) *
        (∑ p ∈ Finset.range 58,
          (wTot.getD p 0 : ℝ) * ((List.ofFn (uFn j)).getD p 0) ^ 2)) = target)
    (hcert : (obAllGo 58 obRows obW wTot 0 0 fun ok p' n' ↦
      ok && Nat.beq p' obP && Nat.beq n' obN) = true) :
    target * 100000 ≤ (obP : ℝ) - (obN : ℝ) := by
  let goalProp : Prop := target * 100000 ≤ (obP : ℝ) - (obN : ℝ)
  let fImp : Bool → Prop := fun b ↦ b = true → goalProp
  have h1 := obAllGo_le hwlen 58 obRows obW uFn 0 0 hrows
    (fun ok p' n' ↦ fImp (ok && Nat.beq p' obP && Nat.beq n' obN))
    fun ok p' n' hob hk ↦ by
      obtain ⟨hab, hbN⟩ := Bool.and_eq_true_iff.mp hk
      obtain ⟨hok, hbP⟩ := Bool.and_eq_true_iff.mp hab
      have hP := Nat.beq_eq.mp hbP
      have hN := Nat.beq_eq.mp hbN
      subst hP hN
      have hle := hob hok
      rw [htarget] at hle
      simp only [Nat.cast_zero, sub_zero, zero_add] at hle
      exact hle
  rw [obAllGo_comp fImp] at h1
  exact h1 hcert

lemma ob_cert_sound (hcay : checkCayleyCertTop = true)
    (hrot_ob : checkRotObLeavesCert = true) (hcert : checkObCert = true) :
    cipsiObReal * 100000 ≤ (obPCert : ℝ) - (obNCert : ℝ) := by
  unfold checkRotObLeavesCert checkRotObLeavesRangeCert at hrot_ob
  unfold checkObCert at hcert
  simp -iota only [strictNatList_eq, forceList_eq] at hcert
  have hwlen : 58 ≤ wTotCert.length := by rw [wTotCert_length]
  let uFn : ℕ → Fin 58 → ℝ := fun j ↦ rObVec ⟨min j 57, by omega⟩
  have hrows : ∀ j < 58,
      List.Forall₂ ValidOrb5e8 (rotObLeavesCert.getD j []) (List.ofFn (uFn j)) := by
    intro j hj
    have hm : min j 57 = j := Nat.min_eq_left (by omega)
    have hfin : (⟨min j 57, by omega⟩ : Fin 58) = ⟨j, hj⟩ := Fin.ext hm
    dsimp only [uFn]; rw [hfin]
    unfold rObVec rotOneBodyVec oneBodyVector
    have hraw := checkRotLeavesRange_sound deepRotQ_left cayleyQ12Cert_length
      (deepRotQ_cert hcay) hrot_ob hj (by omega)
    simpa only [zero_add] using hraw
  refine ob_cert_of_tables wTotCert hwlen rotObLeavesCert (bvVec oneBodyWeights) uFn
    hrows obPCert obNCert cipsiObReal ?_ hcert
  unfold cipsiObReal
  rw [← Fin.sum_univ_eq_sum_range]
  refine Finset.sum_congr rfl fun ℓ _ ↦ ?_
  have hw : (bvVec oneBodyWeights).getD ℓ.val 16384 =
      (oneBodyWeights.getChunk ℓ).toNat := bvVec_getD oneBodyWeights ℓ 16384
  rw [hw, ← Fin.sum_univ_eq_sum_range]
  refine congr_arg₂ (· * ·) rfl (Finset.sum_congr rfl fun p _ ↦ ?_)
  have hm : min ℓ.val 57 = ℓ.val := Nat.min_eq_left (by omega)
  have hfin : (⟨min ℓ.val 57, by omega⟩ : Fin 58) = ℓ := Fin.ext hm
  have hget : (List.ofFn (uFn ℓ.val)).getD p.val 0 = rObVec ℓ p := by
    rw [ofFn_getD_fin (uFn ℓ.val) p]
    dsimp only [uFn]; rw [hfin]
  rw [hget]
lemma cps3_congr {γ₁ γ₂ γ₃ β : Type} (m : (γ₁ → γ₂ → γ₃ → β) → β)
    {k₁ k₂ : γ₁ → γ₂ → γ₃ → β} (h : ∀ a b c, k₁ a b c = k₂ a b c) : m k₁ = m k₂ :=
  congrArg m (funext fun a ↦ funext fun b ↦ funext fun c ↦ h a b c)

