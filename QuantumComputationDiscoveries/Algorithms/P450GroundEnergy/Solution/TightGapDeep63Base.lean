      push_cast at hprod_lo hprod_hi
      have hlo_b : (pT : ℝ) - (nT : ℝ) - (radT : ℝ) ≤ (M1 * M2) * 250000 := by linarith
      have hhi_b : (M1 * M2) * 250000 ≤ (pT : ℝ) - (nT : ℝ) + (radT : ℝ) := by linarith
