      obtain ⟨hl2, hh2⟩ := h2 hok2
      dsimp only at hl1 hh1 hl2 hh2
      set M1 := keyModeLists uFn iwRow k1
      set M2 := keyModeLists uFn iwRow k2
      set c1 := 2 * l1 + w1
      set c2 := 2 * l2 + w2
      set m1 := absDiffNat c1 250000000
      set m2 := absDiffNat c2 250000000
