          (bp : ℝ) + 18 * (sumPos : ℝ) - (negRaw : ℝ) := by
        rw [Nat.cast_sub hneg_le]; push_cast; ring
      have hbp : (bp : ℝ) + 18 * (sumPos : ℝ) - (negRaw : ℝ) =
          50000000000 * 10000 + ((posRaw : ℝ) - (negRaw : ℝ) + 18 * (sumPos : ℝ)) := by
        simp only [bp]; push_cast; ring
