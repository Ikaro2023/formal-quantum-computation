        f ((if beqBool ref1 (sextetBitNat w2) then
          pushQuadTreeCPS kp1 (Nat.mul 65 (Nat.div w2 2)) wa2 0 t
        else pushQuadTreeCPS kp1 (Nat.mul 65 (Nat.div w2 2)) 0 wa2 t) cont) := by
      split_ifs <;> exact pushQuadTreeCPS_comp f _ _ _ _ t cont
    rw [← h1]
    refine cps2_congr _ fun ok1 tree1 ↦ ?_
    by_cases hnot : (!ok1) = true
    · simp only [hnot, ↓reduceIte]
    · simp only [hnot, Bool.false_eq_true, ↓reduceIte]
      by_cases hsp : beqBool s1Par (Nat.beq (Nat.mod w2 2) 1) = true
      · simp only [hsp, ↓reduceIte]
        have h2 (t : QuadAccTree) (cont : Bool → QuadAccTree → α) :
            (if beqBool ref1 (sextetBitNat w2) then
              pushQuadTreeCPS (pqKey (Nat.div kp1 65) (Nat.div w2 2))
                (pqKey (Nat.div kp1 65) (Nat.div w2 2)) 0 wa2 t
            else pushQuadTreeCPS (pqKey (Nat.div kp1 65) (Nat.div w2 2))
                (pqKey (Nat.div kp1 65) (Nat.div w2 2)) wa2 0 t)
              (fun a b ↦ f (cont a b)) =
            f ((if beqBool ref1 (sextetBitNat w2) then
              pushQuadTreeCPS (pqKey (Nat.div kp1 65) (Nat.div w2 2))
                (pqKey (Nat.div kp1 65) (Nat.div w2 2)) 0 wa2 t
            else pushQuadTreeCPS (pqKey (Nat.div kp1 65) (Nat.div w2 2))
                (pqKey (Nat.div kp1 65) (Nat.div w2 2)) wa2 0 t) cont) := by
          split_ifs <;> exact pushQuadTreeCPS_comp f _ _ _ _ t cont
        rw [← h2]
        refine cps2_congr _ fun ok2 tree2 ↦ ?_
        split_ifs
        · exact diagQuadsInner_comp f wa2 kp1 s1Par ref1 ws tree2 k
