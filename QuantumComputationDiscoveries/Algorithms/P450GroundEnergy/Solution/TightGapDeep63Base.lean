private lemma slice_append_left {α : Type*} {a b : List α} {k n m : ℕ}
    (ha : a.length = m) (h : k + n ≤ m) :
    ((List.append a b).drop k).take n = (a.drop k).take n := by
  rw [List.append_eq, List.drop_append, ha, Nat.sub_eq_zero_of_le (by omega),
    List.drop_zero, List.take_append, List.length_drop, ha,
    Nat.sub_eq_zero_of_le (by omega), List.take_zero, List.append_nil]

private lemma slice_append_right {α : Type*} {a b : List α} {k n m : ℕ}
    (ha : a.length = m) (h : m ≤ k) :
    ((List.append a b).drop k).take n = (b.drop (k - m)).take n := by
  rw [List.append_eq, List.drop_append, ha, List.drop_eq_nil_of_le (by omega),
    List.nil_append]

private lemma slice_zero_self {α : Type*} {a : List α} {n : ℕ} (h : a.length = n) :
    (a.drop 0).take n = a := by
  rw [List.drop_zero, ← h, List.take_length]

