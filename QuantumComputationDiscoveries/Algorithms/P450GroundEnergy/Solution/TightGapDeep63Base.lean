local instance (priority := 100000) instNeZeroTwoPow (k : ℕ) : NeZero (2 ^ k) :=
  ⟨Nat.pos_iff_ne_zero.mp (Nat.two_pow_pos k)⟩

/-- `ψ` is a `63`-electron eigenvector of `thcHamiltonian dfthc` with eigenvalue `E`,
definitionally matching `IsEigen` inside `MeasuresLowEnergies (thcHamiltonian dfthc) 63`. -/
abbrev IsEigen63 (E : ℝ) (ψ : Fin (2 ^ (2 * 58)) → ℂ) : Prop :=
  thcHamiltonian dfthc *ᵥ ψ = (E : ℂ) • ψ ∧
    electronSectorProjector (2 * 58) 63 *ᵥ ψ = ψ ∧ ψ ≠ 0

private lemma list_getD_eq_getElem {α : Type*} (xs : List α) (d : α) {i : ℕ}
    (h : i < xs.length) : xs.getD i d = xs[i] := by
  simp [List.getD, h]

private lemma list_getD_eq_default {α : Type*} (xs : List α) (d : α) {i : ℕ}
    (h : xs.length ≤ i) : xs.getD i d = d := by
  simp [List.getD, h]

/-! ## Part 1: Invariant-Subspace Hermitian Minimum-Eigenvalue Bridge -/

lemma star_dotProduct_self_eq_sum_normSq {d : ℕ} (v : Fin d → ℂ) :
    star v ⬝ᵥ v = ((∑ i : Fin d, Complex.normSq (v i) : ℝ) : ℂ) := by
  simp only [dotProduct, Pi.star_apply, RCLike.star_def, ← Complex.normSq_eq_conj_mul_self,
    Complex.ofReal_sum]

/-- Variational Rayleigh–Ritz principle on an invariant projector subspace:
if `H` and `P` are commuting Hermitian matrices with `P² = P`, and `ψ` is a unit vector in the
`+1` eigenspace of `P` with Rayleigh quotient at most `E_var`, then `H` has an actual unit
eigenvector `φ₀` in the `+1` eigenspace of `P` with eigenvalue `E₀ ≤ E_var`. -/
theorem exists_eigen_of_variational {d : ℕ} {H P : Operator d} {E_var : ℝ} {ψ : Fin d → ℂ}
    (hH : H.IsHermitian) (hP : P.IsHermitian) (hP2 : P * P = P) (hHP : H * P = P * H)
    (hψP : P *ᵥ ψ = ψ) (hψ1 : ∑ i, Complex.normSq (ψ i) = 1)
    (hvar : (star ψ ⬝ᵥ (H *ᵥ ψ)).re ≤ E_var) :
    ∃ (E₀ : ℝ) (φ₀ : Fin d → ℂ),
      H *ᵥ φ₀ = (E₀ : ℂ) • φ₀ ∧ P *ᵥ φ₀ = φ₀ ∧ φ₀ ≠ 0 ∧
        ∑ i, Complex.normSq (φ₀ i) = 1 ∧ E₀ ≤ E_var := by
  let C : ℝ := E_var + 1
  let B : Operator d := P * (H - (C : ℂ) • 1) * P
  have hB : B.IsHermitian := by
    change Bᴴ = B
    simp only [B, conjTranspose_mul, conjTranspose_sub, conjTranspose_smul, conjTranspose_one,
      hH.eq, hP.eq, RCLike.star_def, Complex.conj_ofReal, Matrix.mul_assoc]
  have hP_dot (v : Fin d → ℂ) : star ψ ⬝ᵥ (P *ᵥ v) = star ψ ⬝ᵥ v := by
    rw [dotProduct_mulVec, ← hP.eq, ← Matrix.star_mulVec, hψP]
  have hBψ : B *ᵥ ψ = P *ᵥ (H *ᵥ ψ - (C : ℂ) • ψ) := by
    simp only [B, Matrix.mul_assoc, ← mulVec_mulVec, hψP, sub_mulVec, smul_mulVec, one_mulVec]
  have hBre : (star ψ ⬝ᵥ (B *ᵥ ψ)).re ≤ -1 := by
    rw [hBψ, hP_dot, dotProduct_sub, dotProduct_smul, star_dotProduct_self_eq_sum_normSq, hψ1]
    simp only [C, smul_eq_mul, Complex.ofReal_one, mul_one, Complex.sub_re, Complex.ofReal_re]
    linarith
  let U : 𝐔[Fin d] := hB.eigenvectorUnitary
  let w : Fin d → ℂ := (star U : 𝐔[Fin d]).1 *ᵥ ψ
  have hw_norm : ∑ j : Fin d, Complex.normSq (w j) = 1 :=
    (sum_normSq_unitary_mulVec (star U) ψ).trans hψ1
  have hB_spec :
      (star ψ ⬝ᵥ (B *ᵥ ψ)).re = ∑ j : Fin d, hB.eigenvalues j * Complex.normSq (w j) := by
    have hspec := hB.spectral_theorem
    rw [Unitary.conjStarAlgAut_apply] at hspec
    change B = U.1 * diagonal (RCLike.ofReal ∘ hB.eigenvalues) * (star U : 𝐔[Fin d]).1 at hspec
    have hBw : B *ᵥ ψ = U.1 *ᵥ (diagonal (RCLike.ofReal ∘ hB.eigenvalues) *ᵥ w) := by
      conv_lhs => rw [hspec]
      simp only [Matrix.mul_assoc, ← mulVec_mulVec, w]
    have hUstar : star w = star ψ ᵥ* U.1 := by
      have h1 : (star U : 𝐔[Fin d]).1 = U.1ᴴ := Matrix.star_eq_conjTranspose U.1
      calc
        star w = star (U.1ᴴ *ᵥ ψ) := by rw [← h1]
        _ = star ψ ᵥ* (U.1ᴴ)ᴴ := Matrix.star_mulVec _ _
        _ = star ψ ᵥ* U.1 := by rw [conjTranspose_conjTranspose]
    rw [hBw, dotProduct_mulVec, ← hUstar]
    have hdiag :
        star w ⬝ᵥ (diagonal (RCLike.ofReal ∘ hB.eigenvalues) *ᵥ w) =
          ∑ j : Fin d, ((hB.eigenvalues j * Complex.normSq (w j) : ℝ) : ℂ) := by
      simp only [dotProduct, mulVec_diagonal, Pi.star_apply, RCLike.star_def, Function.comp_apply,
        RCLike.ofReal_eq_complex_ofReal]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [← mul_assoc, mul_comm (starRingEnd ℂ (w j)), mul_assoc,
        ← Complex.normSq_eq_conj_mul_self, Complex.ofReal_mul]
    rw [hdiag, ← Complex.ofReal_sum, Complex.ofReal_re]
  have hex : ∃ j₀ : Fin d, hB.eigenvalues j₀ ≤ -1 := by
    by_contra! hgt
    have hj_nonneg : ∀ j : Fin d, 0 ≤ Complex.normSq (w j) := fun j ↦ Complex.normSq_nonneg _
    have hex_pos : ∃ j₁ : Fin d, 0 < Complex.normSq (w j₁) := by
      by_contra! hall0
      have h0 : ∑ j : Fin d, Complex.normSq (w j) = 0 :=
        Finset.sum_eq_zero fun j _ ↦ le_antisymm (hall0 j) (hj_nonneg j)
      linarith
    obtain ⟨j₁, hj₁⟩ := hex_pos
    have hlt :
        ∑ j : Fin d, (-1 : ℝ) * Complex.normSq (w j) <
          ∑ j : Fin d, hB.eigenvalues j * Complex.normSq (w j) := by
      refine Finset.sum_lt_sum (fun j _ ↦ ?_) ⟨j₁, Finset.mem_univ j₁, ?_⟩
      · exact mul_le_mul_of_nonneg_right (hgt j).le (hj_nonneg j)
      · exact mul_lt_mul_of_pos_right (hgt j₁) hj₁
    rw [← Finset.mul_sum, hw_norm, mul_one, ← hB_spec] at hlt
    linarith
  obtain ⟨j₀, hj₀⟩ := hex
  let μ₀ : ℝ := hB.eigenvalues j₀
  let φ₀ : Fin d → ℂ := ⇑(hB.eigenvectorBasis j₀)
  have hPB_left : P * B = B := by simp only [B, ← Matrix.mul_assoc, hP2]
  have hBφ : B *ᵥ φ₀ = (μ₀ : ℂ) • φ₀ := by
    have h := hB.mulVec_eigenvectorBasis j₀
    ext i
    simpa [μ₀, φ₀, Complex.real_smul] using congrFun h i
  have hPφ : P *ᵥ φ₀ = φ₀ := by
    have hμ_ne : (μ₀ : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (by change hB.eigenvalues j₀ ≠ 0; linarith)
    have h1 : (μ₀ : ℂ) • (P *ᵥ φ₀) = (μ₀ : ℂ) • φ₀ := by
      rw [← mulVec_smul, ← hBφ, mulVec_mulVec, hPB_left, hBφ]
    calc
      P *ᵥ φ₀ = (μ₀ : ℂ)⁻¹ • ((μ₀ : ℂ) • (P *ᵥ φ₀)) := (inv_smul_smul₀ hμ_ne _).symm
      _ = (μ₀ : ℂ)⁻¹ • ((μ₀ : ℂ) • φ₀) := by rw [h1]
      _ = φ₀ := inv_smul_smul₀ hμ_ne _
  refine ⟨μ₀ + C, φ₀, ?_, hPφ, ?_, ?_, ?_⟩
  · have hPB_eq : B = (H - (C : ℂ) • 1) * P := by
      calc
        B = (P * H - P * ((C : ℂ) • 1)) * P := by simp [B, mul_sub]
        _ = (H * P - (C : ℂ) • P) * P := by rw [← hHP, mul_smul_comm, mul_one]
        _ = (H - (C : ℂ) • 1) * (P * P) := by
          simp only [sub_mul, Matrix.mul_assoc, smul_mul_assoc, one_mul]
        _ = (H - (C : ℂ) • 1) * P := by rw [hP2]
    have hBφ2 : B *ᵥ φ₀ = H *ᵥ φ₀ - (C : ℂ) • φ₀ := by
      rw [hPB_eq, ← mulVec_mulVec, hPφ, sub_mulVec, smul_mulVec, one_mulVec]
    rw [hBφ2] at hBφ
    calc
      H *ᵥ φ₀ = (H *ᵥ φ₀ - (C : ℂ) • φ₀) + (C : ℂ) • φ₀ := (sub_add_cancel _ _).symm
      _ = (μ₀ : ℂ) • φ₀ + (C : ℂ) • φ₀ := by rw [hBφ]
      _ = ((μ₀ + C : ℝ) : ℂ) • φ₀ := by rw [← add_smul]; dsimp only [C]; push_cast; rfl
  · have hφ_norm : ∑ i : Fin d, Complex.normSq (φ₀ i) = 1 := by
      have hcol : U.1 *ᵥ Pi.single j₀ 1 = φ₀ := hB.eigenvectorUnitary_mulVec j₀
      rw [← hcol, sum_normSq_unitary_mulVec]
      simp [Pi.single_apply]
    intro h0
    rw [h0] at hφ_norm
    simp at hφ_norm
  · have hcol : U.1 *ᵥ Pi.single j₀ 1 = φ₀ := hB.eigenvectorUnitary_mulVec j₀
    rw [← hcol, sum_normSq_unitary_mulVec]
    simp [Pi.single_apply]
  · change hB.eigenvalues j₀ + (E_var + 1) ≤ E_var
    linarith

/-! ## Part 2: Hermiticity and Sector Commutation of `thcHamiltonian` -/

private def bitWeight (k : ℕ) (i : Fin (2 ^ k)) : ℕ :=
  ∑ q : Fin k, (basisBits k i q).val

private def ShiftsWeight (k : ℕ) (δ : ℤ) (A : Operator (2 ^ k)) : Prop :=
  ∀ r c : Fin (2 ^ k), A r c ≠ 0 → (bitWeight k r : ℤ) = (bitWeight k c : ℤ) + δ

private lemma shiftsWeight_zero_diag {k : ℕ} (d : Fin (2 ^ k) → ℂ) :
    ShiftsWeight k 0 (Matrix.diagonal d) := by
  intro r c hne
  by_cases hrc : r = c
  · subst hrc; omega
  · exfalso; exact hne (Matrix.diagonal_apply_ne _ hrc)

private lemma shiftsWeight_conjTranspose {k : ℕ} {δ : ℤ} {A : Operator (2 ^ k)}
    (hA : ShiftsWeight k δ A) : ShiftsWeight k (-δ) Aᴴ := by
  intro r c hne
  have hcr : A c r ≠ 0 := by
    intro h0; apply hne; simp [Matrix.conjTranspose_apply, h0]
  have h := hA c r hcr
  omega

private lemma shiftsWeight_mul {k : ℕ} {δ₁ δ₂ : ℤ} {A B : Operator (2 ^ k)}
    (hA : ShiftsWeight k δ₁ A) (hB : ShiftsWeight k δ₂ B) :
    ShiftsWeight k (δ₁ + δ₂) (A * B) := by
  intro r c hne
  rw [Matrix.mul_apply] at hne
  obtain ⟨m, _, hm⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
  have h1 := hA r m (left_ne_zero_of_mul hm)
  have h2 := hB m c (right_ne_zero_of_mul hm)
  omega

private lemma shiftsWeight_add {k : ℕ} {δ : ℤ} {A B : Operator (2 ^ k)}
    (hA : ShiftsWeight k δ A) (hB : ShiftsWeight k δ B) :
    ShiftsWeight k δ (A + B) := by
  intro r c hne
  rw [Matrix.add_apply] at hne
  by_cases h : A r c ≠ 0
  · exact hA r c h
  · rw [not_not] at h
    rw [h, zero_add] at hne
    exact hB r c hne

private lemma shiftsWeight_smul {k : ℕ} {δ : ℤ} (α : ℂ) {A : Operator (2 ^ k)}
    (hA : ShiftsWeight k δ A) : ShiftsWeight k δ (α • A) := by
  intro r c hne
  rw [Matrix.smul_apply, smul_eq_mul] at hne
  exact hA r c (right_ne_zero_of_mul hne)

private lemma shiftsWeight_sum {ι : Type*} {k : ℕ} {δ : ℤ} (s : Finset ι)
    (f : ι → Operator (2 ^ k)) (hf : ∀ x ∈ s, ShiftsWeight k δ (f x)) :
    ShiftsWeight k δ (∑ x ∈ s, f x) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro r c hne
    simp at hne
  | @insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact shiftsWeight_add (hf a (Finset.mem_insert_self a s))
      (ih fun x hx ↦ hf x (Finset.mem_insert_of_mem hx))

private lemma basisBits_one_val_sbtg (x : Fin (2 ^ 1)) :
    (basisBits 1 x 0).val = x.val := by
  fin_cases x <;> decide

private lemma singleton_extractIndex_val_sbtg {k : ℕ} (q : Fin k) (i : Fin (2 ^ k)) :
    ((QRegister.singleton q).extractIndex i).val = (basisBits k i q).val := by
  rw [← basisBits_one_val_sbtg ((QRegister.singleton q).extractIndex i),
    QRegister.basisBits_extractIndex, QRegister.singleton_apply]

private lemma jwAnnihilate_shiftsWeight (k : ℕ) (j : Fin k) :
    ShiftsWeight k (-1) (jwAnnihilate k j) := by
  rw [jwAnnihilate]
  have h1 := shiftsWeight_zero_diag
    (fun i : Fin (2 ^ k) ↦ (-1 : ℂ) ^ ∑ q ∈ Finset.univ.filter (· < j), (basisBits k i q).val)
  suffices h2 : ShiftsWeight k (-1)
      ((QRegister.singleton j).embedMatrix (Matrix.single (0 : Fin 2) (1 : Fin 2) 1)) by
    simpa using shiftsWeight_mul h1 h2
  intro r c hne
  rw [QRegister.embedMatrix_apply_of_agreeOutside] at hne
  have h_agree : (QRegister.singleton j).AgreeOutside r c := by
    by_contra hna
    simp [hna] at hne
  have h_loc : Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ)
      ((QRegister.singleton j).extractIndex r) ((QRegister.singleton j).extractIndex c) ≠ 0 :=
    left_ne_zero_of_mul hne
  have hr0 : ((QRegister.singleton j).extractIndex r).val = 0 := by
    rcases hxr : (QRegister.singleton j).extractIndex r with ⟨v, hv⟩
    interval_cases v
    · rfl
    · exfalso; apply h_loc; simp [hxr]
  have hc1 : ((QRegister.singleton j).extractIndex c).val = 1 := by
    rcases hxc : (QRegister.singleton j).extractIndex c with ⟨v, hv⟩
    interval_cases v
    · exfalso; apply h_loc; simp [hxc]
    · rfl
  rw [singleton_extractIndex_val_sbtg] at hr0 hc1
  have h_rest :
      ∑ q ∈ Finset.univ.erase j, (basisBits k r q).val =
        ∑ q ∈ Finset.univ.erase j, (basisBits k c q).val := by
    refine Finset.sum_congr rfl fun q hq ↦ ?_
    have hqne : q ≠ j := Finset.ne_of_mem_erase hq
    have hout : q ∉ Set.range (QRegister.singleton j).wires := by
      rintro ⟨x, hx⟩
      fin_cases x
      exact hqne hx.symm
    rw [h_agree q hout]
  have hwr : bitWeight k r =
      (basisBits k r j).val + ∑ q ∈ Finset.univ.erase j, (basisBits k r q).val := by
    rw [bitWeight, ← Finset.add_sum_erase _ _ (Finset.mem_univ j)]
  have hwc : bitWeight k c =
      (basisBits k c j).val + ∑ q ∈ Finset.univ.erase j, (basisBits k c q).val := by
    rw [bitWeight, ← Finset.add_sum_erase _ _ (Finset.mem_univ j)]
  rw [hwr, hwc, hr0, hc1, h_rest]
  omega

private lemma shiftsWeight_zero_comm_electronSectorProjector {k : ℕ} (η : ℕ)
    {A : Operator (2 ^ k)} (hA : ShiftsWeight k 0 A) :
    A * electronSectorProjector k η = electronSectorProjector k η * A := by
  ext r c
  rw [electronSectorProjector, Matrix.mul_diagonal, Matrix.diagonal_mul]
  by_cases h0 : A r c = 0
  · simp [h0]
  · have hw : bitWeight k r = bitWeight k c := by
      have h := hA r c h0
      omega
    change A r c * (if bitWeight k c = η then 1 else 0) =
      (if bitWeight k r = η then 1 else 0) * A r c
    rw [hw, mul_comm]

theorem electronSectorProjector_isHermitian (k η : ℕ) :
    (electronSectorProjector k η).IsHermitian := by
  change (electronSectorProjector k η)ᴴ = electronSectorProjector k η
  rw [electronSectorProjector, Matrix.diagonal_conjTranspose]
  congr 1; ext i
  by_cases hi : (∑ q, (basisBits k i q).val) = η <;> simp [hi]

theorem electronSectorProjector_mul_self (k η : ℕ) :
    electronSectorProjector k η * electronSectorProjector k η = electronSectorProjector k η := by
  rw [electronSectorProjector, Matrix.diagonal_mul_diagonal]
  congr 1; ext i
  by_cases hi : (∑ q, (basisBits k i q).val) = η <;> simp [hi]

lemma orbitalNumberOp_isHermitian {N : ℕ} (χ : Fin N → ℝ) (σ : Fin 2) :
    (orbitalNumberOp N χ σ).IsHermitian := by
  change (orbitalNumberOp N χ σ)ᴴ = orbitalNumberOp N χ σ
  simp [orbitalNumberOp, Matrix.conjTranspose_mul]

private lemma oneBodyHamiltonian_isHermitian {N : ℕ} {h : Matrix (Fin N) (Fin N) ℝ}
    (hh : h.IsSymm) : (oneBodyHamiltonian h).IsHermitian := by
  change (oneBodyHamiltonian h)ᴴ = oneBodyHamiltonian h
  simp only [oneBodyHamiltonian, conjTranspose_sum, conjTranspose_smul, conjTranspose_mul,
    conjTranspose_conjTranspose, RCLike.star_def, Complex.conj_ofReal]
  refine Finset.sum_congr rfl fun σ _ ↦ ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun p _ ↦ Finset.sum_congr rfl fun q _ ↦ ?_
  rw [hh.apply q p]

theorem thcHamiltonian_isHermitian {N M : ℕ} (thc : THCFactorization N M) :
    (thcHamiltonian thc).IsHermitian := by
  change (thcHamiltonian thc)ᴴ = thcHamiltonian thc
  rw [thcHamiltonian, conjTranspose_add, (oneBodyHamiltonian_isHermitian thc.h1eMod_symm).eq,
    conjTranspose_smul]
  congr 1
  have h2 : star (2 : ℂ)⁻¹ = (2 : ℂ)⁻¹ := by simp
  rw [h2]
  congr 1
  simp only [conjTranspose_sum, conjTranspose_smul, conjTranspose_mul,
    (orbitalNumberOp_isHermitian _ _).eq, RCLike.star_def, Complex.conj_ofReal]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun τ _ ↦ Finset.sum_congr rfl fun σ _ ↦ ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ν _ ↦ Finset.sum_congr rfl fun μ _ ↦ ?_
  rw [thc.zeta_symm.apply ν μ]

theorem thcHamiltonian_comm_electronSectorProjector {N M : ℕ} (thc : THCFactorization N M)
    (η : ℕ) :
    thcHamiltonian thc * electronSectorProjector (2 * N) η =
      electronSectorProjector (2 * N) η * thcHamiltonian thc := by
  apply shiftsWeight_zero_comm_electronSectorProjector
  have hob : ShiftsWeight (2 * N) 0 (oneBodyHamiltonian thc.h1eMod) := by
    refine shiftsWeight_sum _ _ fun σ _ ↦ shiftsWeight_sum _ _ fun p _ ↦
      shiftsWeight_sum _ _ fun q _ ↦ shiftsWeight_smul _ ?_
    simpa using shiftsWeight_mul
      (shiftsWeight_conjTranspose (jwAnnihilate_shiftsWeight (2 * N) (spinOrbital N p σ)))
      (jwAnnihilate_shiftsWeight (2 * N) (spinOrbital N q σ))
  have horb (χ : Fin N → ℝ) (σ : Fin 2) : ShiftsWeight (2 * N) 0 (orbitalNumberOp N χ σ) := by
    have hb : ShiftsWeight (2 * N) (-1)
        (∑ p : Fin N, (χ p : ℂ) • jwAnnihilate (2 * N) (spinOrbital N p σ)) :=
      shiftsWeight_sum _ _ fun p _ ↦
        shiftsWeight_smul _ (jwAnnihilate_shiftsWeight (2 * N) (spinOrbital N p σ))
    simpa [orbitalNumberOp] using shiftsWeight_mul (shiftsWeight_conjTranspose hb) hb
  refine shiftsWeight_add hob (shiftsWeight_smul _ ?_)
  exact shiftsWeight_sum _ _ fun σ _ ↦ shiftsWeight_sum _ _ fun τ _ ↦
    shiftsWeight_sum _ _ fun μ _ ↦ shiftsWeight_sum _ _ fun ν _ ↦
      shiftsWeight_smul _ (by simpa using shiftsWeight_mul (horb _ _) (horb _ _))

/-! ## Part 3: Computational-Basis Slater Determinant Expectation Formula -/

/-- Basis state index in `Fin (2 ^ k)` whose bit string is `b`. -/
noncomputable def detIdx {k : ℕ} (b : Fin k → Bool) : Fin (2 ^ k) :=
  (basisBits k).symm (fun q ↦ if b q then 1 else 0)

/-- Computational-basis unit vector `|b⟩` in `Fin (2 ^ k) → ℂ`. -/
noncomputable def detVec {k : ℕ} (b : Fin k → Bool) : Fin (2 ^ k) → ℂ :=
  Pi.single (detIdx b) 1

private lemma basisBits_detIdx {k : ℕ} (b : Fin k → Bool) (q : Fin k) :
    basisBits k (detIdx b) q = if b q then 1 else 0 :=
  congrFun ((basisBits k).apply_symm_apply _) q

private lemma basisBits_detIdx_val {k : ℕ} (b : Fin k → Bool) (q : Fin k) :
    (basisBits k (detIdx b) q).val = if b q then 1 else 0 := by
  rw [basisBits_detIdx]
  split_ifs <;> decide

lemma detIdx_injective {k : ℕ} : Function.Injective (@detIdx k) := by
  intro b₁ b₂ h
  have hbits := congrArg (basisBits k) h
  ext q
  have hq := congrFun hbits q
  rw [basisBits_detIdx, basisBits_detIdx] at hq
  cases hb₁ : b₁ q <;> cases hb₂ : b₂ q <;> simp_all

lemma detVec_normSq_sum {k : ℕ} (b : Fin k → Bool) :
    ∑ i : Fin (2 ^ k), Complex.normSq (detVec b i) = 1 := by
  simp [detVec, Pi.single_apply]

lemma star_detVec_dotProduct_detVec {k : ℕ} (b₁ b₂ : Fin k → Bool) :
    star (detVec b₁) ⬝ᵥ detVec b₂ = if b₁ = b₂ then 1 else 0 := by
  by_cases h : b₁ = b₂
  · subst h; simp [detVec, dotProduct, Pi.single_apply]
  · have hne : detIdx b₂ ≠ detIdx b₁ := fun heq ↦ h (detIdx_injective heq.symm)
    simp [detVec, dotProduct, Pi.single_apply, h, hne]

lemma electronSectorProjector_mulVec_detVec {k η : ℕ} (b : Fin k → Bool)
    (hwt : (∑ q : Fin k, if b q then 1 else 0) = η) :
    electronSectorProjector k η *ᵥ detVec b = detVec b := by
  rw [electronSectorProjector, detVec, Matrix.diagonal_mulVec_single]
  have hbw : (∑ q : Fin k, (basisBits k (detIdx b) q).val) = η := by
    simp_rw [basisBits_detIdx_val]
    exact hwt
  simp [hbw]

/-- Jordan-Wigner parity sign `(-1)^{∑_{q < j} b_q}` at wire `j`. -/
def jwSign {k : ℕ} (b : Fin k → Bool) (j : Fin k) : ℂ :=
  (-1 : ℂ) ^ ∑ q ∈ Finset.univ.filter (· < j), (if b q then 1 else 0)

lemma star_jwSign {k : ℕ} (b : Fin k → Bool) (j : Fin k) :
    star (jwSign b j) = jwSign b j := by
  simp [jwSign]

lemma jwSign_mul_self {k : ℕ} (b : Fin k → Bool) (j : Fin k) :
    jwSign b j * jwSign b j = 1 := by
  rw [jwSign, ← pow_add, ← two_mul, pow_mul]
  norm_num

private lemma singleton_replaceIndex_detIdx {k : ℕ} (b : Fin k → Bool) (j : Fin k)
    (v : Bool) :
    (QRegister.singleton j).replaceIndex (detIdx b) (if v then 1 else 0) =
      detIdx (Function.update b j v) := by
  apply (basisBits k).injective
  ext q
  rw [basisBits_detIdx]
  by_cases hqj : q = j
  · subst hqj
    have h0 := (QRegister.singleton q).basisBits_replaceIndex_apply (detIdx b)
      (if v then 1 else 0) 0
    rw [QRegister.singleton_apply] at h0
    rw [h0, Function.update_self]
    cases v <;> decide
  · have hout : q ∉ Set.range (QRegister.singleton j).wires := by
      rintro ⟨x, hx⟩; fin_cases x; exact hqj hx.symm
    rw [(QRegister.singleton j).basisBits_replaceIndex_of_not_mem _ _ q hout,
      basisBits_detIdx, Function.update_of_ne hqj]

private lemma singleton_extractIndex_detIdx {k : ℕ} (b : Fin k → Bool) (j : Fin k) :
    (QRegister.singleton j).extractIndex (detIdx b) = if b j then 1 else 0 := by
  apply Fin.ext
  rw [singleton_extractIndex_val_sbtg, basisBits_detIdx_val]
  cases b j <;> rfl

private lemma single01_mulVec_single (x : Fin (2 ^ 1)) :
    Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ) *ᵥ Pi.single x 1 =
      if x = 1 then Pi.single 0 1 else 0 := by
  fin_cases x <;> ext y <;> fin_cases y <;>
    simp [Matrix.mulVec, dotProduct, Matrix.single_apply, Pi.single_apply]

private lemma single10_mulVec_single (x : Fin (2 ^ 1)) :
    (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ))ᴴ *ᵥ Pi.single x 1 =
      if x = 0 then Pi.single 1 1 else 0 := by
  fin_cases x <;> ext y <;> fin_cases y <;>
    simp [Matrix.mulVec, dotProduct, Matrix.single_apply, Pi.single_apply]

lemma jwAnnihilate_mulVec_detVec {k : ℕ} (b : Fin k → Bool) (j : Fin k) :
    jwAnnihilate k j *ᵥ detVec b =
      if b j then jwSign b j • detVec (Function.update b j false) else 0 := by
  rw [jwAnnihilate, ← mulVec_mulVec, detVec, QRegister.embedMatrix_mulVec_single_factors,
    singleton_extractIndex_detIdx, single01_mulVec_single]
  cases hbj : b j
  · simp
  · simp only [↓reduceIte]
    rw [(QRegister.singleton j).tensorState_single_replaceIndex]
    have hrep := singleton_replaceIndex_detIdx b j false
    simp only [Bool.false_eq_true, ↓reduceIte] at hrep
    rw [hrep, Matrix.diagonal_mulVec_single]
    have hexp :
        (∑ q ∈ Finset.univ.filter (· < j),
          (basisBits k (detIdx (Function.update b j false)) q).val) =
          ∑ q ∈ Finset.univ.filter (· < j), (if b q then 1 else 0) := by
      refine Finset.sum_congr rfl fun q hq ↦ ?_
      have hne : q ≠ j := (Finset.mem_filter.mp hq).2.ne
      rw [basisBits_detIdx_val, Function.update_of_ne hne]
    rw [hexp, mul_one]
    ext x; simp [detVec, jwSign, Pi.single_apply]

lemma jwAnnihilate_conjTranspose_mulVec_detVec {k : ℕ} (b : Fin k → Bool) (j : Fin k) :
    (jwAnnihilate k j)ᴴ *ᵥ detVec b =
      if b j then 0 else jwSign b j • detVec (Function.update b j true) := by
  have hdiag :
      (Matrix.diagonal fun i : Fin (2 ^ k) ↦
        (-1 : ℂ) ^ ∑ q ∈ Finset.univ.filter (· < j), (basisBits k i q).val)ᴴ =
      Matrix.diagonal fun i : Fin (2 ^ k) ↦
        (-1 : ℂ) ^ ∑ q ∈ Finset.univ.filter (· < j), (basisBits k i q).val := by
    rw [Matrix.diagonal_conjTranspose]; congr 1; ext i; simp
  rw [jwAnnihilate, conjTranspose_mul, hdiag, ← (QRegister.singleton j).embedMatrix_conjTranspose,
    ← mulVec_mulVec, detVec, Matrix.diagonal_mulVec_single]
  have hexp :
      (∑ q ∈ Finset.univ.filter (· < j), (basisBits k (detIdx b) q).val) =
        ∑ q ∈ Finset.univ.filter (· < j), (if b q then 1 else 0) := by
    refine Finset.sum_congr rfl fun q _ ↦ basisBits_detIdx_val b q
  have hps :
      Pi.single (detIdx b)
        ((-1 : ℂ) ^ (∑ q ∈ Finset.univ.filter (· < j), (basisBits k (detIdx b) q).val) * 1) =
      jwSign b j • Pi.single (detIdx b) 1 := by
    rw [hexp, mul_one]
    ext x; simp [jwSign, Pi.single_apply]
  rw [hps, mulVec_smul, QRegister.embedMatrix_mulVec_single_factors,
    singleton_extractIndex_detIdx, single10_mulVec_single]
  cases hbj : b j
  · simp only [Bool.false_eq_true, ↓reduceIte]
    rw [(QRegister.singleton j).tensorState_single_replaceIndex]
    have hrep := singleton_replaceIndex_detIdx b j true
    simp only [↓reduceIte] at hrep
    rw [hrep]; rfl
  · simp

lemma spinOrbital_injective {N : ℕ} :
    Function.Injective (fun ps : Fin N × Fin 2 ↦ spinOrbital N ps.1 ps.2) := by
  rintro ⟨p₁, σ₁⟩ ⟨p₂, σ₂⟩ h
  have hv := congrArg Fin.val h
  dsimp [spinOrbital] at hv
  have hσ₁ : σ₁.val < 2 := σ₁.isLt
  have hσ₂ : σ₂.val < 2 := σ₂.isLt
  ext <;> dsimp <;> omega

lemma spinOrbital_ne_of_ne {N : ℕ} {p q : Fin N} (σ : Fin 2) (hpq : p ≠ q) :
    spinOrbital N p σ ≠ spinOrbital N q σ :=
  fun h ↦ hpq (Prod.mk.inj (spinOrbital_injective h)).1

/-- Occupied-orbital overlap `∑_{q : b(q,σ)} u_q v_q` for spin `σ`. -/
def occDot {N : ℕ} (b : Fin (2 * N) → Bool) (σ : Fin 2) (u v : Fin N → ℝ) : ℝ :=
  ∑ q : Fin N, if b (spinOrbital N q σ) then u q * v q else 0

/-- Virtual-orbital overlap `∑_{p : !b(p,σ)} u_p v_p` for spin `σ`. -/
def virtDot {N : ℕ} (b : Fin (2 * N) → Bool) (σ : Fin 2) (u v : Fin N → ℝ) : ℝ :=
  ∑ p : Fin N, if !b (spinOrbital N p σ) then u p * v p else 0

/-- Single-excitation occupation bitstring moving an electron from `wHole` to `wPart`. -/
def excite {k : ℕ} (b : Fin k → Bool) (wHole wPart : Fin k) : Fin k → Bool :=
  Function.update (Function.update b wHole false) wPart true

/-- Fermionic Jordan-Wigner sign of exciting from `wHole` to `wPart` on `b`. -/
def exciteSign {k : ℕ} (b : Fin k → Bool) (wHole wPart : Fin k) : ℂ :=
  jwSign b wHole * jwSign (Function.update b wHole false) wPart

lemma excite_ne_self {k : ℕ} {b : Fin k → Bool} {wHole wPart : Fin k}
    (hp : b wPart = false) : excite b wHole wPart ≠ b := by
  intro heq
  have h1 := congrFun heq wPart
  simp [excite, hp] at h1

lemma excite_eq_iff {k : ℕ} {b : Fin k → Bool} {h₁ p₁ h₂ p₂ : Fin k}
    (hh₁ : b h₁ = true) (hp₁ : b p₁ = false)
    (hh₂ : b h₂ = true) (hp₂ : b p₂ = false) :
    excite b h₁ p₁ = excite b h₂ p₂ ↔ h₁ = h₂ ∧ p₁ = p₂ := by
  constructor
  · intro heq
    have hne₁ : p₁ ≠ h₁ := by intro h; subst h; simp [hh₁] at hp₁
    have hne₂ : p₂ ≠ h₂ := by intro h; subst h; simp [hh₂] at hp₂
    have hp_eq : p₁ = p₂ := by
      by_contra hne_p
      have hv := congrFun heq p₁
      simp only [excite, Function.update_self] at hv
      rw [Function.update_of_ne hne_p] at hv
      by_cases hp₁h₂ : p₁ = h₂
      · subst hp₁h₂; simp [hh₂] at hp₁
      · rw [Function.update_of_ne hp₁h₂, hp₁] at hv
        exact Bool.noConfusion hv
    subst hp_eq
    refine ⟨?_, rfl⟩
    by_contra hne_h
    have hv := congrFun heq h₁
    simp only [excite, Function.update_of_ne hne₁.symm, Function.update_self] at hv
    rw [Function.update_of_ne hne_h] at hv
    rw [hh₁] at hv
    exact Bool.noConfusion hv
  · rintro ⟨rfl, rfl⟩; rfl

lemma star_exciteSign_mul_self {k : ℕ} (b : Fin k → Bool) (wHole wPart : Fin k) :
    star (exciteSign b wHole wPart) * exciteSign b wHole wPart = 1 := by
  simp only [exciteSign, star_mul', star_jwSign]
  calc
    (jwSign b wHole * jwSign (Function.update b wHole false) wPart) *
        (jwSign b wHole * jwSign (Function.update b wHole false) wPart)
      = (jwSign b wHole * jwSign b wHole) *
          (jwSign (Function.update b wHole false) wPart *
            jwSign (Function.update b wHole false) wPart) := by ring
    _ = 1 := by rw [jwSign_mul_self, jwSign_mul_self, mul_one]

lemma orbitalNumberOp_mulVec_detVec {N : ℕ} (b : Fin (2 * N) → Bool)
    (u : Fin N → ℝ) (σ : Fin 2) :
    orbitalNumberOp N u σ *ᵥ detVec b =
      (occDot b σ u u : ℂ) • detVec b +
      ∑ q : Fin N, ∑ p : Fin N,
        if b (spinOrbital N q σ) && !b (spinOrbital N p σ) then
          (((u p * u q : ℝ) : ℂ) * exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
            detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))
        else 0 := by
  rw [orbitalNumberOp, ← mulVec_mulVec]
  have hstep1 :
      (∑ q : Fin N, (u q : ℂ) • jwAnnihilate (2 * N) (spinOrbital N q σ)) *ᵥ detVec b =
        ∑ q : Fin N, if b (spinOrbital N q σ) then
          ((u q : ℂ) * jwSign b (spinOrbital N q σ)) •
            detVec (Function.update b (spinOrbital N q σ) false)
        else 0 := by
    rw [sum_mulVec]
    refine Finset.sum_congr rfl fun q _ ↦ ?_
    rw [smul_mulVec, jwAnnihilate_mulVec_detVec]
    split_ifs <;> simp [smul_smul]
  rw [hstep1, conjTranspose_sum, mulVec_sum]
  have hinner (q : Fin N) :
      (∑ p : Fin N, ((u p : ℂ) • jwAnnihilate (2 * N) (spinOrbital N p σ))ᴴ) *ᵥ
          (if b (spinOrbital N q σ) then
            ((u q : ℂ) * jwSign b (spinOrbital N q σ)) •
              detVec (Function.update b (spinOrbital N q σ) false)
          else 0) =
        (if b (spinOrbital N q σ) then ((u q * u q : ℝ) : ℂ) • detVec b else 0) +
        ∑ p : Fin N,
          if b (spinOrbital N q σ) && !b (spinOrbital N p σ) then
            (((u p * u q : ℝ) : ℂ) * exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
              detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))
          else 0 := by
    cases hbq : b (spinOrbital N q σ)
    · simp
    · simp only [Bool.true_and, ↓reduceIte, sum_mulVec]
      have hsplit : ∀ p : Fin N,
          ((u p : ℂ) • jwAnnihilate (2 * N) (spinOrbital N p σ))ᴴ *ᵥ
              (((u q : ℂ) * jwSign b (spinOrbital N q σ)) •
                detVec (Function.update b (spinOrbital N q σ) false)) =
            (if p = q then ((u q * u q : ℝ) : ℂ) • detVec b else 0) +
            (if !b (spinOrbital N p σ) then
              (((u p * u q : ℝ) : ℂ) * exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
                detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))
            else 0) := by
        intro p
        rw [conjTranspose_smul, RCLike.star_def, Complex.conj_ofReal, smul_mulVec, mulVec_smul,
          jwAnnihilate_conjTranspose_mulVec_detVec]
        by_cases hpq : p = q
        · subst hpq
          simp only [Function.update_self, Bool.false_eq_true, ↓reduceIte, hbq, Bool.not_true,
            add_zero, smul_smul]
          have hupd : Function.update (Function.update b (spinOrbital N p σ) false)
              (spinOrbital N p σ) true = b := by
            rw [Function.update_idem, Function.update_eq_self_iff]
            exact hbq.symm
          have hsign_eq :
              jwSign (Function.update b (spinOrbital N p σ) false) (spinOrbital N p σ) =
                jwSign b (spinOrbital N p σ) := by
            simp only [jwSign]
            congr 1
            refine Finset.sum_congr rfl fun x hx ↦ ?_
            rw [Function.update_of_ne (Finset.mem_filter.mp hx).2.ne]
          rw [hupd, hsign_eq]
          congr 1
          push_cast
          calc
            (u p : ℂ) * ((u p : ℂ) * jwSign b (spinOrbital N p σ) * jwSign b (spinOrbital N p σ))
              = (u p : ℂ) * (u p : ℂ) *
                  (jwSign b (spinOrbital N p σ) * jwSign b (spinOrbital N p σ)) := by ring
            _ = (u p : ℂ) * (u p : ℂ) := by rw [jwSign_mul_self, mul_one]
        · have hwne : spinOrbital N p σ ≠ spinOrbital N q σ := spinOrbital_ne_of_ne σ hpq
          simp only [hpq, ↓reduceIte, zero_add, Function.update_of_ne hwne]
          cases hbp : b (spinOrbital N p σ)
          · simp only [Bool.false_eq_true, ↓reduceIte, Bool.not_false, smul_smul]
            congr 1
            push_cast [exciteSign]
            ring
          · simp
      simp_rw [hsplit, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  simp_rw [hinner, Finset.sum_add_distrib]
  congr 1
  rw [occDot, Complex.ofReal_sum, Finset.sum_smul]
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  split_ifs <;> simp

lemma dotProduct_orbitalNumberOp_detVec {N : ℕ} (b : Fin (2 * N) → Bool)
    (u : Fin N → ℝ) (σ : Fin 2) :
    star (detVec b) ⬝ᵥ (orbitalNumberOp N u σ *ᵥ detVec b) = (occDot b σ u u : ℂ) := by
  rw [orbitalNumberOp_mulVec_detVec, dotProduct_add, dotProduct_smul,
    star_detVec_dotProduct_detVec]
  simp only [↓reduceIte, smul_eq_mul, mul_one]
  suffices h0 : star (detVec b) ⬝ᵥ
      (∑ q : Fin N, ∑ p : Fin N,
        if b (spinOrbital N q σ) && !b (spinOrbital N p σ) then
          (((u p * u q : ℝ) : ℂ) * exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
            detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))
        else 0) = 0 by
    rw [h0, add_zero]
  rw [dotProduct_sum]
  refine Finset.sum_eq_zero fun q _ ↦ ?_
  rw [dotProduct_sum]
  refine Finset.sum_eq_zero fun p _ ↦ ?_
  split_ifs with hcond
  · obtain ⟨_, hnp⟩ := Bool.and_eq_true_iff.mp hcond
    have hp : b (spinOrbital N p σ) = false := by
      cases h : b (spinOrbital N p σ) <;> simp_all
    have hne : b ≠ excite b (spinOrbital N q σ) (spinOrbital N p σ) :=
      (excite_ne_self hp).symm
    rw [dotProduct_smul, star_detVec_dotProduct_detVec]
    simp [hne]
  · simp

lemma dotProduct_orbitalNumberOp_mul_detVec {N : ℕ} (b : Fin (2 * N) → Bool)
    (u v : Fin N → ℝ) (σ τ : Fin 2) :
    star (detVec b) ⬝ᵥ ((orbitalNumberOp N u σ * orbitalNumberOp N v τ) *ᵥ detVec b) =
      ((occDot b σ u u * occDot b τ v v +
        if σ = τ then occDot b σ u v * virtDot b σ u v else 0 : ℝ) : ℂ) := by
  have hherm : star (detVec b) ⬝ᵥ ((orbitalNumberOp N u σ * orbitalNumberOp N v τ) *ᵥ detVec b) =
      star (orbitalNumberOp N u σ *ᵥ detVec b) ⬝ᵥ (orbitalNumberOp N v τ *ᵥ detVec b) := by
    calc
      star (detVec b) ⬝ᵥ ((orbitalNumberOp N u σ * orbitalNumberOp N v τ) *ᵥ detVec b)
        = (star (detVec b) ᵥ* orbitalNumberOp N u σ) ⬝ᵥ (orbitalNumberOp N v τ *ᵥ detVec b) := by
            rw [← mulVec_mulVec, dotProduct_mulVec]
      _ = (star (detVec b) ᵥ* (orbitalNumberOp N u σ)ᴴ) ⬝ᵥ
            (orbitalNumberOp N v τ *ᵥ detVec b) := by
            rw [(orbitalNumberOp_isHermitian u σ).eq]
      _ = star (orbitalNumberOp N u σ *ᵥ detVec b) ⬝ᵥ (orbitalNumberOp N v τ *ᵥ detVec b) := by
            rw [Matrix.star_mulVec]
  rw [hherm, orbitalNumberOp_mulVec_detVec b u σ, orbitalNumberOp_mulVec_detVec b v τ]
  let Y₁ := ∑ q : Fin N, ∑ p : Fin N,
    if b (spinOrbital N q σ) && !b (spinOrbital N p σ) then
      (((u p * u q : ℝ) : ℂ) * exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
        detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))
    else 0
  let Y₂ := ∑ q : Fin N, ∑ p : Fin N,
    if b (spinOrbital N q τ) && !b (spinOrbital N p τ) then
      (((v p * v q : ℝ) : ℂ) * exciteSign b (spinOrbital N q τ) (spinOrbital N p τ)) •
        detVec (excite b (spinOrbital N q τ) (spinOrbital N p τ))
    else 0
  change star ((occDot b σ u u : ℂ) • detVec b + Y₁) ⬝ᵥ
      ((occDot b τ v v : ℂ) • detVec b + Y₂) = _
  rw [star_add, add_dotProduct, dotProduct_add, dotProduct_add]
  have h_diag :
      star ((occDot b σ u u : ℂ) • detVec b) ⬝ᵥ ((occDot b τ v v : ℂ) • detVec b) =
        ((occDot b σ u u * occDot b τ v v : ℝ) : ℂ) := by
    rw [star_smul, smul_dotProduct, dotProduct_smul, star_detVec_dotProduct_detVec]
    simp [RCLike.star_def]
  have h_cross1 : star ((occDot b σ u u : ℂ) • detVec b) ⬝ᵥ Y₂ = 0 := by
    rw [star_smul, smul_dotProduct, smul_eq_mul, mul_eq_zero]
    right
    simp only [Y₂, dotProduct_sum]
    refine Finset.sum_eq_zero fun q _ ↦ Finset.sum_eq_zero fun p _ ↦ ?_
    split_ifs with hcond
    · obtain ⟨_, hnp⟩ := Bool.and_eq_true_iff.mp hcond
      have hp : b (spinOrbital N p τ) = false := by
        cases h : b (spinOrbital N p τ) <;> simp_all
      have hne : b ≠ excite b (spinOrbital N q τ) (spinOrbital N p τ) :=
        (excite_ne_self hp).symm
      rw [dotProduct_smul, star_detVec_dotProduct_detVec]
      simp [hne]
    · simp
  have h_cross2 : star Y₁ ⬝ᵥ ((occDot b τ v v : ℂ) • detVec b) = 0 := by
    rw [dotProduct_smul, smul_eq_mul, mul_eq_zero]
    right
    simp only [Y₁, star_sum, sum_dotProduct]
    refine Finset.sum_eq_zero fun q _ ↦ Finset.sum_eq_zero fun p _ ↦ ?_
    split_ifs with hcond
    · obtain ⟨_, hnp⟩ := Bool.and_eq_true_iff.mp hcond
      have hp : b (spinOrbital N p σ) = false := by
        cases h : b (spinOrbital N p σ) <;> simp_all
      have hne : excite b (spinOrbital N q σ) (spinOrbital N p σ) ≠ b :=
        excite_ne_self hp
      rw [star_smul, smul_dotProduct, star_detVec_dotProduct_detVec]
      simp [hne]
    · simp
  have h_off : star Y₁ ⬝ᵥ Y₂ =
      ((if σ = τ then occDot b σ u v * virtDot b σ u v else 0 : ℝ) : ℂ) := by
    simp only [Y₁, Y₂, star_sum, sum_dotProduct]
    by_cases hστ : σ = τ
    · subst hστ
      simp only [↓reduceIte]
      have hterm (q p : Fin N) :
          star (if b (spinOrbital N q σ) && !b (spinOrbital N p σ) then
              (((u p * u q : ℝ) : ℂ) * exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
                detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))
            else 0) ⬝ᵥ
            (∑ q' : Fin N, ∑ p' : Fin N,
              if b (spinOrbital N q' σ) && !b (spinOrbital N p' σ) then
                (((v p' * v q' : ℝ) : ℂ) * exciteSign b (spinOrbital N q' σ) (spinOrbital N p' σ)) •
                  detVec (excite b (spinOrbital N q' σ) (spinOrbital N p' σ))
              else 0) =
            if b (spinOrbital N q σ) && !b (spinOrbital N p σ) then
              (((u q * v q) * (u p * v p) : ℝ) : ℂ)
            else 0 := by
        split_ifs with hcond
        · obtain ⟨hq, hnp⟩ := Bool.and_eq_true_iff.mp hcond
          have hp : b (spinOrbital N p σ) = false := by
            cases h : b (spinOrbital N p σ) <;> simp_all
          rw [dotProduct_sum]
          have hq' (q' : Fin N) :
              star ((((u p * u q : ℝ) : ℂ) * exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
                  detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))) ⬝ᵥ
                (∑ p' : Fin N,
                  if b (spinOrbital N q' σ) && !b (spinOrbital N p' σ) then
                    (((v p' * v q' : ℝ) : ℂ) *
                      exciteSign b (spinOrbital N q' σ) (spinOrbital N p' σ)) •
                      detVec (excite b (spinOrbital N q' σ) (spinOrbital N p' σ))
                  else 0) =
                if q' = q then (((u q * v q) * (u p * v p) : ℝ) : ℂ) else 0 := by
            rw [dotProduct_sum]
            have hp' (p' : Fin N) :
                star ((((u p * u q : ℝ) : ℂ) *
                    exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) •
                    detVec (excite b (spinOrbital N q σ) (spinOrbital N p σ))) ⬝ᵥ
                  (if b (spinOrbital N q' σ) && !b (spinOrbital N p' σ) then
                    (((v p' * v q' : ℝ) : ℂ) *
                      exciteSign b (spinOrbital N q' σ) (spinOrbital N p' σ)) •
                      detVec (excite b (spinOrbital N q' σ) (spinOrbital N p' σ))
                  else 0) =
                if q' = q ∧ p' = p then (((u q * v q) * (u p * v p) : ℝ) : ℂ) else 0 := by
              by_cases heq_qp : q' = q ∧ p' = p
              · rcases heq_qp with ⟨hq_eq, hp_eq⟩
                subst q'; subst p'
                simp only [hcond, and_self, ↓reduceIte]
                rw [star_smul, smul_dotProduct, dotProduct_smul, star_detVec_dotProduct_detVec]
                simp only [↓reduceIte, smul_eq_mul, mul_one, star_mul', RCLike.star_def,
                  Complex.conj_ofReal]
                calc
                  ((u p * u q : ℝ) : ℂ) *
                      star (exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) *
                      (((v p * v q : ℝ) : ℂ) *
                        exciteSign b (spinOrbital N q σ) (spinOrbital N p σ))
                    = ((u p * u q : ℝ) : ℂ) * ((v p * v q : ℝ) : ℂ) *
                        (star (exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) *
                          exciteSign b (spinOrbital N q σ) (spinOrbital N p σ)) := by ring
                  _ = (((u q * v q) * (u p * v p) : ℝ) : ℂ) := by
                        rw [star_exciteSign_mul_self, mul_one]; push_cast; ring
              · simp only [heq_qp, ↓reduceIte]
                split_ifs with hc'
                · obtain ⟨hq'', hnp''⟩ := Bool.and_eq_true_iff.mp hc'
                  have hp'' : b (spinOrbital N p' σ) = false := by
                    cases h : b (spinOrbital N p' σ) <;> simp_all
                  have hneq : excite b (spinOrbital N q σ) (spinOrbital N p σ) ≠
                      excite b (spinOrbital N q' σ) (spinOrbital N p' σ) := by
                    intro hex
                    have ⟨hw₁, hw₂⟩ := (excite_eq_iff hq hp hq'' hp'').mp hex
                    exact heq_qp ⟨(Prod.mk.inj (spinOrbital_injective hw₁)).1.symm,
                      (Prod.mk.inj (spinOrbital_injective hw₂)).1.symm⟩
                  rw [star_smul, smul_dotProduct, dotProduct_smul, star_detVec_dotProduct_detVec]
                  simp [hneq]
                · simp
            simp_rw [hp']
            by_cases hqq : q' = q
            · subst hqq; simp
            · simp [hqq]
          simp_rw [hq', Finset.sum_ite_eq', Finset.mem_univ, ite_true]
        · simp
      simp_rw [hterm]
      rw [occDot, virtDot, Finset.sum_mul]
      push_cast
      refine Finset.sum_congr rfl fun q _ ↦ ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun p _ ↦ ?_
      cases b (spinOrbital N q σ) <;> cases b (spinOrbital N p σ) <;> simp
    · simp only [hστ, ↓reduceIte, Complex.ofReal_zero]
      refine Finset.sum_eq_zero fun q _ ↦ Finset.sum_eq_zero fun p _ ↦ ?_
      split_ifs with hcond
      · obtain ⟨hq, hnp⟩ := Bool.and_eq_true_iff.mp hcond
        have hp : b (spinOrbital N p σ) = false := by
          cases h : b (spinOrbital N p σ) <;> simp_all
        rw [dotProduct_sum]
        refine Finset.sum_eq_zero fun q' _ ↦ ?_
        rw [dotProduct_sum]
        refine Finset.sum_eq_zero fun p' _ ↦ ?_
        split_ifs with hc'
        · obtain ⟨hq', hnp'⟩ := Bool.and_eq_true_iff.mp hc'
          have hp' : b (spinOrbital N p' τ) = false := by
            cases h : b (spinOrbital N p' τ) <;> simp_all
          have hneq : excite b (spinOrbital N q σ) (spinOrbital N p σ) ≠
              excite b (spinOrbital N q' τ) (spinOrbital N p' τ) := by
            intro hex
            have ⟨hw₁, _⟩ := (excite_eq_iff hq hp hq' hp').mp hex
            exact hστ (Prod.mk.inj (spinOrbital_injective hw₁)).2
          rw [star_smul, smul_dotProduct, dotProduct_smul, star_detVec_dotProduct_detVec]
          simp [hneq]
        · simp
      · simp
  rw [h_diag, h_cross1, h_cross2, h_off]
  push_cast
  ring

lemma oneBodyHamiltonian_add {N : ℕ} (h₁ h₂ : Matrix (Fin N) (Fin N) ℝ) :
    oneBodyHamiltonian (h₁ + h₂) = oneBodyHamiltonian h₁ + oneBodyHamiltonian h₂ := by
  simp only [oneBodyHamiltonian, Matrix.add_apply, Complex.ofReal_add, add_smul,
    Finset.sum_add_distrib]

lemma oneBodyHamiltonian_sum {ι : Type*} {N : ℕ} (s : Finset ι)
    (f : ι → Matrix (Fin N) (Fin N) ℝ) :
    oneBodyHamiltonian (∑ i ∈ s, f i) = ∑ i ∈ s, oneBodyHamiltonian (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [oneBodyHamiltonian]
  | @insert a s ha ih => rw [Finset.sum_insert ha, oneBodyHamiltonian_add, ih, Finset.sum_insert ha]

lemma oneBodyHamiltonian_smul_vecMulVec {N : ℕ} (t : ℝ) (u : Fin N → ℝ) :
    oneBodyHamiltonian (t • vecMulVec u u) =
      (t : ℂ) • ∑ σ : Fin 2, orbitalNumberOp N u σ := by
  simp only [oneBodyHamiltonian, Matrix.smul_apply, vecMulVec_apply, smul_eq_mul,
    Complex.ofReal_mul, Finset.smul_sum, orbitalNumberOp]
  refine Finset.sum_congr rfl fun σ _ ↦ ?_
  rw [conjTranspose_sum, Finset.sum_mul, Finset.smul_sum]
  refine Finset.sum_congr rfl fun p _ ↦ ?_
  rw [Finset.mul_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  rw [conjTranspose_smul, RCLike.star_def, Complex.conj_ofReal, smul_mul_assoc, mul_smul_comm,
    smul_smul, smul_smul]
  congr 1
  ring

/-- Equivalence `(r, b) ↦ 29 * r + b` indexing the `261` DFTHC leaves. -/
def leafEquiv : Fin 9 × Fin 29 ≃ Fin 261 where
  toFun rb := ⟨29 * rb.1.val + rb.2.val, by omega⟩
  invFun μ := (⟨μ.val / 29, by omega⟩, ⟨μ.val % 29, by omega⟩)
  left_inv rb := by ext <;> dsimp <;> omega
  right_inv μ := by ext; dsimp; omega

lemma fragmentVector_leafEquiv (r : Fin 9) (c : Fin 14) (r' : Fin 9) (b_idx : Fin 29) :
    fragmentVector r c (leafEquiv (r', b_idx)) =
      if r' = r then weight r c b_idx.castSucc else 0 := by
  unfold fragmentVector leafEquiv
  dsimp only [Equiv.coe_fn_mk]
  have hdiv : (29 * r'.val + b_idx.val) / 29 = r'.val := by omega
  by_cases hrr : r' = r
  · subst hrr
    rw [ite_eq_left hdiv, ite_eq_left rfl]
    congr 1
    ext; dsimp; omega
  · have hval : (29 * r'.val + b_idx.val) / 29 ≠ r.val := by omega
    rw [ite_eq_right hval, ite_eq_right hrr]

/-- Signed integer inner weight `m^{(r,c)}_{b}` from `innerWeights`. -/
def innerInt (r : Fin 9) (c : Fin 14) (b : Fin 30) : ℤ :=
  fromOffset (innerWeights.getChunk₂ ⟨14 * r.val + c.val, by omega⟩ b).toNat

/-- Signed integer symmetry-shift weight `m^{(r,c)}_{29} - ∑_{b < 29} m^{(r,c)}_b`. -/
def innerShiftInt (r : Fin 9) (c : Fin 14) : ℤ :=
  innerInt r c 29 - ∑ b_idx : Fin 29, innerInt r c b_idx.castSucc

/-- Natural outer fragment weight index for `(r, c)` from `fragmentWeights`. -/
def fragOuterNat (r : Fin 9) (c : Fin 14) : ℕ :=
  (fragmentWeights.getChunk₂ r c).toNat

lemma weight_mul_weight (r : Fin 9) (c : Fin 14) (b₁ b₂ : Fin 30) :
    weight r c b₁ * weight r c b₂ =
      ((innerInt r c b₁ * innerInt r c b₂ : ℤ) : ℝ) *
        (4 * (fragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) := by
  have hpos : 0 ≤ 4 * (fragOuterNat r c : ℝ) * coefficientUnit := by
    unfold coefficientUnit fragOuterNat; positivity
  have hw (b : Fin 30) : weight r c b =
      (innerInt r c b : ℝ) * √(4 * (fragOuterNat r c : ℝ) * coefficientUnit) / 15360 := by
    simp only [weight, innerInt, fragOuterNat]
  rw [hw b₁, hw b₂]
  set x : ℝ := 4 * (fragOuterNat r c : ℝ) * coefficientUnit
  have hsq : √x * √x = x := Real.mul_self_sqrt hpos
  push_cast
  calc
    (innerInt r c b₁ : ℝ) * √x / 15360 * ((innerInt r c b₂ : ℝ) * √x / 15360)
      = (innerInt r c b₁ : ℝ) * (innerInt r c b₂ : ℝ) * (√x * √x) / (15360 ^ 2 : ℝ) := by ring
    _ = _ := by rw [hsq]

lemma fragmentShift_mul_weight (r : Fin 9) (c : Fin 14) (b_idx : Fin 29) :
    fragmentShift r c * weight r c b_idx.castSucc =
      ((innerShiftInt r c * innerInt r c b_idx.castSucc : ℤ) : ℝ) *
        (4 * (fragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) := by
  rw [fragmentShift, sub_mul, Finset.sum_mul, weight_mul_weight]
  simp_rw [weight_mul_weight]
  rw [← Finset.sum_div, ← Finset.sum_mul]
  have hsum :
      (∑ x : Fin 29, ((innerInt r c x.castSucc * innerInt r c b_idx.castSucc : ℤ) : ℝ)) =
        (∑ x : Fin 29, (innerInt r c x.castSucc : ℝ)) * (innerInt r c b_idx.castSucc : ℝ) := by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun x _ ↦ by push_cast; ring
  rw [hsum]
  unfold innerShiftInt
  push_cast
  ring

/-- Exact radical-free real expression for
`(star (detVec b) ⬝ᵥ (thcHamiltonian dfthc *ᵥ detVec b)).re`. -/
noncomputable def detEnergyReal (b : Fin (2 * 58) → Bool) : ℝ :=
  let obSum : ℝ := ∑ ℓ : Fin 58,
    (fromOffset (oneBodyWeights.getChunk ℓ).toNat : ℝ) *
      (occDot b 0 (oneBodyVector ℓ) (oneBodyVector ℓ) +
        occDot b 1 (oneBodyVector ℓ) (oneBodyVector ℓ))
  let fragSum : ℝ := ∑ r : Fin 9, ∑ c : Fin 14,
    let dOcc : Fin 29 → ℝ := fun b_idx ↦
      occDot b 0 (leafVector (leafEquiv (r, b_idx))) (leafVector (leafEquiv (r, b_idx))) +
      occDot b 1 (leafVector (leafEquiv (r, b_idx))) (leafVector (leafEquiv (r, b_idx)))
    let sD : ℝ := ∑ b_idx : Fin 29, (innerInt r c b_idx.castSucc : ℝ) * dOcc b_idx
    let exch : ℝ := ∑ b₁ : Fin 29, (innerInt r c b₁.castSucc : ℝ) *
      ∑ b₂ : Fin 29, (innerInt r c b₂.castSucc : ℝ) *
        (occDot b 0 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) *
          virtDot b 0 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) +
         occDot b 1 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) *
          virtDot b 1 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))))
    ((4 * (fragOuterNat r c : ℤ) * innerShiftInt r c : ℤ) : ℝ) * sD +
      ((2 * (fragOuterNat r c : ℤ) : ℤ) : ℝ) * (sD * sD) +
      ((2 * (fragOuterNat r c : ℤ) : ℤ) : ℝ) * exch
  coefficientUnit * obSum + (coefficientUnit / (15360 ^ 2 : ℝ)) * fragSum

lemma sum_prod_swap {α β γ δ : Type*} [Fintype α] [Fintype β] [Fintype γ] [Fintype δ]
    (g : α → β → γ → δ → ℝ) :
    (∑ a : α, ∑ b : β, ∑ c : γ, ∑ d : δ, g a b c d) =
      ∑ c : γ, ∑ d : δ, ∑ a : α, ∑ b : β, g a b c d := by
  calc
    (∑ a : α, ∑ b : β, ∑ c : γ, ∑ d : δ, g a b c d)
      = ∑ p : α × β, ∑ q : γ × δ, g p.1 p.2 q.1 q.2 := by
          rw [← Fintype.sum_prod_type']
          refine Finset.sum_congr rfl fun p _ ↦ (Fintype.sum_prod_type' _).symm
    _ = ∑ q : γ × δ, ∑ p : α × β, g p.1 p.2 q.1 q.2 := Finset.sum_comm
    _ = ∑ c : γ, ∑ d : δ, ∑ a : α, ∑ b : β, g a b c d := by
          rw [Fintype.sum_prod_type]
          refine Finset.sum_congr rfl fun c _ ↦ Finset.sum_congr rfl fun d _ ↦
            Fintype.sum_prod_type _

lemma sum_leafEquiv_fragmentVector (r : Fin 9) (c : Fin 14) (f : Fin 261 → ℝ) :
    ∑ μ : Fin 261, fragmentVector r c μ * f μ =
      ∑ b_idx : Fin 29, weight r c b_idx.castSucc * f (leafEquiv (r, b_idx)) := by
  rw [← leafEquiv.sum_comp, Fintype.sum_prod_type]
  simp_rw [fragmentVector_leafEquiv]
  have hrow (r' : Fin 9) :
      (∑ b_idx : Fin 29, (if r' = r then weight r c b_idx.castSucc else 0) *
        f (leafEquiv (r', b_idx))) =
      if r' = r then ∑ b_idx : Fin 29, weight r c b_idx.castSucc * f (leafEquiv (r, b_idx))
      else 0 := by
    by_cases hrr : r' = r
    · subst hrr; simp
    · simp [hrr]
  simp_rw [hrow, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

private lemma hob_vec_lemma {N : ℕ} (b : Fin (2 * N) → Bool) (t : ℝ) (u : Fin N → ℝ) :
    star (detVec b) ⬝ᵥ (oneBodyHamiltonian (t • vecMulVec u u) *ᵥ detVec b) =
      ((t * (occDot b 0 u u + occDot b 1 u u) : ℝ) : ℂ) := by
  rw [oneBodyHamiltonian_smul_vecMulVec, smul_mulVec, dotProduct_smul, sum_mulVec,
    Fin.sum_univ_two, dotProduct_add, dotProduct_orbitalNumberOp_detVec,
    dotProduct_orbitalNumberOp_detVec]
  push_cast; ring

lemma re_thcHamiltonian_detVec_gen {N M L : ℕ} (thc : THCFactorization N M)
    (eig : Fin L → ℝ) (u : Fin L → Fin N → ℝ) (κ : Fin M → ℝ)
    (h1e : thc.h1eMod = ∑ ℓ : Fin L, eig ℓ • vecMulVec (u ℓ) (u ℓ) +
      ∑ μ : Fin M, κ μ • vecMulVec (thc.chi μ) (thc.chi μ))
    (b : Fin (2 * N) → Bool) :
    (star (detVec b) ⬝ᵥ (thcHamiltonian thc *ᵥ detVec b)).re =
      (∑ ℓ : Fin L, eig ℓ * (occDot b 0 (u ℓ) (u ℓ) + occDot b 1 (u ℓ) (u ℓ)) +
       ∑ μ : Fin M, κ μ * (occDot b 0 (thc.chi μ) (thc.chi μ) +
         occDot b 1 (thc.chi μ) (thc.chi μ))) +
      2⁻¹ * ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin M, ∑ ν : Fin M,
        thc.zeta μ ν *
          (occDot b σ (thc.chi μ) (thc.chi μ) * occDot b τ (thc.chi ν) (thc.chi ν) +
            if σ = τ then occDot b σ (thc.chi μ) (thc.chi ν) *
              virtDot b σ (thc.chi μ) (thc.chi ν) else 0) := by
  rw [thcHamiltonian, add_mulVec, dotProduct_add]
  have h1 :
      star (detVec b) ⬝ᵥ (oneBodyHamiltonian thc.h1eMod *ᵥ detVec b) =
        ((∑ ℓ : Fin L, eig ℓ * (occDot b 0 (u ℓ) (u ℓ) + occDot b 1 (u ℓ) (u ℓ)) +
          ∑ μ : Fin M, κ μ * (occDot b 0 (thc.chi μ) (thc.chi μ) +
            occDot b 1 (thc.chi μ) (thc.chi μ)) : ℝ) : ℂ) := by
    rw [h1e, oneBodyHamiltonian_add, add_mulVec, dotProduct_add,
      oneBodyHamiltonian_sum, sum_mulVec, dotProduct_sum,
      oneBodyHamiltonian_sum, sum_mulVec, dotProduct_sum]
    simp_rw [hob_vec_lemma, ← Complex.ofReal_sum, ← Complex.ofReal_add]
  have h2 :
      star (detVec b) ⬝ᵥ
        (((2 : ℂ)⁻¹ • ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin M, ∑ ν : Fin M,
          (thc.zeta μ ν : ℂ) •
            (orbitalNumberOp N (thc.chi μ) σ * orbitalNumberOp N (thc.chi ν) τ)) *ᵥ detVec b) =
        ((2⁻¹ * ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin M, ∑ ν : Fin M,
          thc.zeta μ ν *
            (occDot b σ (thc.chi μ) (thc.chi μ) * occDot b τ (thc.chi ν) (thc.chi ν) +
              if σ = τ then occDot b σ (thc.chi μ) (thc.chi ν) *
                virtDot b σ (thc.chi μ) (thc.chi ν) else 0) : ℝ) : ℂ) := by
    rw [smul_mulVec, dotProduct_smul]
    simp only [sum_mulVec, dotProduct_sum, smul_mulVec, dotProduct_smul, smul_eq_mul]
    simp_rw [dotProduct_orbitalNumberOp_mul_detVec]
    push_cast; rfl
  rw [h1, h2, ← Complex.ofReal_add, Complex.ofReal_re]

lemma re_thcHamiltonian_detVec (b : Fin (2 * 58) → Bool) :
    (star (detVec b) ⬝ᵥ (thcHamiltonian dfthc *ᵥ detVec b)).re = detEnergyReal b := by
  rw [re_thcHamiltonian_detVec_gen dfthc oneBodyEigenvalue oneBodyVector
    (fun μ ↦ ∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ)
    rfl b]
  have hchi (μ : Fin 261) : dfthc.chi μ = leafVector μ := rfl
  have hzeta (μ ν : Fin 261) :
      dfthc.zeta μ ν =
        ∑ r : Fin 9, ∑ c : Fin 14,
          fragmentVector r c μ * fragmentVector r c ν := by
    change (∑ r : Fin 9, ∑ c : Fin 14,
      vecMulVec (fragmentVector r c) (fragmentVector r c)) μ ν = _
    simp [Matrix.sum_apply, vecMulVec_apply]
  simp_rw [hchi, hzeta]
  have h1_frag :
      (∑ μ : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ) *
          (occDot b 0 (leafVector μ) (leafVector μ) +
            occDot b 1 (leafVector μ) (leafVector μ))) =
      ∑ r : Fin 9, ∑ c : Fin 14, ∑ b_idx : Fin 29,
        (fragmentShift r c * weight r c b_idx.castSucc) *
          (occDot b 0 (leafVector (leafEquiv (r, b_idx))) (leafVector (leafEquiv (r, b_idx))) +
            occDot b 1 (leafVector (leafEquiv (r, b_idx)))
              (leafVector (leafEquiv (r, b_idx)))) := by
    simp_rw [Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun r _ ↦ ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun c _ ↦ ?_
    simp_rw [mul_assoc]
    rw [← Finset.mul_sum, sum_leafEquiv_fragmentVector, Finset.mul_sum]
  have h2_frag :
      (∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        (∑ r : Fin 9, ∑ c : Fin 14, fragmentVector r c μ * fragmentVector r c ν) *
          (occDot b σ (leafVector μ) (leafVector μ) * occDot b τ (leafVector ν) (leafVector ν) +
            if σ = τ then occDot b σ (leafVector μ) (leafVector ν) *
              virtDot b σ (leafVector μ) (leafVector ν) else 0)) =
      ∑ r : Fin 9, ∑ c : Fin 14, ∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
        (weight r c b₁.castSucc * weight r c b₂.castSucc) *
          ((occDot b 0 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₁))) +
              occDot b 1 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₁)))) *
            (occDot b 0 (leafVector (leafEquiv (r, b₂))) (leafVector (leafEquiv (r, b₂))) +
              occDot b 1 (leafVector (leafEquiv (r, b₂))) (leafVector (leafEquiv (r, b₂)))) +
            (occDot b 0 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) *
              virtDot b 0 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) +
             occDot b 1 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) *
              virtDot b 1 (leafVector (leafEquiv (r, b₁)))
                (leafVector (leafEquiv (r, b₂))))) := by
    rw [sum_prod_swap]
    have hspin (μ ν : Fin 261) :
        (∑ σ : Fin 2, ∑ τ : Fin 2,
          (∑ r : Fin 9, ∑ c : Fin 14, fragmentVector r c μ * fragmentVector r c ν) *
            (occDot b σ (leafVector μ) (leafVector μ) * occDot b τ (leafVector ν) (leafVector ν) +
              if σ = τ then occDot b σ (leafVector μ) (leafVector ν) *
                virtDot b σ (leafVector μ) (leafVector ν) else 0)) =
        ∑ r : Fin 9, ∑ c : Fin 14,
          (fragmentVector r c μ * fragmentVector r c ν) *
            ((occDot b 0 (leafVector μ) (leafVector μ) +
                occDot b 1 (leafVector μ) (leafVector μ)) *
              (occDot b 0 (leafVector ν) (leafVector ν) +
                occDot b 1 (leafVector ν) (leafVector ν)) +
              (occDot b 0 (leafVector μ) (leafVector ν) *
                  virtDot b 0 (leafVector μ) (leafVector ν) +
                occDot b 1 (leafVector μ) (leafVector ν) *
                  virtDot b 1 (leafVector μ) (leafVector ν))) := by
      simp_rw [← Finset.mul_sum]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun r _ ↦ ?_
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun c _ ↦ ?_
      congr 1
      have h01 : ((0 : Fin 2) = 1) = False := eq_false (by decide)
      have h10 : ((1 : Fin 2) = 0) = False := eq_false (by decide)
      simp only [Fin.sum_univ_two, Fin.isValue, h01, h10, ↓reduceIte]
      ring
    simp_rw [hspin]
    rw [sum_prod_swap]
    refine Finset.sum_congr rfl fun r _ ↦ Finset.sum_congr rfl fun c _ ↦ ?_
    let M : Fin 261 → Fin 261 → ℝ := fun μ ν ↦
      (occDot b 0 (leafVector μ) (leafVector μ) + occDot b 1 (leafVector μ) (leafVector μ)) *
        (occDot b 0 (leafVector ν) (leafVector ν) + occDot b 1 (leafVector ν) (leafVector ν)) +
        (occDot b 0 (leafVector μ) (leafVector ν) * virtDot b 0 (leafVector μ) (leafVector ν) +
          occDot b 1 (leafVector μ) (leafVector ν) * virtDot b 1 (leafVector μ) (leafVector ν))
    change (∑ μ : Fin 261, ∑ ν : Fin 261,
        (fragmentVector r c μ * fragmentVector r c ν) * M μ ν) =
      ∑ b₁ : Fin 29, ∑ b₂ : Fin 29, (weight r c b₁.castSucc * weight r c b₂.castSucc) *
        M (leafEquiv (r, b₁)) (leafEquiv (r, b₂))
    have hinner_ν (μ : Fin 261) :
        (∑ ν : Fin 261, (fragmentVector r c μ * fragmentVector r c ν) * M μ ν) =
          fragmentVector r c μ *
            ∑ b₂ : Fin 29, weight r c b₂.castSucc * M μ (leafEquiv (r, b₂)) := by
      simp_rw [mul_assoc]
      rw [← Finset.mul_sum, sum_leafEquiv_fragmentVector]
    simp_rw [hinner_ν]
    rw [sum_leafEquiv_fragmentVector]
    refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun b₂ _ ↦ by ring
  rw [h1_frag, h2_frag]
  unfold detEnergyReal oneBodyEigenvalue
  simp_rw [fragmentShift_mul_weight, weight_mul_weight]
  have h1_ob :
      (∑ ℓ : Fin 58, (fromOffset (oneBodyWeights.getChunk ℓ).toNat : ℝ) * coefficientUnit *
        (occDot b 0 (oneBodyVector ℓ) (oneBodyVector ℓ) +
          occDot b 1 (oneBodyVector ℓ) (oneBodyVector ℓ))) =
      coefficientUnit * ∑ ℓ : Fin 58, (fromOffset (oneBodyWeights.getChunk ℓ).toNat : ℝ) *
        (occDot b 0 (oneBodyVector ℓ) (oneBodyVector ℓ) +
          occDot b 1 (oneBodyVector ℓ) (oneBodyVector ℓ)) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun ℓ _ ↦ by ring
  rw [h1_ob, add_assoc]
  refine congr_arg₂ (· + ·) rfl ?_
  rw [Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
  refine Finset.sum_congr rfl fun r _ ↦ ?_
  rw [Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
  refine Finset.sum_congr rfl fun c _ ↦ ?_
  let dOcc : Fin 29 → ℝ := fun b_idx ↦
    occDot b 0 (leafVector (leafEquiv (r, b_idx))) (leafVector (leafEquiv (r, b_idx))) +
    occDot b 1 (leafVector (leafEquiv (r, b_idx))) (leafVector (leafEquiv (r, b_idx)))
  let K : Fin 29 → Fin 29 → ℝ := fun b₁ b₂ ↦
    occDot b 0 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) *
      virtDot b 0 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) +
    occDot b 1 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂))) *
      virtDot b 1 (leafVector (leafEquiv (r, b₁))) (leafVector (leafEquiv (r, b₂)))
  let m : Fin 29 → ℝ := fun b_idx ↦ (innerInt r c b_idx.castSucc : ℝ)
  change (∑ b_idx : Fin 29,
      ((innerShiftInt r c * innerInt r c b_idx.castSucc : ℤ) : ℝ) *
        (4 * (fragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) * dOcc b_idx) +
    2⁻¹ * (∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
      ((innerInt r c b₁.castSucc * innerInt r c b₂.castSucc : ℤ) : ℝ) *
        (4 * (fragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) *
        (dOcc b₁ * dOcc b₂ + K b₁ b₂)) =
    coefficientUnit / (15360 ^ 2 : ℝ) *
      (((4 * (fragOuterNat r c : ℤ) * innerShiftInt r c : ℤ) : ℝ) *
          (∑ b_idx : Fin 29, m b_idx * dOcc b_idx) +
        ((2 * (fragOuterNat r c : ℤ) : ℤ) : ℝ) *
          ((∑ b_idx : Fin 29, m b_idx * dOcc b_idx) *
            (∑ b_idx : Fin 29, m b_idx * dOcc b_idx)) +
        ((2 * (fragOuterNat r c : ℤ) : ℤ) : ℝ) *
          (∑ b₁ : Fin 29, m b₁ * ∑ b₂ : Fin 29, m b₂ * K b₁ b₂))
  have hs1 :
      (∑ b_idx : Fin 29,
        ((innerShiftInt r c * innerInt r c b_idx.castSucc : ℤ) : ℝ) *
          (4 * (fragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) * dOcc b_idx) =
      coefficientUnit / (15360 ^ 2 : ℝ) *
        (((4 * (fragOuterNat r c : ℤ) * innerShiftInt r c : ℤ) : ℝ) *
          ∑ b_idx : Fin 29, m b_idx * dOcc b_idx) := by
    rw [Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun b_idx _ ↦ ?_
    simp only [m]; push_cast; ring
  have hs2 :
      2⁻¹ * (∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
        ((innerInt r c b₁.castSucc * innerInt r c b₂.castSucc : ℤ) : ℝ) *
          (4 * (fragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) *
          (dOcc b₁ * dOcc b₂ + K b₁ b₂)) =
      coefficientUnit / (15360 ^ 2 : ℝ) *
        (((2 * (fragOuterNat r c : ℤ) : ℤ) : ℝ) *
          ((∑ b_idx : Fin 29, m b_idx * dOcc b_idx) * (∑ b_idx : Fin 29, m b_idx * dOcc b_idx)) +
        ((2 * (fragOuterNat r c : ℤ) : ℤ) : ℝ) *
          (∑ b₁ : Fin 29, m b₁ * ∑ b₂ : Fin 29, m b₂ * K b₁ b₂)) := by
    have hsq_sum :
        (∑ b_idx : Fin 29, m b_idx * dOcc b_idx) * (∑ b_idx : Fin 29, m b_idx * dOcc b_idx) =
          ∑ b₁ : Fin 29, ∑ b₂ : Fin 29, m b₁ * m b₂ * (dOcc b₁ * dOcc b₂) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun b₂ _ ↦ by ring
    have hexch_sum :
        (∑ b₁ : Fin 29, m b₁ * ∑ b₂ : Fin 29, m b₂ * K b₁ b₂) =
          ∑ b₁ : Fin 29, ∑ b₂ : Fin 29, m b₁ * m b₂ * K b₁ b₂ := by
      refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun b₂ _ ↦ by ring
    rw [hsq_sum, hexch_sum, mul_add]
    simp_rw [Finset.mul_sum]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun b₂ _ ↦ ?_
    simp only [m]; push_cast; ring
  rw [hs1, hs2]
  ring

/-! ## Part 4: Alternating Taylor Trigonometric Bounds & Fixed-Point Interval Arithmetic -/

private lemma nonneg_of_deriv_nonneg (f : ℝ → ℝ) {f' : ℝ → ℝ}
    (hf0 : f 0 = 0) (hfd : ∀ t : ℝ, HasDerivAt f (f' t) t)
    (hf' : ∀ t : ℝ, 0 ≤ t → 0 ≤ f' t) {x : ℝ} (hx : 0 ≤ x) :
    0 ≤ f x := by
  have hcont : ContinuousOn f (Set.Ici 0) :=
    fun t _ ↦ (hfd t).continuousAt.continuousWithinAt
  have hdiff : DifferentiableOn ℝ f (interior (Set.Ici 0)) :=
    fun t _ ↦ (hfd t).differentiableAt.differentiableWithinAt
  have hmono : MonotoneOn f (Set.Ici 0) :=
    monotoneOn_of_deriv_nonneg (convex_Ici 0) hcont hdiff fun t ht ↦ by
      rw [interior_Ici] at ht
      rw [(hfd t).deriv]
      exact hf' t ht.le
  simpa [hf0] using hmono (by simp : (0 : ℝ) ∈ Set.Ici 0) hx hx

private lemma sin_le_deg1 {x : ℝ} (hx : 0 ≤ x) : Real.sin x ≤ x := by
  suffices h : 0 ≤ x - Real.sin x by linarith
  refine nonneg_of_deriv_nonneg (fun t ↦ t - Real.sin t) (by norm_num)
    (fun t ↦ (hasDerivAt_id t).sub (Real.hasDerivAt_sin t))
    (fun t _ ↦ by linarith [Real.cos_le_one t]) hx

private lemma cos_ge_deg2 {x : ℝ} (hx : 0 ≤ x) : 1 - x ^ 2 / 2 ≤ Real.cos x := by
  suffices h : 0 ≤ Real.cos x - (1 - x ^ 2 / 2) by linarith
  refine nonneg_of_deriv_nonneg (fun t ↦ Real.cos t - (1 - t ^ 2 / 2)) (by norm_num)
    (fun t ↦ (Real.hasDerivAt_cos t).sub
      ((hasDerivAt_const t (1 : ℝ)).sub ((hasDerivAt_pow 2 t).div_const 2)))
    (fun t ht ↦ ?_) hx
  simp only [Nat.reduceSub, pow_one, Nat.cast_ofNat]
  linarith [sin_le_deg1 ht]

private lemma sin_ge_deg3 {x : ℝ} (hx : 0 ≤ x) :
    x - x ^ 3 / 6 ≤ Real.sin x := by
  suffices h : 0 ≤ Real.sin x - (x - x ^ 3 / 6) by linarith
