  if w.val % 2 = 0 then decide (w.val / 2 < 33) else decide (w.val / 2 < 30)

/-! ### Part 1: Multi-Determinant Variational State & Hermitian Upper-Triangular Expansion -/

private noncomputable def multiDetVec {k D : ℕ} (dets : Fin D → (Fin k → Bool)) (c : Fin D → ℝ)
    (sNorm : ℝ) : Fin (2 ^ k) → ℂ :=
  ((1 / √sNorm : ℝ) : ℂ) • ∑ a : Fin D, (c a : ℂ) • detVec (dets a)

private lemma electronSectorProjector_mulVec_multiDetVec {k η D : ℕ}
    (dets : Fin D → (Fin k → Bool)) (c : Fin D → ℝ) (sNorm : ℝ)
    (hw : ∀ a : Fin D, (∑ j : Fin k, if dets a j then 1 else 0) = η) :
    electronSectorProjector k η *ᵥ multiDetVec dets c sNorm = multiDetVec dets c sNorm := by
  unfold multiDetVec
  rw [mulVec_smul, mulVec_sum]
  congr 1
  refine Finset.sum_congr rfl fun a _ ↦ ?_
  rw [mulVec_smul, electronSectorProjector_mulVec_detVec (dets a) (hw a)]

private lemma multiDetVec_normSq_sum {k D : ℕ} (dets : Fin D → (Fin k → Bool)) (c : Fin D → ℝ)
    (sNorm : ℝ) (hinj : Function.Injective dets) (hs_eq : sNorm = ∑ a : Fin D, (c a) ^ 2)
    (hs_pos : 0 < sNorm) :
    ∑ i : Fin (2 ^ k), Complex.normSq (multiDetVec dets c sNorm i) = 1 := by
  have hc : star (multiDetVec dets c sNorm) ⬝ᵥ multiDetVec dets c sNorm = (1 : ℂ) := by
    unfold multiDetVec
    rw [star_smul, smul_dotProduct, dotProduct_smul, star_sum, sum_dotProduct]
    have hdiag : (∑ a : Fin D, star ((c a : ℂ) • detVec (dets a)) ⬝ᵥ
          ∑ b : Fin D, (c b : ℂ) • detVec (dets b)) = (sNorm : ℂ) := by
      rw [hs_eq, Complex.ofReal_sum]
      refine Finset.sum_congr rfl fun a _ ↦ ?_
      rw [dotProduct_sum, star_smul, RCLike.star_def, Complex.conj_ofReal]
      have hterm (b : Fin D) :
          ((c a : ℂ) • star (detVec (dets a))) ⬝ᵥ ((c b : ℂ) • detVec (dets b)) =
            if b = a then (((c a) ^ 2 : ℝ) : ℂ) else 0 := by
        rw [smul_dotProduct, dotProduct_smul, star_detVec_dotProduct_detVec]
        by_cases hba : b = a
        · subst hba; simp [sq]
        · have hne : dets a ≠ dets b := fun h ↦ hba (hinj h).symm
          simp [hba, hne]
      simp_rw [hterm, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    rw [hdiag, RCLike.star_def, Complex.conj_ofReal, smul_eq_mul, smul_eq_mul]
    have hsq : (1 / √sNorm) * ((1 / √sNorm) * sNorm) = 1 := by
      have hsqrt_ne : √sNorm ≠ 0 := Real.sqrt_ne_zero'.mpr hs_pos
      calc
        (1 / √sNorm) * ((1 / √sNorm) * sNorm) = sNorm / (√sNorm * √sNorm) := by ring
        _ = sNorm / sNorm := by rw [Real.mul_self_sqrt hs_pos.le]
        _ = 1 := div_self hs_pos.ne'
    exact_mod_cast hsq
  have hre := congr_arg Complex.re (star_dotProduct_self_eq_sum_normSq (multiDetVec dets c sNorm))
  rw [hc] at hre
  simpa using hre.symm

private lemma hermitian_re_symm {d : ℕ} {H : Matrix (Fin d) (Fin d) ℂ} (hH : H.IsHermitian)
    (u v : Fin d → ℂ) :
    (star v ⬝ᵥ (H *ᵥ u)).re = (star u ⬝ᵥ (H *ᵥ v)).re := by
  calc
    (star v ⬝ᵥ (H *ᵥ u)).re = (star (Hᴴ *ᵥ v) ⬝ᵥ u).re := by
      rw [dotProduct_mulVec, star_mulVec, conjTranspose_conjTranspose]
    _ = (star (H *ᵥ v) ⬝ᵥ u).re := by rw [hH.eq]
    _ = (star (star u ⬝ᵥ (H *ᵥ v))).re := by rw [star_dotProduct]
    _ = (star u ⬝ᵥ (H *ᵥ v)).re := Complex.conj_re _

private lemma dotProduct_real_smul_mulVec {d : ℕ} (H : Matrix (Fin d) (Fin d) ℂ)
    (r s : ℝ) (x y : Fin d → ℂ) :
    star ((r : ℂ) • x) ⬝ᵥ (H *ᵥ ((s : ℂ) • y)) =
      ((r * s : ℝ) : ℂ) * (star x ⬝ᵥ (H *ᵥ y)) := by
  simp only [dotProduct, mulVec, Pi.star_apply, Pi.smul_apply, smul_eq_mul, star_mul',
    RCLike.star_def, Complex.conj_ofReal, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  refine Finset.sum_congr rfl fun j _ ↦ by push_cast; ring

private lemma re_hermitian_multiDet {d D : ℕ} {H : Matrix (Fin d) (Fin d) ℂ} (hH : H.IsHermitian)
    (v : Fin D → (Fin d → ℂ)) (c : Fin D → ℝ) (sNorm : ℝ) (hs_pos : 0 < sNorm) :
    let ψ := ((1 / √sNorm : ℝ) : ℂ) • ∑ a : Fin D, (c a : ℂ) • v a
    (star ψ ⬝ᵥ (H *ᵥ ψ)).re * sNorm =
      (∑ a : Fin D, (c a) ^ 2 * (star (v a) ⬝ᵥ (H *ᵥ v a)).re) +
      ∑ a : Fin D, ∑ b ∈ Finset.univ.filter (fun b ↦ a < b),
        2 * (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re := by
  intro ψ
  have hexp : star ψ ⬝ᵥ (H *ᵥ ψ) =
      (((1 / √sNorm) ^ 2 : ℝ) : ℂ) *
        ∑ a : Fin D, ∑ b : Fin D, ((c a * c b : ℝ) : ℂ) * (star (v a) ⬝ᵥ (H *ᵥ v b)) := by
    dsimp only [ψ]
    rw [dotProduct_real_smul_mulVec, ← sq, mulVec_sum, star_sum, sum_dotProduct]
    congr 1
    refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [dotProduct_sum]
    refine Finset.sum_congr rfl fun b _ ↦ dotProduct_real_smul_mulVec H (c a) (c b) (v a) (v b)
  have hre : (star ψ ⬝ᵥ (H *ᵥ ψ)).re * sNorm =
      ∑ a : Fin D, ∑ b : Fin D, (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re := by
    rw [hexp, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
      Complex.re_sum]
    have h1 : (1 / √sNorm) ^ 2 * sNorm = 1 := by
      rw [one_div, inv_pow, Real.sq_sqrt hs_pos.le, inv_mul_cancel₀ hs_pos.ne']
    calc
      (1 / √sNorm) ^ 2 * (∑ a : Fin D, (∑ b : Fin D,
          ((c a * c b : ℝ) : ℂ) * (star (v a) ⬝ᵥ (H *ᵥ v b))).re) * sNorm
        = ((1 / √sNorm) ^ 2 * sNorm) * ∑ a : Fin D, ∑ b : Fin D,
            (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re := by
          rw [mul_right_comm]
          congr 1
          refine Finset.sum_congr rfl fun a _ ↦ ?_
          rw [Complex.re_sum]
          refine Finset.sum_congr rfl fun b _ ↦ ?_
          rw [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
      _ = _ := by rw [h1, one_mul]
  rw [hre]
  -- Split pairs (a, b) into a = b, a < b, and b < a:
  have hsplit : (∑ a : Fin D, ∑ b : Fin D, (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re) =
      (∑ a : Fin D, (c a) ^ 2 * (star (v a) ⬝ᵥ (H *ᵥ v a)).re) +
      (∑ a : Fin D, ∑ b ∈ Finset.univ.filter (fun b ↦ a < b),
        (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re) +
      (∑ a : Fin D, ∑ b ∈ Finset.univ.filter (fun b ↦ b < a),
        (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re) := by
    simp_rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [Finset.sum_filter, Finset.sum_filter]
    have hrow : (∑ b : Fin D, (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re) =
        ∑ b : Fin D, ((if b = a then (c a) ^ 2 * (star (v a) ⬝ᵥ (H *ᵥ v a)).re else 0) +
          (if a < b then (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re else 0) +
          (if b < a then (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re else 0)) := by
      refine Finset.sum_congr rfl fun b _ ↦ ?_
      rcases lt_trichotomy a b with hab | rfl | hba
      · simp [hab, hab.ne', asymm hab]
      · simp [sq]
      · simp [hba, hba.ne, asymm hba]
    rw [hrow, Finset.sum_add_distrib, Finset.sum_add_distrib]
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  have hupper : (∑ a : Fin D, ∑ b ∈ Finset.univ.filter (fun b ↦ b < a),
        (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re) =
      ∑ a : Fin D, ∑ b ∈ Finset.univ.filter (fun b ↦ a < b),
        (c a * c b) * (star (v a) ⬝ᵥ (H *ᵥ v b)).re := by
    simp_rw [Finset.sum_filter]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ ↦ Finset.sum_congr rfl fun b _ ↦ ?_
    by_cases hab : a < b
    · simp only [hab, ↓reduceIte]
      rw [hermitian_re_symm hH (v a) (v b)]
      ring
    · simp [hab]
  rw [hsplit, hupper, add_assoc, ← Finset.sum_add_distrib]
  congr 1
  refine Finset.sum_congr rfl fun a _ ↦ ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun b _ ↦ by ring

private lemma re_hermitian_multiDetVec {k D : ℕ} {H : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ}
    (hH : H.IsHermitian) (dets : Fin D → (Fin k → Bool)) (c : Fin D → ℝ) (sNorm : ℝ)
    (hs_pos : 0 < sNorm) :
    (star (multiDetVec dets c sNorm) ⬝ᵥ (H *ᵥ multiDetVec dets c sNorm)).re * sNorm =
      (∑ a : Fin D, (c a) ^ 2 * (star (detVec (dets a)) ⬝ᵥ (H *ᵥ detVec (dets a))).re) +
      ∑ a : Fin D, ∑ b ∈ Finset.univ.filter (fun b ↦ a < b),
        2 * (c a * c b) * (star (detVec (dets a)) ⬝ᵥ (H *ᵥ detVec (dets b))).re :=
  re_hermitian_multiDet hH (fun a ↦ detVec (dets a)) c sNorm hs_pos
/-! ### Part 2: Off-Diagonal Slater-Condon Vanishing (`d_H ≥ 4` One-Body, `d_H ≥ 5` Two-Body)
and Exact 4-Wire Double-Excitation Identity -/

private lemma excite_apply_of_ne {k : ℕ} (b : Fin k → Bool) {h p w : Fin k}
    (hwh : w ≠ h) (hwp : w ≠ p) :
    excite b h p w = b w := by
  unfold excite
  rw [Function.update_of_ne hwp, Function.update_of_ne hwh]

private lemma diff_subset_two_of_eq_excite {k : ℕ} {b₁ b₂ : Fin k → Bool} {h p : Fin k}
    {s : Finset (Fin k)} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (heq : b₁ = excite b₂ h p) :
    s ⊆ {h, p} := by
  intro w hw
  by_contra hmem
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hmem
  apply hs w hw
  rw [heq, excite_apply_of_ne b₂ hmem.1 hmem.2]

private lemma ne_of_card_diff_ge_four {k : ℕ} {b₁ b₂ : Fin k → Bool} {s : Finset (Fin k)}
    (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (hcard : 4 ≤ s.card) : b₁ ≠ b₂ := by
  intro heq
  subst heq
  rcases s.eq_empty_or_nonempty with rfl | ⟨w, hw⟩
  · simp at hcard
  · exact hs w hw rfl

private lemma ne_excite_right_of_card_diff_ge_four {k : ℕ} {b₁ b₂ : Fin k → Bool} {h p : Fin k}
    {s : Finset (Fin k)} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (hcard : 4 ≤ s.card) :
    b₁ ≠ excite b₂ h p := by
  intro heq
  have hsub := Finset.card_le_card (diff_subset_two_of_eq_excite hs heq)
  have hle2 : ({h, p} : Finset (Fin k)).card ≤ 2 :=
    (Finset.card_insert_le h {p}).trans (by simp)
  omega

private lemma ne_excite_left_of_card_diff_ge_four {k : ℕ} {b₁ b₂ : Fin k → Bool} {h p : Fin k}
    {s : Finset (Fin k)} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (hcard : 4 ≤ s.card) :
    excite b₁ h p ≠ b₂ := by
  intro heq
  exact ne_excite_right_of_card_diff_ge_four (s := s) (fun w hw ↦ (hs w hw).symm) hcard heq.symm

private lemma diff_subset_four_of_excite_eq_excite {k : ℕ} {b₁ b₂ : Fin k → Bool}
    {h₁ p₁ h₂ p₂ : Fin k} {s : Finset (Fin k)} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w)
    (heq : excite b₁ h₁ p₁ = excite b₂ h₂ p₂) :
    s ⊆ {h₁, p₁, h₂, p₂} := by
  intro w hw
  by_contra hmem
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hmem
  rcases hmem with ⟨nh1, np1, nh2, np2⟩
  apply hs w hw
  have e1 := excite_apply_of_ne b₁ nh1 np1
  have e2 := excite_apply_of_ne b₂ nh2 np2
  rw [← e1, ← e2, heq]

private lemma excite_ne_excite_of_card_diff_ge_five {k : ℕ} {b₁ b₂ : Fin k → Bool}
    {h₁ p₁ h₂ p₂ : Fin k} {s : Finset (Fin k)} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w)
    (hcard : 5 ≤ s.card) :
    excite b₁ h₁ p₁ ≠ excite b₂ h₂ p₂ := by
  intro heq
  have hsub := Finset.card_le_card (diff_subset_four_of_excite_eq_excite hs heq)
  have hle4 : ({h₁, p₁, h₂, p₂} : Finset (Fin k)).card ≤ 4 := by
    calc
      ({h₁, p₁, h₂, p₂} : Finset (Fin k)).card ≤ ({p₁, h₂, p₂} : Finset (Fin k)).card + 1 :=
        Finset.card_insert_le _ _
      _ ≤ ({h₂, p₂} : Finset (Fin k)).card + 1 + 1 := by gcongr; exact Finset.card_insert_le _ _
      _ ≤ ({p₂} : Finset (Fin k)).card + 1 + 1 + 1 := by gcongr; exact Finset.card_insert_le _ _
      _ = 4 := by simp
  omega

private lemma dotProduct_orbitalNumberOp_eq_zero_of_diff4 {N : ℕ} {b₁ b₂ : Fin (2 * N) → Bool}
    {s : Finset (Fin (2 * N))} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (hcard : 4 ≤ s.card)
    (u : Fin N → ℝ) (σ : Fin 2) :
    star (detVec b₁) ⬝ᵥ (orbitalNumberOp N u σ *ᵥ detVec b₂) = 0 := by
  rw [orbitalNumberOp_mulVec_detVec, dotProduct_add, dotProduct_smul,
    star_detVec_dotProduct_detVec, ite_eq_right (ne_of_card_diff_ge_four hs hcard), smul_zero,
    zero_add, dotProduct_sum]
  refine Finset.sum_eq_zero fun q _ ↦ ?_
  rw [dotProduct_sum]
  refine Finset.sum_eq_zero fun p _ ↦ ?_
  split_ifs
  · rw [dotProduct_smul, star_detVec_dotProduct_detVec,
      ite_eq_right (ne_excite_right_of_card_diff_ge_four hs hcard), smul_zero]
  · simp

private lemma dotProduct_oneBodyHamiltonian_eq_zero_of_diff4 {N L M : ℕ}
    {b₁ b₂ : Fin (2 * N) → Bool} {s : Finset (Fin (2 * N))}
    (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (hcard : 4 ≤ s.card)
    (eig : Fin L → ℝ) (u : Fin L → Fin N → ℝ) (κ : Fin M → ℝ) (chi : Fin M → Fin N → ℝ)
    (h1e : Matrix (Fin N) (Fin N) ℝ)
    (hh1e : h1e = ∑ ℓ : Fin L, eig ℓ • vecMulVec (u ℓ) (u ℓ) +
      ∑ μ : Fin M, κ μ • vecMulVec (chi μ) (chi μ)) :
    star (detVec b₁) ⬝ᵥ (oneBodyHamiltonian h1e *ᵥ detVec b₂) = 0 := by
  have hsingle (t : ℝ) (v : Fin N → ℝ) :
      star (detVec b₁) ⬝ᵥ (oneBodyHamiltonian (t • vecMulVec v v) *ᵥ detVec b₂) = 0 := by
    rw [oneBodyHamiltonian_smul_vecMulVec, smul_mulVec, dotProduct_smul, sum_mulVec,
      Fin.sum_univ_two, dotProduct_add,
      dotProduct_orbitalNumberOp_eq_zero_of_diff4 hs hcard,
      dotProduct_orbitalNumberOp_eq_zero_of_diff4 hs hcard, add_zero, smul_zero]
  rw [hh1e, oneBodyHamiltonian_add, add_mulVec, dotProduct_add,
    oneBodyHamiltonian_sum, sum_mulVec, dotProduct_sum,
    oneBodyHamiltonian_sum, sum_mulVec, dotProduct_sum]
  simp_rw [hsingle, Finset.sum_const_zero, add_zero]
private lemma dotProduct_orbitalNumberOp_mul_of_diff4 {N : ℕ} {b₁ b₂ : Fin (2 * N) → Bool}
    {s : Finset (Fin (2 * N))} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (hcard : 4 ≤ s.card)
    (u v : Fin N → ℝ) (σ τ : Fin 2) :
    star (detVec b₁) ⬝ᵥ ((orbitalNumberOp N u σ * orbitalNumberOp N v τ) *ᵥ detVec b₂) =
      ∑ q₁ : Fin N, ∑ p₁ : Fin N, ∑ q₂ : Fin N, ∑ p₂ : Fin N,
        if (b₁ (spinOrbital N q₁ σ) && !b₁ (spinOrbital N p₁ σ)) &&
            (b₂ (spinOrbital N q₂ τ) && !b₂ (spinOrbital N p₂ τ)) &&
            decide (excite b₁ (spinOrbital N q₁ σ) (spinOrbital N p₁ σ) =
              excite b₂ (spinOrbital N q₂ τ) (spinOrbital N p₂ τ)) then
          ((u p₁ * u q₁ * (v p₂ * v q₂) : ℝ) : ℂ) *
            (star (exciteSign b₁ (spinOrbital N q₁ σ) (spinOrbital N p₁ σ)) *
              exciteSign b₂ (spinOrbital N q₂ τ) (spinOrbital N p₂ τ))
        else 0 := by
  have hadj : star (detVec b₁) ⬝ᵥ
      ((orbitalNumberOp N u σ * orbitalNumberOp N v τ) *ᵥ detVec b₂) =
      star (orbitalNumberOp N u σ *ᵥ detVec b₁) ⬝ᵥ (orbitalNumberOp N v τ *ᵥ detVec b₂) := by
    rw [← mulVec_mulVec, dotProduct_mulVec, star_mulVec,
      (orbitalNumberOp_isHermitian u σ).eq]
  rw [hadj]
  have hD1 : star ((occDot b₁ σ u u : ℂ) • detVec b₁) ⬝ᵥ
      (orbitalNumberOp N v τ *ᵥ detVec b₂) = 0 := by
    rw [star_smul, smul_dotProduct, dotProduct_orbitalNumberOp_eq_zero_of_diff4 hs hcard,
      smul_zero]
  conv_lhs => rw [orbitalNumberOp_mulVec_detVec b₁ u σ]
  rw [star_add, add_dotProduct, hD1, zero_add]
  rw [orbitalNumberOp_mulVec_detVec b₂ v τ, star_sum, sum_dotProduct]
  refine Finset.sum_congr rfl fun q₁ _ ↦ ?_
  rw [star_sum, sum_dotProduct]
  refine Finset.sum_congr rfl fun p₁ _ ↦ ?_
  by_cases hc1 : (b₁ (spinOrbital N q₁ σ) && !b₁ (spinOrbital N p₁ σ)) = true
  · rw [ite_eq_left hc1, dotProduct_add, star_smul, smul_dotProduct, dotProduct_smul,
      star_detVec_dotProduct_detVec, ite_eq_right (ne_excite_left_of_card_diff_ge_four hs hcard),
      smul_zero, smul_zero, zero_add, dotProduct_sum]
    refine Finset.sum_congr rfl fun q₂ _ ↦ ?_
    rw [dotProduct_sum]
    refine Finset.sum_congr rfl fun p₂ _ ↦ ?_
    by_cases hc2 : (b₂ (spinOrbital N q₂ τ) && !b₂ (spinOrbital N p₂ τ)) = true
    · rw [ite_eq_left hc2, smul_dotProduct, dotProduct_smul, star_detVec_dotProduct_detVec]
      by_cases heq : excite b₁ (spinOrbital N q₁ σ) (spinOrbital N p₁ σ) =
          excite b₂ (spinOrbital N q₂ τ) (spinOrbital N p₂ τ)
      · simp only [hc1, hc2, Bool.true_and, heq, decide_true, ↓reduceIte, star_mul',
          RCLike.star_def, Complex.conj_ofReal, smul_eq_mul]
        push_cast; ring
      · simp [hc1, hc2, heq]
    · have hc2f : (b₂ (spinOrbital N q₂ τ) && !b₂ (spinOrbital N p₂ τ)) = false :=
        Bool.eq_false_iff.mpr hc2
      simp [hc1, hc2f]
  · have hc1f : (b₁ (spinOrbital N q₁ σ) && !b₁ (spinOrbital N p₁ σ)) = false :=
      Bool.eq_false_iff.mpr hc1
    simp [hc1f]

private lemma dotProduct_thcHamiltonian_eq_zero_of_diff5 (b₁ b₂ : Fin (2 * 58) → Bool)
    {s : Finset (Fin (2 * 58))} (hs : ∀ w ∈ s, b₁ w ≠ b₂ w) (hcard : 5 ≤ s.card) :
    star (detVec b₁) ⬝ᵥ (thcHamiltonian rThc *ᵥ detVec b₂) = 0 := by
  have hcard4 : 4 ≤ s.card := by omega
  rw [thcHamiltonian, add_mulVec, dotProduct_add]
  have h1 : star (detVec b₁) ⬝ᵥ (oneBodyHamiltonian rThc.h1eMod *ᵥ detVec b₂) = 0 :=
    dotProduct_oneBodyHamiltonian_eq_zero_of_diff4 hs hcard4 oneBodyEigenvalue rObVec
      (fun μ ↦ ∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ)
      rThc.chi rThc.h1eMod rfl
  rw [h1, zero_add, smul_mulVec, dotProduct_smul]
  suffices h2 : (∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
      (rThc.zeta μ ν : ℂ) •
        (orbitalNumberOp 58 (rThc.chi μ) σ * orbitalNumberOp 58 (rThc.chi ν) τ)) *ᵥ detVec b₂ =
      0 ∨ star (detVec b₁) ⬝ᵥ
      ((∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        (rThc.zeta μ ν : ℂ) •
          (orbitalNumberOp 58 (rThc.chi μ) σ * orbitalNumberOp 58 (rThc.chi ν) τ)) *ᵥ detVec b₂)
        = 0 by
    rcases h2 with h2 | h2
    · rw [h2, dotProduct_zero, smul_zero]
    · rw [h2, smul_zero]
  right
  simp only [sum_mulVec, dotProduct_sum, smul_mulVec, dotProduct_smul]
  refine Finset.sum_eq_zero fun σ _ ↦ Finset.sum_eq_zero fun τ _ ↦
    Finset.sum_eq_zero fun μ _ ↦ Finset.sum_eq_zero fun ν _ ↦ ?_
  rw [dotProduct_orbitalNumberOp_mul_of_diff4 hs hcard4]
  have hz : (∑ q₁ : Fin 58, ∑ p₁ : Fin 58, ∑ q₂ : Fin 58, ∑ p₂ : Fin 58,
      if (b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
          (b₂ (spinOrbital 58 q₂ τ) && !b₂ (spinOrbital 58 p₂ τ)) &&
          decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
            excite b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ)) then
        ((rThc.chi μ p₁ * rThc.chi μ q₁ * (rThc.chi ν p₂ * rThc.chi ν q₂) : ℝ) : ℂ) *
          (star (exciteSign b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ)) *
            exciteSign b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ))
      else 0) = 0 := by
    refine Finset.sum_eq_zero fun q₁ _ ↦ Finset.sum_eq_zero fun p₁ _ ↦
      Finset.sum_eq_zero fun q₂ _ ↦ Finset.sum_eq_zero fun p₂ _ ↦ ?_
    rw [decide_eq_false (excite_ne_excite_of_card_diff_ge_five hs hcard)]
    simp
  rw [hz, smul_zero]
private lemma excite_eq_excite_of_quad {k : ℕ} {b₁ b₂ : Fin k → Bool} {a b c d : Fin k}
    (ha : b₁ a = true ∧ b₂ a = false) (hd : b₁ d = true ∧ b₂ d = false)
    (hb : b₁ b = false ∧ b₂ b = true) (hc : b₁ c = false ∧ b₂ c = true)
    (had : a ≠ d) (hbc : b ≠ c)
    (hagree : ∀ w : Fin k, w ≠ a → w ≠ d → w ≠ b → w ≠ c → b₁ w = b₂ w) :
    excite b₁ a b = excite b₂ c d := by
  have hab : a ≠ b := fun h ↦ by subst h; simp [ha.1] at hb
  have hac : a ≠ c := fun h ↦ by subst h; simp [ha.1] at hc
  have hdb : d ≠ b := fun h ↦ by subst h; simp [hd.1] at hb
  have hdc : d ≠ c := fun h ↦ by subst h; simp [hd.1] at hc
  ext w
  unfold excite
  by_cases hwa : w = a
  · subst hwa
    rw [Function.update_of_ne hab, Function.update_self,
      Function.update_of_ne had, Function.update_of_ne hac, ha.2]
  · by_cases hwd : w = d
    · subst hwd
      rw [Function.update_of_ne hdb, Function.update_of_ne had.symm, hd.1, Function.update_self]
    · by_cases hwb : w = b
      · subst hwb
        rw [Function.update_self, Function.update_of_ne hdb.symm, Function.update_of_ne hbc, hb.2]
      · by_cases hwc : w = c
        · subst hwc
          rw [Function.update_of_ne hbc.symm, Function.update_of_ne hac.symm, hc.1,
            Function.update_of_ne hdc.symm, Function.update_self]
        · rw [Function.update_of_ne hwb, Function.update_of_ne hwa,
            Function.update_of_ne hwd, Function.update_of_ne hwc,
            hagree w hwa hwd hwb hwc]

private lemma excite_eq_excite_iff_four_quads {k : ℕ} {b₁ b₂ : Fin k → Bool}
    {wp₁ wp₂ wh₁ wh₂ wq₁ wp_1 wq₂ wp_2 : Fin k}
    (hwp_ne : wp₁ ≠ wp₂) (hwh_ne : wh₁ ≠ wh₂)
    (hwp1 : b₁ wp₁ = true ∧ b₂ wp₁ = false) (hwp2 : b₁ wp₂ = true ∧ b₂ wp₂ = false)
    (hwh1 : b₁ wh₁ = false ∧ b₂ wh₁ = true) (hwh2 : b₁ wh₂ = false ∧ b₂ wh₂ = true)
    (hagree : ∀ w : Fin k, w ≠ wp₁ → w ≠ wp₂ → w ≠ wh₁ → w ≠ wh₂ → b₁ w = b₂ w) :
    (((b₁ wq₁ && !b₁ wp_1) && (b₂ wq₂ && !b₂ wp_2) &&
        decide (excite b₁ wq₁ wp_1 = excite b₂ wq₂ wp_2)) = true) ↔
      ((wq₁ = wp₁ ∧ wp_2 = wp₂) ∨ (wq₁ = wp₂ ∧ wp_2 = wp₁)) ∧
      ((wp_1 = wh₁ ∧ wq₂ = wh₂) ∨ (wp_1 = wh₂ ∧ wq₂ = wh₁)) := by
  constructor
  · intro h
    obtain ⟨hc12, hdec⟩ := Bool.and_eq_true_iff.mp h
    obtain ⟨hc1, hc2⟩ := Bool.and_eq_true_iff.mp hc12
    obtain ⟨hq1, hp1⟩ := Bool.and_eq_true_iff.mp hc1
    obtain ⟨hq2, hp2⟩ := Bool.and_eq_true_iff.mp hc2
    simp only [Bool.not_eq_true'] at hp1 hp2
    have heq : excite b₁ wq₁ wp_1 = excite b₂ wq₂ wp_2 := of_decide_eq_true hdec
    let s : Finset (Fin k) := {wp₁, wp₂, wh₁, wh₂}
    have hs : ∀ w ∈ s, b₁ w ≠ b₂ w := by
      intro w hw
      simp only [s, Finset.mem_insert, Finset.mem_singleton] at hw
      rcases hw with rfl | rfl | rfl | rfl
      · simp [hwp1.1, hwp1.2]
      · simp [hwp2.1, hwp2.2]
      · simp [hwh1.1, hwh1.2]
      · simp [hwh2.1, hwh2.2]
    have hsub := diff_subset_four_of_excite_eq_excite hs heq
    have hmem_wp1 : wp₁ = wq₁ ∨ wp₁ = wp_2 := by
      have hm := @hsub wp₁ (by simp [s])
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm
      rcases hm with h1 | h1 | h1 | h1
      · exact Or.inl h1
      · exfalso; rw [← h1, hwp1.1] at hp1; exact Bool.false_ne_true hp1.symm
      · exfalso; rw [← h1, hwp1.2] at hq2; exact Bool.false_ne_true hq2
      · exact Or.inr h1
    have hmem_wp2 : wp₂ = wq₁ ∨ wp₂ = wp_2 := by
      have hm := @hsub wp₂ (by simp [s])
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm
      rcases hm with h1 | h1 | h1 | h1
      · exact Or.inl h1
      · exfalso; rw [← h1, hwp2.1] at hp1; exact Bool.false_ne_true hp1.symm
      · exfalso; rw [← h1, hwp2.2] at hq2; exact Bool.false_ne_true hq2
      · exact Or.inr h1
    have hmem_wh1 : wh₁ = wp_1 ∨ wh₁ = wq₂ := by
      have hm := @hsub wh₁ (by simp [s])
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm
      rcases hm with h1 | h1 | h1 | h1
      · exfalso; rw [← h1, hwh1.1] at hq1; exact Bool.false_ne_true hq1
      · exact Or.inl h1
      · exact Or.inr h1
      · exfalso; rw [← h1, hwh1.2] at hp2; exact Bool.false_ne_true hp2.symm
    have hmem_wh2 : wh₂ = wp_1 ∨ wh₂ = wq₂ := by
      have hm := @hsub wh₂ (by simp [s])
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm
      rcases hm with h1 | h1 | h1 | h1
      · exfalso; rw [← h1, hwh2.1] at hq1; exact Bool.false_ne_true hq1
      · exact Or.inl h1
      · exact Or.inr h1
      · exfalso; rw [← h1, hwh2.2] at hp2; exact Bool.false_ne_true hp2.symm
    constructor
    · rcases hmem_wp1 with rfl | rfl <;> rcases hmem_wp2 with h2 | h2
      · exact absurd h2.symm hwp_ne
      · exact Or.inl ⟨rfl, h2.symm⟩
      · exact Or.inr ⟨h2.symm, rfl⟩
      · exact absurd h2.symm hwp_ne
    · rcases hmem_wh1 with rfl | rfl <;> rcases hmem_wh2 with h2 | h2
      · exact absurd h2.symm hwh_ne
      · exact Or.inl ⟨rfl, h2.symm⟩
      · exact Or.inr ⟨h2.symm, rfl⟩
      · exact absurd h2.symm hwh_ne
  · rintro ⟨(⟨rfl, rfl⟩ | ⟨rfl, rfl⟩), (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)⟩
    · have he := excite_eq_excite_of_quad hwp1 hwp2 hwh1 hwh2 hwp_ne hwh_ne hagree
      simp [hwp1.1, hwh1.1, hwh2.2, hwp2.2, he]
    · have he := excite_eq_excite_of_quad hwp1 hwp2 hwh2 hwh1 hwp_ne hwh_ne.symm
        (fun w h1 h2 h3 h4 ↦ hagree w h1 h2 h4 h3)
      simp [hwp1.1, hwh2.1, hwh1.2, hwp2.2, he]
    · have he := excite_eq_excite_of_quad hwp2 hwp1 hwh1 hwh2 hwp_ne.symm hwh_ne
        (fun w h1 h2 h3 h4 ↦ hagree w h2 h1 h3 h4)
      simp [hwp2.1, hwh1.1, hwh2.2, hwp1.2, he]
    · have he := excite_eq_excite_of_quad hwp2 hwp1 hwh2 hwh1 hwp_ne.symm hwh_ne.symm
        (fun w h1 h2 h3 h4 ↦ hagree w h2 h1 h4 h3)
      simp [hwp2.1, hwh2.1, hwh1.2, hwp1.2, he]

private def wireEquiv (N : ℕ) : Fin N × Fin 2 ≃ Fin (2 * N) where
  toFun ps := spinOrbital N ps.1 ps.2
  invFun w := (⟨w.val / 2, by omega⟩, ⟨w.val % 2, by omega⟩)
  left_inv ps := by
    rcases ps with ⟨p, σ⟩
    have hσ : σ.val < 2 := σ.isLt
    dsimp [spinOrbital]
    ext <;> dsimp <;> omega
  right_inv w := by
    dsimp [spinOrbital]
    ext; dsimp; omega

private lemma sum_spinOrbital_pair {N : ℕ} {α : Type*} [AddCommMonoid α]
    (F : Fin (2 * N) → Fin (2 * N) → α) :
    (∑ σ : Fin 2, ∑ q : Fin N, ∑ p : Fin N, F (spinOrbital N q σ) (spinOrbital N p σ)) =
      ∑ wq : Fin (2 * N), ∑ wp : Fin (2 * N),
        if wq.val % 2 = wp.val % 2 then F wq wp else 0 := by
  symm
  rw [← (wireEquiv N).sum_comp]
  simp_rw [← (wireEquiv N).sum_comp]
  rw [Fintype.sum_prod_type]
  simp_rw [Fintype.sum_prod_type]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun σ _ ↦ Finset.sum_congr rfl fun q _ ↦
    Finset.sum_congr rfl fun p _ ↦ ?_
  have hmod (x : Fin N) (s : Fin 2) : (wireEquiv N (x, s)).val % 2 = s.val := by
    have hs : s.val < 2 := s.isLt
    change (2 * x.val + s.val) % 2 = s.val
    omega
  simp_rw [hmod, ← Fin.ext_iff]
  have hite (τ : Fin 2) :
      (if σ = τ then F (wireEquiv N (q, σ)) (wireEquiv N (p, τ)) else 0) =
        if τ = σ then F (spinOrbital N q σ) (spinOrbital N p σ) else 0 := by
    by_cases h : τ = σ
    · subst h; simp [wireEquiv]
    · have h' : σ ≠ τ := Ne.symm h
      simp [h, h']
  simp_rw [hite, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

/-- Internal Deep helper `modeMatrix`. -/
noncomputable def modeMatrix (r : Fin 9) (c : Fin 14) (p q : Fin 58) : ℝ :=
  ∑ b_idx : Fin 29, (deepInnerInt r c b_idx.val : ℝ) *
    (rLeafVec (leafEquiv (r, b_idx)) p * rLeafVec (leafEquiv (r, b_idx)) q)

private lemma zeta_chi_sum_eq_modeMatrix (p₁ q₁ p₂ q₂ : Fin 58) :
    2⁻¹ * (∑ μ : Fin 261, ∑ ν : Fin 261,
        rThc.zeta μ ν *
          (rThc.chi μ p₁ * rThc.chi μ q₁ * (rThc.chi ν p₂ * rThc.chi ν q₂))) =
      (coefficientUnit / (15360 ^ 2 : ℝ)) *
        ∑ r : Fin 9, ∑ c : Fin 14,
          ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
            (modeMatrix r c p₁ q₁ * modeMatrix r c p₂ q₂) := by
  have hchi (μ : Fin 261) : rThc.chi μ = rLeafVec μ := rfl
  have hzeta (μ ν : Fin 261) :
      rThc.zeta μ ν =
        ∑ r : Fin 9, ∑ c : Fin 14,
          fragmentVector r c μ * fragmentVector r c ν := by
    change (∑ r : Fin 9, ∑ c : Fin 14,
      vecMulVec (fragmentVector r c) (fragmentVector r c)) μ ν = _
    simp [Matrix.sum_apply, vecMulVec_apply]
  simp_rw [hchi, hzeta, Finset.sum_mul]
  rw [sum_prod_swap, Finset.mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun r _ ↦ ?_
  rw [Finset.mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun c _ ↦ ?_
  have hν (μ : Fin 261) :
      (∑ ν : Fin 261, fragmentVector r c μ * fragmentVector r c ν *
        (rLeafVec μ p₁ * rLeafVec μ q₁ * (rLeafVec ν p₂ * rLeafVec ν q₂))) =
      fragmentVector r c μ * (rLeafVec μ p₁ * rLeafVec μ q₁) *
        ∑ b₂ : Fin 29, weight r c b₂.castSucc *
          (rLeafVec (leafEquiv (r, b₂)) p₂ * rLeafVec (leafEquiv (r, b₂)) q₂) := by
    trans ∑ ν : Fin 261, (fragmentVector r c μ * (rLeafVec μ p₁ * rLeafVec μ q₁)) *
        (fragmentVector r c ν * (rLeafVec ν p₂ * rLeafVec ν q₂))
    · refine Finset.sum_congr rfl fun ν _ ↦ by ring
    · rw [← Finset.mul_sum, deep_sum_leafEquiv_fragmentVector]
  simp_rw [hν]
  rw [← Finset.sum_mul, deep_sum_leafEquiv_fragmentVector, Finset.sum_mul]
  have hprod :
      (∑ b₁ : Fin 29, weight r c b₁.castSucc *
          (rLeafVec (leafEquiv (r, b₁)) p₁ * rLeafVec (leafEquiv (r, b₁)) q₁) *
        ∑ b₂ : Fin 29, weight r c b₂.castSucc *
          (rLeafVec (leafEquiv (r, b₂)) p₂ * rLeafVec (leafEquiv (r, b₂)) q₂)) =
      ∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
        (weight r c b₁.castSucc * weight r c b₂.castSucc) *
          ((rLeafVec (leafEquiv (r, b₁)) p₁ * rLeafVec (leafEquiv (r, b₁)) q₁) *
            (rLeafVec (leafEquiv (r, b₂)) p₂ * rLeafVec (leafEquiv (r, b₂)) q₂)) := by
    refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun b₂ _ ↦ by ring
  rw [hprod]
  simp_rw [deep_weight_mul_weight]; dsimp only [Fin.val_castSucc]
  have hmode :
      ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) * (modeMatrix r c p₁ q₁ * modeMatrix r c p₂ q₂) =
        ∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
          ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
            (((deepInnerInt r c b₁.val : ℝ) *
              (rLeafVec (leafEquiv (r, b₁)) p₁ * rLeafVec (leafEquiv (r, b₁)) q₁)) *
             ((deepInnerInt r c b₂.val : ℝ) *
              (rLeafVec (leafEquiv (r, b₂)) p₂ * rLeafVec (leafEquiv (r, b₂)) q₂))) := by
    unfold modeMatrix
    simp_rw [Finset.sum_mul]
    simp_rw [Finset.mul_sum]
  rw [hmode]
  simp_rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
  refine Finset.sum_congr rfl fun b₂ _ ↦ ?_
  push_cast; ring

private noncomputable def offDiagQuadReal (b₁ b₂ : Fin (2 * 58) → Bool)
    (wq₁ wp₁ wq₂ wp₂ : Fin (2 * 58)) : ℝ :=
  if wq₁.val % 2 = wp₁.val % 2 ∧ wq₂.val % 2 = wp₂.val % 2 then
    (star (exciteSign b₁ wq₁ wp₁) * exciteSign b₂ wq₂ wp₂).re *
      ((coefficientUnit / (15360 ^ 2 : ℝ)) *
        ∑ r : Fin 9, ∑ c : Fin 14,
          ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
            (modeMatrix r c ⟨wp₁.val / 2, by omega⟩ ⟨wq₁.val / 2, by omega⟩ *
              modeMatrix r c ⟨wp₂.val / 2, by omega⟩ ⟨wq₂.val / 2, by omega⟩))
  else 0

private lemma re_thcHamiltonian_offDiag_of_four_quads (b₁ b₂ : Fin (2 * 58) → Bool)
    {wp₁ wp₂ wh₁ wh₂ : Fin (2 * 58)}
    (hwp_ne : wp₁ ≠ wp₂) (hwh_ne : wh₁ ≠ wh₂)
    (hwp1 : b₁ wp₁ = true ∧ b₂ wp₁ = false) (hwp2 : b₁ wp₂ = true ∧ b₂ wp₂ = false)
    (hwh1 : b₁ wh₁ = false ∧ b₂ wh₁ = true) (hwh2 : b₁ wh₂ = false ∧ b₂ wh₂ = true)
    (hagree : ∀ w : Fin (2 * 58), w ≠ wp₁ → w ≠ wp₂ → w ≠ wh₁ → w ≠ wh₂ → b₁ w = b₂ w) :
    (star (detVec b₁) ⬝ᵥ (thcHamiltonian rThc *ᵥ detVec b₂)).re =
      offDiagQuadReal b₁ b₂ wp₁ wh₁ wh₂ wp₂ +
      offDiagQuadReal b₁ b₂ wp₁ wh₂ wh₁ wp₂ +
      offDiagQuadReal b₁ b₂ wp₂ wh₁ wh₂ wp₁ +
      offDiagQuadReal b₁ b₂ wp₂ wh₂ wh₁ wp₁ := by
  let s : Finset (Fin (2 * 58)) := {wp₁, wp₂, wh₁, wh₂}
  have hs : ∀ w ∈ s, b₁ w ≠ b₂ w := by
    intro w hw; simp only [s, Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl | rfl <;> simp_all
  have h13 : wp₁ ≠ wh₁ := fun h ↦ by subst h; simp [hwp1.1] at hwh1
  have h14 : wp₁ ≠ wh₂ := fun h ↦ by subst h; simp [hwp1.1] at hwh2
  have h23 : wp₂ ≠ wh₁ := fun h ↦ by subst h; simp [hwp2.1] at hwh1
  have h24 : wp₂ ≠ wh₂ := fun h ↦ by subst h; simp [hwp2.1] at hwh2
  have hcard4 : 4 ≤ s.card := by
    have hc : s.card = 4 := by
      simp [s, hwp_ne, h13, h14, h23, h24, hwh_ne]
    omega
  rw [thcHamiltonian, add_mulVec, dotProduct_add,
    dotProduct_oneBodyHamiltonian_eq_zero_of_diff4 hs hcard4 oneBodyEigenvalue rObVec
      (fun μ ↦ ∑ r : Fin 9, ∑ c : Fin 14, fragmentShift r c * fragmentVector r c μ)
      rThc.chi rThc.h1eMod rfl,
    zero_add, smul_mulVec, dotProduct_smul]
  simp only [sum_mulVec, dotProduct_sum, smul_mulVec, dotProduct_smul, smul_eq_mul]
  simp_rw [dotProduct_orbitalNumberOp_mul_of_diff4 hs hcard4]
  -- Move (μ, ν) outside (σ, τ, q₁, p₁, q₂, p₂), collapse spinOrbital pairs, and apply 4-quad iff:
  have hswap :
      ((2 : ℂ)⁻¹ * ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin 261, ∑ ν : Fin 261,
        (rThc.zeta μ ν : ℂ) * ∑ q₁ : Fin 58, ∑ p₁ : Fin 58, ∑ q₂ : Fin 58, ∑ p₂ : Fin 58,
          if (b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
              (b₂ (spinOrbital 58 q₂ τ) && !b₂ (spinOrbital 58 p₂ τ)) &&
              decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
                excite b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ)) then
            ((rThc.chi μ p₁ * rThc.chi μ q₁ * (rThc.chi ν p₂ * rThc.chi ν q₂) : ℝ) : ℂ) *
              (star (exciteSign b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ)) *
                exciteSign b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ))
          else 0).re =
      ∑ wq₁ : Fin (2 * 58), ∑ wp₁' : Fin (2 * 58), ∑ wq₂ : Fin (2 * 58), ∑ wp₂' : Fin (2 * 58),
        if ((b₁ wq₁ && !b₁ wp₁') && (b₂ wq₂ && !b₂ wp₂') &&
            decide (excite b₁ wq₁ wp₁' = excite b₂ wq₂ wp₂')) then
          offDiagQuadReal b₁ b₂ wq₁ wp₁' wq₂ wp₂'
        else 0 := by
    rw [show ((2 : ℂ)⁻¹ : ℂ) = ((2⁻¹ : ℝ) : ℂ) by norm_num, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero]
    simp_rw [Complex.re_sum (s := (Finset.univ : Finset (Fin 2))),
      Finset.mul_sum (s := (Finset.univ : Finset (Fin 2))),
      Complex.re_sum (s := (Finset.univ : Finset (Fin 261)))]
    -- First reindex σ, q₁, p₁ and τ, q₂, p₂ via sum_spinOrbital_pair.
    have hinner (σ τ : Fin 2) :
        (2⁻¹ * ∑ μ : Fin 261, ∑ ν : Fin 261,
          ((rThc.zeta μ ν : ℂ) * ∑ q₁ : Fin 58, ∑ p₁ : Fin 58, ∑ q₂ : Fin 58, ∑ p₂ : Fin 58,
            if (b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
                (b₂ (spinOrbital 58 q₂ τ) && !b₂ (spinOrbital 58 p₂ τ)) &&
                decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
                  excite b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ)) then
              ((rThc.chi μ p₁ * rThc.chi μ q₁ * (rThc.chi ν p₂ * rThc.chi ν q₂) : ℝ) : ℂ) *
                (star (exciteSign b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ)) *
                  exciteSign b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ))
            else 0).re) =
        ∑ q₁ : Fin 58, ∑ p₁ : Fin 58, ∑ q₂ : Fin 58, ∑ p₂ : Fin 58,
          if (b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
              (b₂ (spinOrbital 58 q₂ τ) && !b₂ (spinOrbital 58 p₂ τ)) &&
              decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
                excite b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ)) then
            (star (exciteSign b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ)) *
              exciteSign b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ)).re *
              ((coefficientUnit / (15360 ^ 2 : ℝ)) *
                ∑ r : Fin 9, ∑ c : Fin 14,
                  ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                    (modeMatrix r c p₁ q₁ * modeMatrix r c p₂ q₂))
          else 0 := by
      conv =>
        lhs
        simp only [Finset.mul_sum, Complex.re_sum]
      rw [sum_prod_swap]
      refine Finset.sum_congr rfl fun q₁ _ ↦ Finset.sum_congr rfl fun p₁ _ ↦ ?_
      rw [sum_prod_swap]
      refine Finset.sum_congr rfl fun q₂ _ ↦ Finset.sum_congr rfl fun p₂ _ ↦ ?_
      split_ifs
      · rw [← zeta_chi_sum_eq_modeMatrix p₁ q₁ p₂ q₂]
        simp only [Finset.mul_sum]
        refine Finset.sum_congr rfl fun μ _ ↦ Finset.sum_congr rfl fun ν _ ↦ ?_
        rw [← mul_assoc (rThc.zeta μ ν : ℂ), ← Complex.ofReal_mul, Complex.mul_re,
          Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
        ring
      · simp
    simp_rw [hinner]
    -- Now apply sum_spinOrbital_pair to τ and σ.
    have hdiv (p : Fin 58) (s : Fin 2) :
        (⟨(spinOrbital 58 p s).val / 2, by omega⟩ : Fin 58) = p := by
      have hs : s.val < 2 := s.isLt
      ext; change (2 * p.val + s.val) / 2 = p.val; omega
    have hmod_eq (x y : Fin 58) (s : Fin 2) :
        (spinOrbital 58 x s).val % 2 = (spinOrbital 58 y s).val % 2 := by
      have hs : s.val < 2 := s.isLt
      change (2 * x.val + s.val) % 2 = (2 * y.val + s.val) % 2; omega
    have hstep1 (σ : Fin 2) :
        (∑ τ : Fin 2, ∑ q₁ : Fin 58, ∑ p₁ : Fin 58, ∑ q₂ : Fin 58, ∑ p₂ : Fin 58,
          if (b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
              (b₂ (spinOrbital 58 q₂ τ) && !b₂ (spinOrbital 58 p₂ τ)) &&
              decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
                excite b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ)) then
            (star (exciteSign b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ)) *
              exciteSign b₂ (spinOrbital 58 q₂ τ) (spinOrbital 58 p₂ τ)).re *
              ((coefficientUnit / (15360 ^ 2 : ℝ)) *
                ∑ r : Fin 9, ∑ c : Fin 14,
                  ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                    (modeMatrix r c p₁ q₁ * modeMatrix r c p₂ q₂))
          else 0) =
        ∑ q₁ : Fin 58, ∑ p₁ : Fin 58, ∑ wq₂ : Fin (2 * 58), ∑ wp₂' : Fin (2 * 58),
          if ((b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
              (b₂ wq₂ && !b₂ wp₂') &&
              decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
                excite b₂ wq₂ wp₂')) then
            if (spinOrbital 58 q₁ σ).val % 2 = (spinOrbital 58 p₁ σ).val % 2 ∧
                wq₂.val % 2 = wp₂'.val % 2 then
              (star (exciteSign b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ)) *
                exciteSign b₂ wq₂ wp₂').re *
                ((coefficientUnit / (15360 ^ 2 : ℝ)) *
                  ∑ r : Fin 9, ∑ c : Fin 14,
                    ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                      (modeMatrix r c p₁ q₁ *
                        modeMatrix r c ⟨wp₂'.val / 2, by omega⟩ ⟨wq₂.val / 2, by omega⟩))
            else 0
          else 0 := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun q₁ _ ↦ ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun p₁ _ ↦ ?_
      trans ∑ wq₂ : Fin (2 * 58), ∑ wp₂' : Fin (2 * 58),
        if wq₂.val % 2 = wp₂'.val % 2 then
          if ((b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
              (b₂ wq₂ && !b₂ wp₂') &&
              decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
                excite b₂ wq₂ wp₂')) then
            (star (exciteSign b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ)) *
              exciteSign b₂ wq₂ wp₂').re *
              ((coefficientUnit / (15360 ^ 2 : ℝ)) *
                ∑ r : Fin 9, ∑ c : Fin 14,
                  ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                    (modeMatrix r c p₁ q₁ *
                      modeMatrix r c ⟨wp₂'.val / 2, by omega⟩ ⟨wq₂.val / 2, by omega⟩))
          else 0
        else 0
      · rw [← sum_spinOrbital_pair]
        refine Finset.sum_congr rfl fun τ _ ↦ Finset.sum_congr rfl fun q₂ _ ↦
          Finset.sum_congr rfl fun p₂ _ ↦ ?_
        simp [hdiv p₂ τ, hdiv q₂ τ]
      · refine Finset.sum_congr rfl fun wq₂ _ ↦ Finset.sum_congr rfl fun wp₂' _ ↦ ?_
        by_cases hm2 : wq₂.val % 2 = wp₂'.val % 2 <;> simp [hm2, hmod_eq q₁ p₁ σ]
    simp_rw [hstep1]
    have hstep2 := sum_spinOrbital_pair (N := 58) (fun wq₁ wp₁' ↦
      ∑ wq₂ : Fin (2 * 58), ∑ wp₂' : Fin (2 * 58),
        if ((b₁ wq₁ && !b₁ wp₁') && (b₂ wq₂ && !b₂ wp₂') &&
            decide (excite b₁ wq₁ wp₁' = excite b₂ wq₂ wp₂')) then
          offDiagQuadReal b₁ b₂ wq₁ wp₁' wq₂ wp₂'
        else 0)
    trans ∑ σ : Fin 2, ∑ q₁ : Fin 58, ∑ p₁ : Fin 58,
      ∑ wq₂ : Fin (2 * 58), ∑ wp₂' : Fin (2 * 58),
        if ((b₁ (spinOrbital 58 q₁ σ) && !b₁ (spinOrbital 58 p₁ σ)) &&
            (b₂ wq₂ && !b₂ wp₂') &&
            decide (excite b₁ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) =
              excite b₂ wq₂ wp₂')) then
          offDiagQuadReal b₁ b₂ (spinOrbital 58 q₁ σ) (spinOrbital 58 p₁ σ) wq₂ wp₂'
        else 0
    · refine Finset.sum_congr rfl fun σ _ ↦ Finset.sum_congr rfl fun q₁ _ ↦
        Finset.sum_congr rfl fun p₁ _ ↦ Finset.sum_congr rfl fun wq₂ _ ↦
          Finset.sum_congr rfl fun wp₂' _ ↦ ?_
      unfold offDiagQuadReal
      simp [hdiv p₁ σ, hdiv q₁ σ]
    · rw [hstep2]
      refine Finset.sum_congr rfl fun wq₁ _ ↦ Finset.sum_congr rfl fun wp₁' _ ↦ ?_
      by_cases hm : wq₁.val % 2 = wp₁'.val % 2
      · simp [hm]
      · simp only [hm, ↓reduceIte]
        symm
        refine Finset.sum_eq_zero fun wq₂ _ ↦ Finset.sum_eq_zero fun wp₂' _ ↦ ?_
        unfold offDiagQuadReal
        simp [hm]
  rw [hswap]
  -- Collapse the 4-fold Fin 116 sum using excite_eq_excite_iff_four_quads.
  have hiff (wq₁ wp₁' wq₂ wp₂' : Fin (2 * 58)) :
      (if ((b₁ wq₁ && !b₁ wp₁') && (b₂ wq₂ && !b₂ wp₂') &&
          decide (excite b₁ wq₁ wp₁' = excite b₂ wq₂ wp₂')) then
        offDiagQuadReal b₁ b₂ wq₁ wp₁' wq₂ wp₂'
      else 0) =
      (if wq₁ = wp₁ ∧ wp₂' = wp₂ ∧ wp₁' = wh₁ ∧ wq₂ = wh₂ then
        offDiagQuadReal b₁ b₂ wp₁ wh₁ wh₂ wp₂ else 0) +
      (if wq₁ = wp₁ ∧ wp₂' = wp₂ ∧ wp₁' = wh₂ ∧ wq₂ = wh₁ then
        offDiagQuadReal b₁ b₂ wp₁ wh₂ wh₁ wp₂ else 0) +
      (if wq₁ = wp₂ ∧ wp₂' = wp₁ ∧ wp₁' = wh₁ ∧ wq₂ = wh₂ then
        offDiagQuadReal b₁ b₂ wp₂ wh₁ wh₂ wp₁ else 0) +
      (if wq₁ = wp₂ ∧ wp₂' = wp₁ ∧ wp₁' = wh₂ ∧ wq₂ = wh₁ then
        offDiagQuadReal b₁ b₂ wp₂ wh₂ wh₁ wp₁ else 0) := by
    have h4 := excite_eq_excite_iff_four_quads (wq₁ := wq₁) (wp_1 := wp₁')
      (wq₂ := wq₂) (wp_2 := wp₂') hwp_ne hwh_ne hwp1 hwp2 hwh1 hwh2 hagree
    by_cases hc : ((b₁ wq₁ && !b₁ wp₁') && (b₂ wq₂ && !b₂ wp₂') &&
        decide (excite b₁ wq₁ wp₁' = excite b₂ wq₂ wp₂')) = true
    · rw [ite_eq_left hc]
      obtain ⟨(⟨rfl, rfl⟩ | ⟨rfl, rfl⟩), (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)⟩ := h4.mp hc
      · simp [hwp_ne, hwh_ne]
      · simp [hwp_ne, hwh_ne.symm]
      · simp [hwp_ne.symm, hwh_ne]
      · simp [hwp_ne.symm, hwh_ne.symm]
    · rw [ite_eq_right hc]
      have hnot := mt h4.mpr hc
      by_cases e1 : wq₁ = wp₁ ∧ wp₂' = wp₂ ∧ wp₁' = wh₁ ∧ wq₂ = wh₂
      · exfalso; exact hnot ⟨Or.inl ⟨e1.1, e1.2.1⟩, Or.inl ⟨e1.2.2.1, e1.2.2.2⟩⟩
      · by_cases e2 : wq₁ = wp₁ ∧ wp₂' = wp₂ ∧ wp₁' = wh₂ ∧ wq₂ = wh₁
        · exfalso; exact hnot ⟨Or.inl ⟨e2.1, e2.2.1⟩, Or.inr ⟨e2.2.2.1, e2.2.2.2⟩⟩
        · by_cases e3 : wq₁ = wp₂ ∧ wp₂' = wp₁ ∧ wp₁' = wh₁ ∧ wq₂ = wh₂
          · exfalso; exact hnot ⟨Or.inr ⟨e3.1, e3.2.1⟩, Or.inl ⟨e3.2.2.1, e3.2.2.2⟩⟩
          · by_cases e4 : wq₁ = wp₂ ∧ wp₂' = wp₁ ∧ wp₁' = wh₂ ∧ wq₂ = wh₁
            · exfalso; exact hnot ⟨Or.inr ⟨e4.1, e4.2.1⟩, Or.inr ⟨e4.2.2.1, e4.2.2.2⟩⟩
            · simp [e1, e2, e3, e4]
  simp_rw [hiff, Finset.sum_add_distrib]
  have hsingle (a b c d : Fin (2 * 58)) (val : ℝ) :
      (∑ wq₁ : Fin (2 * 58), ∑ wp₁' : Fin (2 * 58), ∑ wq₂ : Fin (2 * 58), ∑ wp₂' : Fin (2 * 58),
        if wq₁ = a ∧ wp₂' = d ∧ wp₁' = b ∧ wq₂ = c then val else 0) = val := by
    have h4' (wq₁ wp₁' wq₂ : Fin (2 * 58)) :
        (∑ wp₂' : Fin (2 * 58), if wq₁ = a ∧ wp₂' = d ∧ wp₁' = b ∧ wq₂ = c then val else 0) =
          if wq₁ = a ∧ wp₁' = b ∧ wq₂ = c then val else 0 := by
      by_cases h : wq₁ = a ∧ wp₁' = b ∧ wq₂ = c
      · rcases h with ⟨rfl, rfl, rfl⟩; simp
      · simp only [h, ↓reduceIte]
        refine Finset.sum_eq_zero fun wp₂' _ ↦ ?_
        split_ifs with h2
        · exfalso; exact h ⟨h2.1, h2.2.2.1, h2.2.2.2⟩
        · rfl
    simp_rw [h4']
    have h3' (wq₁ wp₁' : Fin (2 * 58)) :
        (∑ wq₂ : Fin (2 * 58), if wq₁ = a ∧ wp₁' = b ∧ wq₂ = c then val else 0) =
          if wq₁ = a ∧ wp₁' = b then val else 0 := by
      by_cases h : wq₁ = a ∧ wp₁' = b
      · rcases h with ⟨rfl, rfl⟩; simp
      · simp only [h, ↓reduceIte]
        refine Finset.sum_eq_zero fun wq₂ _ ↦ ?_
        split_ifs with h2
        · exact absurd ⟨h2.1, h2.2.1⟩ h
        · rfl
    simp_rw [h3']
    have h2' (wq₁ : Fin (2 * 58)) :
        (∑ wp₁' : Fin (2 * 58), if wq₁ = a ∧ wp₁' = b then val else 0) =
          if wq₁ = a then val else 0 := by
      by_cases h : wq₁ = a
      · subst h; simp
      · simp [h]
    simp_rw [h2', Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  rw [hsingle, hsingle, hsingle, hsingle]

/-! ### Part 3: Flip-List Determinants, Weight Preservation, and `O(|f|)` JW Parity -/

lemma nat_div_def (a b : ℕ) : Nat.div a b = a / b := rfl

lemma nat_mod_def (a b : ℕ) : Nat.mod a b = a % b := rfl

private lemma nat_beq_eq_false_of_ne {a b : ℕ} (h : a ≠ b) : Nat.beq a b = false :=
  Bool.eq_false_iff.mpr fun heq ↦ h (Nat.beq_eq.mp heq)

private lemma nat_blt_eq_decide (a b : ℕ) : Nat.blt a b = decide (a < b) :=
  Bool.eq_iff_iff.mpr (by simp [Nat.blt_eq])

private lemma sextetBitNat_eq_qOcc (w : Fin (2 * 58)) :
    sextetBitNat w.val = qOcc w := by
  unfold sextetBitNat qOcc
  simp only [nat_mod_def, nat_div_def, nat_blt_eq_decide]
  by_cases hm : w.val % 2 = 0
  · simp [hm]
  · simp [hm, nat_beq_eq_false_of_ne hm]
private lemma memNat_eq_true_iff (w : ℕ) : ∀ xs : List ℕ, memNat w xs = true ↔ w ∈ xs
  | [] => by simp [memNat]
  | x :: xs => by
    unfold memNat
    by_cases h : w = x
    · subst h; simp
    · simp [h, nat_beq_eq_false_of_ne h, memNat_eq_true_iff w xs]

private lemma memNat_eq_false_iff (w : ℕ) (xs : List ℕ) : memNat w xs = false ↔ w ∉ xs := by
  rw [← Bool.not_eq_true, memNat_eq_true_iff]

private def detOfFlips (flips : List ℕ) (w : Fin (2 * 58)) : Bool :=
  detBitFlips flips w.val

private lemma detOfFlips_nil : detOfFlips [] = qOcc := by
  ext w; simp [detOfFlips, detBitFlips, memNat, sextetBitNat_eq_qOcc]

private lemma detOfFlips_cons_of_not_mem {x : ℕ} {xs : List ℕ} (hx : x < 2 * 58)
    (_hnot : x ∉ xs) :
    detOfFlips (x :: xs) =
      Function.update (detOfFlips xs) ⟨x, hx⟩ (!qOcc ⟨x, hx⟩) := by
  ext w
  unfold detOfFlips detBitFlips
  by_cases hw : w = ⟨x, hx⟩
  · subst hw
    simp [memNat, sextetBitNat_eq_qOcc ⟨x, hx⟩]
  · have hv : w.val ≠ x := fun e ↦ hw (Fin.ext e)
    rw [Function.update_of_ne hw]
    simp [memNat, nat_beq_eq_false_of_ne hv]

private def jwSignInt {k : ℕ} (b : Fin k → Bool) (j : Fin k) : ℤ :=
  (-1 : ℤ) ^ ∑ q ∈ Finset.univ.filter (· < j), (if b q then 1 else 0)

private lemma jwSign_eq_int {k : ℕ} (b : Fin k → Bool) (j : Fin k) :
    jwSign b j = ((jwSignInt b j : ℤ) : ℂ) := by
  unfold jwSign jwSignInt; push_cast; rfl

private lemma neg_one_pow_update_bool {k : ℕ} (b : Fin k → Bool) (w₀ j : Fin k) (v : Bool) :
    jwSignInt (Function.update b w₀ v) j =
      (if w₀ < j ∧ b w₀ ≠ v then -1 else 1) * jwSignInt b j := by
  unfold jwSignInt
  by_cases hwj : w₀ < j
  · have hmem : w₀ ∈ Finset.univ.filter (· < j) := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hwj⟩
    have hrest :
        (∑ q ∈ (Finset.univ.filter (· < j)).erase w₀,
          if Function.update b w₀ v q then 1 else 0) =
        ∑ q ∈ (Finset.univ.filter (· < j)).erase w₀, (if b q then 1 else 0) := by
      refine Finset.sum_congr rfl fun q hq ↦ ?_
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hq)]
    rw [← Finset.add_sum_erase _ _ hmem,
      ← Finset.add_sum_erase _ (fun q ↦ if b q then 1 else 0) hmem,
      Function.update_self, hrest]
    set S := ∑ q ∈ (Finset.univ.filter (· < j)).erase w₀, (if b q then 1 else 0)
    cases hbw : b w₀ <;> cases hv : v <;> simp [hwj, pow_add]
  · have hsame :
        (∑ q ∈ Finset.univ.filter (· < j), if Function.update b w₀ v q then 1 else 0) =
        ∑ q ∈ Finset.univ.filter (· < j), (if b q then 1 else 0) := by
      refine Finset.sum_congr rfl fun q hq ↦ ?_
      have hne : q ≠ w₀ := fun e ↦ hwj (e ▸ (Finset.mem_filter.mp hq).2)
      rw [Function.update_of_ne hne]
    simp [hwj, hsame]

private lemma strictBool_eq {α : Type} (b : Bool) (k : Bool → α) : strictBool b k = k b := by
  cases b <;> rfl

private def sextetBasePar (j : ℕ) : Bool :=
  let na := minNat (Nat.div (Nat.add j 1) 2) 33
  let nb := minNat (Nat.div j 2) 30
  Nat.beq (Nat.mod (Nat.add na nb) 2) 1

private lemma sum_range_sextetBitNat : ∀ k : ℕ,
    (∑ x ∈ Finset.range k, if sextetBitNat x then 1 else 0) =
      min ((k + 1) / 2) 33 + min (k / 2) 30
  | 0 => rfl
  | k + 1 => by
    rw [Finset.sum_range_succ, sum_range_sextetBitNat k]
    unfold sextetBitNat
    simp only [nat_mod_def, nat_div_def]
    by_cases hm : k % 2 = 0
    · rw [Nat.beq_eq.mpr hm]
      by_cases h34 : k / 2 < 33
      · simp only [↓reduceIte, Nat.blt_eq.mpr h34]; omega
      · have hbf : Nat.blt (k / 2) 33 = false := Bool.eq_false_iff.mpr (mt Nat.blt_eq.mp h34)
        simp only [↓reduceIte, hbf, Bool.false_eq_true]; omega
    · rw [nat_beq_eq_false_of_ne hm]
      by_cases h29 : k / 2 < 30
      · simp only [Bool.false_eq_true, ↓reduceIte, Nat.blt_eq.mpr h29]; omega
      · have hbf : Nat.blt (k / 2) 30 = false := Bool.eq_false_iff.mpr (mt Nat.blt_eq.mp h29)
        simp only [Bool.false_eq_true, ↓reduceIte, hbf]; omega

private lemma neg_one_pow_nat_mod2 : ∀ n : ℕ, (-1 : ℤ) ^ n = if n % 2 = 1 then -1 else 1
  | 0 => rfl
  | n + 1 => by
    rw [pow_succ, neg_one_pow_nat_mod2 n]
    have hm : n % 2 = 0 ∨ n % 2 = 1 := by omega
    rcases hm with h0 | h1
    · have h1' : (n + 1) % 2 = 1 := by omega
      simp [h0, h1']
    · have h0' : (n + 1) % 2 = 0 := by omega
      simp [h1, h0']

private lemma sum_range_lt_eq_range (f : ℕ → ℕ) :
    ∀ (m k : ℕ), k ≤ m →
      (∑ x ∈ Finset.range m, if x < k then f x else 0) = ∑ x ∈ Finset.range k, f x
  | 0, k, hk => by
    have hk0 : k = 0 := by omega
    subst hk0; rfl
  | m + 1, k, hk => by
    by_cases hkm : k = m + 1
    · subst hkm
      refine Finset.sum_congr rfl fun x hx ↦ ?_
      simp [Finset.mem_range.mp hx]
    · have hle : k ≤ m := by omega
      have hnot : ¬(m < k) := by omega
      rw [Finset.sum_range_succ, sum_range_lt_eq_range f m k hle]
      simp [hnot]

private lemma minNat_eq_min (a b : ℕ) : minNat a b = min a b := by
  unfold minNat
  by_cases h : a ≤ b
  · simp [Nat.ble_eq.mpr h, h]
  · have hbf : Nat.ble a b = false := Bool.eq_false_iff.mpr (mt Nat.ble_eq.mp h)
    have hba : b ≤ a := by omega
    simp [hbf, hba]

private lemma jwSignInt_qOcc (j : Fin (2 * 58)) :
    jwSignInt qOcc j = if sextetBasePar j.val then -1 else 1 := by
  unfold jwSignInt sextetBasePar
  simp only [minNat_eq_min, nat_div_def, Nat.add_eq, nat_mod_def]
  rw [Finset.sum_filter]
  have hrew : (∑ a : Fin (2 * 58), if a < j then (if qOcc a then 1 else 0) else 0) =
      ∑ x ∈ Finset.range j.val, if sextetBitNat x then 1 else 0 := by
    have h1 : (∑ a : Fin (2 * 58), if a < j then (if qOcc a then 1 else 0) else 0) =
        ∑ a : Fin (2 * 58), if a.val < j.val then (if sextetBitNat a.val then 1 else 0) else 0 := by
      refine Finset.sum_congr rfl fun a _ ↦ ?_
      rw [← sextetBitNat_eq_qOcc a]
      exact if_congr Fin.lt_def rfl rfl
    rw [h1, Fin.sum_univ_eq_sum_range
      (fun x ↦ if x < j.val then (if sextetBitNat x then 1 else 0) else 0) (2 * 58),
      sum_range_lt_eq_range _ (2 * 58) j.val j.isLt.le]
  rw [hrew, sum_range_sextetBitNat, neg_one_pow_nat_mod2]
  set s := min ((j.val + 1) / 2) 33 + min (j.val / 2) 30
  by_cases hs : s % 2 = 1
  · simp [hs]
  · simp [hs, nat_beq_eq_false_of_ne hs]

private lemma oddLtAll_sign : ∀ (xs : List ℕ) (j : ℕ) (par : Bool),
    (if oddLtAll xs j par then (-1 : ℤ) else 1) =
      (if par then (-1 : ℤ) else 1) * (xs.map fun w ↦ if w < j then (-1 : ℤ) else 1).prod
  | [], _, par => by cases par <;> rfl
  | w :: ws, j, par => by
    simp only [oddLtAll, List.map_cons, List.prod_cons, Nat.blt_eq]
    rw [oddLtAll_sign ws j]
    by_cases hw : w < j <;> cases par <;> simp [hw]

private lemma jwSignInt_detOfFlips {flips : List ℕ} (hnodup : flips.Nodup)
    (hlt : ∀ w ∈ flips, w < 2 * 58) (j : Fin (2 * 58)) :
    jwSignInt (detOfFlips flips) j =
      if prefixParityFlips flips j.val then -1 else 1 := by
  unfold prefixParityFlips
  simp only [strictNat_eq, strictBool_eq]
  change jwSignInt (detOfFlips flips) j =
    if oddLtAll flips j.val (sextetBasePar j.val) then -1 else 1
  rw [oddLtAll_sign, ← jwSignInt_qOcc j]
  induction flips with
  | nil => simp [detOfFlips_nil]
  | cons x xs ih =>
    obtain ⟨hnot, hnd⟩ := List.nodup_cons.mp hnodup
    have hx : x < 2 * 58 := hlt x List.mem_cons_self
    have hxs : ∀ w ∈ xs, w < 2 * 58 := fun w hw ↦ hlt w (List.mem_cons_of_mem x hw)
    rw [detOfFlips_cons_of_not_mem hx hnot, neg_one_pow_update_bool, ih hnd hxs]
    have hprev : detOfFlips xs ⟨x, hx⟩ = qOcc ⟨x, hx⟩ := by
      unfold detOfFlips detBitFlips
      rw [(memNat_eq_false_iff x xs).mpr hnot]
      simp [sextetBitNat_eq_qOcc ⟨x, hx⟩]
    have hneq : detOfFlips xs ⟨x, hx⟩ ≠ !qOcc ⟨x, hx⟩ := by
      rw [hprev]; cases qOcc ⟨x, hx⟩ <;> decide
    by_cases hxj : x < j.val
    · have hfin : (⟨x, hx⟩ : Fin (2 * 58)) < j := hxj
      simp only [List.map_cons, List.prod_cons, hxj, hfin, hneq, ne_eq, not_false_eq_true,
        and_self, ↓reduceIte]
      ring
    · have hfin : ¬((⟨x, hx⟩ : Fin (2 * 58)) < j) := hxj
      simp only [List.map_cons, List.prod_cons, hxj, hfin, false_and, ↓reduceIte, one_mul]

private lemma xor_sign_int (a b : Bool) :
    (if xor a b then (-1 : ℤ) else 1) =
      (if a then (-1 : ℤ) else 1) * (if b then (-1 : ℤ) else 1) := by
  cases a <;> cases b <;> decide

private lemma exciteSign_detOfFlips {flips : List ℕ} (hnodup : flips.Nodup)
    (hlt : ∀ w ∈ flips, w < 2 * 58) {wh wp : Fin (2 * 58)}
    (hocc : detOfFlips flips wh = true) :
    exciteSign (detOfFlips flips) wh wp =
      ((if exciteNegFlips flips wh.val wp.val then (-1 : ℤ) else 1 : ℤ) : ℂ) := by
  unfold exciteSign exciteNegFlips
  rw [jwSign_eq_int, jwSign_eq_int, neg_one_pow_update_bool, jwSignInt_detOfFlips hnodup hlt wh,
    jwSignInt_detOfFlips hnodup hlt wp, hocc]
  have hlt_iff : Nat.blt wh.val wp.val = decide (wh < wp) := by
    rw [nat_blt_eq_decide]; rfl
  rw [hlt_iff, xor_sign_int, xor_sign_int]
  cases prefixParityFlips flips wh.val <;> cases prefixParityFlips flips wp.val <;>
    by_cases hlt_w : wh < wp <;> simp [hlt_w]

private lemma sum_detOfFlips_weight : ∀ {flips : List ℕ}, flips.Nodup →
    (∀ w ∈ flips, w < 2 * 58) →
    (∑ q : Fin (2 * 58), if detOfFlips flips q then 1 else 0) +
      (flips.filter sextetBitNat).length =
    63 + (flips.filter (fun w ↦ !sextetBitNat w)).length
  | [], _, _ => by
    have h63 : (∑ q : Fin (2 * 58), if qOcc q then 1 else 0) = 63 := by
      simp_rw [← sextetBitNat_eq_qOcc]
      rw [Fin.sum_univ_eq_sum_range (fun x ↦ if sextetBitNat x then 1 else 0) (2 * 58),
        sum_range_sextetBitNat]
      omega
    simp [detOfFlips_nil, h63]
  | x :: xs, hnodup, hlt => by
    obtain ⟨hnot, hnd⟩ := List.nodup_cons.mp hnodup
    have hx : x < 2 * 58 := hlt x List.mem_cons_self
    have hxs : ∀ w ∈ xs, w < 2 * 58 := fun w hw ↦ hlt w (List.mem_cons_of_mem x hw)
    have ih := sum_detOfFlips_weight hnd hxs
    rw [detOfFlips_cons_of_not_mem hx hnot]
    let xFin : Fin (2 * 58) := ⟨x, hx⟩
    have hprev : detOfFlips xs xFin = qOcc xFin := by
      unfold detOfFlips detBitFlips
      rw [(memNat_eq_false_iff x xs).mpr hnot]
      simp [sextetBitNat_eq_qOcc xFin]
    have hrest :
        (∑ q ∈ Finset.univ.erase xFin,
          if Function.update (detOfFlips xs) xFin (!qOcc xFin) q then 1 else 0) =
        ∑ q ∈ Finset.univ.erase xFin, if detOfFlips xs q then 1 else 0 := by
      refine Finset.sum_congr rfl fun q hq ↦ ?_
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hq)]
    have h1 := (Finset.add_sum_erase Finset.univ
      (fun q ↦ if Function.update (detOfFlips xs) xFin (!qOcc xFin) q then 1 else 0)
      (Finset.mem_univ xFin)).symm
    have h2 := (Finset.add_sum_erase Finset.univ
      (fun q ↦ if detOfFlips xs q then 1 else 0) (Finset.mem_univ xFin)).symm
    rw [h1, Function.update_self, hrest]
    rw [h2, hprev] at ih
    have hsb : sextetBitNat x = qOcc xFin := sextetBitNat_eq_qOcc xFin
    set remSum := ∑ q ∈ Finset.univ.erase xFin, if detOfFlips xs q then 1 else 0
    cases hocc : qOcc xFin <;>
      simp only [List.filter_cons, hsb, hocc, Bool.not_true, Bool.not_false, Bool.false_eq_true,
        ↓reduceIte, List.length_cons] at ih ⊢ <;>
      omega

private lemma checkFlipsGo_sound :
    ∀ (ws : List ℕ) (minW len nHole nPart : ℕ),
      checkFlipsGo ws minW len nHole nPart = true →
      (∀ w ∈ ws, minW ≤ w ∧ w < 116) ∧
      List.Pairwise (· < ·) ws ∧
      nHole + (ws.filter sextetBitNat).length =
        nPart + (ws.filter (fun w ↦ !sextetBitNat w)).length
  | [], _, _, nHole, nPart, h => by
    simp only [checkFlipsGo, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq] at h
    exact ⟨(fun _ hm ↦ by cases hm), List.Pairwise.nil, by simp [h.2]⟩
  | w :: ws, minW, len, nHole, nPart, h => by
    unfold checkFlipsGo at h
    by_cases hc : (Nat.ble minW w && Nat.blt w 116) = true
    · rw [ite_eq_left hc] at h
      obtain ⟨hmin, hlt⟩ := Bool.and_eq_true_iff.mp hc
      rw [Nat.ble_eq] at hmin; rw [Nat.blt_eq] at hlt
      obtain ⟨hmem, hpw, hbal⟩ := checkFlipsGo_sound ws (Nat.add w 1) (Nat.add len 1)
        (if sextetBitNat w then Nat.add nHole 1 else nHole)
        (if sextetBitNat w then nPart else Nat.add nPart 1) h
      simp only [Nat.add_eq] at hmem
      refine ⟨?_, ?_, ?_⟩
      · intro x hx
        rcases List.mem_cons.mp hx with rfl | hxs
        · exact ⟨hmin, hlt⟩
        · obtain ⟨h1, h2⟩ := hmem x hxs
          exact ⟨by omega, h2⟩
      · refine List.Pairwise.cons (fun x hx ↦ ?_) hpw
        have h1 := (hmem x hx).1
        omega
      · cases hsb : sextetBitNat w <;>
          simp only [List.filter_cons, hsb, Nat.add_eq, Bool.not_true, Bool.not_false,
            Bool.false_eq_true, ↓reduceIte, List.length_cons] at hbal ⊢ <;>
          omega
    · rw [ite_eq_right hc] at h
      exact absurd h Bool.false_ne_true

private lemma checkFlipsGo_det_valid {fa : List ℕ} (h : checkFlipsGo fa 0 0 0 0 = true) :
    fa.Nodup ∧ (∀ w ∈ fa, w < 2 * 58) ∧ List.Pairwise (· < ·) fa ∧
      (∑ q : Fin (2 * 58), if detOfFlips fa q then 1 else 0) = 63 := by
  obtain ⟨hmem, hpw, hbal⟩ := checkFlipsGo_sound fa 0 0 0 0 h
  have hlt : ∀ w ∈ fa, w < 2 * 58 := fun w hw ↦ (hmem w hw).2
  have hnd : fa.Nodup := hpw.imp ne_of_lt
  have hw := sum_detOfFlips_weight hnd hlt
  simp only [zero_add] at hbal
  refine ⟨hnd, hlt, hpw, by omega⟩

private def detListToList : DetList → List (Bool × ℕ × List ℕ)
  | .nil => []
  | .cons neg w fl rest => (neg, w, fl) :: detListToList rest

private lemma strictDetList_eq {α : Type} :
    ∀ (ds : DetList) (k : DetList → α), strictDetList ds k = k ds
  | .nil, _ => rfl
  | .cons _ _ _ rest, k => by
    simp [strictDetList, strictBool_eq, strictNat_eq, strictNatList_eq, strictDetList_eq rest]

private lemma checkDetsValidGo_sound :
    ∀ (ds : DetList) (sqAcc : ℕ),
      checkDetsValidGo ds sqAcc = true →
      (∀ t ∈ detListToList ds, checkFlipsGo t.2.2 0 0 0 0 = true) ∧
      sqAcc + ((detListToList ds).map (fun t ↦ t.2.1 ^ 2)).sum = deepNormSq
  | .nil, sqAcc, h => by
    simp only [checkDetsValidGo, Nat.beq_eq] at h
    exact ⟨(fun _ hm ↦ by cases hm), by simp [detListToList, h]⟩
  | .cons neg wa fa rest, sqAcc, h => by
    unfold checkDetsValidGo at h
    by_cases hc : checkFlipsGo fa 0 0 0 0 = true
    · rw [ite_eq_left hc, strictNat_eq] at h
      obtain ⟨hall, hsum⟩ := checkDetsValidGo_sound rest (Nat.add sqAcc (Nat.mul wa wa)) h
      refine ⟨?_, ?_⟩
      · intro t ht
        rcases List.mem_cons.mp ht with rfl | hrest
        · exact hc
        · exact hall t hrest
      · simp only [detListToList, List.map_cons, List.sum_cons, Nat.add_eq, Nat.mul_eq] at hsum ⊢
        nlinarith [sq wa]
    · rw [ite_eq_right hc] at h
      exact absurd h Bool.false_ne_true

/-! ### Symmetric-Difference (`symDiff5Go`) Soundness -/

private lemma detBitFlips_ne_iff {fa fb : List ℕ} {w : ℕ} :
    detBitFlips fa w ≠ detBitFlips fb w ↔ memNat w fa ≠ memNat w fb := by
  unfold detBitFlips
  cases memNat w fa <;> cases memNat w fb <;> cases sextetBitNat w <;> decide

private def accListOfCnt (d1 d2 d3 d4 cnt : ℕ) : List ℕ :=
  if cnt = 0 then []
  else if cnt = 1 then [d1]
  else if cnt = 2 then [d1, d2]
  else if cnt = 3 then [d1, d2, d3]
  else [d1, d2, d3, d4]

private lemma symDiff5Go_sound :
    ∀ (fuel : ℕ) (xs ys : List ℕ) (fa fb : List ℕ) (d1 d2 d3 d4 cnt : ℕ),
      cnt ≤ 4 →
      List.Pairwise (· < ·) xs →
      List.Pairwise (· < ·) ys →
      (∀ w ∈ xs, w < 116) →
      (∀ w ∈ ys, w < 116) →
      List.Pairwise (· < ·) (accListOfCnt d1 d2 d3 d4 cnt) →
      (∀ a ∈ accListOfCnt d1 d2 d3 d4 cnt, a < 116 ∧ memNat a fa ≠ memNat a fb ∧
        (∀ x ∈ xs, a < x) ∧ (∀ y ∈ ys, a < y)) →
      (∀ w : ℕ, w ∉ accListOfCnt d1 d2 d3 d4 cnt →
        (memNat w fa ≠ memNat w fb ↔ memNat w xs ≠ memNat w ys)) →
      match symDiff5Go fuel xs ys d1 d2 d3 d4 cnt with
      | .lt4 => True
      | .gt4 e1 e2 e3 e4 e5 =>
        List.Pairwise (· < ·) [e1, e2, e3, e4, e5] ∧
        ∀ w ∈ [e1, e2, e3, e4, e5], w < 116 ∧ memNat w fa ≠ memNat w fb
      | .eq4 e1 e2 e3 e4 =>
        List.Pairwise (· < ·) [e1, e2, e3, e4] ∧
        (∀ w ∈ [e1, e2, e3, e4], w < 116 ∧ memNat w fa ≠ memNat w fb) ∧
        (∀ w : ℕ, memNat w fa ≠ memNat w fb ↔ w ∈ [e1, e2, e3, e4])
  | 0, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _ => trivial
  | fuel + 1, [], [], fa, fb, d1, d2, d3, d4, cnt,
      hcnt, _, _, _, _, hpwA, hmemA, hiff => by
    unfold symDiff5Go
    by_cases hc4 : Nat.beq cnt 4 = true
    · rw [ite_eq_left hc4]
      have hce : cnt = 4 := Nat.beq_eq.mp hc4
      subst hce
      simp only [accListOfCnt, ↓reduceIte, OfNat.ofNat_ne_zero] at hpwA hmemA hiff
      refine ⟨hpwA, fun w hw ↦ ⟨(hmemA w hw).1, (hmemA w hw).2.1⟩, fun w ↦ ⟨fun hne ↦ ?_,
        fun hw ↦ (hmemA w hw).2.1⟩⟩
      by_contra hnot
      exact (hiff w hnot).mp hne (by simp [memNat])
    · rw [ite_eq_right hc4]; trivial
  | fuel + 1, x :: xs, [], fa, fb, d1, d2, d3, d4, cnt,
      hcnt, hpx, hpy, hltx, hlty, hpwA, hmemA, hiff => by
    -- Helper step pushing x (where memNat x (x::xs) = true != memNat x [] = false):
    unfold symDiff5Go
    obtain ⟨hx_lt_xs, hpx'⟩ := List.pairwise_cons.mp hpx
    have hx116 : x < 116 := hltx x List.mem_cons_self
    have hltx' : ∀ w ∈ xs, w < 116 := fun w hw ↦ hltx w (List.mem_cons_of_mem x hw)
    have hx_not_acc : x ∉ accListOfCnt d1 d2 d3 d4 cnt :=
      fun hm ↦ (lt_irrefl x) ((hmemA x hm).2.2.1 x List.mem_cons_self)
    have hx_diff : memNat x fa ≠ memNat x fb := by
      refine (hiff x hx_not_acc).mpr ?_
      simp [memNat]
    by_cases hc4 : Nat.beq cnt 4 = true
    · rw [ite_eq_left hc4]
      have hce : cnt = 4 := Nat.beq_eq.mp hc4; subst hce
      simp only [accListOfCnt, ↓reduceIte, OfNat.ofNat_ne_zero] at hpwA hmemA
      have hpw5 : List.Pairwise (· < ·) [d1, d2, d3, d4, x] := by
        rw [show [d1, d2, d3, d4, x] = [d1, d2, d3, d4] ++ [x] from rfl, List.pairwise_append]
        exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
          rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.1 x List.mem_cons_self⟩
      refine ⟨hpw5, fun w hw ↦ ?_⟩
      rcases List.mem_append.mp (show w ∈ [d1, d2, d3, d4] ++ [x] from hw) with ha | hx_eq
      · exact ⟨(hmemA w ha).1, (hmemA w ha).2.1⟩
      · rw [List.mem_singleton.mp hx_eq]; exact ⟨hx116, hx_diff⟩
    · rw [ite_eq_right hc4]
      have hcnt_lt : cnt < 4 := by
        have hne : cnt ≠ 4 := fun e ↦ hc4 (Nat.beq_eq.mpr e); omega
      have hstep : ∀ d1' d2' d3' d4' : ℕ,
          accListOfCnt d1' d2' d3' d4' (cnt + 1) = accListOfCnt d1 d2 d3 d4 cnt ++ [x] →
          match symDiff5Go fuel xs [] d1' d2' d3' d4' (cnt + 1) with
          | .lt4 => True
          | .gt4 e1 e2 e3 e4 e5 =>
            List.Pairwise (· < ·) [e1, e2, e3, e4, e5] ∧
            ∀ w ∈ [e1, e2, e3, e4, e5], w < 116 ∧ memNat w fa ≠ memNat w fb
          | .eq4 e1 e2 e3 e4 =>
            List.Pairwise (· < ·) [e1, e2, e3, e4] ∧
            (∀ w ∈ [e1, e2, e3, e4], w < 116 ∧ memNat w fa ≠ memNat w fb) ∧
            (∀ w : ℕ, memNat w fa ≠ memNat w fb ↔ w ∈ [e1, e2, e3, e4]) := by
        intro d1' d2' d3' d4' hacc_eq
        refine symDiff5Go_sound fuel xs [] fa fb d1' d2' d3' d4' (cnt + 1) (by omega)
          hpx' hpy hltx' hlty ?_ ?_ ?_
        · rw [hacc_eq, List.pairwise_append]
          exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
            rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.1 x List.mem_cons_self⟩
        · intro a ha; rw [hacc_eq] at ha
          rcases List.mem_append.mp ha with ha0 | hx_eq
          · obtain ⟨h1, h2, h3, _⟩ := hmemA a ha0
            exact ⟨h1, h2, fun z hz ↦ h3 z (List.mem_cons_of_mem x hz), (fun _ hy ↦ by cases hy)⟩
          · rw [List.mem_singleton.mp hx_eq]
            exact ⟨hx116, hx_diff, hx_lt_xs, (fun _ hy ↦ by cases hy)⟩
        · intro w hw; rw [hacc_eq, List.mem_append, List.mem_singleton, not_or] at hw
          rw [hiff w hw.1]
          simp [memNat, nat_beq_eq_false_of_ne hw.2]
      rcases (show cnt = 0 ∨ cnt = 1 ∨ cnt = 2 ∨ cnt = 3 by omega) with rfl | rfl | rfl | rfl
      · exact hstep x d2 d3 d4 rfl
      · exact hstep d1 x d3 d4 rfl
      · exact hstep d1 d2 x d4 rfl
      · exact hstep d1 d2 d3 x rfl
  | fuel + 1, [], y :: ys, fa, fb, d1, d2, d3, d4, cnt,
      hcnt, hpx, hpy, hltx, hlty, hpwA, hmemA, hiff => by
    unfold symDiff5Go
    obtain ⟨hy_lt_ys, hpy'⟩ := List.pairwise_cons.mp hpy
    have hy116 : y < 116 := hlty y List.mem_cons_self
    have hlty' : ∀ w ∈ ys, w < 116 := fun w hw ↦ hlty w (List.mem_cons_of_mem y hw)
    have hy_not_acc : y ∉ accListOfCnt d1 d2 d3 d4 cnt :=
      fun hm ↦ (lt_irrefl y) ((hmemA y hm).2.2.2 y List.mem_cons_self)
    have hy_diff : memNat y fa ≠ memNat y fb := by
      refine (hiff y hy_not_acc).mpr ?_
      simp [memNat]
    by_cases hc4 : Nat.beq cnt 4 = true
    · rw [ite_eq_left hc4]
      have hce : cnt = 4 := Nat.beq_eq.mp hc4; subst hce
      simp only [accListOfCnt, ↓reduceIte, OfNat.ofNat_ne_zero] at hpwA hmemA
      have hpw5 : List.Pairwise (· < ·) [d1, d2, d3, d4, y] := by
        rw [show [d1, d2, d3, d4, y] = [d1, d2, d3, d4] ++ [y] from rfl, List.pairwise_append]
        exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
          rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.2 y List.mem_cons_self⟩
      refine ⟨hpw5, fun w hw ↦ ?_⟩
      rcases List.mem_append.mp (show w ∈ [d1, d2, d3, d4] ++ [y] from hw) with ha | hy_eq
      · exact ⟨(hmemA w ha).1, (hmemA w ha).2.1⟩
      · rw [List.mem_singleton.mp hy_eq]; exact ⟨hy116, hy_diff⟩
    · rw [ite_eq_right hc4]
      have hcnt_lt : cnt < 4 := by
        have hne : cnt ≠ 4 := fun e ↦ hc4 (Nat.beq_eq.mpr e); omega
      have hstep : ∀ d1' d2' d3' d4' : ℕ,
          accListOfCnt d1' d2' d3' d4' (cnt + 1) = accListOfCnt d1 d2 d3 d4 cnt ++ [y] →
          match symDiff5Go fuel [] ys d1' d2' d3' d4' (cnt + 1) with
          | .lt4 => True
          | .gt4 e1 e2 e3 e4 e5 =>
            List.Pairwise (· < ·) [e1, e2, e3, e4, e5] ∧
            ∀ w ∈ [e1, e2, e3, e4, e5], w < 116 ∧ memNat w fa ≠ memNat w fb
          | .eq4 e1 e2 e3 e4 =>
            List.Pairwise (· < ·) [e1, e2, e3, e4] ∧
            (∀ w ∈ [e1, e2, e3, e4], w < 116 ∧ memNat w fa ≠ memNat w fb) ∧
            (∀ w : ℕ, memNat w fa ≠ memNat w fb ↔ w ∈ [e1, e2, e3, e4]) := by
        intro d1' d2' d3' d4' hacc_eq
        refine symDiff5Go_sound fuel [] ys fa fb d1' d2' d3' d4' (cnt + 1) (by omega)
          hpx hpy' hltx hlty' ?_ ?_ ?_
        · rw [hacc_eq, List.pairwise_append]
          exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
            rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.2 y List.mem_cons_self⟩
        · intro a ha; rw [hacc_eq] at ha
          rcases List.mem_append.mp ha with ha0 | hy_eq
          · obtain ⟨h1, h2, _, h4⟩ := hmemA a ha0
            exact ⟨h1, h2, (fun _ hx ↦ by cases hx), fun z hz ↦ h4 z (List.mem_cons_of_mem y hz)⟩
          · rw [List.mem_singleton.mp hy_eq]
            exact ⟨hy116, hy_diff, (fun _ hx ↦ by cases hx), hy_lt_ys⟩
        · intro w hw; rw [hacc_eq, List.mem_append, List.mem_singleton, not_or] at hw
          rw [hiff w hw.1]
          simp [memNat, nat_beq_eq_false_of_ne hw.2]
      rcases (show cnt = 0 ∨ cnt = 1 ∨ cnt = 2 ∨ cnt = 3 by omega) with rfl | rfl | rfl | rfl
      · exact hstep y d2 d3 d4 rfl
      · exact hstep d1 y d3 d4 rfl
      · exact hstep d1 d2 y d4 rfl
      · exact hstep d1 d2 d3 y rfl
  | fuel + 1, x :: xs, y :: ys, fa, fb, d1, d2, d3, d4, cnt,
      hcnt, hpx, hpy, hltx, hlty, hpwA, hmemA, hiff => by
    unfold symDiff5Go
    obtain ⟨hx_lt_xs, hpx'⟩ := List.pairwise_cons.mp hpx
    obtain ⟨hy_lt_ys, hpy'⟩ := List.pairwise_cons.mp hpy
    have hx116 : x < 116 := hltx x List.mem_cons_self
    have hy116 : y < 116 := hlty y List.mem_cons_self
    have hltx' : ∀ w ∈ xs, w < 116 := fun w hw ↦ hltx w (List.mem_cons_of_mem x hw)
    have hlty' : ∀ w ∈ ys, w < 116 := fun w hw ↦ hlty w (List.mem_cons_of_mem y hw)
    by_cases hxy_eq : Nat.beq x y = true
    · rw [ite_eq_left hxy_eq]
      have heq : x = y := Nat.beq_eq.mp hxy_eq; subst heq
      refine symDiff5Go_sound fuel xs ys fa fb d1 d2 d3 d4 cnt hcnt hpx' hpy' hltx' hlty'
        hpwA ?_ ?_
      · intro a ha
        obtain ⟨h1, h2, h3, h4⟩ := hmemA a ha
        exact ⟨h1, h2, fun z hz ↦ h3 z (List.mem_cons_of_mem x hz),
          fun z hz ↦ h4 z (List.mem_cons_of_mem x hz)⟩
      · intro w hw
        rw [hiff w hw]
        by_cases hwx : w = x
        · subst hwx
          have hx_not_xs : w ∉ xs := fun hm ↦ (lt_irrefl w) (hx_lt_xs w hm)
          have hx_not_ys : w ∉ ys := fun hm ↦ (lt_irrefl w) (hy_lt_ys w hm)
          simp [memNat, (memNat_eq_false_iff w xs).mpr hx_not_xs,
            (memNat_eq_false_iff w ys).mpr hx_not_ys]
        · simp [memNat, nat_beq_eq_false_of_ne hwx]
    · rw [ite_eq_right hxy_eq]
      have hxy_ne : x ≠ y := fun e ↦ hxy_eq (Nat.beq_eq.mpr e)
      by_cases hxy_lt : Nat.blt x y = true
      · rw [ite_eq_left hxy_lt]
        have hlt_xy : x < y := Nat.blt_eq.mp hxy_lt
        have hx_not_yys : x ∉ y :: ys := by
          intro hm
          rcases List.mem_cons.mp hm with rfl | hms
          · exact lt_irrefl x hlt_xy
          · exact lt_irrefl x (hlt_xy.trans (hy_lt_ys x hms))
        have hx_not_acc : x ∉ accListOfCnt d1 d2 d3 d4 cnt :=
          fun hm ↦ (lt_irrefl x) ((hmemA x hm).2.2.1 x List.mem_cons_self)
        have hx_diff : memNat x fa ≠ memNat x fb := by
          refine (hiff x hx_not_acc).mpr ?_
          rw [(memNat_eq_false_iff x (y :: ys)).mpr hx_not_yys]
          simp [memNat]
        by_cases hc4 : Nat.beq cnt 4 = true
        · rw [ite_eq_left hc4]
          have hce : cnt = 4 := Nat.beq_eq.mp hc4; subst hce
          simp only [accListOfCnt, ↓reduceIte, OfNat.ofNat_ne_zero] at hpwA hmemA
          have hpw5 : List.Pairwise (· < ·) [d1, d2, d3, d4, x] := by
            rw [show [d1, d2, d3, d4, x] = [d1, d2, d3, d4] ++ [x] from rfl, List.pairwise_append]
            exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
              rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.1 x List.mem_cons_self⟩
          refine ⟨hpw5, fun w hw ↦ ?_⟩
          rcases List.mem_append.mp (show w ∈ [d1, d2, d3, d4] ++ [x] from hw) with ha | hx_eq
          · exact ⟨(hmemA w ha).1, (hmemA w ha).2.1⟩
          · rw [List.mem_singleton.mp hx_eq]; exact ⟨hx116, hx_diff⟩
        · rw [ite_eq_right hc4]
          have hcnt_lt : cnt < 4 := by
            have hne : cnt ≠ 4 := fun e ↦ hc4 (Nat.beq_eq.mpr e); omega
          have hstep : ∀ d1' d2' d3' d4' : ℕ,
              accListOfCnt d1' d2' d3' d4' (cnt + 1) = accListOfCnt d1 d2 d3 d4 cnt ++ [x] →
              match symDiff5Go fuel xs (y :: ys) d1' d2' d3' d4' (cnt + 1) with
              | .lt4 => True
              | .gt4 e1 e2 e3 e4 e5 =>
                List.Pairwise (· < ·) [e1, e2, e3, e4, e5] ∧
                ∀ w ∈ [e1, e2, e3, e4, e5], w < 116 ∧ memNat w fa ≠ memNat w fb
              | .eq4 e1 e2 e3 e4 =>
                List.Pairwise (· < ·) [e1, e2, e3, e4] ∧
                (∀ w ∈ [e1, e2, e3, e4], w < 116 ∧ memNat w fa ≠ memNat w fb) ∧
                (∀ w : ℕ, memNat w fa ≠ memNat w fb ↔ w ∈ [e1, e2, e3, e4]) := by
            intro d1' d2' d3' d4' hacc_eq
            refine symDiff5Go_sound fuel xs (y :: ys) fa fb d1' d2' d3' d4' (cnt + 1) (by omega)
              hpx' hpy hltx' hlty ?_ ?_ ?_
            · rw [hacc_eq, List.pairwise_append]
              exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
                rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.1 x List.mem_cons_self⟩
            · intro a ha; rw [hacc_eq] at ha
              rcases List.mem_append.mp ha with ha0 | hx_eq
              · obtain ⟨h1, h2, h3, h4⟩ := hmemA a ha0
                exact ⟨h1, h2, fun z hz ↦ h3 z (List.mem_cons_of_mem x hz), h4⟩
              · rw [List.mem_singleton.mp hx_eq]
                refine ⟨hx116, hx_diff, hx_lt_xs, fun z hz ↦ ?_⟩
                rcases List.mem_cons.mp hz with rfl | hzs
                · exact hlt_xy
                · exact hlt_xy.trans (hy_lt_ys z hzs)
            · intro w hw; rw [hacc_eq, List.mem_append, List.mem_singleton, not_or] at hw
              rw [hiff w hw.1]
              simp [memNat, nat_beq_eq_false_of_ne hw.2]
          rcases (show cnt = 0 ∨ cnt = 1 ∨ cnt = 2 ∨ cnt = 3 by omega) with rfl | rfl | rfl | rfl
          · exact hstep x d2 d3 d4 rfl
          · exact hstep d1 x d3 d4 rfl
          · exact hstep d1 d2 x d4 rfl
          · exact hstep d1 d2 d3 x rfl
      · rw [ite_eq_right hxy_lt]
        have hlt_yx : y < x := by
          have : ¬(x < y) := fun h ↦ hxy_lt (Nat.blt_eq.mpr h); omega
        have hy_not_xxs : y ∉ x :: xs := by
          intro hm
          rcases List.mem_cons.mp hm with rfl | hms
          · exact lt_irrefl y hlt_yx
          · exact lt_irrefl y (hlt_yx.trans (hx_lt_xs y hms))
        have hy_not_acc : y ∉ accListOfCnt d1 d2 d3 d4 cnt :=
          fun hm ↦ (lt_irrefl y) ((hmemA y hm).2.2.2 y List.mem_cons_self)
        have hy_diff : memNat y fa ≠ memNat y fb := by
          refine (hiff y hy_not_acc).mpr ?_
          rw [(memNat_eq_false_iff y (x :: xs)).mpr hy_not_xxs]
          simp [memNat]
        by_cases hc4 : Nat.beq cnt 4 = true
        · rw [ite_eq_left hc4]
          have hce : cnt = 4 := Nat.beq_eq.mp hc4; subst hce
          simp only [accListOfCnt, ↓reduceIte, OfNat.ofNat_ne_zero] at hpwA hmemA
          have hpw5 : List.Pairwise (· < ·) [d1, d2, d3, d4, y] := by
            rw [show [d1, d2, d3, d4, y] = [d1, d2, d3, d4] ++ [y] from rfl, List.pairwise_append]
            exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
              rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.2 y List.mem_cons_self⟩
          refine ⟨hpw5, fun w hw ↦ ?_⟩
          rcases List.mem_append.mp (show w ∈ [d1, d2, d3, d4] ++ [y] from hw) with ha | hy_eq
          · exact ⟨(hmemA w ha).1, (hmemA w ha).2.1⟩
          · rw [List.mem_singleton.mp hy_eq]; exact ⟨hy116, hy_diff⟩
        · rw [ite_eq_right hc4]
          have hcnt_lt : cnt < 4 := by
            have hne : cnt ≠ 4 := fun e ↦ hc4 (Nat.beq_eq.mpr e); omega
          have hstep : ∀ d1' d2' d3' d4' : ℕ,
              accListOfCnt d1' d2' d3' d4' (cnt + 1) = accListOfCnt d1 d2 d3 d4 cnt ++ [y] →
              match symDiff5Go fuel (x :: xs) ys d1' d2' d3' d4' (cnt + 1) with
              | .lt4 => True
              | .gt4 e1 e2 e3 e4 e5 =>
                List.Pairwise (· < ·) [e1, e2, e3, e4, e5] ∧
                ∀ w ∈ [e1, e2, e3, e4, e5], w < 116 ∧ memNat w fa ≠ memNat w fb
              | .eq4 e1 e2 e3 e4 =>
                List.Pairwise (· < ·) [e1, e2, e3, e4] ∧
                (∀ w ∈ [e1, e2, e3, e4], w < 116 ∧ memNat w fa ≠ memNat w fb) ∧
                (∀ w : ℕ, memNat w fa ≠ memNat w fb ↔ w ∈ [e1, e2, e3, e4]) := by
            intro d1' d2' d3' d4' hacc_eq
            refine symDiff5Go_sound fuel (x :: xs) ys fa fb d1' d2' d3' d4' (cnt + 1) (by omega)
              hpx hpy' hltx hlty' ?_ ?_ ?_
            · rw [hacc_eq, List.pairwise_append]
              exact ⟨hpwA, List.pairwise_singleton _ _, fun a ha b hb ↦ by
                rw [List.mem_singleton.mp hb]; exact (hmemA a ha).2.2.2 y List.mem_cons_self⟩
            · intro a ha; rw [hacc_eq] at ha
              rcases List.mem_append.mp ha with ha0 | hy_eq
              · obtain ⟨h1, h2, h3, h4⟩ := hmemA a ha0
                exact ⟨h1, h2, h3, fun z hz ↦ h4 z (List.mem_cons_of_mem y hz)⟩
              · rw [List.mem_singleton.mp hy_eq]
                refine ⟨hy116, hy_diff, fun z hz ↦ ?_, hy_lt_ys⟩
                rcases List.mem_cons.mp hz with rfl | hzs
                · exact hlt_yx
                · exact hlt_yx.trans (hx_lt_xs z hzs)
            · intro w hw; rw [hacc_eq, List.mem_append, List.mem_singleton, not_or] at hw
              rw [hiff w hw.1]
              simp [memNat, nat_beq_eq_false_of_ne hw.2]
          rcases (show cnt = 0 ∨ cnt = 1 ∨ cnt = 2 ∨ cnt = 3 by omega) with rfl | rfl | rfl | rfl
          · exact hstep y d2 d3 d4 rfl
          · exact hstep d1 y d3 d4 rfl
          · exact hstep d1 d2 y d4 rfl
          · exact hstep d1 d2 d3 y rfl

private lemma modeMatrix_symm (r : Fin 9) (c : Fin 14) (p q : Fin 58) :
    modeMatrix r c p q = modeMatrix r c q p := by
  unfold modeMatrix
  refine Finset.sum_congr rfl fun b _ ↦ by ring

/-- Internal Deep helper `keyModeReal`. -/
noncomputable def keyModeReal (r : Fin 9) (c : Fin 14) (k : ℕ) : ℝ :=
  if hk : k / 64 < 58 ∧ k % 64 < 58 then
    modeMatrix r c ⟨k / 64, hk.1⟩ ⟨k % 64, hk.2⟩
  else 0

private lemma pqKey_lt_4096 {p q : ℕ} (hp : p < 58) (hq : q < 58) :
    pqKey p q < 4096 := by
  unfold pqKey
  split_ifs <;> simp only [Nat.add_eq, Nat.mul_eq] <;> omega

private lemma keyModeReal_pqKey (r : Fin 9) (c : Fin 14) (p q : Fin 58) :
    keyModeReal r c (pqKey p.val q.val) = modeMatrix r c p q := by
  have hp := p.isLt
  have hq := q.isLt
  unfold pqKey keyModeReal
  by_cases hle : Nat.ble p.val q.val = true
  · rw [ite_eq_left hle]
    simp only [Nat.add_eq, Nat.mul_eq]
    have hd : (64 * p.val + q.val) / 64 = p.val := by omega
    have hm : (64 * p.val + q.val) % 64 = q.val := by omega
    simp [hd, hm, hp, hq]
  · rw [ite_eq_right hle]
    simp only [Nat.add_eq, Nat.mul_eq]
    have hd : (64 * q.val + p.val) / 64 = q.val := by omega
    have hm : (64 * q.val + p.val) % 64 = p.val := by omega
    simp only [hd, hm, hp, hq, and_self, ↓reduceDIte]
    exact modeMatrix_symm r c q p

private lemma keyModeReal_diag (r : Fin 9) (c : Fin 14) (p : Fin 58) :
    keyModeReal r c (65 * p.val) = modeMatrix r c p p := by
  have h65 : 65 * p.val = pqKey p.val p.val := by
    unfold pqKey
    simp [Nat.ble_eq_true_of_le (le_refl p.val), Nat.add_eq, Nat.mul_eq]
    omega
  rw [h65, keyModeReal_pqKey]

/-- Internal Deep helper `evalQuadList`. -/
noncomputable def evalQuadList (r : Fin 9) (c : Fin 14) : QuadList → ℝ
  | .nil => 0
  | .cons k1 k2 p m rest =>
    ((p : ℝ) - (m : ℝ)) * (keyModeReal r c k1 * keyModeReal r c k2) + evalQuadList r c rest

private noncomputable def evalQuadAccTree (r : Fin 9) (c : Fin 14) : QuadAccTree → ℝ
  | .empty => 0
  | .node l qk p m rt =>
    evalQuadAccTree r c l +
      ((p : ℝ) - (m : ℝ)) * (keyModeReal r c (qk / 4096) * keyModeReal r c (qk % 4096)) +
      evalQuadAccTree r c rt

private lemma buildZeroQuadTreeCPS_succ_succ_cons {α : Type}
    (fuel n qk : ℕ) (rest : List ℕ) (k : QuadAccTree → List ℕ → α) :
    buildZeroQuadTreeCPS (fuel + 1) (n + 1) (qk :: rest) k =
      if Nat.beq (n + 1) 1 then
        strictNat qk fun qk' ↦ k (.node .empty qk' 0 0 .empty) rest
      else
        strictNat (Nat.div (n + 1) 2) fun half ↦
        strictNat (Nat.sub (Nat.sub (n + 1) 1) half) fun rLen ↦
        buildZeroQuadTreeCPS fuel half (qk :: rest) fun lTree midAndRight ↦
        match midAndRight with
        | [] => k lTree []
        | mKey :: rightXs =>
          strictNat mKey fun qk' ↦
          buildZeroQuadTreeCPS fuel rLen rightXs fun rTree remXs ↦
            k (.node lTree qk' 0 0 rTree) remXs := rfl

private lemma buildZeroQuadTreeCPS_sound :
    ∀ (fuel n : ℕ) (xs : List ℕ) (P : QuadAccTree → List ℕ → Prop),
      (∀ t rem, (∀ r c, evalQuadAccTree r c t = 0) → P t rem) →
      buildZeroQuadTreeCPS fuel n xs P
  | 0, _, xs, _, hk => hk .empty xs fun _ _ ↦ rfl
  | _ + 1, 0, xs, _, hk => hk .empty xs fun _ _ ↦ rfl
  | _ + 1, _ + 1, [], _, hk => hk .empty [] fun _ _ ↦ rfl
  | fuel + 1, n + 1, qk :: rest, P, hk => by
    rw [buildZeroQuadTreeCPS_succ_succ_cons]
    by_cases h1 : Nat.beq (n + 1) 1 = true
    · simp only [h1, ↓reduceIte, strictNat_eq]
      exact hk _ _ fun r c ↦ by simp [evalQuadAccTree]
    · simp only [h1, Bool.false_eq_true, ↓reduceIte, strictNat_eq]
      refine buildZeroQuadTreeCPS_sound fuel (Nat.div (n + 1) 2) (qk :: rest) _
        fun lT mid hl ↦ ?_
      cases mid with
      | nil => exact hk lT [] hl
      | cons mKey rightXs =>
        refine buildZeroQuadTreeCPS_sound fuel
          (Nat.sub (Nat.sub (n + 1) 1) (Nat.div (n + 1) 2)) rightXs _ fun rT remXs hr ↦ ?_
        exact hk _ remXs fun r c ↦ by simp [evalQuadAccTree, hl r c, hr r c]

private lemma addQuadTreeCPS_sound (qk cP cN : ℕ) :
    ∀ (tree : QuadAccTree) (P : Bool → QuadAccTree → Prop),
      (∀ ok tree',
        (ok = true → ∀ r c, evalQuadAccTree r c tree' = evalQuadAccTree r c tree +
          ((cP : ℝ) - (cN : ℝ)) * (keyModeReal r c (qk / 4096) * keyModeReal r c (qk % 4096))) →
        P ok tree') →
      addQuadTreeCPS qk cP cN tree P
  | .empty, _, hk => hk false .empty fun h ↦ absurd h Bool.false_ne_true
  | .node l nk p m rt, P, hk => by
    unfold addQuadTreeCPS
    by_cases heq : Nat.beq qk nk = true
    · rw [ite_eq_left heq]
      have hqn : qk = nk := Nat.beq_eq.mp heq
      subst hqn
      simp only [strictNat_eq]
      refine hk true _ fun _ r c ↦ ?_
      simp only [evalQuadAccTree, Nat.add_eq, Nat.cast_add]
      ring
    · rw [ite_eq_right heq]
      by_cases hlt : Nat.blt qk nk = true
      · rw [ite_eq_left hlt]
        refine addQuadTreeCPS_sound qk cP cN l _ fun ok l' hl ↦ ?_
        cases ok with
        | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
        | true =>
          refine hk true _ fun _ r c ↦ ?_
          simp only [evalQuadAccTree, hl rfl r c]
          ring
      · rw [ite_eq_right hlt]
        refine addQuadTreeCPS_sound qk cP cN rt _ fun ok r' hr ↦ ?_
        cases ok with
        | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
        | true =>
          refine hk true _ fun _ r c ↦ ?_
          simp only [evalQuadAccTree, hr rfl r c]
          ring

private lemma pushQuadTreeCPS_sound {k1 k2 : ℕ} (hk1 : k1 < 4096) (hk2 : k2 < 4096)
    (cP cN : ℕ) (tree : QuadAccTree) (P : Bool → QuadAccTree → Prop)
    (hk : ∀ ok tree',
      (ok = true → ∀ r c, evalQuadAccTree r c tree' = evalQuadAccTree r c tree +
        ((cP : ℝ) - (cN : ℝ)) * (keyModeReal r c k1 * keyModeReal r c k2)) →
      P ok tree') :
    pushQuadTreeCPS k1 k2 cP cN tree P := by
  unfold pushQuadTreeCPS
  simp only [strictNat_eq]
  refine addQuadTreeCPS_sound _ cP cN tree P fun ok tree' htree ↦ hk ok tree' fun hok r c ↦ ?_
  rw [htree hok r c]
  congr 2
  by_cases hle : Nat.ble k1 k2 = true
  · rw [ite_eq_left hle]
    simp only [Nat.add_eq, Nat.mul_eq]
    have hd : (4096 * k1 + k2) / 4096 = k1 := by omega
    have hm : (4096 * k1 + k2) % 4096 = k2 := by omega
    rw [hd, hm]
  · rw [ite_eq_right hle]
    simp only [Nat.add_eq, Nat.mul_eq]
    have hd : (4096 * k2 + k1) / 4096 = k2 := by omega
    have hm : (4096 * k2 + k1) % 4096 = k1 := by omega
    rw [hd, hm, mul_comm]

private lemma emitNonzeroQuadCPS_sound (qk p m : ℕ) (acc : QuadList)
    (P : QuadList → Prop)
    (hk : ∀ res, (∀ r c, evalQuadList r c res =
      ((p : ℝ) - (m : ℝ)) * (keyModeReal r c (qk / 4096) * keyModeReal r c (qk % 4096)) +
        evalQuadList r c acc) → P res) :
    emitNonzeroQuadCPS qk p m acc P := by
  unfold emitNonzeroQuadCPS
  by_cases heq : Nat.beq p m = true
  · rw [ite_eq_left heq]
    have hpm : p = m := Nat.beq_eq.mp heq
    subst hpm
    exact hk acc fun r c ↦ by ring
  · rw [ite_eq_right heq]
    simp only [strictNat_eq, nat_div_def, nat_mod_def]
    by_cases hlt : Nat.blt m p = true
    · rw [ite_eq_left hlt]
      have hmp : m ≤ p := (Nat.blt_eq.mp hlt).le
      refine hk _ fun r c ↦ ?_
      simp only [evalQuadList, Nat.sub_eq, Nat.cast_sub hmp, Nat.cast_zero, sub_zero]
    · rw [ite_eq_right hlt]
      have hpm : p ≤ m := by
        have : ¬(m < p) := fun h ↦ hlt (Nat.blt_eq.mpr h); omega
      refine hk _ fun r c ↦ ?_
      simp only [evalQuadList, Nat.sub_eq, Nat.cast_sub hpm, Nat.cast_zero]; ring

private lemma flattenQuadTreeCPS_sound :
    ∀ (tree : QuadAccTree) (acc : QuadList) (P : QuadList → Prop),
      (∀ res, (∀ r c, evalQuadList r c res =
        evalQuadAccTree r c tree + evalQuadList r c acc) → P res) →
      flattenQuadTreeCPS tree acc P
  | .empty, acc, _, hk => hk acc fun _ _ ↦ by simp [evalQuadAccTree]
  | .node l qk p m rt, acc, P, hk => by
    unfold flattenQuadTreeCPS
    refine flattenQuadTreeCPS_sound rt acc _ fun acc1 h1 ↦ ?_
    refine emitNonzeroQuadCPS_sound qk p m acc1 _ fun acc2 h2 ↦ ?_
    refine flattenQuadTreeCPS_sound l acc2 P fun res h3 ↦ hk res fun r c ↦ ?_
    rw [h3 r c, h2 r c, h1 r c]
    simp only [evalQuadAccTree]
    ring

private lemma beqNatList_eq : ∀ {xs ys : List ℕ}, beqNatList xs ys = true → xs = ys
  | [], [], _ => rfl
  | _ :: _, [], h => absurd h Bool.false_ne_true
  | [], _ :: _, h => absurd h Bool.false_ne_true
  | x :: xs, y :: ys, h => by
    unfold beqNatList at h
    by_cases hxy : Nat.beq x y = true
    · rw [ite_eq_left hxy] at h
      rw [Nat.beq_eq.mp hxy, beqNatList_eq h]
    · rw [ite_eq_right hxy] at h
      exact absurd h Bool.false_ne_true

private lemma beqQuadList_eq : ∀ {xs ys : QuadList}, beqQuadList xs ys = true → xs = ys
  | .nil, .nil, _ => rfl
  | .cons _ _ _ _ _, .nil, h => absurd h Bool.false_ne_true
  | .nil, .cons _ _ _ _ _, h => absurd h Bool.false_ne_true
  | .cons a1 b1 p1 m1 xs, .cons a2 b2 p2 m2 ys, h => by
    unfold beqQuadList at h
    by_cases hc : (Nat.beq a1 a2 && Nat.beq b1 b2 && Nat.beq p1 p2 && Nat.beq m1 m2) = true
    · rw [ite_eq_left hc] at h
      simp only [Bool.and_eq_true, Nat.beq_eq] at hc
      rcases hc with ⟨⟨⟨rfl, rfl⟩, rfl⟩, rfl⟩
      rw [beqQuadList_eq h]
    · rw [ite_eq_right hc] at h
      exact absurd h Bool.false_ne_true

private def revQuadListPure : QuadList → QuadList → QuadList
  | .nil, acc => acc
  | .cons k1 k2 p m rest, acc => revQuadListPure rest (.cons k1 k2 p m acc)

private lemma revQuadListCPS_eq {α : Type} :
    ∀ (qs acc : QuadList) (k : QuadList → α),
      revQuadListCPS qs acc k = k (revQuadListPure qs acc)
  | .nil, acc, k => rfl
  | .cons _ _ _ _ rest, acc, k => by
    simp [revQuadListCPS, strictNat_eq, revQuadListCPS_eq rest, revQuadListPure]

private lemma evalQuadList_revQuadListPure (r : Fin 9) (c : Fin 14) :
    ∀ (qs acc : QuadList),
      evalQuadList r c (revQuadListPure qs acc) =
        evalQuadList r c qs + evalQuadList r c acc
  | .nil, acc => by simp [revQuadListPure, evalQuadList]
  | .cons k1 k2 p m rest, acc => by
    simp only [revQuadListPure, evalQuadList_revQuadListPure r c rest, evalQuadList]
    ring

lemma forceQuadListCPS_eval {α : Type} (qs : QuadList) (k : QuadList → α) :
    ∃ qs', forceQuadListCPS qs k = k qs' ∧ ∀ r c, evalQuadList r c qs' = evalQuadList r c qs := by
  refine ⟨revQuadListPure (revQuadListPure qs .nil) .nil, ?_, fun r c ↦ ?_⟩
  · unfold forceQuadListCPS
    rw [revQuadListCPS_eq, revQuadListCPS_eq]
  · rw [evalQuadList_revQuadListPure, evalQuadList_revQuadListPure]
    simp [evalQuadList]

/-! ### Wire-Weight Accumulation & Diagonal Mode Identities -/

private lemma addAtNat_length : ∀ (i v : ℕ) (xs : List ℕ), (addAtNat i v xs).length = xs.length
  | _, _, [] => by simp [addAtNat]
  | 0, _, _ :: _ => by simp [addAtNat, strictNat_eq]
  | i + 1, v, _ :: xs => by simp [addAtNat, addAtNat_length i v xs]

private lemma addAtNat_getD : ∀ (i v : ℕ) (xs : List ℕ) (j : ℕ),
    (addAtNat i v xs).getD j 0 =
      if j = i ∧ i < xs.length then xs.getD j 0 + v else xs.getD j 0
  | _, _, [], _ => by simp [addAtNat]
  | 0, v, x :: xs, 0 => by simp [addAtNat, strictNat_eq, Nat.add_eq]
  | 0, v, x :: xs, j + 1 => by simp [addAtNat, strictNat_eq]
  | i + 1, v, x :: xs, 0 => by simp [addAtNat]
  | i + 1, v, x :: xs, j + 1 => by
    simp only [addAtNat, List.getD_cons_succ, List.length_cons, addAtNat_getD i v xs j]
    by_cases hji : j = i
    · subst hji; simp
    · simp [hji]

private lemma addFlipsW_length (wa2 : ℕ) :
    ∀ (flips wireW : List ℕ), (addFlipsW wa2 flips wireW).length = wireW.length
  | [], _ => rfl
  | w :: ws, wireW => by rw [addFlipsW, addFlipsW_length wa2 ws, addAtNat_length]

private lemma addFlipsW_getD (wa2 : ℕ) :
    ∀ (flips wireW : List ℕ), flips.Nodup → (∀ w ∈ flips, w < wireW.length) →
      ∀ j : ℕ, (addFlipsW wa2 flips wireW).getD j 0 =
        wireW.getD j 0 + if j ∈ flips then wa2 else 0
  | [], wireW, _, _, j => by simp [addFlipsW]
  | w :: ws, wireW, hnd, hlt, j => by
    obtain ⟨hnot, hnd'⟩ := List.nodup_cons.mp hnd
    have hw : w < wireW.length := hlt w List.mem_cons_self
    have hws : ∀ x ∈ ws, x < (addAtNat w wa2 wireW).length := by
      rw [addAtNat_length]
      exact fun x hx ↦ hlt x (List.mem_cons_of_mem w hx)
    rw [addFlipsW, addFlipsW_getD wa2 ws _ hnd' hws j, addAtNat_getD]
    by_cases hjw : j = w
    · subst hjw
      simp [hw, hnot]
    · simp [hjw, List.mem_cons]

private lemma checkWireWLe_sound :
    ∀ {xs : List ℕ}, checkWireWLe xs = true → ∀ j : ℕ, xs.getD j 0 ≤ deepNormSq
  | [], _, _ => by simp
  | x :: xs, h, 0 => by
    unfold checkWireWLe at h
    by_cases hx : Nat.ble x deepNormSq = true
    · exact Nat.le_of_ble_eq_true hx
    · rw [ite_eq_right hx] at h; exact absurd h Bool.false_ne_true
  | x :: xs, h, j + 1 => by
    unfold checkWireWLe at h
    by_cases hx : Nat.ble x deepNormSq = true
    · rw [ite_eq_left hx] at h
      exact checkWireWLe_sound h j
    · rw [ite_eq_right hx] at h; exact absurd h Bool.false_ne_true

private def flipSignReal (w : ℕ) : ℝ :=
  if sextetBitNat w then -1 else 1

private lemma detOfFlips_ind_sub (fa : List ℕ) (w : Fin (2 * 58)) :
    (if detOfFlips fa w then (1 : ℝ) else 0) - (if qOcc w then (1 : ℝ) else 0) =
      if w.val ∈ fa then flipSignReal w.val else 0 := by
  unfold detOfFlips detBitFlips flipSignReal
  rw [← sextetBitNat_eq_qOcc w]
  by_cases hm : w.val ∈ fa
  · rw [(memNat_eq_true_iff w.val fa).mpr hm]
    cases sextetBitNat w.val <;> simp [hm]
  · rw [(memNat_eq_false_iff w.val fa).mpr hm]
    simp [hm]

private lemma sum_fin_mem_nodup {N : ℕ} (f : Fin N → ℝ) :
    ∀ (xs : List ℕ) (_ : xs.Nodup) (hlt : ∀ w ∈ xs, w < N),
      (∑ w : Fin N, if w.val ∈ xs then f w else 0) =
        (xs.attach.map fun w ↦ f ⟨w.1, hlt w.1 w.2⟩).sum
  | [], _, _ => by simp
  | x :: xs, hnd, hlt => by
    obtain ⟨hnot, hnd'⟩ := List.nodup_cons.mp hnd
    have hx : x < N := hlt x List.mem_cons_self
    have hxs : ∀ w ∈ xs, w < N := fun w hw ↦ hlt w (List.mem_cons_of_mem x hw)
    have hsplit (w : Fin N) :
        (if w.val ∈ x :: xs then f w else 0) =
          (if w = ⟨x, hx⟩ then f ⟨x, hx⟩ else 0) + (if w.val ∈ xs then f w else 0) := by
      by_cases hw : w = ⟨x, hx⟩
      · subst hw; simp [hnot]
      · have hne : w.val ≠ x := fun e ↦ hw (Fin.ext e)
        simp [hw, hne]
    simp_rw [hsplit, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    rw [sum_fin_mem_nodup f xs hnd' hxs, List.attach_cons, List.map_cons, List.sum_cons,
      List.map_map]
    rfl

private noncomputable def occDeltaSpin (fa : List ℕ) (σ : Fin 2) (u v : Fin 58 → ℝ) : ℝ :=
  occDot (detOfFlips fa) σ u v - occDot qOcc σ u v

private lemma occDeltaSpin_eq_list {fa : List ℕ} (hnd : fa.Nodup) (hlt : ∀ w ∈ fa, w < 2 * 58)
    (σ : Fin 2) (u v : Fin 58 → ℝ) :
    occDeltaSpin fa σ u v =
      (fa.attach.map fun w ↦
        if w.1 % 2 = σ.val then
          flipSignReal w.1 *
            (u ⟨w.1 / 2, by have := hlt w.1 w.2; omega⟩ *
              v ⟨w.1 / 2, by have := hlt w.1 w.2; omega⟩)
        else 0).sum := by
  unfold occDeltaSpin occDot
  rw [← Finset.sum_sub_distrib]
  have h1 : (∑ p : Fin 58, ((if detOfFlips fa (spinOrbital 58 p σ) then u p * v p else 0) -
        (if qOcc (spinOrbital 58 p σ) then u p * v p else 0))) =
      ∑ p : Fin 58, (if (spinOrbital 58 p σ).val ∈ fa then
        flipSignReal (spinOrbital 58 p σ).val * (u p * v p) else 0) := by
    refine Finset.sum_congr rfl fun p _ ↦ ?_
    have hd := detOfFlips_ind_sub fa (spinOrbital 58 p σ)
    have hmul :
        (if detOfFlips fa (spinOrbital 58 p σ) then u p * v p else 0) -
          (if qOcc (spinOrbital 58 p σ) then u p * v p else 0) =
        ((if detOfFlips fa (spinOrbital 58 p σ) then (1 : ℝ) else 0) -
          (if qOcc (spinOrbital 58 p σ) then (1 : ℝ) else 0)) * (u p * v p) := by
      cases detOfFlips fa (spinOrbital 58 p σ) <;>
        cases qOcc (spinOrbital 58 p σ) <;> simp
    rw [hmul, hd]
    split_ifs <;> ring
  rw [h1]
  rw [← sum_fin_mem_nodup (fun w : Fin (2 * 58) ↦
    if w.val % 2 = σ.val then
      flipSignReal w.val * (u ⟨w.val / 2, by omega⟩ * v ⟨w.val / 2, by omega⟩)
    else 0) fa hnd hlt]
  rw [← (wireEquiv 58).sum_comp, Fintype.sum_prod_type, Finset.sum_comm]
  have hσ : σ.val < 2 := σ.isLt
  have hmod (p : Fin 58) (τ : Fin 2) : (wireEquiv 58 (p, τ)).val % 2 = τ.val := by
    have hτ := τ.isLt; change (2 * p.val + τ.val) % 2 = τ.val; omega
  have hdiv (p : Fin 58) (τ : Fin 2) :
      (⟨(wireEquiv 58 (p, τ)).val / 2, by omega⟩ : Fin 58) = p := by
    have hτ := τ.isLt; ext; change (2 * p.val + τ.val) / 2 = p.val; omega
  have hcollapse : ∀ τ : Fin 2,
      (∑ p : Fin 58, if (wireEquiv 58 (p, τ)).val ∈ fa then
        if (wireEquiv 58 (p, τ)).val % 2 = σ.val then
          flipSignReal (wireEquiv 58 (p, τ)).val *
            (u ⟨(wireEquiv 58 (p, τ)).val / 2, by omega⟩ *
              v ⟨(wireEquiv 58 (p, τ)).val / 2, by omega⟩)
        else 0
      else 0) =
      if τ = σ then
        ∑ p : Fin 58, if (spinOrbital 58 p σ).val ∈ fa then
          flipSignReal (spinOrbital 58 p σ).val * (u p * v p)
        else 0
      else 0 := by
    intro τ
    by_cases hτσ : τ = σ
    · subst hτσ
      simp only [↓reduceIte]
      refine Finset.sum_congr rfl fun p _ ↦ ?_
      rw [hmod p τ, hdiv p τ]
      simp [wireEquiv]
    · simp only [hτσ, ↓reduceIte]
      refine Finset.sum_eq_zero fun p _ ↦ ?_
      have hne : τ.val ≠ σ.val := fun e ↦ hτσ (Fin.ext e)
      simp [hmod p τ, hne]
  simp_rw [hcollapse, Finset.sum_ite_eq', Finset.mem_univ, ite_true]

private lemma occDot_mul_virtDot_decomp (fa : List ℕ) (σ : Fin 2)
    (u v : Fin 58 → ℝ) :
    occDot (detOfFlips fa) σ u v * virtDot (detOfFlips fa) σ u v =
      occDot qOcc σ u v * virtDot qOcc σ u v +
        (virtDot qOcc σ u v - occDot qOcc σ u v) * occDeltaSpin fa σ u v -
        (occDeltaSpin fa σ u v) ^ 2 := by
  have ho : occDot (detOfFlips fa) σ u v = occDot qOcc σ u v + occDeltaSpin fa σ u v := by
    unfold occDeltaSpin; ring
  have hv : virtDot (detOfFlips fa) σ u v = virtDot qOcc σ u v - occDeltaSpin fa σ u v := by
    unfold occDeltaSpin occDot virtDot
    rw [← Finset.sum_sub_distrib]
    have hpt (p : Fin 58) :
        (if !detOfFlips fa (spinOrbital 58 p σ) then u p * v p else 0) =
          (if !qOcc (spinOrbital 58 p σ) then u p * v p else 0) -
            ((if detOfFlips fa (spinOrbital 58 p σ) then u p * v p else 0) -
              (if qOcc (spinOrbital 58 p σ) then u p * v p else 0)) := by
      cases detOfFlips fa (spinOrbital 58 p σ) <;> cases qOcc (spinOrbital 58 p σ) <;> simp
    calc
      (∑ p : Fin 58, if (!detOfFlips fa (spinOrbital 58 p σ)) = true then u p * v p else 0)
        = ∑ p : Fin 58, ((if (!qOcc (spinOrbital 58 p σ)) = true then u p * v p else 0) -
            ((if detOfFlips fa (spinOrbital 58 p σ) = true then u p * v p else 0) -
              (if qOcc (spinOrbital 58 p σ) = true then u p * v p else 0))) :=
          Finset.sum_congr rfl fun p _ ↦ hpt p
      _ = _ := Finset.sum_sub_distrib _ _
  rw [ho, hv]
  ring

private lemma list_sum_finset_comm {α β : Type*} (xs : List α) (s : Finset β) (f : α → β → ℝ) :
    (∑ b ∈ s, (xs.map fun a ↦ f a b).sum) = (xs.map fun a ↦ ∑ b ∈ s, f a b).sum := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
    simp only [List.map_cons, List.sum_cons, Finset.sum_add_distrib, ih]

private lemma list_sum_map_add {α : Type*} (g1 g2 : α → ℝ) :
    ∀ ys : List α, (ys.map fun a ↦ g1 a + g2 a).sum = (ys.map g1).sum + (ys.map g2).sum
  | [] => by simp
  | y :: ys => by simp only [List.map_cons, List.sum_cons, list_sum_map_add g1 g2 ys]; ring

private lemma list_sum_map_sub {α : Type*} (g1 g2 : α → ℝ) :
    ∀ ys : List α, (ys.map fun a ↦ g1 a - g2 a).sum = (ys.map g1).sum - (ys.map g2).sum
  | [] => by simp
  | y :: ys => by simp only [List.map_cons, List.sum_cons, list_sum_map_sub g1 g2 ys]; ring

private lemma list_sum_sq {α : Type*} (xs : List α) (f : α → ℝ) :
    (xs.map f).sum ^ 2 = (xs.map fun a ↦ (xs.map fun b ↦ f a * f b).sum).sum := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
    simp only [List.map_cons, List.sum_cons]
    have h1 : (xs.map fun b ↦ f x * f b).sum = f x * (xs.map f).sum := by
      rw [← List.sum_map_mul_left]
    have h2 : (xs.map fun a ↦ f a * f x + (xs.map fun b ↦ f a * f b).sum).sum =
        (xs.map f).sum * f x + (xs.map fun a ↦ (xs.map fun b ↦ f a * f b).sum).sum := by
      rw [list_sum_map_add, ← List.sum_map_mul_right]
    rw [h1, h2, ← ih]
    ring

private noncomputable def flipModeDelta (r : Fin 9) (c : Fin 14) (fa : List ℕ)
    (hlt : ∀ w ∈ fa, w < 2 * 58) : ℝ :=
  (fa.attach.map fun w ↦
    flipSignReal w.1 *
      modeMatrix r c ⟨w.1 / 2, by have := hlt w.1 w.2; omega⟩
        ⟨w.1 / 2, by have := hlt w.1 w.2; omega⟩).sum

private lemma detOfFlips_sub_sextet (r : Fin 9) (c : Fin 14) {fa : List ℕ}
    (hnd : fa.Nodup) (hlt : ∀ w ∈ fa, w < 2 * 58) :
    (∑ b_idx : Fin 29, (deepInnerInt r c b_idx.val : ℝ) *
      (occDot (detOfFlips fa) 0 (rLeafVec (leafEquiv (r, b_idx)))
          (rLeafVec (leafEquiv (r, b_idx))) +
        occDot (detOfFlips fa) 1 (rLeafVec (leafEquiv (r, b_idx)))
          (rLeafVec (leafEquiv (r, b_idx))))) -
    (∑ b_idx : Fin 29, (deepInnerInt r c b_idx.val : ℝ) *
      (occDot qOcc 0 (rLeafVec (leafEquiv (r, b_idx)))
          (rLeafVec (leafEquiv (r, b_idx))) +
        occDot qOcc 1 (rLeafVec (leafEquiv (r, b_idx)))
          (rLeafVec (leafEquiv (r, b_idx))))) =
    flipModeDelta r c fa hlt := by
  rw [← Finset.sum_sub_distrib]
  have hterm (b_idx : Fin 29) :
      (deepInnerInt r c b_idx.val : ℝ) *
          (occDot (detOfFlips fa) 0 (rLeafVec (leafEquiv (r, b_idx)))
              (rLeafVec (leafEquiv (r, b_idx))) +
            occDot (detOfFlips fa) 1 (rLeafVec (leafEquiv (r, b_idx)))
              (rLeafVec (leafEquiv (r, b_idx)))) -
        (deepInnerInt r c b_idx.val : ℝ) *
          (occDot qOcc 0 (rLeafVec (leafEquiv (r, b_idx)))
              (rLeafVec (leafEquiv (r, b_idx))) +
            occDot qOcc 1 (rLeafVec (leafEquiv (r, b_idx)))
              (rLeafVec (leafEquiv (r, b_idx)))) =
      (fa.attach.map fun w ↦
        (deepInnerInt r c b_idx.val : ℝ) *
          (flipSignReal w.1 *
            (rLeafVec (leafEquiv (r, b_idx)) ⟨w.1 / 2, by have := hlt w.1 w.2; omega⟩ *
              rLeafVec (leafEquiv (r, b_idx))
                ⟨w.1 / 2, by have := hlt w.1 w.2; omega⟩))).sum := by
    have hsplit :
        (deepInnerInt r c b_idx.val : ℝ) *
            (occDot (detOfFlips fa) 0 (rLeafVec (leafEquiv (r, b_idx)))
                 (rLeafVec (leafEquiv (r, b_idx))) +
              occDot (detOfFlips fa) 1 (rLeafVec (leafEquiv (r, b_idx)))
                (rLeafVec (leafEquiv (r, b_idx)))) -
          (deepInnerInt r c b_idx.val : ℝ) *
            (occDot qOcc 0 (rLeafVec (leafEquiv (r, b_idx)))
                (rLeafVec (leafEquiv (r, b_idx))) +
              occDot qOcc 1 (rLeafVec (leafEquiv (r, b_idx)))
                (rLeafVec (leafEquiv (r, b_idx)))) =
        (deepInnerInt r c b_idx.val : ℝ) *
          (occDeltaSpin fa 0 (rLeafVec (leafEquiv (r, b_idx)))
              (rLeafVec (leafEquiv (r, b_idx))) +
            occDeltaSpin fa 1 (rLeafVec (leafEquiv (r, b_idx)))
              (rLeafVec (leafEquiv (r, b_idx)))) := by
      unfold occDeltaSpin; ring
    rw [hsplit, occDeltaSpin_eq_list hnd hlt 0, occDeltaSpin_eq_list hnd hlt 1,
      show ((0 : Fin 2).val) = 0 from rfl, show ((1 : Fin 2).val) = 1 from rfl,
      ← list_sum_map_add, ← List.sum_map_mul_left]
    refine congrArg List.sum (List.map_congr_left fun w _ ↦ ?_)
    have hm : w.1 % 2 = 0 ∨ w.1 % 2 = 1 := by omega
    rcases hm with h0 | h1
    · simp [h0]
    · simp [h1]
  simp_rw [hterm]
  rw [list_sum_finset_comm]
  unfold flipModeDelta modeMatrix
  congr 1
  refine List.map_congr_left fun w _ ↦ ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun b_idx _ ↦ by ring

private noncomputable def exchFlipSqMode (r : Fin 9) (c : Fin 14) (fa : List ℕ)
    (hlt : ∀ w ∈ fa, w < 2 * 58) : ℝ :=
  (fa.attach.map fun w1 ↦
    (fa.attach.map fun w2 ↦
      if w1.1 % 2 = w2.1 % 2 then
        flipSignReal w1.1 * flipSignReal w2.1 *
          (modeMatrix r c ⟨w1.1 / 2, by have := hlt w1.1 w1.2; omega⟩
            ⟨w2.1 / 2, by have := hlt w2.1 w2.2; omega⟩) ^ 2
      else 0).sum).sum

private lemma exch_delta_sq_eq_mode (r : Fin 9) (c : Fin 14) {fa : List ℕ}
    (hnd : fa.Nodup) (hlt : ∀ w ∈ fa, w < 2 * 58) :
    (∑ b₁ : Fin 29, (deepInnerInt r c b₁.val : ℝ) *
      ∑ b₂ : Fin 29, (deepInnerInt r c b₂.val : ℝ) *
        ((occDeltaSpin fa 0 (rLeafVec (leafEquiv (r, b₁)))
            (rLeafVec (leafEquiv (r, b₂)))) ^ 2 +
          (occDeltaSpin fa 1 (rLeafVec (leafEquiv (r, b₁)))
            (rLeafVec (leafEquiv (r, b₂)))) ^ 2)) =
    exchFlipSqMode r c fa hlt := by
  have hspin (σ : Fin 2) :
      (∑ b₁ : Fin 29, (deepInnerInt r c b₁.val : ℝ) *
        ∑ b₂ : Fin 29, (deepInnerInt r c b₂.val : ℝ) *
          (occDeltaSpin fa σ (rLeafVec (leafEquiv (r, b₁)))
            (rLeafVec (leafEquiv (r, b₂)))) ^ 2) =
      (fa.attach.map fun w1 ↦
        (fa.attach.map fun w2 ↦
          if w1.1 % 2 = σ.val ∧ w2.1 % 2 = σ.val then
            flipSignReal w1.1 * flipSignReal w2.1 *
              (modeMatrix r c ⟨w1.1 / 2, by have := hlt w1.1 w1.2; omega⟩
                ⟨w2.1 / 2, by have := hlt w2.1 w2.2; omega⟩) ^ 2
          else 0).sum).sum := by
    have hpt (b₁ b₂ : Fin 29) :
        (deepInnerInt r c b₁.val : ℝ) * ((deepInnerInt r c b₂.val : ℝ) *
          (occDeltaSpin fa σ (rLeafVec (leafEquiv (r, b₁)))
            (rLeafVec (leafEquiv (r, b₂)))) ^ 2) =
        (fa.attach.map fun w1 ↦
          (fa.attach.map fun w2 ↦
            if w1.1 % 2 = σ.val ∧ w2.1 % 2 = σ.val then
              flipSignReal w1.1 * flipSignReal w2.1 *
                (((deepInnerInt r c b₁.val : ℝ) *
                  (rLeafVec (leafEquiv (r, b₁)) ⟨w1.1 / 2, by have := hlt w1.1 w1.2; omega⟩ *
                    rLeafVec (leafEquiv (r, b₁)) ⟨w2.1 / 2, by have := hlt w2.1 w2.2; omega⟩)) *
                 ((deepInnerInt r c b₂.val : ℝ) *
                  (rLeafVec (leafEquiv (r, b₂)) ⟨w1.1 / 2, by have := hlt w1.1 w1.2; omega⟩ *
                    rLeafVec (leafEquiv (r, b₂)) ⟨w2.1 / 2, by have := hlt w2.1 w2.2; omega⟩)))
            else 0).sum).sum := by
      rw [occDeltaSpin_eq_list hnd hlt σ, list_sum_sq, ← List.sum_map_mul_left,
        ← List.sum_map_mul_left]
      refine congrArg List.sum (List.map_congr_left fun w1 _ ↦ ?_)
      rw [← List.sum_map_mul_left, ← List.sum_map_mul_left]
      refine congrArg List.sum (List.map_congr_left fun w2 _ ↦ ?_)
      by_cases h1 : w1.1 % 2 = σ.val <;> by_cases h2 : w2.1 % 2 = σ.val <;>
        (simp [h1, h2]; try ring)
    calc
      (∑ b₁ : Fin 29, (deepInnerInt r c b₁.val : ℝ) *
          ∑ b₂ : Fin 29, (deepInnerInt r c b₂.val : ℝ) *
            (occDeltaSpin fa σ (rLeafVec (leafEquiv (r, b₁)))
              (rLeafVec (leafEquiv (r, b₂)))) ^ 2)
        = ∑ b₁ : Fin 29, ∑ b₂ : Fin 29,
            (deepInnerInt r c b₁.val : ℝ) * ((deepInnerInt r c b₂.val : ℝ) *
              (occDeltaSpin fa σ (rLeafVec (leafEquiv (r, b₁)))
                (rLeafVec (leafEquiv (r, b₂)))) ^ 2) := by
          refine Finset.sum_congr rfl fun b₁ _ ↦ Finset.mul_sum _ _ _
      _ = _ := by
          simp_rw [hpt, list_sum_finset_comm]
          refine congrArg List.sum (List.map_congr_left fun w1 _ ↦ ?_)
          refine congrArg List.sum (List.map_congr_left fun w2 _ ↦ ?_)
          by_cases hc : w1.1 % 2 = σ.val ∧ w2.1 % 2 = σ.val
          · simp only [hc, and_self, ↓reduceIte, modeMatrix, sq]
            simp_rw [← Finset.mul_sum]
            congr 1
            rw [Finset.sum_mul]
          · simp [hc]
  have hsplit_sum :
      (∑ b₁ : Fin 29, (deepInnerInt r c b₁.val : ℝ) *
        ∑ b₂ : Fin 29, (deepInnerInt r c b₂.val : ℝ) *
          ((occDeltaSpin fa 0 (rLeafVec (leafEquiv (r, b₁)))
              (rLeafVec (leafEquiv (r, b₂)))) ^ 2 +
            (occDeltaSpin fa 1 (rLeafVec (leafEquiv (r, b₁)))
              (rLeafVec (leafEquiv (r, b₂)))) ^ 2)) =
      (∑ b₁ : Fin 29, (deepInnerInt r c b₁.val : ℝ) *
        ∑ b₂ : Fin 29, (deepInnerInt r c b₂.val : ℝ) *
          (occDeltaSpin fa 0 (rLeafVec (leafEquiv (r, b₁)))
            (rLeafVec (leafEquiv (r, b₂)))) ^ 2) +
      (∑ b₁ : Fin 29, (deepInnerInt r c b₁.val : ℝ) *
        ∑ b₂ : Fin 29, (deepInnerInt r c b₂.val : ℝ) *
          (occDeltaSpin fa 1 (rLeafVec (leafEquiv (r, b₁)))
            (rLeafVec (leafEquiv (r, b₂)))) ^ 2) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun b₁ _ ↦ ?_
    simp_rw [mul_add, Finset.sum_add_distrib]
    rw [mul_add]
  rw [hsplit_sum, hspin 0, hspin 1]
  unfold exchFlipSqMode
  rw [← list_sum_map_add]
  refine congrArg List.sum (List.map_congr_left fun w1 _ ↦ ?_)
  rw [← list_sum_map_add]
  refine congrArg List.sum (List.map_congr_left fun w2 _ ↦ ?_)
  have hm1 : w1.1 % 2 = 0 ∨ w1.1 % 2 = 1 := by omega
  have hm2 : w2.1 % 2 = 0 ∨ w2.1 % 2 = 1 := by omega
  change (if w1.1 % 2 = 0 ∧ w2.1 % 2 = 0 then _ else 0) +
      (if w1.1 % 2 = 1 ∧ w2.1 % 2 = 1 then _ else 0) = _
  rcases hm1 with h1 | h1 <;> rcases hm2 with h2 | h2 <;> simp [h1, h2]

private lemma diagQuadsInner_sound (wa2 : ℕ) {p1 : ℕ} (hp1 : p1 < 58) (s1Par ref1 : Bool) :
    ∀ (ws : List ℕ) (hws : ∀ w ∈ ws, w < 2 * 58) (tree : QuadAccTree)
      (P : Bool → QuadAccTree → Prop),
      (∀ ok tree',
        (ok = true → ∀ r c,
          evalQuadAccTree r c tree' = evalQuadAccTree r c tree +
            (wa2 : ℝ) * (ws.attach.map fun w2 ↦
              (if ref1 then (-1 : ℝ) else 1) * flipSignReal w2.1 *
                (modeMatrix r c ⟨p1, hp1⟩ ⟨p1, hp1⟩ *
                  modeMatrix r c ⟨w2.1 / 2, by have := hws w2.1 w2.2; omega⟩
                    ⟨w2.1 / 2, by have := hws w2.1 w2.2; omega⟩ -
                if beqBool s1Par (Nat.beq (w2.1 % 2) 1) then
                  (modeMatrix r c ⟨p1, hp1⟩
                    ⟨w2.1 / 2, by have := hws w2.1 w2.2; omega⟩) ^ 2
                else 0)).sum) →
        P ok tree') →
      diagQuadsInner wa2 (65 * p1) s1Par ref1 ws tree P
  | [], _, tree, _, hk => hk true tree fun _ _ _ ↦ by simp
  | w2 :: ws, hws, tree, P, hk => by
    unfold diagQuadsInner
    have hw2 : w2 < 2 * 58 := hws w2 List.mem_cons_self
    have hws' : ∀ w ∈ ws, w < 2 * 58 := fun w hw ↦ hws w (List.mem_cons_of_mem w2 hw)
    have hp2 : w2 / 2 < 58 := by omega
    have hk1_lt : 65 * p1 < 4096 := by omega
    have hk2_lt : 65 * (w2 / 2) < 4096 := by omega
    simp only [strictNat_eq, strictBool_eq, nat_div_def, Nat.mul_eq, nat_mod_def]
    have hstep1 :
        ∀ (Q : Bool → QuadAccTree → Prop),
          (∀ ok1 tree1,
            (ok1 = true → ∀ r c, evalQuadAccTree r c tree1 = evalQuadAccTree r c tree +
              (wa2 : ℝ) * ((if ref1 then (-1 : ℝ) else 1) * flipSignReal w2) *
                (modeMatrix r c ⟨p1, hp1⟩ ⟨p1, hp1⟩ *
                  modeMatrix r c ⟨w2 / 2, hp2⟩ ⟨w2 / 2, hp2⟩)) →
            Q ok1 tree1) →
          (if beqBool ref1 (sextetBitNat w2) then
            pushQuadTreeCPS (65 * p1) (65 * (w2 / 2)) wa2 0 tree
          else
            pushQuadTreeCPS (65 * p1) (65 * (w2 / 2)) 0 wa2 tree) Q := by
      intro Q hQ
      cases hr : ref1 <;> cases hs : sextetBitNat w2 <;>
        simp only [beqBool, Bool.not_true, Bool.not_false, ↓reduceIte, Bool.false_eq_true]
      · refine pushQuadTreeCPS_sound hk1_lt hk2_lt wa2 0 tree Q fun ok1 t1 ht1 ↦
          hQ ok1 t1 fun hok r c ↦ ?_
        rw [ht1 hok r c, keyModeReal_diag r c ⟨p1, hp1⟩, keyModeReal_diag r c ⟨w2 / 2, hp2⟩]
        unfold flipSignReal
        simp only [hr, hs, Bool.false_eq_true, ↓reduceIte]; push_cast; ring
      · refine pushQuadTreeCPS_sound hk1_lt hk2_lt 0 wa2 tree Q fun ok1 t1 ht1 ↦
          hQ ok1 t1 fun hok r c ↦ ?_
        rw [ht1 hok r c, keyModeReal_diag r c ⟨p1, hp1⟩, keyModeReal_diag r c ⟨w2 / 2, hp2⟩]
        unfold flipSignReal
        simp only [hr, hs, Bool.false_eq_true, ↓reduceIte]; push_cast; ring
      · refine pushQuadTreeCPS_sound hk1_lt hk2_lt 0 wa2 tree Q fun ok1 t1 ht1 ↦
          hQ ok1 t1 fun hok r c ↦ ?_
        rw [ht1 hok r c, keyModeReal_diag r c ⟨p1, hp1⟩, keyModeReal_diag r c ⟨w2 / 2, hp2⟩]
        unfold flipSignReal
        simp only [hr, hs, Bool.false_eq_true, ↓reduceIte]; push_cast; ring
      · refine pushQuadTreeCPS_sound hk1_lt hk2_lt wa2 0 tree Q fun ok1 t1 ht1 ↦
          hQ ok1 t1 fun hok r c ↦ ?_
        rw [ht1 hok r c, keyModeReal_diag r c ⟨p1, hp1⟩, keyModeReal_diag r c ⟨w2 / 2, hp2⟩]
        unfold flipSignReal
        simp only [hr, hs, ↓reduceIte]; push_cast; ring
    refine hstep1 _ fun ok1 tree1 ht1 ↦ ?_
    cases ok1 with
    | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
    | true =>
      simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
      by_cases hsp : beqBool s1Par (Nat.beq (w2 % 2) 1) = true
      · rw [ite_eq_left hsp]
        have hdiv65 : 65 * p1 / 65 = p1 := by omega
        rw [hdiv65]
        have hkp_lt : pqKey p1 (w2 / 2) < 4096 := pqKey_lt_4096 hp1 hp2
        have hstep2 :
            ∀ (Q : Bool → QuadAccTree → Prop),
              (∀ ok2 tree2,
                (ok2 = true → ∀ r c, evalQuadAccTree r c tree2 = evalQuadAccTree r c tree1 -
                  (wa2 : ℝ) * ((if ref1 then (-1 : ℝ) else 1) * flipSignReal w2) *
                    (modeMatrix r c ⟨p1, hp1⟩ ⟨w2 / 2, hp2⟩) ^ 2) →
                Q ok2 tree2) →
              (if beqBool ref1 (sextetBitNat w2) then
                pushQuadTreeCPS (pqKey p1 (w2 / 2)) (pqKey p1 (w2 / 2)) 0 wa2 tree1
              else
                pushQuadTreeCPS (pqKey p1 (w2 / 2)) (pqKey p1 (w2 / 2)) wa2 0 tree1) Q := by
          intro Q hQ
          cases hr : ref1 <;> cases hs : sextetBitNat w2 <;>
            simp only [beqBool, Bool.not_true, Bool.not_false, ↓reduceIte, Bool.false_eq_true]
          · refine pushQuadTreeCPS_sound hkp_lt hkp_lt 0 wa2 tree1 Q fun ok2 t2 ht2 ↦
              hQ ok2 t2 fun hok r c ↦ ?_
            rw [ht2 hok r c, keyModeReal_pqKey r c ⟨p1, hp1⟩ ⟨w2 / 2, hp2⟩]
            unfold flipSignReal
            simp only [hr, hs, Bool.false_eq_true, ↓reduceIte]; push_cast; ring
          · refine pushQuadTreeCPS_sound hkp_lt hkp_lt wa2 0 tree1 Q fun ok2 t2 ht2 ↦
              hQ ok2 t2 fun hok r c ↦ ?_
            rw [ht2 hok r c, keyModeReal_pqKey r c ⟨p1, hp1⟩ ⟨w2 / 2, hp2⟩]
            unfold flipSignReal
            simp only [hr, hs, Bool.false_eq_true, ↓reduceIte]; push_cast; ring
          · refine pushQuadTreeCPS_sound hkp_lt hkp_lt wa2 0 tree1 Q fun ok2 t2 ht2 ↦
              hQ ok2 t2 fun hok r c ↦ ?_
            rw [ht2 hok r c, keyModeReal_pqKey r c ⟨p1, hp1⟩ ⟨w2 / 2, hp2⟩]
            unfold flipSignReal
            simp only [hr, hs, Bool.false_eq_true, ↓reduceIte]; push_cast; ring
          · refine pushQuadTreeCPS_sound hkp_lt hkp_lt 0 wa2 tree1 Q fun ok2 t2 ht2 ↦
              hQ ok2 t2 fun hok r c ↦ ?_
            rw [ht2 hok r c, keyModeReal_pqKey r c ⟨p1, hp1⟩ ⟨w2 / 2, hp2⟩]
            unfold flipSignReal
            simp only [hr, hs, ↓reduceIte]; push_cast; ring
        refine hstep2 _ fun ok2 tree2 ht2 ↦ ?_
        cases ok2 with
        | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
        | true =>
          simp only [↓reduceIte]
          refine diagQuadsInner_sound wa2 hp1 s1Par ref1 ws hws' tree2 P fun ok3 t3 ht3 ↦
            hk ok3 t3 fun hok r c ↦ ?_
          rw [ht3 hok r c, ht2 rfl r c, ht1 rfl r c]
          simp only [List.attach_cons, List.map_cons, List.sum_cons, List.map_map,
            Function.comp_def, hsp, ↓reduceIte]
          ring
      · rw [ite_eq_right hsp]
        refine diagQuadsInner_sound wa2 hp1 s1Par ref1 ws hws' tree1 P fun ok3 t3 ht3 ↦
          hk ok3 t3 fun hok r c ↦ ?_
        rw [ht3 hok r c, ht1 rfl r c]
        have hsp_f : beqBool s1Par (Nat.beq (w2 % 2) 1) = false :=
          Bool.eq_false_iff.mpr hsp
        simp only [List.attach_cons, List.map_cons, List.sum_cons, List.map_map,
          Function.comp_def, hsp_f, Bool.false_eq_true, ↓reduceIte, sub_zero]
        ring

private lemma beqBool_mod2_eq_iff (a b : ℕ) :
    beqBool (Nat.beq (a % 2) 1) (Nat.beq (b % 2) 1) = true ↔ a % 2 = b % 2 := by
  have ha : a % 2 = 0 ∨ a % 2 = 1 := by omega
  have hb : b % 2 = 0 ∨ b % 2 = 1 := by omega
  rcases ha with h1 | h1 <;> rcases hb with h2 | h2 <;> rw [h1, h2] <;> decide

private lemma diagQuadsOuter_aux (wa2 : ℕ) {fullFlips : List ℕ}
    (hfull : ∀ w ∈ fullFlips, w < 2 * 58) :
    ∀ (ws : List ℕ) (hws : ∀ w ∈ ws, w < 2 * 58) (tree : QuadAccTree)
      (P : Bool → QuadAccTree → Prop),
      (∀ ok tree',
        (ok = true → ∀ r c, evalQuadAccTree r c tree' = evalQuadAccTree r c tree +
          (wa2 : ℝ) * (ws.attach.map fun w1 ↦
            (fullFlips.attach.map fun w2 ↦
              flipSignReal w1.1 * flipSignReal w2.1 *
                (modeMatrix r c ⟨w1.1 / 2, by have := hws w1.1 w1.2; omega⟩
                  ⟨w1.1 / 2, by have := hws w1.1 w1.2; omega⟩ *
                  modeMatrix r c ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩
                    ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩ -
                if w1.1 % 2 = w2.1 % 2 then
                  (modeMatrix r c ⟨w1.1 / 2, by have := hws w1.1 w1.2; omega⟩
                    ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩) ^ 2
                else 0)).sum).sum) →
        P ok tree') →
      diagQuadsOuter wa2 fullFlips ws tree P
  | [], _, tree, _, hk => hk true tree fun _ _ _ ↦ by simp
  | w1 :: ws, hws, tree, P, hk => by
    unfold diagQuadsOuter
    have hw1 : w1 < 2 * 58 := hws w1 List.mem_cons_self
    have hws' : ∀ w ∈ ws, w < 2 * 58 := fun w hw ↦ hws w (List.mem_cons_of_mem w1 hw)
    have hp1 : w1 / 2 < 58 := by omega
    simp only [strictNat_eq, strictBool_eq, nat_div_def, Nat.mul_eq, nat_mod_def]
    refine diagQuadsInner_sound wa2 hp1 (Nat.beq (w1 % 2) 1) (sextetBitNat w1) fullFlips hfull
      tree _ fun ok1 t1 ht1 ↦ ?_
    cases ok1 with
    | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
    | true =>
      simp only [↓reduceIte]
      refine diagQuadsOuter_aux wa2 hfull ws hws' t1 P fun ok2 t2 ht2 ↦ hk ok2 t2 fun hok r c ↦ ?_
      rw [ht2 hok r c, ht1 rfl r c]
      simp only [List.attach_cons, List.map_cons, List.sum_cons, List.map_map, Function.comp_def]
      have hhead :
          (fullFlips.attach.map fun w2 ↦
            (if sextetBitNat w1 then (-1 : ℝ) else 1) * flipSignReal w2.1 *
              (modeMatrix r c ⟨w1 / 2, hp1⟩ ⟨w1 / 2, hp1⟩ *
                modeMatrix r c ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩
                  ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩ -
              if beqBool (Nat.beq (w1 % 2) 1) (Nat.beq (w2.1 % 2) 1) then
                (modeMatrix r c ⟨w1 / 2, hp1⟩
                  ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩) ^ 2
              else 0)).sum =
          (fullFlips.attach.map fun w2 ↦
            flipSignReal w1 * flipSignReal w2.1 *
              (modeMatrix r c ⟨w1 / 2, hp1⟩ ⟨w1 / 2, hp1⟩ *
                modeMatrix r c ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩
                  ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩ -
              if w1 % 2 = w2.1 % 2 then
                (modeMatrix r c ⟨w1 / 2, hp1⟩
                  ⟨w2.1 / 2, by have := hfull w2.1 w2.2; omega⟩) ^ 2
              else 0)).sum := by
        refine congrArg List.sum (List.map_congr_left fun w2 _ ↦ ?_)
        have hiff := beqBool_mod2_eq_iff w1 w2.1
        by_cases hm : w1 % 2 = w2.1 % 2
        · rw [hiff.mpr hm]
          simp [flipSignReal, hm]
        · have hbf : beqBool (Nat.beq (w1 % 2) 1) (Nat.beq (w2.1 % 2) 1) = false :=
            Bool.eq_false_iff.mpr (mt hiff.mp hm)
          rw [hbf]
          simp [flipSignReal, hm]
      rw [hhead]
      ring

private lemma diagQuadsOuter_sound (wa2 : ℕ) {fa : List ℕ} (hlt : ∀ w ∈ fa, w < 2 * 58)
    (tree : QuadAccTree) (P : Bool → QuadAccTree → Prop)
    (hk : ∀ ok tree',
      (ok = true → ∀ r c, evalQuadAccTree r c tree' = evalQuadAccTree r c tree +
        (wa2 : ℝ) * (flipModeDelta r c fa hlt ^ 2 - exchFlipSqMode r c fa hlt)) →
      P ok tree') :
    diagQuadsOuter wa2 fa fa tree P := by
  refine diagQuadsOuter_aux wa2 hlt fa hlt tree P fun ok tree' htree ↦ hk ok tree' fun hok r c ↦ ?_
  rw [htree hok r c]
  congr 2
  unfold flipModeDelta exchFlipSqMode
  rw [list_sum_sq, ← list_sum_map_sub]
  symm
  refine congrArg List.sum (List.map_congr_left fun w1 _ ↦ ?_)
  rw [← list_sum_map_sub]
  refine congrArg List.sum (List.map_congr_left fun w2 _ ↦ ?_)
  by_cases hm : w1.1 % 2 = w2.1 % 2 <;> (simp [hm]; try ring)

/-! ### Off-Diagonal Mode Decomposition (`emitOneQuadCPS`, `offDiagInner`, `offDiagOuter`) -/

private noncomputable def offDiagModeTerm (r : Fin 9) (c : Fin 14)
    (b₁ b₂ : Fin (2 * 58) → Bool) (wq₁ wp₁ wq₂ wp₂ : Fin (2 * 58)) : ℝ :=
  if wq₁.val % 2 = wp₁.val % 2 ∧ wq₂.val % 2 = wp₂.val % 2 then
    (star (exciteSign b₁ wq₁ wp₁) * exciteSign b₂ wq₂ wp₂).re *
      (modeMatrix r c ⟨wp₁.val / 2, by omega⟩ ⟨wq₁.val / 2, by omega⟩ *
        modeMatrix r c ⟨wp₂.val / 2, by omega⟩ ⟨wq₂.val / 2, by omega⟩)
  else 0

private lemma offDiagQuadReal_eq_modeSum (b₁ b₂ : Fin (2 * 58) → Bool)
    (wq₁ wp₁ wq₂ wp₂ : Fin (2 * 58)) :
    offDiagQuadReal b₁ b₂ wq₁ wp₁ wq₂ wp₂ =
      (coefficientUnit / (15360 ^ 2 : ℝ)) *
        ∑ r : Fin 9, ∑ c : Fin 14,
          ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ)
            * offDiagModeTerm r c b₁ b₂ wq₁ wp₁ wq₂ wp₂ := by
  unfold offDiagQuadReal offDiagModeTerm
  by_cases hm : wq₁.val % 2 = wp₁.val % 2 ∧ wq₂.val % 2 = wp₂.val % 2
  · simp only [hm, and_self, ↓reduceIte]
    rw [mul_left_comm, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun r _ ↦ ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun c _ ↦ by ring
  · simp [hm]

private def coeffReal (neg : Bool) (w : ℕ) : ℝ :=
  if neg then -(w : ℝ) else (w : ℝ)

private lemma coeffReal_sq (neg : Bool) (w : ℕ) :
    (coeffReal neg w) ^ 2 = ((w ^ 2 : ℕ) : ℝ) := by
  cases neg <;> simp [coeffReal]

private lemma emitOneQuadCPS_sound (na nb : Bool) (wa wb : ℕ) {fa fb : List ℕ}
    (hfa : checkFlipsGo fa 0 0 0 0 = true) (hfb : checkFlipsGo fb 0 0 0 0 = true)
    {wq1 wp1 wq2 wp2 : ℕ}
    (hwq1 : wq1 < 2 * 58) (hwp1 : wp1 < 2 * 58) (hwq2 : wq2 < 2 * 58) (hwp2 : wp2 < 2 * 58)
    (hocc1 : detOfFlips fa ⟨wq1, hwq1⟩ = true) (hocc2 : detOfFlips fb ⟨wq2, hwq2⟩ = true)
    (tree : QuadAccTree) (P : Bool → QuadAccTree → Prop)
    (hk : ∀ ok tree',
      (ok = true → ∀ r c, evalQuadAccTree r c tree' = evalQuadAccTree r c tree +
        2 * (coeffReal na wa * coeffReal nb wb) *
          offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
            ⟨wq1, hwq1⟩ ⟨wp1, hwp1⟩ ⟨wq2, hwq2⟩ ⟨wp2, hwp2⟩) →
      P ok tree') :
    emitOneQuadCPS (xor na nb) (2 * (wa * wb)) fa fb wq1 wp1 wq2 wp2 tree P := by
  obtain ⟨hnda, hlta, _, _⟩ := checkFlipsGo_det_valid hfa
  obtain ⟨hndb, hltb, _, _⟩ := checkFlipsGo_det_valid hfb
  unfold emitOneQuadCPS
  by_cases hm : (Nat.beq (Nat.mod wq1 2) (Nat.mod wp1 2) &&
      Nat.beq (Nat.mod wq2 2) (Nat.mod wp2 2)) = true
  · rw [ite_eq_left hm]
    obtain ⟨hm1, hm2⟩ := Bool.and_eq_true_iff.mp hm
    simp only [Nat.beq_eq, nat_mod_def] at hm1 hm2
    simp only [strictBool_eq, strictNat_eq, nat_div_def]
    have hp1_lt : wp1 / 2 < 58 := by omega
    have hq1_lt : wq1 / 2 < 58 := by omega
    have hp2_lt : wp2 / 2 < 58 := by omega
    have hq2_lt : wq2 / 2 < 58 := by omega
    have hk1_lt : pqKey (wp1 / 2) (wq1 / 2) < 4096 := pqKey_lt_4096 hp1_lt hq1_lt
    have hk2_lt : pqKey (wp2 / 2) (wq2 / 2) < 4096 := pqKey_lt_4096 hp2_lt hq2_lt
    have hex1 := exciteSign_detOfFlips hnda hlta hocc1 (wp := ⟨wp1, hwp1⟩)
    have hex2 := exciteSign_detOfFlips hndb hltb hocc2 (wp := ⟨wp2, hwp2⟩)
    have hsgn_re :
        (star (exciteSign (detOfFlips fa) ⟨wq1, hwq1⟩ ⟨wp1, hwp1⟩) *
            exciteSign (detOfFlips fb) ⟨wq2, hwq2⟩ ⟨wp2, hwp2⟩).re =
          (if exciteNegFlips fa wq1 wp1 then (-1 : ℝ) else 1) *
            (if exciteNegFlips fb wq2 wp2 then (-1 : ℝ) else 1) := by
      rw [hex1, hex2]
      cases exciteNegFlips fa wq1 wp1 <;> cases exciteNegFlips fb wq2 wp2 <;> simp
    have hcoeff_eq :
        (if xor (xor na nb) (xor (exciteNegFlips fa wq1 wp1) (exciteNegFlips fb wq2 wp2)) then
            -(2 * ((wa : ℝ) * (wb : ℝ)))
          else 2 * ((wa : ℝ) * (wb : ℝ))) =
          2 * (coeffReal na wa * coeffReal nb wb) *
            ((if exciteNegFlips fa wq1 wp1 then (-1 : ℝ) else 1) *
              (if exciteNegFlips fb wq2 wp2 then (-1 : ℝ) else 1)) := by
      cases na <;> cases nb <;> cases exciteNegFlips fa wq1 wp1 <;>
        cases exciteNegFlips fb wq2 wp2 <;> simp [coeffReal]
    cases hneg : xor (xor na nb) (xor (exciteNegFlips fa wq1 wp1) (exciteNegFlips fb wq2 wp2))
    · simp only [Bool.false_eq_true, ↓reduceIte]
      refine pushQuadTreeCPS_sound hk1_lt hk2_lt (2 * (wa * wb)) 0 tree P fun ok t' ht' ↦
        hk ok t' fun hok r c ↦ ?_
      rw [ht' hok r c, keyModeReal_pqKey r c ⟨wp1 / 2, hp1_lt⟩ ⟨wq1 / 2, hq1_lt⟩,
        keyModeReal_pqKey r c ⟨wp2 / 2, hp2_lt⟩ ⟨wq2 / 2, hq2_lt⟩]
      unfold offDiagModeTerm
      dsimp only
      simp only [hm1, hm2, and_self, ↓reduceIte, hsgn_re, Nat.cast_mul, Nat.cast_ofNat,
        Nat.cast_zero, sub_zero]
      rw [hneg] at hcoeff_eq
      simp only [Bool.false_eq_true, ↓reduceIte] at hcoeff_eq
      have hmul := congrArg (· * (modeMatrix r c ⟨wp1 / 2, hp1_lt⟩ ⟨wq1 / 2, hq1_lt⟩ *
        modeMatrix r c ⟨wp2 / 2, hp2_lt⟩ ⟨wq2 / 2, hq2_lt⟩)) hcoeff_eq
      linarith [hmul]
    · simp only [↓reduceIte]
      refine pushQuadTreeCPS_sound hk1_lt hk2_lt 0 (2 * (wa * wb)) tree P fun ok t' ht' ↦
        hk ok t' fun hok r c ↦ ?_
      rw [ht' hok r c, keyModeReal_pqKey r c ⟨wp1 / 2, hp1_lt⟩ ⟨wq1 / 2, hq1_lt⟩,
        keyModeReal_pqKey r c ⟨wp2 / 2, hp2_lt⟩ ⟨wq2 / 2, hq2_lt⟩]
      unfold offDiagModeTerm
      dsimp only
      simp only [hm1, hm2, and_self, ↓reduceIte, hsgn_re, Nat.cast_mul, Nat.cast_ofNat,
        Nat.cast_zero, zero_sub]
      rw [hneg] at hcoeff_eq
      simp only [↓reduceIte] at hcoeff_eq
      have hmul := congrArg (· * (modeMatrix r c ⟨wp1 / 2, hp1_lt⟩ ⟨wq1 / 2, hq1_lt⟩ *
        modeMatrix r c ⟨wp2 / 2, hp2_lt⟩ ⟨wq2 / 2, hq2_lt⟩)) hcoeff_eq
      linarith [hmul]
  · rw [ite_eq_right hm]
    refine hk true tree fun _ r c ↦ ?_
    have hnot : ¬(wq1 % 2 = wp1 % 2 ∧ wq2 % 2 = wp2 % 2) := by
      rintro ⟨h1, h2⟩
      exact hm (Bool.and_eq_true_iff.mpr ⟨Nat.beq_eq.mpr h1, Nat.beq_eq.mpr h2⟩)
    unfold offDiagModeTerm
    simp [hnot]

private lemma offDiagInner_sound (na : Bool) (wa : ℕ) {fa : List ℕ}
    (hfa : checkFlipsGo fa 0 0 0 0 = true) :
    ∀ (rest : DetList)
      (_ : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true)
      (tree : QuadAccTree) (P : Bool → QuadAccTree → Prop),
      (∀ ok tree',
        (ok = true →
          (∀ tb ∈ detListToList rest, detOfFlips fa ≠ detOfFlips tb.2.2) ∧
          (coefficientUnit / (15360 ^ 2 : ℝ)) *
              (∑ r : Fin 9, ∑ c : Fin 14,
                ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                  (evalQuadAccTree r c tree' - evalQuadAccTree r c tree)) =
            ((detListToList rest).map fun tb ↦
              2 * (coeffReal na wa * coeffReal tb.1 tb.2.1) *
                (star (detVec (detOfFlips fa)) ⬝ᵥ
                  (thcHamiltonian rThc *ᵥ detVec (detOfFlips tb.2.2))).re).sum) →
        P ok tree') →
      offDiagInner na wa fa rest tree P
  | .nil, _, tree, _, hk =>
    hk true tree fun _ ↦ ⟨(fun _ hm ↦ by cases hm), by simp [detListToList]⟩
  | .cons nb wb fb rest, hrest, tree, P, hk => by
    unfold offDiagInner
    have hfb : checkFlipsGo fb 0 0 0 0 = true := hrest (nb, wb, fb) List.mem_cons_self
    have hrest' : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true :=
      fun t ht ↦ hrest t (List.mem_cons_of_mem _ ht)
    obtain ⟨_, hlta, hpwa, _⟩ := checkFlipsGo_det_valid hfa
    obtain ⟨_, hltb, hpwb, _⟩ := checkFlipsGo_det_valid hfb
    have hsd := symDiff5Go_sound 52 fa fb fa fb 0 0 0 0 0 (by decide) hpwa hpwb hlta hltb
      (by simp [accListOfCnt]) (by simp [accListOfCnt]) (fun _ _ ↦ Iff.rfl)
    cases hres : symDiff5Go 52 fa fb 0 0 0 0 0 with
    | lt4 => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
    | gt4 e1 e2 e3 e4 e5 =>
      rw [hres] at hsd
      obtain ⟨hpw5, hmem5⟩ := hsd
      have he1 := hmem5 e1 (by simp)
      have he2 := hmem5 e2 (by simp)
      have he3 := hmem5 e3 (by simp)
      have he4 := hmem5 e4 (by simp)
      have he5 := hmem5 e5 (by simp)
      have hne_ab : detOfFlips fa ≠ detOfFlips fb := by
        intro heq
        have hbit : detBitFlips fa e1 = detBitFlips fb e1 :=
          congr_fun heq ⟨e1, he1.1⟩
        exact (detBitFlips_ne_iff.mpr he1.2) hbit
      -- Five distinct differing wires -> matrix element is 0.
      have hzero : (star (detVec (detOfFlips fa)) ⬝ᵥ
          (thcHamiltonian rThc *ᵥ detVec (detOfFlips fb))).re = 0 := by
        let w1 : Fin (2 * 58) := ⟨e1, he1.1⟩
        let w2 : Fin (2 * 58) := ⟨e2, he2.1⟩
        let w3 : Fin (2 * 58) := ⟨e3, he3.1⟩
        let w4 : Fin (2 * 58) := ⟨e4, he4.1⟩
        let w5 : Fin (2 * 58) := ⟨e5, he5.1⟩
        let s : Finset (Fin (2 * 58)) := {w1, w2, w3, w4, w5}
        simp only [List.pairwise_cons, List.mem_cons, List.not_mem_nil, or_false,
          forall_eq_or_imp, forall_eq] at hpw5
        rcases hpw5 with ⟨⟨h12, h13, h14, h15⟩, ⟨h23, h24, h25⟩, ⟨h34, h35⟩, h45, _⟩
        have hcard : 5 ≤ s.card := by
          have hc : s.card = 5 := by
            have n12 : w1 ≠ w2 := Fin.ne_of_val_ne h12.ne
            have n13 : w1 ≠ w3 := Fin.ne_of_val_ne h13.ne
            have n14 : w1 ≠ w4 := Fin.ne_of_val_ne h14.ne
            have n15 : w1 ≠ w5 := Fin.ne_of_val_ne h15.ne
            have n23 : w2 ≠ w3 := Fin.ne_of_val_ne h23.ne
            have n24 : w2 ≠ w4 := Fin.ne_of_val_ne h24.ne
            have n25 : w2 ≠ w5 := Fin.ne_of_val_ne h25.ne
            have n34 : w3 ≠ w4 := Fin.ne_of_val_ne h34.ne
            have n35 : w3 ≠ w5 := Fin.ne_of_val_ne h35.ne
            have n45 : w4 ≠ w5 := Fin.ne_of_val_ne h45.ne
            simp [s, n12, n13, n14, n15, n23, n24, n25, n34, n35, n45]
          omega
        have hs_diff : ∀ w ∈ s, detOfFlips fa w ≠ detOfFlips fb w := by
          intro w hw
          simp only [s, Finset.mem_insert, Finset.mem_singleton] at hw
          rcases hw with rfl | rfl | rfl | rfl | rfl
          · exact detBitFlips_ne_iff.mpr he1.2
          · exact detBitFlips_ne_iff.mpr he2.2
          · exact detBitFlips_ne_iff.mpr he3.2
          · exact detBitFlips_ne_iff.mpr he4.2
          · exact detBitFlips_ne_iff.mpr he5.2
        rw [dotProduct_thcHamiltonian_eq_zero_of_diff5 (detOfFlips fa) (detOfFlips fb)
          hs_diff hcard, Complex.zero_re]
      refine offDiagInner_sound na wa hfa rest hrest' tree P fun ok tree' hih ↦
        hk ok tree' fun hok ↦ ?_
      obtain ⟨hneqs, hsum⟩ := hih hok
      refine ⟨?_, ?_⟩
      · intro tb htb
        rcases List.mem_cons.mp htb with rfl | htl
        · exact hne_ab
        · exact hneqs tb htl
      · simp only [detListToList, List.map_cons, List.sum_cons, hzero, mul_zero, zero_add]
        exact hsum
    | eq4 d1 d2 d3 d4 =>
      rw [hres] at hsd
      obtain ⟨hpw4, hmem4, hiff4⟩ := hsd
      simp only [strictNatList_eq]
      cases hwps : List.filter (fun w ↦ detBitFlips fa w) [d1, d2, d3, d4] with
      | nil => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
      | cons wp1 wpsRest =>
        cases wpsRest with
        | nil => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
        | cons wp2 wpsTail =>
          cases wpsTail with
          | cons _ _ => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
          | nil =>
            cases hwhs : List.filter (fun w ↦ !detBitFlips fa w) [d1, d2, d3, d4] with
            | nil => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
            | cons wh1 whsRest =>
              cases whsRest with
              | nil => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
              | cons wh2 whsTail =>
                cases whsTail with
                | cons _ _ => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
                | nil =>
                  dsimp only
                  simp only [strictNat_eq, strictBool_eq, Nat.mul_eq]
                  have hpw_p : List.Pairwise (· < ·) [wp1, wp2] :=
                    hwps ▸ hpw4.filter _
                  have hpw_h : List.Pairwise (· < ·) [wh1, wh2] :=
                    hwhs ▸ hpw4.filter _
                  have hwp1_mem : wp1 ∈ [d1, d2, d3, d4] ∧ detBitFlips fa wp1 = true :=
                    List.mem_filter.mp (hwps ▸ List.mem_cons_self)
                  have hwp2_mem : wp2 ∈ [d1, d2, d3, d4] ∧ detBitFlips fa wp2 = true :=
                    List.mem_filter.mp (hwps ▸ List.mem_cons_of_mem wp1 List.mem_cons_self)
                  have hwh1_mem : wh1 ∈ [d1, d2, d3, d4] ∧ (!detBitFlips fa wh1) = true :=
                    List.mem_filter.mp (hwhs ▸ List.mem_cons_self)
                  have hwh2_mem : wh2 ∈ [d1, d2, d3, d4] ∧ (!detBitFlips fa wh2) = true :=
                    List.mem_filter.mp (hwhs ▸ List.mem_cons_of_mem wh1 List.mem_cons_self)
                  have hlt_wp1 : wp1 < 2 * 58 := (hmem4 wp1 hwp1_mem.1).1
                  have hlt_wp2 : wp2 < 2 * 58 := (hmem4 wp2 hwp2_mem.1).1
                  have hlt_wh1 : wh1 < 2 * 58 := (hmem4 wh1 hwh1_mem.1).1
                  have hlt_wh2 : wh2 < 2 * 58 := (hmem4 wh2 hwh2_mem.1).1
                  let fwp1 : Fin (2 * 58) := ⟨wp1, hlt_wp1⟩
                  let fwp2 : Fin (2 * 58) := ⟨wp2, hlt_wp2⟩
                  let fwh1 : Fin (2 * 58) := ⟨wh1, hlt_wh1⟩
                  let fwh2 : Fin (2 * 58) := ⟨wh2, hlt_wh2⟩
                  have hwp_ne : fwp1 ≠ fwp2 := by
                    simp only [List.pairwise_cons, List.mem_singleton, forall_eq] at hpw_p
                    exact Fin.ne_of_val_ne (ne_of_lt hpw_p.1)
                  have hwh_ne : fwh1 ≠ fwh2 := by
                    simp only [List.pairwise_cons, List.mem_singleton, forall_eq] at hpw_h
                    exact Fin.ne_of_val_ne (ne_of_lt hpw_h.1)
                  have hb_wp1 : detOfFlips fa fwp1 = true ∧ detOfFlips fb fwp1 = false := by
                    have hne := detBitFlips_ne_iff.mpr (hmem4 wp1 hwp1_mem.1).2
                    unfold detOfFlips
                    rw [hwp1_mem.2] at hne ⊢
                    exact ⟨rfl, Bool.eq_false_iff.mpr hne.symm⟩
                  have hb_wp2 : detOfFlips fa fwp2 = true ∧ detOfFlips fb fwp2 = false := by
                    have hne := detBitFlips_ne_iff.mpr (hmem4 wp2 hwp2_mem.1).2
                    unfold detOfFlips
                    rw [hwp2_mem.2] at hne ⊢
                    exact ⟨rfl, Bool.eq_false_iff.mpr hne.symm⟩
                  have hb_wh1 : detOfFlips fa fwh1 = false ∧ detOfFlips fb fwh1 = true := by
                    have hfa0 : detBitFlips fa wh1 = false :=
                      Bool.eq_false_iff.mpr fun h ↦ by simp [h] at hwh1_mem
                    have hne := detBitFlips_ne_iff.mpr (hmem4 wh1 hwh1_mem.1).2
                    unfold detOfFlips
                    rw [hfa0] at hne ⊢
                    cases hfb_v : detBitFlips fb wh1
                    · exact absurd hfb_v.symm hne
                    · exact ⟨rfl, rfl⟩
                  have hb_wh2 : detOfFlips fa fwh2 = false ∧ detOfFlips fb fwh2 = true := by
                    have hfa0 : detBitFlips fa wh2 = false :=
                      Bool.eq_false_iff.mpr fun h ↦ by simp [h] at hwh2_mem
                    have hne := detBitFlips_ne_iff.mpr (hmem4 wh2 hwh2_mem.1).2
                    unfold detOfFlips
                    rw [hfa0] at hne ⊢
                    cases hfb_v : detBitFlips fb wh2
                    · exact absurd hfb_v.symm hne
                    · exact ⟨rfl, rfl⟩
                  have hagree : ∀ w : Fin (2 * 58),
                      w ≠ fwp1 → w ≠ fwp2 → w ≠ fwh1 → w ≠ fwh2 →
                      detOfFlips fa w = detOfFlips fb w := by
                    intro w hn1 hn2 hn3 hn4
                    by_contra hdiff
                    have hm4 : w.val ∈ [d1, d2, d3, d4] :=
                      (hiff4 w.val).mp (detBitFlips_ne_iff.mp hdiff)
                    cases hba : detBitFlips fa w.val
                    · have hm_wh : w.val ∈ [wh1, wh2] :=
                        hwhs ▸ List.mem_filter.mpr ⟨hm4, by simp [hba]⟩
                      rcases List.mem_cons.mp hm_wh with h1 | h2
                      · exact hn3 (Fin.ext h1)
                      · exact hn4 (Fin.ext (List.mem_singleton.mp h2))
                    · have hm_wp : w.val ∈ [wp1, wp2] :=
                        hwps ▸ List.mem_filter.mpr ⟨hm4, hba⟩
                      rcases List.mem_cons.mp hm_wp with h1 | h2
                      · exact hn1 (Fin.ext h1)
                      · exact hn2 (Fin.ext (List.mem_singleton.mp h2))
                  have hne_ab : detOfFlips fa ≠ detOfFlips fb := by
                    intro heq
                    have := congr_fun heq fwp1
                    rw [hb_wp1.1, hb_wp1.2] at this
                    exact Bool.noConfusion this
                  have hfour := re_thcHamiltonian_offDiag_of_four_quads
                    (detOfFlips fa) (detOfFlips fb) hwp_ne hwh_ne hb_wp1 hb_wp2 hb_wh1 hb_wh2 hagree
                  refine emitOneQuadCPS_sound na nb wa wb hfa hfb
                    hlt_wp1 hlt_wh1 hlt_wh2 hlt_wp2 hb_wp1.1 hb_wh2.2 tree _ fun ok1 t1 ht1 ↦ ?_
                  cases ok1 with
                  | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
                  | true =>
                    simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
                    refine emitOneQuadCPS_sound na nb wa wb hfa hfb
                      hlt_wp1 hlt_wh2 hlt_wh1 hlt_wp2 hb_wp1.1 hb_wh1.2 t1 _ fun ok2 t2 ht2 ↦ ?_
                    cases ok2 with
                    | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
                    | true =>
                      simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
                      refine emitOneQuadCPS_sound na nb wa wb hfa hfb
                        hlt_wp2 hlt_wh1 hlt_wh2 hlt_wp1 hb_wp2.1 hb_wh2.2 t2 _ fun ok3 t3 ht3 ↦ ?_
                      cases ok3 with
                      | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
                      | true =>
                        simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
                        refine emitOneQuadCPS_sound na nb wa wb hfa hfb
                          hlt_wp2 hlt_wh2 hlt_wh1 hlt_wp1 hb_wp2.1 hb_wh1.2 t3 _ fun ok4 t4 ht4 ↦ ?_
                        cases ok4 with
                        | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
                        | true =>
                          simp only [↓reduceIte]
                          refine offDiagInner_sound na wa hfa rest hrest' t4 P fun ok5 t5 hih ↦
                            hk ok5 t5 fun hok ↦ ?_
                          obtain ⟨hneqs, hsum_rest⟩ := hih hok
                          refine ⟨?_, ?_⟩
                          · intro tb htb
                            rcases List.mem_cons.mp htb with rfl | htl
                            · exact hne_ab
                            · exact hneqs tb htl
                          · have hdiff4 (r : Fin 9) (c : Fin 14) :
                                evalQuadAccTree r c t5 - evalQuadAccTree r c tree =
                                  (evalQuadAccTree r c t4 - evalQuadAccTree r c tree) +
                                    (evalQuadAccTree r c t5 - evalQuadAccTree r c t4) := by ring
                            have ht4_diff (r : Fin 9) (c : Fin 14) :
                                evalQuadAccTree r c t4 - evalQuadAccTree r c tree =
                                  2 * (coeffReal na wa * coeffReal nb wb) *
                                    (offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                        fwp1 fwh1 fwh2 fwp2 +
                                      offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                        fwp1 fwh2 fwh1 fwp2 +
                                      offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                        fwp2 fwh1 fwh2 fwp1 +
                                      offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                        fwp2 fwh2 fwh1 fwp1) := by
                              rw [ht4 rfl r c, ht3 rfl r c, ht2 rfl r c, ht1 rfl r c]; ring
                            have hlhs_split :
                                (coefficientUnit / (15360 ^ 2 : ℝ)) *
                                  (∑ r : Fin 9, ∑ c : Fin 14,
                                    ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                                      (evalQuadAccTree r c t5 - evalQuadAccTree r c tree)) =
                                (coefficientUnit / (15360 ^ 2 : ℝ)) *
                                  (∑ r : Fin 9, ∑ c : Fin 14,
                                    ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                                      (evalQuadAccTree r c t4 - evalQuadAccTree r c tree)) +
                                ((detListToList rest).map fun tb ↦
                                  2 * (coeffReal na wa * coeffReal tb.1 tb.2.1) *
                                    (star (detVec (detOfFlips fa)) ⬝ᵥ
                                      (thcHamiltonian rThc *ᵥ
                                        detVec (detOfFlips tb.2.2))).re).sum := by
                              simp_rw [hdiff4, mul_add, Finset.sum_add_distrib]
                              rw [mul_add, hsum_rest]
                            rw [hlhs_split]
                            simp only [detListToList, List.map_cons, List.sum_cons]
                            refine congrArg (· + _) ?_
                            have hsum_rc :
                                (∑ r : Fin 9, ∑ c : Fin 14,
                                  ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                                    (evalQuadAccTree r c t4 - evalQuadAccTree r c tree)) =
                                2 * (coeffReal na wa * coeffReal nb wb) *
                                  ∑ r : Fin 9, ∑ c : Fin 14,
                                    ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                                      (offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                          fwp1 fwh1 fwh2 fwp2 +
                                        offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                          fwp1 fwh2 fwh1 fwp2 +
                                        offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                          fwp2 fwh1 fwh2 fwp1 +
                                        offDiagModeTerm r c (detOfFlips fa) (detOfFlips fb)
                                          fwp2 fwh2 fwh1 fwp1) := by
                              rw [Finset.mul_sum]
                              refine Finset.sum_congr rfl fun r _ ↦ ?_
                              rw [Finset.mul_sum]
                              refine Finset.sum_congr rfl fun c _ ↦ ?_
                              rw [ht4_diff r c]; ring
                            rw [hsum_rc, hfour, offDiagQuadReal_eq_modeSum,
                              offDiagQuadReal_eq_modeSum, offDiagQuadReal_eq_modeSum,
                              offDiagQuadReal_eq_modeSum]
                            simp only [mul_add, Finset.sum_add_distrib]
                            ring

private def upperPairsSum {α : Type*} (g : α → α → ℝ) : List α → ℝ
  | [] => 0
  | x :: xs => (xs.map (g x)).sum + upperPairsSum g xs

private lemma list_sum_eq_fin_sum {α : Type*} :
    ∀ (L : List α) (f : α → ℝ), (L.map f).sum = ∑ a : Fin L.length, f (L.get a)
  | [], _ => by simp
  | x :: xs, f => by
    rw [List.map_cons, List.sum_cons, list_sum_eq_fin_sum xs f]
    change f x + ∑ a : Fin xs.length, f (xs.get a) = ∑ a : Fin (xs.length + 1), f ((x :: xs).get a)
    rw [Fin.sum_univ_succ]
    rfl

private lemma upperPairsSum_eq_fin_sum {α : Type*} :
    ∀ (L : List α) (g : α → α → ℝ),
      upperPairsSum g L =
        ∑ a : Fin L.length, ∑ b ∈ Finset.univ.filter (fun b ↦ a < b), g (L.get a) (L.get b)
  | [], _ => by simp [upperPairsSum]
  | x :: xs, g => by
    rw [upperPairsSum, list_sum_eq_fin_sum xs (g x), upperPairsSum_eq_fin_sum xs g]
    change (∑ a : Fin xs.length, g x (xs.get a)) +
      (∑ a : Fin xs.length, ∑ b ∈ Finset.univ.filter (fun b ↦ a < b), g (xs.get a) (xs.get b)) =
      ∑ a : Fin (xs.length + 1),
        ∑ b ∈ Finset.univ.filter (fun b ↦ a < b), g ((x :: xs).get a) ((x :: xs).get b)
    rw [Fin.sum_univ_succ]
    congr 1
    · rw [Finset.sum_filter, Fin.sum_univ_succ]
      simp [Fin.succ_pos]
    · refine Finset.sum_congr rfl fun a _ ↦ ?_
      rw [Finset.sum_filter, Finset.sum_filter, Fin.sum_univ_succ]
      have hnot0 : ¬(a.succ < (0 : Fin (xs.length + 1))) := not_lt.mpr (Fin.zero_le _)
      simp [hnot0, Fin.succ_lt_succ_iff]

private lemma offDiagOuter_sound :
    ∀ (ds : DetList)
      (_ : ∀ t ∈ detListToList ds, checkFlipsGo t.2.2 0 0 0 0 = true)
      (tree : QuadAccTree) (P : Bool → QuadAccTree → Prop),
      (∀ ok tree',
        (ok = true →
          List.Pairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2) (detListToList ds) ∧
          (coefficientUnit / (15360 ^ 2 : ℝ)) *
              (∑ r : Fin 9, ∑ c : Fin 14,
                ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                  (evalQuadAccTree r c tree' - evalQuadAccTree r c tree)) =
            upperPairsSum (fun ta tb ↦
              2 * (coeffReal ta.1 ta.2.1 * coeffReal tb.1 tb.2.1) *
                (star (detVec (detOfFlips ta.2.2)) ⬝ᵥ
                  (thcHamiltonian rThc *ᵥ detVec (detOfFlips tb.2.2))).re)
              (detListToList ds)) →
        P ok tree') →
      offDiagOuter ds tree P
  | .nil, _, tree, _, hk =>
    hk true tree fun _ ↦ ⟨List.Pairwise.nil, by simp [detListToList, upperPairsSum]⟩
  | .cons na wa fa rest, hvalid, tree, P, hk => by
    unfold offDiagOuter
    have hfa : checkFlipsGo fa 0 0 0 0 = true := hvalid (na, wa, fa) List.mem_cons_self
    have hrest : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true :=
      fun t ht ↦ hvalid t (List.mem_cons_of_mem _ ht)
    refine offDiagInner_sound na wa hfa rest hrest tree _ fun ok1 t1 ht1 ↦ ?_
    cases ok1 with
    | false => exact hk false .empty fun h ↦ absurd h Bool.false_ne_true
    | true =>
      simp only [↓reduceIte]
      refine offDiagOuter_sound rest hrest t1 P fun ok2 t2 ht2 ↦ hk ok2 t2 fun hok ↦ ?_
      obtain ⟨hneq_hd, hsum_hd⟩ := ht1 rfl
      obtain ⟨hpw_tl, hsum_tl⟩ := ht2 hok
      refine ⟨List.Pairwise.cons hneq_hd hpw_tl, ?_⟩
      have hsplit (r : Fin 9) (c : Fin 14) :
          evalQuadAccTree r c t2 - evalQuadAccTree r c tree =
            (evalQuadAccTree r c t1 - evalQuadAccTree r c tree) +
              (evalQuadAccTree r c t2 - evalQuadAccTree r c t1) := by ring
      simp_rw [hsplit, mul_add, Finset.sum_add_distrib, mul_add, hsum_hd, hsum_tl]
      rfl

