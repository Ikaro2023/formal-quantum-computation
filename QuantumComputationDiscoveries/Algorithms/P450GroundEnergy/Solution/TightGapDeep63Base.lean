          ((dw0NCert.getD p.val 0 : ℝ) + (dw1NCert.getD p.val 0 : ℝ))) *
          modeMatrix r c p p := by
    rw [← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl fun p _ ↦ ?_
    rw [hdml p,
      list_zipWith_add_getD dw0PCert dw1PCert (dw0PCert_length.trans dw1PCert_length.symm),
      list_zipWith_add_getD dw0NCert dw1NCert (dw0NCert_length.trans dw1NCert_length.symm),
