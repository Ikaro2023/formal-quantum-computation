    rw [← Fin.sum_univ_eq_sum_range]; unfold sextetModeSD0
    refine Finset.sum_congr rfl fun p _ ↦ by rw [hdml p]; unfold sextetOccCountNat; push_cast; rfl
  have hdelta : (∑ p ∈ Finset.range 58,
