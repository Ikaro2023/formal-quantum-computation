    hs0 hs1 hs2 hs3 hs4 hs5 hs6 hs7 hs8 hs9 hs10 hs11 hs12 hs13 hs14 hs15
  let detsData := deepDetsData
  set L := detListToList deepDetsData
  let goalProp : Prop :=
    ∃ ψ : Fin (2 ^ (2 * 58)) → ℂ,
