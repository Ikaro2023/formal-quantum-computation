private lemma buildDiagStep_aux :
    ∀ (ds : DetList)
      (_ : ∀ t ∈ detListToList ds, checkFlipsGo t.2.2 0 0 0 0 = true)
      (wireW : List ℕ) (_ : wireW.length = 116) (qTree : QuadAccTree)
      (P : Bool → List ℕ → QuadAccTree → Prop),
      (∀ ok wOut diagTree,
        (ok = true →
          wOut.length = 116 ∧
          (∀ j : ℕ, j < 116 → wOut.getD j 0 = wireW.getD j 0 +
            ((detListToList ds).map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum) ∧
          (∀ r c, evalQuadAccTree r c diagTree = evalQuadAccTree r c qTree +
            ((detListToList ds).map (diagDetModeTerm r c)).sum)) →
        P ok wOut diagTree) →
      buildDiagStep ds wireW qTree P
  | .nil, _, wireW, hlen, qTree, _, hk =>
    hk true wireW qTree fun _ ↦
      ⟨hlen, fun _ _ ↦ by simp [detListToList], fun _ _ ↦ by simp [detListToList]⟩
  | .cons na wa fa rest, hvalid, wireW, hlen, qTree, P, hk => by
    unfold buildDiagStep
    have hfa : checkFlipsGo fa 0 0 0 0 = true := hvalid (na, wa, fa) List.mem_cons_self
    have hrest : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true :=
      fun t ht ↦ hvalid t (List.mem_cons_of_mem _ ht)
    obtain ⟨hnda, hlta, _, _⟩ := checkFlipsGo_det_valid hfa
    simp only [strictNat_eq, strictNatList_eq, Nat.mul_eq]
    have hlen' : (addFlipsW (wa * wa) fa wireW).length = 116 := by
      rw [addFlipsW_length, hlen]
    have hlta_w : ∀ w ∈ fa, w < wireW.length := by rw [hlen]; exact hlta
    refine diagQuadsOuter_sound (wa * wa) hlta qTree _ fun ok1 qt1 hqt1 ↦ ?_
    cases ok1 with
    | false => exact hk false [] .empty fun h ↦ absurd h Bool.false_ne_true
    | true =>
      simp only [↓reduceIte]
      refine buildDiagStep_aux rest hrest (addFlipsW (wa * wa) fa wireW) hlen' qt1 P
        fun ok2 wOut diagTree hih ↦
          hk ok2 wOut diagTree fun hok ↦ ?_
      obtain ⟨hlenF, hgetF, hqF⟩ := hih hok
      refine ⟨hlenF, fun j hj ↦ ?_, fun r c ↦ ?_⟩
      · rw [hgetF j hj, addFlipsW_getD (wa * wa) fa wireW hnda hlta_w j]
        simp only [detListToList, List.map_cons, List.sum_cons, sq]
        omega
      · rw [hqF r c, hqt1 rfl r c]
        have hhd : diagDetModeTerm r c (na, wa, fa) =
            ((wa ^ 2 : ℕ) : ℝ) *
              (flipModeDelta r c fa hlta ^ 2 - exchFlipSqMode r c fa hlta) := by
          unfold diagDetModeTerm
          dsimp only
          exact dite_eq_left hlta
        simp only [detListToList, List.map_cons, List.sum_cons, hhd, sq, Nat.cast_mul]
        ring

private lemma emitOneQuadCPS_comp {α β : Type} (f : α → β) (wProdNeg : Bool) (twoWab : ℕ)
    (fa fb : List ℕ) (wq1 wp1 wq2 wp2 : ℕ) (tree : QuadAccTree)
    (k : Bool → QuadAccTree → α) :
    emitOneQuadCPS wProdNeg twoWab fa fb wq1 wp1 wq2 wp2 tree (fun a b ↦ f (k a b)) =
      f (emitOneQuadCPS wProdNeg twoWab fa fb wq1 wp1 wq2 wp2 tree k) := by
  unfold emitOneQuadCPS
  split_ifs with hm
  · simp only [strictBool_eq, strictNat_eq]
