private lemma block_exch_of_tables (dw0P dw0N dw1P dw1N : List ℕ)
    (hl0P : dw0P.length = 58) (hl0N : dw0N.length = 58)
    (hl1P : dw1P.length = 58) (hl1N : dw1N.length = 58)
    (blkLeaves blkIw : List (List ℕ)) (uFn : ℕ → Fin 58 → ℝ)
    (hblk : ∀ b < 29, List.Forall₂ ValidOrb5e8 (blkLeaves.getD b []) (List.ofFn (uFn b)))
    (fwRow : List ℕ) (expP expN : ℕ) (targetReal : ℝ)
    (htarget : (∑ b1 ∈ Finset.range 29, ∑ b2 ∈ Finset.range 29,
        zWeightReal fwRow blkIw b1 b2 *
          pairValLists dw0P dw0N dw1P dw1N (uFn b1) (uFn b2)) =
      targetReal)
    (hcert : (prepLeavesExch dw0P dw0N dw1P dw1N 29 blkLeaves [] fun okL leaves ↦
      if !okL then false
      else
        blockExchCipsi (sumList (getFw2Go 14 fwRow))
          (sumList dw0P) (sumList dw0N) (sumList dw1P) (sumList dw1N) leaves
          ((List.range 29).map fun j ↦ getColGo j 14 blkIw)
          ((List.range 29).map fun j ↦
            List.zipWith Nat.mul (getFw2Go 14 fwRow) (getColGo j 14 blkIw))
          ((List.range 29).map fun j ↦ dotRaw (getFw2Go 14 fwRow) (getColGo j 14 blkIw))
          0 0 fun okEx blkExP blkExN ↦
        if !okEx then false
        else
          normPN (Nat.div (Nat.add blkExP 99) 100) (Nat.div blkExN 100) fun frP1 frN1 ↦
            Nat.beq frP1 expP && Nat.beq frN1 expN) = true) :
    targetReal ≤ 10 * ((expP : ℝ) - (expN : ℝ)) := by
  let goalProp : Prop := targetReal ≤ 10 * ((expP : ℝ) - (expN : ℝ))
  let fImp : Bool → Prop := fun b ↦ b = true → goalProp
  have h1 := prepLeavesExch_valid_aux dw0P dw0N dw1P dw1N 29 blkLeaves uFn [] [] uFn
    hblk (fun _ _ ↦ by simp) .nil
    (fun okL leaves ↦ fImp (
      if !okL then false
      else
        blockExchCipsi (sumList (getFw2Go 14 fwRow))
          (sumList dw0P) (sumList dw0N) (sumList dw1P) (sumList dw1N) leaves
          ((List.range 29).map fun j ↦ getColGo j 14 blkIw)
          ((List.range 29).map fun j ↦
            List.zipWith Nat.mul (getFw2Go 14 fwRow) (getColGo j 14 blkIw))
          ((List.range 29).map fun j ↦ dotRaw (getFw2Go 14 fwRow) (getColGo j 14 blkIw))
          0 0 fun okEx blkExP blkExN ↦
        if !okEx then false
        else
          normPN (Nat.div (Nat.add blkExP 99) 100) (Nat.div blkExN 100) fun frP1 frN1 ↦
            Nat.beq frP1 expP && Nat.beq frN1 expN))
    fun okL leaves hleaves hk1 ↦ by
      cases okL with
      | false => exact absurd hk1 Bool.false_ne_true
      | true =>
        simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte] at hk1
        have hlv := hleaves rfl
        simp only [List.nil_append, List.length_nil, Nat.zero_add, List.map_id'] at hlv
        have h2 := blockExchCipsi_le hl0P hl0N hl1P hl1N uFn fwRow blkIw (List.range 29) hlv
          0 0
          (fun okEx blkExP blkExN ↦ fImp (
            if !okEx then false
            else
              normPN (Nat.div (Nat.add blkExP 99) 100) (Nat.div blkExN 100) fun frP1 frN1 ↦
                Nat.beq frP1 expP && Nat.beq frN1 expN))
          fun okEx blkExP blkExN hblk2 hk2 ↦ by
            cases okEx with
            | false => exact absurd hk2 Bool.false_ne_true
            | true =>
              simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte] at hk2
              have hle := hblk2 rfl
              have h3 := normPN_sound (Nat.div (Nat.add blkExP 99) 100) (Nat.div blkExN 100)
                (fun frP1 frN1 ↦ fImp (Nat.beq frP1 expP && Nat.beq frN1 expN))
                fun frP1 frN1 hnorm hk3 ↦ by
                  obtain ⟨hbP, hbN⟩ := Bool.and_eq_true_iff.mp hk3
                  have hP := Nat.beq_eq.mp hbP
                  have hN := Nat.beq_eq.mp hbN
                  subst hP hN
                  have hsymm : ∀ i j,
                      zWeightReal fwRow blkIw i j *
                        pairValLists dw0P dw0N dw1P dw1N (uFn i) (uFn j) =
                      zWeightReal fwRow blkIw j i *
                        pairValLists dw0P dw0N dw1P dw1N (uFn j) (uFn i) := by
                    intro i j; rw [zWeightReal_symm, pairValLists_symm]
                  rw [← list_double_sum_eq_symmQuadSum _ hsymm] at hle
                  simp_rw [list_sum_map_range] at hle
                  rw [htarget] at hle
                  have hc := real_le_nat_cdiv (n := blkExP) (d := 100) (k := 99) (by decide)
                  have hf := nat_div_le_real (n := blkExN) (d := 100)
                  simp only [Nat.add_eq, nat_div_def] at hnorm
                  simp only [Nat.cast_zero, sub_zero, zero_add] at hle
                  linarith
              rw [normPN_comp fImp] at h3; exact h3 hk2
        rw [blockExchCipsi_comp fImp] at h2; exact h2 hk1
  rw [prepLeavesExch_comp fImp] at h1; exact h1 hcert

lemma block_exch_cert_sound (hcay : checkCayleyCertTop = true)
    (hb0 : checkRotBlkLeavesCert 0 87 = true)
    (hb1 : checkRotBlkLeavesCert 87 87 = true)
    (hb2 : checkRotBlkLeavesCert 174 87 = true)
    (r : Fin 9) (expP expN : ℕ) (hcert : checkBlockExchCert r.val expP expN = true) :
    cipsiBlockExchReal r ≤ 10 * ((expP : ℝ) - (expN : ℝ)) := by
  unfold checkBlockExchCert at hcert
  simp -iota only [strictNatList_eq, strictNat_eq, forceList_eq,
    getRotBlkChunk_eq r, buildColsCipsi_eq, blockExchF_eq, List.reverse_nil, List.nil_append,
    Nat.zero_add, Nat.mul_eq] at hcert
  refine block_exch_of_tables dw0PCert dw0NCert dw1PCert dw1NCert
    dw0PCert_length dw0NCert_length dw1PCert_length dw1NCert_length
    ((rotBlkLeavesCert.drop (29 * r.val)).take 29)
    (bvSlice innerWeights (14 * r.val) 14)
    (rBlkFn r) (fun _ hb ↦ rotBlk_row_valid hcay hb0 hb1 hb2 r hb)
    (bvRow fragmentWeights ⟨min r.val 8, by omega⟩) expP expN (cipsiBlockExchReal r)
    ?_ hcert
  unfold cipsiBlockExchReal
  rw [← Fin.sum_univ_eq_sum_range]
  refine Finset.sum_congr rfl fun b1 _ ↦ ?_
  rw [← Fin.sum_univ_eq_sum_range]
  refine Finset.sum_congr rfl fun b2 _ ↦ ?_
  have hzw : zWeightReal (bvRow fragmentWeights ⟨min r.val 8, by omega⟩)
      (bvSlice innerWeights (14 * r.val) 14) b1.val b2.val =
      ∑ c : Fin 14, ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
        (deepInnerInt r c b1.val : ℝ) * (deepInnerInt r c b2.val : ℝ) := by
    unfold zWeightReal; rw [← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl fun c _ ↦ ?_
    rw [fwRow_fragOuterNat r c, blkIw_innerInt r c b1.val, blkIw_innerInt r c b2.val]
    push_cast; rfl
  have hb1_eq : rBlkFn r b1.val = rLeafVec (leafEquiv (r, b1)) := by
    unfold rBlkFn
    have hfin : (⟨min b1.val 28, by omega⟩ : Fin 29) = b1 := Fin.ext (Nat.min_eq_left (by omega))
    rw [hfin]
  have hb2_eq : rBlkFn r b2.val = rLeafVec (leafEquiv (r, b2)) := by
    unfold rBlkFn
    have hfin : (⟨min b2.val 28, by omega⟩ : Fin 29) = b2 := Fin.ext (Nat.min_eq_left (by omega))
    rw [hfin]
  rw [hzw]; unfold pairValLists cipsiPairValReal; rw [hb1_eq, hb2_eq]
lemma strictNat_bind {n : ℕ} {P : ℕ → Prop} (h : ∀ x, x = n → P x) :
    strictNat n P := by
  rw [strictNat_eq]
  exact h n rfl

private lemma cps1_congr {γ₁ β : Type} (m : (γ₁ → β) → β)
    {k₁ k₂ : γ₁ → β} (h : ∀ a, k₁ a = k₂ a) : m k₁ = m k₂ :=
  congrArg m (funext h)

lemma cps9_congr {γ₁ γ₂ γ₃ γ₄ γ₅ γ₆ γ₇ γ₈ γ₉ β : Type}
    (m : (γ₁ → γ₂ → γ₃ → γ₄ → γ₅ → γ₆ → γ₇ → γ₈ → γ₉ → β) → β)
    {k₁ k₂ : γ₁ → γ₂ → γ₃ → γ₄ → γ₅ → γ₆ → γ₇ → γ₈ → γ₉ → β}
    (h : ∀ a1 a2 a3 a4 a5 a6 a7 a8 a9,
      k₁ a1 a2 a3 a4 a5 a6 a7 a8 a9 = k₂ a1 a2 a3 a4 a5 a6 a7 a8 a9) :
    m k₁ = m k₂ :=
  congrArg m (funext fun a1 ↦ funext fun a2 ↦ funext fun a3 ↦ funext fun a4 ↦
    funext fun a5 ↦ funext fun a6 ↦ funext fun a7 ↦ funext fun a8 ↦ funext fun a9 ↦
      h a1 a2 a3 a4 a5 a6 a7 a8 a9)

