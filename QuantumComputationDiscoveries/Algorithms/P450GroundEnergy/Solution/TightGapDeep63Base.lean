/-! ### Upper-Triangular Block Exchange Accumulation (`rowExchCipsi` & `blockExchCipsi`) -/

private def symmQuadSum {α : Type*} (g : α → α → ℝ) : List α → ℝ
  | [] => 0
  | x :: xs => g x x + (xs.map fun y ↦ 2 * g x y).sum + symmQuadSum g xs

private lemma list_double_sum_eq_symmQuadSum {α : Type*} (g : α → α → ℝ)
    (hg : ∀ x y, g x y = g y x) :
    ∀ xs : List α, (xs.map fun x ↦ (xs.map fun y ↦ g x y).sum).sum = symmQuadSum g xs
  | [] => rfl
  | x :: xs => by
    simp only [List.map_cons, List.sum_cons, symmQuadSum,
      ← list_double_sum_eq_symmQuadSum g hg xs]
    rw [List.sum_map_add]
    have hmap : (xs.map fun y ↦ g y x) = xs.map fun y ↦ g x y :=
      List.map_congr_left fun y _ ↦ hg y x
    have htwo : (xs.map fun y ↦ 2 * g x y).sum =
        (xs.map fun y ↦ g x y).sum + (xs.map fun y ↦ g x y).sum := by
      have : (fun y ↦ 2 * g x y) = fun y ↦ g x y + g x y := funext fun y ↦ two_mul (g x y)
      rw [this, List.sum_map_add]
    rw [hmap, htwo]
    ring

private lemma list_sum_map_range (f : ℕ → ℝ) : ∀ n : ℕ,
    ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i
  | 0 => rfl
  | n + 1 => by
    rw [List.range_succ_eq_map, List.map_cons, List.map_map, List.sum_cons,
      list_sum_map_range (f ∘ Nat.succ) n, Finset.sum_range_succ']
    dsimp; ring

private noncomputable def zWeightReal (fw : List ℕ) (iw14 : List (List ℕ)) (b1 b2 : ℕ) : ℝ :=
  ∑ c ∈ Finset.range 14,
    2 * (fw.getD c 0 : ℝ) *
      (((iw14.getD c []).getD b1 16384 : ℝ) - 16384) *
      (((iw14.getD c []).getD b2 16384 : ℝ) - 16384)

private lemma zWeightReal_symm (fw : List ℕ) (iw14 : List (List ℕ)) (b1 b2 : ℕ) :
    zWeightReal fw iw14 b1 b2 = zWeightReal fw iw14 b2 b1 := by
  unfold zWeightReal
  refine Finset.sum_congr rfl fun c _ ↦ by ring

private lemma zDiag_eq_zWeightReal (fw : List ℕ) (iw14 : List (List ℕ)) (b1 : ℕ) :
    let nrc2s := getFw2Go 14 fw
    let raw1 := getColGo b1 14 iw14
    let sc1 := List.zipWith Nat.mul nrc2s raw1
    let cs1 := dotRaw nrc2s raw1
    let sum2Nrc := sumList nrc2s
    ((Nat.add (dotRaw sc1 raw1) (Nat.mul 268435456 sum2Nrc) : ℕ) : ℝ) -
      ((Nat.mul 32768 cs1 : ℕ) : ℝ) = zWeightReal fw iw14 b1 b1 := by
  simp only [getFw2Go_eq, getColGo_eq, zipWith_mul_map_range, dotRaw_map_range, sumList_map_range,
    Nat.add_eq, Nat.mul_eq, zWeightReal]
  push_cast
  have h1 : (268435456 : ℝ) * ∑ i ∈ Finset.range 14, 2 * (fw.getD i 0 : ℝ) =
      ∑ i ∈ Finset.range 14, 268435456 * (2 * (fw.getD i 0 : ℝ)) := Finset.mul_sum _ _ _
  have h2 : (32768 : ℝ) * ∑ i ∈ Finset.range 14,
        2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b1 16384 : ℝ) =
      ∑ i ∈ Finset.range 14,
        32768 * (2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b1 16384 : ℝ)) :=
    Finset.mul_sum _ _ _
  rw [h1, h2, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun c _ ↦ by ring

private lemma zOffDiag_eq_two_zWeightReal (fw : List ℕ) (iw14 : List (List ℕ)) (b1 b2 : ℕ) :
    let nrc2s := getFw2Go 14 fw
    let raw1 := getColGo b1 14 iw14
    let raw2 := getColGo b2 14 iw14
    let sc1 := List.zipWith Nat.mul nrc2s raw1
    let cs1 := dotRaw nrc2s raw1
    let cs2 := dotRaw nrc2s raw2
    let sum2Nrc := sumList nrc2s
    ((Nat.mul 2 (Nat.add (dotRaw sc1 raw2) (Nat.mul 268435456 sum2Nrc)) : ℕ) : ℝ) -
      ((Nat.mul 32768 (Nat.add cs1 cs2) : ℕ) : ℝ) = 2 * zWeightReal fw iw14 b1 b2 := by
  simp only [getFw2Go_eq, getColGo_eq, zipWith_mul_map_range, dotRaw_map_range, sumList_map_range,
    Nat.add_eq, Nat.mul_eq, zWeightReal]
  push_cast
  rw [two_mul (∑ _ ∈ _, _)]
  have hsum :
      2 * ((∑ i ∈ Finset.range 14,
            2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b1 16384 : ℝ) *
              ((iw14.getD i []).getD b2 16384 : ℝ)) +
          268435456 * ∑ i ∈ Finset.range 14, 2 * (fw.getD i 0 : ℝ)) -
        32768 * ((∑ i ∈ Finset.range 14,
            2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b1 16384 : ℝ)) +
          ∑ i ∈ Finset.range 14,
            2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b2 16384 : ℝ)) =
      ∑ i ∈ Finset.range 14,
        (2 * (2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b1 16384 : ℝ) *
            ((iw14.getD i []).getD b2 16384 : ℝ) +
          268435456 * (2 * (fw.getD i 0 : ℝ))) -
        32768 * (2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b1 16384 : ℝ) +
          2 * (fw.getD i 0 : ℝ) * ((iw14.getD i []).getD b2 16384 : ℝ))) := by
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  rw [hsum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun c _ ↦ by ring

private lemma buildColsCipsi_eq {α : Type} :
    ∀ (rem b : ℕ) (iw14 : List (List ℕ)) (nrc2s : List ℕ)
      (accR accC : List (List ℕ)) (accS : List ℕ)
      (k : List (List ℕ) → List (List ℕ) → List ℕ → α),
      buildColsCipsi rem b iw14 nrc2s accR accC accS k =
        k (accR.reverse ++ (List.range rem).map (fun j ↦ getColGo (b + j) 14 iw14))
          (accC.reverse ++ (List.range rem).map
            (fun j ↦ List.zipWith Nat.mul nrc2s (getColGo (b + j) 14 iw14)))
          (accS.reverse ++ (List.range rem).map
            (fun j ↦ dotRaw nrc2s (getColGo (b + j) 14 iw14)))
  | 0, _, _, _, accR, accC, accS, k => by
    simp [buildColsCipsi, forceList_eq]
  | rem + 1, b, iw14, nrc2s, accR, accC, accS, k => by
    unfold buildColsCipsi
    simp only [forceList_eq, strictNatList_eq, strictNat_eq, Nat.add_eq]
    rw [buildColsCipsi_eq rem (b + 1)]
    congr 1
    · rw [List.reverse_cons, List.range_succ_eq_map, List.map_cons, List.map_map,
        Nat.add_zero, List.append_assoc, List.singleton_append]
      refine congrArg (accR.reverse ++ getColGo b 14 iw14 :: ·) (List.map_congr_left fun j _ ↦ ?_)
      change getColGo (b + 1 + j) 14 iw14 = getColGo (b + (j + 1)) 14 iw14
      rw [show b + 1 + j = b + (j + 1) by omega]
    · rw [List.reverse_cons, List.range_succ_eq_map, List.map_cons, List.map_map,
        Nat.add_zero, List.append_assoc, List.singleton_append]
      refine congrArg (accC.reverse ++ List.zipWith Nat.mul nrc2s (getColGo b 14 iw14) :: ·)
        (List.map_congr_left fun j _ ↦ ?_)
      change List.zipWith Nat.mul nrc2s (getColGo (b + 1 + j) 14 iw14) =
        List.zipWith Nat.mul nrc2s (getColGo (b + (j + 1)) 14 iw14)
      rw [show b + 1 + j = b + (j + 1) by omega]
    · rw [List.reverse_cons, List.range_succ_eq_map, List.map_cons, List.map_map,
        Nat.add_zero, List.append_assoc, List.singleton_append]
      refine congrArg (accS.reverse ++ dotRaw nrc2s (getColGo b 14 iw14) :: ·)
        (List.map_congr_left fun j _ ↦ ?_)
      change dotRaw nrc2s (getColGo (b + 1 + j) 14 iw14) =
        dotRaw nrc2s (getColGo (b + (j + 1)) 14 iw14)
      rw [show b + 1 + j = b + (j + 1) by omega]

private lemma rowExchCipsi_le {dw0P dw0N dw1P dw1N : List ℕ}
    (hl0P : dw0P.length = 58) (hl0N : dw0N.length = 58)
    (hl1P : dw1P.length = 58) (hl1N : dw1N.length = 58)
    (uFn : ℕ → Fin 58 → ℝ) (fw : List ℕ) (iw14 : List (List ℕ))
    (b1 : ℕ) {lf1 : LeafExchRec}
    (hlf1 : LeafExchValid dw0P dw0N dw1P dw1N lf1 (uFn b1)) :
    ∀ (bs : List ℕ) {ls : List LeafExchRec},
      List.Forall₂ (fun lf b ↦ LeafExchValid dw0P dw0N dw1P dw1N lf (uFn b)) ls bs →
      ∀ (posA negA : ℕ) (P : Bool → ℕ → ℕ → Prop),
        (∀ (ok : Bool) (p' n' : ℕ),
          (ok = true →
            (posA : ℝ) - (negA : ℝ) +
              ((bs.map fun b2 ↦
                2 * (zWeightReal fw iw14 b1 b2 *
                  pairValLists dw0P dw0N dw1P dw1N
                    (uFn b1) (uFn b2))).sum) * 10 ≤
              (p' : ℝ) - (n' : ℝ)) →
          P ok p' n') →
        rowExchCipsi lf1 (List.zipWith Nat.mul (getFw2Go 14 fw) (getColGo b1 14 iw14))
          (dotRaw (getFw2Go 14 fw) (getColGo b1 14 iw14)) (sumList (getFw2Go 14 fw))
          (sumList dw0P) (sumList dw0N) (sumList dw1P) (sumList dw1N)
          ls (bs.map fun b ↦ getColGo b 14 iw14)
          (bs.map fun b ↦ dotRaw (getFw2Go 14 fw) (getColGo b 14 iw14)) posA negA P
  | [], ls, hls, posA, negA, P, hk => by
    cases hls; exact hk true posA negA fun _ ↦ by simp
  | b2 :: bs, ls, hls, posA, negA, P, hk => by
    cases ls with
    | nil => cases hls
    | cons lf2 ls' =>
      cases hls with
      | cons hlf2 htl =>
        simp only [List.map_cons, rowExchCipsi]
        refine evalLeafPairFast_sound hl0P hl0N hl1P hl1N hlf1 hlf2 _
          fun ok pvl10 pvw10 hpv ↦ ?_
        cases ok with
        | false => exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true
        | true =>
          simp only [↓reduceIte, strictNat_eq]
          obtain ⟨hpv_lo, hpv_hi⟩ := hpv rfl
          have hpv_lo' : (pvl10 : ℝ) - ((450000000 : ℕ) : ℝ) ≤
              pairValLists dw0P dw0N dw1P dw1N (uFn b1) (uFn b2) * 10 :=
            by simpa using hpv_lo
          have hpv_hi' :
              pairValLists dw0P dw0N dw1P dw1N (uFn b1) (uFn b2) * 10 ≤
              (pvl10 : ℝ) + (pvw10 : ℝ) - ((450000000 : ℕ) : ℝ) :=
            by simpa using hpv_hi
          refine accSignedIv_le hpv_lo' hpv_hi' _ fun p1 n1 hp1 ↦ ?_
          refine rowExchCipsi_le hl0P hl0N hl1P hl1N uFn fw iw14 b1 hlf1 bs htl p1 n1 P
            fun ok2 p2 n2 hp2 ↦ hk ok2 p2 n2 fun hok2 ↦ ?_
          have hr := hp2 hok2
          rw [zOffDiag_eq_two_zWeightReal] at hp1
          simp only [List.map_cons, List.sum_cons, add_mul]
          linarith

private lemma rowExchCipsi_comp {α β : Type} (f : α → β) (lf1 : LeafExchRec) (sc1 : List ℕ)
    (cs1 sum2Nrc s0P s0N s1P s1N : ℕ) :
    ∀ (ls : List LeafExchRec) (raws : List (List ℕ)) (css : List ℕ) (posA negA : ℕ)
      (k : Bool → ℕ → ℕ → α),
      rowExchCipsi lf1 sc1 cs1 sum2Nrc s0P s0N s1P s1N ls raws css posA negA
        (fun a b c ↦ f (k a b c)) =
      f (rowExchCipsi lf1 sc1 cs1 sum2Nrc s0P s0N s1P s1N ls raws css posA negA k)
  | [], _, _, _, _, _ => rfl
  | _ :: _, [], _, _, _, _ => rfl
  | _ :: _, _ :: _, [], _, _, _ => rfl
  | lf2 :: ls, _ :: raws, _ :: css, posA, negA, k => by
    unfold rowExchCipsi
    rw [← evalLeafPairFast_comp f]
    refine cps3_congr _ fun ok pvl10 pvw10 ↦ ?_
    split_ifs
    · simp only [strictNat_eq]
      simp_rw [rowExchCipsi_comp f _ _ _ _ _ _ _ _ ls raws css, accSignedIv_comp f]
    · rfl

private lemma blockExchCipsi_le {dw0P dw0N dw1P dw1N : List ℕ}
    (hl0P : dw0P.length = 58) (hl0N : dw0N.length = 58)
    (hl1P : dw1P.length = 58) (hl1N : dw1N.length = 58)
    (uFn : ℕ → Fin 58 → ℝ) (fw : List ℕ) (iw14 : List (List ℕ)) :
    ∀ (bs : List ℕ) {ls : List LeafExchRec},
      List.Forall₂ (fun lf b ↦ LeafExchValid dw0P dw0N dw1P dw1N lf (uFn b)) ls bs →
      ∀ (posA negA : ℕ) (P : Bool → ℕ → ℕ → Prop),
        (∀ (ok : Bool) (p' n' : ℕ),
          (ok = true →
            (posA : ℝ) - (negA : ℝ) +
              symmQuadSum
                (fun b1 b2 ↦ zWeightReal fw iw14 b1 b2 *
                  pairValLists dw0P dw0N dw1P dw1N (uFn b1) (uFn b2))
                bs * 10 ≤
              (p' : ℝ) - (n' : ℝ)) →
          P ok p' n') →
        blockExchCipsi (sumList (getFw2Go 14 fw))
          (sumList dw0P) (sumList dw0N) (sumList dw1P) (sumList dw1N)
          ls (bs.map fun b ↦ getColGo b 14 iw14)
          (bs.map fun b ↦ List.zipWith Nat.mul (getFw2Go 14 fw) (getColGo b 14 iw14))
          (bs.map fun b ↦ dotRaw (getFw2Go 14 fw) (getColGo b 14 iw14)) posA negA P
  | [], ls, hls, posA, negA, P, hk => by
    cases hls; exact hk true posA negA fun _ ↦ by simp [symmQuadSum]
  | b1 :: bs, ls, hls, posA, negA, P, hk => by
    cases ls with
    | nil => cases hls
    | cons lf1 ls' =>
      cases hls with
      | cons hlf1 htl =>
        simp only [List.map_cons, blockExchCipsi]
        refine evalLeafPairFast_sound hl0P hl0N hl1P hl1N hlf1 hlf1 _
          fun ok pvl10 pvw10 hpv ↦ ?_
        cases ok with
        | false => exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true
        | true =>
          simp only [↓reduceIte, strictNat_eq]
          obtain ⟨hpv_lo, hpv_hi⟩ := hpv rfl
          have hpv_lo' : (pvl10 : ℝ) - ((450000000 : ℕ) : ℝ) ≤
              pairValLists dw0P dw0N dw1P dw1N (uFn b1) (uFn b1) * 10 :=
            by simpa using hpv_lo
          have hpv_hi' :
              pairValLists dw0P dw0N dw1P dw1N (uFn b1) (uFn b1) * 10 ≤
              (pvl10 : ℝ) + (pvw10 : ℝ) - ((450000000 : ℕ) : ℝ) :=
            by simpa using hpv_hi
          refine accSignedIv_le hpv_lo' hpv_hi' _ fun p1 n1 hp1 ↦ ?_
          refine rowExchCipsi_le hl0P hl0N hl1P hl1N uFn fw iw14 b1 hlf1 bs htl p1 n1 _
            fun okR p2 n2 hp2 ↦ ?_
          cases okR with
          | false => exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true
          | true =>
            simp only [↓reduceIte]
            have hr2 := hp2 rfl
            refine blockExchCipsi_le hl0P hl0N hl1P hl1N uFn fw iw14 bs htl p2 n2 P
              fun ok3 p3 n3 hp3 ↦ hk ok3 p3 n3 fun hok3 ↦ ?_
            have hr3 := hp3 hok3
            rw [zDiag_eq_zWeightReal] at hp1
            simp only [symmQuadSum]
            linarith

private lemma blockExchCipsi_comp {α β : Type} (f : α → β) (sum2Nrc s0P s0N s1P s1N : ℕ) :
    ∀ (ls : List LeafExchRec) (raws scs : List (List ℕ)) (css : List ℕ) (posA negA : ℕ)
      (k : Bool → ℕ → ℕ → α),
      blockExchCipsi sum2Nrc s0P s0N s1P s1N ls raws scs css posA negA
        (fun a b c ↦ f (k a b c)) =
      f (blockExchCipsi sum2Nrc s0P s0N s1P s1N ls raws scs css posA negA k)
  | [], _, _, _, _, _, _ => rfl
  | _ :: _, [], _, _, _, _, _ => rfl
  | _ :: _, _ :: _, [], _, _, _, _ => rfl
  | _ :: _, _ :: _, _ :: _, [], _, _, _ => rfl
  | lf1 :: ls, _ :: raws, _ :: scs, _ :: css, posA, negA, k => by
    unfold blockExchCipsi
    rw [← evalLeafPairFast_comp f]
    refine cps3_congr _ fun ok pvl10 pvw10 ↦ ?_
    split_ifs
    · simp only [strictNat_eq]
      rw [← accSignedIv_comp f]
      refine cps2_congr _ fun p1 n1 ↦ ?_
      rw [← rowExchCipsi_comp f]
      refine cps3_congr _ fun okR p2 n2 ↦ ?_
      split_ifs
      · exact blockExchCipsi_comp f _ _ _ _ _ ls raws scs css p2 n2 k
      · rfl
    · rfl

