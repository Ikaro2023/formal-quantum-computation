lemma oneIw_innerInt (r : Fin 9) (c : Fin 14) (b : ℕ) :
    (((bvRow innerWeights ⟨min (14 * r.val + c.val) 125, by omega⟩).getD b 16384 : ℝ) -
      16384) = (deepInnerInt r c b : ℝ) := by
