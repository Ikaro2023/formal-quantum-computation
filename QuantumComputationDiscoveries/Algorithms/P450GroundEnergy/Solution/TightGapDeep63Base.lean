/-- Internal CIPSI certificate helper `SymDiff5`. -/
inductive SymDiff5 : Type
  /-- Constructor `lt4` of `SymDiff5`. -/
  | lt4 : SymDiff5
  /-- Constructor `eq4` of `SymDiff5`. -/
  | eq4 : ℕ → ℕ → ℕ → ℕ → SymDiff5
  /-- Constructor `gt4` of `SymDiff5`. -/
