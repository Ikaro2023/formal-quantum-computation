def normPN {α : Type} (p n : ℕ) (k : ℕ → ℕ → α) : α :=
  if Nat.ble n p then strictNat (Nat.sub p n) fun d ↦ k d 0
  else strictNat (Nat.sub n p) fun d ↦ k 0 d

/-- Internal CIPSI certificate helper `accSignedIv`. -/
def accSignedIv {α : Type} (posA negA wPos wNeg off lo w : ℕ) (k : ℕ → ℕ → α) : α :=
  strictNat (Nat.add lo w) fun hi ↦
  if Nat.ble wNeg wPos then
    strictNat (Nat.sub wPos wNeg) fun wm ↦
    if Nat.ble off hi then
      strictNat (Nat.add posA (Nat.mul wm (Nat.sub hi off))) fun p' ↦ normPN p' negA k
    else
      strictNat (Nat.add negA (Nat.mul wm (Nat.sub off hi))) fun n' ↦ normPN posA n' k
  else
    strictNat (Nat.sub wNeg wPos) fun wm ↦
    if Nat.ble lo off then
      strictNat (Nat.add posA (Nat.mul wm (Nat.sub off lo))) fun p' ↦ normPN p' negA k
    else
      strictNat (Nat.add negA (Nat.mul wm (Nat.sub lo off))) fun n' ↦ normPN posA n' k


