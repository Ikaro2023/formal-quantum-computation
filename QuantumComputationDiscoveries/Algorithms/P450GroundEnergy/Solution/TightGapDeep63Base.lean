/-- Internal Deep certificate helper `consStrict`. -/
def consStrict (x : ℕ) (xs : List ℕ) : List ℕ :=
  Nat.casesOn x (0 :: xs) (fun m ↦ Nat.add m 1 :: xs)

/-- Internal Deep certificate helper `revStrict`. -/
def revStrict : List ℕ → List ℕ → List ℕ
  | [], acc => acc
  | x :: xs, acc => revStrict xs (consStrict x acc)

/-- Internal Deep certificate helper `addQuadTreeOpt`. -/
def addQuadTreeOpt (qk cP cN : ℕ) : QuadAccTree → OptQTree
  | .empty => .none
  | .node l nk p m r =>
    bif Nat.beq qk nk then
      Nat.casesOn (Nat.add p cP)
        (Nat.casesOn (Nat.add m cN) (.some (.node l nk 0 0 r))
          (fun mn ↦ .some (.node l nk 0 (Nat.add mn 1) r)))
        (fun mp ↦
          let p' := Nat.add mp 1
          Nat.casesOn (Nat.add m cN) (.some (.node l nk p' 0 r))
            (fun mn ↦ .some (.node l nk p' (Nat.add mn 1) r)))
    else bif Nat.blt qk nk then
      match addQuadTreeOpt qk cP cN l with
      | .none => .none
      | .some l' => .some (.node l' nk p m r)
    else
      match addQuadTreeOpt qk cP cN r with
      | .none => .none
      | .some r' => .some (.node l nk p m r')

/-- Internal Deep certificate helper `lookupKeyIvOpt`. -/
def lookupKeyIvOpt : KeyIvTree → ℕ → OptIv
  | .empty, _ => .none
  | .node l nk lo w r, qk =>
    bif Nat.beq qk nk then .some lo w
    else bif Nat.blt qk nk then lookupKeyIvOpt l qk
    else lookupKeyIvOpt r qk


/-- Internal Deep certificate helper `unpackWordsAux`. -/
def unpackWordsAux (w : ℕ) : ℕ → ℕ → ℕ → List ℕ
  | _, 0, _ => []
  | _, 1, x => [x % (2 ^ w)]
  | 0, _, _ => []
  | fuel + 1, len, x =>
      let half := len / 2
      let k := half * w
      let hi := x >>> k
      let lo := x - (hi <<< k)
      unpackWordsAux w fuel half lo ++ unpackWordsAux w fuel (len - half) hi

private theorem shift_sub_eq_mod (x k : ℕ) : x - ((x >>> k) <<< k) = x % (2 ^ k) := by
  rw [Nat.shiftRight_eq_div_pow, Nat.shiftLeft_eq, Nat.mul_comm (x / 2 ^ k), Nat.mod_def]

private theorem mod_high_div_mod (x w half i : ℕ) (hi : i < half) :
    (x % (2 ^ (half * w))) / (2 ^ (i * w)) % (2 ^ w) = x / (2 ^ (i * w)) % (2 ^ w) := by
  have hsplit : half * w = i * w + (w + (half - 1 - i) * w) := by
    have h1 : half = i + 1 + (half - 1 - i) := by omega
    calc half * w = (i + 1 + (half - 1 - i)) * w := by rw [← h1]
      _ = i * w + (w + (half - 1 - i) * w) := by ring
  have hpow : 2 ^ (half * w) = 2 ^ (i * w) * (2 ^ w * 2 ^ ((half - 1 - i) * w)) := by
    rw [hsplit, Nat.pow_add, Nat.pow_add]
  have hdiv_eq : x / 2 ^ (i * w) =
      x % 2 ^ (half * w) / 2 ^ (i * w) +
        (2 ^ w * 2 ^ ((half - 1 - i) * w)) * (x / 2 ^ (half * w)) := by
    conv_lhs => rw [← Nat.div_add_mod x (2 ^ (half * w)), hpow]
    rw [Nat.mul_assoc (2 ^ (i * w)), Nat.add_comm _ (x % _),
      Nat.add_mul_div_left _ _ (Nat.two_pow_pos (i * w)), ← hpow]
  rw [hdiv_eq, Nat.mul_assoc (2 ^ w), Nat.add_mul_mod_self_left]

private theorem unpackWordsAux_eq (w : ℕ) :
    ∀ (fuel len x : ℕ), len ≤ 2 ^ fuel →
      unpackWordsAux w fuel len x =
        (List.range len).map (fun i ↦ (x / 2 ^ (i * w)) % 2 ^ w)
  | 0, 0, _, _ => rfl
  | _ + 1, 0, _, _ => rfl
  | 0, 1, _, _ => by simp [unpackWordsAux]
  | _ + 1, 1, _, _ => by simp [unpackWordsAux]
  | 0, _ + 2, _, hle => by simp at hle
  | fuel + 1, len + 2, x, hle => by
      have hpow : 2 ^ (fuel + 1) = 2 ^ fuel + 2 ^ fuel := by ring
      simp only [unpackWordsAux, shift_sub_eq_mod]
      set n := len + 2
      rw [unpackWordsAux_eq w fuel (n / 2) _ (by omega),
        unpackWordsAux_eq w fuel (n - n / 2) _ (by omega)]
      refine List.ext_getElem (by simp; omega) fun i h1 h2 ↦ ?_
      simp only [List.getElem_map, List.getElem_range]
      by_cases hi : i < n / 2
      · rw [List.getElem_append_left (by simp [hi])]
        simp only [List.getElem_map, List.getElem_range]
        exact mod_high_div_mod x w (n / 2) i hi
      · have hge : ((List.range (n / 2)).map
            (fun j ↦ (x % 2 ^ (n / 2 * w)) / 2 ^ (j * w) % 2 ^ w)).length ≤ i := by
          simp only [List.length_map, List.length_range]; omega
        rw [List.getElem_append_right hge]
        simp only [List.length_map, List.length_range, List.getElem_map, List.getElem_range,
          Nat.shiftRight_eq_div_pow, Nat.div_div_eq_div_mul, ← Nat.pow_add]
        have hadd : n / 2 * w + (i - n / 2) * w = i * w := by
          calc n / 2 * w + (i - n / 2) * w = (n / 2 + (i - n / 2)) * w := by ring
            _ = i * w := by rw [Nat.add_sub_of_le (by omega)]
        rw [hadd]

/-- Internal Deep certificate helper `bvRow`. -/
def bvRow {m n w : ℕ} (bv : BitVec (m * n * w)) (i : Fin m) : List ℕ :=
  let s := bv.toNat >>> (i.val * n * w)
  unpackWordsAux w n n (s - ((s >>> (n * w)) <<< (n * w)))

/-- Internal Deep certificate helper `bvSlice`. -/
def bvSlice {m n w : ℕ} (bv : BitVec (m * n * w)) (start count : ℕ) : List (List ℕ) :=
  (((List.finRange m).drop start).take count).map (bvRow bv)

/-- Internal Deep certificate helper `bvVec`. -/
def bvVec {n w : ℕ} (bv : BitVec (n * w)) : List ℕ :=
  unpackWordsAux w n n bv.toNat

private lemma bvRow_getD {m n w : ℕ} (bv : BitVec (m * n * w)) (i : Fin m) (j d : ℕ) :
    (bvRow bv i).getD j d = if h : j < n then (bv.getChunk₂ i ⟨j, h⟩).toNat else d := by
  have hle : n ≤ 2 ^ n := Nat.le_of_lt n.lt_two_pow_self
  unfold bvRow; dsimp only
  simp only [shift_sub_eq_mod, unpackWordsAux_eq w n n _ hle]
  split_ifs with h
  · rw [list_getD_eq_getElem _ d (by simp [h]), List.getElem_map, List.getElem_range,
      mod_high_div_mod _ w n j h]
    simp only [BitVec.getChunk₂, BitVec.extractLsb', BitVec.toNat_ofNat,
      Nat.shiftRight_eq_div_pow, Nat.div_div_eq_div_mul, ← Nat.pow_add, Nat.add_mul]
  · exact list_getD_eq_default _ d (by simp; omega)

private lemma bvSlice_getD {m n w : ℕ} (bv : BitVec (m * n * w)) {s cnt idx : ℕ}
    (hi : idx < cnt) (hlt : s + idx < m) :
    (bvSlice bv s cnt).getD idx [] = bvRow bv ⟨s + idx, hlt⟩ := by
  unfold bvSlice
  rw [list_getD_eq_getElem _ [] (by simp; omega), List.getElem_map,
    List.getElem_take, List.getElem_drop, List.getElem_finRange]
  rfl

lemma bvVec_getD {n w : ℕ} (bv : BitVec (n * w)) (i : Fin n) (d : ℕ) :
    (bvVec bv).getD i.val d = (bv.getChunk i).toNat := by
  have hle : n ≤ 2 ^ n := Nat.le_of_lt n.lt_two_pow_self
  unfold bvVec
  rw [unpackWordsAux_eq w n n bv.toNat hle,
    list_getD_eq_getElem _ d (by simp [i.isLt]), List.getElem_map, List.getElem_range]
  simp only [BitVec.getChunk, BitVec.extractLsb', BitVec.toNat_ofNat, Nat.shiftRight_eq_div_pow]

private lemma list_take_add_drop {α : Type*} :
    ∀ (a b : ℕ) (xs : List α), xs.take (a + b) = xs.take a ++ (xs.drop a).take b
  | 0, _, _ => by simp
  | _ + 1, _, [] => by simp
  | a + 1, b, x :: xs => by
    rw [Nat.succ_add, List.take_succ_cons, List.take_succ_cons, List.drop_succ_cons,
      List.cons_append, list_take_add_drop a b xs]

private lemma bvSlice_add {m n w : ℕ} (bv : BitVec (m * n * w)) (s a b : ℕ) :
    bvSlice bv s (a + b) = bvSlice bv s a ++ bvSlice bv (s + a) b := by
  unfold bvSlice
  rw [list_take_add_drop, List.map_append, List.drop_drop]

private lemma bvSlice_length {m n w : ℕ} (bv : BitVec (m * n * w)) {s a : ℕ} (h : s + a ≤ m) :
    (bvSlice bv s a).length = a := by
  unfold bvSlice; simp; omega

/-- Internal Deep helper `deepInnerInt`. -/
def deepInnerInt (r : Fin 9) (c : Fin 14) (bIdx : ℕ) : ℤ :=
  if hb : bIdx < 30 then
    fromOffset (innerWeights.getChunk₂ ⟨14 * r.val + c.val, by omega⟩ ⟨bIdx, hb⟩).toNat
  else 0

/-- Internal Deep helper `deepInnerShiftInt`. -/
def deepInnerShiftInt (r : Fin 9) (c : Fin 14) : ℤ :=
  deepInnerInt r c 29 - ∑ b_idx : Fin 29, deepInnerInt r c b_idx.val

/-- Internal Deep helper `deepFragOuterNat`. -/
def deepFragOuterNat (r : Fin 9) (c : Fin 14) : ℕ :=
  (fragmentWeights.getChunk₂ r c).toNat

private lemma deep_fragmentVector_leafEquiv (r : Fin 9) (c : Fin 14) (r' : Fin 9)
    (b_idx : Fin 29) :
    fragmentVector r c (leafEquiv (r', b_idx)) =
      if r' = r then weight r c b_idx.castSucc else 0 := by
  unfold fragmentVector leafEquiv
  dsimp only [Equiv.coe_fn_mk]
  have hdiv : (29 * r'.val + b_idx.val) / 29 = r'.val := by omega
  have hmod : (29 * r'.val + b_idx.val) % 29 = b_idx.val := by omega
  by_cases hrr : r' = r
  · subst hrr
    simp only [hdiv, ↓reduceIte]
    exact congrArg (weight r' c) (Fin.ext hmod)
  · have hval : (29 * r'.val + b_idx.val) / 29 ≠ r.val := by omega
    simp [hrr, hval]

lemma deep_weight_mul_weight (r : Fin 9) (c : Fin 14) (b₁ b₂ : Fin 30) :
    weight r c b₁ * weight r c b₂ =
      ((deepInnerInt r c b₁.val * deepInnerInt r c b₂.val : ℤ) : ℝ) *
        (4 * (deepFragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) := by
  have hpos : 0 ≤ 4 * (deepFragOuterNat r c : ℝ) * coefficientUnit := by
    unfold coefficientUnit deepFragOuterNat; positivity
  have hw (b : Fin 30) : weight r c b =
      (deepInnerInt r c b.val : ℝ) * √(4 * (deepFragOuterNat r c : ℝ) * coefficientUnit) /
        15360 := by
    unfold weight deepInnerInt deepFragOuterNat
    simp only [b.isLt, ↓reduceDIte]
  rw [hw b₁, hw b₂]
  set x : ℝ := 4 * (deepFragOuterNat r c : ℝ) * coefficientUnit
  have hsq : √x * √x = x := Real.mul_self_sqrt hpos
  push_cast
  calc
    (deepInnerInt r c b₁.val : ℝ) * √x / 15360 *
        ((deepInnerInt r c b₂.val : ℝ) * √x / 15360)
      = (deepInnerInt r c b₁.val : ℝ) * (deepInnerInt r c b₂.val : ℝ) * (√x * √x) /
          (15360 ^ 2 : ℝ) := by ring
    _ = _ := by rw [hsq]

private lemma deep_fragmentShift_mul_weight (r : Fin 9) (c : Fin 14) (b_idx : Fin 29) :
    fragmentShift r c * weight r c b_idx.castSucc =
      ((deepInnerShiftInt r c * deepInnerInt r c b_idx.val : ℤ) : ℝ) *
        (4 * (deepFragOuterNat r c : ℝ) * coefficientUnit) / (15360 ^ 2 : ℝ) := by
  rw [fragmentShift, sub_mul, Finset.sum_mul, deep_weight_mul_weight]
  simp_rw [deep_weight_mul_weight]
  rw [← Finset.sum_div, ← Finset.sum_mul]
  have h29 : ((29 : Fin 30).val : ℕ) = 29 := rfl
  have hcs (x : Fin 29) : x.castSucc.val = x.val := rfl
  simp only [h29, hcs]
  have hsum : (∑ x : Fin 29, ((deepInnerInt r c x.val * deepInnerInt r c b_idx.val : ℤ) : ℝ)) =
      (∑ x : Fin 29, (deepInnerInt r c x.val : ℝ)) * (deepInnerInt r c b_idx.val : ℝ) := by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun _ _ ↦ by push_cast; ring
  rw [hsum]
  unfold deepInnerShiftInt
  push_cast; ring

lemma deep_sum_leafEquiv_fragmentVector (r : Fin 9) (c : Fin 14) (f : Fin 261 → ℝ) :
    ∑ μ : Fin 261, fragmentVector r c μ * f μ =
      ∑ b_idx : Fin 29, weight r c b_idx.castSucc * f (leafEquiv (r, b_idx)) := by
  rw [← leafEquiv.sum_comp, Fintype.sum_prod_type]
  simp_rw [deep_fragmentVector_leafEquiv]
  have hrow (r' : Fin 9) :
      (∑ b_idx : Fin 29, (if r' = r then weight r c b_idx.castSucc else 0) *
        f (leafEquiv (r', b_idx))) =
      if r' = r then ∑ b_idx : Fin 29, weight r c b_idx.castSucc * f (leafEquiv (r, b_idx))
      else 0 := by
    by_cases hrr : r' = r
    · subst hrr; simp
    · simp [hrr]
  simp_rw [hrow]
  simp


lemma fwRow_fragOuterNat (r : Fin 9) (c : Fin 14) :
    (bvRow fragmentWeights ⟨min r.val 8, by omega⟩).getD c.val 0 = deepFragOuterNat r c := by
  have hfin : (⟨min r.val 8, by omega⟩ : Fin 9) = r := Fin.ext (Nat.min_eq_left (by omega))
  rw [hfin, bvRow_getD]
  simp [c.isLt, deepFragOuterNat]

lemma blkIw_innerInt (r : Fin 9) (c : Fin 14) (b : ℕ) :
    ((((bvSlice innerWeights (14 * r.val) 14).getD c.val []).getD b 16384 : ℝ) - 16384) =
      (deepInnerInt r c b : ℝ) := by
