          linarith
        · simp only [Bool.not_eq_true] at h123
          simp only [h123, Bool.false_eq_true, ↓reduceIte]
          exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true
      · simp only [Bool.not_eq_true] at hok1
        refine evalTermCPS_any _ _ _ _ _ _ fun ok2 _ _ ↦ ?_
