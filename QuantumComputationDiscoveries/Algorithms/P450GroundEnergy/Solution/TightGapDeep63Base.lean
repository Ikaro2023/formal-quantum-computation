private lemma listLenGo_eq {α : Type} :
    ∀ (xs : List α) (acc : ℕ), listLenGo xs acc = acc + xs.length
  | [], acc => by simp [listLenGo]
  | _ :: xs, acc => by
    simp only [listLenGo, Nat.add_eq, listLenGo_eq xs, List.length_cons]
    omega

lemma list_eq_map_getD_of_length {α : Type*} (d : α) :
    ∀ (xs : List α), xs = (List.range xs.length).map (xs.getD · d)
  | [] => rfl
  | x :: xs => by
    rw [List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_map]
    simp only [List.getD_cons_zero]
    have htl : List.map ((fun i ↦ (x :: xs).getD i d) ∘ Nat.succ) (List.range xs.length) =
        List.map (xs.getD · d) (List.range xs.length) :=
      List.map_congr_left fun _ _ ↦ List.getD_cons_succ
    rw [htl]
    exact congrArg (x :: ·) (list_eq_map_getD_of_length d xs)


lemma nat_cases_id {α : Type*} (n : ℕ) (f : ℕ → α) :
    Nat.casesOn n (f 0) (fun m ↦ f (Nat.add m 1)) = f n := by
  cases n <;> rfl

lemma consStrict_eq (x : ℕ) (xs : List ℕ) : consStrict x xs = x :: xs := by
  cases x <;> rfl

lemma revStrict_eq : ∀ (xs acc : List ℕ), revStrict xs acc = xs.reverse ++ acc
  | [], acc => rfl
  | x :: xs, acc => by
    simp only [revStrict, consStrict_eq, List.reverse_cons, List.append_assoc,
      List.singleton_append]
    exact revStrict_eq xs (x :: acc)

lemma getOrbColOpt_eq :
    ∀ (rs : List (List ℕ)) (p : ℕ) (acc : List ℕ),
      getOrbColOpt rs p acc = .some (acc.reverse ++ rs.map (fun r ↦ r.getD p 0))
  | [], _, acc => by simp [getOrbColOpt, revStrict_eq]
  | r :: rs, p, acc => by
    simp only [getOrbColOpt, consStrict_eq, getOrbColOpt_eq rs p, List.reverse_cons,
      List.append_assoc, List.singleton_append, List.map_cons]

/-- Internal Deep helper `OrbColValid`. -/
def OrbColValid (uFn : ℕ → Fin 58 → ℝ) (p : ℕ) (col : List ℕ) : Prop :=
  ∃ hp : p < 58, List.Forall₂ (fun x b ↦ ValidOrb5e8 x (uFn b ⟨p, hp⟩)) col (List.range 29)

/-- Internal Deep helper `OrbColTreeSound`. -/
def OrbColTreeSound (uFn : ℕ → Fin 58 → ℝ) : OrbColTree → Prop
  | .empty => True
  | .node l idx col r =>
    OrbColValid uFn idx col ∧ OrbColTreeSound uFn l ∧ OrbColTreeSound uFn r

lemma map_getD_orbColValid {uFn : ℕ → Fin 58 → ℝ} {rows : List (List ℕ)}
    (hlen : rows.length = 29)
    (hrows : ∀ b < 29, List.Forall₂ ValidOrb5e8 (rows.getD b []) (List.ofFn (uFn b)))
    {p : ℕ} (hp : p < 58) :
    OrbColValid uFn p (rows.map fun r ↦ r.getD p 0) := by
  refine ⟨hp, List.forall₂_iff_get.mpr ⟨by simp [hlen], fun b hb1 hb2 ↦ ?_⟩⟩
  simp only [List.length_range] at hb2
  simp only [List.get_eq_getElem, List.getElem_map, List.getElem_range]
  have hget : rows[b]'(hlen ▸ hb2) = rows.getD b [] :=
    (list_getD_eq_getElem rows [] (hlen ▸ hb2)).symm
  rw [hget]
  have hv := forall2_getD (hrows b hb2) 0 0 (by simpa using hp)
  rwa [ofFn_getD_fin (uFn b) ⟨p, hp⟩] at hv

lemma buildOrbColTree_sound {uFn : ℕ → Fin 58 → ℝ} {rows : List (List ℕ)}
    (hlen : rows.length = 29)
    (hrows : ∀ b < 29, List.Forall₂ ValidOrb5e8 (rows.getD b []) (List.ofFn (uFn b))) :
    ∀ (fuel baseP len : ℕ), baseP + len ≤ 58 →
      OrbColTreeSound uFn (buildOrbColTree fuel baseP len rows)
  | 0, _, _, _ => trivial
  | _ + 1, _, 0, _ => trivial
  | fuel + 1, baseP, len + 1, hbd => by
    simp only [buildOrbColTree, getOrbColOpt_eq, List.reverse_nil, List.nil_append,
      Nat.add_eq, Nat.sub_eq, nat_div_def]
    have hmid : baseP + (len + 1) / 2 < 58 := by omega
    refine ⟨map_getD_orbColValid hlen hrows hmid,
      buildOrbColTree_sound hlen hrows fuel baseP ((len + 1) / 2) (by omega),
      buildOrbColTree_sound hlen hrows fuel (baseP + (len + 1) / 2 + 1)
        (len + 1 - 1 - (len + 1) / 2) (by omega)⟩

private lemma lookupOrbCol_sound {uFn : ℕ → Fin 58 → ℝ} :
    ∀ {t : OrbColTree}, OrbColTreeSound uFn t → ∀ {q : ℕ} {col : List ℕ},
      lookupOrbCol t q = .some col → OrbColValid uFn q col
  | .empty, _, _, _, h => by cases h
  | .node l idx col0 r, ht, q, col, h => by
    unfold lookupOrbCol at h
    by_cases h1 : Nat.beq q idx = true
    · simp only [h1, Bool.cond_true] at h
      cases h
      have hq : q = idx := Nat.beq_eq.mp h1
      subst hq; exact ht.1
    · simp only [Bool.eq_false_iff.mpr h1, Bool.cond_false] at h
      by_cases h2 : Nat.blt q idx = true
      · simp only [h2, Bool.cond_true] at h
        exact lookupOrbCol_sound ht.2.1 h
      · simp only [Bool.eq_false_iff.mpr h2, Bool.cond_false] at h
        exact lookupOrbCol_sound ht.2.2 h

/-- Internal Deep helper `GVecElemValid`. -/
def GVecElemValid (uVec : Fin 58 → ℝ) (p q : Fin 58) (glo : ℕ) : Prop :=
  (glo : ℝ) - (gpOffHi : ℝ) ≤ uVec p * uVec q * 1000000000 ∧
  uVec p * uVec q * 1000000000 ≤ (glo : ℝ) + 18 - (gpOffHi : ℝ)

private lemma buildOneGVecCPS_step {uVec : Fin 58 → ℝ} {p q : Fin 58} {up vq : ℕ}
    (hup : ValidOrb5e8 up (uVec p)) (hvq : ValidOrb5e8 vq (uVec q))
    (hneg_le : errHi + cOffHi * (up + vq) ≤ gcAddHi + up * vq) :
    GVecElemValid uVec p q
      ((gcAddHi + up * vq - (errHi + cOffHi * (up + vq))) / 250000000) := by
  obtain ⟨herr_lo, herr_hi⟩ := abs_le.mp (orb5e8_prod_err hup hvq)
  set pos := gcAddHi + up * vq
  set neg := errHi + cOffHi * (up + vq)
  set glo := (pos - neg) / 250000000
  set prodR := uVec p * uVec q * 1000000000
  have hsc : (uVec p * (cScaleHi : ℝ)) * (uVec q * (cScaleHi : ℝ)) = prodR * 250000000 := by
    simp only [prodR, cScaleHi, Nat.cast_ofNat]; ring
  have hpn : (pos : ℝ) - (neg : ℝ) =
      ((up : ℝ) - (cOffHi : ℝ)) * ((vq : ℝ) - (cOffHi : ℝ)) - (errHi : ℝ) +
        (gpOffHi : ℝ) * 250000000 := by
    simp only [pos, neg, gcAddHi_eq, cOffHi_eq, gpOffHi_eq, errHi_eq]; push_cast; ring
  rw [hsc] at herr_lo herr_hi
  refine ⟨?_, ?_⟩
  · have hf := nat_div_le_real (n := pos - neg) (d := 250000000)
    rw [Nat.cast_sub hneg_le, hpn] at hf; linarith
  · have hmod := Nat.div_add_mod (pos - neg) 250000000
    have hlt := Nat.mod_lt (pos - neg) (by decide : 0 < 250000000)
    have hcomm : 250000000 * glo = glo * 250000000 := Nat.mul_comm _ _
    have hnat : pos - neg ≤ glo * 250000000 + 249999999 := by omega
    have hR : ((pos - neg : ℕ) : ℝ) ≤ (glo : ℝ) * 250000000 + 249999999 := by exact_mod_cast hnat
    rw [Nat.cast_sub hneg_le, hpn] at hR
    simp only [errHi_eq, Nat.cast_ofNat] at herr_hi hR; linarith


/-- Internal Deep helper `KeyGEntryValid`. -/
def KeyGEntryValid (uFn : ℕ → Fin 58 → ℝ) (entry : ℕ × List ℕ × ℕ) : Prop :=
  ∃ (hp : entry.1 / 64 < 58) (hq : entry.1 % 64 < 58),
    List.Forall₂ (fun glo b ↦
      GVecElemValid (uFn b) ⟨entry.1 / 64, hp⟩ ⟨entry.1 % 64, hq⟩ glo)
      entry.2.1 (List.range 29) ∧
    entry.2.2 = sumList entry.2.1

/-- Internal Deep helper `DiagGEntryValid`. -/
def DiagGEntryValid (uFn : ℕ → Fin 58 → ℝ) (p : ℕ) (entry : ℕ × List ℕ × ℕ) : Prop :=
  ∃ (hp : p < 58),
    List.Forall₂ (fun glo b ↦
      GVecElemValid (uFn b) ⟨p, hp⟩ ⟨p, hp⟩ glo)
      entry.2.1 (List.range 29) ∧
    entry.2.2 = sumList entry.2.1

lemma sumList_append : ∀ (xs ys : List ℕ),
    sumList (List.append xs ys) = sumList xs + sumList ys
  | [], ys => by change sumList ys = sumList [] + sumList ys; rw [sumList_nil, zero_add]
  | x :: xs, ys => by
    change sumList (x :: List.append xs ys) = sumList (x :: xs) + sumList ys
    rw [sumList_cons, sumList_cons, sumList_append xs ys]; simp only [Nat.add_eq]; omega

private lemma sumList_reverse : ∀ (xs : List ℕ), sumList xs.reverse = sumList xs
  | [] => rfl
  | x :: xs => by
    rw [List.reverse_cons, ← List.append_eq, sumList_append, sumList_reverse xs,
      sumList_cons, sumList_cons, sumList_nil]; simp only [Nat.add_eq]; omega

lemma forall2_append_assoc {α β : Type*} {R : α → β → Prop}
    {xs : List α} {a b c : List β} (h : List.Forall₂ R xs ((a ++ b) ++ c)) :
    List.Forall₂ R xs (a ++ (b ++ c)) := by
  rwa [List.append_assoc] at h

private lemma zipGVecOpt_step_aux (b : Bool) (d sAcc : ℕ) (ups vqs acc : List ℕ) :
    (bif b then
      Nat.casesOn d
        (zipGVecOpt ups vqs (0 :: acc) sAcc)
        (fun m ↦
          Nat.casesOn (Nat.add sAcc (Nat.add m 1))
            (zipGVecOpt ups vqs (Nat.add m 1 :: acc) 0)
            (fun ms ↦ zipGVecOpt ups vqs (Nat.add m 1 :: acc) (Nat.add ms 1)))
    else OptGEntry.none) =
    (bif b then zipGVecOpt ups vqs (d :: acc) (Nat.add sAcc d) else OptGEntry.none) := by
  cases b
  · rfl
  · cases d with
    | zero => rfl
    | succ m =>
      exact nat_cases_id (Nat.add sAcc (Nat.add m 1))
        (fun k ↦ zipGVecOpt ups vqs (Nat.add m 1 :: acc) k)

private lemma bif_optGEntry_some {c : Bool} {x : OptGEntry} {gb : List ℕ} {sGb : ℕ}
    (h : (bif c then x else .none) = .some gb sGb) :
    c = true ∧ x = .some gb sGb := by
  cases c
  · cases h
  · exact ⟨rfl, h⟩

private lemma zipGVecOpt_sound {uFn : ℕ → Fin 58 → ℝ} {p q : ℕ} (hp : p < 58) (hq : q < 58)
    (bs : List ℕ) :
    ∀ {ups vqs : List ℕ} (acc accBs : List ℕ) (sAcc : ℕ),
      List.Forall₂ (fun x b ↦ ValidOrb5e8 x (uFn b ⟨p, hp⟩)) ups bs →
      List.Forall₂ (fun x b ↦ ValidOrb5e8 x (uFn b ⟨q, hq⟩)) vqs bs →
      List.Forall₂ (fun glo b ↦ GVecElemValid (uFn b) ⟨p, hp⟩ ⟨q, hq⟩ glo) acc.reverse accBs →
      sAcc = sumList acc →
      ∀ {gb : List ℕ} {sGb : ℕ},
        zipGVecOpt ups vqs acc sAcc = .some gb sGb →
        List.Forall₂ (fun glo b ↦ GVecElemValid (uFn b) ⟨p, hp⟩ ⟨q, hq⟩ glo)
          gb (accBs ++ bs) ∧ sGb = sumList gb := by
  induction bs with
  | nil =>
    intro ups vqs acc accBs sAcc hup hvq hacc hsAcc gb sGb hz
    cases hup; cases hvq
    simp only [zipGVecOpt, revStrict_eq, List.append_nil] at hz
    cases hz
    rw [List.append_nil]
    exact ⟨hacc, by rw [hsAcc, sumList_reverse]⟩
  | cons b bs ih =>
    intro ups vqs acc accBs sAcc hup hvq hacc hsAcc gb sGb hz
    cases hup with
    | @cons up _ restU _ h1 htl1 =>
      cases hvq with
      | @cons vq _ restV _ h2 htl2 =>
        unfold zipGVecOpt at hz
        rw [zipGVecOpt_step_aux] at hz
        obtain ⟨hble, hz'⟩ := bif_optGEntry_some hz
        simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, nat_div_def] at hz' hble
        have hle := Nat.le_of_ble_eq_true hble
        have hglo := buildOneGVecCPS_step h1 h2 hle
        generalize (gcAddHi + up * vq - (errHi + cOffHi * (up + vq))) / 250000000 = glo
          at hglo hz'
        have hacc' : List.Forall₂ (fun g b' ↦ GVecElemValid (uFn b') ⟨p, hp⟩ ⟨q, hq⟩ g)
            (glo :: acc).reverse (accBs ++ [b]) := by
          rw [List.reverse_cons]; exact forall2_append hacc (.cons hglo .nil)
        have hsAcc' : sAcc + glo = sumList (glo :: acc) := by
          rw [sumList_cons, hsAcc, Nat.add_eq, Nat.add_comm]
        obtain ⟨hf, hs⟩ := ih (glo :: acc) (accBs ++ [b])
          (sAcc + glo) htl1 htl2 hacc' hsAcc' hz'
        exact ⟨forall2_append_assoc hf, hs⟩

private lemma zipGVecOpt_sound_nil {uFn : ℕ → Fin 58 → ℝ} {p q : ℕ} (hp : p < 58) (hq : q < 58)
    {bs ups vqs gb : List ℕ} {sGb : ℕ}
    (hup : List.Forall₂ (fun x b ↦ ValidOrb5e8 x (uFn b ⟨p, hp⟩)) ups bs)
    (hvq : List.Forall₂ (fun x b ↦ ValidOrb5e8 x (uFn b ⟨q, hq⟩)) vqs bs)
    (hz : zipGVecOpt ups vqs [] 0 = .some gb sGb) :
    List.Forall₂ (fun glo b ↦ GVecElemValid (uFn b) ⟨p, hp⟩ ⟨q, hq⟩ glo) gb bs ∧
      sGb = sumList gb :=
  zipGVecOpt_sound hp hq bs [] [] 0 hup hvq .nil sumList_nil.symm hz

private lemma keyGEntryValid_of_eq {uFn : ℕ → Fin 58 → ℝ} {key p q : ℕ} {gb : List ℕ} {sGb : ℕ}
    (hp_eq : p = key / 64) (hq_eq : q = key % 64)
    (hp58 : p < 58) (hq58 : q < 58)
    (hgb : List.Forall₂ (fun glo b ↦ GVecElemValid (uFn b) ⟨p, hp58⟩ ⟨q, hq58⟩ glo)
      gb (List.range 29))
    (hsGb : sGb = sumList gb) :
    KeyGEntryValid uFn (key, gb, sGb) := by
  subst hp_eq hq_eq
  exact ⟨hp58, hq58, hgb, hsGb⟩

lemma buildAllGsCol_sound {uFn : ℕ → Fin 58 → ℝ} {colTree : OrbColTree}
    (htree : OrbColTreeSound uFn colTree) (keys : List ℕ) :
    ∀ (acc : KeyGList),
      (∀ e ∈ (keyGToList acc).reverse, KeyGEntryValid uFn e) →
      ∀ {res : KeyGList}, buildAllGsCol colTree keys acc = .some res →
        ∀ e ∈ keyGToList res, KeyGEntryValid uFn e := by
  induction keys with
  | nil =>
    intro acc hacc res h e he
    simp only [buildAllGsCol, revKeyGListCPS_eq, id_eq] at h
    cases h
    rw [keyGToList_rev, keyGToList, List.append_nil] at he
    exact hacc e he
  | cons key rest ih =>
    intro acc hacc res h e he
    unfold buildAllGsCol at h
    cases hp : lookupOrbCol colTree (Nat.div key 64) with
    | none => rw [hp] at h; cases h
    | some cp =>
      cases hq : lookupOrbCol colTree (Nat.mod key 64) with
      | none => rw [hp, hq] at h; cases h
      | some cq =>
        rw [hp, hq] at h; dsimp only at h
        cases hz : zipGVecOpt cp cq [] 0 with
        | none => rw [hz] at h; cases h
        | some gb sGb =>
          rw [hz] at h; dsimp only at h
          obtain ⟨hp58, hcp⟩ := lookupOrbCol_sound htree hp
          obtain ⟨hq58, hcq⟩ := lookupOrbCol_sound htree hq
          obtain ⟨hgb, hsGb⟩ := zipGVecOpt_sound_nil hp58 hq58 hcp hcq hz
          refine ih (.cons key gb sGb acc) (fun e' he' ↦ ?_) h e he
          simp only [keyGToList, List.reverse_cons, List.mem_append, List.mem_singleton] at he'
          rcases he' with he0 | rfl
          · exact hacc e' he0
          · exact keyGEntryValid_of_eq (nat_div_def key 64) (nat_mod_def key 64) hp58 hq58 hgb hsGb

lemma buildDiagGsCol_sound {uFn : ℕ → Fin 58 → ℝ} {colTree : OrbColTree}
    (htree : OrbColTreeSound uFn colTree) (rem : ℕ) :
    ∀ (p : ℕ) (acc : KeyGList) (accPs : List ℕ),
      List.Forall₂ (fun e q ↦ DiagGEntryValid uFn q e) (keyGToList acc).reverse accPs →
      ∀ {res : KeyGList}, buildDiagGsCol colTree rem p acc = .some res →
        List.Forall₂ (fun e q ↦ DiagGEntryValid uFn q e)
          (keyGToList res) (accPs ++ (List.range rem).map (p + ·)) := by
  induction rem with
  | zero =>
    intro p acc accPs hacc res h
    simp only [buildDiagGsCol, revKeyGListCPS_eq, id_eq] at h
    cases h
    rw [keyGToList_rev, keyGToList, List.append_nil, List.range_zero, List.map_nil, List.append_nil]
    exact hacc
  | succ rem ih =>
    intro p acc accPs hacc res h
    unfold buildDiagGsCol at h
    cases hp : lookupOrbCol colTree p with
    | none => rw [hp] at h; cases h
    | some cp =>
      rw [hp] at h; dsimp only at h
      cases hz : zipGVecOpt cp cp [] 0 with
      | none => rw [hz] at h; cases h
      | some gb sGb =>
        rw [hz] at h; simp only [Nat.add_eq] at h
        obtain ⟨hp58, hcp⟩ := lookupOrbCol_sound htree hp
        obtain ⟨hgb, hsGb⟩ := zipGVecOpt_sound_nil hp58 hp58 hcp hcp hz
        have hhd : DiagGEntryValid uFn p (p, gb, sGb) := ⟨hp58, hgb, hsGb⟩
        have hacc' : List.Forall₂ (fun e q ↦ DiagGEntryValid uFn q e)
            (keyGToList (.cons p gb sGb acc)).reverse (accPs ++ [p]) := by
          simp only [keyGToList, List.reverse_cons]
          exact forall2_append hacc (.cons hhd .nil)
        have hrec := ih (p + 1) (.cons p gb sGb acc) (accPs ++ [p]) hacc' h
        rw [List.append_assoc, List.singleton_append] at hrec
        rw [List.range_succ_eq_map, List.map_cons, List.map_map, add_zero]
        have hmap : List.map ((p + ·) ∘ Nat.succ) (List.range rem) =
            List.map (p + 1 + ·) (List.range rem) :=
          List.map_congr_left fun j _ ↦ by change p + (j + 1) = p + 1 + j; omega
        rwa [hmap]

private noncomputable def modeValLists (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    (p q : Fin 58) : ℝ :=
  ∑ b ∈ Finset.range 29,
    ((iwRow.getD b 16384 : ℝ) - 16384) *
      (uFn b p * uFn b q)

private noncomputable def diagModeLists (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    (p : ℕ) : ℝ :=
  if hp : p < 58 then modeValLists uFn iwRow ⟨p, hp⟩ ⟨p, hp⟩ else 0

private lemma diagModeLists_of_lt (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    {p : ℕ} (hp : p < 58) :
    diagModeLists uFn iwRow p = modeValLists uFn iwRow ⟨p, hp⟩ ⟨p, hp⟩ := by
  simp [diagModeLists, hp]

private noncomputable def keyModeLists (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    (k : ℕ) : ℝ :=
  if hk : k / 64 < 58 ∧ k % 64 < 58 then
    modeValLists uFn iwRow ⟨k / 64, hk.1⟩ ⟨k % 64, hk.2⟩
  else 0

private noncomputable def evalQuadLists (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ) :
    QuadList → ℝ
  | .nil => 0
  | .cons k1 k2 p m rest =>
    ((p : ℝ) - (m : ℝ)) * (keyModeLists uFn iwRow k1 * keyModeLists uFn iwRow k2) +
      evalQuadLists uFn iwRow rest

private def mPosFn (iwRow : List ℕ) (b : ℕ) : ℕ :=
  let x := iwRow.getD b 16384
  if Nat.ble 16384 x then Nat.sub x 16384 else 0

private def mNegFn (iwRow : List ℕ) (b : ℕ) : ℕ :=
  let x := iwRow.getD b 16384
  if Nat.ble 16384 x then 0 else Nat.sub 16384 x

private lemma mPos_sub_mNeg_cast (iwRow : List ℕ) (b : ℕ) :
    (mPosFn iwRow b : ℝ) - (mNegFn iwRow b : ℝ) = (iwRow.getD b 16384 : ℝ) - 16384 := by
  unfold mPosFn mNegFn
  dsimp only
  split_ifs with h
  · have hle := Nat.le_of_ble_eq_true h
    rw [Nat.sub_eq, Nat.cast_sub hle, Nat.cast_zero, sub_zero]
    push_cast; rfl
  · have hle : iwRow.getD b 16384 ≤ 16384 := by
      have : ¬(16384 ≤ iwRow.getD b 16384) := fun h' ↦ h (Nat.ble_eq_true_of_le h'); omega
    rw [Nat.sub_eq, Nat.cast_sub hle, Nat.cast_zero, zero_sub]
    push_cast; ring

private lemma list_range29_getD : ∀ b ∈ Finset.range 29, (List.range 29).getD b 0 = b := by
  decide

private lemma mode_term_bounds {w g gp mp mn u : ℝ}
    (hdiff : mp - mn = w - 16384)
    (hmp : 0 ≤ mp) (hmn : 0 ≤ mn)
    (hglo : g - gp ≤ u) (hghi : u ≤ g + 18 - gp) :
    (w * g + 16384 * gp) - (16384 * g + gp * w) - 18 * mn ≤ (w - 16384) * u ∧
    (w - 16384) * u ≤ (w * g + 16384 * gp) - (16384 * g + gp * w) + 18 * mp := by
  set d := u - (g - gp)
  have hd0 : 0 ≤ d := by simp only [d]; linarith
  have hd18 : d ≤ 18 := by simp only [d]; linarith
  have hid : (w - 16384) * u - ((w * g + 16384 * gp) - (16384 * g + gp * w)) =
      mp * d - mn * d := by
    have hw : w - 16384 = mp - mn := hdiff.symm
    calc (w - 16384) * u - ((w * g + 16384 * gp) - (16384 * g + gp * w))
        = (w - 16384) * d := by simp only [d]; ring
      _ = (mp - mn) * d := by rw [hw]
      _ = mp * d - mn * d := by ring
  have hmp_d0 : 0 ≤ mp * d := mul_nonneg hmp hd0
  have hmp_d18 : mp * d ≤ 18 * mp := by
    have := mul_le_mul_of_nonneg_left hd18 hmp
    linarith
  have hmn_d0 : 0 ≤ mn * d := mul_nonneg hmn hd0
  have hmn_d18 : mn * d ≤ 18 * mn := by
    have := mul_le_mul_of_nonneg_left hd18 hmn
    linarith
  exact ⟨by linarith, by linarith⟩

private lemma evalOneModeKey_sound (uFn : ℕ → Fin 58 → ℝ) (iwRow : List ℕ)
    {iw29 : List ℕ} {sumIw29 sumPos sumNeg : ℕ}
    (hiw29 : iw29 = getRow29Go 29 iwRow)
    (hsumIw : sumIw29 = sumList iw29)
    (hsumPos : sumPos = sumList ((List.range 29).map (mPosFn iwRow)))
    (hsumNeg : sumNeg = sumList ((List.range 29).map (mNegFn iwRow)))
    {p q : Fin 58} {gb : List ℕ} {sGb : ℕ}
    (hgb : List.Forall₂ (fun glo b ↦ GVecElemValid (uFn b) p q glo)
      gb (List.range 29))
    (hsGb : sGb = sumList gb)
    (P : Bool → ℕ → ℕ → Prop)
    (hk : ∀ (ok : Bool) (lo5 w5 : ℕ),
      (ok = true →
        (lo5 : ℝ) - 50000000000 ≤ modeValLists uFn iwRow p q * 100000 ∧
        modeValLists uFn iwRow p q * 100000 ≤ (lo5 : ℝ) + (w5 : ℝ) - 50000000000) →
      P ok lo5 w5) :
    evalOneModeKey iw29 sumIw29 sumPos sumNeg gb sGb P := by
  unfold evalOneModeKey
  dsimp only
  simp only [strictNat_eq, Nat.add_eq, Nat.mul_eq, Nat.sub_eq, nat_div_def]
  split_ifs with hble1 hble2
  · have hreq_le := Nat.le_of_ble_eq_true hble1
    have hgb_len : gb.length = 29 := hgb.length_eq.trans List.length_range
    have hgb_map : gb = (List.range 29).map (gb.getD · 0) :=
      hgb_len ▸ list_eq_map_getD_of_length 0 gb
    have hiw_map : iw29 = (List.range 29).map (iwRow.getD · 16384) :=
      hiw29.trans (getRow29Go_eq 29 iwRow)
    have hdot : dotRaw iw29 gb = ∑ b ∈ Finset.range 29, iwRow.getD b 16384 * gb.getD b 0 := by
      conv_lhs => rw [hiw_map, hgb_map, dotRaw_map_range]
    have hsgb_eq : sGb = ∑ b ∈ Finset.range 29, gb.getD b 0 := by
      conv_lhs => rw [hsGb, hgb_map, sumList_map_range]
    have hsiw_eq : sumIw29 = ∑ b ∈ Finset.range 29, iwRow.getD b 16384 := by
      rw [hsumIw, hiw_map, sumList_map_range]
    have hsp_eq : sumPos = ∑ b ∈ Finset.range 29, mPosFn iwRow b := by
      rw [hsumPos, sumList_map_range]
    have hsn_eq : sumNeg = ∑ b ∈ Finset.range 29, mNegFn iwRow b := by
      rw [hsumNeg, sumList_map_range]
    set posRaw := dotRaw iw29 gb + 950272000000000
    set negRaw := 16384 * sGb + gpOffHi * sumIw29
    set reqLo := negRaw + 18 * sumNeg
    set bp := 500000000000000 + posRaw
    have hneg_le : negRaw ≤ bp + 18 * sumPos := by omega
    set lo5 := (bp - reqLo) / 10000
    set hi5 := (bp + 18 * sumPos - negRaw + 9999) / 10000
    have hlo_hi : lo5 ≤ hi5 :=
      Nat.div_le_div_right (by omega : bp - reqLo ≤ bp + 18 * sumPos - negRaw + 9999)
    have hterm_bounds : ∀ b ∈ Finset.range 29,
        let wR := (iwRow.getD b 16384 : ℝ)
        let gR := (gb.getD b 0 : ℝ)
        let uR := uFn b p * uFn b q * 1000000000
        (wR * gR + 16384 * (gpOffHi : ℝ)) - (16384 * gR + (gpOffHi : ℝ) * wR) -
            18 * (mNegFn iwRow b : ℝ) ≤ (wR - 16384) * uR ∧
        (wR - 16384) * uR ≤
          (wR * gR + 16384 * (gpOffHi : ℝ)) - (16384 * gR + (gpOffHi : ℝ) * wR) +
            18 * (mPosFn iwRow b : ℝ) := by
      intro b hb
      have hb29 : b < (List.range 29).length := by simp [Finset.mem_range.mp hb]
      have hge : GVecElemValid (uFn b) p q (gb.getD b 0) := by
        have h0 := forall2_getD hgb 0 0 hb29
        rwa [list_range29_getD b hb] at h0
      exact mode_term_bounds (mPos_sub_mNeg_cast iwRow b)
        (Nat.cast_nonneg _) (Nat.cast_nonneg _) hge.1 hge.2
    have hsum_lo := Finset.sum_le_sum fun b hb ↦ (hterm_bounds b hb).1
    have hsum_hi := Finset.sum_le_sum fun b hb ↦ (hterm_bounds b hb).2
    have hmid_eq : (∑ b ∈ Finset.range 29,
        ((iwRow.getD b 16384 : ℝ) - 16384) *
