      buildDiagStep ds wireW qTree (fun a b c ↦ f (k a b c)) =
        f (buildDiagStep ds wireW qTree k)
  | .nil, _, _, _ => rfl
  | .cons _ wa fa rest, wireW, qTree, k => by
