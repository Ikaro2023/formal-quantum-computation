        else match addQuadSlicesOpt (List.append diagAllEighthCerts s12AllSliceCerts) zeroTree with
          | .none => false
          | .some fullTree =>
            flattenQuadTreeCPS fullTree .nil fun quads ↦
              beqNatList wTot wTotCert && beqNatList dw0P dw0PCert &&
              beqNatList dw0N dw0NCert && beqNatList dw1P dw1PCert &&
              beqNatList dw1N dw1NCert && beqQuadList quads quadsCert))
    fun zeroTree _ hzero hk1 ↦ by
      have h2 := buildDiagStats_aux .nil (fun _ hm ↦ by cases hm) wireWE7Cert hlen_w7
        zeroTree
        (fun okD wTot dw0P dw0N dw1P dw1N _ ↦ fImp (
