def buildDiagStats {α : Type} :
    DetList → List ℕ → QuadAccTree →
    (Bool → List ℕ → List ℕ → List ℕ → List ℕ → List ℕ → QuadAccTree → α) → α
  | .nil, wireW, qTree, k =>
    if !checkWireWLe wireW then k false [] [] [] [] [] .empty
    else
      strictNatList ((List.range 58).map fun p ↦
        if Nat.blt p 33 then 0 else wireW.getD (Nat.mul 2 p) 0) fun dw0P ↦
      strictNatList ((List.range 58).map fun p ↦
        if Nat.blt p 33 then wireW.getD (Nat.mul 2 p) 0 else 0) fun dw0N ↦
      strictNatList ((List.range 58).map fun p ↦
        if Nat.blt p 30 then 0 else wireW.getD (Nat.add (Nat.mul 2 p) 1) 0) fun dw1P ↦
      strictNatList ((List.range 58).map fun p ↦
        if Nat.blt p 30 then wireW.getD (Nat.add (Nat.mul 2 p) 1) 0 else 0) fun dw1N ↦
      strictNatList ((List.range 58).map fun p ↦
        let w0 := wireW.getD (Nat.mul 2 p) 0
        let w1 := wireW.getD (Nat.add (Nat.mul 2 p) 1) 0
        Nat.add (if Nat.blt p 33 then Nat.sub deepNormSq w0 else w0)
                (if Nat.blt p 30 then Nat.sub deepNormSq w1 else w1)) fun wTot ↦
        k true wTot dw0P dw0N dw1P dw1N qTree
  | .cons _ wa fa rest, wireW, qTree, k =>
    strictNat (Nat.mul wa wa) fun wa2 ↦
    strictNatList (addFlipsW wa2 fa wireW) fun wireW' ↦
    diagQuadsOuter wa2 fa fa qTree fun ok qTree' ↦
      if ok then buildDiagStats rest wireW' qTree' k
      else k false [] [] [] [] [] .empty

