    rw [list_getD_take nModes _ [] hk_lt, list_getD_drop cStart blkIwFull [] k]
  rw [hiw_eq]
  set iwRow := blkIwFull.getD c.val []
  have hfw : fwRow.getD (cStart + k) 0 = deepFragOuterNat r c := fwRow_fragOuterNat r c
  have hiw (b : ℕ) : ((iwRow.getD b 16384 : ℝ) - 16384) = (deepInnerInt r c b : ℝ) :=
    blkIw_innerInt r c b
