/-- Internal CIPSI certificate helper `symDiff5Go`. -/
def symDiff5Go : ℕ → List ℕ → List ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → SymDiff5
  | 0, _, _, _, _, _, _, _ => .lt4
  | _ + 1, [], [], d1, d2, d3, d4, cnt =>
    if Nat.beq cnt 4 then .eq4 d1 d2 d3 d4 else .lt4
  | fuel + 1, x :: xs, [], d1, d2, d3, d4, cnt =>
    if Nat.beq cnt 4 then .gt4 d1 d2 d3 d4 x
    else if Nat.beq cnt 0 then symDiff5Go fuel xs [] x d2 d3 d4 1
    else if Nat.beq cnt 1 then symDiff5Go fuel xs [] d1 x d3 d4 2
    else if Nat.beq cnt 2 then symDiff5Go fuel xs [] d1 d2 x d4 3
    else symDiff5Go fuel xs [] d1 d2 d3 x 4
  | fuel + 1, [], y :: ys, d1, d2, d3, d4, cnt =>
    if Nat.beq cnt 4 then .gt4 d1 d2 d3 d4 y
    else if Nat.beq cnt 0 then symDiff5Go fuel [] ys y d2 d3 d4 1
    else if Nat.beq cnt 1 then symDiff5Go fuel [] ys d1 y d3 d4 2
    else if Nat.beq cnt 2 then symDiff5Go fuel [] ys d1 d2 y d4 3
    else symDiff5Go fuel [] ys d1 d2 d3 y 4
  | fuel + 1, x :: xs, y :: ys, d1, d2, d3, d4, cnt =>
    if Nat.beq x y then symDiff5Go fuel xs ys d1 d2 d3 d4 cnt
    else if Nat.blt x y then
      if Nat.beq cnt 4 then .gt4 d1 d2 d3 d4 x
      else if Nat.beq cnt 0 then symDiff5Go fuel xs (y :: ys) x d2 d3 d4 1
      else if Nat.beq cnt 1 then symDiff5Go fuel xs (y :: ys) d1 x d3 d4 2
      else if Nat.beq cnt 2 then symDiff5Go fuel xs (y :: ys) d1 d2 x d4 3
      else symDiff5Go fuel xs (y :: ys) d1 d2 d3 x 4
    else
      if Nat.beq cnt 4 then .gt4 d1 d2 d3 d4 y
      else if Nat.beq cnt 0 then symDiff5Go fuel (x :: xs) ys y d2 d3 d4 1
      else if Nat.beq cnt 1 then symDiff5Go fuel (x :: xs) ys d1 y d3 d4 2
      else if Nat.beq cnt 2 then symDiff5Go fuel (x :: xs) ys d1 d2 y d4 3
      else symDiff5Go fuel (x :: xs) ys d1 d2 d3 y 4

/-- Internal CIPSI certificate helper `oddLtAll`. -/
def oddLtAll : List ℕ → ℕ → Bool → Bool
  | [], _, par => par
  | w :: ws, j, par => oddLtAll ws j (if Nat.blt w j then !par else par)

/-- Internal CIPSI certificate helper `prefixParityFlips`. -/
def prefixParityFlips (flips : List ℕ) (j : ℕ) : Bool :=
  strictNat (minNat (Nat.div (Nat.add j 1) 2) 33) fun na ↦
  strictNat (minNat (Nat.div j 2) 30) fun nb ↦
  strictBool (Nat.beq (Nat.mod (Nat.add na nb) 2) 1) fun basePar ↦
    oddLtAll flips j basePar

/-- Internal CIPSI certificate helper `exciteNegFlips`. -/
def exciteNegFlips (flips : List ℕ) (wh wp : ℕ) : Bool :=
  xor (xor (prefixParityFlips flips wh) (prefixParityFlips flips wp)) (Nat.blt wh wp)

/-- Internal CIPSI certificate helper `emitOneQuadCPS`. -/
def emitOneQuadCPS {α : Type} (wProdNeg : Bool) (twoWab : ℕ) (fa fb : List ℕ)
    (wq1 wp1 wq2 wp2 : ℕ) (tree : QuadAccTree) (k : Bool → QuadAccTree → α) : α :=
  if Nat.beq (Nat.mod wq1 2) (Nat.mod wp1 2) && Nat.beq (Nat.mod wq2 2) (Nat.mod wp2 2) then
    strictBool (xor wProdNeg (xor (exciteNegFlips fa wq1 wp1) (exciteNegFlips fb wq2 wp2)))
      fun neg ↦
    strictNat (pqKey (Nat.div wp1 2) (Nat.div wq1 2)) fun k1 ↦
    strictNat (pqKey (Nat.div wp2 2) (Nat.div wq2 2)) fun k2 ↦
    if neg then pushQuadTreeCPS k1 k2 0 twoWab tree k
    else pushQuadTreeCPS k1 k2 twoWab 0 tree k
  else k true tree

/-- Internal CIPSI certificate helper `offDiagInner`. -/
def offDiagInner {α : Type} (na : Bool) (wa : ℕ) (fa : List ℕ) :
    DetList → QuadAccTree → (Bool → QuadAccTree → α) → α
  | .nil, tree, k => k true tree
  | .cons nb wb fb rest, tree, k =>
    match symDiff5Go 52 fa fb 0 0 0 0 0 with
    | .lt4 => k false .empty
    | .gt4 _ _ _ _ _ => offDiagInner na wa fa rest tree k
    | .eq4 d1 d2 d3 d4 =>
      let diff := [d1, d2, d3, d4]
      strictNatList (diff.filter (fun w ↦ detBitFlips fa w)) fun wps ↦
      strictNatList (diff.filter (fun w ↦ !detBitFlips fa w)) fun whs ↦
      match wps, whs with
      | [wp1, wp2], [wh1, wh2] =>
        strictNat (Nat.mul 2 (Nat.mul wa wb)) fun twoWab ↦
        strictBool (xor na nb) fun wNeg ↦
        emitOneQuadCPS wNeg twoWab fa fb wp1 wh1 wh2 wp2 tree fun ok1 t1 ↦
        if !ok1 then k false .empty else
        emitOneQuadCPS wNeg twoWab fa fb wp1 wh2 wh1 wp2 t1 fun ok2 t2 ↦
        if !ok2 then k false .empty else
        emitOneQuadCPS wNeg twoWab fa fb wp2 wh1 wh2 wp1 t2 fun ok3 t3 ↦
        if !ok3 then k false .empty else
        emitOneQuadCPS wNeg twoWab fa fb wp2 wh2 wh1 wp1 t3 fun ok4 t4 ↦
        if ok4 then offDiagInner na wa fa rest t4 k
        else k false .empty
      | _, _ => k false .empty

/-- Internal CIPSI certificate helper `offDiagOuter`. -/
def offDiagOuter {α : Type} : DetList → QuadAccTree → (Bool → QuadAccTree → α) → α
  | .nil, tree, k => k true tree
  | .cons na wa fa rest, tree, k =>
    offDiagInner na wa fa rest tree fun ok tree' ↦
      if ok then offDiagOuter rest tree' k
      else k false .empty

/-- Internal CIPSI certificate helper `mulZIv`. -/
def mulZIv {α : Type} (z1 l1 w1 z2 l2 w2 divBy newOff : ℕ) (k : Bool → ℕ → ℕ → α) : α :=
  strictNat (Nat.add (Nat.mul 2 l1) w1) fun c1 ↦
  strictNat (Nat.mul 2 z1) fun zz1 ↦
  strictNat (Nat.add (Nat.mul 2 l2) w2) fun c2 ↦
  strictNat (Nat.mul 2 z2) fun zz2 ↦
  strictNat (Nat.add (Nat.mul c1 c2) (Nat.mul zz1 zz2)) fun pA ↦
  strictNat (Nat.add (Nat.mul zz2 c1) (Nat.mul zz1 c2)) fun nA ↦
  strictNat (absDiffNat c1 zz1) fun m1 ↦
  strictNat (absDiffNat c2 zz2) fun m2 ↦
  strictNat (Nat.add (Nat.add (Nat.mul w1 m2) (Nat.mul m1 w2)) (Nat.mul w1 w2)) fun rad ↦
  strictNat (Nat.mul 4 divBy) fun div4 ↦
  strictNat (Nat.mul newOff div4) fun base ↦
  strictNat (Nat.add nA rad) fun req ↦
  strictNat (Nat.add base pA) fun bp ↦
  if Nat.ble req bp && Nat.blt 0 div4 then
    strictNat (Nat.div (Nat.sub bp req) div4) fun lo ↦
    strictNat (Nat.div (Nat.add (Nat.sub (Nat.add bp rad) nA) (Nat.sub div4 1)) div4) fun hi ↦
    strictNat (Nat.sub hi lo) fun w ↦ k true lo w
  else k false 0 0

