private lemma evalMQuadsGo_comp {α β : Type} (f : α → β) (m2Tree : KeyIvTree) :
    ∀ (qs : QuadList) (rawP rawN : ℕ) (k : Bool → ℕ → ℕ → α),
      evalMQuadsGo m2Tree qs rawP rawN (fun a b c ↦ f (k a b c)) =
        f (evalMQuadsGo m2Tree qs rawP rawN k)
  | .nil, rawP, rawN, k => by
    unfold evalMQuadsGo
    rw [← normPN_comp f]
    refine cps2_congr _ fun _ _ ↦ ?_
    simp only [strictNat_eq]
    exact normPN_comp f _ _ _
  | .cons k1 k2 cP cN rest, rawP, rawN, k => by
    unfold evalMQuadsGo; dsimp only
    rw [← lookupKeyIv_comp f m2Tree k1]
    refine cps3_congr _ fun _ _ _ ↦ ?_
    rw [← lookupKeyIv_comp f m2Tree k2]
    refine cps3_congr _ fun _ _ _ ↦ ?_
    simp only [strictNat_eq]
    split_ifs <;> first | exact evalMQuadsGo_comp f m2Tree rest _ _ k | rfl

private noncomputable def modeListsReal (uFn : ℕ → Fin 58 → ℝ)
    (wTot dTotP dTotN : List ℕ) (quads : QuadList) (fw : ℕ) (iwRow : List ℕ) : ℝ :=
  let shiftR : ℝ := ((iwRow.getD 29 16384 : ℝ) - 16384) -
    ∑ b ∈ Finset.range 29, ((iwRow.getD b 16384 : ℝ) - 16384)
  let linR : ℝ := ∑ p ∈ Finset.range 58,
    (wTot.getD p 0 : ℝ) * diagModeLists uFn iwRow p
  let refR : ℝ := ∑ p ∈ Finset.range 58,
    (sextetOccCountNat p : ℝ) * diagModeLists uFn iwRow p
  let deltaR : ℝ := ∑ p ∈ Finset.range 58,
    ((dTotP.getD p 0 : ℝ) - (dTotN.getD p 0 : ℝ)) * diagModeLists uFn iwRow p
  4 * (fw : ℝ) * shiftR * linR +
    2 * (fw : ℝ) * ((deepNormSq : ℝ) * refR ^ 2 + 2 * refR * deltaR +
      evalQuadLists uFn iwRow quads)

private lemma modesLoopGo_le (uFn : ℕ → Fin 58 → ℝ)
    {diagGs activeGs : KeyGList}
    (hdiagGs : List.Forall₂ (fun e q ↦ DiagGEntryValid uFn q e)
      (keyGToList diagGs) ((List.range 58).map (0 + ·)))
    (hactGs : ∀ e ∈ keyGToList activeGs, KeyGEntryValid uFn e)
    {wTot dTotP dTotN : List ℕ}
    (hw : wTot.length = 58) (hdP : dTotP.length = 58) (hdN : dTotN.length = 58)
    (quads : QuadList) (fwRow : List ℕ) :
    ∀ (rem cIdx : ℕ) (iwRows : List (List ℕ)) (frP frN : ℕ) (P : Bool → ℕ → ℕ → Prop),
      (∀ (ok : Bool) (mdP mdN : ℕ),
        (ok = true →
          (frP : ℝ) - (frN : ℝ) +
            (∑ k ∈ Finset.range rem,
              modeListsReal uFn wTot dTotP dTotN quads
                (fwRow.getD (cIdx + k) 0) (iwRows.getD k [])) / 10 ≤
            (mdP : ℝ) - (mdN : ℝ)) →
        P ok mdP mdN) →
      modesLoopGo diagGs activeGs wTot dTotP dTotN quads fwRow rem cIdx iwRows frP frN P
  | 0, _, _, frP, frN, _, hk =>
    hk true frP frN fun _ ↦ by simp
  | rem + 1, cIdx, iwRows, frP, frN, P, hk => by
    unfold modesLoopGo
    rw [list_headD_eq_getD]
    simp only [strictNat_eq, strictNatList_eq]
    set iwRow := iwRows.getD 0 []
    set fw := fwRow.getD cIdx 0
    set iw29 := getRow29Go 29 iwRow
