      have hml := modesLoopGo_le uFn hdgs hags hw hdP hdN quads fwRow nModes cStart blkIw 0 0
        (fun okM mdP mdN ↦ fImp (okM && Nat.beq mdP expP && Nat.beq mdN expN))
        fun okM mdP mdN hle0 hk ↦ by
