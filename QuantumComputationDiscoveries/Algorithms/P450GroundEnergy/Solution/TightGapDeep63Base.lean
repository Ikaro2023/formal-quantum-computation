private lemma offDiagInner_comp {α β : Type} (f : α → β) (na : Bool) (wa : ℕ) (fa : List ℕ) :
    ∀ (ds : DetList) (tree : QuadAccTree) (k : Bool → QuadAccTree → α),
      offDiagInner na wa fa ds tree (fun a b ↦ f (k a b)) =
        f (offDiagInner na wa fa ds tree k)
  | .nil, _, _ => rfl
  | .cons nb wb fb rest, tree, k => by
    unfold offDiagInner
    cases symDiff5Go 52 fa fb 0 0 0 0 0 with
    | lt4 => rfl
    | gt4 _ _ _ _ _ => exact offDiagInner_comp f na wa fa rest tree k
    | eq4 d1 d2 d3 d4 =>
      simp only [strictNatList_eq]
      cases List.filter (fun w ↦ detBitFlips fa w) [d1, d2, d3, d4] with
      | nil => rfl
      | cons wp1 r1 =>
        cases r1 with
        | nil => rfl
        | cons wp2 r2 =>
          cases r2 with
          | cons _ _ => rfl
          | nil =>
            cases List.filter (fun w ↦ !detBitFlips fa w) [d1, d2, d3, d4] with
            | nil => rfl
            | cons wh1 s1 =>
              cases s1 with
              | nil => rfl
              | cons wh2 s2 =>
                cases s2 with
                | cons _ _ => rfl
                | nil =>
                  dsimp only
                  simp only [strictNat_eq, strictBool_eq]
                  rw [← emitOneQuadCPS_comp f]
                  refine cps2_congr _ fun ok1 t1 ↦ ?_
                  split_ifs; · rfl
                  rw [← emitOneQuadCPS_comp f]
                  refine cps2_congr _ fun ok2 t2 ↦ ?_
                  split_ifs; · rfl
                  rw [← emitOneQuadCPS_comp f]
                  refine cps2_congr _ fun ok3 t3 ↦ ?_
                  split_ifs; · rfl
                  rw [← emitOneQuadCPS_comp f]
                  refine cps2_congr _ fun ok4 t4 ↦ ?_
                  split_ifs
                  · exact offDiagInner_comp f na wa fa rest t4 k
                  · rfl

private lemma offDiagOuter_comp {α β : Type} (f : α → β) :
    ∀ (ds : DetList) (tree : QuadAccTree) (k : Bool → QuadAccTree → α),
      offDiagOuter ds tree (fun a b ↦ f (k a b)) =
        f (offDiagOuter ds tree k)
  | .nil, _, _ => rfl
  | .cons na wa fa rest, tree, k => by
    unfold offDiagOuter
    rw [← offDiagInner_comp f]
    refine cps2_congr _ fun ok tree' ↦ ?_
    split_ifs
    · exact offDiagOuter_comp f rest tree' k
    · rfl

/-! ### Phase 1+2 Real Target Quantities & Master Energy Identity -/

/-- Internal Deep helper `cipsiObReal`. -/
noncomputable def cipsiObReal : ℝ :=
  ∑ ℓ : Fin 58,
    (fromOffset ((oneBodyWeights.getChunk ℓ).toNat) : ℝ) *
      ∑ p : Fin 58, (wTotCert.getD p.val 0 : ℝ) * (rObVec ℓ p) ^ 2

/-- Internal Deep helper `cipsiPairValReal`. -/
noncomputable def cipsiPairValReal (u1 u2 : Fin 58 → ℝ) : ℝ :=
  (deepNormSq : ℝ) *
    (occDot qOcc 0 u1 u2 * virtDot qOcc 0 u1 u2 +
      occDot qOcc 1 u1 u2 * virtDot qOcc 1 u1 u2) +
  (virtDot qOcc 0 u1 u2 - occDot qOcc 0 u1 u2) *
    (∑ p : Fin 58,
      ((dw0PCert.getD p.val 0 : ℝ) - (dw0NCert.getD p.val 0 : ℝ)) * (u1 p * u2 p)) +
  (virtDot qOcc 1 u1 u2 - occDot qOcc 1 u1 u2) *
    (∑ p : Fin 58,
      ((dw1PCert.getD p.val 0 : ℝ) - (dw1NCert.getD p.val 0 : ℝ)) * (u1 p * u2 p))

/-- Internal Deep helper `cipsiBlockExchReal`. -/
noncomputable def cipsiBlockExchReal (r : Fin 9) : ℝ :=
  ∑ b1 : Fin 29, ∑ b2 : Fin 29,
    (∑ c : Fin 14,
      ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
        (deepInnerInt r c b1.val : ℝ) * (deepInnerInt r c b2.val : ℝ)) *
      cipsiPairValReal (rLeafVec (leafEquiv (r, b1))) (rLeafVec (leafEquiv (r, b2)))

/-- Internal Deep helper `sextetModeSD0`. -/
noncomputable def sextetModeSD0 (r : Fin 9) (c : Fin 14) : ℝ :=
  ∑ p : Fin 58,
    ((if p.val < 33 then (1 : ℝ) else 0) + (if p.val < 30 then (1 : ℝ) else 0)) *
      modeMatrix r c p p

/-- Internal Deep helper `cipsiModeReal`. -/
noncomputable def cipsiModeReal (r : Fin 9) (c : Fin 14) : ℝ :=
  ((4 * (deepFragOuterNat r c : ℤ) * deepInnerShiftInt r c : ℤ) : ℝ) *
    (∑ p : Fin 58, (wTotCert.getD p.val 0 : ℝ) * modeMatrix r c p p) +
  ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
    ((deepNormSq : ℝ) * (sextetModeSD0 r c) ^ 2 +
      2 * sextetModeSD0 r c *
        (∑ p : Fin 58,
          (((dw0PCert.getD p.val 0 : ℝ) + (dw1PCert.getD p.val 0 : ℝ)) -
            ((dw0NCert.getD p.val 0 : ℝ) + (dw1NCert.getD p.val 0 : ℝ))) *
            modeMatrix r c p p) +
      evalQuadList r c quadsCert)

private lemma qOcc_spin0_real (p : Fin 58) :
    (if qOcc (spinOrbital 58 p 0) then (1 : ℝ) else 0) =
      if p.val < 33 then 1 else 0 := by
  unfold qOcc spinOrbital
  dsimp
  have h1 : (2 * p.val) % 2 = 0 := by omega
  have h2 : (2 * p.val) / 2 = p.val := by omega
  simp [h1, h2]

private lemma qOcc_spin1_real (p : Fin 58) :
    (if qOcc (spinOrbital 58 p 1) then (1 : ℝ) else 0) =
      if p.val < 30 then 1 else 0 := by
  unfold qOcc spinOrbital
  dsimp
  have h1 : (2 * p.val + 1) % 2 = 1 := by omega
  have h2 : (2 * p.val + 1) / 2 = p.val := by omega
  simp [h1, h2]

private lemma eq_sum_modeMatrix_diag (b : Fin (2 * 58) → Bool) (r : Fin 9) (c : Fin 14) :
    (∑ b_idx : Fin 29, (deepInnerInt r c b_idx.val : ℝ) *
      (occDot b 0 (rLeafVec (leafEquiv (r, b_idx))) (rLeafVec (leafEquiv (r, b_idx))) +
        occDot b 1 (rLeafVec (leafEquiv (r, b_idx))) (rLeafVec (leafEquiv (r, b_idx))))) =
    ∑ p : Fin 58,
      ((if b (spinOrbital 58 p 0) then (1 : ℝ) else 0) +
        (if b (spinOrbital 58 p 1) then (1 : ℝ) else 0)) *
        modeMatrix r c p p := by
  unfold occDot modeMatrix
  have h1 (b_idx : Fin 29) :
      (deepInnerInt r c b_idx.val : ℝ) *
        ((∑ q : Fin 58,
            if b (spinOrbital 58 q 0) = true then
              rLeafVec (leafEquiv (r, b_idx)) q * rLeafVec (leafEquiv (r, b_idx)) q
            else 0) +
          (∑ q : Fin 58,
            if b (spinOrbital 58 q 1) = true then
              rLeafVec (leafEquiv (r, b_idx)) q * rLeafVec (leafEquiv (r, b_idx)) q
            else 0)) =
      ∑ p : Fin 58,
        ((if b (spinOrbital 58 p 0) then (1 : ℝ) else 0) +
          (if b (spinOrbital 58 p 1) then (1 : ℝ) else 0)) *
          ((deepInnerInt r c b_idx.val : ℝ) *
            (rLeafVec (leafEquiv (r, b_idx)) p * rLeafVec (leafEquiv (r, b_idx)) p)) := by
    rw [← Finset.sum_add_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ ↦ ?_
    cases b (spinOrbital 58 p 0) <;> cases b (spinOrbital 58 p 1) <;> (simp; try ring)
  simp_rw [h1]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun p _ ↦ (Finset.mul_sum _ _ _).symm

private lemma sextet_eq_sextetModeSD0 (r : Fin 9) (c : Fin 14) :
    (∑ b_idx : Fin 29, (deepInnerInt r c b_idx.val : ℝ) *
      (occDot qOcc 0 (rLeafVec (leafEquiv (r, b_idx)))
          (rLeafVec (leafEquiv (r, b_idx))) +
        occDot qOcc 1 (rLeafVec (leafEquiv (r, b_idx)))
          (rLeafVec (leafEquiv (r, b_idx))))) =
    sextetModeSD0 r c := by
  rw [eq_sum_modeMatrix_diag]
  unfold sextetModeSD0
  refine Finset.sum_congr rfl fun p _ ↦ by
    rw [qOcc_spin0_real, qOcc_spin1_real]

private lemma list_map_range_getD (n : ℕ) (f : ℕ → ℕ) {i : ℕ} (hi : i < n) :
    ((List.range n).map f).getD i 0 = f i := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hi]
  rfl

private lemma weighted_occDelta_spin0 (ds : DetList) {wFinal : List ℕ}
    (hw_get : ∀ j : ℕ, j < 116 → wFinal.getD j 0 = 0 +
      ((detListToList ds).map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum)
    (u v : Fin 58 → ℝ) :
    ((detListToList ds).map fun t ↦
      ((t.2.1 ^ 2 : ℕ) : ℝ) * occDeltaSpin t.2.2 0 u v).sum =
    ∑ p : Fin 58,
      (((if p.val < 33 then 0 else wFinal.getD (2 * p.val) 0 : ℕ) : ℝ) -
        ((if p.val < 33 then wFinal.getD (2 * p.val) 0 else 0 : ℕ) : ℝ)) * (u p * v p) := by
  have hexp (t : Bool × ℕ × List ℕ) :
      ((t.2.1 ^ 2 : ℕ) : ℝ) * occDeltaSpin t.2.2 0 u v =
        ∑ p : Fin 58,
          ((t.2.1 ^ 2 : ℕ) : ℝ) *
            (if 2 * p.val ∈ t.2.2 then flipSignReal (2 * p.val) else 0) * (u p * v p) := by
    unfold occDeltaSpin occDot
    rw [← Finset.sum_sub_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ ↦ ?_
    have hd := detOfFlips_ind_sub t.2.2 (spinOrbital 58 p 0)
    have hval : (spinOrbital 58 p 0).val = 2 * p.val := rfl
    rw [hval] at hd
    have hmul :
        ((t.2.1 ^ 2 : ℕ) : ℝ) *
          ((if detOfFlips t.2.2 (spinOrbital 58 p 0) then u p * v p else 0) -
            (if qOcc (spinOrbital 58 p 0) then u p * v p else 0)) =
        ((t.2.1 ^ 2 : ℕ) : ℝ) *
          ((if detOfFlips t.2.2 (spinOrbital 58 p 0) then (1 : ℝ) else 0) -
            (if qOcc (spinOrbital 58 p 0) then (1 : ℝ) else 0)) * (u p * v p) := by
      cases detOfFlips t.2.2 (spinOrbital 58 p 0) <;>
        cases qOcc (spinOrbital 58 p 0) <;> simp
    rw [hmul, hd]
  simp_rw [hexp]
  rw [← list_sum_finset_comm]
  refine Finset.sum_congr rfl fun p _ ↦ ?_
  have hp2 : 2 * p.val < 116 := by omega
  have hw := hw_get (2 * p.val) hp2
  rw [zero_add] at hw
  have hcast_sum : ((wFinal.getD (2 * p.val) 0 : ℕ) : ℝ) =
      ((detListToList ds).map fun t ↦
        if 2 * p.val ∈ t.2.2 then ((t.2.1 ^ 2 : ℕ) : ℝ) else 0).sum := by
    rw [hw, Nat.cast_list_sum, List.map_map]
    refine congrArg List.sum (List.map_congr_left fun t _ ↦ ?_)
    dsimp; split_ifs <;> simp
  have hfactor :
      ((detListToList ds).map fun t ↦
        ((t.2.1 ^ 2 : ℕ) : ℝ) *
          (if 2 * p.val ∈ t.2.2 then flipSignReal (2 * p.val) else 0) * (u p * v p)).sum =
      flipSignReal (2 * p.val) * (wFinal.getD (2 * p.val) 0 : ℝ) * (u p * v p) := by
    rw [hcast_sum, ← List.sum_map_mul_left, ← List.sum_map_mul_right]
    refine congrArg List.sum (List.map_congr_left fun t _ ↦ ?_)
    split_ifs <;> ring
  rw [hfactor]
  congr 1
  unfold flipSignReal sextetBitNat
  simp only [nat_mod_def, nat_div_def]
  have hm : Nat.beq (2 * p.val % 2) 0 = true := Nat.beq_eq.mpr (by omega)
  have hd : 2 * p.val / 2 = p.val := by omega
  rw [hm, hd]
  by_cases hlt : p.val < 33
  · simp [Nat.blt_eq.mpr hlt, hlt]
  · have hbf : Nat.blt p.val 33 = false := Bool.eq_false_iff.mpr (mt Nat.blt_eq.mp hlt)
    simp [hbf, hlt]

private lemma weighted_occDelta_spin1 (ds : DetList) {wFinal : List ℕ}
    (hw_get : ∀ j : ℕ, j < 116 → wFinal.getD j 0 = 0 +
      ((detListToList ds).map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum)
    (u v : Fin 58 → ℝ) :
    ((detListToList ds).map fun t ↦
      ((t.2.1 ^ 2 : ℕ) : ℝ) * occDeltaSpin t.2.2 1 u v).sum =
    ∑ p : Fin 58,
      (((if p.val < 30 then 0 else wFinal.getD (2 * p.val + 1) 0 : ℕ) : ℝ) -
        ((if p.val < 30 then wFinal.getD (2 * p.val + 1) 0 else 0 : ℕ) : ℝ)) *
        (u p * v p) := by
  have hexp (t : Bool × ℕ × List ℕ) :
      ((t.2.1 ^ 2 : ℕ) : ℝ) * occDeltaSpin t.2.2 1 u v =
        ∑ p : Fin 58,
          ((t.2.1 ^ 2 : ℕ) : ℝ) *
            (if 2 * p.val + 1 ∈ t.2.2 then flipSignReal (2 * p.val + 1) else 0) *
            (u p * v p) := by
    unfold occDeltaSpin occDot
    rw [← Finset.sum_sub_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ ↦ ?_
    have hd := detOfFlips_ind_sub t.2.2 (spinOrbital 58 p 1)
    have hval : (spinOrbital 58 p 1).val = 2 * p.val + 1 := rfl
    rw [hval] at hd
    have hmul :
        ((t.2.1 ^ 2 : ℕ) : ℝ) *
          ((if detOfFlips t.2.2 (spinOrbital 58 p 1) then u p * v p else 0) -
            (if qOcc (spinOrbital 58 p 1) then u p * v p else 0)) =
        ((t.2.1 ^ 2 : ℕ) : ℝ) *
          ((if detOfFlips t.2.2 (spinOrbital 58 p 1) then (1 : ℝ) else 0) -
            (if qOcc (spinOrbital 58 p 1) then (1 : ℝ) else 0)) * (u p * v p) := by
      cases detOfFlips t.2.2 (spinOrbital 58 p 1) <;>
        cases qOcc (spinOrbital 58 p 1) <;> simp
    rw [hmul, hd]
  simp_rw [hexp]
  rw [← list_sum_finset_comm]
  refine Finset.sum_congr rfl fun p _ ↦ ?_
  have hp2 : 2 * p.val + 1 < 116 := by omega
  have hw := hw_get (2 * p.val + 1) hp2
  rw [zero_add] at hw
  have hcast_sum : ((wFinal.getD (2 * p.val + 1) 0 : ℕ) : ℝ) =
      ((detListToList ds).map fun t ↦
        if 2 * p.val + 1 ∈ t.2.2 then ((t.2.1 ^ 2 : ℕ) : ℝ) else 0).sum := by
    rw [hw, Nat.cast_list_sum, List.map_map]
    refine congrArg List.sum (List.map_congr_left fun t _ ↦ ?_)
    dsimp; split_ifs <;> simp
  have hfactor :
      ((detListToList ds).map fun t ↦
        ((t.2.1 ^ 2 : ℕ) : ℝ) *
          (if 2 * p.val + 1 ∈ t.2.2 then flipSignReal (2 * p.val + 1) else 0) *
          (u p * v p)).sum =
      flipSignReal (2 * p.val + 1) * (wFinal.getD (2 * p.val + 1) 0 : ℝ) * (u p * v p) := by
    rw [hcast_sum, ← List.sum_map_mul_left, ← List.sum_map_mul_right]
    refine congrArg List.sum (List.map_congr_left fun t _ ↦ ?_)
    split_ifs <;> ring
  rw [hfactor]
  congr 1
  unfold flipSignReal sextetBitNat
  simp only [nat_mod_def, nat_div_def]
  have hm : Nat.beq ((2 * p.val + 1) % 2) 0 = false := nat_beq_eq_false_of_ne (by omega)
  have hd : (2 * p.val + 1) / 2 = p.val := by omega
  rw [hm, hd]
  by_cases hlt : p.val < 30
  · simp [Nat.blt_eq.mpr hlt, hlt]
  · have hbf : Nat.blt p.val 30 = false := Bool.eq_false_iff.mpr (mt Nat.blt_eq.mp hlt)
    simp [hbf, hlt]

private lemma pairwise_get_inj {α β : Type*} {f : α → β} {L : List α}
    (hpw : List.Pairwise (fun a b ↦ f a ≠ f b) L) :
    Function.Injective (fun i : Fin L.length ↦ f (L.get i)) := by
  intro i j hij
  rcases lt_trichotomy i j with hlt | rfl | hgt
  · exfalso
    exact (List.pairwise_iff_get.mp hpw i j hlt) hij
  · rfl
  · exfalso
    exact (List.pairwise_iff_get.mp hpw j i hgt) hij.symm

private lemma list_attach_sum_eq_map_sum {α : Type*} :
    ∀ (L : List α) (g : α → ℝ), (L.attach.map fun x ↦ g x.1).sum = (L.map g).sum
  | [], _ => rfl
  | x :: xs, g => by
    rw [List.attach_cons, List.map_cons, List.sum_cons, List.map_map,
      List.map_cons, List.sum_cons, ← list_attach_sum_eq_map_sum xs g]
    rfl

private lemma cast_list_sum_sq {L : List (Bool × ℕ × List ℕ)} :
    (L.map fun t ↦ ((t.2.1 ^ 2 : ℕ) : ℝ)).sum =
      (((L.map fun t ↦ (t.2.1 ^ 2 : ℕ)).sum : ℕ) : ℝ) := by
  rw [Nat.cast_list_sum, List.map_map]; rfl


private lemma addQuadTreeOpt_eq {α : Type} (qk cP cN : ℕ) :
    ∀ (t : QuadAccTree) (k : Bool → QuadAccTree → α),
      (match addQuadTreeOpt qk cP cN t with
       | .none => k false .empty
       | .some t' => k true t') = addQuadTreeCPS qk cP cN t k
  | .empty, _ => rfl
  | .node l nk p m rt, k => by
    unfold addQuadTreeOpt addQuadTreeCPS
    by_cases hbeq : Nat.beq qk nk = true
    · simp only [hbeq, Bool.cond_true, ↓reduceIte, strictNat_eq]
      cases Nat.add p cP <;> cases Nat.add m cN <;> rfl
    · simp only [Bool.eq_false_iff.mpr hbeq, Bool.cond_false, Bool.false_eq_true, ↓reduceIte]
      by_cases hblt : Nat.blt qk nk = true
      · simp only [hblt, Bool.cond_true, ↓reduceIte, ← addQuadTreeOpt_eq qk cP cN l]
        cases addQuadTreeOpt qk cP cN l <;> rfl
      · simp only [Bool.eq_false_iff.mpr hblt, Bool.cond_false, Bool.false_eq_true, ↓reduceIte,
          ← addQuadTreeOpt_eq qk cP cN rt]
        cases addQuadTreeOpt qk cP cN rt <;> rfl

private lemma emitOneOpt_eq {α : Type} (wNeg : Bool) (twoWab : ℕ) (fa fb : List ℕ)
    (wq1 wp1 wq2 wp2 : ℕ) (tree : QuadAccTree) (k : Bool → QuadAccTree → α) :
    (match emitOneOpt wNeg twoWab fa fb wq1 wp1 wq2 wp2 tree with
     | .none => k false .empty
     | .some t' => k true t') = emitOneQuadCPS wNeg twoWab fa fb wq1 wp1 wq2 wp2 tree k := by
  unfold emitOneOpt emitOneQuadCPS pushQuadTreeCPS
  by_cases hm :
      (Nat.beq (Nat.mod wq1 2) (Nat.mod wp1 2) &&
        Nat.beq (Nat.mod wq2 2) (Nat.mod wp2 2)) = true
  · simp only [hm, Bool.cond_true, ↓reduceIte, strictBool_eq, strictNat_eq]
    split_ifs <;> exact addQuadTreeOpt_eq _ _ _ tree k
  · simp [Bool.eq_false_iff.mpr hm]

private lemma offDiagInnerOpt_eq {α : Type} (na : Bool) (wa : ℕ) (fa : List ℕ) :
    ∀ (ds : DetList) (tree : QuadAccTree) (k : Bool → QuadAccTree → α),
      (match offDiagInnerOpt na wa fa ds tree with
       | .none => k false .empty
       | .some t' => k true t') = offDiagInner na wa fa ds tree k
  | .nil, _, _ => rfl
  | .cons nb wb fb rest, tree, k => by
    unfold offDiagInnerOpt offDiagInner
    cases symDiff5Go 52 fa fb 0 0 0 0 0 with
    | lt4 => rfl
    | gt4 _ _ _ _ _ => exact offDiagInnerOpt_eq na wa fa rest tree k
    | eq4 d1 d2 d3 d4 =>
      simp only [strictNatList_eq]
      cases List.filter (fun w ↦ detBitFlips fa w) [d1, d2, d3, d4] with
      | nil => rfl
      | cons wp1 r1 =>
        cases r1 with
        | nil => rfl
        | cons wp2 r2 =>
          cases r2 with
          | cons _ _ => rfl
          | nil =>
            cases List.filter (fun w ↦ !detBitFlips fa w) [d1, d2, d3, d4] with
            | nil => rfl
            | cons wh1 s1 =>
              cases s1 with
              | nil => rfl
              | cons wh2 s2 =>
                cases s2 with
                | cons _ _ => rfl
                | nil =>
                  dsimp only
                  simp only [strictNat_eq, strictBool_eq]
                  rw [← emitOneOpt_eq]
                  cases emitOneOpt _ _ _ _ _ _ _ _ tree with
                  | none => rfl
                  | some t1 =>
                    dsimp only
                    rw [← emitOneOpt_eq]
                    cases emitOneOpt _ _ _ _ _ _ _ _ t1 with
                    | none => rfl
                    | some t2 =>
                      dsimp only
                      rw [← emitOneOpt_eq]
                      cases emitOneOpt _ _ _ _ _ _ _ _ t2 with
                      | none => rfl
                      | some t3 =>
                        dsimp only
                        rw [← emitOneOpt_eq]
                        cases emitOneOpt _ _ _ _ _ _ _ _ t3 with
                        | none => rfl
                        | some t4 =>
                          dsimp only
                          exact offDiagInnerOpt_eq na wa fa rest t4 k

private lemma detListToList_dropDetList :
    ∀ (n : ℕ) (ds : DetList), detListToList (dropDetList n ds) = (detListToList ds).drop n
  | 0, _ => rfl
  | _ + 1, .nil => rfl
  | n + 1, .cons _ _ _ rest => detListToList_dropDetList n rest

private lemma isNilDetList_eq :
    ∀ (ds : DetList), isNilDetList ds = true → detListToList ds = []
  | .nil, _ => rfl
  | .cons _ _ _ _, h => absurd h Bool.false_ne_true

private def upperPairwise {α : Type*} (R : α → α → Prop) : ℕ → List α → Prop
  | 0, _ => True
  | _ + 1, [] => True
  | n + 1, x :: xs => (∀ y ∈ xs, R x y) ∧ upperPairwise R n xs

private lemma upperPairwise_add {α : Type*} {R : α → α → Prop} :
    ∀ (a b : ℕ) (L : List α),
      upperPairwise R a L → upperPairwise R b (L.drop a) → upperPairwise R (a + b) L
  | 0, _, _, _, hb => by simpa using hb
  | a + 1, b, [], _, _ => by rw [Nat.succ_add]; trivial
  | a + 1, b, x :: xs, ⟨hhd, htl⟩, hb => by
    rw [Nat.succ_add]
    exact ⟨hhd, upperPairwise_add a b xs htl hb⟩

private lemma upperPairwise_to_pairwise {α : Type*} {R : α → α → Prop} :
    ∀ (n : ℕ) (L : List α), L.drop n = [] → upperPairwise R n L → List.Pairwise R L
  | 0, L, hnil, _ => by rw [show L = [] from hnil]; exact .nil
  | _ + 1, [], _, _ => .nil
  | n + 1, x :: xs, hnil, ⟨hhd, htl⟩ =>
    .cons hhd (upperPairwise_to_pairwise n xs hnil htl)

private def upperPairsCnt {α : Type*} (g : α → α → ℝ) : ℕ → List α → ℝ
  | 0, _ => 0
  | _ + 1, [] => 0
  | n + 1, x :: xs => (xs.map (g x)).sum + upperPairsCnt g n xs

private lemma upperPairsCnt_add {α : Type*} (g : α → α → ℝ) :
    ∀ (a b : ℕ) (L : List α),
      upperPairsCnt g (a + b) L = upperPairsCnt g a L + upperPairsCnt g b (L.drop a)
  | 0, _, _ => by simp [upperPairsCnt]
  | a + 1, b, [] => by
    rw [Nat.succ_add, upperPairsCnt, upperPairsCnt, List.drop_nil]
    cases b <;> simp [upperPairsCnt]
  | a + 1, b, x :: xs => by
    rw [Nat.succ_add, upperPairsCnt, upperPairsCnt, List.drop_succ_cons,
      upperPairsCnt_add g a b xs, add_assoc]

private lemma upperPairsCnt_eq_sum {α : Type*} (g : α → α → ℝ) :
    ∀ (n : ℕ) (L : List α), L.drop n = [] → upperPairsCnt g n L = upperPairsSum g L
  | 0, L, hnil => by rw [show L = [] from hnil]; rfl
  | _ + 1, [], _ => rfl
  | n + 1, x :: xs, hnil => by
    rw [upperPairsCnt, upperPairsSum, upperPairsCnt_eq_sum g n xs hnil]

private noncomputable abbrev offPairTerm
    (ta tb : Bool × ℕ × List ℕ) : ℝ :=
  2 * (coeffReal ta.1 ta.2.1 * coeffReal tb.1 tb.2.1) *
    (star (detVec (detOfFlips ta.2.2)) ⬝ᵥ
      (thcHamiltonian rThc *ᵥ detVec (detOfFlips tb.2.2))).re

private lemma offDiagOuterCnt_sound :
    ∀ (cnt : ℕ) (ds : DetList)
      (_ : ∀ t ∈ detListToList ds, checkFlipsGo t.2.2 0 0 0 0 = true)
      (tree tree' : QuadAccTree),
      offDiagOuterCnt cnt ds tree = .some tree' →
      upperPairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2)
        cnt (detListToList ds) ∧
      (coefficientUnit / (15360 ^ 2 : ℝ)) *
        (∑ r : Fin 9, ∑ c : Fin 14,
          ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
            (evalQuadAccTree r c tree' - evalQuadAccTree r c tree)) =
        upperPairsCnt offPairTerm cnt (detListToList ds)
  | 0, _, _, tree, tree', hopt => by
    cases hopt
    exact ⟨trivial, by simp [upperPairsCnt]⟩
  | _ + 1, .nil, _, tree, tree', hopt => by
    cases hopt
    exact ⟨trivial, by simp [detListToList, upperPairsCnt]⟩
  | cnt + 1, .cons na wa fa rest, hvalid, tree, tree', hopt => by
    unfold offDiagOuterCnt at hopt
    have hfa : checkFlipsGo fa 0 0 0 0 = true := hvalid (na, wa, fa) List.mem_cons_self
    have hrest : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true :=
      fun t ht ↦ hvalid t (List.mem_cons_of_mem _ ht)
    cases h1 : offDiagInnerOpt na wa fa rest tree with
    | none => rw [h1] at hopt; cases hopt
    | some t1 =>
      rw [h1] at hopt; dsimp -zeta only at hopt
      have hin := offDiagInner_sound na wa hfa rest hrest tree
        (fun ok t ↦ ok = true →
          (∀ tb ∈ detListToList rest, detOfFlips fa ≠ detOfFlips tb.2.2) ∧
          (coefficientUnit / (15360 ^ 2 : ℝ)) *
            (∑ r : Fin 9, ∑ c : Fin 14,
              ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                (evalQuadAccTree r c t - evalQuadAccTree r c tree)) =
            ((detListToList rest).map fun tb ↦ offPairTerm (na, wa, fa) tb).sum)
        (fun _ _ h ↦ h)
      rw [← offDiagInnerOpt_eq, h1] at hin
      obtain ⟨hneq_hd, hsum_hd⟩ := hin rfl
      obtain ⟨hpw_tl, hsum_tl⟩ := offDiagOuterCnt_sound cnt rest hrest t1 tree' hopt
      refine ⟨⟨hneq_hd, hpw_tl⟩, ?_⟩
      have hsplit (r : Fin 9) (c : Fin 14) :
          evalQuadAccTree r c tree' - evalQuadAccTree r c tree =
            (evalQuadAccTree r c t1 - evalQuadAccTree r c tree) +
              (evalQuadAccTree r c tree' - evalQuadAccTree r c t1) := by ring
      simp_rw [hsplit, mul_add, Finset.sum_add_distrib, mul_add, hsum_hd, hsum_tl]
      rfl

private lemma two_pow_testBit : ∀ (x w : ℕ), (2 ^ x).testBit w = Nat.beq w x
  | 0, 0 => rfl
  | 0, w + 1 => by
    rw [Nat.pow_zero, Nat.testBit_succ]
    change (0 : ℕ).testBit w = false
    exact Nat.zero_testBit w
  | x + 1, 0 => by
    rw [Nat.testBit_zero]
    have hmod : (2 ^ (x + 1)) % 2 ≠ 1 := by
      rw [Nat.pow_succ]
      omega
    exact decide_eq_false hmod
  | x + 1, w + 1 => by
    rw [Nat.testBit_succ]
    have hdiv : 2 ^ (x + 1) / 2 = 2 ^ x := by
      rw [Nat.pow_succ]
      omega
    have hbeq : Nat.beq (w + 1) (x + 1) = Nat.beq w x := by
      simp [Nat.beq]
    rw [hdiv, hbeq]
    exact two_pow_testBit x w

private lemma testBit_maskOfFlips :
    ∀ (ws : List ℕ) (e : ℕ), (maskOfFlips ws).testBit e = memNat e ws
  | [], e => by
    unfold maskOfFlips memNat
    exact Nat.zero_testBit e
  | x :: xs, e => by
    unfold maskOfFlips memNat
    rw [Nat.testBit_or, Nat.shiftLeft_eq, one_mul, two_pow_testBit x e, testBit_maskOfFlips xs e]
    cases Nat.beq e x <;> rfl

private lemma clearLowNat_sub (y j : ℕ) (h : (clearLowNat y).testBit j = true) :
    y.testBit j = true := by
  unfold clearLowNat at h
  rw [Nat.testBit_and, Bool.and_eq_true] at h
  exact h.1

private lemma clearLowNat_spec :
    ∀ y : ℕ, y ≠ 0 → ∃ k : ℕ, y.testBit k = true ∧ (clearLowNat y).testBit k = false := by
  intro y
  induction y using Nat.strongRecOn with
  | ind y ih =>
    intro hy0
    by_cases hodd : y % 2 = 1
    · refine ⟨0, ?_, ?_⟩
      · rw [Nat.testBit_zero]; exact decide_eq_true hodd
      · unfold clearLowNat
        rw [Nat.testBit_and, Nat.testBit_zero]
        have hsub : (y - 1) % 2 ≠ 1 := by omega
        simp [decide_eq_false hsub]
    · have hy2_ne : y / 2 ≠ 0 := by omega
      have hy2_lt : y / 2 < y := Nat.div_lt_self (Nat.pos_of_ne_zero hy0) (by decide)
      obtain ⟨k', hk1, hk2⟩ := ih (y / 2) hy2_lt hy2_ne
      refine ⟨k' + 1, ?_, ?_⟩
      · rwa [Nat.testBit_succ]
      · unfold clearLowNat at hk2 ⊢
        rw [Nat.testBit_and] at hk2 ⊢
        have hdiv : (y - 1) / 2 = y / 2 - 1 := by omega
        rw [Nat.testBit_succ, Nat.testBit_succ, hdiv]
        exact hk2

private lemma popGt4_five_bits {d : ℕ} (hf : hasPopLe4 d = false) :
    ∃ e1 e2 e3 e4 e5 : ℕ,
      (e1 ≠ e2 ∧ e1 ≠ e3 ∧ e1 ≠ e4 ∧ e1 ≠ e5 ∧
       e2 ≠ e3 ∧ e2 ≠ e4 ∧ e2 ≠ e5 ∧
       e3 ≠ e4 ∧ e3 ≠ e5 ∧ e4 ≠ e5) ∧
      d.testBit e1 = true ∧ d.testBit e2 = true ∧ d.testBit e3 = true ∧
      d.testBit e4 = true ∧ d.testBit e5 = true := by
  unfold hasPopLe4 at hf
  dsimp only at hf
  set d1 := clearLowNat d
  set d2 := clearLowNat d1
  set d3 := clearLowNat d2
  set d4 := clearLowNat d3
  have hd4 : d4 ≠ 0 := fun h ↦ by rw [h] at hf; exact Bool.noConfusion hf
  have hd3 : d3 ≠ 0 := fun h ↦ hd4 (by simp [d4, clearLowNat, h])
  have hd2 : d2 ≠ 0 := fun h ↦ hd3 (by simp [d3, clearLowNat, h])
  have hd1 : d1 ≠ 0 := fun h ↦ hd2 (by simp [d2, clearLowNat, h])
  have hd0 : d ≠ 0 := fun h ↦ hd1 (by simp [d1, clearLowNat, h])
  obtain ⟨e1, ht1, hc1⟩ := clearLowNat_spec d hd0
  obtain ⟨e2, ht2, hc2⟩ := clearLowNat_spec d1 hd1
  obtain ⟨e3, ht3, hc3⟩ := clearLowNat_spec d2 hd2
  obtain ⟨e4, ht4, hc4⟩ := clearLowNat_spec d3 hd3
  obtain ⟨e5, ht5, _⟩ := clearLowNat_spec d4 hd4
  have h5_d3 : d3.testBit e5 = true := clearLowNat_sub d3 e5 ht5
  have h5_d2 : d2.testBit e5 = true := clearLowNat_sub d2 e5 h5_d3
  have h5_d1 : d1.testBit e5 = true := clearLowNat_sub d1 e5 h5_d2
  have h5_d0 : d.testBit e5 = true := clearLowNat_sub d e5 h5_d1
  have h4_d2 : d2.testBit e4 = true := clearLowNat_sub d2 e4 ht4
  have h4_d1 : d1.testBit e4 = true := clearLowNat_sub d1 e4 h4_d2
  have h4_d0 : d.testBit e4 = true := clearLowNat_sub d e4 h4_d1
  have h3_d1 : d1.testBit e3 = true := clearLowNat_sub d1 e3 ht3
  have h3_d0 : d.testBit e3 = true := clearLowNat_sub d e3 h3_d1
  have h2_d0 : d.testBit e2 = true := clearLowNat_sub d e2 ht2
  have ne_of_bit {x a b : ℕ} (ha : x.testBit a = false) (hb : x.testBit b = true) : a ≠ b :=
    fun heq ↦ by subst heq; rw [ha] at hb; exact Bool.noConfusion hb
  exact ⟨e1, e2, e3, e4, e5,
         ⟨ne_of_bit hc1 ht2, ne_of_bit hc1 h3_d1, ne_of_bit hc1 h4_d1, ne_of_bit hc1 h5_d1,
          ne_of_bit hc2 ht3, ne_of_bit hc2 h4_d2, ne_of_bit hc2 h5_d2,
          ne_of_bit hc3 ht4, ne_of_bit hc3 h5_d3, ne_of_bit hc4 ht5⟩,
         ht1, h2_d0, h3_d0, h4_d0, h5_d0⟩

private lemma xor_maskOfFlips_bit {fa fb : List ℕ}
    (hlta : ∀ w ∈ fa, w < 2 * 58) (hltb : ∀ w ∈ fb, w < 2 * 58)
    {e : ℕ} (he : (maskOfFlips fa ^^^ maskOfFlips fb).testBit e = true) :
    e < 2 * 58 ∧ memNat e fa ≠ memNat e fb := by
  rw [Nat.testBit_xor, testBit_maskOfFlips, testBit_maskOfFlips] at he
  have hne : memNat e fa ≠ memNat e fb := by
    intro h; simp [h] at he
  refine ⟨?_, hne⟩
  cases ha : memNat e fa
  · cases hb : memNat e fb
    · exact absurd (ha.trans hb.symm) hne
    · exact hltb e ((memNat_eq_true_iff e fb).mp hb)
  · exact hlta e ((memNat_eq_true_iff e fa).mp ha)

private lemma offDiagInnerMaskOpt_sound (na : Bool) (wa : ℕ) {fa : List ℕ}
    (hfa : checkFlipsGo fa 0 0 0 0 = true) :
    ∀ (rest : DetList)
      (_ : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true)
      (tree tree' : QuadAccTree),
      offDiagInnerMaskOpt na wa (maskOfFlips fa) fa (toMaskDetList rest) tree = .some tree' →
      (∀ tb ∈ detListToList rest, detOfFlips fa ≠ detOfFlips tb.2.2) ∧
      (coefficientUnit / (15360 ^ 2 : ℝ)) *
        (∑ r : Fin 9, ∑ c : Fin 14,
          ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
            (evalQuadAccTree r c tree' - evalQuadAccTree r c tree)) =
        ((detListToList rest).map fun tb ↦ offPairTerm (na, wa, fa) tb).sum
  | .nil, _, tree, tree', hopt => by
    simp only [toMaskDetList, offDiagInnerMaskOpt] at hopt
    cases hopt
    exact ⟨(fun _ hm ↦ by cases hm), by simp [detListToList]⟩
  | .cons nb wb fb rest, hrest, tree, tree', hopt => by
    simp only [toMaskDetList, strictNat_eq] at hopt
    unfold offDiagInnerMaskOpt at hopt
    have hfb : checkFlipsGo fb 0 0 0 0 = true := hrest (nb, wb, fb) List.mem_cons_self
    have hrest' : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true :=
      fun t ht ↦ hrest t (List.mem_cons_of_mem _ ht)
    cases hpop : hasPopLe4 (maskOfFlips fa ^^^ maskOfFlips fb) with
    | false =>
      rw [hpop] at hopt; dsimp -zeta only at hopt
      obtain ⟨_, hlta, _, _⟩ := checkFlipsGo_det_valid hfa
      obtain ⟨_, hltb, _, _⟩ := checkFlipsGo_det_valid hfb
      obtain ⟨e1, e2, e3, e4, e5,
        ⟨h12, h13, h14, h15, h23, h24, h25, h34, h35, h45⟩,
        hb1, hb2, hb3, hb4, hb5⟩ := popGt4_five_bits hpop
      have he1 := xor_maskOfFlips_bit hlta hltb hb1
      have he2 := xor_maskOfFlips_bit hlta hltb hb2
      have he3 := xor_maskOfFlips_bit hlta hltb hb3
      have he4 := xor_maskOfFlips_bit hlta hltb hb4
      have he5 := xor_maskOfFlips_bit hlta hltb hb5
      have hne_ab : detOfFlips fa ≠ detOfFlips fb := by
        intro heq
        exact (detBitFlips_ne_iff.mpr he1.2) (congr_fun heq ⟨e1, he1.1⟩)
      have hzero : (star (detVec (detOfFlips fa)) ⬝ᵥ
          (thcHamiltonian rThc *ᵥ detVec (detOfFlips fb))).re = 0 := by
        let w1 : Fin (2 * 58) := ⟨e1, he1.1⟩
        let w2 : Fin (2 * 58) := ⟨e2, he2.1⟩
        let w3 : Fin (2 * 58) := ⟨e3, he3.1⟩
        let w4 : Fin (2 * 58) := ⟨e4, he4.1⟩
        let w5 : Fin (2 * 58) := ⟨e5, he5.1⟩
        let s : Finset (Fin (2 * 58)) := {w1, w2, w3, w4, w5}
        have hcard : 5 ≤ s.card := by
          have hc : s.card = 5 := by
            have n12 : w1 ≠ w2 := Fin.ne_of_val_ne h12
            have n13 : w1 ≠ w3 := Fin.ne_of_val_ne h13
            have n14 : w1 ≠ w4 := Fin.ne_of_val_ne h14
            have n15 : w1 ≠ w5 := Fin.ne_of_val_ne h15
            have n23 : w2 ≠ w3 := Fin.ne_of_val_ne h23
            have n24 : w2 ≠ w4 := Fin.ne_of_val_ne h24
            have n25 : w2 ≠ w5 := Fin.ne_of_val_ne h25
            have n34 : w3 ≠ w4 := Fin.ne_of_val_ne h34
            have n35 : w3 ≠ w5 := Fin.ne_of_val_ne h35
            have n45 : w4 ≠ w5 := Fin.ne_of_val_ne h45
            simp [s, n12, n13, n14, n15, n23, n24, n25, n34, n35, n45]
          omega
        have hs_diff : ∀ w ∈ s, detOfFlips fa w ≠ detOfFlips fb w := by
          intro w hw
          simp only [s, Finset.mem_insert, Finset.mem_singleton] at hw
          rcases hw with rfl | rfl | rfl | rfl | rfl
          · exact detBitFlips_ne_iff.mpr he1.2
          · exact detBitFlips_ne_iff.mpr he2.2
          · exact detBitFlips_ne_iff.mpr he3.2
          · exact detBitFlips_ne_iff.mpr he4.2
          · exact detBitFlips_ne_iff.mpr he5.2
        rw [dotProduct_thcHamiltonian_eq_zero_of_diff5 (detOfFlips fa) (detOfFlips fb)
          hs_diff hcard, Complex.zero_re]
      obtain ⟨hneqs, hsum⟩ := offDiagInnerMaskOpt_sound na wa hfa rest hrest' tree tree' hopt
      refine ⟨?_, ?_⟩
      · intro tb htb
        rcases List.mem_cons.mp htb with rfl | htl
        · exact hne_ab
        · exact hneqs tb htl
      · simp only [detListToList, offPairTerm, List.map_cons, List.sum_cons, hzero,
          mul_zero, zero_add]
        exact hsum
    | true =>
      rw [hpop] at hopt; dsimp -zeta only at hopt
      cases hstep : offDiagInnerOpt na wa fa (.cons nb wb fb .nil) tree with
      | none => rw [hstep] at hopt; cases hopt
      | some t1 =>
        rw [hstep] at hopt; dsimp -zeta only at hopt
        have h1_valid : ∀ t ∈ detListToList (.cons nb wb fb .nil),
            checkFlipsGo t.2.2 0 0 0 0 = true := by
          intro t ht
          rcases List.mem_cons.mp ht with rfl | hnil
          · exact hfb
          · cases hnil
        have hin := offDiagInner_sound na wa hfa (.cons nb wb fb .nil) h1_valid tree
          (fun ok t ↦ ok = true →
            (∀ tb ∈ detListToList (.cons nb wb fb .nil), detOfFlips fa ≠ detOfFlips tb.2.2) ∧
            (coefficientUnit / (15360 ^ 2 : ℝ)) *
              (∑ r : Fin 9, ∑ c : Fin 14,
                ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
                  (evalQuadAccTree r c t - evalQuadAccTree r c tree)) =
              ((detListToList (.cons nb wb fb .nil)).map fun tb ↦ offPairTerm (na, wa, fa) tb).sum)
          (fun _ _ h ↦ h)
        rw [← offDiagInnerOpt_eq, hstep] at hin
        obtain ⟨hneq_1, hsum_1⟩ := hin rfl
        have hne_ab : detOfFlips fa ≠ detOfFlips fb := hneq_1 (nb, wb, fb) List.mem_cons_self
        simp only [detListToList, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
          add_zero] at hsum_1
        obtain ⟨hneqs, hsum_rest⟩ := offDiagInnerMaskOpt_sound na wa hfa rest hrest' t1 tree' hopt
        refine ⟨?_, ?_⟩
        · intro tb htb
          rcases List.mem_cons.mp htb with rfl | htl
          · exact hne_ab
          · exact hneqs tb htl
        · have hsplit (r : Fin 9) (c : Fin 14) :
              evalQuadAccTree r c tree' - evalQuadAccTree r c tree =
                (evalQuadAccTree r c t1 - evalQuadAccTree r c tree) +
                  (evalQuadAccTree r c tree' - evalQuadAccTree r c t1) := by ring
          simp_rw [hsplit, mul_add, Finset.sum_add_distrib, mul_add, hsum_1, hsum_rest]
          rfl

private lemma offDiagOuterMaskCnt_sound :
    ∀ (cnt : ℕ) (ds : DetList)
      (_ : ∀ t ∈ detListToList ds, checkFlipsGo t.2.2 0 0 0 0 = true)
      (tree tree' : QuadAccTree),
      offDiagOuterMaskCnt cnt (toMaskDetList ds) tree = .some tree' →
      upperPairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2)
        cnt (detListToList ds) ∧
      (coefficientUnit / (15360 ^ 2 : ℝ)) *
        (∑ r : Fin 9, ∑ c : Fin 14,
          ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) *
            (evalQuadAccTree r c tree' - evalQuadAccTree r c tree)) =
        upperPairsCnt offPairTerm cnt (detListToList ds)
  | 0, _, _, tree, tree', hopt => by
    unfold offDiagOuterMaskCnt at hopt
    cases hopt
    exact ⟨trivial, by simp [upperPairsCnt]⟩
  | _ + 1, .nil, _, tree, tree', hopt => by
    simp only [toMaskDetList, offDiagOuterMaskCnt] at hopt
    cases hopt
    exact ⟨trivial, by simp [detListToList, upperPairsCnt]⟩
  | cnt + 1, .cons na wa fa rest, hvalid, tree, tree', hopt => by
    simp only [toMaskDetList, strictNat_eq] at hopt
    unfold offDiagOuterMaskCnt at hopt
    have hfa : checkFlipsGo fa 0 0 0 0 = true := hvalid (na, wa, fa) List.mem_cons_self
    have hrest : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true :=
      fun t ht ↦ hvalid t (List.mem_cons_of_mem _ ht)
    cases h1 : offDiagInnerMaskOpt na wa (maskOfFlips fa) fa (toMaskDetList rest) tree with
    | none => rw [h1] at hopt; cases hopt
    | some t1 =>
      rw [h1] at hopt; dsimp -zeta only at hopt
      obtain ⟨hneq_hd, hsum_hd⟩ := offDiagInnerMaskOpt_sound na wa hfa rest hrest tree t1 h1
      obtain ⟨hpw_tl, hsum_tl⟩ := offDiagOuterMaskCnt_sound cnt rest hrest t1 tree' hopt
      refine ⟨⟨hneq_hd, hpw_tl⟩, ?_⟩
      have hsplit (r : Fin 9) (c : Fin 14) :
          evalQuadAccTree r c tree' - evalQuadAccTree r c tree =
            (evalQuadAccTree r c t1 - evalQuadAccTree r c tree) +
              (evalQuadAccTree r c tree' - evalQuadAccTree r c t1) := by ring
      simp_rw [hsplit, mul_add, Finset.sum_add_distrib, mul_add, hsum_hd, hsum_tl]
      rfl

private lemma sliceCert_sound
    {hvalid : ∀ t ∈ detListToList deepDetsData, checkFlipsGo t.2.2 0 0 0 0 = true}
    {skip cnt : ℕ} {expected : QuadList}
    (hs : checkPhase12SliceCert skip cnt expected = true) :
    upperPairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2)
      cnt ((detListToList deepDetsData).drop skip) ∧
    (coefficientUnit / (15360 ^ 2 : ℝ)) *
      (∑ r : Fin 9, ∑ c : Fin 14,
        ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) * evalQuadList r c expected) =
      upperPairsCnt offPairTerm cnt ((detListToList deepDetsData).drop skip) := by
  unfold checkPhase12SliceCert at hs
  simp -iota only [strictDetList_eq, strictNatList_eq, strictNat_eq] at hs
  let goalProp : Prop :=
    upperPairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2)
      cnt ((detListToList deepDetsData).drop skip) ∧
    (coefficientUnit / (15360 ^ 2 : ℝ)) *
      (∑ r : Fin 9, ∑ c : Fin 14,
        ((2 * (deepFragOuterNat r c : ℤ) : ℤ) : ℝ) * evalQuadList r c expected) =
      upperPairsCnt offPairTerm cnt ((detListToList deepDetsData).drop skip)
  let fImp : Bool → Prop := fun b ↦ b = true → goalProp
  have h1 := buildZeroQuadTreeCPS_sound 14 (listLenGo allQuadKeysCert 0) allQuadKeysCert
    (fun zeroTree _ ↦ fImp (
      match offDiagOuterMaskCnt cnt (toMaskDetList (dropDetList skip deepDetsData)) zeroTree with
      | .none => false
      | .some sliceTree =>
        flattenQuadTreeCPS sliceTree .nil fun quads ↦ beqQuadList quads expected))
    fun zeroTree _ hzero hk1 ↦ by
      cases hoc : offDiagOuterMaskCnt cnt
          (toMaskDetList (dropDetList skip deepDetsData)) zeroTree with
      | none => rw [hoc] at hk1; exact absurd hk1 Bool.false_ne_true
      | some sliceTree =>
        rw [hoc] at hk1; dsimp -zeta only at hk1
        have h2 := flattenQuadTreeCPS_sound sliceTree .nil
          (fun quads ↦ fImp (beqQuadList quads expected))
          fun quads hflat hk2 ↦ by
            have hqeq := beqQuadList_eq hk2
            subst hqeq
            have hv_drop : ∀ t ∈ detListToList (dropDetList skip deepDetsData),
                checkFlipsGo t.2.2 0 0 0 0 = true := by
              rw [detListToList_dropDetList]
              exact fun t ht ↦ hvalid t (List.mem_of_mem_drop ht)
            obtain ⟨hpw, hsum⟩ := offDiagOuterMaskCnt_sound cnt _ hv_drop zeroTree sliceTree hoc
            rw [detListToList_dropDetList] at hpw hsum
            refine ⟨hpw, ?_⟩
            rw [← hsum]
            refine congrArg ((coefficientUnit / (15360 ^ 2 : ℝ)) * ·)
              (Finset.sum_congr rfl fun r _ ↦ Finset.sum_congr rfl fun c _ ↦ ?_)
            have hf := hflat r c
            simp only [evalQuadList, add_zero, hzero r c, sub_zero] at hf ⊢
            rw [hf]
        rw [flattenQuadTreeCPS_comp fImp] at h2
        exact h2 hk1
  rw [buildZeroQuadTreeCPS_comp fImp] at h1
  exact h1 hs

private lemma addQuadListOpt_sound :
    ∀ (qs : QuadList) (tree tree' : QuadAccTree),
      addQuadListOpt qs tree = .some tree' →
      ∀ r c, evalQuadAccTree r c tree' = evalQuadAccTree r c tree + evalQuadList r c qs
  | .nil, tree, tree', h, r, c => by
    cases h; simp [evalQuadList]
  | .cons k1 k2 cP cN rest, tree, tree', h, r, c => by
    unfold addQuadListOpt at h
    by_cases hk2 : Nat.blt k2 4096 = true
    · simp -iota only [hk2, Bool.cond_true] at h
      have hlt2 : k2 < 4096 := Nat.blt_eq.mp hk2
      cases hadd : addQuadTreeOpt (Nat.add (Nat.mul 4096 k1) k2) cP cN tree with
      | none => rw [hadd] at h; cases h
      | some t1 =>
        rw [hadd] at h; dsimp -zeta only at h
        have hstep := addQuadTreeCPS_sound (Nat.add (Nat.mul 4096 k1) k2) cP cN tree
          (fun ok t ↦ ok = true → ∀ r' c', evalQuadAccTree r' c' t = evalQuadAccTree r' c' tree +
            ((cP : ℝ) - (cN : ℝ)) *
              (keyModeReal r' c' ((Nat.add (Nat.mul 4096 k1) k2) / 4096) *
                keyModeReal r' c' ((Nat.add (Nat.mul 4096 k1) k2) % 4096)))
          (fun _ _ ht ↦ ht)
        rw [← addQuadTreeOpt_eq, hadd] at hstep
        have ht1 := hstep rfl r c
        simp only [Nat.add_eq, Nat.mul_eq] at ht1
        have hd : (4096 * k1 + k2) / 4096 = k1 := by omega
        have hm : (4096 * k1 + k2) % 4096 = k2 := by omega
        rw [hd, hm] at ht1
        rw [addQuadListOpt_sound rest t1 tree' h r c, ht1, evalQuadList]
        ring
    · simp [Bool.eq_false_iff.mpr hk2] at h

private lemma addQuadSlicesOpt_sound :
    ∀ (qss : List QuadList) (tree tree' : QuadAccTree),
      addQuadSlicesOpt qss tree = .some tree' →
      ∀ r c, evalQuadAccTree r c tree' - evalQuadAccTree r c tree =
        (qss.map (evalQuadList r c)).sum
  | [], tree, tree', h, r, c => by
    cases h; simp
  | qs :: qss, tree, tree', h, r, c => by
    unfold addQuadSlicesOpt at h
    cases h1 : addQuadListOpt qs tree with
    | none => rw [h1] at h; cases h
    | some t1 =>
      rw [h1] at h; dsimp -zeta only at h
      have hhd := addQuadListOpt_sound qs tree t1 h1 r c
      have htl := addQuadSlicesOpt_sound qss t1 tree' h r c
      simp only [List.map_cons, List.sum_cons]
      linarith

private lemma combine_slice {L : List (Bool × ℕ × List ℕ)} {s a b : ℕ} {e1 e2 : ℝ}
    (h1 : upperPairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2) a (L.drop s) ∧
      e1 = upperPairsCnt offPairTerm a (L.drop s))
    (h2 : upperPairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2) b (L.drop (s + a)) ∧
      e2 = upperPairsCnt offPairTerm b (L.drop (s + a))) :
    upperPairwise (fun ta tb ↦ detOfFlips ta.2.2 ≠ detOfFlips tb.2.2) (a + b) (L.drop s) ∧
      e1 + e2 = upperPairsCnt offPairTerm (a + b) (L.drop s) := by
  have hd : (L.drop s).drop a = L.drop (s + a) := by rw [List.drop_drop, Nat.add_comm]
  exact ⟨upperPairwise_add a b (L.drop s) h1.1 (hd.symm ▸ h2.1),
    by rw [upperPairsCnt_add offPairTerm a b (L.drop s), hd, h1.2, h2.2]⟩

private lemma diagEighthCert_sound {ds : DetList} {inWireW outWireW : List ℕ}
    {expQuads : QuadList}
    (hvalid : ∀ t ∈ detListToList ds, checkFlipsGo t.2.2 0 0 0 0 = true)
    (hc : checkDiagEighthCert ds inWireW outWireW expQuads = true) :
    (∀ j : ℕ, j < 116 → outWireW.getD j 0 = inWireW.getD j 0 +
      ((detListToList ds).map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum) ∧
    (∀ r c, evalQuadList r c expQuads =
      ((detListToList ds).map (diagDetModeTerm r c)).sum) := by
  unfold checkDiagEighthCert at hc
  have hlen_b : Nat.beq inWireW.length 116 = true := by
    cases h : Nat.beq inWireW.length 116
    · rw [h] at hc
      simp -iota only [Bool.not_false, ↓reduceIte] at hc
      exact absurd hc Bool.false_ne_true
    · rfl
  rw [hlen_b] at hc
  simp -iota only [Bool.not_true, Bool.false_eq_true, ↓reduceIte,
    strictDetList_eq, strictNatList_eq, strictNat_eq] at hc
  have hlen_in : inWireW.length = 116 := Nat.beq_eq.mp hlen_b
  let goalProp : Prop :=
    (∀ j : ℕ, j < 116 → outWireW.getD j 0 = inWireW.getD j 0 +
      ((detListToList ds).map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum) ∧
    (∀ r c, evalQuadList r c expQuads =
      ((detListToList ds).map (diagDetModeTerm r c)).sum)
  let fImp : Bool → Prop := fun b ↦ b = true → goalProp
  have h1 := buildZeroQuadTreeCPS_sound 14 (listLenGo allQuadKeysCert 0) allQuadKeysCert
    (fun zeroTree _ ↦ fImp (
      buildDiagStep ds inWireW zeroTree fun okD wOut qTree ↦
        if !okD then false
        else flattenQuadTreeCPS qTree .nil fun quads ↦
          beqNatList wOut outWireW && beqQuadList quads expQuads))
    fun zeroTree _ hzero hk1 ↦ by
      have h2 := buildDiagStep_aux ds hvalid inWireW hlen_in zeroTree
        (fun okD wOut qTree ↦ fImp (
          if !okD then false
          else flattenQuadTreeCPS qTree .nil fun quads ↦
            beqNatList wOut outWireW && beqQuadList quads expQuads))
        fun okD wOut qTree hstep hk2 ↦ by
          cases okD with
          | false => exact absurd hk2 Bool.false_ne_true
          | true =>
            simp -iota only [Bool.not_true, Bool.false_eq_true, ↓reduceIte] at hk2
            have h3 := flattenQuadTreeCPS_sound qTree .nil
              (fun quads ↦ fImp (beqNatList wOut outWireW && beqQuadList quads expQuads))
              fun quads hflat hk3 ↦ by
                obtain ⟨hbw, hbq⟩ := Bool.and_eq_true_iff.mp hk3
                have hw_eq := beqNatList_eq hbw
                have hq_eq := beqQuadList_eq hbq
                obtain ⟨_hlen_out, hget_out, hq_out⟩ := hstep rfl
                rw [hw_eq] at hget_out
                refine ⟨hget_out, fun r c ↦ ?_⟩
                have hf0 := hflat r c
                simp only [evalQuadList, add_zero] at hf0
                rw [← hq_eq, hf0, hq_out r c, hzero r c, zero_add]
            rw [flattenQuadTreeCPS_comp fImp] at h3
            exact h3 hk2
      rw [buildDiagStep_comp fImp] at h2
      exact h2 hk1
  rw [buildZeroQuadTreeCPS_comp fImp] at h1
  exact h1 hc

private lemma combine_diag_step {L₁ L₂ : List (Bool × ℕ × List ℕ)}
    {w₀ w₁ w₂ : List ℕ} {e₁ e₂ : Fin 9 → Fin 14 → ℝ}
    (h₁ : (∀ j : ℕ, j < 116 → w₁.getD j 0 = w₀.getD j 0 +
        (L₁.map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum) ∧
      (∀ r c, e₁ r c = (L₁.map (diagDetModeTerm r c)).sum))
    (h₂ : (∀ j : ℕ, j < 116 → w₂.getD j 0 = w₁.getD j 0 +
        (L₂.map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum) ∧
      (∀ r c, e₂ r c = (L₂.map (diagDetModeTerm r c)).sum)) :
    (∀ j : ℕ, j < 116 → w₂.getD j 0 = w₀.getD j 0 +
        ((L₁ ++ L₂).map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum) ∧
      (∀ r c, e₁ r c + e₂ r c = ((L₁ ++ L₂).map (diagDetModeTerm r c)).sum) := by
  refine ⟨fun j hj ↦ ?_, fun r c ↦ ?_⟩
  · rw [h₂.1 j hj, h₁.1 j hj, List.map_append, List.sum_append, Nat.add_assoc]
  · rw [h₁.2 r c, h₂.2 r c, List.map_append, List.sum_append]

