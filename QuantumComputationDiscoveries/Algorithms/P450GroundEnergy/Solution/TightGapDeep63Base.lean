/-- Internal CIPSI certificate helper `OrbTree`. -/
inductive OrbTree : Type
  /-- Constructor `empty` of `OrbTree`. -/
  | empty : OrbTree
  /-- Constructor `node` of `OrbTree`. -/
  | node : OrbTree → ℕ → ℕ → OrbTree → OrbTree

/-- Internal CIPSI certificate helper `listLenGo`. -/
def listLenGo {α : Type} : List α → ℕ → ℕ
  | [], acc => acc
  | _ :: xs, acc => listLenGo xs (Nat.add acc 1)

/-- Internal CIPSI certificate helper `buildOrbTreeCPS`. -/
def buildOrbTreeCPS {α : Type} : ℕ → ℕ → List ℕ → (OrbTree → α) → α
  | 0, _, _, k => k .empty
  | _ + 1, _, [], k => k .empty
  | fuel + 1, baseIdx, xs, k =>
    strictNat (listLenGo xs 0) fun n ↦
    if Nat.beq n 0 then k .empty
    else
      strictNat (Nat.div n 2) fun half ↦
      splitAtList half xs fun lxs rAll ↦
      match rAll with
      | [] => buildOrbTreeCPS fuel baseIdx lxs k
      | v :: rxs =>
        strictNat (Nat.add baseIdx half) fun midIdx ↦
        strictNat v fun v' ↦
        buildOrbTreeCPS fuel baseIdx lxs fun lT ↦
        buildOrbTreeCPS fuel (Nat.add midIdx 1) rxs fun rT ↦
          k (.node lT midIdx v' rT)

/-- Internal CIPSI certificate helper `lookupOrbCPS`. -/
def lookupOrbCPS {α : Type} : OrbTree → ℕ → (Bool → ℕ → α) → α
  | .empty, _, k => k false 0
  | .node l idx val r, q, k =>
    if Nat.beq q idx then k true val
    else if Nat.blt q idx then lookupOrbCPS l q k
    else lookupOrbCPS r q k

/-- Internal CIPSI certificate helper `KeyIvTree`. -/
inductive KeyIvTree : Type
  /-- Constructor `empty` of `KeyIvTree`. -/
  | empty : KeyIvTree
  /-- Constructor `node` of `KeyIvTree`. -/
  | node : KeyIvTree → ℕ → ℕ → ℕ → KeyIvTree → KeyIvTree

/-- Internal CIPSI certificate helper `buildIvTreeFastCPS`. -/
def buildIvTreeFastCPS {α : Type} : ℕ → ℕ → IvList → (KeyIvTree → IvList → α) → α
  | 0, _, xs, k => k .empty xs
  | _ + 1, 0, xs, k => k .empty xs
  | _ + 1, _, .nil, k => k .empty .nil
  | fuel + 1, n, xs, k =>
    if Nat.beq n 1 then
      match xs with
      | .nil => k .empty .nil
      | .cons nk lo w rest => k (.node .empty nk lo w .empty) rest
    else
      strictNat (Nat.div n 2) fun half ↦
      strictNat (Nat.sub (Nat.sub n 1) half) fun rLen ↦
      buildIvTreeFastCPS fuel half xs fun lTree midAndRight ↦
      match midAndRight with
      | .nil => k lTree .nil
      | .cons nk lo w rightXs =>
        buildIvTreeFastCPS fuel rLen rightXs fun rTree remXs ↦
          k (.node lTree nk lo w rTree) remXs

/-- Internal CIPSI certificate helper `lookupKeyIv`. -/
def lookupKeyIv {α : Type} : KeyIvTree → ℕ → (Bool → ℕ → ℕ → α) → α
  | .empty, _, k => k false 0 0
  | .node l nk lo w r, qk, k =>
    if Nat.beq qk nk then k true lo w
    else if Nat.blt qk nk then lookupKeyIv l qk k
    else lookupKeyIv r qk k

