        fun ok1 sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 ↦
      evalTermCPS refLo refW pos_3 neg2 rad2 fun ok2 p_3 n_3 ↦
      evalMQuadsGo m2Tree quads 0 0 fun ok3 mqP mqN ↦
      if ok1 && ok2 && ok3 then
        strictNat (Nat.div sdpLo 100000) fun kLo ↦
        strictNat (Nat.div (Nat.add (Nat.add sdpLo sdpW) 99999) 100000) fun kHi ↦
        strictNat (Nat.mul (Nat.mul 4 fw) (Nat.add w29 sumNeg)) fun p_4 ↦
        strictNat (Nat.mul (Nat.mul 4 fw) (Nat.add 16384 sumPos)) fun n_4 ↦
        accSignedIv 0 0 p_4 n_4 sdpOff10 kLo (Nat.sub kHi kLo) fun modeP modeN ↦
        strictNat (Nat.mul (Nat.mul 2 fw) (Nat.add p_3 mqP)) fun addP ↦
        strictNat (Nat.mul (Nat.mul 2 fw) (Nat.add n_3 mqN)) fun addN ↦
        normPN (Nat.add (Nat.add frP modeP) addP) (Nat.add (Nat.add frN modeN) addN)
          fun frP' frN' ↦
          modesLoopGo diagGs activeGs wTot dTotP dTotN quads fwRow
            rem (Nat.add cIdx 1) iwRows.tail frP' frN' k
      else k false 0 0

/-- Internal Deep certificate checker `checkScaledCipsi`. -/
def checkScaledCipsi (obP obN frP frN : ℕ) : Bool :=
  let s2 := Nat.mul 15360 15360
  let cOb := Nat.mul 973864 s2
  let cFr := Nat.mul 973864 1000000
  let rhsConst := Nat.mul (Nat.mul (Nat.mul 1301526 188416) s2) (Nat.mul 100000 deepNormSq)
  let lhs := Nat.add (Nat.add (Nat.mul cOb obP) (Nat.mul cFr frP)) rhsConst
  let rhs := Nat.add (Nat.mul cOb obN) (Nat.mul cFr frN)
  Nat.ble lhs rhs


/-- Internal Deep certificate helper `emitOneOpt`. -/
def emitOneOpt (wNeg : Bool) (twoWab : ℕ) (fa fb : List ℕ)
    (wq1 wp1 wq2 wp2 : ℕ) (tree : QuadAccTree) : OptQTree :=
  bif Nat.beq (Nat.mod wq1 2) (Nat.mod wp1 2) && Nat.beq (Nat.mod wq2 2) (Nat.mod wp2 2) then
    let neg := xor wNeg (xor (exciteNegFlips fa wq1 wp1) (exciteNegFlips fb wq2 wp2))
    let k1 := pqKey (Nat.div wp1 2) (Nat.div wq1 2)
    let k2 := pqKey (Nat.div wp2 2) (Nat.div wq2 2)
    let qk := if Nat.ble k1 k2 then Nat.add (Nat.mul 4096 k1) k2
              else Nat.add (Nat.mul 4096 k2) k1
    if neg then addQuadTreeOpt qk 0 twoWab tree else addQuadTreeOpt qk twoWab 0 tree
  else .some tree

/-- Internal Deep certificate helper `offDiagInnerOpt`. -/
def offDiagInnerOpt (na : Bool) (wa : ℕ) (fa : List ℕ) :
    DetList → QuadAccTree → OptQTree
  | .nil, tree => .some tree
  | .cons nb wb fb rest, tree =>
    match symDiff5Go 52 fa fb 0 0 0 0 0 with
    | .lt4 => .none
    | .gt4 _ _ _ _ _ => offDiagInnerOpt na wa fa rest tree
    | .eq4 d1 d2 d3 d4 =>
      let diff := [d1, d2, d3, d4]
      let wps := diff.filter (fun w ↦ detBitFlips fa w)
      let whs := diff.filter (fun w ↦ !detBitFlips fa w)
      match wps, whs with
      | [wp1, wp2], [wh1, wh2] =>
        let twoWab := Nat.mul 2 (Nat.mul wa wb)
        let wNeg := xor na nb
        match emitOneOpt wNeg twoWab fa fb wp1 wh1 wh2 wp2 tree with
        | .none => .none
        | .some t1 =>
        match emitOneOpt wNeg twoWab fa fb wp1 wh2 wh1 wp2 t1 with
        | .none => .none
        | .some t2 =>
        match emitOneOpt wNeg twoWab fa fb wp2 wh1 wh2 wp1 t2 with
        | .none => .none
        | .some t3 =>
        match emitOneOpt wNeg twoWab fa fb wp2 wh2 wh1 wp1 t3 with
        | .none => .none
        | .some t4 => offDiagInnerOpt na wa fa rest t4
      | _, _ => .none

/-- Internal Deep certificate helper `dropDetList`. -/
def dropDetList : ℕ → DetList → DetList
  | 0, ds => ds
  | _ + 1, .nil => .nil
  | n + 1, .cons _ _ _ rest => dropDetList n rest

/-- Internal Deep certificate helper `isNilDetList`. -/
def isNilDetList : DetList → Bool
  | .nil => true
  | .cons _ _ _ _ => false

/-- Internal Deep certificate helper `MaskDetList`. -/
inductive MaskDetList : Type
  | nil : MaskDetList
  | cons : Bool → ℕ → ℕ → List ℕ → MaskDetList → MaskDetList

/-- Internal Deep certificate helper `maskOfFlips`. -/
def maskOfFlips : List ℕ → ℕ
  | [] => 0
  | w :: ws => (1 <<< w) ||| maskOfFlips ws

/-- Internal Deep certificate helper `toMaskDetList`. -/
def toMaskDetList : DetList → MaskDetList
  | .nil => .nil
  | .cons na wa fa rest =>
    strictNat (maskOfFlips fa) fun ma ↦ .cons na wa ma fa (toMaskDetList rest)

/-- Internal Deep certificate helper `clearLowNat`. -/
def clearLowNat (x : ℕ) : ℕ := x &&& (x - 1)

/-- Internal Deep certificate helper `hasPopLe4`. -/
def hasPopLe4 (x : ℕ) : Bool :=
  let x1 := clearLowNat x
  let x2 := clearLowNat x1
  let x3 := clearLowNat x2
  Nat.beq (clearLowNat x3) 0

/-- Internal Deep certificate helper `offDiagInnerMaskOpt`. -/
def offDiagInnerMaskOpt (na : Bool) (wa ma : ℕ) (fa : List ℕ) :
    MaskDetList → QuadAccTree → OptQTree
  | .nil, tree => .some tree
  | .cons nb wb mb fb rest, tree =>
    match hasPopLe4 (ma ^^^ mb) with
    | false => offDiagInnerMaskOpt na wa ma fa rest tree
    | true =>
      match offDiagInnerOpt na wa fa (.cons nb wb fb .nil) tree with
      | .none => .none
      | .some t1 => offDiagInnerMaskOpt na wa ma fa rest t1

/-- Internal Deep certificate helper `offDiagOuterMaskCnt`. -/
def offDiagOuterMaskCnt : ℕ → MaskDetList → QuadAccTree → OptQTree
  | 0, _, tree => .some tree
  | _ + 1, .nil, tree => .some tree
  | rem + 1, .cons na wa ma fa rest, tree =>
    match offDiagInnerMaskOpt na wa ma fa rest tree with
    | .none => .none
    | .some tree' => offDiagOuterMaskCnt rem rest tree'

/-- Internal Deep certificate helper `offDiagOuterCnt`. -/
def offDiagOuterCnt : ℕ → DetList → QuadAccTree → OptQTree
  | 0, _, tree => .some tree
  | _ + 1, .nil, tree => .some tree
  | rem + 1, .cons na wa fa rest, tree =>
    match offDiagInnerOpt na wa fa rest tree with
    | .none => .none
    | .some tree' => offDiagOuterCnt rem rest tree'

/-- Internal Deep certificate helper `addQuadListOpt`. -/
def addQuadListOpt : QuadList → QuadAccTree → OptQTree
  | .nil, tree => .some tree
  | .cons k1 k2 cP cN rest, tree =>
    bif Nat.blt k2 4096 then
      match addQuadTreeOpt (Nat.add (Nat.mul 4096 k1) k2) cP cN tree with
      | .none => .none
      | .some t1 => addQuadListOpt rest t1
    else .none

/-- Internal Deep certificate helper `addQuadSlicesOpt`. -/
def addQuadSlicesOpt : List QuadList → QuadAccTree → OptQTree
  | [], tree => .some tree
  | qs :: qss, tree =>
    match addQuadListOpt qs tree with
    | .none => .none
    | .some t1 => addQuadSlicesOpt qss t1

/-- Internal Deep certificate helper `mulZIvF`. -/
def mulZIvF {α : Type} (z1 l1 w1 z2 l2 w2 divBy newOff : ℕ)
    (k : Bool → ℕ → ℕ → α) : α :=
  let c1 := Nat.add (Nat.mul 2 l1) w1
  let zz1 := Nat.mul 2 z1
  let c2 := Nat.add (Nat.mul 2 l2) w2
  let zz2 := Nat.mul 2 z2
  let pA := Nat.add (Nat.mul c1 c2) (Nat.mul zz1 zz2)
  let nA := Nat.add (Nat.mul zz2 c1) (Nat.mul zz1 c2)
  let m1 := absDiffNat c1 zz1
  let m2 := absDiffNat c2 zz2
  let rad := Nat.add (Nat.add (Nat.mul w1 m2) (Nat.mul m1 w2)) (Nat.mul w1 w2)
  let div4 := Nat.mul 4 divBy
  let base := Nat.mul newOff div4
  let req := Nat.add nA rad
  let bp := Nat.add base pA
  if Nat.ble req bp && Nat.blt 0 div4 then
    strictNat (Nat.div (Nat.sub bp req) div4) fun lo ↦
    let hi := Nat.div (Nat.add (Nat.sub (Nat.add bp rad) nA) (Nat.sub div4 1)) div4
    strictNat (Nat.sub hi lo) fun w ↦ k true lo w
  else k false 0 0

/-- Internal Deep certificate helper `sliceDotPreF`. -/
def sliceDotPreF {α : Type} (n : ℕ) (u v : List ℕ) (su sv : ℕ)
    (k : Bool → ℕ → ℕ → α) : α :=
  let raw := dotRaw u v
  let pos := Nat.add (Nat.add raw (Nat.mul n (Nat.mul cOff cOff))) (Nat.mul dOff 250000000)
  let neg := Nat.mul cOff (Nat.add su sv)
  let rad := Nat.mul n err1
  let req := Nat.add neg rad
  if Nat.ble req pos then
    strictNat (Nat.div (Nat.sub pos req) 250000000) fun lo ↦
    let hi := Nat.div (Nat.add (Nat.sub (Nat.add pos rad) neg) 249999999) 250000000
    strictNat (Nat.sub hi lo) fun w ↦ k true lo w
  else k false 0 0

/-- Internal Deep certificate helper `dwIvPreF`. -/
def dwIvPreF {α : Type} (uDwP uDwN v5 : List ℕ) (suP svP suN svN sP sN : ℕ)
    (k : Bool → ℕ → ℕ → α) : α :=
  let divBy := 62500000000
  let baseDW := 312500000000000000
  let dotPP := dotRaw uDwP v5
  let dotNN := dotRaw uDwN v5
  let pos := Nat.add (Nat.add baseDW dotPP)
    (Nat.add (Nat.mul (Nat.mul cOff5 cOff5) sP) (Nat.mul cOff5 (Nat.add suN svN)))
  let neg := Nat.add dotNN
    (Nat.add (Nat.mul (Nat.mul cOff5 cOff5) sN) (Nat.mul cOff5 (Nat.add suP svP)))
  let rad := Nat.mul err5 (Nat.add sP sN)
  let req := Nat.add neg rad
  if Nat.ble req pos then
    strictNat (Nat.div (Nat.sub pos req) divBy) fun lo ↦
    let hi := Nat.div (Nat.add (Nat.sub (Nat.add pos rad) neg) 62499999999) divBy
    strictNat (Nat.sub hi lo) fun w ↦ k true lo w
  else k false 0 0

/-- Internal Deep certificate helper `evalLeafPairF`. -/
def evalLeafPairF {α : Type} (lf1 lf2 : LeafExchRec) (s0P s0N s1P s1N : ℕ)
    (k : Bool → ℕ → ℕ → α) : α :=
  match lf1, lf2 with
  | LeafExchRec.mk u033 u33 u030 u30 su033 su33 su030 su30
      _ uDw0P uDw0N uDw1P uDw1N su0P su0N su1P su1N,
    LeafExchRec.mk v033 v33 v030 v30 sv033 sv33 sv030 sv30
      v5 _ _ _ _ sv0P sv0N sv1P sv1N =>
    sliceDotPreF 33 u033 v033 su033 sv033 fun ok1 o0l o0w ↦
    sliceDotPreF 25 u33 v33 su33 sv33 fun ok2 v0l v0w ↦
    sliceDotPreF 30 u030 v030 su030 sv030 fun ok3 o1l o1w ↦
    sliceDotPreF 28 u30 v30 su30 sv30 fun ok4 v1l v1w ↦
    mulZIvF dOff o0l o0w dOff v0l v0w 100000000 64000000 fun ok5 ov0l ov0w ↦
    mulZIvF dOff o1l o1w dOff v1l v1w 100000000 64000000 fun ok6 ov1l ov1w ↦
    dwIvPreF uDw0P uDw0N v5 su0P sv0P su0N sv0N s0P s0N fun ok7 dw0Lo dw0W ↦
    dwIvPreF uDw1P uDw1N v5 su1P sv1P su1N sv1N s1P s1N fun ok8 dw1Lo dw1W ↦
    if !(ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8) then k false 0 0
    else
      let baseD := 800000000
      if !(Nat.ble (Nat.add o0l o0w) (Nat.add baseD v0l) &&
           Nat.ble (Nat.add o1l o1w) (Nat.add baseD v1l)) then k false 0 0
      else
        strictNat (Nat.div (Nat.sub (Nat.add baseD v0l) (Nat.add o0l o0w)) 1000) fun d0Lo ↦
        let d0Hi := Nat.div (Nat.add (Nat.sub (Nat.add (Nat.add baseD v0l) v0w) o0l) 999) 1000
        strictNat (Nat.sub d0Hi d0Lo) fun d0W ↦
        strictNat (Nat.div (Nat.sub (Nat.add baseD v1l) (Nat.add o1l o1w)) 1000) fun d1Lo ↦
        let d1Hi := Nat.div (Nat.add (Nat.sub (Nat.add (Nat.add baseD v1l) v1w) o1l) 999) 1000
        strictNat (Nat.sub d1Hi d1Lo) fun d1W ↦
        mulZIvF 800000 d0Lo d0W 5000000 dw0Lo dw0W 100000 50000000 fun ok9 lin0l lin0w ↦
        mulZIvF 800000 d1Lo d1W 5000000 dw1Lo dw1W 100000 50000000 fun ok10 lin1l lin1w ↦
        if !(ok9 && ok10) then k false 0 0
        else
          let sovPad := 275904000000
          let sovLo := Nat.div (Nat.add (Nat.mul deepNormSq (Nat.add ov0l ov1l)) sovPad) 100000
          let sovHi := Nat.div (Nat.add (Nat.add (Nat.mul deepNormSq
            (Nat.add (Nat.add ov0l ov0w) (Nat.add ov1l ov1w))) sovPad) 99999) 100000
          strictNat (Nat.add (Nat.add sovLo lin0l) lin1l) fun pvl10 ↦
          strictNat (Nat.add (Nat.add (Nat.sub sovHi sovLo) lin0w) lin1w) fun pvw10 ↦
            k true pvl10 pvw10

/-- Internal Deep certificate helper `rowExchF`. -/
def rowExchF {α : Type} (lf1 : LeafExchRec) (sc1 : List ℕ)
    (cs1 sum2Nrc s0P s0N s1P s1N : ℕ) :
    List LeafExchRec → List (List ℕ) → List ℕ → ℕ → ℕ → (Bool → ℕ → ℕ → α) → α
  | [], _, _, posA, negA, k => k true posA negA
  | _, [], _, posA, negA, k => k true posA negA
  | _, _, [], posA, negA, k => k true posA negA
  | lf2 :: ls, raw2 :: raws, cs2 :: css, posA, negA, k =>
    evalLeafPairF lf1 lf2 s0P s0N s1P s1N fun ok pvl10 pvw10 ↦
    if ok then
      let zPos := Nat.mul 2 (Nat.add (dotRaw sc1 raw2) (Nat.mul 268435456 sum2Nrc))
      let zNeg := Nat.mul 32768 (Nat.add cs1 cs2)
      accSignedIv posA negA zPos zNeg 450000000 pvl10 pvw10 fun p' n' ↦
        rowExchF lf1 sc1 cs1 sum2Nrc s0P s0N s1P s1N ls raws css p' n' k
    else k false 0 0

/-- Internal Deep certificate helper `blockExchF`. -/
def blockExchF {α : Type} (sum2Nrc s0P s0N s1P s1N : ℕ) :
    List LeafExchRec → List (List ℕ) → List (List ℕ) → List ℕ →
    ℕ → ℕ → (Bool → ℕ → ℕ → α) → α
  | [], _, _, _, posA, negA, k => k true posA negA
  | _, [], _, _, posA, negA, k => k true posA negA
  | _, _, [], _, posA, negA, k => k true posA negA
  | _, _, _, [], posA, negA, k => k true posA negA
  | lf1 :: ls, raw1 :: raws, sc1 :: scs, cs1 :: css, posA, negA, k =>
    evalLeafPairF lf1 lf1 s0P s0N s1P s1N fun ok pvl10 pvw10 ↦
    if ok then
      let zDiagP := Nat.add (dotRaw sc1 raw1) (Nat.mul 268435456 sum2Nrc)
      let zDiagN := Nat.mul 32768 cs1
      accSignedIv posA negA zDiagP zDiagN 450000000 pvl10 pvw10 fun p1 n1 ↦
      rowExchF lf1 sc1 cs1 sum2Nrc s0P s0N s1P s1N ls raws css p1 n1 fun okR p2 n2 ↦
      if okR then blockExchF sum2Nrc s0P s0N s1P s1N ls raws scs css p2 n2 k
      else k false 0 0
    else k false 0 0

private lemma mulZIvF_eq {α : Type} (z1 l1 w1 z2 l2 w2 divBy newOff : ℕ)
    (k : Bool → ℕ → ℕ → α) :
    mulZIvF z1 l1 w1 z2 l2 w2 divBy newOff k = mulZIv z1 l1 w1 z2 l2 w2 divBy newOff k := by
  unfold mulZIvF mulZIv; simp only [strictNat_eq]

private lemma sliceDotPreF_eq {α : Type} (n : ℕ) (u v : List ℕ) (su sv : ℕ)
    (k : Bool → ℕ → ℕ → α) :
    sliceDotPreF n u v su sv k = sliceDotPre n u v su sv k := by
  unfold sliceDotPreF sliceDotPre; simp only [strictNat_eq]

private lemma dwIvPreF_eq {α : Type} (uDwP uDwN v5 : List ℕ) (suP svP suN svN sP sN : ℕ)
    (k : Bool → ℕ → ℕ → α) :
    dwIvPreF uDwP uDwN v5 suP svP suN svN sP sN k =
      dwIvPre uDwP uDwN v5 suP svP suN svN sP sN k := by
  unfold dwIvPreF dwIvPre; simp only [strictNat_eq]

lemma evalLeafPairF_eq {α : Type} (lf1 lf2 : LeafExchRec) (s0P s0N s1P s1N : ℕ)
    (k : Bool → ℕ → ℕ → α) :
    evalLeafPairF lf1 lf2 s0P s0N s1P s1N k =
      evalLeafPairFast lf1 lf2 s0P s0N s1P s1N k := by
  cases lf1; cases lf2
  unfold evalLeafPairF evalLeafPairFast
  simp only [sliceDotPreF_eq, mulZIvF_eq, dwIvPreF_eq, strictNat_eq]

lemma rowExchF_eq {α : Type} (lf1 : LeafExchRec) (sc1 : List ℕ)
    (cs1 sum2Nrc s0P s0N s1P s1N : ℕ) :
    ∀ (ls : List LeafExchRec) (raws : List (List ℕ)) (css : List ℕ) (posA negA : ℕ)
      (k : Bool → ℕ → ℕ → α),
      rowExchF lf1 sc1 cs1 sum2Nrc s0P s0N s1P s1N ls raws css posA negA k =
        rowExchCipsi lf1 sc1 cs1 sum2Nrc s0P s0N s1P s1N ls raws css posA negA k
  | [], _, _, _, _, _ => rfl
  | _ :: _, [], _, _, _, _ => rfl
  | _ :: _, _ :: _, [], _, _, _ => rfl
  | lf2 :: ls, raw2 :: raws, cs2 :: css, posA, negA, k => by
    unfold rowExchF rowExchCipsi
    simp only [evalLeafPairF_eq, strictNat_eq, rowExchF_eq _ _ _ _ _ _ _ _ ls raws css]

lemma blockExchF_eq {α : Type} (sum2Nrc s0P s0N s1P s1N : ℕ) :
    ∀ (ls : List LeafExchRec) (raws scs : List (List ℕ)) (css : List ℕ) (posA negA : ℕ)
      (k : Bool → ℕ → ℕ → α),
      blockExchF sum2Nrc s0P s0N s1P s1N ls raws scs css posA negA k =
        blockExchCipsi sum2Nrc s0P s0N s1P s1N ls raws scs css posA negA k
  | [], _, _, _, _, _, _ => rfl
  | _ :: _, [], _, _, _, _, _ => rfl
  | _ :: _, _ :: _, [], _, _, _, _ => rfl
  | _ :: _, _ :: _, _ :: _, [], _, _, _ => rfl
  | lf1 :: ls, raw1 :: raws, sc1 :: scs, cs1 :: css, posA, negA, k => by
    unfold blockExchF blockExchCipsi
    simp only [evalLeafPairF_eq, rowExchF_eq, strictNat_eq,
      blockExchF_eq _ _ _ _ _ ls raws scs css]

/-- Internal Deep certificate helper `getOrbColOpt`. -/
def getOrbColOpt : List (List ℕ) → ℕ → List ℕ → OptList
  | [], _, acc => .some (revStrict acc [])
  | r :: rs, p, acc => getOrbColOpt rs p (consStrict (r.getD p 0) acc)

/-- Internal Deep certificate helper `buildOrbColTree`. -/
def buildOrbColTree : ℕ → ℕ → ℕ → List (List ℕ) → OrbColTree
  | 0, _, _, _ => .empty
  | _ + 1, _, 0, _ => .empty
  | fuel + 1, baseP, len, rows =>
    let half := Nat.div len 2
    let midP := Nat.add baseP half
    let rLen := Nat.sub (Nat.sub len 1) half
    match getOrbColOpt rows midP [],
          buildOrbColTree fuel baseP half rows,
          buildOrbColTree fuel (Nat.add midP 1) rLen rows with
    | .some col, lT, rT => .node lT midP col rT
    | .none, _, _ => .empty

/-- Internal Deep certificate helper `lookupOrbCol`. -/
def lookupOrbCol : OrbColTree → ℕ → OptList
  | .empty, _ => .none
  | .node l idx col r, q =>
    bif Nat.beq q idx then .some col
    else bif Nat.blt q idx then lookupOrbCol l q
    else lookupOrbCol r q

/-- Internal Deep certificate helper `zipGVecOpt`. -/
def zipGVecOpt : List ℕ → List ℕ → List ℕ → ℕ → OptGEntry
  | [], [], acc, sAcc => .some (revStrict acc []) sAcc
  | up :: ups, vq :: vqs, acc, sAcc =>
    let pos := Nat.add gcAddHi (Nat.mul up vq)
    let neg := Nat.add errHi (Nat.mul cOffHi (Nat.add up vq))
    bif Nat.ble neg pos then
      Nat.casesOn (Nat.div (Nat.sub pos neg) 250000000)
        (zipGVecOpt ups vqs (0 :: acc) sAcc)
        (fun m ↦
          let g := Nat.add m 1
          Nat.casesOn (Nat.add sAcc g)
            (zipGVecOpt ups vqs (g :: acc) 0)
            (fun ms ↦ zipGVecOpt ups vqs (g :: acc) (Nat.add ms 1)))
    else .none
  | _, _, _, _ => .none

/-- Internal Deep certificate helper `buildAllGsCol`. -/
def buildAllGsCol (colTree : OrbColTree) : List ℕ → KeyGList → OptKeyGList
  | [], acc => .some (revKeyGListCPS acc .nil id)
  | key :: rest, acc =>
    match lookupOrbCol colTree (Nat.div key 64), lookupOrbCol colTree (Nat.mod key 64) with
    | .some cp, .some cq =>
      match zipGVecOpt cp cq [] 0 with
      | .none => .none
      | .some gb sGb => buildAllGsCol colTree rest (.cons key gb sGb acc)
    | _, _ => .none

/-- Internal Deep certificate helper `buildDiagGsCol`. -/
def buildDiagGsCol (colTree : OrbColTree) : ℕ → ℕ → KeyGList → OptKeyGList
  | 0, _, acc => .some (revKeyGListCPS acc .nil id)
  | rem + 1, p, acc =>
    match lookupOrbCol colTree p with
    | .some cp =>
      match zipGVecOpt cp cp [] 0 with
      | .none => .none
      | .some gb sGb => buildDiagGsCol colTree rem (Nat.add p 1) (.cons p gb sGb acc)
    | .none => .none

/-- Internal Deep certificate helper `evalOneModeKeyOpt`. -/
def evalOneModeKeyOpt (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ)
    (gb : List ℕ) (sGb : ℕ) : OptIv :=
  let base5 := 500000000000000
  let addConst := 950272000000000
  let posRaw := Nat.add (dotRaw iw29 gb) addConst
  let negRaw := Nat.add (Nat.mul 16384 sGb) (Nat.mul gpOffHi sumIw29)
  let reqLo := Nat.add negRaw (Nat.mul 18 sumNeg)
  let bp := Nat.add base5 posRaw
  if Nat.ble reqLo bp then
    let lo5 := Nat.div (Nat.sub bp reqLo) 10000
    let hi5 := Nat.div (Nat.add (Nat.sub (Nat.add bp (Nat.mul 18 sumPos)) negRaw) 9999) 10000
    if Nat.ble hi5 100000000000 then
      Nat.casesOn lo5
        (Nat.casesOn hi5 (.some 0 0) (fun mh ↦ .some 0 (Nat.add mh 1)))
        (fun ml ↦
          let lo' := Nat.add ml 1
          let w' := Nat.sub hi5 lo'
          Nat.casesOn w' (.some lo' 0) (fun mw ↦ .some lo' (Nat.add mw 1)))
    else .none
  else .none

/-- Internal Deep certificate helper `someIvStrict`. -/
def someIvStrict (lo w : ℕ) : OptIv :=
  Nat.casesOn lo
    (Nat.casesOn w (.some 0 0) (fun mw ↦ .some 0 (Nat.add mw 1)))
    (fun ml ↦
      let lo' := Nat.add ml 1
      Nat.casesOn w (.some lo' 0) (fun mw ↦ .some lo' (Nat.add mw 1)))

/-- Internal Deep certificate helper `buildDiagMOpt`. -/
def buildDiagMOpt (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ) :
    KeyGList → PairList → OptPairs
  | .nil, acc => .some (revPairListCPS acc .nil id)
  | .cons _ gb sGb rest, acc =>
    match evalOneModeKeyOpt iw29 sumIw29 sumPos sumNeg gb sGb with
    | .none => .none
    | .some lo5 w5 => buildDiagMOpt iw29 sumIw29 sumPos sumNeg rest (.cons lo5 w5 acc)

/-- Internal Deep certificate helper `buildActM2Opt`. -/
def buildActM2Opt (iw29 : List ℕ) (sumIw29 sumPos sumNeg : ℕ) :
    KeyGList → IvList → ℕ → OptActIvs
  | .nil, acc, cnt => .some (revIvListCPS acc .nil id) cnt
  | .cons key gb sGb rest, acc, cnt =>
    match evalOneModeKeyOpt iw29 sumIw29 sumPos sumNeg gb sGb with
    | .none => .none
    | .some lo5 w5 =>
      let lo3 := Nat.div lo5 400
      let hi3 := Nat.div (Nat.add (Nat.add lo5 w5) 399) 400
      let w3 := Nat.sub hi3 lo3
      match someIvStrict lo3 w3 with
      | .none => .none
      | .some lo3' w3' =>
        buildActM2Opt iw29 sumIw29 sumPos sumNeg rest (.cons key lo3' w3' acc) (Nat.add cnt 1)

/-- Internal Deep certificate helper `evalMQuadsFast`. -/
def evalMQuadsFast (m2Tree : KeyIvTree) : QuadList → ℕ → ℕ → OptIv
  | .nil, rawP, rawN =>
    normPN rawP rawN fun rp rn ↦
    let mqP := Nat.div (Nat.add rp 2499999) 2500000
    let mqN := Nat.div rn 2500000
    normPN mqP mqN someIvStrict
  | .cons k1 k2 cP cN rest, rawP, rawN =>
    let z2M := 250000000
    let z2M2 := 62500000000000000
    match lookupKeyIvOpt m2Tree k1, lookupKeyIvOpt m2Tree k2 with
    | .some l1 w1, .some l2 w2 =>
      let c1 := Nat.add (Nat.mul 2 l1) w1
      let c2 := Nat.add (Nat.mul 2 l2) w2
      let m1 := absDiffNat c1 z2M
      let m2 := absDiffNat c2 z2M
      let pT := Nat.add (Nat.mul c1 c2) z2M2
      let nT := Nat.mul z2M (Nat.add c1 c2)
      let radT := Nat.add (Nat.add (Nat.mul w1 m2) (Nat.mul m1 w2)) (Nat.mul w1 w2)
      if Nat.beq cN 0 then
        let hiP := Nat.add pT radT
        if Nat.ble nT hiP then
          strictNat (Nat.add rawP (Nat.mul cP (Nat.sub hiP nT))) fun rawP' ↦
            evalMQuadsFast m2Tree rest rawP' rawN
        else
          strictNat (Nat.add rawN (Nat.mul cP (Nat.sub nT hiP))) fun rawN' ↦
            evalMQuadsFast m2Tree rest rawP rawN'
      else if Nat.beq cP 0 then
        let hiN := Nat.add nT radT
        if Nat.ble pT hiN then
          strictNat (Nat.add rawP (Nat.mul cN (Nat.sub hiN pT))) fun rawP' ↦
            evalMQuadsFast m2Tree rest rawP' rawN
        else
          strictNat (Nat.add rawN (Nat.mul cN (Nat.sub pT hiN))) fun rawN' ↦
            evalMQuadsFast m2Tree rest rawP rawN'
      else .none
    | _, _ => .none

/-- Internal Deep certificate helper `modesLoopFast`. -/
def modesLoopFast {α : Type} (diagGs activeGs : KeyGList)
    (wTot dTotP dTotN : List ℕ) (quads : QuadList) (fwRow : List ℕ) :
    ℕ → ℕ → List (List ℕ) → ℕ → ℕ → (Bool → ℕ → ℕ → α) → α
  | 0, _, _, frP, frN, k => k true frP frN
  | rem + 1, cIdx, iwRows, frP, frN, k =>
    strictNat (fwRow.getD cIdx 0) fun fw ↦
    strictNatList (getRow29Go 29 (iwRows.headD [])) fun iw29 ↦
    strictNat (sumList iw29) fun sumIw29 ↦
    strictNat ((iwRows.headD []).getD 29 16384) fun w29 ↦
    strictNatList (iw29.map fun x ↦ if Nat.ble 16384 x then Nat.sub x 16384 else 0) fun mPos ↦
    strictNatList (iw29.map fun x ↦ if Nat.ble 16384 x then 0 else Nat.sub 16384 x) fun mNeg ↦
    strictNat (sumList mPos) fun sumPos ↦
    strictNat (sumList mNeg) fun sumNeg ↦
    match buildDiagMOpt iw29 sumIw29 sumPos sumNeg diagGs .nil,
          buildActM2Opt iw29 sumIw29 sumPos sumNeg activeGs .nil 0 with
    | .some diagM, .some m2Ivs nAct =>
      buildIvTreeFastCPS 12 nAct m2Ivs fun m2Tree _ ↦
      linRefDeltaGo 0 wTot dTotP dTotN diagM 0 0 0 0 0 0 0 0
        fun ok1 sdpLo sdpW sdpOff10 refLo refW pos_3 neg2 rad2 ↦
      evalTermCPS refLo refW pos_3 neg2 rad2 fun ok2 p_3 n_3 ↦
      match evalMQuadsFast m2Tree quads 0 0 with
      | .some mqP mqN =>
        if ok1 && ok2 then
          strictNat (Nat.div sdpLo 100000) fun kLo ↦
          strictNat (Nat.div (Nat.add (Nat.add sdpLo sdpW) 99999) 100000) fun kHi ↦
          strictNat (Nat.mul (Nat.mul 4 fw) (Nat.add w29 sumNeg)) fun p_4 ↦
          strictNat (Nat.mul (Nat.mul 4 fw) (Nat.add 16384 sumPos)) fun n_4 ↦
          accSignedIv 0 0 p_4 n_4 sdpOff10 kLo (Nat.sub kHi kLo) fun modeP modeN ↦
          strictNat (Nat.mul (Nat.mul 2 fw) (Nat.add p_3 mqP)) fun addP ↦
          strictNat (Nat.mul (Nat.mul 2 fw) (Nat.add n_3 mqN)) fun addN ↦
          normPN (Nat.add (Nat.add frP modeP) addP) (Nat.add (Nat.add frN modeN) addN)
            fun frP' frN' ↦
            modesLoopFast diagGs activeGs wTot dTotP dTotN quads fwRow
              rem (Nat.add cIdx 1) iwRows.tail frP' frN' k
        else k false 0 0
      | .none => k false 0 0
    | _, _ => k false 0 0

/-- Internal Deep certificate checker `checkCayleyRange0Cert`. -/
def checkCayleyRange0Cert : Bool :=
  forceList cayleyKTable fun ksF ↦
  forceList cayleyQ14Table fun qsF ↦
  forceList cayleyQ12Cert fun certF ↦
    Nat.beq ksF.length 58 &&
      Nat.beq qsF.length 58 &&
      Nat.beq cayleyFlipMask.length 58 &&
      Nat.beq certF.length 58 &&
      checkSkewAllGo ksF 0 ksF &&
      forceList (prepKRows ksF) fun pKRs ↦
        checkCayleyColsCnt pKRs 18 58 qsF ksF cayleyFlipMask certF

/-- Internal Deep certificate checker `checkCayleyRange1Cert`. -/
def checkCayleyRange1Cert : Bool :=
  forceList cayleyKTable fun ksF ↦
  forceList cayleyQ14Table fun qsF ↦
  forceList cayleyQ12Cert fun certF ↦
  forceList (prepKRows ksF) fun pKRs ↦
    checkCayleyColsCnt pKRs 20 40 (qsF.drop 18) (ksF.drop 18)
      (cayleyFlipMask.drop 18) (certF.drop 18)

/-- Internal Deep certificate checker `checkCayleyRange2Cert`. -/
def checkCayleyRange2Cert : Bool :=
  forceList cayleyKTable fun ksF ↦
  forceList cayleyQ14Table fun qsF ↦
  forceList cayleyQ12Cert fun certF ↦
  forceList (prepKRows ksF) fun pKRs ↦
    checkCayleyColsGo pKRs 20 (qsF.drop 38) (ksF.drop 38)
      (cayleyFlipMask.drop 38) (certF.drop 38)

/-- Internal Deep certificate checker `checkCayleyCertTop`. -/
def checkCayleyCertTop : Bool :=
  checkCayleyCert cayleyFlipMask cayleyKTable cayleyQ14Table cayleyQ12Cert

/-- Combines the three Cayley column-range certificates into `checkCayleyCertTop`. -/
lemma cayley_of_ranges (h0 : checkCayleyRange0Cert = true)
    (h1 : checkCayleyRange1Cert = true) (h2 : checkCayleyRange2Cert = true) :
    checkCayleyCertTop = true := by
  unfold checkCayleyCertTop checkCayleyCert
  unfold checkCayleyRange0Cert at h0
  unfold checkCayleyRange1Cert at h1
  unfold checkCayleyRange2Cert at h2
  simp -iota only [forceList_eq] at h0 h1 h2 ⊢
  rw [show (58 : ℕ) = 18 + 40 from rfl, checkCayleyColsGo_split _ 18 40]
  rw [show (40 : ℕ) = 20 + 20 from rfl, checkCayleyColsGo_split _ 20 20]
  simp -iota only [List.drop_drop,
    show (18 + 40 : ℕ) = 58 from rfl, show (20 + 20 : ℕ) = 40 from rfl,
    show (18 + 20 : ℕ) = 38 from rfl]
  simp -iota only [Bool.and_eq_true] at h0 ⊢
  exact ⟨h0.1, h0.2, h1, h2⟩

