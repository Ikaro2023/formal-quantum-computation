private noncomputable def diagDetModeTerm (r : Fin 9) (c : Fin 14)
    (t : Bool × ℕ × List ℕ) : ℝ :=
  if hlt : ∀ w ∈ t.2.2, w < 2 * 58 then
    ((t.2.1 ^ 2 : ℕ) : ℝ) *
      (flipModeDelta r c t.2.2 hlt ^ 2 - exchFlipSqMode r c t.2.2 hlt)
  else 0

