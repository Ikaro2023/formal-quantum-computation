        modeValLists uFn iwRow p q * 100000 * 10000 := by
      unfold modeValLists
      rw [Finset.sum_mul, Finset.sum_mul]
      refine Finset.sum_congr rfl fun b _ ↦ by ring
    have hconst29 : (∑ _ ∈ Finset.range 29, (16384 : ℝ) * (gpOffHi : ℝ)) = 950272000000000 := by
      rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      norm_num [gpOffHi_eq]
    have hposR_eq : (posRaw : ℝ) =
        ∑ b ∈ Finset.range 29, ((iwRow.getD b 16384 : ℝ) * (gb.getD b 0 : ℝ) +
          16384 * (gpOffHi : ℝ)) := by
      rw [Finset.sum_add_distrib, hconst29]
      simp only [posRaw, hdot]; push_cast; ring
    have hnegR_eq : (negRaw : ℝ) =
        ∑ b ∈ Finset.range 29, (16384 * (gb.getD b 0 : ℝ) +
          (gpOffHi : ℝ) * (iwRow.getD b 16384 : ℝ)) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
      simp only [negRaw, hsgb_eq, hsiw_eq]; push_cast; ring
    have hspR_eq : 18 * (sumPos : ℝ) = ∑ b ∈ Finset.range 29, 18 * (mPosFn iwRow b : ℝ) := by
      rw [← Finset.mul_sum, hsp_eq]; push_cast; rfl
    have hsnR_eq : 18 * (sumNeg : ℝ) = ∑ b ∈ Finset.range 29, 18 * (mNegFn iwRow b : ℝ) := by
      rw [← Finset.mul_sum, hsn_eq]; push_cast; rfl
    rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← hposR_eq, ← hnegR_eq, ← hsnR_eq,
      hmid_eq] at hsum_lo
    rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← hposR_eq, ← hnegR_eq, ← hspR_eq,
      hmid_eq] at hsum_hi
    refine hk true lo5 (hi5 - lo5) fun _ ↦ ⟨?_, ?_⟩
    · have hf := nat_div_le_real (n := bp - reqLo) (d := 10000)
      have hsub : ((bp - reqLo : ℕ) : ℝ) = (bp : ℝ) - (reqLo : ℝ) := Nat.cast_sub hreq_le
      have hbp : (bp : ℝ) - (reqLo : ℝ) =
          50000000000 * 10000 + ((posRaw : ℝ) - (negRaw : ℝ) - 18 * (sumNeg : ℝ)) := by
        simp only [bp, reqLo]; push_cast; ring
