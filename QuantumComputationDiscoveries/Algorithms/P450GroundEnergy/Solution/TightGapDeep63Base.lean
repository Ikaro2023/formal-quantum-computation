/-- Internal Deep helper `deepRotQ`. -/
noncomputable def deepRotQ : Matrix (Fin 58) (Fin 58) ℝ :=
  if h : checkCayleyCertTop = true then (checkCayleyCert_sound h).choose else 1

lemma deepRotQ_left : deepRotQᵀ * deepRotQ = 1 := by
  unfold deepRotQ; split_ifs with h
  · exact (checkCayleyCert_sound h).choose_spec.1
  · simp

lemma deepRotQ_right : deepRotQ * deepRotQᵀ = 1 := by
  unfold deepRotQ; split_ifs with h
  · exact (checkCayleyCert_sound h).choose_spec.2.1
  · simp

lemma deepRotQ_cert (h : checkCayleyCertTop = true) :
    ∀ j : Fin 58,
      ValidZ2List (cayleyQ12Cert.getD j.val []) (List.replicate 58 2)
        (List.ofFn fun i : Fin 58 ↦ deepRotQ i j) := by
  unfold deepRotQ; simp only [h, ↓reduceDIte]
  exact (checkCayleyCert_sound h).choose_spec.2.2

lemma ofFn_getD_fin {n : ℕ} (f : Fin n → ℝ) (q : Fin n) :
    (List.ofFn f).getD q.val 0 = f q := by
  rw [list_getD_eq_getElem (List.ofFn f) 0 (by simp [q.isLt]), List.getElem_ofFn]

