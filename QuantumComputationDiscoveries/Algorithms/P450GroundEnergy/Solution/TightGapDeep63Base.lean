lemma rotBlk_row_valid (hcay : checkCayleyCertTop = true)
    (hb0 : checkRotBlkLeavesCert 0 87 = true)
    (hb1 : checkRotBlkLeavesCert 87 87 = true)
    (hb2 : checkRotBlkLeavesCert 174 87 = true)
    (r : Fin 9) {b : ℕ} (hb : b < 29) :
    List.Forall₂ ValidOrb5e8 (((rotBlkLeavesCert.drop (29 * r.val)).take 29).getD b [])
      (List.ofFn (rBlkFn r b)) := by
  unfold checkRotBlkLeavesCert at hb0 hb1 hb2
  rw [list_take_getD 29 _ b hb, list_drop_getD]
  set k := 29 * r.val + b
  have hk261 : k < 261 := by dsimp [k]; omega
  unfold rBlkFn rLeafVec rotLeafVec leafVector
  have hrew (s idx : ℕ) (hs : s + idx = k) (hlt' : s + idx < 261) :
      rotBlkLeavesCert.getD (s + idx) [] = rotBlkLeavesCert.getD k [] ∧
      (⟨s + idx, hlt'⟩ : Fin 261) = leafEquiv (r, ⟨min b 28, by omega⟩) :=
    ⟨by rw [hs], Fin.ext (by dsimp [leafEquiv, k] at hs ⊢; omega)⟩
  by_cases hk87 : k < 87
  · obtain ⟨hg, hf⟩ := hrew 0 k (by omega) (by omega)
    have h := checkRotLeavesRange_sound deepRotQ_left cayleyQ12Cert_length
      (deepRotQ_cert hcay) hb0 hk87 (by omega)
    rwa [hg, hf] at h
  · by_cases hk174 : k < 174
    · have hlt : k - 87 < 87 := by omega
      obtain ⟨hg, hf⟩ := hrew 87 (k - 87) (by omega) (by omega)
      have h := checkRotLeavesRange_sound deepRotQ_left cayleyQ12Cert_length
        (deepRotQ_cert hcay) hb1 hlt (by omega)
      rwa [hg, hf] at h
    · have hlt : k - 174 < 87 := by omega
      obtain ⟨hg, hf⟩ := hrew 174 (k - 174) (by omega) (by omega)
      have h := checkRotLeavesRange_sound deepRotQ_left cayleyQ12Cert_length
        (deepRotQ_cert hcay) hb2 hlt (by omega)
      rwa [hg, hf] at h

private def LeafExchValid (dw0P dw0N dw1P dw1N : List ℕ) (lf : LeafExchRec)
    (uVec : Fin 58 → ℝ) : Prop :=
  match lf with
  | LeafExchRec.mk u033 u33 u030 u30 su033 su33 su030 su30
      u5 uDw0P uDw0N uDw1P uDw1N su0P su0N su1P su1N =>
    ∃ u : List ℕ,
      List.Forall₂ ValidOrb5e7 u (List.ofFn uVec) ∧
      u033 = u.take 33 ∧ u33 = u.drop 33 ∧
      u030 = u.take 30 ∧ u30 = u.drop 30 ∧
      su033 = sumList u033 ∧ su33 = sumList u33 ∧
      su030 = sumList u030 ∧ su30 = sumList u30 ∧
      u5 = u.map (fun x ↦ Nat.div x 20) ∧
      uDw0P = List.zipWith Nat.mul dw0P u5 ∧
      uDw0N = List.zipWith Nat.mul dw0N u5 ∧
      uDw1P = List.zipWith Nat.mul dw1P u5 ∧
      uDw1N = List.zipWith Nat.mul dw1N u5 ∧
      su0P = sumList uDw0P ∧ su0N = sumList uDw0N ∧
      su1P = sumList uDw1P ∧ su1N = sumList uDw1N

private lemma forall2_orb5e8_div10 :
    ∀ {xs : List ℕ} {ys : List ℝ},
      List.Forall₂ ValidOrb5e8 xs ys →
      List.Forall₂ ValidOrb5e7 (xs.map fun x ↦ Nat.div x 10) ys
  | _, _, .nil => .nil
  | _, _, .cons h hs => .cons (validOrb5e8_div10 h) (forall2_orb5e8_div10 hs)

private lemma prepLeavesExch_valid_aux (dw0P dw0N dw1P dw1N : List ℕ) :
    ∀ (rem : ℕ) (rows : List (List ℕ)) (uFn : ℕ → Fin 58 → ℝ)
      (acc : List LeafExchRec) (accBs : List ℕ) (uOrig : ℕ → Fin 58 → ℝ),
      (∀ j < rem, List.Forall₂ ValidOrb5e8 (rows.getD j []) (List.ofFn (uFn j))) →
      (∀ j < rem, uFn j = uOrig (accBs.length + j)) →
      List.Forall₂ (fun lf b ↦ LeafExchValid dw0P dw0N dw1P dw1N lf (uOrig b))
        acc.reverse accBs →
      ∀ (P : Bool → List LeafExchRec → Prop),
        (∀ ok leaves,
          (ok = true →
            List.Forall₂ (fun lf b ↦ LeafExchValid dw0P dw0N dw1P dw1N lf (uOrig b))
              leaves (accBs ++ (List.range rem).map (accBs.length + ·))) →
          P ok leaves) →
        prepLeavesExch dw0P dw0N dw1P dw1N rem rows acc P
  | 0, _, _, acc, _, _, _, _, hacc, P, hk => by
    simp only [prepLeavesExch, forceList_eq]
    exact hk true acc.reverse fun _ ↦ by simpa using hacc
  | rem + 1, rows, uFn, acc, accBs, uOrig, hrows, huOrig, hacc, P, hk => by
    unfold prepLeavesExch
    rw [list_headD_eq_getD]
    simp only [strictNatList_eq, splitAtList_eq, strictNat_eq]
    set u := (rows.getD 0 []).map (fun x ↦ Nat.div x 10)
    have hu5e8 := hrows 0 (by omega)
    rw [huOrig 0 (by omega), Nat.add_zero] at hu5e8
    have hu5e7 : List.Forall₂ ValidOrb5e7 u (List.ofFn (uOrig accBs.length)) :=
      forall2_orb5e8_div10 hu5e8
    let rec0 := LeafExchRec.mk (u.take 33) (u.drop 33) (u.take 30) (u.drop 30)
      (sumList (u.take 33)) (sumList (u.drop 33))
      (sumList (u.take 30)) (sumList (u.drop 30))
      (u.map fun x ↦ Nat.div x 20)
      (List.zipWith Nat.mul dw0P (u.map fun x ↦ Nat.div x 20))
      (List.zipWith Nat.mul dw0N (u.map fun x ↦ Nat.div x 20))
      (List.zipWith Nat.mul dw1P (u.map fun x ↦ Nat.div x 20))
      (List.zipWith Nat.mul dw1N (u.map fun x ↦ Nat.div x 20))
      (sumList (List.zipWith Nat.mul dw0P (u.map fun x ↦ Nat.div x 20)))
      (sumList (List.zipWith Nat.mul dw0N (u.map fun x ↦ Nat.div x 20)))
      (sumList (List.zipWith Nat.mul dw1P (u.map fun x ↦ Nat.div x 20)))
      (sumList (List.zipWith Nat.mul dw1N (u.map fun x ↦ Nat.div x 20)))
    have hlf : LeafExchValid dw0P dw0N dw1P dw1N rec0 (uOrig accBs.length) :=
      ⟨u, hu5e7, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl,
        rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
    have hacc' : List.Forall₂ (fun lf b ↦ LeafExchValid dw0P dw0N dw1P dw1N lf (uOrig b))
        (rec0 :: acc).reverse (accBs ++ [accBs.length]) := by
      rw [List.reverse_cons]; exact forall2_append hacc (.cons hlf .nil)
    have hrows' : ∀ j < rem,
        List.Forall₂ ValidOrb5e8 (rows.tail.getD j []) (List.ofFn (uFn (j + 1))) := by
      intro j hj; rw [list_tail_getD]; exact hrows (j + 1) (by omega)
    have huOrig' : ∀ j < rem,
        uFn (j + 1) = uOrig ((accBs ++ [accBs.length]).length + j) := by
      intro j hj; simp only [List.length_append, List.length_singleton]
      rw [show accBs.length + 1 + j = accBs.length + (j + 1) by omega]
      exact huOrig (j + 1) (by omega)
    refine prepLeavesExch_valid_aux dw0P dw0N dw1P dw1N rem rows.tail (fun j ↦ uFn (j + 1))
      (rec0 :: acc) (accBs ++ [accBs.length]) uOrig hrows' huOrig' hacc' P
      fun ok2 leaves h2 ↦ hk ok2 leaves fun hok2 ↦ ?_
    have hr := h2 hok2
    rw [List.append_assoc, List.singleton_append] at hr
    rw [List.range_succ_eq_map, List.map_cons, Nat.add_zero, List.map_map]
    have hmap : List.map ((accBs.length + ·) ∘ Nat.succ) (List.range rem) =
        List.map ((accBs ++ [accBs.length]).length + ·) (List.range rem) := by
      refine List.map_congr_left fun i _ ↦ ?_
      simp only [Function.comp_apply, List.length_append, List.length_singleton]; omega
    rwa [hmap]

private lemma prepLeavesExch_comp {α β : Type} (f : α → β) (dw0P dw0N dw1P dw1N : List ℕ) :
    ∀ (rem : ℕ) (rows : List (List ℕ)) (acc : List LeafExchRec)
      (k : Bool → List LeafExchRec → α),
      prepLeavesExch dw0P dw0N dw1P dw1N rem rows acc (fun a b ↦ f (k a b)) =
        f (prepLeavesExch dw0P dw0N dw1P dw1N rem rows acc k)
  | 0, _, _, _ => by simp [prepLeavesExch, forceList_eq]
  | rem + 1, rows, acc, k => by
    unfold prepLeavesExch
    simp only [strictNatList_eq, splitAtList_eq, strictNat_eq]
    exact prepLeavesExch_comp f dw0P dw0N dw1P dw1N rem rows.tail _ k
private noncomputable def pairValLists (dw0P dw0N dw1P dw1N : List ℕ) (u1 u2 : Fin 58 → ℝ) : ℝ :=
  (deepNormSq : ℝ) *
    (occDot qOcc 0 u1 u2 * virtDot qOcc 0 u1 u2 +
      occDot qOcc 1 u1 u2 * virtDot qOcc 1 u1 u2) +
  (virtDot qOcc 0 u1 u2 - occDot qOcc 0 u1 u2) *
    (∑ p : Fin 58, ((dw0P.getD p.val 0 : ℝ) - (dw0N.getD p.val 0 : ℝ)) * (u1 p * u2 p)) +
  (virtDot qOcc 1 u1 u2 - occDot qOcc 1 u1 u2) *
    (∑ p : Fin 58, ((dw1P.getD p.val 0 : ℝ) - (dw1N.getD p.val 0 : ℝ)) * (u1 p * u2 p))

private lemma pairValLists_symm (dw0P dw0N dw1P dw1N : List ℕ) (u1 u2 : Fin 58 → ℝ) :
    pairValLists dw0P dw0N dw1P dw1N u1 u2 = pairValLists dw0P dw0N dw1P dw1N u2 u1 := by
  unfold pairValLists
  have ho (σ : Fin 2) : occDot qOcc σ (u1) (u2) =
      occDot qOcc σ (u2) (u1) := by
    unfold occDot; refine Finset.sum_congr rfl fun q _ ↦ ?_; split_ifs <;> ring
  have hv (σ : Fin 2) : virtDot qOcc σ (u1) (u2) =
      virtDot qOcc σ (u2) (u1) := by
    unfold virtDot; refine Finset.sum_congr rfl fun p _ ↦ ?_; split_ifs <;> ring
  have hs0 :
      (∑ p : Fin 58, ((dw0P.getD p.val 0 : ℝ) - (dw0N.getD p.val 0 : ℝ)) *
        (u1 p * u2 p)) =
      ∑ p : Fin 58, ((dw0P.getD p.val 0 : ℝ) - (dw0N.getD p.val 0 : ℝ)) *
        (u2 p * u1 p) :=
    Finset.sum_congr rfl fun p _ ↦ by ring
  have hs1 :
      (∑ p : Fin 58, ((dw1P.getD p.val 0 : ℝ) - (dw1N.getD p.val 0 : ℝ)) *
        (u1 p * u2 p)) =
      ∑ p : Fin 58, ((dw1P.getD p.val 0 : ℝ) - (dw1N.getD p.val 0 : ℝ)) *
        (u2 p * u1 p) :=
    Finset.sum_congr rfl fun p _ ↦ by ring
  rw [ho 0, ho 1, hv 0, hv 1, hs0, hs1]

private lemma evalLeafPairFast_sound {dw0P dw0N dw1P dw1N : List ℕ}
    (hl0P : dw0P.length = 58) (hl0N : dw0N.length = 58)
