/-- Internal CIPSI certificate helper `sextetBitNat`. -/
def sextetBitNat (w : ℕ) : Bool :=
  if Nat.beq (Nat.mod w 2) 0 then Nat.blt (Nat.div w 2) 33
  else Nat.blt (Nat.div w 2) 30

/-- Internal CIPSI certificate helper `detBitFlips`. -/
def detBitFlips (flips : List ℕ) (w : ℕ) : Bool :=
  if memNat w flips then !sextetBitNat w else sextetBitNat w

/-- Internal CIPSI certificate helper `pqKey`. -/
def pqKey (p q : ℕ) : ℕ :=
  if Nat.ble p q then Nat.add (Nat.mul 64 p) q else Nat.add (Nat.mul 64 q) p

/-- Internal CIPSI certificate helper `checkFlipsGo`. -/
def checkFlipsGo : List ℕ → ℕ → ℕ → ℕ → ℕ → Bool
  | [], _, len, nHole, nPart => Nat.ble len 24 && Nat.beq nHole nPart
  | w :: ws, minW, len, nHole, nPart =>
    if Nat.ble minW w && Nat.blt w 116 then
      let nHole' := if sextetBitNat w then Nat.add nHole 1 else nHole
      let nPart' := if sextetBitNat w then nPart else Nat.add nPart 1
      checkFlipsGo ws (Nat.add w 1) (Nat.add len 1) nHole' nPart'
    else false

/-- Internal CIPSI certificate helper `checkDetsValidGo`. -/
def checkDetsValidGo : DetList → ℕ → Bool
  | .nil, sqAcc => Nat.beq sqAcc deepNormSq
  | .cons _ wa fa rest, sqAcc =>
    if checkFlipsGo fa 0 0 0 0 then
      strictNat (Nat.add sqAcc (Nat.mul wa wa)) fun sqAcc' ↦
        checkDetsValidGo rest sqAcc'
    else false

/-- Internal CIPSI certificate helper `addAtNat`. -/
def addAtNat : ℕ → ℕ → List ℕ → List ℕ
  | _, _, [] => []
  | 0, v, x :: xs => strictNat (Nat.add x v) fun s ↦ s :: xs
  | i + 1, v, x :: xs => x :: addAtNat i v xs

/-- Internal CIPSI certificate helper `addFlipsW`. -/
def addFlipsW (wa2 : ℕ) : List ℕ → List ℕ → List ℕ
  | [], wireW => wireW
  | w :: ws, wireW => addFlipsW wa2 ws (addAtNat w wa2 wireW)

/-- Internal CIPSI certificate helper `diagQuadsInner`. -/
def diagQuadsInner {α : Type} (wa2 kp1 : ℕ) (s1Par ref1 : Bool) :
    List ℕ → QuadAccTree → (Bool → QuadAccTree → α) → α
  | [], tree, k => k true tree
  | w2 :: ws, tree, k =>
    strictNat (Nat.div w2 2) fun p2 ↦
    strictNat (Nat.mul 65 p2) fun kp2 ↦
    strictBool (beqBool ref1 (sextetBitNat w2)) fun sameSign ↦
    (if sameSign then pushQuadTreeCPS kp1 kp2 wa2 0 tree
     else pushQuadTreeCPS kp1 kp2 0 wa2 tree) fun ok1 tree1 ↦
    if !ok1 then k false .empty
    else if beqBool s1Par (Nat.beq (Nat.mod w2 2) 1) then
      strictNat (pqKey (Nat.div kp1 65) p2) fun kp ↦
      (if sameSign then pushQuadTreeCPS kp kp 0 wa2 tree1
       else pushQuadTreeCPS kp kp wa2 0 tree1) fun ok2 tree2 ↦
      if ok2 then diagQuadsInner wa2 kp1 s1Par ref1 ws tree2 k
      else k false .empty
    else
      diagQuadsInner wa2 kp1 s1Par ref1 ws tree1 k

/-- Internal CIPSI certificate helper `diagQuadsOuter`. -/
def diagQuadsOuter {α : Type} (wa2 : ℕ) (fullFlips : List ℕ) :
    List ℕ → QuadAccTree → (Bool → QuadAccTree → α) → α
  | [], tree, k => k true tree
  | w1 :: ws, tree, k =>
    strictNat (Nat.div w1 2) fun p1 ↦
    strictNat (Nat.mul 65 p1) fun kp1 ↦
    strictBool (Nat.beq (Nat.mod w1 2) 1) fun s1Par ↦
    strictBool (sextetBitNat w1) fun ref1 ↦
    diagQuadsInner wa2 kp1 s1Par ref1 fullFlips tree fun ok tree' ↦
      if ok then diagQuadsOuter wa2 fullFlips ws tree' k
      else k false .empty

