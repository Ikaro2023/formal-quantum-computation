/-- Strict natural-number continuation binder forcing WHNF reduction in `decide +kernel`. -/
def strictNat {α : Type} (n : ℕ) (k : ℕ → α) : α :=
  Nat.casesOn n (k 0) (fun m ↦ k (Nat.add m 1))

/-- Elementwise strict continuation binder for `List ℕ`. -/
def strictNatList {α : Type} : List ℕ → (List ℕ → α) → α
  | [], k => k []
  | x :: xs, k => strictNat x fun x' ↦ strictNatList xs fun xs' ↦ k (x' :: xs')

/-- Spine-forcing continuation binder for `List α`. -/
def forceList {α β : Type} : List α → (List α → β) → β
  | [], k => k []
  | x :: xs, k => forceList xs (fun xs' ↦ k (x :: xs'))

/-- Continuation-passing `List.splitAt` avoiding `Prod` allocation in `decide +kernel`. -/
def splitAtList {α β : Type} : ℕ → List α → (List α → List α → β) → β
  | 0, xs, k => k [] xs
  | _ + 1, [], k => k [] []
  | n + 1, x :: xs, k => splitAtList n xs (fun pre suf ↦ k (x :: pre) suf)

lemma strictNat_eq {α : Type} (n : ℕ) (k : ℕ → α) : strictNat n k = k n := by
  cases n <;> rfl

lemma strictNatList_eq {α : Type} : ∀ (xs : List ℕ) (k : List ℕ → α),
    strictNatList xs k = k xs
  | [], _ => rfl
  | _ :: xs, k => by simp [strictNatList, strictNat_eq, strictNatList_eq xs]

lemma forceList_eq {α β : Type} : ∀ (xs : List α) (k : List α → β),
    forceList xs k = k xs
  | [], _ => rfl
  | _ :: xs, k => by simp [forceList, forceList_eq xs]

lemma splitAtList_eq {α β : Type} : ∀ (n : ℕ) (xs : List α) (k : List α → List α → β),
    splitAtList n xs k = k (xs.take n) (xs.drop n)
  | 0, _, _ => rfl
  | _ + 1, [], _ => rfl
  | n + 1, _ :: xs, _ => by simp [splitAtList, splitAtList_eq n xs]

/-- Fixed-point scaling denominator `10 ^ 12` for verified unsigned interval arithmetic. -/
def bScale : ℕ := 1000000000000

/-- Squared fixed-point scaling denominator `10 ^ 24`. -/
def bScale2 : ℕ := 1000000000000000000000000

/-- Power `bScale ^ 4` for octant Taylor bounds. -/
def bScale4 : ℕ := Nat.mul bScale2 bScale2
/-- Power `bScale ^ 6` for octant Taylor bounds. -/
def bScale6 : ℕ := Nat.mul bScale4 bScale2
/-- Power `bScale ^ 8` for octant Taylor bounds. -/
def bScale8 : ℕ := Nat.mul bScale4 bScale4
/-- Power `bScale ^ 9` for octant Taylor bounds. -/
def bScale9 : ℕ := Nat.mul bScale8 bScale
/-- Power `bScale ^ 10` for octant Taylor bounds. -/
def bScale10 : ℕ := Nat.mul bScale8 bScale2
/-- Power `bScale ^ 11` for octant Taylor bounds. -/
def bScale11 : ℕ := Nat.mul bScale10 bScale
/-- Power `bScale ^ 12` for octant Taylor bounds. -/
def bScale12 : ℕ := Nat.mul bScale10 bScale2

/-- Zero-offset `2 * bScale` for unit-bounded Givens entries in `[-1, 1]`. -/
def zOff2 : ℕ := 2000000000000

/-- Zero-offset `64 * bScale` for bounded orbital inner products in `[-64, 64]`. -/
def zOff64 : ℕ := 64000000000000

/-- Upper-range bound `128 * bScale` for offset-`64 * bScale` inner products. -/
def zOff128 : ℕ := 128000000000000

/-- Zero-offset `12288 * bScale` for quadratic leaf-pair contractions in `[-12288, 12288]`. -/
def kZeroOff : ℕ := 12288000000000000

/-- Clamps an unsigned fixed-point upper bound to `bScale`. -/
def clampHiB (x : ℕ) : ℕ := if Nat.ble bScale x then bScale else x

private lemma clampHiB_le (x : ℕ) : clampHiB x ≤ bScale := by
  unfold clampHiB
  split_ifs with h
  · exact le_rfl
  · have : ¬(bScale ≤ x) := fun hle ↦ h (Nat.ble_eq_true_of_le hle)
    omega

private lemma le_clampHiB_of_le {y : ℝ} {x : ℕ} (hyB : y ≤ (bScale : ℝ)) (hyx : y ≤ (x : ℝ)) :
    y ≤ (clampHiB x : ℝ) := by
  unfold clampHiB
  split_ifs <;> assumption

private lemma nat_div_le_real_sbtg {n d : ℕ} :
    ((Nat.div n d : ℕ) : ℝ) * (d : ℝ) ≤ (n : ℝ) := by
  exact_mod_cast Nat.div_mul_le_self n d

private lemma real_le_nat_cdiv_sbtg {n d : ℕ} (hd : 0 < d) :
    (n : ℝ) ≤ ((Nat.div (Nat.add n (Nat.sub d 1)) d : ℕ) : ℝ) * (d : ℝ) := by
  simp only [Nat.add_eq, Nat.sub_eq]
  change (n : ℝ) ≤ (((n + (d - 1)) / d : ℕ) : ℝ) * (d : ℝ)
  have h1 := Nat.div_add_mod (n + (d - 1)) d
  have h2 := Nat.mod_lt (n + (d - 1)) hd
  have hle : n ≤ d * ((n + (d - 1)) / d) := by omega
  rw [Nat.mul_comm] at hle
  exact_mod_cast hle

/-- Unsigned `10 ^ 12`-scaled Taylor interval evaluator on `[0, π / 4]` (`m ≤ 2048`). -/
def octTrig12 {α : Type} (m : ℕ) (k : ℕ → ℕ → ℕ → ℕ → α) : α :=
  strictNat (Nat.div (Nat.mul 314159265358979 m) 819200) fun alo ↦
  strictNat (Nat.div (Nat.add (Nat.mul 314159265358980 m) 819199) 819200) fun ahi ↦
  strictNat (Nat.mul alo alo) fun l2 ↦
  strictNat (Nat.mul l2 l2) fun l4 ↦
  strictNat (Nat.mul l4 l2) fun l6 ↦
  strictNat (Nat.mul l4 l4) fun l8 ↦
  strictNat (Nat.mul l8 l2) fun l10 ↦
  strictNat (Nat.mul l6 l6) fun l12 ↦
  strictNat (Nat.mul ahi ahi) fun h2 ↦
  strictNat (Nat.mul h2 h2) fun h4 ↦
  strictNat (Nat.mul h4 h2) fun h6 ↦
  strictNat (Nat.mul h4 h4) fun h8 ↦
  strictNat (Nat.mul h8 h2) fun h10 ↦
  strictNat (Nat.mul h6 h6) fun h12 ↦
    let cLoPos := Nat.add (Nat.add (Nat.mul 3628800 bScale10)
      (Nat.mul 151200 (Nat.mul bScale6 h4))) (Nat.mul 90 (Nat.mul bScale2 h8))
    let cLoNeg := Nat.add (Nat.add (Nat.mul 1814400 (Nat.mul bScale8 h2))
      (Nat.mul 5040 (Nat.mul bScale4 h6))) h10
    let cLo := Nat.div (Nat.sub cLoPos cLoNeg) (Nat.mul 3628800 bScale9)
    let cHiPos := Nat.add (Nat.add (Nat.add (Nat.mul 479001600 bScale12)
      (Nat.mul 19958400 (Nat.mul bScale8 l4))) (Nat.mul 11880 (Nat.mul bScale4 l8))) l12
    let cHiNeg := Nat.add (Nat.add (Nat.mul 239500800 (Nat.mul bScale10 l2))
      (Nat.mul 665280 (Nat.mul bScale6 l6))) (Nat.mul 132 (Nat.mul bScale2 l10))
    let d12 := Nat.mul 479001600 bScale11
    let cHi := if Nat.ble cHiNeg cHiPos then
      clampHiB (Nat.div (Nat.add (Nat.sub cHiPos cHiNeg) (Nat.sub d12 1)) d12)
    else bScale
    let sLoPos := Nat.add (Nat.add (Nat.mul 39916800 bScale10)
      (Nat.mul 332640 (Nat.mul bScale6 l4))) (Nat.mul 110 (Nat.mul bScale2 l8))
    let sLoNeg := Nat.add (Nat.add (Nat.mul 6652800 (Nat.mul bScale8 l2))
      (Nat.mul 7920 (Nat.mul bScale4 l6))) l10
    let sLo := Nat.div (Nat.mul alo (Nat.sub sLoPos sLoNeg)) (Nat.mul 39916800 bScale10)
    let sHiPos := Nat.add (Nat.add (Nat.add (Nat.mul 6227020800 bScale12)
      (Nat.mul 51891840 (Nat.mul bScale8 h4))) (Nat.mul 17160 (Nat.mul bScale4 h8))) h12
    let sHiNeg := Nat.add (Nat.add (Nat.mul 1037836800 (Nat.mul bScale10 h2))
      (Nat.mul 1235520 (Nat.mul bScale6 h6))) (Nat.mul 156 (Nat.mul bScale2 h10))
    let d13 := Nat.mul 6227020800 bScale12
    let sHi := if Nat.ble sHiNeg sHiPos then
      clampHiB (Nat.div (Nat.add (Nat.mul ahi (Nat.sub sHiPos sHiNeg)) (Nat.sub d13 1)) d13)
    else bScale
    strictNat cLo fun cLo' ↦
    strictNat cHi fun cHi' ↦
    strictNat sLo fun sLo' ↦
    strictNat sHi fun sHi' ↦
      k cLo' cHi' sLo' sHi'

private lemma octTrig12_sound {m : ℕ} (hm : m ≤ 2048) (P : ℕ → ℕ → ℕ → ℕ → Prop)
    (hk : ∀ cL cH sL sH : ℕ,
      cH ≤ bScale → sH ≤ bScale →
      (cL : ℝ) ≤ Real.cos (π * (m : ℝ) / 8192) * (bScale : ℝ) →
      Real.cos (π * (m : ℝ) / 8192) * (bScale : ℝ) ≤ (cH : ℝ) →
      (sL : ℝ) ≤ Real.sin (π * (m : ℝ) / 8192) * (bScale : ℝ) →
      Real.sin (π * (m : ℝ) / 8192) * (bScale : ℝ) ≤ (sH : ℝ) →
      P cL cH sL sH) :
    octTrig12 m P := by
  unfold octTrig12
  simp only [strictNat_eq]
  set alo := Nat.div (Nat.mul 314159265358979 m) 819200
  set ahi := Nat.div (Nat.add (Nat.mul 314159265358980 m) 819199) 819200
  have hpi_lo : (314159265358979 : ℝ) / 10 ^ 14 < π := by linarith [Real.pi_gt_d20]
  have hpi_hi : π < (314159265358980 : ℝ) / 10 ^ 14 := by linarith [Real.pi_lt_d20]
  have halo_mul : (alo : ℝ) * 819200 ≤ 314159265358979 * (m : ℝ) := by
    have := Nat.div_mul_le_self (314159265358979 * m) 819200
    exact_mod_cast this
  have hahi_mul : 314159265358980 * (m : ℝ) ≤ (ahi : ℝ) * 819200 ∧
      (ahi : ℝ) * 819200 ≤ 314159265358980 * (m : ℝ) + 819199 := by
    have hdef : ahi = (314159265358980 * m + 819199) / 819200 := rfl
    have h1 := Nat.div_add_mod (314159265358980 * m + 819199) 819200
    have h2 := Nat.mod_lt (314159265358980 * m + 819199) (by decide : 0 < 819200)
    have ha1 : 314159265358980 * m ≤ ahi * 819200 := by omega
    have ha2 : ahi * 819200 ≤ 314159265358980 * m + 819199 := by omega
    exact ⟨by exact_mod_cast ha1, by exact_mod_cast ha2⟩
  have hmR : (m : ℝ) ≤ 2048 := Nat.cast_le.mpr hm
  have hm0 : (0 : ℝ) ≤ (m : ℝ) := by positivity
  have hBpos : (0 : ℝ) < (bScale : ℝ) := by norm_num [bScale]
  have hBne : (bScale : ℝ) ≠ 0 := hBpos.ne'
  have hxlo_nn : 0 ≤ (alo : ℝ) / (bScale : ℝ) := by positivity
  have hxhi_nn : 0 ≤ (ahi : ℝ) / (bScale : ℝ) := by positivity
  have h_alo_le : (alo : ℝ) / (bScale : ℝ) ≤ π * (m : ℝ) / 8192 := by
    rw [div_le_div_iff₀ hBpos (by norm_num)]; norm_num [bScale]; nlinarith
  have h_le_ahi : π * (m : ℝ) / 8192 ≤ (ahi : ℝ) / (bScale : ℝ) := by
    rw [div_le_div_iff₀ (by norm_num) hBpos]; norm_num [bScale]; nlinarith [hahi_mul.1]
  have h_ahi_pi2 : (ahi : ℝ) / (bScale : ℝ) ≤ π / 2 := by
    rw [div_le_div_iff₀ hBpos (by norm_num)]; norm_num [bScale]; linarith [hahi_mul.2]
  have hα_nn : 0 ≤ π * (m : ℝ) / 8192 := hxlo_nn.trans h_alo_le
  have hα_pi2 : π * (m : ℝ) / 8192 ≤ π / 2 := h_le_ahi.trans h_ahi_pi2
  have hcos_nn : 0 ≤ Real.cos (π * (m : ℝ) / 8192) :=
    Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], hα_pi2⟩
  have hsin_nn : 0 ≤ Real.sin (π * (m : ℝ) / 8192) :=
    Real.sin_nonneg_of_nonneg_of_le_pi hα_nn (by linarith [Real.pi_pos])
  have hcos_mono_lo : Real.cos ((ahi : ℝ) / (bScale : ℝ)) ≤ Real.cos (π * (m : ℝ) / 8192) :=
    Real.cos_le_cos_of_nonneg_of_le_pi hα_nn (by linarith [Real.pi_pos]) h_le_ahi
  have hcos_mono_hi : Real.cos (π * (m : ℝ) / 8192) ≤ Real.cos ((alo : ℝ) / (bScale : ℝ)) :=
    Real.cos_le_cos_of_nonneg_of_le_pi hxlo_nn (by linarith [Real.pi_pos]) h_alo_le
  have hsin_mono_lo : Real.sin ((alo : ℝ) / (bScale : ℝ)) ≤ Real.sin (π * (m : ℝ) / 8192) :=
    Real.sin_le_sin_of_le_of_le_pi_div_two (by linarith [Real.pi_pos]) hα_pi2 h_alo_le
  have hsin_mono_hi : Real.sin (π * (m : ℝ) / 8192) ≤ Real.sin ((ahi : ℝ) / (bScale : ℝ)) :=
    Real.sin_le_sin_of_le_of_le_pi_div_two (by linarith [Real.pi_pos]) h_ahi_pi2 h_le_ahi
  refine hk _ _ _ _ ?_ ?_ ?_ ?_ ?_ ?_
  · split_ifs
    · exact clampHiB_le _
    · exact le_rfl
  · split_ifs
    · exact clampHiB_le _
    · exact le_rfl
  · set cLoPos := Nat.add (Nat.add (Nat.mul 3628800 bScale10)
      (Nat.mul 151200 (Nat.mul bScale6 (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi)))))
      (Nat.mul 90 (Nat.mul bScale2 (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))
        (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi)))))
    set cLoNeg := Nat.add (Nat.add (Nat.mul 1814400 (Nat.mul bScale8 (Nat.mul ahi ahi)))
      (Nat.mul 5040 (Nat.mul bScale4 (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))
        (Nat.mul ahi ahi)))))
      (Nat.mul (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))
        (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))) (Nat.mul ahi ahi))
    by_cases hsub : cLoNeg ≤ cLoPos
    · have hd : 0 < Nat.mul 3628800 bScale9 := by decide
      have hdR : (0 : ℝ) < ((Nat.mul 3628800 bScale9 : ℕ) : ℝ) := by exact_mod_cast hd
      have hf := nat_div_le_real_sbtg (n := Nat.sub cLoPos cLoNeg) (d := Nat.mul 3628800 bScale9)
      have hcast : ((Nat.sub cLoPos cLoNeg : ℕ) : ℝ) =
          (1 - ((ahi : ℝ) / bScale) ^ 2 / 2 + ((ahi : ℝ) / bScale) ^ 4 / 24 -
            ((ahi : ℝ) / bScale) ^ 6 / 720 + ((ahi : ℝ) / bScale) ^ 8 / 40320 -
            ((ahi : ℝ) / bScale) ^ 10 / 3628800) * (bScale : ℝ) *
            ((Nat.mul 3628800 bScale9 : ℕ) : ℝ) := by
        change ((cLoPos - cLoNeg : ℕ) : ℝ) = _
        rw [Nat.cast_sub hsub]
        simp only [cLoPos, cLoNeg, Nat.add_eq, Nat.mul_eq, bScale10, bScale9, bScale8, bScale6,
          bScale4, bScale2, bScale]
        push_cast; ring
      rw [hcast] at hf
      exact (le_of_mul_le_mul_right hf hdR).trans
        (mul_le_mul_of_nonneg_right ((cos_ge_deg10 hxhi_nn).trans hcos_mono_lo) hBpos.le)
    · have hz : Nat.sub cLoPos cLoNeg = 0 := Nat.sub_eq_zero_of_le (by omega)
      have hz0 : Nat.div 0 (Nat.mul 3628800 bScale9) = 0 := by decide
      rw [hz, hz0, Nat.cast_zero]
      exact mul_nonneg hcos_nn hBpos.le
  · set cHiPos := Nat.add (Nat.add (Nat.add (Nat.mul 479001600 bScale12)
      (Nat.mul 19958400 (Nat.mul bScale8 (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo)))))
      (Nat.mul 11880 (Nat.mul bScale4 (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))
        (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))))))
      (Nat.mul (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo)) (Nat.mul alo alo))
        (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo)) (Nat.mul alo alo)))
    set cHiNeg := Nat.add (Nat.add (Nat.mul 239500800 (Nat.mul bScale10 (Nat.mul alo alo)))
      (Nat.mul 665280 (Nat.mul bScale6 (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))
        (Nat.mul alo alo)))))
      (Nat.mul 132 (Nat.mul bScale2 (Nat.mul (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))
        (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))) (Nat.mul alo alo))))
    have hcosB : Real.cos (π * (m : ℝ) / 8192) * (bScale : ℝ) ≤ (bScale : ℝ) := by
      nlinarith [Real.cos_le_one (π * (m : ℝ) / 8192)]
    split_ifs with hble
    · refine le_clampHiB_of_le hcosB ?_
      have hsub : cHiNeg ≤ cHiPos := Nat.le_of_ble_eq_true hble
      have hd : 0 < Nat.mul 479001600 bScale11 := by decide
      have hdR : (0 : ℝ) < ((Nat.mul 479001600 bScale11 : ℕ) : ℝ) := by exact_mod_cast hd
      have hc := real_le_nat_cdiv_sbtg (n := Nat.sub cHiPos cHiNeg) hd
      have hcast : ((Nat.sub cHiPos cHiNeg : ℕ) : ℝ) =
          (1 - ((alo : ℝ) / bScale) ^ 2 / 2 + ((alo : ℝ) / bScale) ^ 4 / 24 -
            ((alo : ℝ) / bScale) ^ 6 / 720 + ((alo : ℝ) / bScale) ^ 8 / 40320 -
            ((alo : ℝ) / bScale) ^ 10 / 3628800 + ((alo : ℝ) / bScale) ^ 12 / 479001600) *
            (bScale : ℝ) * ((Nat.mul 479001600 bScale11 : ℕ) : ℝ) := by
        change ((cHiPos - cHiNeg : ℕ) : ℝ) = _
        rw [Nat.cast_sub hsub]
        simp only [cHiPos, cHiNeg, Nat.add_eq, Nat.mul_eq, bScale12, bScale11, bScale10, bScale8,
          bScale6, bScale4, bScale2, bScale]
        push_cast; ring
      rw [hcast] at hc
      exact (mul_le_mul_of_nonneg_right (hcos_mono_hi.trans (cos_le_deg12 hxlo_nn)) hBpos.le).trans
        (le_of_mul_le_mul_right hc hdR)
    · exact hcosB
  · set sLoPos := Nat.add (Nat.add (Nat.mul 39916800 bScale10)
      (Nat.mul 332640 (Nat.mul bScale6 (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo)))))
      (Nat.mul 110 (Nat.mul bScale2 (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))
        (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo)))))
    set sLoNeg := Nat.add (Nat.add (Nat.mul 6652800 (Nat.mul bScale8 (Nat.mul alo alo)))
      (Nat.mul 7920 (Nat.mul bScale4 (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))
        (Nat.mul alo alo)))))
      (Nat.mul (Nat.mul (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))
        (Nat.mul (Nat.mul alo alo) (Nat.mul alo alo))) (Nat.mul alo alo))
    by_cases hsub : sLoNeg ≤ sLoPos
    · have hd : 0 < Nat.mul 39916800 bScale10 := by decide
      have hdR : (0 : ℝ) < ((Nat.mul 39916800 bScale10 : ℕ) : ℝ) := by exact_mod_cast hd
      have hf := nat_div_le_real_sbtg (n := Nat.mul alo (Nat.sub sLoPos sLoNeg))
        (d := Nat.mul 39916800 bScale10)
      have hcast : ((Nat.mul alo (Nat.sub sLoPos sLoNeg) : ℕ) : ℝ) =
          (((alo : ℝ) / bScale) - ((alo : ℝ) / bScale) ^ 3 / 6 + ((alo : ℝ) / bScale) ^ 5 / 120 -
            ((alo : ℝ) / bScale) ^ 7 / 5040 + ((alo : ℝ) / bScale) ^ 9 / 362880 -
            ((alo : ℝ) / bScale) ^ 11 / 39916800) * (bScale : ℝ) *
            ((Nat.mul 39916800 bScale10 : ℕ) : ℝ) := by
        change ((alo * (sLoPos - sLoNeg) : ℕ) : ℝ) = _
        rw [Nat.cast_mul, Nat.cast_sub hsub]
        simp only [sLoPos, sLoNeg, Nat.add_eq, Nat.mul_eq, bScale10, bScale8, bScale6, bScale4,
          bScale2, bScale]
        push_cast; ring
      rw [hcast] at hf
      exact (le_of_mul_le_mul_right hf hdR).trans
        (mul_le_mul_of_nonneg_right ((sin_ge_deg11 hxlo_nn).trans hsin_mono_lo) hBpos.le)
    · have hz : Nat.sub sLoPos sLoNeg = 0 := Nat.sub_eq_zero_of_le (by omega)
      have hz0 : Nat.div (Nat.mul alo 0) (Nat.mul 39916800 bScale10) = 0 := by
        simp only [Nat.mul_eq, Nat.mul_zero]; decide
      rw [hz, hz0, Nat.cast_zero]
      exact mul_nonneg hsin_nn hBpos.le
  · set sHiPos := Nat.add (Nat.add (Nat.add (Nat.mul 6227020800 bScale12)
      (Nat.mul 51891840 (Nat.mul bScale8 (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi)))))
      (Nat.mul 17160 (Nat.mul bScale4 (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))
        (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))))))
      (Nat.mul (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi)) (Nat.mul ahi ahi))
        (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi)) (Nat.mul ahi ahi)))
    set sHiNeg := Nat.add (Nat.add (Nat.mul 1037836800 (Nat.mul bScale10 (Nat.mul ahi ahi)))
      (Nat.mul 1235520 (Nat.mul bScale6 (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))
        (Nat.mul ahi ahi)))))
      (Nat.mul 156 (Nat.mul bScale2 (Nat.mul (Nat.mul (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))
        (Nat.mul (Nat.mul ahi ahi) (Nat.mul ahi ahi))) (Nat.mul ahi ahi))))
    have hsinB : Real.sin (π * (m : ℝ) / 8192) * (bScale : ℝ) ≤ (bScale : ℝ) := by
      nlinarith [Real.sin_le_one (π * (m : ℝ) / 8192)]
    split_ifs with hble
    · refine le_clampHiB_of_le hsinB ?_
      have hsub : sHiNeg ≤ sHiPos := Nat.le_of_ble_eq_true hble
      have hd : 0 < Nat.mul 6227020800 bScale12 := by decide
      have hdR : (0 : ℝ) < ((Nat.mul 6227020800 bScale12 : ℕ) : ℝ) := by exact_mod_cast hd
      have hc := real_le_nat_cdiv_sbtg (n := Nat.mul ahi (Nat.sub sHiPos sHiNeg)) hd
      have hcast : ((Nat.mul ahi (Nat.sub sHiPos sHiNeg) : ℕ) : ℝ) =
          (((ahi : ℝ) / bScale) - ((ahi : ℝ) / bScale) ^ 3 / 6 + ((ahi : ℝ) / bScale) ^ 5 / 120 -
            ((ahi : ℝ) / bScale) ^ 7 / 5040 + ((ahi : ℝ) / bScale) ^ 9 / 362880 -
            ((ahi : ℝ) / bScale) ^ 11 / 39916800 + ((ahi : ℝ) / bScale) ^ 13 / 6227020800) *
            (bScale : ℝ) * ((Nat.mul 6227020800 bScale12 : ℕ) : ℝ) := by
        change ((ahi * (sHiPos - sHiNeg) : ℕ) : ℝ) = _
        rw [Nat.cast_mul, Nat.cast_sub hsub]
        simp only [sHiPos, sHiNeg, Nat.add_eq, Nat.mul_eq, bScale12, bScale10, bScale8, bScale6,
          bScale4, bScale2, bScale]
        push_cast; ring
      rw [hcast] at hc
      exact (mul_le_mul_of_nonneg_right (hsin_mono_hi.trans (sin_le_deg13 hxhi_nn)) hBpos.le).trans
        (le_of_mul_le_mul_right hc hdR)
    · exact hsinB

lemma octTrig12_comp {α β : Type} (f : α → β) (m : ℕ) (k : ℕ → ℕ → ℕ → ℕ → α) :
    octTrig12 m (fun a b c d ↦ f (k a b c d)) = f (octTrig12 m k) := by
  unfold octTrig12; simp only [strictNat_eq]

/-- Offset-`2 * bScale` interval validity for unit-bounded Givens entries `|x| ≤ 1`. -/
def ValidZ2 (oL oW : ℕ) (x : ℝ) : Prop :=
  bScale ≤ oL ∧ oL ≤ 3 * bScale ∧ |x| ≤ 1 ∧
    (oL : ℝ) - (zOff2 : ℝ) ≤ x * (bScale : ℝ) ∧
    x * (bScale : ℝ) ≤ (oL : ℝ) + (oW : ℝ) - (zOff2 : ℝ)

/-- Pairwise `ValidZ2` across lower-endpoint, width, and real lists of equal length. -/
inductive ValidZ2List : List ℕ → List ℕ → List ℝ → Prop
  /-- Empty lists satisfy `ValidZ2List`. -/
  | nil : ValidZ2List [] [] []
  /-- Head and tail lists satisfy `ValidZ2List`. -/
  | cons {l w : ℕ} {x : ℝ} {ls ws : List ℕ} {xs : List ℝ} :
      ValidZ2 l w x → ValidZ2List ls ws xs → ValidZ2List (l :: ls) (w :: ws) (x :: xs)

lemma ValidZ2List.lengths {ls ws : List ℕ} {xs : List ℝ} (h : ValidZ2List ls ws xs) :
    ls.length = xs.length ∧ ws.length = xs.length := by
  induction h with
  | nil => simp
  | cons _ _ ih => simp [ih.1, ih.2]

lemma ValidZ2List.append {l1 w1 l2 w2 : List ℕ} {x1 x2 : List ℝ}
    (h1 : ValidZ2List l1 w1 x1) (h2 : ValidZ2List l2 w2 x2) :
    ValidZ2List (l1 ++ l2) (w1 ++ w2) (x1 ++ x2) := by
  induction h1 with
  | nil => exact h2
  | cons hd _ ih => exact .cons hd ih

lemma ValidZ2List.take {ls ws : List ℕ} {xs : List ℝ} (h : ValidZ2List ls ws xs) :
    ∀ n : ℕ, ValidZ2List (ls.take n) (ws.take n) (xs.take n) := by
  induction h with
  | nil => intro n; simp [ValidZ2List.nil]
  | cons hd _ ih =>
    intro n
    cases n with
    | zero => exact .nil
    | succ m => exact .cons hd (ih m)

lemma ValidZ2List.drop {ls ws : List ℕ} {xs : List ℝ} (h : ValidZ2List ls ws xs) :
    ∀ n : ℕ, ValidZ2List (ls.drop n) (ws.drop n) (xs.drop n) := by
  induction h with
  | nil => intro n; simp [ValidZ2List.nil]
  | cons _ tl ih =>
    intro n
    cases n with
    | zero => exact .cons ‹_› tl
    | succ m => exact ih m

private lemma validZ2_fallback {x : ℝ} (hx : |x| ≤ 1) : ValidZ2 bScale zOff2 x := by
  obtain ⟨hx1, hx2⟩ := abs_le.mp hx
  refine ⟨le_rfl, by decide, hx, ?_, ?_⟩ <;> norm_num [bScale, zOff2] <;> nlinarith

private lemma validZ2List_replicate : ∀ (xs : List ℝ), (∀ x ∈ xs, |x| ≤ 1) →
    ValidZ2List (List.replicate xs.length bScale) (List.replicate xs.length zOff2) xs
  | [], _ => .nil
  | x :: xs, hx => .cons (validZ2_fallback (hx x (by simp)))
      (validZ2List_replicate xs fun y hy ↦ hx y (by simp [hy]))

private lemma pos_prod_bounds {pref c : ℝ} {pL pH cL cH : ℕ}
    (hp0 : 0 ≤ pref) (hp1 : pref ≤ 1) (hpH : pH ≤ bScale)
    (hpL_le : (pL : ℝ) ≤ pref * (bScale : ℝ)) (h_le_pH : pref * (bScale : ℝ) ≤ (pH : ℝ))
    (hc0 : 0 ≤ c) (hc1 : c ≤ 1) (hcHb : cH ≤ bScale)
    (hcL_le : (cL : ℝ) ≤ c * (bScale : ℝ)) (h_le_cH : c * (bScale : ℝ) ≤ (cH : ℝ)) :
    let oL := Nat.div (Nat.mul pL cL) bScale
    let oH := Nat.div (Nat.add (Nat.mul pH cH) (Nat.sub bScale 1)) bScale
    0 ≤ pref * c ∧ pref * c ≤ 1 ∧ oL ≤ oH ∧ oH ≤ bScale ∧
      (oL : ℝ) ≤ pref * c * (bScale : ℝ) ∧ pref * c * (bScale : ℝ) ≤ (oH : ℝ) := by
  intro oL oH
  have hB : 0 < bScale := by decide
  have hBR : (0 : ℝ) < (bScale : ℝ) := by norm_num [bScale]
  have hpc0 : 0 ≤ pref * c := mul_nonneg hp0 hc0
  have hpc1 : pref * c ≤ 1 := by nlinarith
  have hoH_le : oH ≤ bScale := by
    have hm : pH * cH ≤ bScale * bScale := Nat.mul_le_mul hpH hcHb
    have hdiv := Nat.div_le_div_right (c := bScale)
      (show pH * cH + (bScale - 1) ≤ bScale * bScale + (bScale - 1) by omega)
    have hrhs : (bScale * bScale + (bScale - 1)) / bScale = bScale := by decide
    change (pH * cH + (bScale - 1)) / bScale ≤ bScale
    rw [← hrhs]
    exact hdiv
  have hoL_R : (oL : ℝ) ≤ pref * c * (bScale : ℝ) := by
    have hd : ((oL : ℕ) : ℝ) * (bScale : ℝ) ≤ ((pL * cL : ℕ) : ℝ) := by
      exact_mod_cast Nat.div_mul_le_self (pL * cL) bScale
    have hm : ((pL * cL : ℕ) : ℝ) ≤ (pref * (bScale : ℝ)) * (c * (bScale : ℝ)) := by
      rw [Nat.cast_mul]
      exact mul_le_mul hpL_le hcL_le (by positivity) (by positivity)
    have h1 : (oL : ℝ) * (bScale : ℝ) ≤ (pref * c * (bScale : ℝ)) * (bScale : ℝ) := by
      linarith [show (pref * (bScale : ℝ)) * (c * (bScale : ℝ)) =
        (pref * c * (bScale : ℝ)) * (bScale : ℝ) by ring]
    exact le_of_mul_le_mul_right h1 hBR
  have hoH_R : pref * c * (bScale : ℝ) ≤ (oH : ℝ) := by
    have hcR : ((Nat.mul pH cH : ℕ) : ℝ) ≤ (oH : ℝ) * (bScale : ℝ) :=
      real_le_nat_cdiv_sbtg (n := Nat.mul pH cH) hB
    simp only [Nat.mul_eq] at hcR
    have hm : (pref * (bScale : ℝ)) * (c * (bScale : ℝ)) ≤ ((pH * cH : ℕ) : ℝ) := by
      rw [Nat.cast_mul]
      exact mul_le_mul h_le_pH h_le_cH (by positivity) (by positivity)
    have h3 : (pref * c * (bScale : ℝ)) * (bScale : ℝ) ≤ (oH : ℝ) * (bScale : ℝ) := by
      linarith [show (pref * (bScale : ℝ)) * (c * (bScale : ℝ)) =
        (pref * c * (bScale : ℝ)) * (bScale : ℝ) by ring]
    exact le_of_mul_le_mul_right h3 hBR
  have hoLH : oL ≤ oH := Nat.cast_le.mp (hoL_R.trans hoH_R)
  exact ⟨hpc0, hpc1, hoLH, hoH_le, hoL_R, hoH_R⟩

private lemma pos_prod_validZ2 {pref c : ℝ} {oL oH : ℕ}
    (hpc0 : 0 ≤ pref * c) (hpc1 : pref * c ≤ 1) (hoLH : oL ≤ oH) (hoH_le : oH ≤ bScale)
    (hoL_R : (oL : ℝ) ≤ pref * c * (bScale : ℝ)) (hoH_R : pref * c * (bScale : ℝ) ≤ (oH : ℝ)) :
    ValidZ2 (Nat.add zOff2 oL) (Nat.sub oH oL) (pref * c) := by
  have hoLb : oL ≤ bScale := hoLH.trans hoH_le
  have h1 : bScale ≤ Nat.add zOff2 oL := by
    simp only [Nat.add_eq, bScale, zOff2]; omega
  have h2 : Nat.add zOff2 oL ≤ 3 * bScale := by
    simp only [Nat.add_eq, bScale, zOff2] at hoLb ⊢; omega
  refine ⟨h1, h2, abs_le.mpr ⟨by linarith, hpc1⟩, ?_, ?_⟩
  · simp only [Nat.add_eq, Nat.cast_add]; linarith
  · simp only [Nat.add_eq, Nat.sub_eq, Nat.cast_add, Nat.cast_sub hoLH]; linarith

private lemma neg_prod_validZ2 {pref c : ℝ} {magLo magHi : ℕ}
    (hpc0 : 0 ≤ pref * c) (hpc1 : pref * c ≤ 1) (hmLH : magLo ≤ magHi) (hmH_le : magHi ≤ bScale)
    (hmL_R : (magLo : ℝ) ≤ pref * c * (bScale : ℝ))
    (hmH_R : pref * c * (bScale : ℝ) ≤ (magHi : ℝ)) :
    ValidZ2 (Nat.sub zOff2 magHi) (Nat.sub magHi magLo) (pref * (-c)) := by
  have hz : magHi ≤ zOff2 := by simp only [bScale, zOff2] at hmH_le ⊢; omega
  have h1 : bScale ≤ Nat.sub zOff2 magHi := by
    simp only [Nat.sub_eq, bScale, zOff2] at hmH_le ⊢; omega
  have h2 : Nat.sub zOff2 magHi ≤ 3 * bScale := by
    simp only [Nat.sub_eq, bScale, zOff2]; omega
  refine ⟨h1, h2, abs_le.mpr ⟨by linarith, by linarith⟩, ?_, ?_⟩
  · simp only [Nat.sub_eq, Nat.cast_sub hz]; linarith
  · simp only [Nat.sub_eq, Nat.cast_sub hz, Nat.cast_sub hmLH]; linarith

/-- Single-step unsigned Givens angle interval evaluator across `[0, π]`. -/
def stepGivens {α : Type} (idx pL pH : ℕ) (k : ℕ → ℕ → ℕ → ℕ → α) : α :=
  if Nat.ble idx 2048 then
    octTrig12 idx fun cL cH sL sH ↦
    strictNat (Nat.div (Nat.mul pL cL) bScale) fun oL ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH cH) (Nat.sub bScale 1)) bScale) fun oH ↦
    strictNat (Nat.div (Nat.mul pL sL) bScale) fun npL ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH sH) (Nat.sub bScale 1)) bScale) fun npH ↦
      k (Nat.add zOff2 oL) (Nat.sub oH oL) npL npH
  else if Nat.ble idx 4096 then
    octTrig12 (Nat.sub 4096 idx) fun cL cH sL sH ↦
    strictNat (Nat.div (Nat.mul pL sL) bScale) fun oL ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH sH) (Nat.sub bScale 1)) bScale) fun oH ↦
    strictNat (Nat.div (Nat.mul pL cL) bScale) fun npL ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH cH) (Nat.sub bScale 1)) bScale) fun npH ↦
      k (Nat.add zOff2 oL) (Nat.sub oH oL) npL npH
  else if Nat.ble idx 6144 then
    octTrig12 (Nat.sub idx 4096) fun cL cH sL sH ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH sH) (Nat.sub bScale 1)) bScale) fun magHi ↦
    strictNat (Nat.div (Nat.mul pL sL) bScale) fun magLo ↦
    strictNat (Nat.div (Nat.mul pL cL) bScale) fun npL ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH cH) (Nat.sub bScale 1)) bScale) fun npH ↦
      k (Nat.sub zOff2 magHi) (Nat.sub magHi magLo) npL npH
  else
    octTrig12 (Nat.sub 8192 idx) fun cL cH sL sH ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH cH) (Nat.sub bScale 1)) bScale) fun magHi ↦
    strictNat (Nat.div (Nat.mul pL cL) bScale) fun magLo ↦
    strictNat (Nat.div (Nat.mul pL sL) bScale) fun npL ↦
    strictNat (Nat.div (Nat.add (Nat.mul pH sH) (Nat.sub bScale 1)) bScale) fun npH ↦
      k (Nat.sub zOff2 magHi) (Nat.sub magHi magLo) npL npH

private lemma octant_cos_sin_bounds {m : ℕ} (hm : m ≤ 2048) :
    0 ≤ Real.cos (π * (m : ℝ) / 8192) ∧ Real.cos (π * (m : ℝ) / 8192) ≤ 1 ∧
    0 ≤ Real.sin (π * (m : ℝ) / 8192) ∧ Real.sin (π * (m : ℝ) / 8192) ≤ 1 := by
  have hmR : (m : ℝ) ≤ 2048 := Nat.cast_le.mpr hm
  have hpi : 0 < π := Real.pi_pos
  have h0 : 0 ≤ π * (m : ℝ) / 8192 := by positivity
  have hpi2 : π * (m : ℝ) / 8192 ≤ π / 2 := by nlinarith
  exact ⟨Real.cos_nonneg_of_mem_Icc ⟨by linarith, hpi2⟩, Real.cos_le_one _,
    Real.sin_nonneg_of_nonneg_of_le_pi h0 (by linarith), Real.sin_le_one _⟩

private lemma stepGivens_sound {idx pL pH : ℕ} {pref : ℝ}
    (hidx : idx ≤ 8192) (hp0 : 0 ≤ pref) (hp1 : pref ≤ 1) (hpH : pH ≤ bScale)
    (hpL_R : (pL : ℝ) ≤ pref * (bScale : ℝ)) (h_R_pH : pref * (bScale : ℝ) ≤ (pH : ℝ))
    (P : ℕ → ℕ → ℕ → ℕ → Prop)
    (hk : ∀ oL oW npL npH : ℕ,
      ValidZ2 oL oW (pref * Real.cos (π * (idx : ℝ) / 8192)) →
      0 ≤ pref * Real.sin (π * (idx : ℝ) / 8192) →
      pref * Real.sin (π * (idx : ℝ) / 8192) ≤ 1 →
      npH ≤ bScale →
      (npL : ℝ) ≤ pref * Real.sin (π * (idx : ℝ) / 8192) * (bScale : ℝ) →
      pref * Real.sin (π * (idx : ℝ) / 8192) * (bScale : ℝ) ≤ (npH : ℝ) →
      P oL oW npL npH) :
    stepGivens idx pL pH P := by
  unfold stepGivens
  split_ifs with h1 h2 h3
  · have hm : idx ≤ 2048 := Nat.le_of_ble_eq_true h1
    obtain ⟨hc0, hc1, hs0, hs1⟩ := octant_cos_sin_bounds hm
    refine octTrig12_sound hm _ fun cL cH sL sH hcH hsH hcLR hRcH hsLR hRsH ↦ ?_
    simp only [strictNat_eq]
    obtain ⟨hpc0, hpc1, hoLH, hoHb, hoLR, hoHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hc0 hc1 hcH hcLR hRcH
    obtain ⟨hps0, hps1, _, hnpHb, hnpLR, hnpHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hs0 hs1 hsH hsLR hRsH
    exact hk _ _ _ _ (pos_prod_validZ2 hpc0 hpc1 hoLH hoHb hoLR hoHR) hps0 hps1 hnpHb hnpLR hnpHR
  · have hgt1 : 2048 < idx := by
      have : ¬(idx ≤ 2048) := fun h ↦ h1 (Nat.ble_eq_true_of_le h); omega
    have hle2 : idx ≤ 4096 := Nat.le_of_ble_eq_true h2
    have hm : Nat.sub 4096 idx ≤ 2048 := by change 4096 - idx ≤ 2048; omega
    obtain ⟨hc0, hc1, hs0, hs1⟩ := octant_cos_sin_bounds hm
    have hang : π * (idx : ℝ) / 8192 = π / 2 - π * ((Nat.sub 4096 idx : ℕ) : ℝ) / 8192 := by
      change _ = π / 2 - π * ((4096 - idx : ℕ) : ℝ) / 8192
      rw [Nat.cast_sub hle2]; push_cast; ring
    have hcos_eq : Real.cos (π * (idx : ℝ) / 8192) =
        Real.sin (π * ((Nat.sub 4096 idx : ℕ) : ℝ) / 8192) := by
      rw [hang, Real.cos_pi_div_two_sub]
    have hsin_eq : Real.sin (π * (idx : ℝ) / 8192) =
        Real.cos (π * ((Nat.sub 4096 idx : ℕ) : ℝ) / 8192) := by
      rw [hang, Real.sin_pi_div_two_sub]
    refine octTrig12_sound hm _ fun cL cH sL sH hcH hsH hcLR hRcH hsLR hRsH ↦ ?_
    simp only [strictNat_eq]
    obtain ⟨hps0, hps1, hoLH, hoHb, hoLR, hoHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hs0 hs1 hsH hsLR hRsH
    obtain ⟨hpc0, hpc1, _, hnpHb, hnpLR, hnpHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hc0 hc1 hcH hcLR hRcH
    rw [hcos_eq, hsin_eq] at hk
    exact hk _ _ _ _ (pos_prod_validZ2 hps0 hps1 hoLH hoHb hoLR hoHR) hpc0 hpc1 hnpHb hnpLR hnpHR
  · have hgt2 : 4096 < idx := by
      have : ¬(idx ≤ 4096) := fun h ↦ h2 (Nat.ble_eq_true_of_le h); omega
    have hle3 : idx ≤ 6144 := Nat.le_of_ble_eq_true h3
    have hm : Nat.sub idx 4096 ≤ 2048 := by change idx - 4096 ≤ 2048; omega
    obtain ⟨hc0, hc1, hs0, hs1⟩ := octant_cos_sin_bounds hm
    have hang : π * (idx : ℝ) / 8192 = π * ((Nat.sub idx 4096 : ℕ) : ℝ) / 8192 + π / 2 := by
      change _ = π * ((idx - 4096 : ℕ) : ℝ) / 8192 + π / 2
      rw [Nat.cast_sub (by omega : 4096 ≤ idx)]; push_cast; ring
    have hcos_eq : Real.cos (π * (idx : ℝ) / 8192) =
        -Real.sin (π * ((Nat.sub idx 4096 : ℕ) : ℝ) / 8192) := by
      rw [hang, Real.cos_add_pi_div_two]
    have hsin_eq : Real.sin (π * (idx : ℝ) / 8192) =
        Real.cos (π * ((Nat.sub idx 4096 : ℕ) : ℝ) / 8192) := by
      rw [hang, Real.sin_add_pi_div_two]
    refine octTrig12_sound hm _ fun cL cH sL sH hcH hsH hcLR hRcH hsLR hRsH ↦ ?_
    simp only [strictNat_eq]
    obtain ⟨hps0, hps1, hmLH, hmHb, hmLR, hmHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hs0 hs1 hsH hsLR hRsH
    obtain ⟨hpc0, hpc1, _, hnpHb, hnpLR, hnpHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hc0 hc1 hcH hcLR hRcH
    rw [hcos_eq, hsin_eq] at hk
    exact hk _ _ _ _ (neg_prod_validZ2 hps0 hps1 hmLH hmHb hmLR hmHR) hpc0 hpc1 hnpHb hnpLR hnpHR
  · have hgt3 : 6144 < idx := by
      have : ¬(idx ≤ 6144) := fun h ↦ h3 (Nat.ble_eq_true_of_le h); omega
    have hm : Nat.sub 8192 idx ≤ 2048 := by change 8192 - idx ≤ 2048; omega
    obtain ⟨hc0, hc1, hs0, hs1⟩ := octant_cos_sin_bounds hm
    have hang : π * (idx : ℝ) / 8192 = π - π * ((Nat.sub 8192 idx : ℕ) : ℝ) / 8192 := by
      change _ = π - π * ((8192 - idx : ℕ) : ℝ) / 8192
      rw [Nat.cast_sub hidx]; push_cast; ring
    have hcos_eq : Real.cos (π * (idx : ℝ) / 8192) =
        -Real.cos (π * ((Nat.sub 8192 idx : ℕ) : ℝ) / 8192) := by
      rw [hang, Real.cos_pi_sub]
    have hsin_eq : Real.sin (π * (idx : ℝ) / 8192) =
        Real.sin (π * ((Nat.sub 8192 idx : ℕ) : ℝ) / 8192) := by
      rw [hang, Real.sin_pi_sub]
    refine octTrig12_sound hm _ fun cL cH sL sH hcH hsH hcLR hRcH hsLR hRsH ↦ ?_
    simp only [strictNat_eq]
    obtain ⟨hpc0, hpc1, hmLH, hmHb, hmLR, hmHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hc0 hc1 hcH hcLR hRcH
    obtain ⟨hps0, hps1, _, hnpHb, hnpLR, hnpHR⟩ :=
      pos_prod_bounds hp0 hp1 hpH hpL_R h_R_pH hs0 hs1 hsH hsLR hRsH
    rw [hcos_eq, hsin_eq] at hk
    exact hk _ _ _ _ (neg_prod_validZ2 hpc0 hpc1 hmLH hmHb hmLR hmHR) hps0 hps1 hnpHb hnpLR hnpHR

lemma stepGivens_comp {α β : Type} (f : α → β) (idx pL pH : ℕ) (k : ℕ → ℕ → ℕ → ℕ → α) :
    stepGivens idx pL pH (fun a b c d ↦ f (k a b c d)) = f (stepGivens idx pL pH k) := by
  unfold stepGivens
  split_ifs <;> simp only [strictNat_eq, octTrig12_comp]

/-- Unsigned fixed-point Givens leaf evaluator returning `(loList, widthList)` at offset `zOff2`. -/
def givensCompactGo {α : Type} : ℕ → List ℕ → ℕ → ℕ → List ℕ → List ℕ →
    (List ℕ → List ℕ → α) → α
  | 0, _, _, _, accL, accW, k =>
    forceList accL.reverse fun ls ↦ forceList accW.reverse fun ws ↦ k ls ws
  | 1, _, pL, pH, accL, accW, k =>
    strictNat (Nat.add zOff2 pL) fun lastL ↦
    strictNat (Nat.sub pH pL) fun lastW ↦
    forceList (lastL :: accL).reverse fun ls ↦
    forceList (lastW :: accW).reverse fun ws ↦ k ls ws
  | n + 2, [], pL, pH, accL, accW, k =>
    stepGivens 0 pL pH fun oL oW npL npH ↦
      givensCompactGo (n + 1) [] npL npH (oL :: accL) (oW :: accW) k
  | n + 2, idx :: ks, pL, pH, accL, accW, k =>
    if Nat.ble idx 8192 then
      stepGivens idx pL pH fun oL oW npL npH ↦
        givensCompactGo (n + 1) ks npL npH (oL :: accL) (oW :: accW) k
    else
      forceList (accL.reverse ++ List.replicate (n + 2) bScale) fun ls ↦
      forceList (accW.reverse ++ List.replicate (n + 2) zOff2) fun ws ↦ k ls ws

/-- Exact real recursion matching `givensCompactGo` on `15`-bit rotation grids. -/
noncomputable def givensRealGo : ℕ → List ℕ → ℝ → List ℝ
  | 0, _, _ => []
  | 1, _, pref => [pref]
  | n + 2, [], pref =>
    (pref * Real.cos 0) :: givensRealGo (n + 1) [] (pref * Real.sin 0)
  | n + 2, idx :: ks, pref =>
    (pref * Real.cos (π * (idx : ℝ) / 8192)) ::
      givensRealGo (n + 1) ks (pref * Real.sin (π * (idx : ℝ) / 8192))

lemma givensRealGo_length : ∀ (n : ℕ) (ks : List ℕ) (pref : ℝ),
    (givensRealGo n ks pref).length = n
  | 0, _, _ => rfl
  | 1, _, _ => rfl
  | n + 2, [], pref => by simp [givensRealGo, givensRealGo_length (n + 1)]
  | n + 2, _ :: ks, pref => by simp [givensRealGo, givensRealGo_length (n + 1)]

lemma givensRealGo_abs_le : ∀ (n : ℕ) (ks : List ℕ) {pref : ℝ}, |pref| ≤ 1 →
    ∀ x ∈ givensRealGo n ks pref, |x| ≤ 1
  | 0, _, _, _, _, hx => by simp [givensRealGo] at hx
  | 1, _, _, hp, x, hx => by simp only [givensRealGo, List.mem_singleton] at hx; subst hx; exact hp
  | n + 2, [], pref, hp, x, hx => by
    simp only [givensRealGo, List.mem_cons] at hx
    rcases hx with rfl | hx
    · rw [Real.cos_zero, mul_one]; exact hp
    · exact givensRealGo_abs_le (n + 1) []
        (by rw [Real.sin_zero, mul_zero, abs_zero]; norm_num) x hx
  | n + 2, idx :: ks, pref, hp, x, hx => by
    simp only [givensRealGo, List.mem_cons] at hx
    rcases hx with rfl | hx
    · rw [abs_mul]; nlinarith [abs_nonneg pref, Real.abs_cos_le_one (π * (idx : ℝ) / 8192)]
    · refine givensRealGo_abs_le (n + 1) ks ?_ x hx
      rw [abs_mul]; nlinarith [abs_nonneg pref, Real.abs_sin_le_one (π * (idx : ℝ) / 8192)]

lemma givensRealGo_getD : ∀ (n : ℕ) (ks : List ℕ) (pref : ℝ) (i : ℕ), i < n →
    (givensRealGo n ks pref).getD i 0 =
      pref * (∏ j ∈ Finset.range i, Real.sin (π * (ks.getD j 0 : ℝ) / 8192)) *
        (if i + 1 = n then 1 else Real.cos (π * (ks.getD i 0 : ℝ) / 8192))
  | 0, _, _, _, hi => by omega
  | 1, _, pref, i, hi => by
    obtain rfl : i = 0 := by omega
    change ([pref] : List ℝ).getD 0 0 = _
    simp
  | n + 2, [], pref, i, hi => by
    cases i with
    | zero => simp [givensRealGo]
    | succ j =>
      simp only [givensRealGo, List.getD_cons_succ, Finset.prod_range_succ', List.getD_nil,
        Nat.cast_zero, mul_zero, zero_div, Real.sin_zero]
      rw [givensRealGo_getD (n + 1) [] 0 j (by omega)]
      simp
  | n + 2, idx :: ks, pref, i, hi => by
    cases i with
    | zero => simp [givensRealGo]
    | succ j =>
      simp only [givensRealGo, List.getD_cons_succ]
      rw [givensRealGo_getD (n + 1) ks (pref * Real.sin (π * (idx : ℝ) / 8192)) j (by omega)]
      rw [Finset.prod_range_succ']
      simp only [List.getD_cons_zero, List.getD_cons_succ, Nat.add_right_cancel_iff]
      ring

lemma givensRealGo_eq_givensLeaf (row : List ℕ) (p : Fin 58) :
    (givensRealGo 58 row 1).getD p.val 0 =
      givensLeaf 15 (fun q : Fin 58 ↦ ((row.getD q.val 0 : ℕ) : ℤ)) p := by
  rw [givensRealGo_getD 58 row 1 p.val p.isLt, one_mul]
  unfold givensLeaf
  have hang (k : ℕ) : (2 * (2 * π * (((k : ℕ) : ℤ) : ℝ) / 2 ^ 15)) = π * (k : ℝ) / 8192 := by
    push_cast; ring
  simp_rw [hang]
  congr 1
  symm
  refine Finset.prod_bij (fun (q : Fin 58) _ ↦ q.val)
    (fun q hq ↦ by simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fin.lt_def] at hq
                   exact Finset.mem_range.mpr hq)
    (fun q₁ _ q₂ _ h ↦ Fin.ext h)
    (fun j hj ↦ ⟨⟨j, (Finset.mem_range.mp hj).trans p.isLt⟩,
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, Fin.lt_def.mpr (Finset.mem_range.mp hj)⟩, rfl⟩)
    (fun _ _ ↦ rfl)

private lemma givensCompactGo_valid_aux : ∀ (n : ℕ) (ks : List ℕ) (pL pH : ℕ) (accL accW : List ℕ)
    (accR : List ℝ) (pref : ℝ),
    ValidZ2List accL.reverse accW.reverse accR.reverse →
    0 ≤ pref → pref ≤ 1 → pH ≤ bScale →
    (pL : ℝ) ≤ pref * (bScale : ℝ) → pref * (bScale : ℝ) ≤ (pH : ℝ) →
    ∀ (P : List ℕ → List ℕ → Prop),
      (∀ ls ws, ValidZ2List ls ws (accR.reverse ++ givensRealGo n ks pref) → P ls ws) →
      givensCompactGo n ks pL pH accL accW P
  | 0, ks, pL, pH, accL, accW, accR, pref, hacc, _, _, _, _, _, P, hk => by
    simp only [givensCompactGo, forceList_eq]
    exact hk _ _ (by simpa [givensRealGo] using hacc)
  | 1, ks, pL, pH, accL, accW, accR, pref, hacc, hp0, hp1, hpH, hpLR, hRpH, P, hk => by
    simp only [givensCompactGo, strictNat_eq, forceList_eq, List.reverse_cons]
    have hpLH : pL ≤ pH := Nat.cast_le.mp (hpLR.trans hRpH)
    have hlast : ValidZ2 (Nat.add zOff2 pL) (Nat.sub pH pL) pref := by
      simpa using pos_prod_validZ2 (c := 1) (by linarith) (by linarith) hpLH hpH
        (by linarith) (by linarith)
    exact hk _ _ (hacc.append (.cons hlast .nil))
  | n + 2, [], pL, pH, accL, accW, accR, pref, hacc, hp0, hp1, hpH, hpLR, hRpH, P, hk => by
    unfold givensCompactGo
    refine stepGivens_sound (Nat.zero_le _) hp0 hp1 hpH hpLR hRpH _
      fun oL oW npL npH ho hps0 hps1 hnpH hnpLR hnpHR ↦ ?_
    have hz : π * ((0 : ℕ) : ℝ) / 8192 = 0 := by norm_num
    rw [hz] at ho hps0 hps1 hnpLR hnpHR
    have hacc' : ValidZ2List (oL :: accL).reverse (oW :: accW).reverse
        ((pref * Real.cos 0) :: accR).reverse := by
      simp only [List.reverse_cons]
      exact hacc.append (.cons ho .nil)
    refine givensCompactGo_valid_aux (n + 1) [] npL npH (oL :: accL) (oW :: accW)
      ((pref * Real.cos 0) :: accR) (pref * Real.sin 0) hacc' hps0 hps1 hnpH hnpLR hnpHR P ?_
    intro ls ws hvalid
    exact hk ls ws (by simpa [givensRealGo, List.append_assoc] using hvalid)
  | n + 2, idx :: ks, pL, pH, accL, accW, accR, pref, hacc, hp0, hp1, hpH, hpLR, hRpH, P, hk => by
    unfold givensCompactGo
    split_ifs with hble
    · refine stepGivens_sound (Nat.le_of_ble_eq_true hble) hp0 hp1 hpH hpLR hRpH _
        fun oL oW npL npH ho hps0 hps1 hnpH hnpLR hnpHR ↦ ?_
      have hacc' : ValidZ2List (oL :: accL).reverse (oW :: accW).reverse
          ((pref * Real.cos (π * (idx : ℝ) / 8192)) :: accR).reverse := by
        simp only [List.reverse_cons]
        exact hacc.append (.cons ho .nil)
      refine givensCompactGo_valid_aux (n + 1) ks npL npH (oL :: accL) (oW :: accW)
        ((pref * Real.cos (π * (idx : ℝ) / 8192)) :: accR)
        (pref * Real.sin (π * (idx : ℝ) / 8192)) hacc' hps0 hps1 hnpH hnpLR hnpHR P ?_
      intro ls ws hvalid
      exact hk ls ws (by simpa [givensRealGo, List.append_assoc] using hvalid)
    · simp only [forceList_eq]
      have habs : |pref| ≤ 1 := abs_le.mpr ⟨by linarith, hp1⟩
      have hrep := validZ2List_replicate (givensRealGo (n + 2) (idx :: ks) pref)
        (givensRealGo_abs_le (n + 2) (idx :: ks) habs)
      rw [givensRealGo_length] at hrep
      exact hk _ _ (hacc.append hrep)

/-- Soundness of `givensCompactGo` starting from `pref = 1` on `58` orbitals. -/
lemma givensCompactGo_valid (row : List ℕ) (P : List ℕ → List ℕ → Prop)
    (hk : ∀ ls ws, ValidZ2List ls ws (givensRealGo 58 row 1) → P ls ws) :
    givensCompactGo 58 row bScale bScale [] [] P :=
  givensCompactGo_valid_aux 58 row bScale bScale [] [] [] 1 .nil zero_le_one le_rfl le_rfl
    (by simp) (by simp) P (by simpa using hk)

lemma givensCompactGo_comp {α β : Type} (f : α → β) :
    ∀ (n : ℕ) (ks : List ℕ) (pL pH : ℕ) (accL accW : List ℕ) (k : List ℕ → List ℕ → α),
      givensCompactGo n ks pL pH accL accW (fun ls ws ↦ f (k ls ws)) =
        f (givensCompactGo n ks pL pH accL accW k)
  | 0, _, _, _, _, _, _ => by simp [givensCompactGo, forceList_eq]
  | 1, _, _, _, _, _, _ => by simp [givensCompactGo, strictNat_eq, forceList_eq]
  | n + 2, [], pL, pH, accL, accW, k => by
    unfold givensCompactGo
    simp_rw [givensCompactGo_comp f (n + 1)]
    exact stepGivens_comp f 0 pL pH _
  | n + 2, idx :: ks, pL, pH, accL, accW, k => by
    unfold givensCompactGo
    split_ifs
    · simp_rw [givensCompactGo_comp f (n + 1)]
      exact stepGivens_comp f idx pL pH _
    · simp [forceList_eq]

/-- Raw natural-number dot product of two lists. -/
def dotRaw : List ℕ → List ℕ → ℕ
  | [], _ => 0
  | _, [] => 0
  | x :: xs, y :: ys => Nat.add (Nat.mul x y) (dotRaw xs ys)

lemma dotRaw_nil_left (ys : List ℕ) : dotRaw [] ys = 0 := rfl
lemma dotRaw_nil_right (xs : List ℕ) : dotRaw xs [] = 0 := by cases xs <;> rfl
lemma dotRaw_cons (x : ℕ) (xs : List ℕ) (y : ℕ) (ys : List ℕ) :
    dotRaw (x :: xs) (y :: ys) = Nat.add (Nat.mul x y) (dotRaw xs ys) := rfl
attribute [irreducible] dotRaw

/-- Raw natural-number list sum. -/
def sumList : List ℕ → ℕ
  | [] => 0
  | x :: xs => Nat.add x (sumList xs)

lemma sumList_nil : sumList [] = 0 := rfl
lemma sumList_cons (x : ℕ) (xs : List ℕ) : sumList (x :: xs) = Nat.add x (sumList xs) := rfl
attribute [irreducible] sumList

/-- Exact real dot product of two lists. -/
def realDot : List ℝ → List ℝ → ℝ
  | [], _ => 0
  | _, [] => 0
  | x :: xs, y :: ys => x * y + realDot xs ys

lemma realDot_comm : ∀ (xs ys : List ℝ), realDot xs ys = realDot ys xs
  | [], _ => by cases ‹List ℝ› <;> rfl
  | _ :: _, [] => rfl
  | x :: xs, y :: ys => by simp [realDot, mul_comm, realDot_comm xs ys]

lemma dot_err_bound {u wu : List ℕ} {uR : List ℝ} (hu : ValidZ2List u wu uR) :
    ∀ {v wv : List ℕ} {vR : List ℝ}, ValidZ2List v wv vR → uR.length = vR.length →
      |realDot uR vR| ≤ (uR.length : ℝ) ∧
      |realDot uR vR * (bScale : ℝ) ^ 2 -
        ((dotRaw u v : ℝ) + 4 * (uR.length : ℝ) * (bScale : ℝ) ^ 2 -
          (zOff2 : ℝ) * ((sumList u : ℝ) + (sumList v : ℝ)))| ≤
        (bScale : ℝ) * ((sumList wu : ℝ) + (sumList wv : ℝ)) := by
  induction hu with
  | nil =>
    intro v wv vR hv hlen
    cases hv with
    | nil => simp [dotRaw_nil_left, sumList_nil, realDot]
    | cons _ _ => simp at hlen
  | @cons l1 w1 x1 ls1 ws1 xs1 hd1 tl1 ih =>
    intro v wv vR hv hlen
    cases hv with
    | nil => simp at hlen
    | @cons l2 w2 x2 ls2 ws2 xs2 hd2 tl2 =>
      simp only [List.length_cons, Nat.add_right_cancel_iff] at hlen
      obtain ⟨ih_abs, ih_err⟩ := ih tl2 hlen
      obtain ⟨hl1a, hl1b, hx1, hx1lo, hx1hi⟩ := hd1
      obtain ⟨_, _, hx2, hx2lo, hx2hi⟩ := hd2
      have hxy : |x1 * x2| ≤ 1 := by
        rw [abs_mul]; nlinarith [abs_nonneg x1, abs_nonneg x2, hx1]
      refine ⟨?_, ?_⟩
      · simp only [realDot, List.length_cons, Nat.cast_add, Nat.cast_one]
        linarith [abs_add_le (x1 * x2) (realDot xs1 xs2)]
      · set a1 : ℝ := (l1 : ℝ) - (zOff2 : ℝ)
        set a2 : ℝ := (l2 : ℝ) - (zOff2 : ℝ)
        set X1 : ℝ := x1 * (bScale : ℝ)
        set X2 : ℝ := x2 * (bScale : ℝ)
        have ha1 : |a1| ≤ (bScale : ℝ) := by
          have h1 : (bScale : ℝ) ≤ (l1 : ℝ) := Nat.cast_le.mpr hl1a
          have h2 : (l1 : ℝ) ≤ 3 * (bScale : ℝ) := by exact_mod_cast hl1b
          rw [abs_le]
          constructor <;> (simp only [a1, zOff2, bScale, Nat.cast_ofNat] at h1 h2 ⊢; linarith)
        have hX2 : |X2| ≤ (bScale : ℝ) := by
          obtain ⟨hx2a, hx2b⟩ := abs_le.mp hx2
          rw [abs_le]
          constructor <;> (simp only [X2, bScale, Nat.cast_ofNat]; linarith)
        have hdX1 : |X1 - a1| ≤ (w1 : ℝ) := by rw [abs_le]; constructor <;> linarith
        have hdX2 : |X2 - a2| ≤ (w2 : ℝ) := by rw [abs_le]; constructor <;> linarith
        have hhead : |X1 * X2 - a1 * a2| ≤ (bScale : ℝ) * ((w1 : ℝ) + (w2 : ℝ)) := by
          have hid : X1 * X2 - a1 * a2 = (X1 - a1) * X2 + a1 * (X2 - a2) := by ring
          rw [hid]
          have hA : |(X1 - a1) * X2| ≤ (w1 : ℝ) * (bScale : ℝ) := by
            rw [abs_mul]; exact mul_le_mul hdX1 hX2 (abs_nonneg _) (by positivity)
          have hB : |a1 * (X2 - a2)| ≤ (bScale : ℝ) * (w2 : ℝ) := by
            rw [abs_mul]; exact mul_le_mul ha1 hdX2 (abs_nonneg _) (by positivity)
          linarith [abs_add_le ((X1 - a1) * X2) (a1 * (X2 - a2))]
        rw [dotRaw_cons, sumList_cons, sumList_cons, sumList_cons, sumList_cons]
        simp only [realDot, Nat.add_eq, Nat.mul_eq, List.length_cons]
        push_cast
        have hsplit : (x1 * x2 + realDot xs1 xs2) * (bScale : ℝ) ^ 2 -
            ((l1 : ℝ) * l2 + dotRaw ls1 ls2 + 4 * ((xs1.length : ℝ) + 1) * (bScale : ℝ) ^ 2 -
              (zOff2 : ℝ) * ((l1 : ℝ) + sumList ls1 + ((l2 : ℝ) + sumList ls2))) =
            (X1 * X2 - a1 * a2) +
            (realDot xs1 xs2 * (bScale : ℝ) ^ 2 -
              ((dotRaw ls1 ls2 : ℝ) + 4 * (xs1.length : ℝ) * (bScale : ℝ) ^ 2 -
                (zOff2 : ℝ) * ((sumList ls1 : ℝ) + (sumList ls2 : ℝ)))) := by
          simp only [X1, X2, a1, a2, zOff2, bScale]; push_cast; ring
        rw [hsplit]
        linarith [abs_add_le (X1 * X2 - a1 * a2)
          (realDot xs1 xs2 * (bScale : ℝ) ^ 2 -
            ((dotRaw ls1 ls2 : ℝ) + 4 * (xs1.length : ℝ) * (bScale : ℝ) ^ 2 -
              (zOff2 : ℝ) * ((sumList ls1 : ℝ) + (sumList ls2 : ℝ))))]

/-- Offset-`64 * bScale` interval validity for bounded inner products `|x| ≤ 64`. -/
def ValidZ64 (lo w : ℕ) (x : ℝ) : Prop :=
  lo + w ≤ zOff128 ∧ |x| ≤ 64 ∧
    (lo : ℝ) - (zOff64 : ℝ) ≤ x * (bScale : ℝ) ∧
    x * (bScale : ℝ) ≤ (lo : ℝ) + (w : ℝ) - (zOff64 : ℝ)

lemma validZ64_fallback {x : ℝ} (hx : |x| ≤ 64) : ValidZ64 0 zOff128 x := by
  obtain ⟨hx1, hx2⟩ := abs_le.mp hx
  refine ⟨by decide, hx, ?_, ?_⟩ <;> norm_num [zOff128, zOff64, bScale] <;> nlinarith

/-- Unsigned fixed-point dot-product interval evaluator on orbital slices of length `≤ 64`. -/
def sliceDotCompact {α : Type} (len : ℕ) (u v : List ℕ) (su sv wu wv : ℕ)
    (k : ℕ → ℕ → α) : α :=
  let rawPos := Nat.add (dotRaw u v) (Nat.mul (Nat.add 64 (Nat.mul 4 len)) bScale2)
  let rawNeg := Nat.mul zOff2 (Nat.add su sv)
  let rad := Nat.mul bScale (Nat.add wu wv)
  if Nat.ble rawNeg rawPos then
    let center := Nat.sub rawPos rawNeg
    if Nat.ble rad center then
      strictNat (Nat.div (Nat.sub center rad) bScale) fun lo64 ↦
      let hi64 := Nat.div (Nat.add (Nat.add center rad) (Nat.sub bScale 1)) bScale
      if Nat.ble lo64 hi64 && Nat.ble hi64 zOff128 then
        strictNat (Nat.sub hi64 lo64) fun w64 ↦ k lo64 w64
      else k 0 zOff128
    else k 0 zOff128
  else k 0 zOff128

lemma sliceDotCompact_sound {len : ℕ} {u wuL v wvL : List ℕ} {uR vR : List ℝ} {su sv wu wv : ℕ}
    (hu : ValidZ2List u wuL uR) (hv : ValidZ2List v wvL vR)
    (hu_len : uR.length = len) (hv_len : vR.length = len) (hlen : len ≤ 64)
    (hsu : su = sumList u) (hsv : sv = sumList v)
    (hwu : wu = sumList wuL) (hwv : wv = sumList wvL)
    (P : ℕ → ℕ → Prop) (hk : ∀ lo w, ValidZ64 lo w (realDot uR vR) → P lo w) :
    sliceDotCompact len u v su sv wu wv P := by
  subst hsu hsv hwu hwv
  obtain ⟨habs, herr⟩ := dot_err_bound hu hv (hu_len.trans hv_len.symm)
  rw [hu_len] at habs herr
  have habs64 : |realDot uR vR| ≤ 64 := habs.trans (by exact_mod_cast hlen)
  unfold sliceDotCompact
  simp only [strictNat_eq]
  split_ifs with h1 h2 h3
  · obtain ⟨h3a, h3b⟩ := Bool.and_eq_true_iff.mp h3
    have hle1 : Nat.mul zOff2 (Nat.add (sumList u) (sumList v)) ≤
        Nat.add (dotRaw u v) (Nat.mul (Nat.add 64 (Nat.mul 4 len)) bScale2) :=
      Nat.le_of_ble_eq_true h1
    set center := Nat.sub (Nat.add (dotRaw u v) (Nat.mul (Nat.add 64 (Nat.mul 4 len)) bScale2))
      (Nat.mul zOff2 (Nat.add (sumList u) (sumList v)))
    set rad := Nat.mul bScale (Nat.add (sumList wuL) (sumList wvL))
    have hle2 : rad ≤ center := Nat.le_of_ble_eq_true h2
    set lo64 := Nat.div (Nat.sub center rad) bScale
    set hi64 := Nat.div (Nat.add (Nat.add center rad) (Nat.sub bScale 1)) bScale
    have hlo_hi : lo64 ≤ hi64 := Nat.le_of_ble_eq_true h3a
    have hhi_128 : hi64 ≤ zOff128 := Nat.le_of_ble_eq_true h3b
    have hB : 0 < bScale := by decide
    have hBR : (0 : ℝ) < (bScale : ℝ) := by norm_num [bScale]
    have hcenter_R : (center : ℝ) =
        (dotRaw u v : ℝ) + 4 * (len : ℝ) * (bScale : ℝ) ^ 2 -
          (zOff2 : ℝ) * ((sumList u : ℝ) + (sumList v : ℝ)) + 64 * (bScale : ℝ) ^ 2 := by
      change ((_ - _ : ℕ) : ℝ) = _
      rw [Nat.cast_sub hle1]
      simp only [Nat.add_eq, Nat.mul_eq, bScale2, bScale, zOff2]; push_cast; ring
    have hrad_R : (rad : ℝ) = (bScale : ℝ) * ((sumList wuL : ℝ) + (sumList wvL : ℝ)) := by
      simp only [rad, Nat.add_eq, Nat.mul_eq]; push_cast; ring
    obtain ⟨herr_lo, herr_hi⟩ := abs_le.mp herr
    refine hk _ _ ⟨by change lo64 + (hi64 - lo64) ≤ zOff128; omega, habs64, ?_, ?_⟩
    · have hf : (lo64 : ℝ) * (bScale : ℝ) ≤ ((Nat.sub center rad : ℕ) : ℝ) :=
        nat_div_le_real_sbtg (n := Nat.sub center rad) (d := bScale)
      have hsub_R : ((Nat.sub center rad : ℕ) : ℝ) = (center : ℝ) - (rad : ℝ) := by
        change ((center - rad : ℕ) : ℝ) = _; rw [Nat.cast_sub hle2]
      have hmul : (lo64 : ℝ) * (bScale : ℝ) ≤
          (realDot uR vR * (bScale : ℝ) + (zOff64 : ℝ)) * (bScale : ℝ) := by
        rw [hsub_R, hcenter_R, hrad_R] at hf
        simp only [zOff64, bScale, Nat.cast_ofNat] at herr_lo hf ⊢
        norm_num at herr_lo hf ⊢; linarith
      linarith [le_of_mul_le_mul_right hmul hBR]
    · have hc : ((Nat.add center rad : ℕ) : ℝ) ≤ (hi64 : ℝ) * (bScale : ℝ) :=
        real_le_nat_cdiv_sbtg (n := Nat.add center rad) hB
      have hadd_R : ((Nat.add center rad : ℕ) : ℝ) = (center : ℝ) + (rad : ℝ) := by
        simp [Nat.add_eq]
      have hmul : (realDot uR vR * (bScale : ℝ) + (zOff64 : ℝ)) * (bScale : ℝ) ≤
          (hi64 : ℝ) * (bScale : ℝ) := by
        rw [hadd_R, hcenter_R, hrad_R] at hc
        simp only [zOff64, bScale, Nat.cast_ofNat] at herr_hi hc ⊢
        norm_num at herr_hi hc ⊢; linarith
      have hhiR : realDot uR vR * (bScale : ℝ) ≤ (hi64 : ℝ) - (zOff64 : ℝ) := by
        linarith [le_of_mul_le_mul_right hmul hBR]
      change _ ≤ (lo64 : ℝ) + ((hi64 - lo64 : ℕ) : ℝ) - (zOff64 : ℝ)
      rw [Nat.cast_sub hlo_hi]; linarith
  · exact hk _ _ (validZ64_fallback habs64)
  · exact hk _ _ (validZ64_fallback habs64)
  · exact hk _ _ (validZ64_fallback habs64)

/-- Unsigned fixed-point addition of two offset-`64 * bScale` intervals bounded by `64`. -/
def combineSum2 {α : Type} (aL aW bL bW : ℕ) (k : ℕ → ℕ → α) : α :=
  let raw := Nat.add aL bL
  let w := Nat.add aW bW
  if Nat.ble zOff64 raw then
    strictNat (Nat.sub raw zOff64) fun sL ↦
    if Nat.ble (Nat.add sL w) zOff128 then
      strictNat w fun sW ↦ k sL sW
    else k 0 zOff128
  else k 0 zOff128

lemma combineSum2_sound {aL aW bL bW : ℕ} {x1 x2 : ℝ}
    (h1 : ValidZ64 aL aW x1) (h2 : ValidZ64 bL bW x2)
    (hb : |x1 + x2| ≤ 64) (P : ℕ → ℕ → Prop)
    (hk : ∀ sL sW, ValidZ64 sL sW (x1 + x2) → P sL sW) :
    combineSum2 aL aW bL bW P := by
  rcases h1 with ⟨_, _, h1lo, h1hi⟩
  rcases h2 with ⟨_, _, h2lo, h2hi⟩
  unfold combineSum2
  simp only [strictNat_eq]
  split_ifs with hble1 hble2
  · have hle1 : zOff64 ≤ aL + bL := Nat.le_of_ble_eq_true hble1
    have hle2 : aL + bL - zOff64 + (aW + bW) ≤ zOff128 := Nat.le_of_ble_eq_true hble2
    refine hk _ _ ⟨hle2, hb, ?_, ?_⟩
    · change ((aL + bL - zOff64 : ℕ) : ℝ) - (zOff64 : ℝ) ≤ _
      rw [Nat.cast_sub hle1]; push_cast
      norm_num [zOff64, bScale] at h1lo h2lo ⊢; linarith
    · change _ ≤ ((aL + bL - zOff64 : ℕ) : ℝ) + ((aW + bW : ℕ) : ℝ) - (zOff64 : ℝ)
      rw [Nat.cast_sub hle1]; push_cast
      norm_num [zOff64, bScale] at h1hi h2hi ⊢; linarith
  · exact hk _ _ (validZ64_fallback hb)
  · exact hk _ _ (validZ64_fallback hb)

lemma mul_z64_err {l1 w1 l2 w2 : ℕ} {x y : ℝ}
    (hx : ValidZ64 l1 w1 x) (hy : ValidZ64 l2 w2 y) :
    |(x * y + 4096) * (bScale : ℝ) ^ 2 -
      (((l1 : ℝ) * l2 + 8192 * (bScale : ℝ) ^ 2) - (zOff64 : ℝ) * ((l1 : ℝ) + l2))| ≤
      64 * (bScale : ℝ) * ((w1 : ℝ) + w2) := by
  rcases hx with ⟨hx128, _, hxlo, hxhi⟩
  rcases hy with ⟨_, hy64, hylo, hyhi⟩
  set A1 : ℝ := (l1 : ℝ) - (zOff64 : ℝ)
  set A2 : ℝ := (l2 : ℝ) - (zOff64 : ℝ)
  set X : ℝ := x * (bScale : ℝ)
  set Y : ℝ := y * (bScale : ℝ)
  have hA1 : |A1| ≤ 64 * (bScale : ℝ) := by
    have hle : (l1 : ℝ) + (w1 : ℝ) ≤ (zOff128 : ℝ) := by exact_mod_cast hx128
    have hw : (0 : ℝ) ≤ (w1 : ℝ) := by positivity
    have hl : (0 : ℝ) ≤ (l1 : ℝ) := by positivity
    rw [abs_le]
    constructor <;> (simp only [A1, zOff64, zOff128, bScale, Nat.cast_ofNat] at hle ⊢; linarith)
  have hY : |Y| ≤ 64 * (bScale : ℝ) := by
    obtain ⟨hy1, hy2⟩ := abs_le.mp hy64
    rw [abs_le]
    constructor <;> (simp only [Y, bScale, Nat.cast_ofNat]; linarith)
  have hdX : |X - A1| ≤ (w1 : ℝ) := by rw [abs_le]; constructor <;> linarith
  have hdY : |Y - A2| ≤ (w2 : ℝ) := by rw [abs_le]; constructor <;> linarith
  have hid : (x * y + 4096) * (bScale : ℝ) ^ 2 -
      (((l1 : ℝ) * l2 + 8192 * (bScale : ℝ) ^ 2) - (zOff64 : ℝ) * ((l1 : ℝ) + l2)) =
      (X - A1) * Y + A1 * (Y - A2) := by
    simp only [X, Y, A1, A2, zOff64, bScale]; push_cast; ring
  rw [hid]
  have h1 : |(X - A1) * Y| ≤ (w1 : ℝ) * (64 * (bScale : ℝ)) := by
    rw [abs_mul]; exact mul_le_mul hdX hY (abs_nonneg _) (by positivity)
  have h2 : |A1 * (Y - A2)| ≤ (64 * (bScale : ℝ)) * (w2 : ℝ) := by
    rw [abs_mul]; exact mul_le_mul hA1 hdY (abs_nonneg _) (by positivity)
  linarith [abs_add_le ((X - A1) * Y) (A1 * (Y - A2))]

/-- Unsigned upper-bound accumulator for `(wPos - wNeg) * X` with `X ∈ [valLo - z, valHi - z]`. -/
def accUpperBound {α : Type} (wPos wNeg valLo valHi valZero posA negA : ℕ)
    (k : ℕ → ℕ → α) : α :=
  strictNat wPos fun wP ↦
  strictNat wNeg fun wN ↦
  if Nat.ble wN wP then
    let wMag := Nat.sub wP wN
    strictNat valHi fun vH ↦
    if Nat.ble valZero vH then
      strictNat (Nat.add posA (Nat.mul wMag (Nat.sub vH valZero))) fun p' ↦ k p' negA
    else
      strictNat (Nat.add negA (Nat.mul wMag (Nat.sub valZero vH))) fun n' ↦ k posA n'
  else
    let wMag := Nat.sub wN wP
    strictNat valLo fun vL ↦
    if Nat.ble valZero vL then
      strictNat (Nat.add negA (Nat.mul wMag (Nat.sub vL valZero))) fun n' ↦ k posA n'
    else
      strictNat (Nat.add posA (Nat.mul wMag (Nat.sub valZero vL))) fun p' ↦ k p' negA

lemma accUpperBound_le {wPos wNeg valLo valHi valZero posA negA : ℕ} {X : ℝ}
    (hlo : (valLo : ℝ) - (valZero : ℝ) ≤ X) (hhi : X ≤ (valHi : ℝ) - (valZero : ℝ))
    (P : ℕ → ℕ → Prop)
    (hk : ∀ p' n' : ℕ,
      (posA : ℝ) - (negA : ℝ) + ((wPos : ℝ) - (wNeg : ℝ)) * X ≤ (p' : ℝ) - (n' : ℝ) → P p' n') :
    accUpperBound wPos wNeg valLo valHi valZero posA negA P := by
  unfold accUpperBound
  simp only [strictNat_eq]
  split_ifs with hw hv1 hv2
  · have hw' : wNeg ≤ wPos := Nat.le_of_ble_eq_true hw
    have hv' : valZero ≤ valHi := Nat.le_of_ble_eq_true hv1
    refine hk _ _ ?_
    change _ ≤ ((posA + (wPos - wNeg) * (valHi - valZero) : ℕ) : ℝ) - (negA : ℝ)
    rw [Nat.cast_add, Nat.cast_mul, Nat.cast_sub hw', Nat.cast_sub hv']
    have hw_nn : (0 : ℝ) ≤ (wPos : ℝ) - (wNeg : ℝ) := sub_nonneg.mpr (Nat.cast_le.mpr hw')
    nlinarith
  · have hw' : wNeg ≤ wPos := Nat.le_of_ble_eq_true hw
    have hv' : valHi ≤ valZero := by
      have : ¬(valZero ≤ valHi) := fun h ↦ hv1 (Nat.ble_eq_true_of_le h); omega
    refine hk _ _ ?_
    change _ ≤ (posA : ℝ) - ((negA + (wPos - wNeg) * (valZero - valHi) : ℕ) : ℝ)
    rw [Nat.cast_add, Nat.cast_mul, Nat.cast_sub hw', Nat.cast_sub hv']
    have hw_nn : (0 : ℝ) ≤ (wPos : ℝ) - (wNeg : ℝ) := sub_nonneg.mpr (Nat.cast_le.mpr hw')
    nlinarith
  · have hw' : wPos ≤ wNeg := by
      have : ¬(wNeg ≤ wPos) := fun h ↦ hw (Nat.ble_eq_true_of_le h); omega
    have hv' : valZero ≤ valLo := Nat.le_of_ble_eq_true hv2
    refine hk _ _ ?_
    change _ ≤ (posA : ℝ) - ((negA + (wNeg - wPos) * (valLo - valZero) : ℕ) : ℝ)
    rw [Nat.cast_add, Nat.cast_mul, Nat.cast_sub hw', Nat.cast_sub hv']
    have hw_np : (wPos : ℝ) - (wNeg : ℝ) ≤ 0 := sub_nonpos.mpr (Nat.cast_le.mpr hw')
    nlinarith
  · have hw' : wPos ≤ wNeg := by
      have : ¬(wNeg ≤ wPos) := fun h ↦ hw (Nat.ble_eq_true_of_le h); omega
    have hv' : valLo ≤ valZero := by
      have : ¬(valZero ≤ valLo) := fun h ↦ hv2 (Nat.ble_eq_true_of_le h); omega
    refine hk _ _ ?_
    change _ ≤ ((posA + (wNeg - wPos) * (valZero - valLo) : ℕ) : ℝ) - (negA : ℝ)
    rw [Nat.cast_add, Nat.cast_mul, Nat.cast_sub hw', Nat.cast_sub hv']
    have hw_np : (wPos : ℝ) - (wNeg : ℝ) ≤ 0 := sub_nonpos.mpr (Nat.cast_le.mpr hw')
    nlinarith

lemma sliceDotCompact_comp {α β : Type} (f : α → β) (len : ℕ) (u v : List ℕ) (su sv wu wv : ℕ)
    (k : ℕ → ℕ → α) :
    sliceDotCompact len u v su sv wu wv (fun a b ↦ f (k a b)) =
      f (sliceDotCompact len u v su sv wu wv k) := by
  unfold sliceDotCompact; simp only [strictNat_eq]
  split_ifs <;> rfl

lemma combineSum2_comp {α β : Type} (f : α → β) (aL aW bL bW : ℕ) (k : ℕ → ℕ → α) :
    combineSum2 aL aW bL bW (fun a b ↦ f (k a b)) = f (combineSum2 aL aW bL bW k) := by
  unfold combineSum2; simp only [strictNat_eq]
  split_ifs <;> rfl

lemma accUpperBound_comp {α β : Type} (f : α → β) (wPos wNeg valLo valHi valZero posA negA : ℕ)
    (k : ℕ → ℕ → α) :
    accUpperBound wPos wNeg valLo valHi valZero posA negA (fun a b ↦ f (k a b)) =
      f (accUpperBound wPos wNeg valLo valHi valZero posA negA k) := by
  unfold accUpperBound; simp only [strictNat_eq]
  split_ifs <;> rfl

lemma ite_comp {α β : Type} (f : α → β) (P : Prop) [Decidable P] (t e : α) :
    (if P then f t else f e) = f (if P then t else e) := by
  split_ifs <;> rfl

/-! ## Part 5: Sextet Occupation and List/Range Helpers -/

/-- Computational-basis Sextet `(34 α, 29 β)` determinant occupation
(`occ_0 = [0..33]`, `occ_1 = [0..28]`). -/
def sextetOcc (w : Fin (2 * 58)) : Bool :=
  if w.val % 2 = 0 then decide (w.val / 2 < 34) else decide (w.val / 2 < 29)

lemma list_drop_getD {α : Type*} : ∀ (k : ℕ) (xs : List α) (i : ℕ) (d : α),
    (xs.drop k).getD i d = xs.getD (k + i) d
  | 0, xs, i, d => by simp
  | k + 1, [], i, d => by simp
  | k + 1, _ :: xs, i, d => by
    simp only [List.drop_succ_cons, list_drop_getD k xs i d]
    have : k + 1 + i = (k + i) + 1 := by omega
    rw [this]; rfl

lemma list_take_getD {α : Type*} : ∀ (k : ℕ) (xs : List α) (i : ℕ) (_ : i < k) (d : α),
    (xs.take k).getD i d = xs.getD i d
  | 0, _, _, hi, _ => by omega
  | _ + 1, [], _, _, _ => by simp
  | _ + 1, _ :: _, 0, _, _ => rfl
  | k + 1, _ :: xs, i + 1, hi, d => list_take_getD k xs i (by omega) d

lemma list_headD_eq_getD {α : Type*} (xs : List α) (d : α) :
    xs.headD d = xs.getD 0 d := by
  cases xs <;> rfl

lemma list_tail_getD {α : Type*} (xs : List α) (i : ℕ) (d : α) :
    xs.tail.getD i d = xs.getD (i + 1) d := by
  cases xs <;> simp

lemma realDot_eq_sum_range : ∀ (n : ℕ) {xs ys : List ℝ},
    xs.length = n → ys.length = n →
    realDot xs ys = ∑ i ∈ Finset.range n, xs.getD i 0 * ys.getD i 0
  | 0, xs, _, hx, _ => by cases xs <;> simp at hx ⊢; rfl
  | n + 1, xs, ys, hx, hy => by
    cases xs with
    | nil => simp at hx
    | cons x xs' =>
      cases ys with
      | nil => simp at hy
      | cons y ys' =>
        simp only [List.length_cons, Nat.add_right_cancel_iff] at hx hy
        rw [realDot, realDot_eq_sum_range n hx hy, Finset.sum_range_succ']
        simp [add_comm]

/-- Exact `15`-bit Givens leaf orbital vector reconstructed from a quantized angle row. -/
noncomputable def rowLeafFn (row : List ℕ) : Fin 58 → ℝ :=
  givensLeaf 15 (fun q : Fin 58 ↦ ((row.getD q.val 0 : ℕ) : ℤ))

lemma fromOffset_cast_real (x : ℕ) : (fromOffset x : ℝ) = (x : ℝ) - 16384 := by
  unfold fromOffset; push_cast; norm_num

/-- Extracts `n` entries from a row with default `16384`. -/
def getRow29Go : ℕ → List ℕ → List ℕ
  | 0, _ => []
  | rem + 1, xs => xs.headD 16384 :: getRow29Go rem xs.tail

lemma getRow29Go_zero (xs : List ℕ) : getRow29Go 0 xs = [] := rfl
lemma getRow29Go_succ (rem : ℕ) (xs : List ℕ) :
    getRow29Go (rem + 1) xs = xs.headD 16384 :: getRow29Go rem xs.tail := rfl
attribute [irreducible] getRow29Go

/-- Extracts `n` doubled fragment weights `2 * fw[c]` with default `0`. -/
def getFw2Go : ℕ → List ℕ → List ℕ
  | 0, _ => []
  | rem + 1, xs => Nat.mul 2 (xs.headD 0) :: getFw2Go rem xs.tail

lemma getFw2Go_zero (xs : List ℕ) : getFw2Go 0 xs = [] := rfl
lemma getFw2Go_succ (rem : ℕ) (xs : List ℕ) :
    getFw2Go (rem + 1) xs = Nat.mul 2 (xs.headD 0) :: getFw2Go rem xs.tail := rfl
attribute [irreducible] getFw2Go

/-- Extracts column `b` across `n` inner-weight rows with default `16384`. -/
def getColGo (b : ℕ) : ℕ → List (List ℕ) → List ℕ
  | 0, _ => []
  | rem + 1, rows => (rows.headD []).getD b 16384 :: getColGo b rem rows.tail

lemma getColGo_zero (b : ℕ) (rows : List (List ℕ)) : getColGo b 0 rows = [] := rfl
lemma getColGo_succ (b rem : ℕ) (rows : List (List ℕ)) :
    getColGo b (rem + 1) rows = (rows.headD []).getD b 16384 :: getColGo b rem rows.tail := rfl
attribute [irreducible] getColGo

lemma getRow29Go_eq : ∀ (n : ℕ) (xs : List ℕ),
    getRow29Go n xs = (List.range n).map (xs.getD · 16384)
  | 0, _ => by simp [getRow29Go_zero]
  | n + 1, xs => by
    rw [getRow29Go_succ]
    simp only [list_headD_eq_getD, getRow29Go_eq n xs.tail,
      List.range_succ_eq_map, List.map_cons, List.map_map]
    refine congrArg (_ :: ·) (List.map_congr_left fun i _ ↦ ?_)
    dsimp; rw [list_tail_getD]

lemma getFw2Go_eq : ∀ (n : ℕ) (xs : List ℕ),
    getFw2Go n xs = (List.range n).map (fun c ↦ 2 * xs.getD c 0)
  | 0, _ => by simp [getFw2Go_zero]
  | n + 1, xs => by
    rw [getFw2Go_succ]
    simp only [Nat.mul_eq, list_headD_eq_getD, getFw2Go_eq n xs.tail,
      List.range_succ_eq_map, List.map_cons, List.map_map]
    refine congrArg (_ :: ·) (List.map_congr_left fun i _ ↦ ?_)
    dsimp; rw [list_tail_getD]

lemma getColGo_eq (b : ℕ) : ∀ (n : ℕ) (rows : List (List ℕ)),
    getColGo b n rows = (List.range n).map (fun c ↦ (rows.getD c []).getD b 16384)
  | 0, _ => by simp [getColGo_zero]
  | n + 1, rows => by
    rw [getColGo_succ]
    simp only [list_headD_eq_getD, getColGo_eq b n rows.tail,
      List.range_succ_eq_map, List.map_cons, List.map_map]
    refine congrArg (_ :: ·) (List.map_congr_left fun i _ ↦ ?_)
    dsimp; rw [list_tail_getD]

lemma sumList_map_range : ∀ (n : ℕ) (f : ℕ → ℕ),
    sumList ((List.range n).map f) = ∑ i ∈ Finset.range n, f i
  | 0, _ => by simp [sumList_nil]
  | n + 1, f => by
    rw [List.range_succ_eq_map, List.map_cons, List.map_map, sumList_cons, Nat.add_eq,
      sumList_map_range n, Finset.sum_range_succ']
    simp [add_comm]

lemma dotRaw_map_range : ∀ (n : ℕ) (f g : ℕ → ℕ),
    dotRaw ((List.range n).map f) ((List.range n).map g) = ∑ i ∈ Finset.range n, f i * g i
  | 0, _, _ => by simp [dotRaw_nil_left]
  | n + 1, f, g => by
    rw [List.range_succ_eq_map, List.map_cons, List.map_cons, List.map_map, List.map_map,
      dotRaw_cons, Nat.add_eq, Nat.mul_eq, dotRaw_map_range n, Finset.sum_range_succ']
    simp [add_comm]

lemma zipWith_mul_map_range : ∀ (n : ℕ) (f g : ℕ → ℕ),
    List.zipWith Nat.mul ((List.range n).map f) ((List.range n).map g) =
      (List.range n).map (fun i ↦ f i * g i)
  | 0, _, _ => rfl
  | n + 1, f, g => by
    simp only [List.range_succ_eq_map, List.map_cons, List.map_map, List.zipWith_cons_cons,
      Nat.mul_eq]
    congr 1
    exact zipWith_mul_map_range n (fun i ↦ f (i + 1)) (fun i ↦ g (i + 1))

lemma zipWith_add_map_range : ∀ (n : ℕ) (f g : ℕ → ℕ),
    List.zipWith Nat.add ((List.range n).map f) ((List.range n).map g) =
      (List.range n).map (fun i ↦ f i + g i)
  | 0, _, _ => rfl
  | n + 1, f, g => by
    simp only [List.range_succ_eq_map, List.map_cons, List.map_map, List.zipWith_cons_cons,
      Nat.add_eq]
    congr 1
    exact zipWith_add_map_range n (fun i ↦ f (i + 1)) (fun i ↦ g (i + 1))

