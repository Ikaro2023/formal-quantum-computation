private lemma qOcc_spin0_bool (q : Fin 58) :
    qOcc (spinOrbital 58 q 0) = decide (q.val < 33) := by
  unfold qOcc spinOrbital
  dsimp
  have h1 : (2 * q.val) % 2 = 0 := by omega
  have h2 : (2 * q.val) / 2 = q.val := by omega
  simp [h1, h2]

private lemma qOcc_spin1_bool (q : Fin 58) :
    qOcc (spinOrbital 58 q 1) = decide (q.val < 30) := by
  unfold qOcc spinOrbital
  dsimp
  have h1 : (2 * q.val + 1) % 2 = 1 := by omega
  have h2 : (2 * q.val + 1) / 2 = q.val := by omega
  simp [h1, h2]

private lemma occ_virt_uFn_33_30 (u1 u2 : Fin 58 → ℝ) :
    let uR := List.ofFn u1
    let vR := List.ofFn u2
    occDot qOcc 0 u1 u2 = realDot (uR.take 33) (vR.take 33) ∧
    virtDot qOcc 0 u1 u2 = realDot (uR.drop 33) (vR.drop 33) ∧
    occDot qOcc 1 u1 u2 = realDot (uR.take 30) (vR.take 30) ∧
    virtDot qOcc 1 u1 u2 = realDot (uR.drop 30) (vR.drop 30) := by
  intro uR vR
  have hu : uR.length = 58 := List.length_ofFn
  have hv : vR.length = 58 := List.length_ofFn
  have hf1 : (fun q : Fin 58 ↦ uR.getD q.val 0) = u1 := funext (ofFn_getD_fin u1)
  have hf2 : (fun q : Fin 58 ↦ vR.getD q.val 0) = u2 := funext (ofFn_getD_fin u2)
  rw [← hf1, ← hf2]
  have ho0 : realDot (uR.take 33) (vR.take 33) =
      ∑ i ∈ Finset.range 33, uR.getD i 0 * vR.getD i 0 := by
    rw [realDot_eq_sum_range 33 (by simp [hu]) (by simp [hv])]
    refine Finset.sum_congr rfl fun i hi ↦ ?_
    rw [list_take_getD 33 uR i (Finset.mem_range.mp hi),
      list_take_getD 33 vR i (Finset.mem_range.mp hi)]
  have hv0 : realDot (uR.drop 33) (vR.drop 33) =
      ∑ i ∈ Finset.range 25, uR.getD (33 + i) 0 * vR.getD (33 + i) 0 := by
    rw [realDot_eq_sum_range 25 (by simp [hu]) (by simp [hv])]
    refine Finset.sum_congr rfl fun i _ ↦ by simp
  have ho1 : realDot (uR.take 30) (vR.take 30) =
      ∑ i ∈ Finset.range 30, uR.getD i 0 * vR.getD i 0 := by
    rw [realDot_eq_sum_range 30 (by simp [hu]) (by simp [hv])]
    refine Finset.sum_congr rfl fun i hi ↦ ?_
    rw [list_take_getD 30 uR i (Finset.mem_range.mp hi),
      list_take_getD 30 vR i (Finset.mem_range.mp hi)]
  have hv1 : realDot (uR.drop 30) (vR.drop 30) =
      ∑ i ∈ Finset.range 28, uR.getD (30 + i) 0 * vR.getD (30 + i) 0 := by
    rw [realDot_eq_sum_range 28 (by simp [hu]) (by simp [hv])]
    refine Finset.sum_congr rfl fun i _ ↦ by simp
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold occDot; simp_rw [qOcc_spin0_bool]
    rw [Fin.sum_univ_eq_sum_range
        (fun x ↦ if decide (x < 33) = true then uR.getD x 0 * vR.getD x 0 else 0),
      show (58 : ℕ) = 33 + 25 from rfl, Finset.sum_range_add, ho0]
    have h1 : (∑ x ∈ Finset.range 33,
        if decide (x < 33) = true then uR.getD x 0 * vR.getD x 0 else 0) =
        ∑ x ∈ Finset.range 33, uR.getD x 0 * vR.getD x 0 :=
      Finset.sum_congr rfl fun x hx ↦ by simp [Finset.mem_range.mp hx]
    have h2 : (∑ x ∈ Finset.range 25,
        if decide (33 + x < 33) = true then uR.getD (33 + x) 0 * vR.getD (33 + x) 0 else 0) = 0 :=
      Finset.sum_eq_zero fun x _ ↦ by simp
    rw [h1, h2, add_zero]
  · unfold virtDot; simp_rw [qOcc_spin0_bool]
    rw [Fin.sum_univ_eq_sum_range
        (fun x ↦ if (!decide (x < 33)) = true then uR.getD x 0 * vR.getD x 0 else 0),
      show (58 : ℕ) = 33 + 25 from rfl, Finset.sum_range_add, hv0]
    have h1 : (∑ x ∈ Finset.range 33,
        if (!decide (x < 33)) = true then uR.getD x 0 * vR.getD x 0 else 0) = 0 :=
      Finset.sum_eq_zero fun x hx ↦ by simp [Finset.mem_range.mp hx]
    have h2 : (∑ x ∈ Finset.range 25, if (!decide (33 + x < 33)) = true then
        uR.getD (33 + x) 0 * vR.getD (33 + x) 0 else 0) =
        ∑ x ∈ Finset.range 25, uR.getD (33 + x) 0 * vR.getD (33 + x) 0 :=
      Finset.sum_congr rfl fun x _ ↦ by simp
    rw [h1, h2, zero_add]
  · unfold occDot; simp_rw [qOcc_spin1_bool]
    rw [Fin.sum_univ_eq_sum_range
        (fun x ↦ if decide (x < 30) = true then uR.getD x 0 * vR.getD x 0 else 0),
      show (58 : ℕ) = 30 + 28 from rfl, Finset.sum_range_add, ho1]
    have h1 : (∑ x ∈ Finset.range 30,
        if decide (x < 30) = true then uR.getD x 0 * vR.getD x 0 else 0) =
        ∑ x ∈ Finset.range 30, uR.getD x 0 * vR.getD x 0 :=
      Finset.sum_congr rfl fun x hx ↦ by simp [Finset.mem_range.mp hx]
    have h2 : (∑ x ∈ Finset.range 28,
        if decide (30 + x < 30) = true then uR.getD (30 + x) 0 * vR.getD (30 + x) 0 else 0) = 0 :=
      Finset.sum_eq_zero fun x _ ↦ by simp
    rw [h1, h2, add_zero]
  · unfold virtDot; simp_rw [qOcc_spin1_bool]
    rw [Fin.sum_univ_eq_sum_range
        (fun x ↦ if (!decide (x < 30)) = true then uR.getD x 0 * vR.getD x 0 else 0),
      show (58 : ℕ) = 30 + 28 from rfl, Finset.sum_range_add, hv1]
    have h1 : (∑ x ∈ Finset.range 30,
        if (!decide (x < 30)) = true then uR.getD x 0 * vR.getD x 0 else 0) = 0 :=
      Finset.sum_eq_zero fun x hx ↦ by simp [Finset.mem_range.mp hx]
    have h2 : (∑ x ∈ Finset.range 28, if (!decide (30 + x < 30)) = true then
        uR.getD (30 + x) 0 * vR.getD (30 + x) 0 else 0) =
        ∑ x ∈ Finset.range 28, uR.getD (30 + x) 0 * vR.getD (30 + x) 0 :=
      Finset.sum_congr rfl fun x _ ↦ by simp
    rw [h1, h2, zero_add]

private lemma dot_orb5e7_err :
    ∀ {u v : List ℕ} {uR vR : List ℝ},
      List.Forall₂ ValidOrb5e7 u uR → List.Forall₂ ValidOrb5e7 v vR →
      uR.length = vR.length →
      |realDot uR vR * (cScale : ℝ) ^ 2 -
        ((dotRaw u v : ℝ) + (uR.length : ℝ) * (cOff : ℝ) ^ 2 -
          (cOff : ℝ) * ((sumList u : ℝ) + (sumList v : ℝ)))| ≤
        (uR.length : ℝ) * (err1 : ℝ)
  | _, _, _, _, .nil, hv, hlen => by
    cases hv with
    | nil =>
      rw [dotRaw_nil_left, sumList_nil]
      simp [realDot]
    | cons _ _ => simp at hlen
  | _, _, _, _, @List.Forall₂.cons _ _ _ up x us xsR hu_hd hu_tl, hv, hlen => by
    cases hv with
    | nil => simp at hlen
    | @cons vq y vs ysR hv_hd hv_tl =>
      simp only [List.length_cons, Nat.add_right_cancel_iff] at hlen
      have ih := dot_orb5e7_err hu_tl hv_tl hlen
      have hhd := orb5e7_prod_err hu_hd hv_hd
      rw [dotRaw_cons, sumList_cons, sumList_cons]
      simp only [realDot, Nat.add_eq, Nat.mul_eq, List.length_cons]
      push_cast
      have hsplit :
          (x * y + realDot xsR ysR) * (cScale : ℝ) ^ 2 -
            ((up : ℝ) * vq + dotRaw us vs + ((xsR.length : ℝ) + 1) * (cOff : ℝ) ^ 2 -
              (cOff : ℝ) * ((up : ℝ) + sumList us + ((vq : ℝ) + sumList vs))) =
          ((x * (cScale : ℝ)) * (y * (cScale : ℝ)) -
            ((up : ℝ) - (cOff : ℝ)) * ((vq : ℝ) - (cOff : ℝ))) +
          (realDot xsR ysR * (cScale : ℝ) ^ 2 -
            ((dotRaw us vs : ℝ) + (xsR.length : ℝ) * (cOff : ℝ) ^ 2 -
              (cOff : ℝ) * ((sumList us : ℝ) + (sumList vs : ℝ)))) := by ring
      rw [hsplit]
      linarith [abs_add_le
        ((x * (cScale : ℝ)) * (y * (cScale : ℝ)) -
          ((up : ℝ) - (cOff : ℝ)) * ((vq : ℝ) - (cOff : ℝ)))
        (realDot xsR ysR * (cScale : ℝ) ^ 2 -
          ((dotRaw us vs : ℝ) + (xsR.length : ℝ) * (cOff : ℝ) ^ 2 -
            (cOff : ℝ) * ((sumList us : ℝ) + (sumList vs : ℝ))))]

private lemma sliceDotPre_sound {n : ℕ} {u v : List ℕ} {uR vR : List ℝ} {su sv : ℕ}
    (hu : List.Forall₂ ValidOrb5e7 u uR) (hv : List.Forall₂ ValidOrb5e7 v vR)
    (hlu : uR.length = n) (hlv : vR.length = n)
    (hsu : su = sumList u) (hsv : sv = sumList v)
    (P : Bool → ℕ → ℕ → Prop)
    (hk : ∀ (ok : Bool) (lo w : ℕ),
      (ok = true →
        (lo : ℝ) - (dOff : ℝ) ≤ realDot uR vR * 10000000 ∧
        realDot uR vR * 10000000 ≤ (lo : ℝ) + (w : ℝ) - (dOff : ℝ)) →
      P ok lo w) :
    sliceDotPre n u v su sv P := by
  unfold sliceDotPre
  simp only [strictNat_eq]
  split_ifs with hble
  · have hreq_le := Nat.le_of_ble_eq_true hble
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, nat_div_def] at hreq_le ⊢
    set raw := dotRaw u v
    set pos := raw + n * (cOff * cOff) + dOff * 250000000
    set neg := cOff * (su + sv)
    set rad := n * err1
    set req := neg + rad
    have hneg_le : neg ≤ pos + rad := by omega
    set lo := (pos - req) / 250000000
    set hi := (pos + rad - neg + 249999999) / 250000000
    have hlo_hi : lo ≤ hi :=
      Nat.div_le_div_right (by omega : pos - req ≤ pos + rad - neg + 249999999)
    obtain ⟨herr_lo, herr_hi⟩ := abs_le.mp (dot_orb5e7_err hu hv (hlu.trans hlv.symm))
    rw [hlu, ← hsu, ← hsv] at herr_lo herr_hi
    have hc2 : (cScale : ℝ) ^ 2 = 10000000 * 250000000 := by norm_num [cScale]
    refine hk true lo (hi - lo) fun _ ↦ ⟨?_, ?_⟩
    · have hf := nat_div_le_real (n := pos - req) (d := 250000000)
      have hsub : ((pos - req : ℕ) : ℝ) = (pos : ℝ) - (req : ℝ) := Nat.cast_sub hreq_le
      simp only [pos, req, neg, rad, raw] at hsub
      push_cast at hsub
      rw [hc2] at herr_lo
      linarith
    · rw [Nat.cast_sub hlo_hi]
      have hc := real_le_nat_cdiv (n := pos + rad - neg) (d := 250000000) (k := 249999999)
        (by decide)
      have hsub : ((pos + rad - neg : ℕ) : ℝ) = (pos : ℝ) + (rad : ℝ) - (neg : ℝ) := by
        rw [Nat.cast_sub hneg_le, Nat.cast_add]
      simp only [pos, neg, rad, raw] at hsub
      push_cast at hsub
      rw [hc2] at herr_hi
      linarith
  · exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true

private lemma sliceDotPre_comp {α β : Type} (f : α → β) (n : ℕ) (u v : List ℕ) (su sv : ℕ)
    (k : Bool → ℕ → ℕ → α) :
    sliceDotPre n u v su sv (fun a b c ↦ f (k a b c)) = f (sliceDotPre n u v su sv k) := by
  unfold sliceDotPre; simp only [strictNat_eq]; split_ifs <;> rfl

private lemma dw_dot_orb5_err :
    ∀ (n : ℕ) {dwP dwN u v : List ℕ} {uR vR : List ℝ},
      List.Forall₂ ValidOrb5e7 u uR → List.Forall₂ ValidOrb5e7 v vR →
      uR.length = n → vR.length = n → dwP.length = n → dwN.length = n →
      let u5 := u.map (fun x ↦ Nat.div x 20)
      let v5 := v.map (fun x ↦ Nat.div x 20)
      let uDwP := List.zipWith Nat.mul dwP u5
      let uDwN := List.zipWith Nat.mul dwN u5
      let vDwP := List.zipWith Nat.mul dwP v5
      let vDwN := List.zipWith Nat.mul dwN v5
      let posR : ℝ := (dotRaw uDwP v5 : ℝ) +
        (cOff5 : ℝ) ^ 2 * (sumList dwP : ℝ) +
        (cOff5 : ℝ) * ((sumList uDwN : ℝ) + (sumList vDwN : ℝ))
      let negR : ℝ := (dotRaw uDwN v5 : ℝ) +
        (cOff5 : ℝ) ^ 2 * (sumList dwN : ℝ) +
        (cOff5 : ℝ) * ((sumList uDwP : ℝ) + (sumList vDwP : ℝ))
      |(∑ i ∈ Finset.range n,
          ((dwP.getD i 0 : ℝ) - (dwN.getD i 0 : ℝ)) * (uR.getD i 0 * vR.getD i 0)) *
        (2500000 : ℝ) ^ 2 - (posR - negR)| ≤
        (err5 : ℝ) * ((sumList dwP : ℝ) + (sumList dwN : ℝ))
  | 0, dwP, dwN, u, v, uR, vR, hu, hv, hlu, hlv, hlp, hln => by
    cases uR <;> simp at hlu
    cases vR <;> simp at hlv
    cases dwP <;> simp at hlp
    cases dwN <;> simp at hln
    cases hu
    cases hv
    simp [dotRaw_nil_left, sumList_nil]
  | n + 1, dwP, dwN, u, v, uR, vR, hu, hv, hlu, hlv, hlp, hln => by
    cases hu with
    | nil => simp at hlu
    | @cons up x us xsR hu_hd hu_tl =>
      cases hv with
      | nil => simp at hlv
      | @cons vq y vs ysR hv_hd hv_tl =>
        cases dwP with
        | nil => simp at hlp
        | cons wP dwPs =>
          cases dwN with
          | nil => simp at hln
          | cons wN dwNs =>
            simp only [List.length_cons, Nat.add_right_cancel_iff] at hlu hlv hlp hln
            have ih := dw_dot_orb5_err n hu_tl hv_tl hlu hlv hlp hln
            have hhd := orb5_prod_err hu_hd hv_hd
            have hw_abs : |(wP : ℝ) - (wN : ℝ)| ≤ (wP : ℝ) + (wN : ℝ) := by
              have hp0 : (0 : ℝ) ≤ (wP : ℝ) := Nat.cast_nonneg wP
              have hn0 : (0 : ℝ) ≤ (wN : ℝ) := Nat.cast_nonneg wN
              exact abs_le.mpr ⟨by linarith, by linarith⟩
            have hprod_hd :
                |((wP : ℝ) - (wN : ℝ)) * ((x * 2500000) * (y * 2500000) -
                  (((up / 20 : ℕ) : ℝ) - (cOff5 : ℝ)) *
                    (((vq / 20 : ℕ) : ℝ) - (cOff5 : ℝ)))| ≤
                (err5 : ℝ) * ((wP : ℝ) + (wN : ℝ)) := by
              rw [abs_mul, mul_comm (err5 : ℝ)]
              exact mul_le_mul hw_abs hhd (abs_nonneg _) (by positivity)
            dsimp only at ih ⊢
            rw [Finset.sum_range_succ']
            simp only [List.map_cons, List.zipWith_cons_cons, dotRaw_cons, sumList_cons,
              List.getD_cons_zero, List.getD_cons_succ, nat_div_def, Nat.add_eq, Nat.mul_eq]
            push_cast
            set T_tail : ℝ :=
              (∑ i ∈ Finset.range n,
                ((dwPs.getD i 0 : ℝ) - (dwNs.getD i 0 : ℝ)) * (xsR.getD i 0 * ysR.getD i 0)) *
                2500000 ^ 2 -
              (((dotRaw (List.zipWith Nat.mul dwPs (List.map (fun x ↦ x / 20) us))
                    (List.map (fun x ↦ x / 20) vs) : ℝ) +
                  (cOff5 : ℝ) ^ 2 * (sumList dwPs : ℝ) +
                  (cOff5 : ℝ) *
                    ((sumList (List.zipWith Nat.mul dwNs (List.map (fun x ↦ x / 20) us)) : ℝ) +
                      (sumList (List.zipWith Nat.mul dwNs (List.map (fun x ↦ x / 20) vs)) : ℝ))) -
                ((dotRaw (List.zipWith Nat.mul dwNs (List.map (fun x ↦ x / 20) us))
                    (List.map (fun x ↦ x / 20) vs) : ℝ) +
                  (cOff5 : ℝ) ^ 2 * (sumList dwNs : ℝ) +
                  (cOff5 : ℝ) *
                    ((sumList (List.zipWith Nat.mul dwPs (List.map (fun x ↦ x / 20) us)) : ℝ) +
                      (sumList (List.zipWith Nat.mul dwPs (List.map (fun x ↦ x / 20) vs)) : ℝ))))
            set T_hd : ℝ :=
              ((wP : ℝ) - (wN : ℝ)) * ((x * 2500000) * (y * 2500000) -
                (((up / 20 : ℕ) : ℝ) - (cOff5 : ℝ)) * (((vq / 20 : ℕ) : ℝ) - (cOff5 : ℝ)))
            have hsplit :
                (∑ x_1 ∈ Finset.range n,
                    ((dwPs.getD x_1 0 : ℝ) - (dwNs.getD x_1 0 : ℝ)) *
                      (xsR.getD x_1 0 * ysR.getD x_1 0) +
                  ((wP : ℝ) - (wN : ℝ)) * (x * y)) * 2500000 ^ 2 -
                (((wP : ℝ) * ((up / 20 : ℕ) : ℝ) * ((vq / 20 : ℕ) : ℝ) +
                    (dotRaw (List.zipWith Nat.mul dwPs (List.map (fun x ↦ x / 20) us))
                      (List.map (fun x ↦ x / 20) vs) : ℝ) +
                    (cOff5 : ℝ) ^ 2 * ((wP : ℝ) + (sumList dwPs : ℝ)) +
                    (cOff5 : ℝ) * (((wN : ℝ) * ((up / 20 : ℕ) : ℝ) +
                      (sumList (List.zipWith Nat.mul dwNs
                        (List.map (fun x ↦ x / 20) us)) : ℝ)) +
                      ((wN : ℝ) * ((vq / 20 : ℕ) : ℝ) +
                        (sumList (List.zipWith Nat.mul dwNs
                          (List.map (fun x ↦ x / 20) vs)) : ℝ)))) -
                  ((wN : ℝ) * ((up / 20 : ℕ) : ℝ) * ((vq / 20 : ℕ) : ℝ) +
                    (dotRaw (List.zipWith Nat.mul dwNs (List.map (fun x ↦ x / 20) us))
                      (List.map (fun x ↦ x / 20) vs) : ℝ) +
                    (cOff5 : ℝ) ^ 2 * ((wN : ℝ) + (sumList dwNs : ℝ)) +
                    (cOff5 : ℝ) * (((wP : ℝ) * ((up / 20 : ℕ) : ℝ) +
                      (sumList (List.zipWith Nat.mul dwPs
                        (List.map (fun x ↦ x / 20) us)) : ℝ)) +
                      ((wP : ℝ) * ((vq / 20 : ℕ) : ℝ) +
                        (sumList (List.zipWith Nat.mul dwPs
                          (List.map (fun x ↦ x / 20) vs)) : ℝ))))) =
                T_hd + T_tail := by
              simp only [T_hd, T_tail]; ring
            rw [hsplit]
            have ih' : |T_tail| ≤ (err5 : ℝ) * ((sumList dwPs : ℝ) + (sumList dwNs : ℝ)) := by
              simpa [T_tail, nat_div_def] using ih
            linarith [abs_add_le T_hd T_tail]

private lemma dwIvPre_sound {n : ℕ} {dwP dwN u v uDwP uDwN v5 : List ℕ} {uR vR : List ℝ}
    {suP svP suN svN sP sN : ℕ}
    (hu : List.Forall₂ ValidOrb5e7 u uR) (hv : List.Forall₂ ValidOrb5e7 v vR)
    (hlu : uR.length = n) (hlv : vR.length = n)
    (hlp : dwP.length = n) (hln : dwN.length = n)
    (hv5 : v5 = v.map (fun x ↦ Nat.div x 20))
    (huDwP : uDwP = List.zipWith Nat.mul dwP (u.map (fun x ↦ Nat.div x 20)))
    (huDwN : uDwN = List.zipWith Nat.mul dwN (u.map (fun x ↦ Nat.div x 20)))
    (hsuP : suP = sumList uDwP)
    (hsvP : svP = sumList (List.zipWith Nat.mul dwP v5))
    (hsuN : suN = sumList uDwN)
    (hsvN : svN = sumList (List.zipWith Nat.mul dwN v5))
    (hsP : sP = sumList dwP) (hsN : sN = sumList dwN)
    (P : Bool → ℕ → ℕ → Prop)
    (hk : ∀ (ok : Bool) (lo w : ℕ),
      (ok = true →
        (lo : ℝ) - 5000000 ≤
          (∑ i ∈ Finset.range n,
            ((dwP.getD i 0 : ℝ) - (dwN.getD i 0 : ℝ)) * (uR.getD i 0 * vR.getD i 0)) * 100 ∧
        (∑ i ∈ Finset.range n,
            ((dwP.getD i 0 : ℝ) - (dwN.getD i 0 : ℝ)) * (uR.getD i 0 * vR.getD i 0)) * 100 ≤
          (lo : ℝ) + (w : ℝ) - 5000000) →
      P ok lo w) :
    dwIvPre uDwP uDwN v5 suP svP suN svN sP sN P := by
  unfold dwIvPre
  simp only [strictNat_eq]
  split_ifs with hble
  · have hreq_le := Nat.le_of_ble_eq_true hble
    simp only [Nat.add_eq, Nat.mul_eq, Nat.sub_eq, nat_div_def] at hreq_le ⊢
    set divBy := 62500000000
    set baseDW := 312500000000000000
    set pos := baseDW + dotRaw uDwP v5 + (cOff5 * cOff5 * sP + cOff5 * (suN + svN))
    set neg := dotRaw uDwN v5 + (cOff5 * cOff5 * sN + cOff5 * (suP + svP))
    set rad := err5 * (sP + sN)
    set req := neg + rad
    have hneg_le : neg ≤ pos + rad := by omega
    set lo := (pos - req) / divBy
    set hi := (pos + rad - neg + 62499999999) / divBy
    have hlo_hi : lo ≤ hi :=
      Nat.div_le_div_right (by omega : pos - req ≤ pos + rad - neg + 62499999999)
    obtain ⟨herr_lo, herr_hi⟩ := abs_le.mp (dw_dot_orb5_err n hu hv hlu hlv hlp hln)
    rw [← hv5, ← huDwP, ← huDwN, ← hsuP, ← hsvP, ← hsuN, ← hsvN, ← hsP, ← hsN] at herr_lo herr_hi
    set S : ℝ := ∑ i ∈ Finset.range n,
      ((dwP.getD i 0 : ℝ) - (dwN.getD i 0 : ℝ)) * (uR.getD i 0 * vR.getD i 0)
    have hscale : S * (2500000 : ℝ) ^ 2 = (S * 100) * (divBy : ℝ) := by
      simp only [divBy]; push_cast; ring
    have hbase : (baseDW : ℝ) = 5000000 * (divBy : ℝ) := by norm_num [baseDW, divBy]
    rw [hscale] at herr_lo herr_hi
    refine hk true lo (hi - lo) fun _ ↦ ⟨?_, ?_⟩
    · have hf := nat_div_le_real (n := pos - req) (d := divBy)
      have hsub : ((pos - req : ℕ) : ℝ) = (pos : ℝ) - (req : ℝ) := Nat.cast_sub hreq_le
      simp only [pos, req, neg, rad, sq] at hsub herr_lo
      push_cast at hsub
      rw [hbase] at hsub
      simp only [divBy, Nat.cast_ofNat] at hf hsub herr_lo ⊢
      linarith
    · rw [Nat.cast_sub hlo_hi]
      have hc := real_le_nat_cdiv (n := pos + rad - neg) (d := divBy) (k := 62499999999)
        (by decide)
      have hsub : ((pos + rad - neg : ℕ) : ℝ) = (pos : ℝ) + (rad : ℝ) - (neg : ℝ) := by
        rw [Nat.cast_sub hneg_le, Nat.cast_add]
      simp only [pos, neg, rad, sq] at hsub herr_hi
      push_cast at hsub
      rw [hbase] at hsub
      simp only [divBy, Nat.cast_ofNat] at hc hsub herr_hi ⊢
      linarith
  · exact hk false 0 0 fun h ↦ absurd h Bool.false_ne_true

