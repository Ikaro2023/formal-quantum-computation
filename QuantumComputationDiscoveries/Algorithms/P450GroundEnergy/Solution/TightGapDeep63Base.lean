private lemma buildDiagStats_aux :
    ∀ (ds : DetList)
      (hvalid : ∀ t ∈ detListToList ds, checkFlipsGo t.2.2 0 0 0 0 = true)
      (wireW : List ℕ) (_ : wireW.length = 116) (qTree : QuadAccTree)
      (P : Bool → List ℕ → List ℕ → List ℕ → List ℕ → List ℕ → QuadAccTree → Prop),
      (∀ ok wTot dw0P dw0N dw1P dw1N diagTree,
        (ok = true →
          ∃ wireWFinal : List ℕ,
            wireWFinal.length = 116 ∧
            (∀ j : ℕ, wireWFinal.getD j 0 ≤ deepNormSq) ∧
            (∀ j : ℕ, j < 116 → wireWFinal.getD j 0 = wireW.getD j 0 +
              ((detListToList ds).map fun t ↦ if j ∈ t.2.2 then t.2.1 ^ 2 else 0).sum) ∧
            wTot = (List.range 58).map (fun p ↦
              let w0 := wireWFinal.getD (2 * p) 0
              let w1 := wireWFinal.getD (2 * p + 1) 0
              (if p < 33 then deepNormSq - w0 else w0) +
                (if p < 30 then deepNormSq - w1 else w1)) ∧
            dw0P = (List.range 58).map (fun p ↦ if p < 33 then 0 else wireWFinal.getD (2 * p) 0) ∧
            dw0N = (List.range 58).map (fun p ↦ if p < 33 then wireWFinal.getD (2 * p) 0 else 0) ∧
            dw1P = (List.range 58).map (fun p ↦
              if p < 30 then 0 else wireWFinal.getD (2 * p + 1) 0) ∧
            dw1N = (List.range 58).map (fun p ↦
              if p < 30 then wireWFinal.getD (2 * p + 1) 0 else 0) ∧
            (∀ r c, evalQuadAccTree r c diagTree = evalQuadAccTree r c qTree +
              ((detListToList ds).attach.map fun t ↦
                let hlt := (checkFlipsGo_det_valid (hvalid t.1 t.2)).2.1
                ((t.1.2.1 ^ 2 : ℕ) : ℝ) *
                  (flipModeDelta r c t.1.2.2 hlt ^ 2 - exchFlipSqMode r c t.1.2.2 hlt)).sum)) →
        P ok wTot dw0P dw0N dw1P dw1N diagTree) →
      buildDiagStats ds wireW qTree P
  | .nil, _, wireW, hlen, qTree, _, hk => by
    unfold buildDiagStats
    by_cases hchk : checkWireWLe wireW = true
    · simp only [hchk, Bool.not_true, Bool.false_eq_true, ↓reduceIte, strictNatList_eq]
      refine hk true _ _ _ _ _ qTree fun _ ↦ ⟨wireW, hlen, checkWireWLe_sound hchk,
        fun j _ ↦ by simp [detListToList], ?_, ?_, ?_, ?_, ?_, fun _ _ ↦ by simp [detListToList]⟩
      · refine List.map_congr_left fun p _ ↦ ?_
        simp [Nat.blt_eq, Nat.mul_eq, Nat.add_eq, Nat.sub_eq]
      · refine List.map_congr_left fun p _ ↦ by simp [Nat.blt_eq, Nat.mul_eq]
      · refine List.map_congr_left fun p _ ↦ by simp [Nat.blt_eq, Nat.mul_eq]
      · refine List.map_congr_left fun p _ ↦ by simp [Nat.blt_eq, Nat.mul_eq, Nat.add_eq]
      · refine List.map_congr_left fun p _ ↦ by simp [Nat.blt_eq, Nat.mul_eq, Nat.add_eq]
    · simp only [Bool.not_eq_true] at hchk
      simp only [hchk, Bool.not_false, ↓reduceIte]
      exact hk false [] [] [] [] [] .empty fun h ↦ absurd h Bool.false_ne_true
  | .cons na wa fa rest, hvalid, wireW, hlen, qTree, P, hk => by
    unfold buildDiagStats
    have hfa : checkFlipsGo fa 0 0 0 0 = true := hvalid (na, wa, fa) List.mem_cons_self
    have hrest : ∀ t ∈ detListToList rest, checkFlipsGo t.2.2 0 0 0 0 = true :=
      fun t ht ↦ hvalid t (List.mem_cons_of_mem _ ht)
    obtain ⟨hnda, hlta, _, _⟩ := checkFlipsGo_det_valid hfa
    simp only [strictNat_eq, strictNatList_eq, Nat.mul_eq]
    have hlen' : (addFlipsW (wa * wa) fa wireW).length = 116 := by
      rw [addFlipsW_length, hlen]
    have hlta_w : ∀ w ∈ fa, w < wireW.length := by rw [hlen]; exact hlta
    refine diagQuadsOuter_sound (wa * wa) hlta qTree _ fun ok1 qt1 hqt1 ↦ ?_
    cases ok1 with
    | false => exact hk false [] [] [] [] [] .empty fun h ↦ absurd h Bool.false_ne_true
    | true =>
      simp only [↓reduceIte]
      refine buildDiagStats_aux rest hrest (addFlipsW (wa * wa) fa wireW) hlen' qt1 P
        fun ok2 wTot dw0P dw0N dw1P dw1N diagTree hih ↦
          hk ok2 wTot dw0P dw0N dw1P dw1N diagTree fun hok ↦ ?_
      obtain ⟨wFinal, hlenF, hleF, hgetF, hwTot, h0P, h0N, h1P, h1N, hqF⟩ := hih hok
      refine ⟨wFinal, hlenF, hleF, fun j hj ↦ ?_, hwTot, h0P, h0N, h1P, h1N, fun r c ↦ ?_⟩
      · rw [hgetF j hj, addFlipsW_getD (wa * wa) fa wireW hnda hlta_w j]
        simp only [detListToList, List.map_cons, List.sum_cons, sq]
        omega
      · rw [hqF r c, hqt1 rfl r c]
        simp only [detListToList, List.attach_cons, List.map_cons, List.sum_cons, List.map_map,
          Function.comp_def, sq, Nat.cast_mul]
        ring

lemma cps2_congr {γ₁ γ₂ β : Type} (m : (γ₁ → γ₂ → β) → β)
    {k₁ k₂ : γ₁ → γ₂ → β} (h : ∀ a b, k₁ a b = k₂ a b) : m k₁ = m k₂ :=
  congrArg m (funext fun a ↦ funext fun b ↦ h a b)

private lemma buildZeroQuadTreeCPS_comp {α β : Type} (f : α → β) :
    ∀ (fuel n : ℕ) (xs : List ℕ) (k : QuadAccTree → List ℕ → α),
      buildZeroQuadTreeCPS fuel n xs (fun a b ↦ f (k a b)) =
        f (buildZeroQuadTreeCPS fuel n xs k)
  | 0, _, _, _ => rfl
  | _ + 1, 0, _, _ => rfl
  | _ + 1, _ + 1, [], _ => rfl
  | fuel + 1, n + 1, qk :: rest, k => by
    rw [buildZeroQuadTreeCPS_succ_succ_cons, buildZeroQuadTreeCPS_succ_succ_cons]
    by_cases h1 : Nat.beq (n + 1) 1 = true
    · simp only [h1, ↓reduceIte, strictNat_eq]
    · simp only [h1, Bool.false_eq_true, ↓reduceIte, strictNat_eq]
      rw [← buildZeroQuadTreeCPS_comp f fuel]
      refine cps2_congr _ fun lT mid ↦ ?_
      cases mid with
      | nil => rfl
      | cons mKey rightXs =>
        rw [← buildZeroQuadTreeCPS_comp f fuel]

private lemma addQuadTreeCPS_comp {α β : Type} (f : α → β) (qk cP cN : ℕ) :
    ∀ (tree : QuadAccTree) (k : Bool → QuadAccTree → α),
      addQuadTreeCPS qk cP cN tree (fun a b ↦ f (k a b)) =
        f (addQuadTreeCPS qk cP cN tree k)
  | .empty, _ => rfl
  | .node l nk p m rt, k => by
    unfold addQuadTreeCPS
    split_ifs
    · simp [strictNat_eq]
    · rw [← addQuadTreeCPS_comp f qk cP cN l]
      refine cps2_congr _ fun ok l' ↦ ?_
      split_ifs <;> rfl
    · rw [← addQuadTreeCPS_comp f qk cP cN rt]
      refine cps2_congr _ fun ok r' ↦ ?_
      split_ifs <;> rfl

