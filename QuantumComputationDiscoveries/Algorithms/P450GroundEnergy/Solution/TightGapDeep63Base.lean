private lemma diagQuadsInner_comp {α β : Type} (f : α → β) (wa2 kp1 : ℕ) (s1Par ref1 : Bool) :
    ∀ (ws : List ℕ) (tree : QuadAccTree) (k : Bool → QuadAccTree → α),
      diagQuadsInner wa2 kp1 s1Par ref1 ws tree (fun a b ↦ f (k a b)) =
        f (diagQuadsInner wa2 kp1 s1Par ref1 ws tree k)
  | [], _, _ => rfl
  | w2 :: ws, tree, k => by
    unfold diagQuadsInner
    simp only [strictNat_eq, strictBool_eq]
    have h1 (t : QuadAccTree) (cont : Bool → QuadAccTree → α) :
        (if beqBool ref1 (sextetBitNat w2) then
          pushQuadTreeCPS kp1 (Nat.mul 65 (Nat.div w2 2)) wa2 0 t
        else pushQuadTreeCPS kp1 (Nat.mul 65 (Nat.div w2 2)) 0 wa2 t)
