      (star ψ ⬝ᵥ (thcHamiltonian rThc *ᵥ ψ)).re * (deepNormSq : ℝ) =
        coefficientUnit * cipsiObReal +
          (coefficientUnit / (15360 ^ 2 : ℝ)) *
            ∑ r : Fin 9, (cipsiBlockExchReal r + ∑ c : Fin 14, cipsiModeReal r c)
  let fImp : Bool → Prop := fun b ↦ b = true → goalProp
  have h1 := buildZeroQuadTreeCPS_sound 14 (listLenGo allQuadKeysCert 0) allQuadKeysCert
    (fun zeroTree _ ↦ fImp (
      buildDiagStats .nil wireWE7Cert zeroTree
        fun okD wTot dw0P dw0N dw1P dw1N _ ↦
