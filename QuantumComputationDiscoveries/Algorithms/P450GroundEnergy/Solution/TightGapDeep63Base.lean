        fun okD wTot dw0P dw0N dw1P dw1N _ hdiag hk2 ↦ by
          cases okD with
          | false => exact absurd hk2 Bool.false_ne_true
          | true =>
            simp -iota only
              [Bool.not_true, Bool.false_eq_true, ↓reduceIte] at hk2
            cases hmerge : addQuadSlicesOpt
                (List.append diagAllEighthCerts s12AllSliceCerts) zeroTree with
            | none => rw [hmerge] at hk2; exact absurd hk2 Bool.false_ne_true
            | some fullTree =>
              rw [hmerge] at hk2; dsimp -zeta only at hk2
              have h4 := flattenQuadTreeCPS_sound fullTree .nil
                (fun quads ↦ fImp (
                  beqNatList wTot wTotCert && beqNatList dw0P dw0PCert &&
                  beqNatList dw0N dw0NCert && beqNatList dw1P dw1PCert &&
