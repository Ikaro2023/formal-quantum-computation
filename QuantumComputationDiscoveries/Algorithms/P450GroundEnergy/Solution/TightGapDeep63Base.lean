      modesLoopGo diagGs activeGs wTot dTotP dTotN quads fwRow rem cIdx iwRows frP frN
        (fun a b c ↦ f (k a b c)) =
      f (modesLoopGo diagGs activeGs wTot dTotP dTotN quads fwRow rem cIdx iwRows frP frN k)
  | 0, _, _, _, _, _ => rfl
  | rem + 1, cIdx, iwRows, frP, frN, k => by
