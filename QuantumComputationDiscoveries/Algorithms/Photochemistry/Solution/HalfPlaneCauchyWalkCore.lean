    · intro i hi
      rw [hu79_1i hi, (hBasisAll i hi).1 u hu, Bool.xor_self]
  have hUncEq (w : ℕ) (aF : ℕ → Bool) (hUz : (evalPrimTree 95 c0 bf31Unc96Tree).testBit w = false)
      (ha0 : aF 0 = false) (haXor : ∀ a b, aF (a ^^^ b) = xor (aF a) (aF b))
      (hBas : ∀ i < 30, (evalPrimTree 95 (in96Val31 c0 (1 <<< i)) bf31Unc96Tree).testBit w =
