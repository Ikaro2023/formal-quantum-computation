theorem upd_idem {α : Sort*} [DecidableEq α] {β : α → Sort*} (f : ∀ a, β a) (k : α)
    (v₁ v₂ : β k) :
    Function.update (Function.update f k v₁) k v₂ = Function.update f k v₂ := by
  funext x
  by_cases h : x = k
  · rw [h, Function.update_self, Function.update_self]
  · rw [Function.update_of_ne h, Function.update_of_ne h, Function.update_of_ne h]

theorem upd_xK {K : ℕ} (u : Wire K) (γ : BitAssignment K) {v : ZMod 2}
    (hv : γ u + 1 = v) : (ComputeProg.x u).fwdBits γ = Function.update γ u v := by
  rw [← hv]
  rfl

theorem upd_cnotK {K : ℕ} {c t : Wire K} (hct : c ≠ t) (γ : BitAssignment K) {v : ZMod 2}
    (hv : γ t + γ c = v) :
    (safeCnotCP c t).fwdBits γ = Function.update γ t v := by
  dsimp only [safeCnotCP]
  rw [leg_dif_neg hct, ← hv]
  rfl

theorem upd_andK {K : ℕ} {c1 c2 a : Wire K} (h12 : c1 ≠ c2) (h1a : c1 ≠ a) (h2a : c2 ≠ a)
    (γ : BitAssignment K) {v : ZMod 2} (hv : γ a + γ c1 * γ c2 = v) :
    (safeAndGateCP c1 c2 a).fwdBits γ = Function.update γ a v := by
  rw [fwdBits_safeAnd h12 h1a h2a γ, hv]

theorem pSplitR2EquivK_fwdBits {K : ℕ} (ws : Fin 10 → Wire K) (hws : Function.Injective ws)
    (γ : BitAssignment K) (hH0 : γ (ws 3) = 0) (hH1 : γ (ws 4) = 0) :
    let out := (pSplitR2EquivK ws).fwdBits γ
    out (ws 1) = γ (ws 1) * (1 + γ (ws 0)) ∧ out (ws 2) = γ (ws 2) * (1 + γ (ws 0)) ∧ out (ws 3) =
        γ (ws 1) * γ (ws 0) ∧ out (ws 4) = γ (ws 2) * γ (ws 0) ∧
    (∀ u : Wire K, u ≠ ws 1 → u ≠ ws 2 → u ≠ ws 3 → u ≠ ws 4 → out u = γ u) := by
  let s1 := (safeAndGateCP (ws 1) (ws 0) (ws 3)).fwdBits γ
  have es1 : s1 = Function.update γ (ws 3) (γ (ws 1) * γ (ws 0)) :=
    upd_andK (hws.ne (by decide)) (hws.ne (by decide))
        (hws.ne (by decide)) γ (by rw [hH0, zero_add])
  let s2 := (safeAndGateCP (ws 2) (ws 0) (ws 4)).fwdBits s1
  have es2 : s2 = Function.update s1 (ws 4) (γ (ws 2) * γ (ws 0)) :=
      upd_andK (hws.ne (by decide)) (hws.ne (by decide)) (hws.ne (by decide)) s1
      (by rw [es1, Function.update_of_ne (hws.ne (by decide)),
            Function.update_of_ne (hws.ne (by decide)), Function.update_of_ne (hws.ne (by decide)),
            hH1, zero_add])
  let s3 := (safeCnotCP (ws 3) (ws 1)).fwdBits s2
  have es3 : s3 = Function.update s2 (ws 1) (γ (ws 1) * (1 + γ (ws 0))) :=
      upd_cnotK (hws.ne (by decide)) s2
      (by rw [es2, Function.update_of_ne (hws.ne (by decide)),
            Function.update_of_ne (hws.ne (by decide)),
              es1, Function.update_of_ne (hws.ne (by decide)), Function.update_self,
                  ← zero_add (γ (ws 1) * _), zmod2_x_add_xy])
  let s4 := (safeCnotCP (ws 4) (ws 2)).fwdBits s3
  have es4 : s4 = Function.update s3 (ws 2) (γ (ws 2) * (1 + γ (ws 0))) :=
      upd_cnotK (hws.ne (by decide)) s3
      (by rw [es3, Function.update_of_ne (hws.ne (by decide)),
            Function.update_of_ne (hws.ne (by decide)), es2,
            Function.update_of_ne (hws.ne (by decide)), Function.update_self,
              es1, Function.update_of_ne (hws.ne (by decide)), ← zero_add (γ (ws 2) * _),
                  zmod2_x_add_xy])
  have hs4 : (pSplitR2EquivK ws).fwdBits γ = s4 := rfl
  dsimp only
  rw [hs4]
  refine ⟨by rw [es4, Function.update_of_ne (hws.ne (by decide)), es3, Function.update_self],
          by rw [es4, Function.update_self],
          by rw [es4, Function.update_of_ne (hws.ne (by decide)), es3,
               Function.update_of_ne (hws.ne (by decide)), es2,
               Function.update_of_ne (hws.ne (by decide)), es1, Function.update_self],
          by rw [es4, Function.update_of_ne (hws.ne (by decide)), es3,
               Function.update_of_ne (hws.ne (by decide)), es2, Function.update_self],
          fun u n1 n2 n3 n4 ↦ by
            rw [es4, Function.update_of_ne n2, es3, Function.update_of_ne n1, es2,
                Function.update_of_ne n4, es1, Function.update_of_ne n3]⟩

theorem stSplitRFwd_eq_stepCB {K n : ℕ} (r : QRegister K n) (ws : Fin 10 → Wire K)
    (hws : Function.Injective ws) (β : BitAssignment n) (hH0 : β (r (ws 3)) = 0)
    (hH1 : β (r (ws 4)) = 0) : stSplitRFwd (r (ws 0)) (lW2Of r ws)
    (hW2Of r ws) β = stepCB r (pSplitR2EquivK ws).fwdBits β := by
  have hlInj : Function.Injective (lW2Of r ws) := fun b1 b2 e ↦ by
    fin_cases b1 <;> fin_cases b2 <;> dsimp [lW2Of] at e <;>
      first | rfl | exact absurd (hws (r.wires.injective e)) (by decide)
  have hhInj : Function.Injective (hW2Of r ws) := fun b1 b2 e ↦ by
    fin_cases b1 <;> fin_cases b2 <;> dsimp [hW2Of] at e <;>
      first | rfl | exact absurd (hws (r.wires.injective e)) (by decide)
  have hlhNe (b1 b2 : Fin 2) : lW2Of r ws b1 ≠ hW2Of r ws b2 := fun e ↦ by
    fin_cases b1 <;> fin_cases b2 <;> exact absurd (hws (r.wires.injective e)) (by decide)
  obtain ⟨oL0, oL1, oH0, oH1, oOth⟩ :=
    pSplitR2EquivK_fwdBits ws hws (fun v ↦ β (r v)) hH0 hH1
  funext x
  by_cases hx : ∃ u, r u = x
  · obtain ⟨u, rfl⟩ := hx
    rw [stepCB_apply_reg]
    rcases eq_or_ne u (ws 1) with rfl | hu1
    · exact (stSplitRFwd_lW hlInj β ⟨0, by decide⟩).trans oL0.symm
    rcases eq_or_ne u (ws 2) with rfl | hu2
    · exact (stSplitRFwd_lW hlInj β ⟨1, by decide⟩).trans oL1.symm
    rcases eq_or_ne u (ws 3) with rfl | hu3
    · exact (stSplitRFwd_hW hhInj hlhNe β ⟨0, by decide⟩).trans oH0.symm
    rcases eq_or_ne u (ws 4) with rfl | hu4
    · exact (stSplitRFwd_hW hhInj hlhNe β ⟨1, by decide⟩).trans oH1.symm
    have hlx (b : Fin 2) : r u ≠ lW2Of r ws b := fun e ↦ by
      fin_cases b <;>
        first | exact hu1 (r.wires.injective e) | exact hu2 (r.wires.injective e)
    have hhx (b : Fin 2) : r u ≠ hW2Of r ws b := fun e ↦ by
      fin_cases b <;>
        first | exact hu3 (r.wires.injective e) | exact hu4 (r.wires.injective e)
    rw [stSplitRFwd_other β hlx hhx, oOth u hu1 hu2 hu3 hu4]
  · exact (stSplitRFwd_other β (fun _ e ↦ hx ⟨_, e.symm⟩)
      (fun _ e ↦ hx ⟨_, e.symm⟩)).trans (stepCB_apply_of_not_mem _ _ _ _ hx).symm

theorem step_counts_wires_splitR2OnReg {Var : Type} [Fintype Var] [DecidableEq Var] {W K n : ℕ}
    [NeZero (2 ^ n)] (v : Var) (rWork : QRegister W n) (r : QRegister K n) (ws : Fin 10 → Wire K)
    (hws : Function.Injective ws) (e0 e1 : ZMod 2 → ZMod 2 → ZMod 2)
    (heMut : ∀ x y : ZMod 2, (e0 x y = 1 → e1 x y = 0) ∧ (e1 x y = 1 → e0 x y = 0))
    (stPre stPost : BitAssignment n → BitAssignment n) (phPre phPost : BitAssignment n → ZMod 2)
    (mid : DynamicCircuit Var n) (hCln : ∀ δ, (∀ q, δ (rWork q) = 0) → stPre δ (r (ws 3)) = 0 ∧
    stPre δ (r (ws 4)) = 0 ∧ stPre δ (r (ws 5)) = 0 ∧ stPre δ (r (ws 6)) = 0 ∧ stPre δ (r (ws 7)) =
    0) (heEq : ∀ δ, (∀ q, δ (rWork q) = 0) → stPre δ (r (ws 1)) = e0 (stPre δ (r (ws 8)))
    (stPre δ (r (ws 9))) ∧ stPre δ (r (ws 2)) = e1 (stPre δ (r (ws 8))) (stPre δ (r (ws 9))))
    (hAgree : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ u : Wire K, stPost δ (r u) = stPre δ (r u))
    (hMid : SubspaceStep (mkKetOpW rWork (fun δ ↦
    stepCB r (pSplitR2EquivK ws).fwdBits (stPre δ)) phPre)
    (mkKetOpW rWork (fun δ ↦ stepCB r (pSplitR2EquivK ws).fwdBits (stPost δ)) phPost) mid) :
    SubspaceStep (mkKetOpW rWork stPre phPre) (mkKetOpW rWork stPost phPost)
    (pSplitR2OnReg v r ws hws mid) ∧ (pSplitR2OnReg v r ws hws mid).count .T = 6 + mid.count .T ∧
    (pSplitR2OnReg v r ws hws mid).count .TOFF = mid.count .TOFF ∧ (∀ S : Wire n → Prop,
    (∀ u, S (r u)) → DynWires S mid → DynWires S (pSplitR2OnReg v r ws hws mid)) := by
  have heIndep : ∀ (b : Fin 2) (γ₁ γ₂ : BitAssignment n),
      (∀ x, (∀ j, x ≠ lW2Of r ws j) → (∀ j, x ≠ hW2Of r ws j) → x ≠ r (ws 5) → γ₁ x = γ₂ x) →
      eBranch2Gen r ws e0 e1 b γ₁ = eBranch2Gen r ws e0 e1 b γ₂ := fun b γ₁ γ₂ hxy ↦ by
    have h8 : γ₁ (r (ws 8)) = γ₂ (r (ws 8)) := hxy (r (ws 8))
      (fun j e ↦
          by fin_cases j <;> dsimp [lW2Of] at e <;> exact absurd (hws (r.wires.injective e))
               (by decide))
      (fun j e ↦
          by fin_cases j <;> dsimp [hW2Of] at e <;> exact absurd (hws (r.wires.injective e))
               (by decide))
      (fun e ↦ absurd (hws (r.wires.injective e)) (by decide))
    have h9 : γ₁ (r (ws 9)) = γ₂ (r (ws 9)) := hxy (r (ws 9))
      (fun j e ↦
          by fin_cases j <;> dsimp [lW2Of] at e <;> exact absurd (hws (r.wires.injective e))
               (by decide))
      (fun j e ↦
          by fin_cases j <;> dsimp [hW2Of] at e <;> exact absurd (hws (r.wires.injective e))
               (by decide))
      (fun e ↦ absurd (hws (r.wires.injective e)) (by decide))
    dsimp only [eBranch2Gen]; rw [h8, h9]
  have hMut : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ b₁ b₂ : Fin 2, b₁ ≠ b₂ → stPre δ (lW2Of r ws b₁) = 1 →
      stPre δ (lW2Of r ws b₂) = 0 := by
    intro δ hz b₁ b₂ hne hb1;
    obtain ⟨he0, he1⟩ := heEq δ hz; obtain ⟨hm01, hm10⟩ :=
        heMut (stPre δ (r (ws 8))) (stPre δ (r (ws 9)))
    fin_cases b₁ <;> fin_cases b₂
    · exact absurd rfl hne
    · dsimp [lW2Of] at hb1 ⊢; rw [he1]; exact hm01 (he0.symm.trans hb1)
    · dsimp [lW2Of] at hb1 ⊢; rw [he0]; exact hm10 (he1.symm.trans hb1)
    · exact absurd rfl hne
  have hClnB : ∀ δ, (∀ q, δ (rWork q) = 0) → (∀ b : Fin 2, stPre δ (hW2Of r ws b) = 0) ∧
      stPre δ (r (ws 5)) = 0 ∧ stPre δ (r (ws 6)) = 0 ∧ stPre δ (r (ws 7)) = 0 := by
    intro δ hz; obtain ⟨c3, c4, c5, c6, c7⟩ := hCln δ hz
    exact ⟨fun b ↦ by fin_cases b <;> dsimp [hW2Of] <;> [exact c3; exact c4], c5, c6, c7⟩
  have heEqB : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ b : Fin 2, eBranch2Gen r ws e0 e1 b (stPre δ) =
      stPre δ (lW2Of r ws b) := by
    intro δ hz b; obtain ⟨he0, he1⟩ := heEq δ hz
    fin_cases b <;> dsimp [eBranch2Gen, lW2Of] <;> [exact he0.symm; exact he1.symm]
  have hSame : ∀ δ, (∀ q, δ (rWork q) = 0) → stPost δ (r (ws 0)) = stPre δ (r (ws 0)) ∧
      (∀ b : Fin 2, stPost δ (lW2Of r ws b) = stPre δ (lW2Of r ws b)) ∧
      (∀ b : Fin 2, stPost δ (hW2Of r ws b) = stPre δ (hW2Of r ws b)) ∧ stPost δ (r (ws 5)) =
      stPre δ (r (ws 5)) ∧ stPost δ (r (ws 6)) = stPre δ (r (ws 6)) ∧ stPost δ (r (ws 7)) =
      stPre δ (r (ws 7)) ∧ (∀ b : Fin 2, eBranch2Gen r ws e0 e1 b (stPost δ) =
      eBranch2Gen r ws e0 e1 b (stPre δ)) := by
    intro δ hz; have ha := hAgree δ hz
    refine ⟨ha _, fun b ↦ ha _, fun b ↦ ha _, ha _, ha _, ha _, fun b ↦ ?_⟩
    dsimp only [eBranch2Gen]; rw [ha (ws 8), ha (ws 9)]
  have hPreEq : mkKetOpW rWork (fun δ ↦ stSplitRFwd (r (ws 0)) (lW2Of r ws) (hW2Of r ws)
      (stPre δ)) phPre =
      mkKetOpW rWork (fun δ ↦ stepCB r (pSplitR2EquivK ws).fwdBits (stPre δ)) phPre :=
          mkKetOpW_congr rWork
      (fun δ hz ↦ stSplitRFwd_eq_stepCB r ws hws (stPre δ) (hCln δ hz).1 (hCln δ hz).2.1)
      (fun _ _ ↦ rfl)
  have hPostEq : mkKetOpW rWork (fun δ ↦ stSplitRFwd (r (ws 0)) (lW2Of r ws) (hW2Of r ws)
      (stPost δ)) phPost =
      mkKetOpW rWork (fun δ ↦ stepCB r (pSplitR2EquivK ws).fwdBits (stPost δ)) phPost :=
          mkKetOpW_congr rWork
      (fun δ hz ↦ by
        have ha := hAgree δ hz
        exact stSplitRFwd_eq_stepCB r ws hws (stPost δ)
          ((ha (ws 3)).trans (hCln δ hz).1)
          ((ha (ws 4)).trans (hCln δ hz).2.1))
      (fun _ _ ↦ rfl)
  have hMid' : SubspaceStep (mkKetOpW rWork (fun δ ↦ stSplitRFwd (r (ws 0)) (lW2Of r ws)
      (hW2Of r ws) (stPre δ)) phPre) (mkKetOpW rWork (fun δ ↦ stSplitRFwd (r (ws 0)) (lW2Of r ws)
      (hW2Of r ws) (stPost δ)) phPost) mid :=
      subspaceStep_congr_out (subspaceStep_congr_in hPreEq hMid) hPostEq.symm
  have hStep := step_pSplitRBracket (by decide : 0 < 2) v rWork (r (ws 0)) (lW2Of r ws) (hW2Of r ws)
    (r (ws 5)) (r (ws 6)) (r (ws 7)) (eBranch2Gen r ws e0 e1) (mkWOptInjSplitR2 r ws hws)
    heIndep stPre stPost phPre phPost mid hMut hClnB heEqB hSame hMid'
  obtain ⟨ht, hf⟩ :=
      counts_pSplitRBracket v (r (ws 0)) (lW2Of r ws) (hW2Of r ws) (r (ws 5)) (r (ws 6)) (r (ws 7))
      (mkWOptInjSplitR2 r ws hws) mid
  refine ⟨hStep, ht, hf, fun S hr hd ↦ ?_⟩
  exact dynWires_pSplitRBracket v (r (ws 0)) (lW2Of r ws) (hW2Of r ws) (r (ws 5)) (r (ws 6))
      (r (ws 7)) (mkWOptInjSplitR2 r ws hws) mid (hr _) (fun _ ↦ hr _) (fun _ ↦ hr _) (hr _) (hr _)
