theorem rSwapNucFlags3Top_rPot0_and_clamp {wWork n : ℕ}
    (hwLo : 232 ≤ wWork) (hwHi : wWork ≤ 886) (rTot : QRegister dLayout n) :
    let rTot1 := rTot.compose (rSwapNucFlags3Top wWork hwLo hwHi)
    rTot1.compose rPot0Layout = rTot.compose rPot0Layout ∧ (uSwapHi24 rTot1).1 =
