      allLt 40 (fun u ↦ (getCT 7 keep22CT u).testBit qi == sti.testBit u) &&
      allLt 39 (fun u ↦ (getCT 7 in85CT u).testBit qi == sti.testBit u) &&
      allLt 24 (fun j ↦ (getCT 7 in85CT (39 + j)).testBit qi ==
        xor ((getCT 7 out1 (9 + j)).testBit qi) ((getCT 7 out2r (9 + j)).testBit qi)) &&
      allLt 22 (fun k ↦
          (getCT 7 in85CT (63 + k)).testBit qi == (getCT 7 keep22CT (keep22Idx k)).testBit qi) &&
      allLt 85 (fun u ↦ (getCT 7 sub94CT u).testBit qi == (getCT 7 in85CT u).testBit qi) &&
