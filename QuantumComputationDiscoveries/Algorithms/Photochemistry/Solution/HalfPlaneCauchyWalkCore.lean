            simp [show ¬(u < 9) by omega, show ¬(u < 39) by omega, show ¬(u < 63) by omega, hu85]
    have hsTail_i (p) (hp : p < 9) :
        (getCT 7 tail94CT (9 + p)).testBit (31 * kp + 1 + i) = pivBit c0 (1 <<< i) p :=
