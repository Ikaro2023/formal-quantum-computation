  let f9 (k : Fin 9) : ZMod 2 :=
    if hk : k.val < 8 then γ (emb ⟨k.val, by omega⟩) else γ (emb ⟨9, by decide⟩)
  have h10 : γ (emb ⟨10, by decide⟩) = mkIn22 (code9Emb emb γ) ⟨10, by decide⟩ :=
    hp01.trans (congrArg₂ (· * ·) (finBitsVal_testBit f9 ⟨0, by decide⟩)
      (finBitsVal_testBit f9 ⟨1, by decide⟩))
  funext u
