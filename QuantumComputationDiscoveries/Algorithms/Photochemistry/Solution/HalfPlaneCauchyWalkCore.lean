theorem wrDisj_out_q : ∀ j, wrOut6_118 j ≠ wrEnc_118 := by decide

theorem wrDisj118 {n : ℕ} (r : QRegister 118 n) :
    WRouterDisj (r wrHas_118) (fun d ↦ r (wrIdx3_118 d))
      (fun j ↦ r (wrOut6_118 j)) (r wrEnc_118) where
