  has_ne_q := r.wires.injective.ne wrDisj_has_q
  idx_ne_out d j := r.wires.injective.ne (wrDisj_idx_out d j)
  idx_ne_q d := r.wires.injective.ne (wrDisj_idx_q d)
  out_inj i j hij := r.wires.injective.ne (wrDisj_out_inj i j hij)
  out_ne_q j := r.wires.injective.ne (wrDisj_out_q j)

def pWrDual118 {Var : Type} {n : ℕ} (v : Var) (r : QRegister 118 n) (w1 w2 : ℕ)
