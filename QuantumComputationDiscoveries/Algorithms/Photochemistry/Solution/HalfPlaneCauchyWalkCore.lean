    r.wires.injective.ne (Fin.ne_of_val_ne (by dsimp [wrOut6_118, dst0]; omega))
  let h1 : r (wrOut6_118 ⟨5, by decide⟩) ≠ r dst1 :=
    r.wires.injective.ne (Fin.ne_of_val_ne (by dsimp [wrOut6_118, dst1]; omega))
  let cMid : Circuit n :=
    Circuit.CNOT (r (wrOut6_118 ⟨3, by decide⟩)) (r dst0) h0 ;;ᶜ
    Circuit.CNOT (r (wrOut6_118 ⟨5, by decide⟩)) (r dst1) h1
  have cMidT : cMid.count .T = 0 := by dsimp only [cMid]; rw [Circuit.count_seq, cnotT, cnotT]
  have cMidF : cMid.count .TOFF = 0 := by dsimp only [cMid]; rw [Circuit.count_seq, cnotF, cnotF]
  obtain ⟨tw, fw⟩ :=
      (wRouterBracket3x2k 1).count_wrap v (r wrHas_118) (fun d ↦ r (wrIdx3_118 d))
      (fun m ↦ r (wrOut6_118 m)) (r wrEnc_118) (.circuit cMid)
  refine ⟨?_, ?_⟩
  · dsimp only [DynamicCircuit.count] at tw ⊢
    rw [tw, cMidT]; simp [Circuit.X]
  · dsimp only [DynamicCircuit.count] at fw ⊢
    rw [fw, cMidF]; simp [Circuit.X]

def toDynStep118 {Var : Type} {n : ℕ} (v : Var) (r : QRegister 118 n)
    (c : ℕ) : DynamicCircuit Var n :=
  let tg := c % 8
  let w1 := (c / 8) % 128
  let w2 := (c / 1024) % 128
  let w3 := (c / 131072) % 128
  if tg = 0 then
    if h : w1 < 118 then .circuit (Circuit.X (r ⟨w1, h⟩))
    else .circuit Circuit.identity
  else if tg = 1 then
    if h : w1 < 118 ∧ w2 < 118 ∧ w1 ≠ w2 then
      .circuit (Circuit.CNOT (r ⟨w1, h.1⟩) (r ⟨w2, h.2.1⟩)
        (r.wires.injective.ne (Fin.ne_of_val_ne h.2.2)))
    else .circuit Circuit.identity
  else if tg = 2 then
    if h : w1 < 118 ∧ w2 < 118 ∧ w3 < 118 ∧ w1 ≠ w2 ∧ w1 ≠ w3 ∧ w2 ≠ w3 then
      .circuit (andComputeCircuit (r ⟨w1, h.1⟩) (r ⟨w2, h.2.1⟩) (r ⟨w3, h.2.2.1⟩)
        (r.wires.injective.ne (Fin.ne_of_val_ne h.2.2.2.1))
        (r.wires.injective.ne (Fin.ne_of_val_ne h.2.2.2.2.1))
        (r.wires.injective.ne (Fin.ne_of_val_ne h.2.2.2.2.2)))
    else .circuit Circuit.identity
  else if tg = 3 then
    if h : w1 < 118 ∧ w2 < 118 ∧ w3 < 118 ∧ w1 ≠ w2 ∧ w1 ≠ w3 ∧ w2 ≠ w3 then
      andUncomputeDyn v (r ⟨w1, h.1⟩) (r ⟨w2, h.2.1⟩) (r ⟨w3, h.2.2.1⟩)
        (r.wires.injective.ne (Fin.ne_of_val_ne h.2.2.2.1))
        (r.wires.injective.ne (Fin.ne_of_val_ne h.2.2.2.2.1))
        (r.wires.injective.ne (Fin.ne_of_val_ne h.2.2.2.2.2))
    else .circuit Circuit.identity
  else if tg = 4 then
    if h : w1 < 118 ∧ w2 < 118 ∧ w1 ≠ w2 ∧ (w1 < 18 ∨ 28 < w1) ∧ (w2 < 18 ∨ 28 < w2) then
      pWrDual118 v r w1 w2 h
    else .circuit Circuit.identity
  else .circuit Circuit.identity

def toDynTree118 {Var : Type} {n : ℕ} (v : Var) (r : QRegister 118 n) :
    PrimTree → DynamicCircuit Var n
  | .empty => .circuit Circuit.identity
  | .leaf c => toDynStep118 v r c
  | .node l rt => .seq (toDynTree118 v r l) (toDynTree118 v r rt)

theorem dynWires_toDynStep118 {Var : Type} {n : ℕ} {S : Wire n → Prop} (v : Var)
    (r : QRegister 118 n) (hr : ∀ i : Fin 118, S (r i)) (c : ℕ) : DynWires S (toDynStep118 v r c)
    := by
  dsimp only [toDynStep118]; split_ifs
  · exact cw_1 (hr _)
  · trivial
  · exact cw_cnot (hr _) (hr _)
  · trivial
  · exact cw_andComputeCircuit118 (hr _) (hr _) (hr _)
  · trivial
  · exact dynWires_andUncomputeDyn118 v (hr _) (hr _) (hr _)
  · trivial
  · exact ⟨cw_1 (hr _),
      (wRouterBracket3x2k 1).dynWires_wrap v _ _ _ _ _
        (hr _) (fun _ ↦ hr _) (fun _ ↦ hr _) (hr _)
        ⟨cw_cnot (hr _) (hr _), cw_cnot (hr _) (hr _)⟩,
      cw_1 (hr _)⟩
  · trivial
  · trivial

theorem dynWires_toDynTree118 {Var : Type} {n : ℕ} {S : Wire n → Prop}
    (v : Var) (r : QRegister 118 n) (hr : ∀ i : Fin 118, S (r i)) :
    ∀ t : PrimTree, DynWires S (toDynTree118 v r t)
  | .empty => trivial
  | .leaf c => dynWires_toDynStep118 v r hr c
  | .node l rt => ⟨dynWires_toDynTree118 v r hr l, dynWires_toDynTree118 v r hr rt⟩

noncomputable def stOfCT {n : ℕ} (r : QRegister 118 n) (st0 : BitAssignment n → BitAssignment n)
    (idxOf : BitAssignment n → ℕ) (cols : CT) (δ : BitAssignment n) : BitAssignment n :=
    writeReg (st0 δ) r (fun u ↦ z2b ((getCT 7 cols u.val).testBit (idxOf δ)))
theorem idxValPrefix_map_reg118 {D n : ℕ} (r : QRegister 118 n) (wIdx : Fin D → Wire 118)
    (γ : BitAssignment n) :
    ∀ (m : ℕ) (hm : m ≤ D),
      idxValPrefix (fun d ↦ r (wIdx d)) γ m hm = idxValPrefix wIdx (fun k ↦ γ (r k)) m hm
  | 0, _ => rfl
  | m + 1, hm => by
      dsimp only [idxValPrefix]; rw [idxValPrefix_map_reg118 r wIdx γ m (Nat.le_of_succ_le hm)]
theorem idxValD_map_reg118 {D n : ℕ} (r : QRegister 118 n) (wIdx : Fin D → Wire 118)
    (γ : BitAssignment n) : idxValD (fun d ↦ r (wIdx d)) γ = idxValD wIdx (fun k ↦ γ (r k)) :=
    idxValPrefix_map_reg118 r wIdx γ D le_rfl
theorem toggleOneHotBits_map_reg118 {D N n : ℕ} (r : QRegister 118 n) (wHas : Wire 118)
    (wIdx : Fin D → Wire 118) (wOut : Fin N → Wire 118) (γ : BitAssignment n)
    (u : Wire 118) : toggleOneHotBits (r wHas) (fun d ↦ r (wIdx d)) (fun j ↦ r (wOut j)) γ (r u) =
    toggleOneHotBits wHas wIdx wOut (fun k ↦ γ (r k)) u := by
  have hIdx := idxValD_map_reg118 r wIdx γ; dsimp only [toggleOneHotBits]
  by_cases h : idxValD wIdx (fun k ↦ γ (r k)) < N
  · have h' : idxValD (fun d ↦ r (wIdx d)) γ < N := hIdx ▸ h
    rw [leg_dif_pos h', leg_dif_pos h]
    have hFin : (⟨idxValD (fun d ↦ r (wIdx d)) γ, h'⟩ : Fin N) =
        ⟨idxValD wIdx (fun k ↦ γ (r k)), h⟩ := Fin.ext hIdx
    rw [hFin]
    by_cases hu : u = wOut ⟨idxValD wIdx (fun k ↦ γ (r k)), h⟩
    · subst hu; rw [Function.update_self, Function.update_self]
    · rw [Function.update_of_ne (r.wires.injective.ne hu), Function.update_of_ne hu]
  · have h' : ¬ idxValD (fun d ↦ r (wIdx d)) γ < N := hIdx ▸ h
    rw [leg_dif_neg h', leg_dif_neg h]

theorem wrIdxVal_props118 (bu d0 d1 : Bool) (hDisj : (d0 && d1) = false) (β : BitAssignment 118)
    (hU : β wrU_118 = z2b bu) (h0 : β wrD0_118 = z2b d0) (h1 : β wrD1_118 = z2b d1) :
    idxValD wrIdx3_118 β < 3 * 2 ^ 1 ∧ (if idxValD wrIdx3_118 β = 3 then (1 : ZMod 2) else 0) =
    z2b (d0 && bu) ∧ (if idxValD wrIdx3_118 β = 5 then (1 : ZMod 2) else 0) = z2b (d1 && bu) := by
  have h0_eq : wrIdx3_118 ⟨0, by decide⟩ = wrU_118 := rfl
  have h1_eq : wrIdx3_118 ⟨1, by decide⟩ = wrD0_118 := rfl
  have h2_eq : wrIdx3_118 ⟨2, by decide⟩ = wrD1_118 := rfl
  have hExpand : idxValD wrIdx3_118 β = (if z2b bu = 1 then 1 else 0) +
      (if z2b d0 = 1 then 2 else 0) + (if z2b d1 = 1 then 4 else 0) := by
    dsimp only [idxValD, idxValPrefix]; rw [h0_eq, h1_eq, h2_eq, hU, h0, h1]
    cases bu <;> cases d0 <;> cases d1 <;> decide
  rw [hExpand]
  revert hDisj
  cases bu <;> cases d0 <;> cases d1 <;> decide

theorem supportedOn_mkKetOpW_ld {W n : ℕ} [NeZero (2 ^ n)] (rWork : QRegister W n)
    (st : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    {P : BitAssignment n → Prop}
    (hP : ∀ δ : BitAssignment n, (∀ k : Fin W, δ (rWork k) = 0) → P (st δ)) :
    SupportedOn P (mkKetOpW rWork st ph) := fun A B hAB ↦
  matrix_ext_ket fun δ ↦ by
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, Matrix.mulVec_smul, hAB (st δ) (hP δ hz)]
    · simp only [Matrix.mulVec_zero]

theorem uOneHotToggle_mul_mkKetOpW_ld {D N W n : ℕ} [NeZero (2 ^ n)] (wHas : Wire n)
    (wIdx : Fin D → Wire n) (wOut : Fin N → Wire n) (hHasOut : ∀ j, wHas ≠ wOut j)
    (hIdxOut : ∀ d j, wIdx d ≠ wOut j) (rWork : QRegister W n)
    (st : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2) :
    (uOneHotToggle wHas wIdx wOut hHasOut hIdxOut).1 * mkKetOpW rWork st ph =
    mkKetOpW rWork (fun δ ↦ toggleOneHotBits wHas wIdx wOut (st δ)) ph :=
  matrix_ext_ket fun δ ↦ by
    rw [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, uOneHotToggle_mulVec_ket]
    · simp only [Matrix.mulVec_zero]

theorem toff_mul_mkKetOpW_ld {W n : ℕ} [NeZero (2 ^ n)] (c₁ c₂ anc : Wire n) (h₁₂ : c₁ ≠ c₂)
    (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc) (rWork : QRegister W n)
    (st : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2) :
    (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * mkKetOpW rWork st ph = mkKetOpW rWork (fun δ ↦
    Function.update (st δ) anc (st δ anc + st δ c₁ * st δ c₂)) ph :=
  matrix_ext_ket fun δ ↦ by
    rw [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, ket_TOFF]
    · simp only [Matrix.mulVec_zero]

theorem andCompute_mul_mkKetOpW_ld {W n : ℕ} [NeZero (2 ^ n)] (c₁ c₂ anc : Wire n) (h₁₂ : c₁ ≠ c₂)
    (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc) (rWork : QRegister W n)
    (st : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (h0 : ∀ δ : BitAssignment n, (∀ k : Fin W, δ (rWork k) = 0) → st δ anc = 0) :
    (andComputeCircuit c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * mkKetOpW rWork st ph =
    mkKetOpW rWork (fun δ ↦ Function.update (st δ) anc (st δ c₁ * st δ c₂)) ph :=
  matrix_ext_ket fun δ ↦ by
    rw [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, andComputeCircuit_mulVec_ket_of_zero c₁ c₂ anc h₁₂ h₁a h₂a (st δ)
          (h0 δ hz)]
    · simp only [Matrix.mulVec_zero]

theorem cleanProj_singleton_mul_mkKetOpW_ld {W n : ℕ} [NeZero (2 ^ n)] (q : Wire n)
    (rWork : QRegister W n) (st : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (hq : ∀ δ : BitAssignment n, (∀ k : Fin W, δ (rWork k) = 0) → st δ q = 0) :
    cleanProj ({q} : Finset (Wire n)) * mkKetOpW rWork st ph = mkKetOpW rWork st ph :=
  matrix_ext_ket fun δ ↦ by
    rw [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, PhotochemistrySolution.KinB.cleanProj_mulVec_ket,
          itePos (fun w hw ↦ by rw [Finset.mem_singleton.mp hw]; exact hq δ hz)]
    · simp only [Matrix.mulVec_zero]

theorem circ_mul_mkKetOpW_ld {W n : ℕ} [NeZero (2 ^ n)] (c : Circuit n) (rWork : QRegister W n)
    (st st' : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (hc : ∀ δ : BitAssignment n, c.eval.1.mulVec (ket (st δ)) = ket (st' δ)) : c.eval.1 *
    mkKetOpW rWork st ph = mkKetOpW rWork st' ph :=
  matrix_ext_ket fun δ ↦ by
    rw [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, hc δ]
    · simp only [Matrix.mulVec_zero]

theorem stOfCT_reg {n : ℕ} (r : QRegister 118 n) (st0 : BitAssignment n → BitAssignment n)
    (idxOf : BitAssignment n → ℕ) (cols : CT) (δ : BitAssignment n) {u : ℕ} (hu : u < 118) :
    stOfCT r st0 idxOf cols δ (r ⟨u, hu⟩) = z2b ((getCT 7 cols u).testBit (idxOf δ)) :=
  writeReg_apply_reg (st0 δ) r _ ⟨u, hu⟩

theorem stOfCT_update_xorStrict7 {n : ℕ} (r : QRegister 118 n)
    (st0 : BitAssignment n → BitAssignment n)
    (idxOf : BitAssignment n → ℕ) (cols : CT) (wt : ℕ) (hwt : wt < 118) (mask : ℕ)
        (δ : BitAssignment n) (val : ZMod 2)
    (hval : val = z2b (xor ((getCT 7 cols wt).testBit (idxOf δ)) (mask.testBit (idxOf δ)))) :
    Function.update (stOfCT r st0 idxOf cols δ)
        (r ⟨wt, hwt⟩) val = stOfCT r st0 idxOf (xorStrict 7 cols wt mask) δ := by
  funext w
  by_cases hmem : w ∈ Set.range r.wires
  · obtain ⟨u, rfl⟩ := hmem
    by_cases hwu : wt = u.val
    · obtain rfl : u = ⟨wt, hwt⟩ := Fin.ext hwu.symm
      rw [Function.update_self, stOfCT_reg, xorStrict7_testBit cols wt wt mask (idxOf δ) hwt hwt,
          ite_eq_left rfl, hval]
    · rw [Function.update_of_ne (r.wires.injective.ne (Fin.ne_of_val_ne (Ne.symm hwu))), stOfCT_reg,
          stOfCT_reg,
          xorStrict7_testBit cols u.val wt mask (idxOf δ) u.isLt hwt, ite_eq_right hwu]
  · dsimp only [stOfCT]
    rw [Function.update_of_ne (fun e ↦ hmem ⟨⟨wt, hwt⟩, e.symm⟩),
        writeReg_apply_of_not_mem _ r _ w hmem, writeReg_apply_of_not_mem _ r _ w hmem]

theorem stOfCT_xorStrict7_cancel {n : ℕ} (r : QRegister 118 n)
    (st0 : BitAssignment n → BitAssignment n)
    (idxOf : BitAssignment n → ℕ) (cols : CT) (wt : ℕ) (hwt : wt < 118) (mask : ℕ)
        (δ : BitAssignment n) :
    stOfCT r st0 idxOf (xorStrict 7 (xorStrict 7 cols wt mask) wt mask) δ =
        stOfCT r st0 idxOf cols δ := by
  funext w
  by_cases hmem : w ∈ Set.range r.wires
  · obtain ⟨u, rfl⟩ := hmem
    rw [stOfCT_reg, stOfCT_reg, xorStrict7_testBit _ u.val wt mask (idxOf δ) u.isLt hwt,
        xorStrict7_testBit cols u.val wt mask (idxOf δ) u.isLt hwt]
    by_cases hwu : wt = u.val <;> simp only [hwu, ↓reduceIte, Bool.xor_assoc, Bool.xor_self,
        Bool.xor_false]
  · dsimp only [stOfCT]
    rw [writeReg_apply_of_not_mem _ r _ w hmem, writeReg_apply_of_not_mem _ r _ w hmem]

theorem step_x118 {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ} [NeZero (2 ^ n)]
    (rWork : QRegister W n) (r : QRegister 118 n)
    (st0 : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (idxOf : BitAssignment n → ℕ) (hIdx : ∀ δ, idxOf δ < 1024)
    (cols : CT) (w1 : ℕ) (hw1 : w1 < 118) :
    SubspaceStep (Var := Var)
      (mkKetOpW rWork (stOfCT r st0 idxOf cols) ph)
      (mkKetOpW rWork (stOfCT r st0 idxOf (xorStrict 7 cols w1 (repMask 10))) ph)
      (.circuit (Circuit.X (r ⟨w1, hw1⟩))) := by
  refine subspaceStep_congr_out (subspaceStep_circuit (Var := Var)
      (Circuit.X (r ⟨w1, hw1⟩)) _) ?_
  rw [circ_mul_mkKetOpW_ld (Circuit.X (r ⟨w1, hw1⟩)) rWork (stOfCT r st0 idxOf cols) _ ph (fun _ ↦
      ket_X (r ⟨w1, hw1⟩) _)]
  exact mkKetOpW_congr rWork (fun δ _ ↦
      stOfCT_update_xorStrict7 r st0 idxOf cols w1 hw1 (repMask 10) δ _
    (by rw [stOfCT_reg, repMask_testBit 10 (idxOf δ), decide_eq_true (p := idxOf δ < 2 ^ 10)
          (hIdx δ), Bool.xor_true, ← z2b_not]))
    (fun _ _ ↦ rfl)

theorem step_cnot118 {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ} [NeZero (2 ^ n)]
    (rWork : QRegister W n) (r : QRegister 118 n)
    (st0 : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (idxOf : BitAssignment n → ℕ)
    (cols : CT) (w1 w2 : ℕ) (hw : w1 < 118 ∧ w2 < 118 ∧ w1 ≠ w2) :
    SubspaceStep (Var := Var)
      (mkKetOpW rWork (stOfCT r st0 idxOf cols) ph)
      (mkKetOpW rWork (stOfCT r st0 idxOf (xorStrict 7 cols w2 (getCT 7 cols w1))) ph)
      (.circuit (Circuit.CNOT (r ⟨w1, hw.1⟩) (r ⟨w2, hw.2.1⟩)
        (r.wires.injective.ne (Fin.ne_of_val_ne hw.2.2)))) := by
  refine subspaceStep_congr_out (subspaceStep_circuit (Var := Var) _ _) ?_
  rw [circ_mul_mkKetOpW_ld _ rWork (stOfCT r st0 idxOf cols) _ ph (fun _ ↦ ket_CNOT _ _ _ _)]
  exact mkKetOpW_congr rWork (fun δ _ ↦
      stOfCT_update_xorStrict7 r st0 idxOf cols w2 hw.2.1 (getCT 7 cols w1) δ _
    (by rw [stOfCT_reg, stOfCT_reg, ← z2b_xor])) (fun _ _ ↦ rfl)

theorem step_andC118 {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ} [NeZero (2 ^ n)]
    (rWork : QRegister W n) (r : QRegister 118 n)
    (st0 : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (idxOf : BitAssignment n → ℕ)
    (cols : CT) (w1 w2 w3 : ℕ)
    (hw : w1 < 118 ∧ w2 < 118 ∧ w3 < 118 ∧ w1 ≠ w2 ∧ w1 ≠ w3 ∧ w2 ≠ w3)
    (hz3 : getCT 7 cols w3 = 0) :
    SubspaceStep (Var := Var)
      (mkKetOpW rWork (stOfCT r st0 idxOf cols) ph)
      (mkKetOpW rWork (stOfCT r st0 idxOf (xorStrict 7 cols w3 (getCT 7 cols w1 &&& getCT 7 cols
          w2))) ph)
      (.circuit (andComputeCircuit (r ⟨w1, hw.1⟩) (r ⟨w2, hw.2.1⟩) (r ⟨w3, hw.2.2.1⟩)
        (r.wires.injective.ne (Fin.ne_of_val_ne hw.2.2.2.1))
        (r.wires.injective.ne (Fin.ne_of_val_ne hw.2.2.2.2.1))
        (r.wires.injective.ne (Fin.ne_of_val_ne hw.2.2.2.2.2)))) := by
  have hc :=
      subspaceStep_circuit (Var := Var) (andComputeCircuit (r ⟨w1, hw.1⟩) (r ⟨w2, hw.2.1⟩)
      (r ⟨w3, hw.2.2.1⟩)
    (r.wires.injective.ne (Fin.ne_of_val_ne hw.2.2.2.1))
        (r.wires.injective.ne (Fin.ne_of_val_ne hw.2.2.2.2.1))
    (r.wires.injective.ne (Fin.ne_of_val_ne hw.2.2.2.2.2)))
        (mkKetOpW rWork (stOfCT r st0 idxOf cols) ph)
  rw [andCompute_mul_mkKetOpW_ld _ _ _ _ _ _ rWork _ ph
    (fun δ _ ↦ by rw [stOfCT_reg, hz3, Nat.zero_testBit, z2b_false])] at hc
  exact subspaceStep_congr_out hc (mkKetOpW_congr rWork (fun δ _ ↦
    stOfCT_update_xorStrict7 r st0 idxOf cols w3 hw.2.2.1 (getCT 7 cols w1 &&& getCT 7 cols w2) δ _
      (by rw [stOfCT_reg, stOfCT_reg, hz3, Nat.zero_testBit, Bool.false_xor, Nat.testBit_and,
            ← z2b_and])) (fun _ _ ↦ rfl))

theorem step_andR118 {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rWork : QRegister W n) (r : QRegister 118 n)
    (st0 : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (idxOf : BitAssignment n → ℕ)
    (cols : CT) (w1 w2 w3 : ℕ)
    (hw : w1 < 118 ∧ w2 < 118 ∧ w3 < 118 ∧ w1 ≠ w2 ∧ w1 ≠ w3 ∧ w2 ≠ w3)
    (hv3 : getCT 7 cols w3 = (getCT 7 cols w1 &&& getCT 7 cols w2)) :
    SubspaceStep (Var := Var)
      (mkKetOpW rWork (stOfCT r st0 idxOf cols) ph)
      (mkKetOpW rWork (stOfCT r st0 idxOf (xorStrict 7 cols w3 (getCT 7 cols w3))) ph)
      (andUncomputeDyn v (r ⟨w1, hw.1⟩) (r ⟨w2, hw.2.1⟩) (r ⟨w3, hw.2.2.1⟩)
