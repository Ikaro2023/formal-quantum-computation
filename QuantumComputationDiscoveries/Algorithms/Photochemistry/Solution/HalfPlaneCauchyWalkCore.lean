    DynWires S (pStep2bScr31 v rBasis9 rCopy30 rScr31 rYHi33 hBC hBS hCS hBY hCY hSY) := by
  let rI85 := rI85Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY
  let rT94 := rTail94Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY
  let rYPiv := rYPiv9Of rYHi33
  let hDisjPiv := tail94_disj_yPiv9 hBC hBS hCS hBY hCY hSY
  let rU96 := rUnc96Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY
  let rA01 := rA01_31Of rScr31
  let hDisjA01 := unc96_disj_a01_31 hBC hBS hCS hBY hCY hSY
  let cpPrep := decodePrimTree 84 bf31Prep85Tree
  let cpTail := decodePrimTree 93 bf31Tail94Tree
