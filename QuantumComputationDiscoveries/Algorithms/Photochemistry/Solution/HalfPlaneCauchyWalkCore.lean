theorem phaseTurn_conjTranspose_mul_single00 (x : ℝ) : (phaseTurn x)ᴴ * Matrix.single (0 : Fin 2)
    (0 : Fin 2) (1 : ℂ) = Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℂ) := by
