def uLoMono {Wp n : ℕ} (r41 : QRegister (122 + Wp) n) : Fin 1 → Wire n := fun _ ↦ wPotBLocQ r41
theorem count_cnot_zero {n : ℕ} (c t : Wire n) (h : c ≠ t) :
    (Circuit.CNOT c t h).count .T = 0 ∧ (Circuit.CNOT c t h).count .TOFF = 0 := ⟨rfl, rfl⟩

theorem count_x_zero {n : ℕ} (q : Wire n) :
    (Circuit.X q).count .T = 0 ∧ (Circuit.X q).count .TOFF = 0 := ⟨rfl, rfl⟩

def vMonoPre (scr pot nn : ZMod 2) : Fin 9 → ZMod 2 :=
    mkVec9 (scr + nn) (pot + scr) nn (1 + pot) scr nn 0 0 0
def vMonoBase (scr pot nn : ZMod 2) : Fin 9 → ZMod 2 := mkVec9 0 0 0 (1 + pot) scr nn 0 0 0
def vMonoMid (locQ scr pot nn : ZMod 2) : Fin 9 → ZMod 2 :=
    mkVec9 ((1 + locQ) * (scr + nn)) ((1 + locQ) * (pot + scr)) ((1 + locQ) * nn)
    (1 + pot) scr nn (locQ * (scr + nn)) (locQ * nn) (locQ * (pot + scr))
def vMonoPost (locQ scr pot nn : ZMod 2) : Fin 9 → ZMod 2 :=
    mkVec9 scr pot nn 0 0 0 ((locQ * pot) * scr) (((locQ * pot) * scr) * nn) (locQ * pot)
theorem cw_andComputeCircuit {n : ℕ} {S : Wire n → Prop} (c₁ c₂ anc : Wire n) (h₁₂ : c₁ ≠ c₂)
    (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc) (hc1 : S c₁) (hc2 : S c₂)
    (ha : S anc) : CircWires S (andComputeCircuit c₁ c₂ anc h₁₂ h₁a h₂a) := by
  have hInv : CircWires S ((Circuit.T anc).inverse) := by
    dsimp [Circuit.T, Circuit.S, Circuit.H, Circuit.Z, Circuit.X, Circuit.inverse,
        Circuit.inverseGate, CircWires]
    repeat (first | constructor | (intro i; fin_cases i; exact ha))
  unfold andComputeCircuit;
  exact ⟨cw_1 ha, cw_1 ha, cw_cnot hc2 ha, hInv, cw_cnot hc1 ha, cw_1 ha, cw_cnot hc2 ha, hInv,
      cw_cnot hc1 ha, cw_1 ha, cw_1 ha⟩
def muxWorkValNoM2 {Wp n : ℕ} (_h193 : 193 ≤ Wp) (isCsel : Bool) (r41 : QRegister (122 + Wp) n)
    (m0 : ℕ) (β : BitAssignment n) (u : Fin Wp) : ZMod 2 :=
  let wt := Wtop Wp isCsel
  if isCsel && decide (u.val = Wp - 1) then
    β (wPotBLocQ r41) * β (wPotBIsPot r41)
  else if wt - 48 + m0 ≤ u.val ∧ u.val < wt - 24 then
    if β (wPotBIsNN r41) == 1 then
      β (rPotBNucA r41 ⟨(u.val - (wt - 48)) % 24, Nat.mod_lt _ (by decide)⟩)
    else
      β (rPotBElecA r41 ⟨(u.val - (wt - 48)) % 24, Nat.mod_lt _ (by decide)⟩)
  else 0

def muxStNoM2 {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool) (r41 : QRegister (122 + Wp) n) (m0 : ℕ)
    (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) : BitAssignment n :=
    writeReg (writeReg β (rMuxZ16 r41) z16) (rPotBWork r41) (muxWorkValNoM2 h193 isCsel r41 m0 β)
theorem muxStNoM2_out {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool) (r41 : QRegister (122 + Wp) n)
    (m0 : ℕ) (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) {w : Wire n}
    (hw : ∀ k : Fin (122 + Wp), w ≠ r41 k) : muxStNoM2 h193 isCsel r41 m0 z16 β w = β w := by
  unfold muxStNoM2
  rw [writeReg_apply_of_not_mem _ (rPotBWork r41) _ w (fun ⟨u, hu⟩ ↦ hw _ hu.symm),
      writeReg_apply_of_not_mem _ (rMuxZ16 r41) _ w (fun ⟨j, hj⟩ ↦ hw _ hj.symm)]

theorem muxStNoM2_lt106 {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool)
    (r41 : QRegister (122 + Wp) n) (m0 : ℕ)
    (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) {m : ℕ} (hm : m < 106) :
    muxStNoM2 h193 isCsel r41 m0 z16 β (r41 ⟨m, by omega⟩) = β (r41 ⟨m, by omega⟩) := by
  unfold muxStNoM2
  rw [writeReg_apply_of_not_mem _ _ _ _ (fun ⟨u, hu⟩ ↦ r41_blk_ne_wire r41 u _ (by omega) hu),
      writeReg_apply_of_not_mem _ _ _ _ (fun ⟨j, hj⟩ ↦ r41_blk_ne_wire r41 j _ (by omega) hj)]

theorem muxStNoM2_z16 {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool) (r41 : QRegister (122 + Wp) n)
    (m0 : ℕ) (z16 : Fin 16 → ZMod 2) (β : BitAssignment n)
    (j : Fin 16) : muxStNoM2 h193 isCsel r41 m0 z16 β (rMuxZ16 r41 j) = z16 j := by
  unfold muxStNoM2
  rw [writeReg_apply_of_not_mem _ _ _ _ (fun ⟨u, hu⟩ ↦ r41_blk_ne_blk r41 u j (by omega) hu),
      writeReg_apply_reg]

theorem muxStNoM2_work {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool) (r41 : QRegister (122 + Wp) n)
    (m0 : ℕ) (z16 : Fin 16 → ZMod 2) (β : BitAssignment n)
    (u : Fin Wp) : muxStNoM2 h193 isCsel r41 m0 z16 β (rPotBWork r41 u) =
    muxWorkValNoM2 h193 isCsel r41 m0 β u := writeReg_apply_reg _ _ _ u
theorem muxStNoM2_r122 {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool)
    (r41 : QRegister (122 + Wp) n) (m0 : ℕ)
    (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) (u : Fin Wp) :
    muxStNoM2 h193 isCsel r41 m0 z16 β (r41 ⟨122 + u.val, by omega⟩) =
      muxWorkValNoM2 h193 isCsel r41 m0 β u := by
  rw [show r41 ⟨122 + u.val, by omega⟩ = rPotBWork r41 u from
    congrArg r41.wires (Fin.ext (by simp only [QRegister.block_apply_val])), muxStNoM2_work]

theorem muxStNoM2_eq_of_ne_z16 {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool)
    (r41 : QRegister (122 + Wp) n) (m0 : ℕ) (zA zB : Fin 16 → ZMod 2) (β : BitAssignment n)
    {w : Wire n} (hwZ : ∀ j : Fin 16, w ≠ rMuxZ16 r41 j) : muxStNoM2 h193 isCsel r41 m0 zA β w =
    muxStNoM2 h193 isCsel r41 m0 zB β w := by
  unfold muxStNoM2
  by_cases hwWk : ∃ u : Fin Wp, rPotBWork r41 u = w
  · obtain ⟨u, rfl⟩ := hwWk; rw [writeReg_apply_reg, writeReg_apply_reg]
  · rw [writeReg_apply_of_not_mem _ _ _ w hwWk, writeReg_apply_of_not_mem _ _ _ w hwWk,
        writeReg_apply_of_not_mem _ _ _ w (fun ⟨j, hj⟩ ↦ hwZ j hj.symm),
        writeReg_apply_of_not_mem _ _ _ w (fun ⟨j, hj⟩ ↦ hwZ j hj.symm)]

theorem muxStNoM2_pool_zero {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool)
    (r41 : QRegister (122 + Wp) n) (m0 : ℕ)
    (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) {u : ℕ}
    (huLtWp : u < Wp)
    (hNoGate : isCsel = false ∨ u ≠ Wp - 1)
    (hNoM1 : u < Wtop Wp isCsel - 48 + m0 ∨ Wtop Wp isCsel - 24 ≤ u) :
    muxStNoM2 h193 isCsel r41 m0 z16 β (r41 ⟨122 + u, by omega⟩) = 0 := by
  rw [muxStNoM2_r122 h193 isCsel r41 m0 z16 β ⟨u, huLtWp⟩]
  dsimp only [muxWorkValNoM2]
  have hc1 : (isCsel && decide (u = Wp - 1)) = false := by
    rcases hNoGate with rfl | hne <;> simp [*]
  simp only [hc1, show ¬(Wtop Wp isCsel - 48 + m0 ≤ u ∧ u < Wtop Wp isCsel - 24) by omega,
      Bool.false_eq_true, ↓reduceIte]

theorem muxStNoM2_240_zero {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool)
    (r41 : QRegister (122 + Wp) n) (m0 : ℕ) (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) :
    muxStNoM2 h193 isCsel r41 m0 z16 β (r41 ⟨240, by omega⟩) = 0 := by
  have := wtop_ge192 h193 isCsel
  exact muxStNoM2_pool_zero h193 isCsel r41 m0 z16 β (u := 118) (by omega) (Or.inr (by omega))
      (Or.inl (by omega))

theorem muxStNoM2_241_zero {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool)
    (r41 : QRegister (122 + Wp) n) (m0 : ℕ) (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) :
    muxStNoM2 h193 isCsel r41 m0 z16 β (r41 ⟨241, by omega⟩) = 0 := by
  have := wtop_ge192 h193 isCsel
  exact muxStNoM2_pool_zero h193 isCsel r41 m0 z16 β (u := 119) (by omega) (Or.inr (by omega))
      (Or.inl (by omega))

theorem muxStNoM2_gate_true {Wp n : ℕ} (h193 : 193 ≤ Wp)
    (r41 : QRegister (122 + Wp) n) (m0 : ℕ)
    (z16 : Fin 16 → ZMod 2) (β : BitAssignment n) :
    muxStNoM2 h193 true r41 m0 z16 β (r41 ⟨122 + Wp - 1, by omega⟩) =
      if potBGateActive true r41 β then 1 else 0 := by
  unfold potBGateActive; simp only [↓reduceIte]
  have hwEq : r41 ⟨122 + Wp - 1, by omega⟩ = r41 ⟨122 + (Wp - 1), by omega⟩ :=
    congrArg r41.wires (Fin.ext (by dsimp only; omega))
  rw [hwEq, muxStNoM2_r122 h193 true r41 m0 z16 β ⟨Wp - 1, by omega⟩]
  unfold muxWorkValNoM2; dsimp only
  simp only [decide_true, Bool.and_self, ↓reduceIte]
  rcases DynCircExt.bit_cases (β (wPotBLocQ r41)) with h0 | h0 <;>
    rcases DynCircExt.bit_cases (β (wPotBIsPot r41)) with h2 | h2 <;> (rw [h0, h2]; decide)

theorem muxStNoM2_m1 {Wp n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool) (r41 : QRegister (122 + Wp) n)
    (m0 : ℕ) (z16 : Fin 16 → ZMod 2) (β : BitAssignment n)
    (i : Fin 24) : muxStNoM2 h193 isCsel r41 m0 z16 β (rMuxM1 h193 isCsel r41 i) = if m0 ≤
    i.val then (if β (wPotBIsNN r41) == 1 then β (rPotBNucA r41 i) else β (rPotBElecA r41 i)) else 0
    := by
  have hw := wtop_ge192 h193 isCsel; have hwle := wtop_le_wp Wp isCsel;
  let u0 : ℕ := Wtop Wp isCsel - 48 + i.val
  have heq : rMuxM1 h193 isCsel r41 i = r41 ⟨122 + u0, by omega⟩ :=
    congrArg r41.wires (Fin.ext (by simp only [QRegister.block_apply_val, u0]; omega))
  rw [heq, muxStNoM2_r122 h193 isCsel r41 m0 z16 β ⟨u0, by omega⟩]
  unfold muxWorkValNoM2; dsimp only [u0]
  have hc1 : (isCsel && decide (Wtop Wp isCsel - 48 + i.val = Wp - 1)) = false := by
    cases isCsel <;> simp only [Wtop, ↓reduceIte, Bool.false_and, Bool.true_and,
        decide_eq_false_iff_not]
    have := i.isLt; omega
  simp only [hc1, Bool.false_eq_true, ↓reduceIte]
  by_cases hm : m0 ≤ i.val
  · have hc3 : Wtop Wp isCsel - 48 + m0 ≤ Wtop Wp isCsel - 48 + i.val ∧
        Wtop Wp isCsel - 48 + i.val < Wtop Wp isCsel - 24 := ⟨by omega, by have := i.isLt; omega⟩
    have hiEq : (⟨(Wtop Wp isCsel - 48 + i.val - (Wtop Wp isCsel - 48)) % 24,
        Nat.mod_lt _ (by decide)⟩ : Fin 24) = i :=
      Fin.ext
          (by dsimp; rw [show Wtop Wp isCsel - 48 + i.val - (Wtop Wp isCsel - 48) = i.val by omega,
        Nat.mod_eq_of_lt i.isLt])
    simp only [hm, hc3, and_self, ↓reduceIte, hiEq]
  · have hc3 : ¬(Wtop Wp isCsel - 48 + m0 ≤ Wtop Wp isCsel - 48 + i.val ∧
        Wtop Wp isCsel - 48 + i.val < Wtop Wp isCsel - 24) := by omega
    simp only [hm, hc3, ↓reduceIte]

theorem outer_wrappers_noM2 {Wp M n : ℕ} (h193 : 193 ≤ Wp) (isCsel : Bool) (hM : M ≤ 24)
    (r41 : QRegister (122 + Wp) n) (z16 : Fin 16 → ZMod 2)
    {β : BitAssignment n} (hWk : ∀ u : Fin Wp, β (rPotBWork r41 u) = 0) :
    let stZ := writeReg β (rMuxZ16 r41) z16
    let stG := gateWrapMux h193 isCsel r41 stZ
    writeSub24 stG (rMuxM1 h193 isCsel r41) M (24 - M) (mux1DistBit r41 stG) =
    muxStNoM2 h193 isCsel r41 M z16 β := by
  have hw := wtop_ge192 h193 isCsel
  have hwle := wtop_le_wp Wp isCsel
  dsimp only
  set stZ := writeReg β (rMuxZ16 r41) z16
  set stG := gateWrapMux h193 isCsel r41 stZ
  have hG_ne : ∀ {w : Wire n}, (isCsel = true → w ≠ r41 ⟨122 + Wp - 1, by omega⟩) → stG w = stZ w :=
      fun hwne ↦ by
    unfold stG gateWrapMux
    cases isCsel <;> simp only [↓reduceIte, Bool.false_eq_true]
    exact Function.update_of_ne (hwne rfl) _ _
  have hZ_lt106 : ∀ {m : ℕ} (hm : m < 106), stZ (r41 ⟨m, by omega⟩) = β (r41 ⟨m, by omega⟩) :=
    fun hm ↦ writeReg_apply_of_not_mem _ _ _ _ (fun ⟨j, hj⟩ ↦ r41_blk_ne_wire r41 j _ (by omega) hj)
  have hG_lt106 : ∀ {m : ℕ} (hm : m < 106), stG (r41 ⟨m, by omega⟩) = β (r41 ⟨m, by omega⟩) :=
    fun hm ↦ (hG_ne fun _ ↦ r41_ne r41 _ _ (by omega)).trans (hZ_lt106 hm)
  have hZ_wk : ∀ u : Fin Wp, stZ (rPotBWork r41 u) = 0 := fun u ↦
    (writeReg_apply_of_not_mem _ _ _ _ (fun ⟨j, hj⟩ ↦
        r41_blk_ne_blk r41 j u (by omega) hj)).trans (hWk u)
  have hBitM1 : ∀ i : Fin 24, mux1DistBit r41 stG i =
      if β (wPotBIsNN r41) == 1 then β (rPotBNucA r41 i) else β (rPotBElecA r41 i) := fun i ↦ by
    unfold mux1DistBit
    rw [show wPotBIsNN r41 = r41 ⟨4, by omega⟩ from rfl,
        show rPotBNucA r41 i = r41 ⟨9 + i.val,
            by omega⟩ from congrArg r41.wires (Fin.ext (by simp only [QRegister.block_apply_val])),
        show rPotBElecA r41 i = r41 ⟨33 + i.val,
