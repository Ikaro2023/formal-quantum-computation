        evalPrimTree_pureCnot_zero postTree_0_k9_pureCnot]
  · intro a b
    by_cases hb9 : b2.val < 9
    · simpa [yFinalBit, hb9] using hPiv_xor b2.val hb9 a b
    · simp only [yFinalBit, hb9, ↓reduceIte, hCar_xor (b2.val - 9) (by omega) a b, hIn33_xor a b,
