theorem tokMaskNT5Local22_eq (ones m : ℕ) (hones : ones.testBit m = true) {tok : DToken}
    (ht : tokWiresLt22 tok = true) (t : NTree5) : cond ((tokMaskNT5Local22 ones tok t).testBit m)
    (1 : ZMod 2) 0 = tokBitLocal22 tok (bitsOfNT5 t m) := by
  rcases tok with ⟨_, ws, inv⟩
  have hws (l : List ℕ) (hl : (l.all fun s ↦ Nat.blt s 22) = true) (base : ℕ) :
      cond ((l.foldr (fun s acc ↦ let v := (getNT5 5 t s) ^^^ acc
        cond (v == 0) 0 v) base).testBit m) (1 : ZMod 2) 0 =
      l.foldr (fun s acc ↦ bitsOfNT5 (M := 22) t m ⟨s % 22, Nat.mod_lt _ (by decide)⟩ + acc) 0 +
        cond (base.testBit m) 1 0 := by
    induction l with
    | nil => simp
    | cons s ss ih =>
      simp only [List.all_cons, Bool.and_eq_true, Nat.blt_eq] at hl
      dsimp only [List.foldr]
      rw [cond_zero_eq, Nat.testBit_xor, zmod2_cond_xor, ih hl.2]
      dsimp only [bitsOfNT5]
      rw [Nat.mod_eq_of_lt hl.1, ← add_assoc]
  dsimp only [tokMaskNT5Local22, tokBitLocal22]
  rw [hws ws ht (cond inv ones 0), add_comm]
  exact congrArg (· + _) (by cases inv <;> simp [hones])

