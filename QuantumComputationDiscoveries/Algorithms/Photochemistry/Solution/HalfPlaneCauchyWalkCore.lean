    rSwapNucFlags3Top_fix hwLo hwHi _ (by
      have hv : (rPot0Layout i).val = (potZeroNEremWireFn 0 pot0_le_690 i).val := rfl
      rw [hv, val_potZeroNEremWireFn pot0_le_690]
      split_ifs <;> omega)
  have hEqN (b : Fin 24) : rTot1 (rBufHi rNucLayout b) = rTot (rBufHi rNucLayout b) :=
    congrArg rTot.wires (rSwapNucFlags3Top_fix hwLo hwHi _ (by rw [val_bufHi_nuc]; omega))
  have hEqE (b : Fin 24) : rTot1 (rBufHi rElecLayout b) = rTot (rBufHi rElecLayout b) :=
    congrArg rTot.wires (rSwapNucFlags3Top_fix hwLo hwHi _ (by rw [val_bufHi_elec]; omega))
  have hwNN : rTot1 (wPotIsNN rPot0Layout) = rTot (wPotIsNN rPot0Layout) :=
    congrArg rTot.wires (hPot0 ⟨4, by decide⟩)
  refine ⟨congrArg QRegister.mk (Function.Embedding.ext fun i ↦ congrArg rTot.wires (hPot0 i)),
    matrix_ext_ket fun β ↦ ?_, funext fun β ↦ ?_⟩
  · rw [uSwapHi24_mulVec_ket rTot1 β, uSwapHi24_mulVec_ket rTot β]
    obtain ⟨eE1, eN1, eO1⟩ := swapHi24Bits_apply rTot1 β
    obtain ⟨eE2, eN2, eO2⟩ := swapHi24Bits_apply rTot β
    refine congrArg ket (funext fun w ↦ ?_)
    rcases Classical.em (∃ b, w = rTot (rBufHi rElecLayout b)) with ⟨b, rfl⟩ | hwE
    · rw [← hEqE b, eE1 b, hEqE b, hEqN b, hwNN, eE2 b]
    · rcases Classical.em (∃ b, w = rTot (rBufHi rNucLayout b)) with ⟨b, rfl⟩ | hwN
      · rw [← hEqN b, eN1 b, hEqE b, hEqN b, hwNN, eN2 b]
      · rw [eO1 w (fun b e ↦ hwE ⟨b, e.trans (hEqE b)⟩) (fun b e ↦ hwN ⟨b, e.trans (hEqN b)⟩),
          eO2 w (fun b e ↦ hwE ⟨b, e⟩) (fun b e ↦ hwN ⟨b, e⟩)]
