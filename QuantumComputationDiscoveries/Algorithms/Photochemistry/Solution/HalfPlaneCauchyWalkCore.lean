/--
Unit-circle Jacobi-Anger truncation and clean-ancilla lift certificate for odd walk degree `d`.
Replaces the triangle-inequality `2 * ∑ |c_n|` bound of `CleanWalkCert` with the exact unit-circle
Laurent tail supremum `htail_circle`.
-/
structure CleanWalkCertHalf (d : ℕ) (sMax δ ε_clean : ℝ) where
  odd_d : Odd d
  hd_le : d ≤ kapteynTruncD
  hδ_pos : 0 < δ
  ε_tail : ℝ
  ε_rem : ℝ
  ε_cheb : ℝ
  ε_block : ℝ
  hε_tail0 : 0 ≤ ε_tail
  hε_cheb0 : 0 ≤ ε_cheb
  htail_circle : ∀ {s : ℝ} {z : ℂ}, 0 ≤ s → s ≤ sMax → ‖z‖ = 1 →
    ‖∑ n ∈ Finset.Icc (d + 1) kapteynTruncD,
      jacobiAngerLaurentCoeff kapteynTruncD s n * (z ^ n + conj z ^ n)‖ ≤ ε_tail
  hrem : ∀ {s : ℝ}, 0 ≤ s → s ≤ sMax →
    s ^ (kapteynTruncD + 1) / ((kapteynTruncD + 1).factorial : ℝ) ≤ ε_rem
  hcheb_sum : ε_rem + ε_tail ≤ ε_cheb
  hblock_sum : ε_cheb + ε_cheb + δ ≤ ε_block
  hclean_nn : 0 ≤ ε_clean
  hclean_sq : 2 * ε_block ≤ ε_clean ^ 2

theorem poly_norm_eval_truncLaurentPoly_half_le {K D : ℕ} {s ε_tail ε_rem ε_cheb : ℝ} {z : ℂ}
    (hKD : K ≤ D) (hs0 : 0 ≤ s) (hz : ‖z‖ = 1) (htail_norm : ‖∑ k ∈ Finset.Icc (K + 1) D,
    jacobiAngerLaurentCoeff D s k * (z ^ k + conj z ^ k)‖ ≤ ε_tail)
    (hrem : s ^ (D + 1) / ((D + 1).factorial : ℝ) ≤ ε_rem) (hsum : ε_rem + ε_tail ≤ ε_cheb) :
    ‖(truncLaurentPoly K D s).eval z‖ ≤ 1 + ε_cheb := by
  unfold truncLaurentPoly
  rw [norm_eval_laurentPoly_of_norm_eq_one K _ hz]
  have hfull := norm_eval_jacobiAngerLaurentPoly_le D hs0 hz
  rw [jacobiAngerLaurentPoly, norm_eval_laurentPoly_of_norm_eq_one D _ hz] at hfull
  rw [show jacobiAngerLaurentCoeff D s 0 +
      ∑ k ∈ Finset.Icc 1 K, jacobiAngerLaurentCoeff D s k * (z ^ k + conj z ^ k) =
      (jacobiAngerLaurentCoeff D s 0 +
        ∑ k ∈ Finset.Icc 1 D, jacobiAngerLaurentCoeff D s k * (z ^ k + conj z ^ k)) -
      ∑ k ∈ Finset.Icc (K + 1) D, jacobiAngerLaurentCoeff D s k * (z ^ k + conj z ^ k) by
    rw [show Finset.Icc 1 D = Finset.Icc 1 K ∪ Finset.Icc (K + 1) D from
        Finset.ext fun k ↦ by simp only [Finset.mem_Icc, Finset.mem_union]; omega,
      Finset.sum_union (Finset.disjoint_left.mpr fun k h1 h2 ↦ by
        simp only [Finset.mem_Icc] at h1 h2; omega)]
    abel]
  exact ((norm_sub_le _ _).trans (add_le_add hfull htail_norm)).trans (by linarith)

theorem chebyshevT_conj_diagonal_pair {I : Type*} [Fintype I] [DecidableEq I]
    {U : Matrix I I ℂ} (hU1 : Uᴴ * U = 1) (hU2 : U * Uᴴ = 1) (d : I → ℂ) :
    ∀ k : ℕ,
      chebyshevT k ((U * Matrix.diagonal d) * Uᴴ) =
        (U * Matrix.diagonal (fun i ↦ chebScalarC k (d i))) * Uᴴ ∧
      chebyshevT (k + 1) ((U * Matrix.diagonal d) * Uᴴ) =
        (U * Matrix.diagonal (fun i ↦ chebScalarC (k + 1) (d i))) * Uᴴ
  | 0 => by
      refine ⟨?_, ?_⟩
      · simp [chebyshevT, chebScalarC, Matrix.diagonal_one, hU2]
      · simp [chebyshevT, chebScalarC]
  | k + 1 => by
      obtain ⟨ih0, ih1⟩ :=
          chebyshevT_conj_diagonal_pair hU1 hU2 d k; refine ⟨ih1, ?_⟩; rw [chebyshevT_add_two, ih1,
          ih0]
      have hmul : ((U * Matrix.diagonal d) * Uᴴ) *
          ((U * Matrix.diagonal (fun i ↦ chebScalarC (k + 1) (d i))) * Uᴴ) =
          (U * Matrix.diagonal (fun i ↦ d i * chebScalarC (k + 1) (d i))) * Uᴴ := by
        calc
          ((U * Matrix.diagonal d) * Uᴴ) *
              ((U * Matrix.diagonal (fun i ↦ chebScalarC (k + 1) (d i))) * Uᴴ)
              = U * Matrix.diagonal d * (Uᴴ * U) *
                  Matrix.diagonal (fun i ↦ chebScalarC (k + 1) (d i)) * Uᴴ := by
                simp only [Matrix.mul_assoc]
          _ = U * (Matrix.diagonal d *
                Matrix.diagonal (fun i ↦ chebScalarC (k + 1) (d i))) * Uᴴ := by
                rw [hU1, Matrix.mul_one]; simp only [Matrix.mul_assoc]
          _ = (U * Matrix.diagonal (fun i ↦ d i * chebScalarC (k + 1) (d i))) * Uᴴ := by
            rw [Matrix.diagonal_mul_diagonal]
      rw [hmul]
      have hstep : (fun i ↦ chebScalarC (k + 2) (d i)) = (fun i ↦ (2 : ℂ) *
          (d i * chebScalarC (k + 1) (d i)) - chebScalarC k (d i))
          := by funext i; simp only [chebScalarC]; ring
      rw [hstep]; ext i j;
      simp [Matrix.sub_apply, Matrix.smul_apply, Matrix.mul_apply, Matrix.diagonal_apply,
          Finset.mul_sum, Finset.sum_sub_distrib, mul_sub, sub_mul, smul_eq_mul, mul_assoc,
          mul_left_comm]
theorem sum_smul_conj_diagonal {I : Type*} [Fintype I] [DecidableEq I] (U : Matrix I I ℂ)
    (S : Finset ℕ) (c : ℕ → ℂ) (f : ℕ → I → ℂ) : (∑ k ∈ S, c k • ((U * Matrix.diagonal (f k)) *
    Uᴴ)) = (U * Matrix.diagonal (fun i ↦ ∑ k ∈ S, c k * f k i)) * Uᴴ := by
  induction S using Finset.induction_on with
  | empty =>
      have h0 : Matrix.diagonal (fun _ : I ↦ (0 : ℂ)) = 0 := Matrix.diagonal_zero
      simp [h0]
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, ih]; ext i j;
      simp [Finset.sum_insert ha, Matrix.add_apply, Matrix.smul_apply, Matrix.mul_apply,
          Matrix.diagonal_apply, Finset.mul_sum, Finset.sum_mul, Finset.sum_add_distrib, mul_add,
          add_mul, smul_eq_mul, mul_assoc, mul_left_comm]
theorem poly_opNorm_truncChebApprox_sub_exp_half_le {I : Type*} [Fintype I] [DecidableEq I]
    {K D : ℕ} {H : Matrix I I ℂ} {s ε_tail ε_rem ε_cheb : ℝ} (hKD : K ≤ D) (hH : Hᴴ = H)
    (hnorm : ‖H‖ ≤ 1) (hs0 : 0 ≤ s) (hε_tail0 : 0 ≤ ε_tail) (htail_circle : ∀ {z : ℂ}, ‖z‖ = 1 →
    ‖∑ k ∈ Finset.Icc (K + 1) D, jacobiAngerLaurentCoeff D s k * (z ^ k + conj z ^ k)‖ ≤ ε_tail)
    (hrem : s ^ (D + 1) / ((D + 1).factorial : ℝ) ≤ ε_rem) (hsum : ε_rem + ε_tail ≤ ε_cheb) :
    ‖truncChebApprox K D H s - NormedSpace.exp ((-Complex.I * (s : ℂ)) • H)‖ ≤ ε_cheb := by
  have hsplit_sum : chebyshevPolyApprox H D s - truncChebApprox K D H s =
      ∑ k ∈ Finset.Icc (K + 1) D, jacobiAngerTruncCoeff D s k • chebyshevT k H := by
    unfold chebyshevPolyApprox truncChebApprox
    rw [show Finset.range (D + 1) = Finset.range (K + 1) ∪ Finset.Icc (K + 1) D from
        Finset.ext fun k ↦ by
          simp only [Finset.mem_range, Finset.mem_union, Finset.mem_Icc]; omega,
      Finset.sum_union (Finset.disjoint_left.mpr fun k h1 h2 ↦ by
        simp only [Finset.mem_range, Finset.mem_Icc] at h1 h2; omega)]
    abel
  have him : IsHermitian H := hH
  set U := him.eigenvectorUnitary.1
  set ev := him.eigenvalues
  have hdiag : H = (U * Matrix.diagonal (fun i ↦ (ev i : ℂ))) * Uᴴ := by
    simpa [U, ev, Matrix.star_eq_conjTranspose, Unitary.coe_star, Function.comp_def,
      Matrix.mul_assoc] using him.spectral_theorem
  have hU1 : Uᴴ * U = 1 := by
    simpa only [Matrix.star_eq_conjTranspose] using him.eigenvectorUnitary.2.1
  have hU2 : U * Uᴴ = 1 := by
    simpa only [Matrix.star_eq_conjTranspose] using him.eigenvectorUnitary.2.2
  have hunit : ‖U‖ ≤ 1 := by
    rcases isEmpty_or_nonempty I with _ | _
    · simp [Subsingleton.elim U 0]
    · nlinarith [norm_nonneg U, show ‖U‖ * ‖U‖ = 1 by
        rw [← Matrix.l2_opNorm_conjTranspose_mul_self, hU1, NormOneClass.norm_one]]
  have hev_abs (i : I) : |ev i| ≤ 1 := by
    have hd_norm : ‖Matrix.diagonal (fun j ↦ (ev j : ℂ))‖ ≤ 1 := by
      rw [show Matrix.diagonal (fun j ↦ (ev j : ℂ)) = Uᴴ * H * U by
        rw [hdiag]
        simp only [← Matrix.mul_assoc, hU1, Matrix.one_mul]
        rw [Matrix.mul_assoc, hU1, Matrix.mul_one]]
      have hUH : ‖Uᴴ * H‖ ≤ 1 := ((Matrix.l2_opNorm_mul _ _).trans (by
        rw [Matrix.l2_opNorm_conjTranspose]
        exact mul_le_mul hunit hnorm (norm_nonneg _) zero_le_one)).trans_eq (one_mul 1)
      exact ((Matrix.l2_opNorm_mul _ _).trans
        (mul_le_mul hUH hunit (norm_nonneg _) zero_le_one)).trans_eq (one_mul 1)
    rw [Matrix.l2_opNorm_diagonal] at hd_norm
    simpa only [Complex.norm_real, Real.norm_eq_abs] using
      (norm_le_pi_norm (fun j ↦ (ev j : ℂ)) i).trans hd_norm
  have htail_op : ‖chebyshevPolyApprox H D s - truncChebApprox K D H s‖ ≤ ε_tail := by
    rw [hsplit_sum,
      show (∑ k ∈ Finset.Icc (K + 1) D, jacobiAngerTruncCoeff D s k • chebyshevT k H) =
        (U * Matrix.diagonal (fun i ↦
          ∑ k ∈ Finset.Icc (K + 1) D, jacobiAngerTruncCoeff D s k * chebScalarC k (ev i : ℂ))) *
          Uᴴ by
      conv_lhs =>
        rw [hdiag]
        arg 2
        ext k
        rw [(chebyshevT_conj_diagonal_pair hU1 hU2 (fun i ↦ (ev i : ℂ)) k).1]
      exact sum_smul_conj_diagonal U (Finset.Icc (K + 1) D) (jacobiAngerTruncCoeff D s)
        (fun k i ↦ chebScalarC k (ev i : ℂ))]
    set g : I → ℂ := fun i ↦
      ∑ k ∈ Finset.Icc (K + 1) D, jacobiAngerTruncCoeff D s k * chebScalarC k (ev i : ℂ)
    have hconj_le : ‖(U * Matrix.diagonal g) * Uᴴ‖ ≤ ‖g‖ := by
      have h1 : ‖U * Matrix.diagonal g‖ ≤ ‖g‖ := ((Matrix.l2_opNorm_mul _ _).trans
        (mul_le_mul_of_nonneg_right hunit (norm_nonneg _))).trans_eq
          ((one_mul _).trans (Matrix.l2_opNorm_diagonal g))
      exact ((Matrix.l2_opNorm_mul _ _).trans (by
        rw [Matrix.l2_opNorm_conjTranspose]
        exact mul_le_mul h1 hunit (norm_nonneg _) (norm_nonneg g))).trans_eq (mul_one _)
    refine hconj_le.trans ((pi_norm_le_iff_of_nonneg hε_tail0).mpr fun i ↦ ?_)
    obtain ⟨hlo, hhi⟩ := abs_le.mp (hev_abs i)
    set z : ℂ := Complex.exp (((Real.arccos (ev i)) : ℂ) * Complex.I)
    have hz : ‖z‖ = 1 := Complex.norm_exp_ofReal_mul_I _
    have hz_inv : z⁻¹ = conj z := inv_eq_of_mul_eq_one_right (mul_conj_eq_one_of_norm_eq_one hz)
    have hz_jouk : (z + z⁻¹) / 2 = (ev i : ℂ) := by
      rw [hz_inv, show z = _ from Complex.exp_ofReal_mul_I _, map_add, map_mul,
        Complex.conj_ofReal, Complex.conj_ofReal, Complex.conj_I, Real.cos_arccos hlo hhi]
      ring
    rw [show g i =
        ∑ k ∈ Finset.Icc (K + 1) D, jacobiAngerLaurentCoeff D s k * (z ^ k + conj z ^ k) from
      Finset.sum_congr rfl fun k hk ↦ by
        obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 :=
          ⟨k - 1, (Nat.sub_add_cancel ((Nat.le_add_left 1 K).trans (Finset.mem_Icc.mp hk).1)).symm⟩
        rw [← hz_jouk,
          (select_chebScalarC_joukowsky_pair (Complex.exp_ne_zero _) (m + 1)).1,
          hz_inv]
        simp only [jacobiAngerLaurentCoeff]
        ring]
    exact htail_circle hz
  rw [show truncChebApprox K D H s - NormedSpace.exp ((-Complex.I * (s : ℂ)) • H) =
      (chebyshevPolyApprox H D s - NormedSpace.exp ((-Complex.I * (s : ℂ)) • H)) -
      (chebyshevPolyApprox H D s - truncChebApprox K D H s) by abel]
  exact ((norm_sub_le _ _).trans (add_le_add
    ((opNorm_chebyshevPolyApprox_sub_exp_le_of_norm_le_one hH hnorm D hs0).trans hrem)
    htail_op)).trans hsum

