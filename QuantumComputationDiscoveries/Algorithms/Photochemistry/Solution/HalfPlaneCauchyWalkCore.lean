theorem poolSum_mapTok22 (emb : Fin 22 → Wire 304) (ps : List DToken) (γ : BitAssignment 304) :
    poolSum (ps.map (mapTok22 emb)) γ = poolSumLocal22 ps (fun u ↦ γ (emb u)) := by
  induction ps with
  | nil => rfl
  | cons t ts ih =>
    rcases t with ⟨col, ws, inv⟩
    have htok : tokBit (mapTok22 emb (col, ws, inv)) γ = tokBitLocal22 (col, ws, inv)
        (fun u ↦ γ (emb u)) := by
      dsimp only [mapTok22, tokBit, tokBitLocal22]; congr 1
      induction ws with
      | nil => rfl
      | cons s ss ihw =>
        dsimp only [List.map, List.foldr]
        have hw : w304 (emb ⟨s % 22, Nat.mod_lt _ (by decide)⟩).val =
            emb ⟨s % 22, Nat.mod_lt _ (by decide)⟩ := Fin.ext (Nat.mod_eq_of_lt (emb _).isLt)
        rw [hw, ihw]
    change (tokBit (mapTok22 emb (col, ws, inv)) γ).val * 2 ^ col +
        poolSum (ts.map (mapTok22 emb)) γ = (tokBitLocal22 (col, ws, inv) (fun u ↦ γ (emb u))).val *
        2 ^ col + poolSumLocal22 ts (fun u ↦ γ (emb u))
    rw [htok, ih]

