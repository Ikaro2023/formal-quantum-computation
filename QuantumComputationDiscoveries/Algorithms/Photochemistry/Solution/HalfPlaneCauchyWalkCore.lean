def unld76ExpPermCols : List ℕ :=
  (List.range 30).map (fun idxS ↦ (unld76MixedCols512.getD idxS 0) <<< 512)

def unld76FullCT110 : CT :=
  loadCols 110 0 (unld76OutCols80 ++ unld76ExpPermCols) (.leaf 0)

theorem getCT_unld76FullCT110 (u : ℕ) (hu : u < 110) :
    getCT 7 unld76FullCT110 u =
      if u < 80 then getCT 7 unld76RawOutCT80 u else unld76ExpPermCols.getD (u - 80) 0 := by
  unfold unld76FullCT110
  rw [getCT_loadCols 110 0 _ u (by decide) (by omega)]
  have hlen80 : unld76OutCols80.length = 80 := by decide +kernel
  simp only [show 0 ≤ u ∧ u < 0 + 110 by omega, and_self, ↓reduceIte, Nat.sub_zero,
      List.getD_eq_getElem?_getD]
  by_cases h80 : u < 80
  · simp only [h80, ↓reduceIte,
        List.getElem?_append_left (by omega : u < unld76OutCols80.length),
        ← List.getD_eq_getElem?_getD]
    exact Nat.eq_of_beq_eq_true ((List.all_eq_true.mp unld76OutCols80_chk) u (List.mem_range.mpr
        h80))
  · simp only [h80, ↓reduceIte,
        List.getElem?_append_right (by omega : unld76OutCols80.length ≤ u), hlen80]

