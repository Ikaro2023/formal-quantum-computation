theorem bxor_tri_raw (c a b : Bool) : xor (xor c a) b = xor (xor c (xor a c)) (xor b c) := by
  cases c <;> cases a <;> cases b <;> rfl
theorem band_bxor (c a b : Bool) : (c && xor a b) = xor (c && a) (c && b) := by
  cases c <;> cases a <;> cases b <;> rfl
theorem bxor_quad (a b c d : Bool) : xor (xor a b) (xor c d) = xor (xor a c) (xor b d) := by
  cases a <;> cases b <;> cases c <;> cases d <;> rfl

