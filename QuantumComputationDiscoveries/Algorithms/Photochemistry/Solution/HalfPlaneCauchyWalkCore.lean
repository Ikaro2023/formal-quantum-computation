  refine (sq_le_sq₀ (abs_nonneg _) (by positivity)).mpr ?_
  unfold dist16Num
  split_ifs with hs
  · rw [abs_of_nonpos
        (by linarith [show ((s.val : ℤ) : ℝ) ≤ 13 by exact_mod_cast (by omega : (s.val : ℤ) ≤ 13)]),
      show ((16 * (13 - s.val) + b.val + 1 : ℕ) : ℝ) = 16 * (13 - ((s.val : ℤ) : ℝ)) +
          ((b.val + 1 : ℕ) : ℝ) by
        push_cast [Nat.cast_sub hs]
        ring]
    linarith
  · rw [abs_of_nonneg
        (by linarith [show (14 : ℝ) ≤
              ((s.val : ℤ) : ℝ) by exact_mod_cast (by omega : (14 : ℤ) ≤ s.val)]),
      show ((16 * (s.val - 13) - b.val : ℕ) : ℝ) = 16 * (((s.val : ℤ) : ℝ) - 13) - (b.val : ℝ) by
        rw [Nat.cast_sub (by omega : b.val ≤ 16 * (s.val - 13))]
        push_cast [Nat.cast_sub (by omega : 13 ≤ s.val)]
        ring]
    linarith
