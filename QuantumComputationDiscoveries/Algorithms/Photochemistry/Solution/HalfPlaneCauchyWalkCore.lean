          by_cases hu85 : u < 85
          · rw [eq_of_beq (allLt_spec hSub94_lo u hu85), hMatchIn85_i u hu85]
          · rw [buildSub94CT_ge87 in85CT prep85CT u (31 * kp + 1 + i)
