theorem zmod2_ite_add_ite (b1 b2 : Bool) : ((if b1 then (1 : ZMod 2) else 0) +
    (if b2 then (1 : ZMod 2) else 0)) = if xor b1 b2 then 1 else 0 := by
  cases b1 <;> cases b2 <;> decide

theorem ite_zmod2_congr {a b : Bool} (h : a = b) : (if a then (1 : ZMod 2) else 0) =
    (if b then 1 else 0) := by subst h; rfl
def outPost24 : Fin 24 → Fin 33 := fun j ↦ ⟨9 + j.val, by omega⟩

def rYCar24Of {n : ℕ} (rYHi33 : QRegister 33 n) : QRegister 24 n :=
  ⟨⟨fun j ↦ rYHi33 ⟨9 + j.val, by omega⟩, fun a b e ↦ Fin.ext (by
    have hv := congrArg Fin.val (rYHi33.wires.injective e)
    dsimp at hv; omega)⟩⟩

def rYPiv9Of {n : ℕ} (rYHi33 : QRegister 33 n) : QRegister 9 n :=
  ⟨⟨fun p ↦ rYHi33 ⟨p.val, by omega⟩, fun a b e ↦ Fin.ext (by
    have hv := congrArg Fin.val (rYHi33.wires.injective e)
    dsimp at hv; omega)⟩⟩

theorem stepCB_writeReg_comm {w1 w2 N : ℕ} (r1 : QRegister w1 N) (r2 : QRegister w2 N)
    (hDisj : r1.DisjointWires r2) (f : BitAssignment w1 → BitAssignment w1) (β : BitAssignment N)
    (vals : Fin w2 → ZMod 2) : stepCB r1 f (writeReg β r2 vals) =
    writeReg (stepCB r1 f β) r2 vals := by
  funext w
  have hfEq : (fun k ↦ writeReg β r2 vals (r1 k)) = (fun k ↦ β (r1 k)) :=
    funext fun k ↦ writeReg_apply_of_not_mem _ _ _ _ (fun ⟨j, hj⟩ ↦ disj_ne hDisj k j hj.symm)
  by_cases hw2 : ∃ j : Fin w2, r2 j = w
  · obtain ⟨j, rfl⟩ := hw2; rw [writeReg_apply_reg]; unfold stepCB
    rw [writeReg_apply_of_not_mem _ _ _ _ (fun ⟨i, hi⟩ ↦ disj_ne hDisj i j hi), writeReg_apply_reg]
  · rw [writeReg_apply_of_not_mem _ _ _ _ hw2]; unfold stepCB
    by_cases hw1 : ∃ i : Fin w1, r1 i = w
    · obtain ⟨i, rfl⟩ := hw1; rw [writeReg_apply_reg, writeReg_apply_reg, hfEq]
    · rw [writeReg_apply_of_not_mem _ _ _ _ hw1, writeReg_apply_of_not_mem _ _ _ _ hw1,
          writeReg_apply_of_not_mem _ _ _ _ hw2]

theorem stepCB_apply_disj {w1 N : ℕ} (r1 : QRegister w1 N) (f : BitAssignment w1 → BitAssignment w1)
    (β : BitAssignment N) (w : Wire N) (hw : ¬∃ i : Fin w1, r1 i = w) : stepCB r1 f β w = β w := by
  unfold stepCB; exact writeReg_apply_of_not_mem _ _ _ _ hw

/-! ### 2. `31`-Scratch Subregisters, `6-T` `pBfRouter6_31`, & `34-T` `pStep2bScr31` -/

theorem rScr31_ne {n : ℕ} (rScr31 : QRegister 31 n) {i j : Fin 31} (h : i ≠ j) : rScr31 i ≠
    rScr31 j := fun e ↦ h (rScr31.wires.injective e)
def keep22ScrIdx (k : Fin 22) : Fin 31 :=
  ⟨keep22Idx k.val - 39, by have := k.isLt; unfold keep22Idx; split_ifs <;> omega⟩

def early6ScrIdx (e : Fin 6) : Fin 31 :=
  ⟨early6Idx e.val - 39, by have := e.isLt; unfold early6Idx; split_ifs <;> omega⟩

theorem keep22ScrIdx_inj : Function.Injective keep22ScrIdx := by intro a b h; revert a b h; decide
theorem early6ScrIdx_inj : Function.Injective early6ScrIdx := by intro a b h; revert a b h; decide
theorem keep22_ne_early6_scr (k : Fin 22) (e : Fin 6) : keep22ScrIdx k ≠ early6ScrIdx e := by
  revert k e; decide

theorem keep22_ne_scr0 (k : Fin 22) : keep22ScrIdx k ≠ ⟨0, by decide⟩ := by
  revert k; decide

theorem keep22_ne_scr29 (k : Fin 22) : keep22ScrIdx k ≠ ⟨29, by decide⟩ := by
  revert k; decide

theorem keep22_ne_scr30 (k : Fin 22) : keep22ScrIdx k ≠ ⟨30, by decide⟩ := by
  revert k; decide

theorem early6_ne_scr0 (e : Fin 6) : early6ScrIdx e ≠ ⟨0, by decide⟩ := by
  revert e; decide

theorem early6_ne_scr29 (e : Fin 6) : early6ScrIdx e ≠ ⟨29, by decide⟩ := by
  revert e; decide

theorem early6_ne_scr30 (e : Fin 6) : early6ScrIdx e ≠ ⟨30, by decide⟩ := by
  revert e; decide

abbrev bfOut6_31 {n : ℕ} (rScr31 : QRegister 31 n) (e : Fin 6) : Wire n := rScr31 (early6ScrIdx e)
theorem wRouterDisj_bf6_31 {n : ℕ} {rBasis9 : QRegister 9 n} {rCopy30 : QRegister 30 n}
    {rScr31 : QRegister 31 n} {rYHi33 : QRegister 33 n}
    (hBS : rBasis9.DisjointWires rScr31) (hCS : rCopy30.DisjointWires rScr31)
    (hBY : rBasis9.DisjointWires rYHi33) (hCY : rCopy30.DisjointWires rYHi33)
    (hSY : rScr31.DisjointWires rYHi33) :
    WRouterDisj (rScr31 ⟨0, by decide⟩) (bfIdx3 rBasis9 rCopy30) (bfOut6_31 rScr31)
      (rYHi33 ⟨0, by decide⟩) where
  has_ne_out e := rScr31_ne rScr31 (early6_ne_scr0 e).symm
  has_ne_q := disj_ne hSY _ _
  idx_ne_out d _ := by fin_cases d <;> first | exact disj_ne hCS _ _ | exact disj_ne hBS _ _
  idx_ne_q d := by fin_cases d <;> first | exact disj_ne hCY _ _ | exact disj_ne hBY _ _
  out_inj _ _ hij := rScr31_ne rScr31 fun eqIdx ↦ hij (early6ScrIdx_inj eqIdx)
  out_ne_q _ := disj_ne hSY _ _

def cBfGatherA01_31 {n : ℕ} (rScr31 : QRegister 31 n) : Circuit n :=
  Circuit.CNOT (bfOut6_31 rScr31 ⟨3, by decide⟩) (rScr31 ⟨29, by decide⟩)
    (rScr31_ne rScr31 (early6_ne_scr29 ⟨3, by decide⟩)) ;;ᶜ
  Circuit.CNOT (bfOut6_31 rScr31 ⟨5, by decide⟩) (rScr31 ⟨30, by decide⟩)
    (rScr31_ne rScr31 (early6_ne_scr30 ⟨5, by decide⟩))

theorem count_cBfGatherA01_31 {n : ℕ} (rScr31 : QRegister 31 n) :
    (cBfGatherA01_31 rScr31).count .T = 0 ∧ (cBfGatherA01_31 rScr31).count .TOFF = 0 := by
  simp [cBfGatherA01_31, Circuit.count_seq, Circuit.CNOT]
theorem cBfGatherA01_31_mulVec_ket {n : ℕ} (rScr31 : QRegister 31 n) (η : BitAssignment n) :
    (cBfGatherA01_31 rScr31).eval.1.mulVec (ket η) =
      ket (Function.update
        (Function.update η (rScr31 ⟨29, by decide⟩)
          (η (rScr31 ⟨29, by decide⟩) + η (bfOut6_31 rScr31 ⟨3, by decide⟩)))
        (rScr31 ⟨30, by decide⟩)
        (η (rScr31 ⟨30, by decide⟩) + η (bfOut6_31 rScr31 ⟨5, by decide⟩))) := by
  dsimp only [cBfGatherA01_31]; rw [eval_seq_mulVec, ket_CNOT, ket_CNOT]
  have n5_29 : bfOut6_31 rScr31 ⟨5, by decide⟩ ≠ rScr31 ⟨29, by decide⟩ :=
    rScr31_ne rScr31 (early6_ne_scr29 ⟨5, by decide⟩)
  have n30_29 : rScr31 ⟨30, by decide⟩ ≠ rScr31 ⟨29, by decide⟩ := rScr31_ne rScr31 (by decide)
  simp only [Function.update_of_ne n5_29, Function.update_of_ne n30_29]

def pBfRouter6_31 {Var : Type} {n : ℕ} (v : Var) (rBasis9 : QRegister 9 n)
    (rCopy30 : QRegister 30 n) (rScr31 : QRegister 31 n) (rYHi33 : QRegister 33 n) :
    DynamicCircuit Var n :=
  .seq (.circuit (Circuit.X (rScr31 ⟨0, by decide⟩)))
    (.seq ((wRouterBracket3x2k 1).wrap v (rScr31 ⟨0, by decide⟩)
            (bfIdx3 rBasis9 rCopy30) (bfOut6_31 rScr31) (rYHi33 ⟨0, by decide⟩)
            (.circuit (cBfGatherA01_31 rScr31)))
      (.circuit (Circuit.X (rScr31 ⟨0, by decide⟩))))

theorem pBfRouter6_31_counts_wires {Var : Type} {n : ℕ} {S : Wire n → Prop} (v : Var)
    (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n) (rScr31 : QRegister 31 n)
    (rYHi33 : QRegister 33 n) (hrB : ∀ i, S (rBasis9 i)) (hrC : ∀ j, S (rCopy30 j))
    (hrS : ∀ u, S (rScr31 u)) (hrY : ∀ b, S (rYHi33 b)) :
    (pBfRouter6_31 v rBasis9 rCopy30 rScr31 rYHi33).count .T = 6 ∧
    (pBfRouter6_31 v rBasis9 rCopy30 rScr31 rYHi33).count .TOFF = 0 ∧
    DynWires S (pBfRouter6_31 v rBasis9 rCopy30 rScr31 rYHi33) := by
  let pG : DynamicCircuit Var n := .circuit (cBfGatherA01_31 rScr31)
  obtain ⟨tW, fW⟩ := (wRouterBracket3x2k 1).count_wrap v (rScr31 ⟨0, by decide⟩)
    (bfIdx3 rBasis9 rCopy30) (bfOut6_31 rScr31) (rYHi33 ⟨0, by decide⟩) pG
  obtain ⟨tG, fG⟩ := count_cBfGatherA01_31 rScr31
  have hIdxS : ∀ d, S (bfIdx3 rBasis9 rCopy30 d) := fun d ↦ by
    fin_cases d <;> [exact hrC _; exact hrB _; exact hrB _]
  have cwG : CircWires S (cBfGatherA01_31 rScr31) :=
      ⟨cw_cnot (hrS _) (hrS _), cw_cnot (hrS _) (hrS _)⟩
  have dwW := (wRouterBracket3x2k 1).dynWires_wrap v (rScr31 ⟨0, by decide⟩)
    (bfIdx3 rBasis9 rCopy30) (bfOut6_31 rScr31) (rYHi33 ⟨0, by decide⟩) pG
    (hrS _) hIdxS (fun _ ↦ hrS _) (hrY _) cwG
  unfold pBfRouter6_31; refine ⟨?_, ?_, ⟨cw_1 (hrS _), dwW, cw_1 (hrS _)⟩⟩
  · dsimp only [DynamicCircuit.count, pG] at tW ⊢
    rw [tW, tG]; simp [Circuit.X]
  · dsimp only [DynamicCircuit.count, pG] at fW ⊢
    rw [fW, fG]; simp [Circuit.X]

theorem subspaceStep_pBfRouter6_31 {Var : Type} [Fintype Var] [DecidableEq Var]
    {W n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rWork : QRegister W n)
    (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n)
    (rScr31 : QRegister 31 n) (rYHi33 : QRegister 33 n)
    (hBS : rBasis9.DisjointWires rScr31) (hCS : rCopy30.DisjointWires rScr31)
    (hBY : rBasis9.DisjointWires rYHi33) (hCY : rCopy30.DisjointWires rYHi33)
    (hSY : rScr31.DisjointWires rYHi33)
    (stP : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (hz0 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → stP δ (rScr31 ⟨0, by decide⟩) = 0)
    (hzY0 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → stP δ (rYHi33 ⟨0, by decide⟩) = 0)
    (hz29 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → stP δ (rScr31 ⟨29, by decide⟩) = 0)
    (hz30 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → stP δ (rScr31 ⟨30, by decide⟩) = 0)
    (hzOut6 : ∀ δ (e : Fin 6), (∀ k : Fin W, δ (rWork k) = 0) → stP δ (bfOut6_31 rScr31 e) = 0)
    (hNotBoth : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) →
      ¬(stP δ (rBasis9 ⟨0, by decide⟩) = 1 ∧ stP δ (rBasis9 ⟨8, by decide⟩) = 1)) :
    SubspaceStep (mkKetOpW rWork stP ph)
      (mkKetOpW rWork (fun δ ↦
        Function.update
          (Function.update (stP δ) (rScr31 ⟨29, by decide⟩)
            (stP δ (rBasis9 ⟨0, by decide⟩) * stP δ (rCopy30 ⟨2, by decide⟩)))
          (rScr31 ⟨30, by decide⟩)
          (stP δ (rBasis9 ⟨8, by decide⟩) * stP δ (rCopy30 ⟨2, by decide⟩))) ph)
      (pBfRouter6_31 v rBasis9 rCopy30 rScr31 rYHi33) := by
  let wHas := rScr31 ⟨0, by decide⟩
  let qEnc := rYHi33 ⟨0, by decide⟩
  let wIdx := bfIdx3 rBasis9 rCopy30
  let wOut6 := bfOut6_31 rScr31
  let hd := wRouterDisj_bf6_31 hBS hCS hBY hCY hSY
  let stOut : BitAssignment n → BitAssignment n := fun δ ↦
      Function.update (Function.update (stP δ) (rScr31 ⟨29, by decide⟩)
    (stP δ (rBasis9 ⟨0, by decide⟩) * stP δ (rCopy30 ⟨2, by decide⟩))) (rScr31 ⟨30, by decide⟩)
        (stP δ (rBasis9 ⟨8, by decide⟩) * stP δ (rCopy30 ⟨2, by decide⟩))
  let stIn1 : BitAssignment n → BitAssignment n := fun δ ↦ Function.update (stP δ) wHas 1
  let stOut1 : BitAssignment n → BitAssignment n := fun δ ↦ Function.update (stOut δ) wHas 1
  have hne29_0 : rScr31 ⟨29, by decide⟩ ≠ wHas := rScr31_ne rScr31 (by decide)
  have hne30_0 : rScr31 ⟨30, by decide⟩ ≠ wHas := rScr31_ne rScr31 (by decide)
  have hne30_29 : rScr31 ⟨30, by decide⟩ ≠ rScr31 ⟨29, by decide⟩ := rScr31_ne rScr31 (by decide)
  have hsX (s1 s2 : BitAssignment n → BitAssignment n) (hEq : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) →
      Function.update (s1 δ) wHas (s1 δ wHas + 1) = s2 δ) :
      SubspaceStep (Var := Var) (mkKetOpW rWork s1 ph) (mkKetOpW rWork s2 ph)
          (.circuit (Circuit.X wHas)) := by
    refine subspaceStep_congr_out (subspaceStep_of_circuit (Var := Var) _ (Circuit.X wHas))
        (matrix_ext_ket fun δ ↦ ?_)
    rw [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, ket_X, hEq δ hz]
    · rw [Matrix.mulVec_zero]
  have hsPreX := hsX stP stIn1 fun δ hz ↦
      congrArg (Function.update (stP δ) wHas) ((congrArg (· + 1) (hz0 δ hz)).trans (zero_add 1))
  have hIdx_in : ∀ δ, idxValD wIdx (stIn1 δ) =
      (((0 + if stP δ (rCopy30 ⟨2, by decide⟩) = 1 then 2 ^ 0 else 0) +
      if stP δ (rBasis9 ⟨0, by decide⟩) = 1 then 2 ^ 1 else 0) + if stP δ (rBasis9 ⟨8, by decide⟩) =
          1 then 2 ^ 2 else 0) := fun δ ↦ by
    dsimp only [idxValD, idxValPrefix, wIdx, bfIdx3, stIn1]
    rw [Function.update_of_ne (disj_ne hCS _ _), Function.update_of_ne (disj_ne hBS _ _),
        Function.update_of_ne (disj_ne hBS _ _)]
  have hIdx_eq : ∀ δ, idxValD wIdx (stOut1 δ) = idxValD wIdx (stIn1 δ) := fun δ ↦ by
    dsimp only [idxValD, idxValPrefix, wIdx, bfIdx3, stOut1, stOut]
    rw [Function.update_of_ne (disj_ne hCS _ _), Function.update_of_ne (disj_ne hCS _ _),
        Function.update_of_ne (disj_ne hCS _ _),
        Function.update_of_ne (disj_ne hBS _ _), Function.update_of_ne (disj_ne hBS _ _),
            Function.update_of_ne (disj_ne hBS _ _),
        Function.update_of_ne (disj_ne hBS _ _), Function.update_of_ne (disj_ne hBS _ _),
            Function.update_of_ne (disj_ne hBS _ _)]
    exact (hIdx_in δ).symm
  have hOut6_in : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → ∀ e : Fin 6, stIn1 δ (wOut6 e) = 0 :=
    fun δ hz e ↦ (Function.update_of_ne (hd.has_ne_out e).symm _ _).trans (hzOut6 δ e hz)
  have hOut6_out : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → ∀ e : Fin 6, stOut1 δ (wOut6 e) = 0 :=
      fun δ hz e ↦ by
    dsimp only [stOut1, stOut]
    rw [Function.update_of_ne (hd.has_ne_out e).symm,
        Function.update_of_ne (rScr31_ne rScr31 (early6_ne_scr30 e)),
        Function.update_of_ne (rScr31_ne rScr31 (early6_ne_scr29 e)), hzOut6 δ e hz]
  have hSuppIn : SupportedOn (ValidWRouterIn wHas wIdx wOut6 qEnc) (mkKetOpW rWork stIn1 ph) :=
    supportedOn_mkKetOpW_bf rWork stIn1 ph fun δ hz ↦
        ⟨hOut6_in δ hz, (Function.update_of_ne hd.has_ne_q.symm _ _).trans (hzY0 δ hz),
      (hIdx_in δ).symm ▸ (z2_bf6_oneHot _ _ _ (hNotBoth δ hz)).1, fun h0 ↦
          absurd ((Function.update_self wHas 1 _).symm.trans h0) one_ne_zero⟩
  have hSuppOut : SupportedOn (ValidWRouterClean wHas wIdx wOut6) (mkKetOpW rWork stOut1 ph) :=
    supportedOn_mkKetOpW_bf rWork stOut1 ph fun δ hz ↦
        ⟨hOut6_out δ hz, (hIdx_eq δ).trans (hIdx_in δ) ▸ (z2_bf6_oneHot _ _ _ (hNotBoth δ hz)).1,
      fun h0 ↦ absurd ((Function.update_self wHas 1 _).symm.trans h0) one_ne_zero⟩
  have hsMid : SubspaceStep (Var := Var)
      ((uOneHotToggle wHas wIdx wOut6 hd.has_ne_out hd.idx_ne_out).1 * mkKetOpW rWork stIn1 ph)
      ((uOneHotToggle wHas wIdx wOut6 hd.has_ne_out hd.idx_ne_out).1 * mkKetOpW rWork stOut1 ph)
          (.circuit (cBfGatherA01_31 rScr31)) := by
    refine subspaceStep_congr_out (subspaceStep_of_circuit (Var := Var) _ (cBfGatherA01_31 rScr31))
        (matrix_ext_ket fun δ ↦ ?_)
    simp only [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, Matrix.mulVec_smul, Matrix.mulVec_smul, uOneHotToggle_mulVec_ket,
          uOneHotToggle_mulVec_ket, cBfGatherA01_31_mulVec_ket]
      refine congrArg (_ • ·) (congrArg ket (funext fun w ↦ ?_))
      set η := toggleOneHotBits wHas wIdx wOut6 (stIn1 δ)
      set ηO := toggleOneHotBits wHas wIdx wOut6 (stOut1 δ)
      obtain ⟨hLt6, hG3, hG5⟩ :=
          z2_bf6_oneHot (stP δ (rCopy30 ⟨2, by decide⟩)) (stP δ (rBasis9 ⟨0, by decide⟩))
          (stP δ (rBasis9 ⟨8, by decide⟩)) (hNotBoth δ hz)
      have hLtIn : idxValD wIdx (stIn1 δ) < 6 := (hIdx_in δ).symm ▸ hLt6
      have hwHasIn : stIn1 δ wHas = 1 := Function.update_self wHas 1 _
      have hwHasOut : stOut1 δ wHas = 1 := Function.update_self wHas 1 _
      have hηOut6 : ∀ j : Fin 6, η (wOut6 j) = if idxValD wIdx (stIn1 δ) = j.val then 1 else 0 :=
        fun j ↦
            (toggleOneHotBits_apply_out hd.out_inj (hOut6_in δ hz) hLtIn j).trans (by rw [hwHasIn])
      by_cases hw30 : w = rScr31 ⟨30, by decide⟩
      · subst hw30
        rw [Function.update_self, show η (bfOut6_31 rScr31 ⟨5, by decide⟩) = _ from hηOut6 ⟨5,
            by decide⟩]
        dsimp only [η, ηO]
        rw [toggleOneHotBits_apply_other (stIn1 δ)
            (fun e ↦ rScr31_ne rScr31 (early6_ne_scr30 e).symm),
            toggleOneHotBits_apply_other (stOut1 δ)
                (fun e ↦ rScr31_ne rScr31 (early6_ne_scr30 e).symm)]
        dsimp only [stIn1, stOut1, stOut]
        rw [Function.update_of_ne hne30_0, Function.update_of_ne hne30_0, Function.update_self,
            hz30 δ hz, hIdx_in δ, hG5]
      · rw [Function.update_of_ne hw30]
        by_cases hw29 : w = rScr31 ⟨29, by decide⟩
        · subst hw29
          rw [Function.update_self, show η (bfOut6_31 rScr31 ⟨3, by decide⟩) = _ from hηOut6 ⟨3,
              by decide⟩]
          dsimp only [η, ηO]
          rw [toggleOneHotBits_apply_other (stIn1 δ)
              (fun e ↦ rScr31_ne rScr31 (early6_ne_scr29 e).symm),
              toggleOneHotBits_apply_other (stOut1 δ)
                  (fun e ↦ rScr31_ne rScr31 (early6_ne_scr29 e).symm)]
          dsimp only [stIn1, stOut1, stOut]
          rw [Function.update_of_ne hne29_0, Function.update_of_ne hne29_0,
              Function.update_of_ne hne30_29.symm, Function.update_self, hz29 δ hz, hIdx_in δ, hG3]
        · rw [Function.update_of_ne hw29]
          by_cases hwO : ∃ j : Fin 6, w = wOut6 j
          · obtain ⟨j, rfl⟩ := hwO
            exact (hηOut6 j).trans ((toggleOneHotBits_apply_out hd.out_inj (hOut6_out δ hz)
                ((hIdx_eq δ).symm ▸ hLtIn) j).trans
              (by rw [hwHasOut, hIdx_eq δ])).symm
          · dsimp only [η, ηO]
            rw [toggleOneHotBits_apply_other (stIn1 δ) (fun j e ↦ hwO ⟨j, e⟩),
                toggleOneHotBits_apply_other (stOut1 δ) (fun j e ↦ hwO ⟨j, e⟩)]
            by_cases hwh : w = wHas
            · exact hwh ▸ hwHasIn.trans hwHasOut.symm
            · dsimp only [stIn1, stOut1, stOut]
              rw [Function.update_of_ne hwh, Function.update_of_ne hwh, Function.update_of_ne hw30,
                  Function.update_of_ne hw29]
    · rw [Matrix.mulVec_zero, Matrix.mulVec_zero]
  have hsPostX := hsX stOut1 stOut fun δ hz ↦ funext fun w ↦ by
    by_cases hwh : w = wHas
    · subst hwh
      dsimp only [stOut1, stOut]
      rw [Function.update_self, Function.update_self, Function.update_of_ne hne30_0.symm,
          Function.update_of_ne hne29_0.symm, hz0 δ hz]
      decide
    · exact (Function.update_of_ne hwh _ _).trans (Function.update_of_ne hwh _ _)
  exact subspaceStep_seq_u hsPreX (subspaceStep_seq_u ((wRouterBracket3x2k 1).subspaceStep_wrap v
    wHas wIdx wOut6 qEnc hd (.circuit (cBfGatherA01_31 rScr31)) (mkKetOpW rWork stIn1 ph)
    (mkKetOpW rWork stOut1 ph) hSuppIn hSuppOut hsMid) hsPostX)

/-! ### Subregisters `rU68Of`, `rI85Of`, `rTail94Of`, `rUnc96Of`, `rA01_31Of`, `rP33_31Of` -/

def fU68 {n : ℕ} (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n) (rScr31 : QRegister 31 n)
    (u : Fin 68) : Wire n :=
  if hu9 : u.val < 9 then rBasis9 ⟨u.val, hu9⟩
  else if hu39 : u.val < 39 then rCopy30 ⟨u.val - 9, by omega⟩
  else rScr31 ⟨u.val - 39, by omega⟩

def rU68Of {n : ℕ} (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n) (rScr31 : QRegister 31 n)
    (hBC : rBasis9.DisjointWires rCopy30) (hBS : rBasis9.DisjointWires rScr31)
    (hCS : rCopy30.DisjointWires rScr31) : QRegister 68 n :=
  ⟨⟨fU68 rBasis9 rCopy30 rScr31, fun a b e ↦ Fin.ext (by
    dsimp only [fU68] at e
    by_cases ha9 : a.val < 9 <;> by_cases hb9 : b.val < 9 <;> simp only [ha9, hb9, ↓reduceDIte] at e
    · have hv := congrArg Fin.val (rBasis9.wires.injective e); dsimp at hv; omega
    · split_ifs at e <;> [exact absurd e (disj_ne hBC _ _); exact absurd e (disj_ne hBS _ _)]
    · split_ifs at e <;>
          [exact absurd e.symm (disj_ne hBC _ _); exact absurd e.symm (disj_ne hBS _ _)]
    · by_cases ha39 : a.val < 39 <;> by_cases hb39 : b.val < 39 <;> simp only [ha39, hb39,
          ↓reduceDIte] at e
      · have hv := congrArg Fin.val (rCopy30.wires.injective e); dsimp at hv; omega
      · exact absurd e (disj_ne hCS _ _)
      · exact absurd e.symm (disj_ne hCS _ _)
      · have hv := congrArg Fin.val (rScr31.wires.injective e); dsimp at hv; omega)⟩⟩

theorem u68_disj_yHi33 {n : ℕ} {rBasis9 : QRegister 9 n} {rCopy30 : QRegister 30 n}
    {rScr31 : QRegister 31 n} {rYHi33 : QRegister 33 n} (hBC : rBasis9.DisjointWires rCopy30)
    (hBS : rBasis9.DisjointWires rScr31) (hCS : rCopy30.DisjointWires rScr31)
    (hBY : rBasis9.DisjointWires rYHi33) (hCY : rCopy30.DisjointWires rYHi33)
    (hSY : rScr31.DisjointWires rYHi33) :
    (rU68Of rBasis9 rCopy30 rScr31 hBC hBS hCS).DisjointWires rYHi33 :=
  disj_of_ne fun u b e ↦ by
    change fU68 rBasis9 rCopy30 rScr31 u = rYHi33 b at e; dsimp only [fU68] at e
    split_ifs at e <;> [exact disj_ne hBY _ _ e; exact disj_ne hCY _ _ e; exact disj_ne hSY _ _ e]

theorem u68_disj_yCar24 {n : ℕ} {rBasis9 : QRegister 9 n} {rCopy30 : QRegister 30 n}
    {rScr31 : QRegister 31 n} {rYHi33 : QRegister 33 n} (hBC : rBasis9.DisjointWires rCopy30)
    (hBS : rBasis9.DisjointWires rScr31) (hCS : rCopy30.DisjointWires rScr31)
    (hBY : rBasis9.DisjointWires rYHi33) (hCY : rCopy30.DisjointWires rYHi33)
    (hSY : rScr31.DisjointWires rYHi33) :
    (rU68Of rBasis9 rCopy30 rScr31 hBC hBS hCS).DisjointWires (rYCar24Of rYHi33) :=
  disj_of_ne fun u j e ↦
    disj_ne (u68_disj_yHi33 hBC hBS hCS hBY hCY hSY) u ⟨9 + j.val, by omega⟩ e

def fI85 {n : ℕ} (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n) (rYHi33 : QRegister 33 n)
    (rScr31 : QRegister 31 n) (u : Fin 85) : Wire n :=
  if hu9 : u.val < 9 then rBasis9 ⟨u.val, hu9⟩
  else if hu39 : u.val < 39 then rCopy30 ⟨u.val - 9, by omega⟩
  else if hu63 : u.val < 63 then rYHi33 ⟨9 + (u.val - 39), by omega⟩
  else rScr31 (keep22ScrIdx ⟨u.val - 63, by omega⟩)

def rI85Of {n : ℕ} (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n) (rYHi33 : QRegister 33 n)
    (rScr31 : QRegister 31 n) (hBC : rBasis9.DisjointWires rCopy30)
    (hBS : rBasis9.DisjointWires rScr31) (hCS : rCopy30.DisjointWires rScr31)
    (hBY : rBasis9.DisjointWires rYHi33) (hCY : rCopy30.DisjointWires rYHi33)
    (hSY : rScr31.DisjointWires rYHi33) : QRegister 85 n :=
  ⟨⟨fI85 rBasis9 rCopy30 rYHi33 rScr31, fun a b e ↦ Fin.ext (by
    dsimp only [fI85] at e
    by_cases ha9 : a.val < 9 <;> by_cases hb9 : b.val < 9 <;> simp only [ha9, hb9, ↓reduceDIte] at e
    · have hv := congrArg Fin.val (rBasis9.wires.injective e); dsimp at hv; omega
    · split_ifs at e <;>
          [exact absurd e (disj_ne hBC _ _); exact absurd e (disj_ne hBY _ _); exact absurd e
          (disj_ne hBS _ _)]
    · split_ifs at e <;>
          [exact absurd e.symm (disj_ne hBC _ _); exact absurd e.symm (disj_ne hBY _ _); exact
          absurd e.symm (disj_ne hBS _ _)]
    · by_cases ha39 : a.val < 39 <;> by_cases hb39 : b.val < 39 <;> simp only [ha39, hb39,
          ↓reduceDIte] at e
      · have hv := congrArg Fin.val (rCopy30.wires.injective e); dsimp at hv; omega
      · split_ifs at e <;> [exact absurd e (disj_ne hCY _ _); exact absurd e (disj_ne hCS _ _)]
      · split_ifs at e <;>
            [exact absurd e.symm (disj_ne hCY _ _); exact absurd e.symm (disj_ne hCS _ _)]
      · by_cases ha63 : a.val < 63 <;> by_cases hb63 : b.val < 63 <;> simp only [ha63, hb63,
            ↓reduceDIte] at e
        · have hv := congrArg Fin.val (rYHi33.wires.injective e); dsimp at hv; omega
        · exact absurd e.symm (disj_ne hSY _ _)
        · exact absurd e (disj_ne hSY _ _)
        · have hk :=
              congrArg Fin.val (keep22ScrIdx_inj (rScr31.wires.injective e)); dsimp at hk; omega)⟩⟩

def fTail94 {n : ℕ} (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n) (rYHi33 : QRegister 33 n)
    (rScr31 : QRegister 31 n) (u : Fin 94) : Wire n :=
  if hu85 : u.val < 85 then fI85 rBasis9 rCopy30 rYHi33 rScr31 ⟨u.val, hu85⟩
  else if hu87 : u.val < 87 then rScr31 ⟨29 + (u.val - 85), by omega⟩
  else if hu88 : u.val < 88 then rScr31 ⟨0, by decide⟩
  else bfOut6_31 rScr31 ⟨u.val - 88, by omega⟩

theorem fI85_ne_scr_tail {n : ℕ} {rBasis9 : QRegister 9 n} {rCopy30 : QRegister 30 n}
    {rYHi33 : QRegister 33 n} {rScr31 : QRegister 31 n}
    (hBS : rBasis9.DisjointWires rScr31) (hCS : rCopy30.DisjointWires rScr31)
    (hSY : rScr31.DisjointWires rYHi33)
    (u : Fin 85) (s : Fin 31)
    (hs : s = ⟨0, by decide⟩ ∨ s = ⟨29, by decide⟩ ∨ s = ⟨30, by decide⟩ ∨ ∃ e : Fin 6, s =
        early6ScrIdx e) :
    fI85 rBasis9 rCopy30 rYHi33 rScr31 u ≠ rScr31 s := by
  dsimp only [fI85]
  split_ifs with h1 h2 h3
  · exact disj_ne hBS _ _
  · exact disj_ne hCS _ _
  · exact fun eqW ↦ disj_ne hSY _ _ eqW.symm
  · intro eqW; have hIdx := rScr31.wires.injective eqW
    rcases hs with rfl | rfl | rfl | ⟨e, rfl⟩
    · exact keep22_ne_scr0 _ hIdx
    · exact keep22_ne_scr29 _ hIdx
    · exact keep22_ne_scr30 _ hIdx
    · exact keep22_ne_early6_scr _ e hIdx

def rTail94Of {n : ℕ} (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n) (rYHi33 : QRegister 33 n)
    (rScr31 : QRegister 31 n) (hBC : rBasis9.DisjointWires rCopy30)
    (hBS : rBasis9.DisjointWires rScr31) (hCS : rCopy30.DisjointWires rScr31)
    (hBY : rBasis9.DisjointWires rYHi33) (hCY : rCopy30.DisjointWires rYHi33)
    (hSY : rScr31.DisjointWires rYHi33) : QRegister 94 n :=
  let rI85 := rI85Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY
  ⟨⟨fTail94 rBasis9 rCopy30 rYHi33 rScr31, fun a b e ↦ Fin.ext (by
    dsimp only [fTail94] at e
    have hRhs (z : Fin 94) (hz : ¬ z.val < 85) :
        ∃ s : Fin 31, (if hz87 : z.val < 87 then rScr31 ⟨29 + (z.val - 85), by omega⟩
          else if hz88 : z.val < 88 then rScr31 ⟨0, by decide⟩
          else bfOut6_31 rScr31 ⟨z.val - 88, by omega⟩) = rScr31 s ∧
          (s = ⟨0, by decide⟩ ∨ s = ⟨29, by decide⟩ ∨ s = ⟨30, by decide⟩ ∨ ∃ j : Fin 6, s =
              early6ScrIdx j) := by
      by_cases hz87 : z.val < 87
      · refine ⟨⟨29 + (z.val - 85), by omega⟩, by simp [hz87], ?_⟩
        by_cases h85 : z.val = 85
        · right; left; ext; dsimp; omega
        · right; right; left; ext; dsimp; omega
      · by_cases hz88 : z.val < 88
        · exact ⟨⟨0, by decide⟩, by simp [hz87, hz88], Or.inl rfl⟩
        · exact ⟨early6ScrIdx ⟨z.val - 88, by omega⟩, by simp [hz87, hz88, bfOut6_31],
              Or.inr (Or.inr (Or.inr ⟨_, rfl⟩))⟩
    by_cases ha85 : a.val < 85 <;> by_cases hb85 : b.val < 85 <;> simp only [ha85, hb85,
        ↓reduceDIte] at e
    · have hv := congrArg Fin.val (rI85.wires.injective e); dsimp at hv; exact hv
    · obtain ⟨s, hsEq, hsProp⟩ :=
          hRhs b hb85; exact absurd (e.trans hsEq)
          (fI85_ne_scr_tail hBS hCS hSY ⟨a.val, ha85⟩ s hsProp)
    · obtain ⟨s, hsEq, hsProp⟩ :=
          hRhs a ha85; exact absurd (e.symm.trans hsEq)
          (fI85_ne_scr_tail hBS hCS hSY ⟨b.val, hb85⟩ s hsProp)
    · by_cases ha87 : a.val < 87 <;> by_cases hb87 : b.val < 87 <;> simp only [ha87, hb87,
          ↓reduceDIte] at e
      · have hv := congrArg Fin.val (rScr31.wires.injective e); dsimp at hv; omega
      · split_ifs at e with hb88
        · have hv := congrArg Fin.val (rScr31.wires.injective e); dsimp at hv; omega
        · have hIdx := rScr31.wires.injective e
          by_cases ha85' : a.val = 85
          · exact absurd (hIdx.symm.trans (Fin.ext (by dsimp; omega))) (early6_ne_scr29 _)
          · exact absurd (hIdx.symm.trans (Fin.ext (by dsimp; omega))) (early6_ne_scr30 _)
      · split_ifs at e with ha88
        · have hv := congrArg Fin.val (rScr31.wires.injective e); dsimp at hv; omega
        · have hIdx := rScr31.wires.injective e
          by_cases hb85' : b.val = 85
          · exact absurd (hIdx.trans (Fin.ext (by dsimp; omega))) (early6_ne_scr29 _)
          · exact absurd (hIdx.trans (Fin.ext (by dsimp; omega))) (early6_ne_scr30 _)
      · by_cases ha88 : a.val < 88 <;> by_cases hb88 : b.val < 88 <;> simp only [ha88, hb88,
            ↓reduceDIte] at e
