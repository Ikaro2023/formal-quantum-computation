      rYHi33); obtain ⟨tR6, fR6, dwR6⟩ :=
      pBfRouter6_31_counts_wires v rBasis9 rCopy30 rScr31 rYHi33 hrB hrC hrS hrY; obtain ⟨tTail,
      fTail⟩ := count_bennettXorReg v rT94 cpTail outPiv9_94 rYPiv hDisjPiv; obtain ⟨tUnc, fUnc⟩ :=
