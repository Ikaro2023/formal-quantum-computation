  let in33CT := buildIn33CT tail94CT
  let outPost := evalStrict 32 uni72Mx in33CT postTree_0_k9
  checkBf31DirectBody initCT out1 out2r keep22CT in85CT prep85CT sub94CT tail94CT in96CT unc96CT
      in33CT outPost

theorem cert_bf31Direct : checkBf31Direct = true := by decide +kernel

