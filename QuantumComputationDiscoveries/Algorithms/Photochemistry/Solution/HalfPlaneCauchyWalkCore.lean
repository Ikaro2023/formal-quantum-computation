theorem stepCB_apply_reg {K n : ℕ} (r : QRegister K n) (f : BitAssignment K → BitAssignment K)
    (β : BitAssignment n) (u : Wire K) : stepCB r f β (r u) = f (fun v ↦ β (r v)) u := by
