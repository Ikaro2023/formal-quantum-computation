    have hMatchIn96_i (u) (hu : u < 96) :
        (getCT 7 in96CT u).testBit (31 * kp + 1 + i) = (in96Val31 c0 (1 <<< i)).testBit u := by
      rw [in96Val31_testBit c0 (1 <<< i) u hc0_512]
