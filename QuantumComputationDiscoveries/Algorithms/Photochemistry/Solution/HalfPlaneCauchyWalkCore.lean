  have hmid : pKara22.fwdBits (mkIn22 m) = bitsOfNT5 midT m.val := by
    rw [hin]
    exact fwdBits_bitsOfNT5 (by decide) ones512 m.val (ones512_testBit m) pKara22 initNT5_22
        initNT5_22_wf
