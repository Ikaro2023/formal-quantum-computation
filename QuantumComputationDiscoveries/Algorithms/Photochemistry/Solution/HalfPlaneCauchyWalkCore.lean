    let out := (ComputeProg.seq pSplitR2Equiv22 pFormD22).fwdBits mid
    mid ⟨8, by decide⟩ = 1 + inp ⟨0, by decide⟩ ∧
    mid ⟨10, by decide⟩ = inp ⟨0, by decide⟩ * inp ⟨1, by decide⟩ ∧
    mid ⟨11, by decide⟩ = 0 ∧
    mid ⟨12, by decide⟩ = 0 ∧
    mid ⟨0, by decide⟩ = inp ⟨0, by decide⟩ ∧
    mid ⟨1, by decide⟩ = inp ⟨1, by decide⟩ ∧
    (∀ i : Fin 8, out ⟨i.val, by omega⟩ = inp ⟨i.val, by omega⟩) ∧
    out ⟨9, by decide⟩ = inp ⟨9, by decide⟩ ∧
    out ⟨10, by decide⟩ * (1 + out ⟨13, by decide⟩) = 0 ∧
    poolSumLocal22 r2LocalPool31 out = 4 + poolSumLocal22 initLocalPool37 inp := by
  have hcert :=
      checkKaraR2_512_cert; dsimp only [checkKaraR2_512_cert_bool] at hcert; rw [initNT5_22_cps_eq,
      evalGatesNT5CPS_eq, evalGatesNT5CPS_eq, ← evalProgNT5_pKara22_eq ones512,
      ← evalProgNT5_postKara22_eq ones512] at hcert; simp only [Bool.and_eq_true,
      beq_iff_eq] at hcert; obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨hm8, hm10⟩, hm11⟩, hm12⟩, hm0⟩, hm1⟩, ho_lo8⟩, ho9⟩,
