    have hsp := esI 32 (by decide) postTree_0_k9 in33CT _ hMatchIn33_i b2.val b2.isLt
    have hBi := eq_of_beq (allLt_spec hBiAll b2.val b2.isLt)
    unfold yFinalBit
    by_cases hb9 : b2.val < 9
    · simp only [hb9, decide_true, ↓reduceIte] at hBi ⊢
      exact (hsTail_i b2.val hb9).symm.trans hBi
    · simp only [hb9, decide_false, Bool.false_eq_true, ↓reduceIte] at hBi ⊢
