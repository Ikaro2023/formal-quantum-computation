def isRawBelowGate (B c : ℕ) : Bool :=
    decide ((c >>> 2) % 512 < B) && decide ((c >>> 11) % 512 < B) && decide ((c >>> 20) % 512 < B)
def isRawBelowTree (B : ℕ) : PrimTree → Bool
  | .empty => true
  | .leaf c => isRawBelowGate B c
  | .node l r => isRawBelowTree B l && isRawBelowTree B r

theorem evalPrimGate_rawBelow {B M1 M2 s c : ℕ} (h1 : B ≤ M1 + 1) (h2 : B ≤ M2 + 1)
    (hG : isRawBelowGate B c = true) : evalPrimGate M1 s c = evalPrimGate M2 s c := by
  simp only [isRawBelowGate, Bool.and_eq_true, decide_eq_true_eq] at hG
  have eqm {x : ℕ} (hx : x < B) : x % (M1 + 1) = x % (M2 + 1) :=
      (Nat.mod_eq_of_lt (by omega)).trans (Nat.mod_eq_of_lt (by omega)).symm
  unfold evalPrimGate
  dsimp only
  rw [eqm hG.1.1, eqm hG.1.2, eqm hG.2]
theorem evalPrimTree_rawBelow {B M1 M2 : ℕ} (h1 : B ≤ M1 + 1) (h2 : B ≤ M2 + 1) :
    ∀ {t : PrimTree} (s : ℕ), isRawBelowTree B t = true →
      evalPrimTree M1 s t = evalPrimTree M2 s t
  | .empty, _, _ => rfl
  | .leaf c, s, h => evalPrimGate_rawBelow h1 h2 h
  | .node l r, s, h => by
      rcases Bool.and_eq_true_iff.mp h with ⟨hL, hR⟩
      dsimp only [evalPrimTree]; rw [evalPrimTree_rawBelow h1 h2 s hL];
      exact evalPrimTree_rawBelow h1 h2 _ hR
def isDisjMaskGate (M mask c : ℕ) : Bool :=
    decide (mask.testBit (((c >>> 2) % 512) % (M + 1)) = false) &&
    decide (mask.testBit (((c >>> 11) % 512) % (M + 1)) = false) &&
    decide (mask.testBit (((c >>> 20) % 512) % (M + 1)) = false)
def isDisjMaskTree (M mask : ℕ) : PrimTree → Bool
  | .empty => true
  | .leaf c => isDisjMaskGate M mask c
  | .node l r => isDisjMaskTree M mask l && isDisjMaskTree M mask r

theorem evalPrimGate_disjMask {M mask s c u : ℕ} (hG : isDisjMaskGate M mask c = true)
    (hu : mask.testBit u = true) : (evalPrimGate M s c).testBit u = s.testBit u := by
  dsimp only [isDisjMaskGate] at hG
  rcases Bool.and_eq_true_iff.mp hG with ⟨h12, h3⟩
  rcases Bool.and_eq_true_iff.mp h12 with ⟨h1, h2⟩
  simp only [decide_eq_true_eq] at h1 h2 h3
  unfold evalPrimGate; dsimp only
  have hsh (w : ℕ) (hw : mask.testBit w = false) : (1 <<< w).testBit u = false := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
    simp only [decide_eq_false_iff_not]; intro e; subst e; rw [hw] at hu; exact Bool.noConfusion hu
  split_ifs <;> simp [Nat.testBit_xor, hsh _ h1, hsh _ h2, hsh _ h3]

theorem evalPrimTree_disjMask {M mask u : ℕ} (hu : mask.testBit u = true) :
    ∀ {t : PrimTree} {s : ℕ}, isDisjMaskTree M mask t = true →
      (evalPrimTree M s t).testBit u = s.testBit u
  | .empty, _, _ => rfl
  | .leaf c, _, h => evalPrimGate_disjMask h hu
  | .node l r, s, h => by
      rcases Bool.and_eq_true_iff.mp h with ⟨hL, hR⟩
      dsimp only [evalPrimTree]; rw [evalPrimTree_disjMask hu hR, evalPrimTree_disjMask hu hL]

