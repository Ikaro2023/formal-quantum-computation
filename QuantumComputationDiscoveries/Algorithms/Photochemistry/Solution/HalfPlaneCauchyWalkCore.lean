      ((getCT 7 sub94CT 86).testBit qi == a1i) &&
      allLt 85 (fun u ↦ (getCT 7 in96CT u).testBit qi == (getCT 7 in85CT u).testBit qi) &&
      allLt 9 (fun p ↦ (getCT 7 in96CT (85 + p)).testBit qi == (getCT 7 tail94CT (9 +
          p)).testBit qi) &&
