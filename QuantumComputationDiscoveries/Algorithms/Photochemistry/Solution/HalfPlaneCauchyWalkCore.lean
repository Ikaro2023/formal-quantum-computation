def pullBackAx2Sha : ComputeProg 304 → ComputeProg 30
  | .id => .id
  | .x u => .x (f304ToAx2Sha u)
  | .cnot c t _ => safeCnotCP (f304ToAx2Sha c) (f304ToAx2Sha t)
  | .andGate c1 c2 a _ _ _ => safeAndGateCP (f304ToAx2Sha c1) (f304ToAx2Sha c2) (f304ToAx2Sha a)
  | .seq p q => .seq (pullBackAx2Sha p) (pullBackAx2Sha q)

def projAx2Sha (γ : BitAssignment 304) : BitAssignment 30 := fun u ↦ γ (fAx2ShaTo304 u)

def patchAx2Sha (γ : BitAssignment 304) (δ : BitAssignment 30) : BitAssignment 304 := fun w ↦
    if _hw : ActiveAx2ShaProp w.val then δ (f304ToAx2Sha w) else γ w
theorem patchAx2Sha_pos {w : Wire 304} (hw : ActiveAx2ShaProp w.val) (γ : BitAssignment 304)
    (δ : BitAssignment 30) : patchAx2Sha γ δ w = δ (f304ToAx2Sha w) := by
  dsimp only [patchAx2Sha]; exact leg_dif_pos hw
theorem patchAx2Sha_neg {w : Wire 304} (hw : ¬ActiveAx2ShaProp w.val) (γ : BitAssignment 304)
    (δ : BitAssignment 30) : patchAx2Sha γ δ w = γ w := by
  dsimp only [patchAx2Sha]; exact leg_dif_neg hw
theorem patchAx2Sha_projAx2Sha (γ : BitAssignment 304) : patchAx2Sha γ (projAx2Sha γ) = γ := by
  funext w
  by_cases hw : ActiveAx2ShaProp w.val
  · rw [patchAx2Sha_pos hw]; dsimp only [projAx2Sha]; rw [fAx2Sha_f304_id hw]
  · exact patchAx2Sha_neg hw γ (projAx2Sha γ)

theorem pullBackAx2Sha_fwdBits (p : ComputeProg 304) (ha : activeInAx2Sha p = true)
    (γ : BitAssignment 304) (δ : BitAssignment 30) :
    p.fwdBits (patchAx2Sha γ δ) = patchAx2Sha γ ((pullBackAx2Sha p).fwdBits δ) :=
        pullBack_gen_fwdBits ActiveAx2ShaProp okW304_Ax2Sha activeInAx2Sha fAx2ShaTo304
    f304ToAx2Sha pullBackAx2Sha γ (patchAx2Sha γ) (fun n h ↦ activeWireAx2Sha_of_bool (n := n) h)
    (fun _ ↦ rfl) (fun _ _ _ ↦ rfl) (fun _ _ _ _ _ _ ↦ rfl) (fun _ _ ↦ rfl)
    rfl (fun _ ↦ rfl) (fun _ _ _ ↦ rfl) (fun _ _ _ _ _ _ ↦ rfl) (fun _ _ ↦ rfl)
    (fun w hw d ↦ patchAx2Sha_pos (w := w) hw γ d) (fun w hw d ↦ patchAx2Sha_neg (w := w) hw γ d)
    (fun w hw ↦ fAx2Sha_f304_id (w := w) hw) p ha δ
def tokBitAx2Sha (t : DToken) (δ : BitAssignment 30) : ZMod 2 :=
    (if t.2.2 then 1 else 0) + t.2.1.foldr (fun s acc ↦ δ (f304ToAx2Sha (w304 s)) + acc) 0
def poolSumAx2Sha (ps : List DToken) (δ : BitAssignment 30) : ℕ :=
    ps.foldr (fun t acc ↦ (tokBitAx2Sha t δ).val * 2 ^ t.1 + acc) 0
def tokInAx2Sha (t : DToken) : Bool := t.2.1.all fun s ↦ okW304_Ax2Sha (w304 s).val

theorem tokBit_patchAx2Sha {t : DToken} (ht : tokInAx2Sha t = true) (γ : BitAssignment 304)
    (δ : BitAssignment 30) : tokBit t (patchAx2Sha γ δ) = tokBitAx2Sha t δ := by
  rcases t with ⟨col, ws, inv⟩
  dsimp only [tokInAx2Sha] at ht; dsimp only [tokBit, tokBitAx2Sha]; congr 1
  induction ws with
  | nil => rfl
  | cons s ss ih =>
      simp only [List.all_cons, Bool.and_eq_true] at ht; dsimp only [List.foldr];
      rw [patchAx2Sha_pos (activeWireAx2Sha_of_bool ht.1), ih ht.2]
theorem poolSum_patchAx2Sha {ps : List DToken} (hps : ps.all tokInAx2Sha = true)
    (γ : BitAssignment 304) (δ : BitAssignment 30) : poolSum ps (patchAx2Sha γ δ) =
    poolSumAx2Sha ps δ := by
  induction ps with
  | nil => rfl
  | cons t ts ih =>
      simp only [List.all_cons, Bool.and_eq_true] at hps;
      change (tokBit t (patchAx2Sha γ δ)).val * 2 ^ t.1 + poolSum ts (patchAx2Sha γ δ) =
          (tokBitAx2Sha t δ).val * 2 ^ t.1 + poolSumAx2Sha ts δ; rw [tokBit_patchAx2Sha hps.1 γ δ,
          ih hps.2]
def tokMaskNT5Ax2Sha (ones : ℕ) (tok : DToken) (t : NTree5) : ℕ :=
  let m0 := cond tok.2.2 ones 0
  tok.2.1.foldr (fun s acc ↦
    let v := (getNT5 5 t (f304ToAx2ShaNat s)) ^^^ acc
    cond (v == 0) 0 v) m0

def poolWordsNT5Ax2Sha (ones : ℕ) (ps : List DToken) (t : NTree5) : List ℕ :=
    ps.foldr (fun tok acc ↦ addMaskAt tok.1 (tokMaskNT5Ax2Sha ones tok t) acc) []
theorem tokMaskNT5Ax2Sha_eq (ones m : ℕ) (hones : ones.testBit m = true) {tok : DToken}
    (ht : tokWiresLt304 tok = true) (t : NTree5) : cond ((tokMaskNT5Ax2Sha ones tok t).testBit m)
    (1 : ZMod 2) 0 = tokBitAx2Sha tok (bitsOfNT5 t m) := by
  rcases tok with ⟨_, ws, inv⟩
  have hws (l : List ℕ) (hl : (l.all fun s ↦ Nat.blt s 304) = true) (base : ℕ) :
      cond ((l.foldr (fun s acc ↦ let v := (getNT5 5 t (f304ToAx2ShaNat s)) ^^^ acc
        cond (v == 0) 0 v) base).testBit m) (1 : ZMod 2) 0 =
      l.foldr (fun s acc ↦ bitsOfNT5 (M := 30) t m (f304ToAx2Sha (w304 s)) + acc) 0 +
        cond (base.testBit m) 1 0 := by
    induction l with
    | nil => simp
    | cons s ss ih =>
      simp only [List.all_cons, Bool.and_eq_true] at hl
      dsimp only [List.foldr]
      rw [cond_zero_eq, Nat.testBit_xor, zmod2_cond_xor, ih hl.2, f304ToAx2ShaNat_eq hl.1]
      dsimp only [bitsOfNT5]
      rw [← add_assoc]
  dsimp only [tokMaskNT5Ax2Sha, tokBitAx2Sha]
  rw [hws ws ht (cond inv ones 0), add_comm]
  exact congrArg (· + _) (by cases inv <;> simp [hones])

theorem poolWordsNT5Ax2Sha_eval (ones m : ℕ) (hones : ones.testBit m = true) {ps : List DToken}
    (hps : ps.all tokWiresLt304 = true) (t : NTree5) : evalWords (poolWordsNT5Ax2Sha ones ps t) m =
    poolSumAx2Sha ps (bitsOfNT5 t m) := by
  induction ps with
  | nil => rfl
  | cons tok ts ih =>
      simp only [List.all_cons, Bool.and_eq_true] at hps;
      change evalWords (addMaskAt tok.1 (tokMaskNT5Ax2Sha ones tok t)
          (poolWordsNT5Ax2Sha ones ts t)) m = (tokBitAx2Sha tok (bitsOfNT5 t m)).val * 2 ^ tok.1 +
          poolSumAx2Sha ts (bitsOfNT5 t m); rw [evalWords_addMaskAt,
          ← tokMaskNT5Ax2Sha_eq ones m hones hps.1 t, zmod2_cond_val, ih hps.2]
def mkIn30 (m : Fin 512) : BitAssignment 30 := fun u ↦
    if h : u.val < 22 then mkIn22 m ⟨u.val, h⟩ else 0
theorem getNT5_initNT5_30_ge22 {u : ℕ} (hge : ¬(u < 22)) (hlt : u < 30) : getNT5 5 initNT5_22 u =
    0 := by
  have hchk : initNT5_22_cps (fun t ↦
      (List.range 30).all fun u' ↦
          Nat.blt u' 22 || (getNT5 5 t u' == 0)) = true := by decide +kernel
  rw [initNT5_22_cps_eq] at hchk; have hu := (List.all_eq_true.mp hchk) u (List.mem_range.mpr hlt)
  have hnb : Nat.blt u 22 = false := Bool.eq_false_iff.mpr fun hb ↦ hge (Nat.blt_eq.mp hb)
  rw [hnb, Bool.false_or] at hu; exact beq_iff_eq.mp hu
theorem mkIn30_eq_bitsOfNT5 (m : Fin 512) :
    mkIn30 m = bitsOfNT5 (M := 30) initNT5_22 m.val := by
  funext u; dsimp only [mkIn30]
  by_cases h22 : u.val < 22
  · rw [leg_dif_pos h22]; exact congrFun (mkIn22_eq_bitsOfNT5 m) ⟨u.val, h22⟩
  · rw [leg_dif_neg h22]; dsimp only [bitsOfNT5]
    rw [getNT5_initNT5_30_ge22 h22 u.isLt, Nat.zero_testBit]; rfl

theorem poolSumAx2Sha_255_eq :
    poolSumAx2Sha (axTokens 2) (mkIn30 ⟨255, by decide⟩) = 87380 := by
  decide +kernel

def code9Ax2Sha (γ : BitAssignment 304) : Fin 512 :=
    ⟨finBitsVal (fun k : Fin 9 ↦ if _h : k.val < 8 then γ (w304 (40 + k.val)) else γ (w304 75)),
    finBitsVal_lt _⟩
theorem projAx2Sha_eq_mkIn30 (γb : BitAssignment 304) (h49 : γb (w304 49) = 0)
    (h76 : γb (w304 76) = γb (w304 40) * γb (w304 41)) (h78 : γb (w304 78) = 0)
    (hcl : ∀ w : Wire 304, 100 ≤ w.val → w.val < 118 → γb w = 0) :
    projAx2Sha γb = mkIn30 (code9Ax2Sha γb) := by
  let f9 (k : Fin 9) : ZMod 2 :=
    if _h : k.val < 8 then γb (w304 (40 + k.val)) else γb (w304 75)
  have hbit (k : Fin 9) : f9 k = if (code9Ax2Sha γb).val.testBit k.val then 1 else 0 :=
    finBitsVal_testBit f9 k
  have h10 : projAx2Sha γb ⟨10, by decide⟩ = mkIn30 (code9Ax2Sha γb) ⟨10, by decide⟩ :=
    h76.trans (congrArg₂ (· * ·) (hbit ⟨0, by decide⟩) (hbit ⟨1, by decide⟩))
  have hlo (u : Wire 30) : u.val < 8 → fAx2ShaTo304 u = w304 (40 + u.val) := by
    fin_cases u <;> decide
  funext u
  by_cases hu8 : u.val < 8
  · have hb := hbit ⟨u.val, by omega⟩
    dsimp only [f9, projAx2Sha, mkIn30, mkIn22] at hb ⊢
    rw [leg_dif_pos hu8] at hb
    rw [leg_dif_pos (by omega), leg_if_pos hu8, hlo u hu8]
    exact hb
  · fin_cases u <;> dsimp only [Fin.val_mk] at hu8 ⊢ <;> first
      | omega | exact h49 | exact h78 | exact hcl _ (by decide) (by decide)
      | simpa [projAx2Sha, fAx2ShaTo304, mkIn30, mkIn22, f9] using hbit ⟨8, by decide⟩

attribute [local semireducible] StructuredCB.validProgMask StructuredCB.finalCleanMask

def f189To304 : Wire 189 → Wire 304 := fun u ↦
  if u.val < 48 then ⟨u.val, by omega⟩ else ⟨u.val + 1, by omega⟩

def f304To189 : Wire 304 → Wire 189 := fun w ↦
  if _hw : w.val < 48 then ⟨w.val, by omega⟩
  else if _hw2 : 49 ≤ w.val ∧ w.val < 190 then ⟨w.val - 1, by omega⟩
  else ⟨0, by omega⟩

def okW304_189 (n : ℕ) : Bool := Nat.blt n 48 || (Nat.ble 49 n && Nat.blt n 190)

def activeIn189 : ComputeProg 304 → Bool
  | .id => true
  | .x u => okW304_189 u.val
  | .cnot c t _ => okW304_189 c.val && okW304_189 t.val
  | .andGate c1 c2 a _ _ _ => okW304_189 c1.val && okW304_189 c2.val && okW304_189 a.val
  | .seq p q => activeIn189 p && activeIn189 q

def stepActive1_189 : List (ComputeProg 304) → Option (List (ComputeProg 304))
  | [] => some []
  | .id :: rest => some rest
  | .x u :: rest => if okW304_189 u.val then some rest else none
  | .cnot c t _ :: rest => if okW304_189 c.val && okW304_189 t.val then some rest else none
  | .andGate c1 c2 a _ _ _ :: rest =>
      if okW304_189 c1.val && okW304_189 c2.val && okW304_189 a.val then some rest else none
  | .seq p q :: rest => some (p :: q :: rest)

def stepActivePow_189 : ℕ → List (ComputeProg 304) → Option (List (ComputeProg 304))
  | 0, ws => stepActive1_189 ws
  | d + 1, ws => match stepActivePow_189 d ws with
    | none => none
    | some ws' => stepActivePow_189 d ws'

theorem stepActive1_189_sound {ws ws' : List (ComputeProg 304)} (h : stepActive1_189 ws = some ws')
    (hall : ∀ q ∈ ws', activeIn189 q = true) :
    ∀ q ∈ ws, activeIn189 q = true :=
  stepActive1_gen_sound rfl (fun _ ↦ rfl) (fun _ _ _ ↦ rfl) (fun _ _ _ _ _ _ ↦ rfl)
    (fun _ _ ↦ rfl) (fun _ ↦ rfl) (fun _ _ ↦ rfl) (fun _ _ _ _ ↦ rfl)
    (fun _ _ _ _ _ _ _ ↦ rfl) (fun _ _ _ ↦ rfl) h hall

theorem stepActivePow_189_sound :
    ∀ (d : ℕ) {ws ws' : List (ComputeProg 304)},
      stepActivePow_189 d ws = some ws' → (∀ q ∈ ws', activeIn189 q = true) → ∀ q ∈ ws,
          activeIn189 q = true :=
  stepActivePow_gen_sound stepActive1_189_sound (fun _ ↦ rfl) (fun _ _ ↦ rfl)

def pullBack189 : ComputeProg 304 → ComputeProg 189
  | .id => .id
  | .x u => .x (f304To189 u)
  | .cnot c t _ => safeCnotCP (f304To189 c) (f304To189 t)
  | .andGate c1 c2 a _ _ _ => safeAndGateCP (f304To189 c1) (f304To189 c2) (f304To189 a)
  | .seq p q => .seq (pullBack189 p) (pullBack189 q)

theorem activeWire189_of_bool {n : ℕ} (h : okW304_189 n = true) : n < 48 ∨ (49 ≤ n ∧ n < 190) := by
  dsimp only [okW304_189] at h
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq] at h; exact h

theorem f189_f304_id {w : Wire 304} (hw : w.val < 48 ∨ (49 ≤ w.val ∧ w.val < 190)) :
    f189To304 (f304To189 w) = w := by
  dsimp only [f189To304, f304To189]
  rcases hw with h1 | ⟨h2, h3⟩
  · rw [leg_dif_pos h1, leg_if_pos h1]
