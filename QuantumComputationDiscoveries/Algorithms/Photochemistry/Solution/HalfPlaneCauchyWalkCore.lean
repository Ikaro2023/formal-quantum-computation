theorem subspaceStep_pStep2bScr31 {Var : Type} [Fintype Var] [DecidableEq Var]
    {W n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rWork : QRegister W n)
    (rBasis9 : QRegister 9 n) (rCopy30 : QRegister 30 n)
    (rScr31 : QRegister 31 n) (rYHi33 : QRegister 33 n)
    (hBC : rBasis9.DisjointWires rCopy30) (hBS : rBasis9.DisjointWires rScr31)
    (hCS : rCopy30.DisjointWires rScr31)
    (hBY : rBasis9.DisjointWires rYHi33) (hCY : rCopy30.DisjointWires rYHi33)
    (hSY : rScr31.DisjointWires rYHi33)
    (stWMid : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (x32Fn kpFn : BitAssignment n → ℕ)
    (hx32 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → x32Fn δ < 2 ^ 32)
    (hkpLe : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → kpFn δ ≤ 9)
    (hScr0 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → stWMid δ (rScr31 ⟨0, by decide⟩) = 0)
    (hScr29 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → stWMid δ (rScr31 ⟨29, by decide⟩) = 0)
    (hScr30 : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → stWMid δ (rScr31 ⟨30, by decide⟩) = 0)
    (hEarly0 : ∀ δ (e : Fin 6), (∀ k : Fin W, δ (rWork k) = 0) → stWMid δ (bfOut6_31 rScr31 e) = 0)
    (hPiv0 : ∀ δ (p : Fin 9), (∀ k : Fin W, δ (rWork k) = 0) → stWMid δ (rYPiv9Of rYHi33 p) = 0)
    (hI85Nat : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) →
      natOfZModBits 85 (fun u ↦
        stWMid δ (rI85Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY u)) =
        in85Val (kpBasis9Code (kpFn δ)) ((x32Fn δ) >>> 2)) :
    SubspaceStep (mkKetOpW rWork stWMid ph)
      (mkKetOpW rWork (fun δ ↦ writeReg (stWMid δ) (rYPiv9Of rYHi33)
        (fun p ↦ if pivBit (kpBasis9Code (kpFn δ)) ((x32Fn δ) >>> 2) p.val then 1 else 0)) ph)
      (pStep2bScr31 v rBasis9 rCopy30 rScr31 rYHi33 hBC hBS hCS hBY hCY hSY) := by
  let rI85 := rI85Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY
  let rT94 := rTail94Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY
  let rYPiv := rYPiv9Of rYHi33
  let hDisjPiv := tail94_disj_yPiv9 hBC hBS hCS hBY hCY hSY
  let rU96 := rUnc96Of rBasis9 rCopy30 rYHi33 rScr31 hBC hBS hCS hBY hCY hSY
  let rA01 := rA01_31Of rScr31
  let hDisjA01 := unc96_disj_a01_31 hBC hBS hCS hBY hCY hSY
  let cpPrep := decodePrimTree 84 bf31Prep85Tree
  have hrI85_ne_piv (u : Fin 85) (p : Fin 9) : rI85 u ≠ rYPiv p := fun e ↦
    disj_ne hDisjPiv ⟨u.val, by omega⟩ p <| (show rT94 ⟨u.val, by omega⟩ = rI85 u by
      change fTail94 rBasis9 rCopy30 rYHi33 rScr31 ⟨u.val, by omega⟩ = _
      exact ditePos u.isLt).trans e
  have hrI85_ne_scr : ∀ (u : Fin 85) (s : Fin 31),
      (s = ⟨0, by decide⟩ ∨ s = ⟨29, by decide⟩ ∨ s = ⟨30, by decide⟩ ∨ ∃ e : Fin 6, s =
          early6ScrIdx e) → rI85 u ≠ rScr31 s :=
    fun u s hs ↦ fI85_ne_scr_tail hBS hCS hSY u s hs
  set stP := fun δ ↦ stepCB rI85 cpPrep.fwdBits (stWMid δ)
  set stAfterW6 : BitAssignment n → BitAssignment n := fun δ ↦
      Function.update (Function.update (stWMid δ) (rScr31 ⟨29, by decide⟩)
    (if a0Bit31 (kpBasis9Code (kpFn δ)) ((x32Fn δ) >>> 2) then 1 else 0)) (rScr31 ⟨30, by decide⟩)
        (if a1PreBit31 (kpBasis9Code (kpFn δ)) ((x32Fn δ) >>> 2) then 1 else 0)
  have hPrepBit (δ : BitAssignment n) (u : Fin 85) (hz : ∀ k : Fin W, δ (rWork k) = 0) :
      stP δ (rI85 u) = if (evalPrimTree 84 (in85Val (kpBasis9Code (kpFn δ))
          ((x32Fn δ) >>> 2)) bf31Prep85Tree).testBit u.val then 1 else 0 :=
    (stepCB_decodePrimTree_apply bf31Prep85Tree rI85 (stWMid δ) u).trans (by rw [hI85Nat δ hz])
  have hStP_notBoth : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → ¬(stP δ (rBasis9 ⟨0, by decide⟩) = 1 ∧
      stP δ (rBasis9 ⟨8, by decide⟩) = 1) := fun δ hz ↦ by
    rw [show rBasis9 ⟨0, by decide⟩ = rI85 ⟨0, by decide⟩ from rfl, show rBasis9 ⟨8, by decide⟩ =
        rI85 ⟨8, by decide⟩ from rfl,
        hPrepBit δ ⟨0, by decide⟩ hz, hPrepBit δ ⟨8, by decide⟩ hz]
    rintro ⟨h0, h8⟩
    refine (bf31_direct_eval (hkpLe δ hz) (hx32 δ hz)).2.1 ⟨?_, ?_⟩
    · revert h0; cases (evalPrimTree 84 (in85Val (kpBasis9Code (kpFn δ))
          ((x32Fn δ) >>> 2)) bf31Prep85Tree).testBit 0 <;> decide
    · revert h8; cases (evalPrimTree 84 (in85Val (kpBasis9Code (kpFn δ))
          ((x32Fn δ) >>> 2)) bf31Prep85Tree).testBit 8 <;> decide
  have stP_disj {w} (hne : ∀ u, rI85 u ≠ w) (δ) : stP δ w = stWMid δ w :=
    stepCB_apply_disj rI85 cpPrep.fwdBits (stWMid δ) w fun ⟨u, hu⟩ ↦ hne u hu
  have hsR6_raw := subspaceStep_pBfRouter6_31 v rWork rBasis9 rCopy30 rScr31 rYHi33
    hBS hCS hBY hCY hSY stP ph
    (fun δ hz ↦ (stP_disj (fun u ↦ hrI85_ne_scr u _ (Or.inl rfl)) δ).trans (hScr0 δ hz))
    (fun δ hz ↦
      (stP_disj (fun u ↦ hrI85_ne_piv u ⟨0, by decide⟩) δ).trans (hPiv0 δ ⟨0, by decide⟩ hz))
    (fun δ hz ↦ (stP_disj (fun u ↦ hrI85_ne_scr u _ (Or.inr (Or.inl rfl))) δ).trans (hScr29 δ hz))
    (fun δ hz ↦ (stP_disj (fun u ↦ hrI85_ne_scr u _ (Or.inr (Or.inr (Or.inl rfl)))) δ).trans
      (hScr30 δ hz))
    (fun δ e hz ↦ (stP_disj (fun u ↦ hrI85_ne_scr u _ (Or.inr (Or.inr (Or.inr ⟨e, rfl⟩)))) δ).trans
      (hEarly0 δ e hz)) hStP_notBoth
  have hR6OutEq : mkKetOpW rWork (fun δ ↦ Function.update (Function.update (stP δ)
      (rScr31 ⟨29, by decide⟩) (stP δ (rBasis9 ⟨0, by decide⟩) * stP δ (rCopy30 ⟨2, by decide⟩)))
        (rScr31 ⟨30, by decide⟩)
