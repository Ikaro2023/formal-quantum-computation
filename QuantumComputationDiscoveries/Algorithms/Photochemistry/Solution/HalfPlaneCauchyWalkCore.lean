  have hrA01 : ∀ j, S (rA01 j) := fun j ↦ hrS ⟨29 + j.val, by omega⟩
  unfold pStep2bScr31;
  refine ⟨?_, ?_, ⟨Stage4FineFast.dynWires_wrapDynOnReg v rI85 hrI85 cpPrep dwR6, ⟨cw_cnot (hrC _)
