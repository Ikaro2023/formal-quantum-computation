def checkBf31Direct : Bool :=
  let initCT := uni72InitCT
  let out1 := evalStrict 78 uni72Mx initCT uniTree1_28_k9
  let keep22CT := evalStrict 78 uni72Mx initCT bf31Keep22Tree
  let early6CT := evalStrict 78 uni72Mx keep22CT bf31Early6Tree
  let out2r := evalStrict 78 uni72Mx early6CT uniReadout2_0_k9
  let in85CT := buildIn85CT initCT out1 out2r keep22CT
  let prep85CT := evalStrict 84 uni72Mx in85CT bf31Prep85Tree
  let sub94CT := buildSub94CT in85CT prep85CT
  let tail94CT := evalStrict 93 uni72Mx sub94CT bf31Tail94Tree
  let in96CT := buildIn96CT in85CT tail94CT
