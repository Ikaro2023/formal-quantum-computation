theorem stepCB_apply_of_not_mem {K n : ℕ} (r : QRegister K n)
    (f : BitAssignment K → BitAssignment K) (β : BitAssignment n) (x : Wire n)
    (hx : ¬∃ u, r u = x) : stepCB r f β x = β x := by
  dsimp only [stepCB]; exact writeReg_apply_of_not_mem _ _ _ _ hx
theorem stepCB_seq {K n : ℕ} (r : QRegister K n) (f g : BitAssignment K → BitAssignment K)
    (β : BitAssignment n) : stepCB r g (stepCB r f β) = stepCB r (fun γ ↦ g (f γ)) β := by
  ext x
  by_cases hx : ∃ u, r u = x
  · obtain ⟨u, rfl⟩ := hx; rw [stepCB_apply_reg, stepCB_apply_reg]
    have hfn : (fun v ↦ stepCB r f β (r v)) = f (fun v ↦ β (r v)) :=
      funext fun v ↦ stepCB_apply_reg r f β v
    rw [hfn]
  · rw [stepCB_apply_of_not_mem _ _ _ _ hx, stepCB_apply_of_not_mem _ _ _ _ hx,
        stepCB_apply_of_not_mem _ _ _ _ hx]

