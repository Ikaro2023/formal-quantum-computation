    have hwPot : rTot1 (wPotIsPot rPot0Layout) = rTot (wPotIsPot rPot0Layout) :=
      congrArg rTot.wires (hPot0 ⟨2, by decide⟩)
    have hwScr : rTot1 (wPotIsScreen rPot0Layout) = rTot (wPotIsScreen rPot0Layout) :=
      congrArg rTot.wires (hPot0 ⟨1, by decide⟩)
    rw [show clampFlags rTot1 β = clampFlags rTot β by
      dsimp only [clampFlags]
      rw [hwPot, hwScr, hwNN]]
    obtain ⟨cN1, cE1, cO1⟩ := clampOneHot_apply rTot1 (clampFlags rTot β)
    obtain ⟨cN2, cE2, cO2⟩ := clampOneHot_apply rTot (clampFlags rTot β)
    funext w
    rcases Classical.em (∃ b, w = rTot (rBufHi rNucLayout b)) with ⟨b, rfl⟩ | hwN
    · rw [← hEqN b, cN1 b, hEqN b, hwNN, cN2 b]
    · rcases Classical.em (∃ b, w = rTot (rBufHi rElecLayout b)) with ⟨b, rfl⟩ | hwE
      · rw [← hEqE b, cE1 b, hEqE b, hwNN, cE2 b]
      · rw [cO1 w (fun b e ↦ hwN ⟨b, e.trans (hEqN b)⟩) (fun b e ↦ hwE ⟨b, e.trans (hEqE b)⟩),
          cO2 w (fun b e ↦ hwN ⟨b, e⟩) (fun b e ↦ hwE ⟨b, e⟩)]

