theorem subspaceStep_toDynStep118 {Var : Type} [Fintype Var] [DecidableEq Var]
    {W n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rWork : QRegister W n) (r : QRegister 118 n)
    (st0 : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (idxOf : BitAssignment n → ℕ) (hIdx : ∀ δ, idxOf δ < 1024)
    (cols ctOut : CT) (c t : ℕ)
    (hEval : evalStep118 cols c = .mk true t ctOut) :
    SubspaceStep (Var := Var)
      (mkKetOpW rWork (stOfCT r st0 idxOf cols) ph)
      (mkKetOpW rWork (stOfCT r st0 idxOf ctOut) ph)
      (toDynStep118 v r c) ∧
    (toDynStep118 v r c).count .T = t ∧
    (toDynStep118 v r c).count .TOFF = 0 := by
  dsimp only [evalStep118] at hEval
  have go {b : Bool} {t0 : ℕ} {ct0 : CT} {P : Prop}
      (h : (if b = true then mkRes118 true t0 ct0 else .mk false 0 cols) = .mk true t ctOut)
      (k : b = true → t0 = t → ct0 = ctOut → P) : P := by
    by_cases hb : b = true
    · rw [itePos hb, mkRes118_eq] at h
      injection h with _ ht hct
      exact k hb ht hct
    · rw [ite_eq_right hb] at h
      cases h
  set w1 := (c / 8) % 128
  set w2 := (c / 1024) % 128
  set w3 := (c / 131072) % 128
  rcases (by omega : c % 8 = 0 ∨ c % 8 = 1 ∨ c % 8 = 2 ∨ c % 8 = 3 ∨ c % 8 = 4 ∨
      (c % 8 ≠ 0 ∧ c % 8 ≠ 1 ∧ c % 8 ≠ 2 ∧ c % 8 ≠ 3 ∧ c % 8 ≠ 4)) with
    htg | htg | htg | htg | htg | ⟨h0, h1, h2, h3, h4⟩
  · rw [htg, itePos (by decide)] at hEval
    refine go hEval ?_
    rintro hok rfl rfl
    dsimp only [toDynStep118]
    rw [htg, ite_eq_left (by decide), dite_eq_left (of_decide_eq_true hok)]
    exact ⟨step_x118 rWork r st0 ph idxOf hIdx cols w1 (of_decide_eq_true hok), rfl, rfl⟩
  · rw [htg, iteNeg (by decide), itePos (by decide)] at hEval
    refine go hEval ?_
    rintro hok rfl rfl
    dsimp only [toDynStep118]
    rw [htg, ite_eq_right (by decide), ite_eq_left (by decide),
        dite_eq_left (of_decide_eq_true hok)]
    exact ⟨step_cnot118 rWork r st0 ph idxOf cols w1 w2 (of_decide_eq_true hok), rfl, rfl⟩
  · rw [htg, iteNeg (by decide), iteNeg (by decide), itePos (by decide)] at hEval
    refine go hEval ?_
    rintro hok rfl rfl
    rw [Bool.and_eq_true] at hok
    dsimp only [toDynStep118]
    rw [htg, ite_eq_right (by decide), ite_eq_right (by decide), ite_eq_left (by decide),
      dite_eq_left (of_decide_eq_true hok.1)]
    exact ⟨step_andC118 rWork r st0 ph idxOf cols w1 w2 w3 (of_decide_eq_true hok.1)
      (Nat.beq_eq.mp hok.2), count_andComputeCircuit_t _ _ _ _ _ _,
      count_andComputeCircuit_toff _ _ _ _ _ _⟩
  · rw [htg, iteNeg (by decide), iteNeg (by decide), iteNeg (by decide),
      itePos (by decide)] at hEval
