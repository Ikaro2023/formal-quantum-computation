/-- Nonnegative 6-term `log(1 + P / Q)` numerator in `ℕ` for `P ≤ Q`. -/
def logLb6Nat (P Q : ℕ) : ℕ :=
  (60 * P * Q ^ 5 - 30 * P ^ 2 * Q ^ 4) +
    (20 * P ^ 3 * Q ^ 3 - 15 * P ^ 4 * Q ^ 2) +
    (12 * P ^ 5 * Q - 10 * P ^ 6)

/-- Machine-word `10^12`-scaled conservative upper bound on `1 - shellDrop A`. -/
def osUb12 (A : ℕ) : ℕ :=
  if A == 0 then 1000000000000
  else
    let u9 := (31415926 * (4 * A - 1) * 1000000000) / 1600000020000000
    let drop12 := (u9 * u9) / 2000000
    let u6Up := (u9 + 1000) / 1000
    1000000000000 - drop12 + ((u6Up ^ 4) / 24000000000000 + 2)

/-- Fast 64-bit `ℕ` shell decay index witness `mk < 65536` given hoisted `(t1, t2)`. -/
def mkFastAt (t1 t2 A : ℕ) : ℕ :=
  let sub := (t2 * osUb12 A + 999999999999) / 1000000000000
  if Nat.ble t1 sub then 0 else min 65535 ((t1 - sub) / 1000000000000)

/-- Adaptive step-deduplicated shell witness loop in pure `ℕ`. -/
def autoShellsFastLoop (t1 t2 : ℕ) : List ℕ → ℕ → ℕ → List (ℕ × ℕ) → List (ℕ × ℕ) × ℕ
  | [], curMk, lastR, acc =>
      let lastMk := mkFastAt t1 t2 1110000
      if Nat.blt curMk lastMk && Nat.blt lastR 1110000 then
        (((1110000, curMk) :: acc).reverse, lastMk)
      else (acc.reverse, curMk)
  | r :: rs, curMk, lastR, acc =>
      let nextMk := mkFastAt t1 t2 r
      let stepReq := if Nat.blt curMk 4800 then 1 else if Nat.blt curMk 8500 then 15 else 65536
      if Nat.ble (curMk + stepReq) nextMk then
        autoShellsFastLoop t1 t2 rs nextMk r ((r, curMk) :: acc)
      else autoShellsFastLoop t1 t2 rs curMk lastR acc

/-- Generates step-deduplicated `(R, mk)` shells and outer `mLast` in pure 64-bit `ℕ`. -/
def autoShellsFast (sNum K P Q : ℕ) : List (ℕ × ℕ) × ℕ :=
  if Nat.blt Q P then ([], 0)
  else
    let lNat := logLb6Nat P Q
    let t1 := ((K + 1) * 10 * lNat * 1000000000000) / (3 * Q ^ 6)
    let qp := Q * (Q + P)
    let t2 := (sNum * (2 * P * Q + P * P) * 10000000000 + qp - 1) / qp
    autoShellsFastLoop t1 t2 candShellRs (mkFastAt t1 t2 0) 0 []

