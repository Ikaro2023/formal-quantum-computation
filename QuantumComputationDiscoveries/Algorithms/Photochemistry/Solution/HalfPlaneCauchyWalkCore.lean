def noWriteK {K : ℕ} (u : Wire K) : ComputeProg K → Bool
  | .id => true
  | .x a => !(a == u)
  | .cnot _ t _ => !(t == u)
  | .andGate _ _ a _ _ _ => !(a == u)
  | .seq p q => noWriteK u p && noWriteK u q

theorem ne_of_not_beq {K : ℕ} {a u : Wire K} (h : (!(a == u)) = true) : u ≠ a := fun e ↦
  Bool.false_ne_true ((congrArg not (beq_iff_eq.mpr e.symm)).symm.trans h)

theorem noWriteK_fwd {K : ℕ} (u : Wire K) :
    ∀ (p : ComputeProg K), noWriteK u p = true → ∀ (γ : BitAssignment K), p.fwdBits γ u = γ u
  | .id, _, _ => rfl
  | .x _, h, _ => Function.update_of_ne (ne_of_not_beq h) _ _
  | .cnot _ _ _, h, _ => Function.update_of_ne (ne_of_not_beq h) _ _
  | .andGate _ _ _ _ _ _, h, _ => Function.update_of_ne (ne_of_not_beq h) _ _
  | .seq p q, h, γ => by
      rw [noWriteK, Bool.and_eq_true] at h
      exact (noWriteK_fwd u q h.2 _).trans (noWriteK_fwd u p h.1 γ)

theorem pCol16CliffordFwd304_spec (γ : BitAssignment 304) :
    let δ := pCol16CliffordFwd304.fwdBits γ
    (∀ u : Wire 304, u.val ≠ 183 → u.val ≠ 186 → δ u = γ u) ∧ (δ (w304 183)).val * 2 ^ 16 +
        (δ (w304 186)).val * 2 ^ 17 =
      (196608 + ((γ (w304 183)).val * 2 ^ 16 + (γ (w304 186)).val * 2 ^ 17)) % 262144 := by
  let s1 := (ComputeProg.x (w304 183)).fwdBits γ
  have es1 : s1 = Function.update γ (w304 183) (γ (w304 183) + 1) := upd_xK (w304 183) γ rfl
  have es2 : pCol16CliffordFwd304.fwdBits γ =
      Function.update s1 (w304 186) (γ (w304 186) + (γ (w304 183) + 1)) :=
          upd_cnotK (by decide) s1
      (by rw [es1, Function.update_of_ne (by decide), Function.update_self])
  dsimp only
  rw [es2, es1]
  refine ⟨fun u h183 h186 ↦ ?_, ?_⟩
  · rw [Function.update_of_ne (fun e ↦ h186 (congrArg Fin.val e)),
        Function.update_of_ne (fun e ↦ h183 (congrArg Fin.val e))]
  · rw [Function.update_of_ne (by decide), Function.update_self, Function.update_self]
    exact zmod2_col16_clifford _ _

theorem pCol0Opt187_304_spec (γ : BitAssignment 304)
    (h49 : γ (w304 49) = 0) (h187 : γ (w304 187) = 0) :
    let δ := pCol0Opt187_304.fwdBits γ
    (∀ u : Wire 304, u.val ≠ 49 → u.val ≠ 187 → δ u = γ u) ∧ (δ (w304 49)).val + 2 *
        (δ (w304 187)).val =
      poolSum [(0, [24], true), (0, [32], true), (0, [40], true)] γ := by
  let a := γ (w304 24)
  let b := γ (w304 32)
  let c := γ (w304 40)
  let v187 : ZMod 2 := (0 : ZMod 2) + (a + c) * (b + c)
  let s1 := (safeCnotCP (w304 40) (w304 24)).fwdBits γ
  have es1 : s1 = Function.update γ (w304 24) (a + c) := upd_cnotK (by decide) γ rfl
  let s2 := (safeCnotCP (w304 40) (w304 32)).fwdBits s1
  have es2 : s2 = Function.update s1 (w304 32) (b + c) := upd_cnotK (by decide) s1
    (by rw [es1, Function.update_of_ne (by decide), Function.update_of_ne (by decide)])
  let s3 := (safeAndGateCP (w304 24) (w304 32) (w304 187)).fwdBits s2
  have es3 : s3 = Function.update s2 (w304 187) v187 :=
    upd_andK (by decide) (by decide) (by decide) s2 (by
      rw [es2, Function.update_of_ne (by decide), Function.update_of_ne (by decide),
        Function.update_self, es1, Function.update_of_ne (by decide), Function.update_self, h187])
  let s4 := (safeCnotCP (w304 40) (w304 24)).fwdBits s3
  have es4 : s4 = Function.update s3 (w304 24) a := upd_cnotK (by decide) s3 (by
    rw [es3, Function.update_of_ne (by decide), Function.update_of_ne (by decide), es2,
      Function.update_of_ne (by decide), Function.update_of_ne (by decide), es1,
      Function.update_self, Function.update_of_ne (by decide), zmod2_add_cancel])
  let s5 := (safeCnotCP (w304 40) (w304 32)).fwdBits s4
  have es5' : s5 = Function.update s4 (w304 32) b := upd_cnotK (by decide) s4 (by
    rw [es4, Function.update_of_ne (by decide), Function.update_of_ne (by decide), es3,
      Function.update_of_ne (by decide), Function.update_of_ne (by decide), es2,
      Function.update_self, Function.update_of_ne (by decide), es1,
      Function.update_of_ne (by decide), zmod2_add_cancel])
  have es5 : s5 = Function.update γ (w304 187) v187 := funext fun u ↦ by
    rcases eq_or_ne u (w304 187) with rfl | h187u
    · rw [es5', Function.update_of_ne (by decide), es4, Function.update_of_ne (by decide),
        es3, Function.update_self, Function.update_self]
    rcases eq_or_ne u (w304 32) with rfl | h32u
    · rw [Function.update_of_ne h187u, es5', Function.update_self]
    rcases eq_or_ne u (w304 24) with rfl | h24u
    · rw [Function.update_of_ne h187u, es5', Function.update_of_ne (by decide), es4,
        Function.update_self]
    · rw [Function.update_of_ne h187u, es5', Function.update_of_ne h32u, es4,
        Function.update_of_ne h24u, es3, Function.update_of_ne h187u, es2,
        Function.update_of_ne h32u, es1, Function.update_of_ne h24u]
  let s6 := (ComputeProg.x (w304 187)).fwdBits s5
  have es6 : s6 = Function.update γ (w304 187) (v187 + 1) := by
    rw [show s6 = _ from upd_xK (w304 187) s5 rfl, es5, Function.update_self, upd_idem]
  let s7 := (safeCnotCP (w304 40) (w304 187)).fwdBits s6
  have es7 : s7 = Function.update γ (w304 187) (v187 + 1 + c) := by
    rw [show s7 = _ from upd_cnotK (by decide) s6 rfl, es6, Function.update_self,
      Function.update_of_ne (by decide), upd_idem]
  have step49 (u : Wire 304) {p v} (hp : p = Function.update s7 (w304 49) v)
      (h49u : u ≠ w304 49 := by decide) (h187u : u ≠ w304 187 := by decide) :
      (safeCnotCP u (w304 49)).fwdBits p = Function.update s7 (w304 49) (v + γ u) := by
    rw [upd_cnotK h49u p rfl, hp, Function.update_self, Function.update_of_ne h49u,
      upd_idem, es7, Function.update_of_ne h187u]
  dsimp only
  rw [show pCol0Opt187_304.fwdBits γ =
    Function.update s7 (w304 49) ((0 : ZMod 2) + 1 + a + b + c) from
    step49 (w304 40) (step49 (w304 32) (step49 (w304 24)
      (upd_xK (w304 49) s7 (by rw [es7, Function.update_of_ne (by decide), h49])))), es7]
  exact ⟨fun u hu49 hu187 ↦ by
      rw [Function.update_of_ne (mt (congrArg Fin.val) hu49),
        Function.update_of_ne (mt (congrArg Fin.val) hu187)],
    by rw [Function.update_self, Function.update_of_ne (by decide), Function.update_self]
       simp only [poolSum, List.foldr, tokBit, ↓reduceIte, pow_zero]
       exact zmod2_col0_val a b c⟩
theorem midPoolFwd_prefix_eq : ∀ (n : ℕ) (_hn : n ≤ 14) (γ : BitAssignment 304),
    poolSum ((List.range n).map (fun i => (i + 2, [d2WireListFwd18.getD (i + 2) 0], false))) γ =
      ∑ i : Fin n, ((γ (d2WireFwd304 ⟨i.val + 2, by omega⟩)).val * 2 ^ (i.val + 2) : ℕ)
  | 0, _, _ => rfl
  | n + 1, hn, γ => by
      rw [List.range_succ, List.map_append, poolSum_append, midPoolFwd_prefix_eq n (by omega) γ]
      rw [Fin.sum_univ_castSucc];
      simp only [List.map, poolSum, List.foldr, tokBit, Bool.false_eq_true, ↓reduceIte, zero_add,
          add_zero, Fin.val_castSucc, Fin.val_last]
      have hd : w304 (d2WireListFwd18.getD (n + 2) 0) = d2WireFwd304 ⟨n + 2, by omega⟩ := rfl
      rw [hd]

theorem d2WireFwd304_mid14_ne (i : Fin 14) :
    (d2WireFwd304 ⟨i.val + 2, by omega⟩).val ≠ 49 ∧
    (d2WireFwd304 ⟨i.val + 2, by omega⟩).val ≠ 183 ∧
    (d2WireFwd304 ⟨i.val + 2, by omega⟩).val ≠ 186 ∧
    (d2WireFwd304 ⟨i.val + 2, by omega⟩).val ≠ 187 := by
  fin_cases i <;> decide +kernel

theorem finalPoolFwd21_col16_col0_spec (γ1 γd : BitAssignment 304) (o49 : γd (w304 49) = 0)
    (h187d : γd (w304 187) = 0) (osum : poolSum finalPoolFwd21 γd % 262144 =
    poolSum initTokens γ1 % 262144) : finBitsVal (fun k : Fin 18 =>
    (pCol0Opt187_304.fwdBits (pCol16CliffordFwd304.fwdBits γd))
    (d2WireFwd304 k)) = poolSum initTokens γ1 % 262144 := by
  obtain ⟨hc16_keep, hc16_sum⟩ := pCol16CliffordFwd304_spec γd
  generalize pCol16CliffordFwd304.fwdBits γd = γc at hc16_keep hc16_sum ⊢
  have h49c : γc (w304 49) = 0 := (hc16_keep (w304 49) (by decide) (by decide)).trans o49
  have h187c : γc (w304 187) = 0 := (hc16_keep (w304 187) (by decide) (by decide)).trans h187d
  obtain ⟨hc0_keep, hc0_sum⟩ := pCol0Opt187_304_spec γc h49c h187c
  generalize pCol0Opt187_304.fwdBits γc = γf at hc0_keep hc0_sum ⊢
  have hcol0_eq : poolSum [(0, [24], true), (0, [32], true), (0, [40], true)] γc =
      poolSum [(0, [24], true), (0, [32], true), (0, [40], true)] γd := by
    apply poolSum_congr [183, 186] _ (by decide) γd γc
    intro u hu; simp only [inNatList, Bool.or_eq_false_iff, beq_eq_false_iff_ne] at hu;
    exact hc16_keep u hu.1 hu.2.1
  rw [hcol0_eq] at hc0_sum
  have hcst16 := poolSum_cst16_17 γd
  have htail2 : poolSum [(16, [183], false), (17, [186], false)] γd = (γd (w304 183)).val * 2 ^ 16 +
      (γd (w304 186)).val * 2 ^ 17 := by
    simp only [poolSum, List.foldr, tokBit, Bool.false_eq_true, ↓reduceIte, zero_add, add_zero]
  have hpool_split : poolSum finalPoolFwd21 γd = (poolSum [(0, [24], true), (0, [32], true),
      (0, [40], true)] γd + poolSum ((List.range 14).map fun i =>
      (i + 2, [d2WireListFwd18.getD (i + 2) 0], false)) γd) + (196608 + ((γd (w304 183)).val *
      2 ^ 16 + (γd (w304 186)).val * 2 ^ 17)) := by
    have hf_eq : finalPoolFwd21 =
        [(16, [], true), (17, [], true)] ++ [(0, [24], true), (0, [32], true), (0, [40], true)] ++
        ((List.range 14).map fun i => (i + 2, [d2WireListFwd18.getD (i + 2) 0], false)) ++
            [(16, [183], false), (17, [186], false)] := rfl
    rw [hf_eq, poolSum_append, poolSum_append, poolSum_append, hcst16, htail2]; omega
  have hmid_eq :
      (∑ i : Fin 14, ((γd (d2WireFwd304 ⟨i.val + 2, by omega⟩)).val * 2 ^ (i.val + 2) : ℕ)) =
      ∑ i : Fin 14, ((γf (d2WireFwd304 ⟨i.val + 2, by omega⟩)).val * 2 ^ (i.val + 2) : ℕ) :=
    Finset.sum_congr rfl fun i _ => by
      obtain ⟨h49i, h183i, h186i, h187i⟩ :=
          d2WireFwd304_mid14_ne i; rw [hc0_keep _ h49i h187i, hc16_keep _ h183i h186i]
  have h183_eq : γc (w304 183) = γf (w304 183) := (hc0_keep (w304 183) (by decide) (by decide)).symm
  have h186_eq : γc (w304 186) = γf (w304 186) := (hc0_keep (w304 186) (by decide) (by decide)).symm
  rw [h183_eq, h186_eq] at hc16_sum;
  rw [midPoolFwd_prefix_eq 14 le_rfl γd, hmid_eq, ← hc0_sum] at hpool_split
  set low16 := (γf (w304 49)).val + 2 * (γf (w304 187)).val +
    (∑ i : Fin 14, ((γf (d2WireFwd304 ⟨i.val + 2, by omega⟩)).val * 2 ^ (i.val + 2) : ℕ))
  set hi2 := (γf (w304 183)).val * 2 ^ 16 + (γf (w304 186)).val * 2 ^ 17
  set rem16 := 196608 + ((γd (w304 183)).val * 2 ^ 16 + (γd (w304 186)).val * 2 ^ 17)
  have hfb : finBitsVal (fun k : Fin 18 => γf (d2WireFwd304 k)) = low16 + hi2 := by
    have hd0 : d2WireFwd304 0 = w304 49 := rfl; have hd1 : d2WireFwd304 1 = w304 187 := rfl;
    have hd16 : d2WireFwd304 16 = w304 183 := rfl;
    have hd17 : d2WireFwd304 17 = w304 186 := rfl; rw [finBitsVal18_split147, hd0, hd1, hd16, hd17]
  have hlt18 : finBitsVal (fun k : Fin 18 => γf (d2WireFwd304 k)) < 262144 := finBitsVal_lt _
  calc finBitsVal (fun k : Fin 18 => γf (d2WireFwd304 k))
      = (low16 + hi2) % 262144 := by rw [← hfb, Nat.mod_eq_of_lt hlt18]
    _ = (low16 % 262144 + (rem16 % 262144) % 262144) % 262144 := by rw [hc16_sum, ← Nat.add_mod]
    _ = (low16 + rem16) % 262144 := by rw [Nat.mod_mod, ← Nat.add_mod]
    _ = poolSum finalPoolFwd21 γd % 262144 := by rw [hpool_split]
    _ = poolSum initTokens γ1 % 262144 := osum

