    refine ⟨fun u hu ↦ (esI 78 (by decide) bf31Keep22Tree initCT _ hMatchi u (by omega)).symm.trans
        (eq_of_beq (allLt_spec hKeepLoi u hu)),
      (esI 95 (by decide) bf31Unc96Tree in96CT _ hMatchIn96_i 94 (by decide)).symm.trans
