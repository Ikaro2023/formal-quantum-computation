theorem exists_eighth_bin {δ : ℝ} (h0 : 0 ≤ δ) (h1 : δ ≤ 1 / 2) : ∃ b : Fin 8, (b.val : ℝ) / 16 ≤
    δ ∧ δ ≤ ((b.val + 1 : ℕ) : ℝ) / 16 := by
  by_cases hlt : δ < 1 / 2
  · let k : ℤ := ⌊16 * δ⌋
    have hk0 : 0 ≤ k := Int.floor_nonneg.mpr (by linarith)
    have hk8 : k < 8 := Int.floor_lt.mpr (by linarith [show ((8 : ℤ) : ℝ) = 8 by norm_num])
    have hbn_eq : (k.toNat : ℝ) = (k : ℝ) := by exact_mod_cast Int.toNat_of_nonneg hk0
    refine ⟨⟨k.toNat, by omega⟩, ?_, ?_⟩
    · linarith [Int.floor_le (16 * δ), hbn_eq]
    · push_cast
      linarith [Int.lt_floor_add_one (16 * δ), hbn_eq]
  · have heq : δ = 1 / 2 := by linarith
    refine ⟨⟨7, by omega⟩, by norm_num [heq], by norm_num [heq]⟩

theorem sq_offset_le_dist16 {δ : ℝ} {b : Fin 8} (hb0 : (b.val : ℝ) / 16 ≤ δ)
    (hb1 : δ ≤ ((b.val + 1 : ℕ) : ℝ) / 16) (s : Fin 28) : ((((s.val : ℤ) : ℝ) - 13 - δ) ^ 2) ≤
    (((dist16Num b s : ℕ) : ℝ) / 16) ^ 2 := by
