theorem cw_cAuxInnerEnter {n : ℕ} {S : Wire n → Prop} (rSrc : QRegister 193 n)
    (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n) (hSrcOut : ∀ (u : Fin 193)
    (b : Fin 10), rSrc u ≠ rAuxOut b) (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (hSrc : ∀ u : Fin 193, S (rSrc u)) (hOut : ∀ b : Fin 10, S (rAuxOut b))
    (hScr : ∀ i : Fin 24, S (rAuxScr i))
    (idx : Fin 5) : CircWires S (cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx) :=
    ⟨⟨⟨⟨cw_cnot (hScr _) (hOut _), cw_cXorMaskSrc rSrc _ _ hSrc (hOut _) _ 193 le_rfl⟩,
    cw_cnot (hScr _) (hOut _)⟩, cw_cXorMaskSrc rSrc _ _ hSrc (hOut _) _ 193 le_rfl⟩,
    cw_cXorMaskSrc rSrc _ _ hSrc (hScr _) _ 193 le_rfl⟩
theorem counts_wrapAuxRouter2 {Var : Type} {n : ℕ} (v : Var) (rSrc : QRegister 193 n)
    (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n) (hSrcOut : ∀ (u : Fin 193)
    (b : Fin 10), rSrc u ≠ rAuxOut b) (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i) (idx : Fin 5)
    (mid : DynamicCircuit Var n) :
    (wrapAuxRouter2 v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx mid).count .T = 6 +
    mid.count .T ∧
    (wrapAuxRouter2 v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx mid).count .TOFF =
    mid.count .TOFF := by
  obtain ⟨tOL, fOL⟩ := count_cAuxOuterLoad rSrc rAuxScr hSrcScr idx; obtain ⟨tIE, fIE⟩ :=
      count_cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx;
      let cIE :=
      cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx;
      let inner := DynamicCircuit.seq (.circuit cIE) (DynamicCircuit.seq mid (.circuit cIE))
  obtain ⟨tB, fB⟩ := counts_pSplitRBracket v (rAuxScr ⟨0, by decide⟩)
    (fun b : Fin 2 ↦ rAuxScr ⟨4 + 2 * idx.val + b.val, by have := idx.isLt; have := b.isLt; omega⟩)
    (fun b : Fin 2 ↦ rAuxScr ⟨14 + 2 * idx.val + b.val, by have := idx.isLt; have := b.isLt; omega⟩)
    (rAuxScr ⟨1, by decide⟩) (rAuxScr ⟨2, by decide⟩) (rAuxScr ⟨3, by decide⟩)
    (auxRouterInj rAuxScr idx) inner
  dsimp only [wrapAuxRouter2, inner, DynamicCircuit.count] at tB fB ⊢;
  rw [tOL, fOL, tB, fB, tIE, fIE]
  exact ⟨by omega, by omega⟩

theorem dw_wrapAuxRouter2 {Var : Type} {n : ℕ} {S : Wire n → Prop} (v : Var)
    (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b) (hSrcScr : ∀ (u : Fin 193)
    (i : Fin 24), rSrc u ≠ rAuxScr i) (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (hSrc : ∀ u : Fin 193, S (rSrc u)) (hOut : ∀ b : Fin 10, S (rAuxOut b))
    (hScr : ∀ i : Fin 24, S (rAuxScr i)) (idx : Fin 5) (mid : DynamicCircuit Var n)
    (hMid : DynWires S mid) :
    DynWires S (wrapAuxRouter2 v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx mid) := by
  have dwOL := cw_cAuxOuterLoad rSrc rAuxScr hSrcScr hSrc hScr idx
  have dwIE := cw_cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr hSrc hOut hScr idx
  exact ⟨dwOL, ⟨dynWires_pSplitRBracket v _ _ _ _ _ _ (auxRouterInj rAuxScr idx) _ (hScr _)
    (fun _ ↦ hScr _) (fun _ ↦ hScr _) (hScr _) (hScr _) (hScr _) ⟨dwIE, ⟨hMid, dwIE⟩⟩, dwOL⟩⟩

def auxRawBitVal (c : Fin (2 ^ 41)) (b : Fin 10) : ZMod 2 :=
  let p := auxSlotPairAt b.val
  if bOf c p.1 && bOf c p.2 then 1 else 0

def auxDecBitVal (c : Fin (2 ^ 41)) (b : Fin 10) : ZMod 2 :=
  let p := fgates173At (163 + b.val)
  if bOf c p.1 && bOf c p.2 then 1 else 0

theorem dom_auxMLs (idx : Fin 5) (b : Fin 2) :
    (domKeepMask &&& (auxMLsAt idx).getD b.val 0 == (auxMLsAt idx).getD b.val 0) = true := by
  revert idx b
  decide +kernel

theorem dom_auxMU (idx : Fin 5) : (domKeepMask &&& auxMUAt idx == auxMUAt idx) = true := by
  revert idx
  decide +kernel

theorem dom_auxMYs (idx : Fin 5) (b : Fin 2) :
    (domKeepMask &&& (auxMYsAt idx).getD b.val 0 == (auxMYsAt idx).getD b.val 0) = true := by
  revert idx b
  decide +kernel

theorem ket_cAuxOuterLoad {n : ℕ} [NeZero (2 ^ n)] (rSrc : QRegister 193 n)
    (rAuxScr : QRegister 24 n)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (idx : Fin 5) (c : Fin (2 ^ 41)) (γ : BitAssignment n)
    (hSrc : ∀ u : Fin 193, γ (rSrc u) = if (e163Dom c).testBit (1 + u.val) then 1 else 0) :
    let i0 : Fin 24 := ⟨4 + 2 * idx.val, by have := idx.isLt; omega⟩
    let i1 : Fin 24 := ⟨4 + 2 * idx.val + 1, by have := idx.isLt; omega⟩
    let iu : Fin 24 := ⟨0, by decide⟩
    (cAuxOuterLoad rSrc rAuxScr hSrcScr idx).eval.1.mulVec (ket γ) =
      ket (Function.update (Function.update (Function.update γ
            (rAuxScr i0) (γ (rAuxScr i0) + if bOf152 c ((auxMLsAt idx).getD 0 0) then 1 else 0))
          (rAuxScr i1) (γ (rAuxScr i1) + if bOf152 c ((auxMLsAt idx).getD 1 0) then 1 else 0))
        (rAuxScr iu) (γ (rAuxScr iu) + if bOf152 c (auxMUAt idx) then 1 else 0)) := by
  intro i0 i1 iu
  have hNe (a b : Fin 24) (h : a.val ≠ b.val) : rAuxScr a ≠ rAuxScr b :=
      rAuxScr.wires.injective.ne (Fin.ne_of_val_ne h)
  have hS0 {v0} (u : Fin 193) := (Function.update_of_ne (hSrcScr u i0) v0 γ).trans (hSrc u)
  dsimp only [cAuxOuterLoad]
  rw [eval_seq_mulVec, eval_seq_mulVec, ket_cXorMaskSrc,
      env163_maskParity193 rSrc c γ hSrc _ (dom_auxMLs idx ⟨0, by decide⟩),
      ket_cXorMaskSrc, env163_maskParity193 rSrc c _ hS0 _ (dom_auxMLs idx ⟨1, by decide⟩),
      Function.update_of_ne (hNe i1 i0 (by dsimp [i1, i0]; omega)), ket_cXorMaskSrc,
      env163_maskParity193 rSrc c _ (fun u ↦
          (Function.update_of_ne (hSrcScr u i1) _ _).trans (hS0 u)) _ (dom_auxMU idx),
      Function.update_of_ne (hNe iu i1 (by dsimp [iu, i1]; omega)),
      Function.update_of_ne (hNe iu i0 (by dsimp [iu, i0]; omega))]

theorem ket_cAuxInnerEnter {n : ℕ} [NeZero (2 ^ n)]
    (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (idx : Fin 5) (c : Fin (2 ^ 41)) (γ : BitAssignment n)
    (hSrc : ∀ u : Fin 193, γ (rSrc u) = if (e163Dom c).testBit (1 + u.val) then 1 else 0) :
    let h0 : Fin 24 := ⟨14 + 2 * idx.val, by have := idx.isLt; omega⟩
    let h1 : Fin 24 := ⟨14 + 2 * idx.val + 1, by have := idx.isLt; omega⟩
    let g0 : Fin 10 := ⟨2 * idx.val, by have := idx.isLt; omega⟩
    let g1 : Fin 10 := ⟨2 * idx.val + 1, by have := idx.isLt; omega⟩
    let iu : Fin 24 := ⟨0, by decide⟩
    (cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx).eval.1.mulVec (ket γ) =
      ket (Function.update (Function.update (Function.update γ
            (rAuxOut g0)
                (γ (rAuxOut g0) + γ (rAuxScr h0) +
                if bOf152 c ((auxMYsAt idx).getD 0 0) then 1 else 0))
          (rAuxOut g1)
              (γ (rAuxOut g1) + γ (rAuxScr h1) +
              if bOf152 c ((auxMYsAt idx).getD 1 0) then 1 else 0))
        (rAuxScr iu) (γ (rAuxScr iu) + if bOf152 c (auxMUAt idx) then 1 else 0)) := by
  intro h0 h1 g0 g1 iu
  have hNeG : rAuxOut g1 ≠ rAuxOut g0 :=
      rAuxOut.wires.injective.ne (Fin.ne_of_val_ne (by dsimp [g1, g0]; omega))
  have hS1 {v0} (u : Fin 193) := (Function.update_of_ne (hSrcOut u g0) v0 γ).trans (hSrc u)
  have hS2 {v0 v1} (u : Fin 193) := (Function.update_of_ne (hSrcOut u g1) v1 _).trans (@hS1 v0 u)
  dsimp only [cAuxInnerEnter]
  rw [eval_seq_mulVec, eval_seq_mulVec, eval_seq_mulVec, eval_seq_mulVec, ket_CNOT, ket_cXorMaskSrc,
      env163_maskParity193 rSrc c _ hS1 _ (dom_auxMYs idx ⟨0, by decide⟩), Function.update_self,
          Function.update_idem, ket_CNOT,
      Function.update_of_ne hNeG, Function.update_of_ne (hOutScr g0 h1).symm, ket_cXorMaskSrc,
      env163_maskParity193 rSrc c _ hS2 _ (dom_auxMYs idx ⟨1, by decide⟩), Function.update_self,
          Function.update_idem,
      ket_cXorMaskSrc, env163_maskParity193 rSrc c _ hS2 _ (dom_auxMU idx),
      Function.update_of_ne (hOutScr g1 iu).symm, Function.update_of_ne (hOutScr g0 iu).symm]

theorem zmod2_aux_gate_eq (l u y g : Bool) (h : g = xor (l && u) y) :
    (if l then (1 : ZMod 2) else 0) * (if u then 1 else 0) + (if y then 1 else 0) =
    if g then 1 else 0 := by subst h; cases l <;> cases u <;> cases y <;> decide
def stAuxStep {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n) (c : Fin (2 ^ 41))
    (idx : Fin 5) (γ : BitAssignment n) : BitAssignment n :=
  let i0 : Fin 24 := ⟨4 + 2 * idx.val, by have := idx.isLt; omega⟩
  let i1 : Fin 24 := ⟨4 + 2 * idx.val + 1, by have := idx.isLt; omega⟩
  let h0 : Fin 24 := ⟨14 + 2 * idx.val, by have := idx.isLt; omega⟩
  let h1 : Fin 24 := ⟨14 + 2 * idx.val + 1, by have := idx.isLt; omega⟩
  let g0 : Fin 10 := ⟨2 * idx.val, by have := idx.isLt; omega⟩
  let g1 : Fin 10 := ⟨2 * idx.val + 1, by have := idx.isLt; omega⟩
  let l0 : ZMod 2 := if bOf152 c ((auxMLsAt idx).getD 0 0) then 1 else 0
  let l1 : ZMod 2 := if bOf152 c ((auxMLsAt idx).getD 1 0) then 1 else 0
  let uV : ZMod 2 := if bOf152 c (auxMUAt idx) then 1 else 0
  Function.update
    (Function.update
      (Function.update
        (Function.update
          (Function.update
            (Function.update γ (rAuxScr i0) (l0 * (1 + uV)))
            (rAuxScr i1) (l1 * (1 + uV)))
          (rAuxScr h0) (l0 * uV))
        (rAuxScr h1) (l1 * uV))
      (rAuxOut g0) (auxRawBitVal c g0))
    (rAuxOut g1) (auxRawBitVal c g1)

theorem stAuxStep_rAuxOut_hit {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (idx : Fin 5) (γ : BitAssignment n) (b : Fin 2) :
    stAuxStep rAuxOut rAuxScr c idx γ
      (rAuxOut ⟨2 * idx.val + b.val, by have := idx.isLt; have := b.isLt; omega⟩) =
      auxRawBitVal c ⟨2 * idx.val + b.val, by have := idx.isLt; have := b.isLt; omega⟩ := by
  dsimp only [stAuxStep]
  rcases (by decide : ∀ k : Fin 2, k = 0 ∨ k = 1) b with rfl | rfl
  · rw [show (⟨2 * idx.val + (0 : Fin 2).val, _⟩ : Fin 10) =
        ⟨2 * idx.val, _⟩ from Fin.ext (Nat.add_zero _),
        Function.update_of_ne (rAuxOut.wires.injective.ne (Fin.ne_of_val_ne (Nat.ne_of_lt
            (Nat.lt_succ_self _)))),
        Function.update_self]
  · rw [show (⟨2 * idx.val + (1 : Fin 2).val, _⟩ : Fin 10) = ⟨2 * idx.val + 1, _⟩ from rfl,
        Function.update_self]

theorem stAuxStep_rAuxOut_other {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i) (c : Fin (2 ^ 41)) (idx : Fin 5)
    (γ : BitAssignment n) (g : Fin 10) (hg0 : g.val ≠ 2 * idx.val) (hg1 : g.val ≠ 2 * idx.val + 1) :
    stAuxStep rAuxOut rAuxScr c idx γ (rAuxOut g) = γ (rAuxOut g) := by
  dsimp only [stAuxStep];
  rw [Function.update_of_ne (rAuxOut.wires.injective.ne (Fin.ne_of_val_ne hg1)),
      Function.update_of_ne (rAuxOut.wires.injective.ne (Fin.ne_of_val_ne hg0)),
      Function.update_of_ne (hOutScr g _), Function.update_of_ne (hOutScr g _),
      Function.update_of_ne (hOutScr g _), Function.update_of_ne (hOutScr g _)]
theorem stAuxStep_rAuxScr_other {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i) (c : Fin (2 ^ 41)) (idx : Fin 5)
    (γ : BitAssignment n) (a : Fin 24) (ha0 : a.val ≠ 4 + 2 * idx.val)
    (ha1 : a.val ≠ 4 + 2 * idx.val + 1) (ha2 : a.val ≠ 14 + 2 * idx.val)
    (ha3 : a.val ≠ 14 + 2 * idx.val + 1) : stAuxStep rAuxOut rAuxScr c idx γ (rAuxScr a) =
    γ (rAuxScr a) := by
  dsimp only [stAuxStep];
  rw [Function.update_of_ne (hOutScr _ a).symm, Function.update_of_ne (hOutScr _ a).symm,
      Function.update_of_ne (rAuxScr.wires.injective.ne (Fin.ne_of_val_ne ha3)),
      Function.update_of_ne (rAuxScr.wires.injective.ne (Fin.ne_of_val_ne ha2)),
      Function.update_of_ne (rAuxScr.wires.injective.ne (Fin.ne_of_val_ne ha1)),
      Function.update_of_ne (rAuxScr.wires.injective.ne (Fin.ne_of_val_ne ha0))]
theorem stAuxStep_outside {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (idx : Fin 5) (γ : BitAssignment n) {x : Wire n}
    (hxO : ∀ g : Fin 10, x ≠ rAuxOut g) (hxS : ∀ a : Fin 24, x ≠ rAuxScr a) :
    stAuxStep rAuxOut rAuxScr c idx γ x = γ x := by
  dsimp only [stAuxStep];
  rw [Function.update_of_ne (hxO _), Function.update_of_ne (hxO _), Function.update_of_ne (hxS _),
      Function.update_of_ne (hxS _), Function.update_of_ne (hxS _), Function.update_of_ne (hxS _)]
abbrev AuxStepClean {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (idx : Fin 5) (γ : BitAssignment n) : Prop :=
  γ (rAuxScr ⟨0, by decide⟩) = 0 ∧ γ (rAuxScr ⟨1, by decide⟩) = 0 ∧
  γ (rAuxScr ⟨2, by decide⟩) = 0 ∧ γ (rAuxScr ⟨3, by decide⟩) = 0 ∧
  γ (rAuxScr ⟨4 + 2 * idx.val, by have := idx.isLt; omega⟩) = 0 ∧
  γ (rAuxScr ⟨4 + 2 * idx.val + 1, by have := idx.isLt; omega⟩) = 0 ∧
  γ (rAuxScr ⟨14 + 2 * idx.val, by have := idx.isLt; omega⟩) = 0 ∧
  γ (rAuxScr ⟨14 + 2 * idx.val + 1, by have := idx.isLt; omega⟩) = 0 ∧
  γ (rAuxOut ⟨2 * idx.val, by have := idx.isLt; omega⟩) = 0 ∧
  γ (rAuxOut ⟨2 * idx.val + 1, by have := idx.isLt; omega⟩) = 0

theorem upd3_add_cancel {n : ℕ} (γ : BitAssignment n) (w0 w1 w2 : Wire n) (d0 d1 d2 : ZMod 2) :
    let γ' :=
        Function.update (Function.update (Function.update γ w0 (γ w0 + d0)) w1 (γ w1 +
        d1)) w2 (γ w2 + d2)
    Function.update (Function.update (Function.update γ' w0 (γ' w0 + d0)) w1 (γ' w1 +
        d1)) w2 (γ' w2 + d2) = γ := by
  intro γ'
  funext x
  by_cases h2 : x = w2 <;> by_cases h1 : x = w1 <;> by_cases h0 : x = w0 <;>
    subst_vars <;> simp [γ', Function.update_apply, *, add_assoc, zmod2_add_self]

theorem step_circ_mkKetOpW {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ} [NeZero (2 ^ n)]
    (rWork : QRegister W n) (c : Circuit n) (st₀ st₁ : BitAssignment n → BitAssignment n)
        (ph : BitAssignment n → ZMod 2)
    (h : ∀ δ, (∀ q, δ (rWork q) = 0) → c.eval.1.mulVec (ket (st₀ δ)) = ket (st₁ δ)) :
    SubspaceStep (Var := Var) (mkKetOpW rWork st₀ ph) (mkKetOpW rWork st₁ ph) (.circuit c) :=
  subspaceStep_congr_out (subspaceStep_of_circuit (Var := Var) (mkKetOpW rWork st₀ ph) c)
    (op_mul_mkKetOpW c.eval.1 rWork st₀ st₁ ph h)

set_option maxHeartbeats 800000 in
-- Large circuit/register elaboration requires raised heartbeat limit.
theorem step_wrapAuxRouter2 {Var : Type} [Fintype Var] [DecidableEq Var]
    {W n : ℕ} [NeZero (2 ^ n)] (v : Var) (rWork : QRegister W n)
    (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (coinFn : BitAssignment n → Fin (2 ^ 41))
    (st₀ st₁ : BitAssignment n → BitAssignment n)
    (idx : Fin 5)
    (mid : DynamicCircuit Var n)
    (hSrc₀ : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ u : Fin 193,
      st₀ δ (rSrc u) = if (e163Dom (coinFn δ)).testBit (1 + u.val) then 1 else 0)
    (hSrc₁ : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ u : Fin 193,
      st₁ δ (rSrc u) = if (e163Dom (coinFn δ)).testBit (1 + u.val) then 1 else 0)
    (hCln₀ : ∀ δ, (∀ q, δ (rWork q) = 0) → AuxStepClean rAuxOut rAuxScr idx (st₀ δ))
    (hCln₁ : ∀ δ, (∀ q, δ (rWork q) = 0) → AuxStepClean rAuxOut rAuxScr idx (st₁ δ))
    (hMid : SubspaceStep
      (mkKetOpW rWork (fun δ ↦ stAuxStep rAuxOut rAuxScr (coinFn δ) idx (st₀ δ)) (fun _ ↦ 0))
      (mkKetOpW rWork (fun δ ↦ stAuxStep rAuxOut rAuxScr (coinFn δ) idx (st₁ δ)) (fun _ ↦ 0))
      mid) :
    SubspaceStep (mkKetOpW rWork st₀ (fun _ ↦ 0)) (mkKetOpW rWork st₁ (fun _ ↦ 0))
      (wrapAuxRouter2 v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx mid) := by
  have _ := idx.isLt
  let iu : Fin 24 := ⟨0, by decide⟩
  let i0 : Fin 24 := ⟨4 + 2 * idx.val, by omega⟩
  let i1 : Fin 24 := ⟨4 + 2 * idx.val + 1, by omega⟩
  let h0 : Fin 24 := ⟨14 + 2 * idx.val, by omega⟩
  let h1 : Fin 24 := ⟨14 + 2 * idx.val + 1, by omega⟩
  let g0 : Fin 10 := ⟨2 * idx.val, by omega⟩
  let g1 : Fin 10 := ⟨2 * idx.val + 1, by omega⟩
  let uWire := rAuxScr iu
  let lW (b : Fin 2) :=
      rAuxScr ⟨4 + 2 * idx.val + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _)
      (by omega)⟩
  let hW (b : Fin 2) :=
      rAuxScr ⟨14 + 2 * idx.val + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _)
      (by omega)⟩
  let hInj := auxRouterInj rAuxScr idx
  obtain ⟨hlInj, hhInj, hlhNe⟩ := wPairR_inj_props hInj.w_inj
  let cOL := cAuxOuterLoad rSrc rAuxScr hSrcScr idx
  let cIE := cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx
  let sL (stB : BitAssignment n → BitAssignment n) (δ : BitAssignment n) :=
    Function.update (Function.update (Function.update (stB δ)
      (rAuxScr i0) (if bOf152 (coinFn δ) ((auxMLsAt idx).getD 0 0) then 1 else 0))
      (rAuxScr i1) (if bOf152 (coinFn δ) ((auxMLsAt idx).getD 1 0) then 1 else 0))
      (rAuxScr iu) (if bOf152 (coinFn δ) (auxMUAt idx) then 1 else 0)
  have hNeS (a b : Fin 24)
      (h : a.val ≠ b.val := by simp only [iu, i0, i1, h0, h1, Fin.val_mk] <;> omega) :
      rAuxScr a ≠ rAuxScr b := rAuxScr.wires.injective.ne (Fin.ne_of_val_ne h)
  have hSL (stB) (δ : BitAssignment n) (u : Fin 193) : sL stB δ (rSrc u) = stB δ (rSrc u) := by
    simp only [sL, Function.update_of_ne (hSrcScr u iu),
      Function.update_of_ne (hSrcScr u i1), Function.update_of_ne (hSrcScr u i0)]
  have hSS (stB : BitAssignment n → BitAssignment n) (δ : BitAssignment n)
      (hSB : ∀ u, stB δ (rSrc u) = if (e163Dom (coinFn δ)).testBit (1 + u.val) then 1 else 0)
          (u : Fin 193) :
      stSplitRFwd uWire lW hW (sL stB δ) (rSrc u) = if (e163Dom (coinFn δ)).testBit (1 +
          u.val) then 1 else 0 :=
    (stSplitRFwd_other _ (fun _ ↦ hSrcScr u _)
        (fun _ ↦ hSrcScr u _)).trans ((hSL stB δ u).trans (hSB u))
  have fin2 : ∀ b : Fin 2, b = 0 ∨ b = 1 := by decide
  have hlW0 : lW 0 = rAuxScr i0 := congrArg rAuxScr (Fin.ext (by dsimp [i0]))
  have hlW1 : lW 1 = rAuxScr i1 := congrArg rAuxScr (Fin.ext (by dsimp [i1]))
  have hhW0 : hW 0 = rAuxScr h0 := congrArg rAuxScr (Fin.ext (by dsimp [h0]))
  have hhW1 : hW 1 = rAuxScr h1 := congrArg rAuxScr (Fin.ext (by dsimp [h1]))
  have hLV (stB) (δ : BitAssignment n) (b : Fin 2) :
      sL stB δ (lW b) = if bOf152 (coinFn δ) ((auxMLsAt idx).getD b.val 0) then 1 else 0 := by
    rcases fin2 b with rfl | rfl
    · simp only [hlW0, sL, Function.update_of_ne (hNeS i0 iu), Function.update_of_ne (hNeS i0 i1),
        Function.update_self, Fin.val_zero]
    · simp only [hlW1, sL, Function.update_of_ne (hNeS i1 iu), Function.update_self, Fin.val_one]
  have hEK (stB) (δ : BitAssignment n)
      (hSrcB : ∀ u, stB δ (rSrc u) = if (e163Dom (coinFn δ)).testBit (1 + u.val) then 1 else 0)
      (hClnB : AuxStepClean rAuxOut rAuxScr idx (stB δ)) :
      cIE.eval.1.mulVec (ket (stSplitRFwd uWire lW hW (sL stB δ))) =
        ket (stAuxStep rAuxOut rAuxScr (coinFn δ) idx (stB δ)) := by
    let c := coinFn δ
    let γ := stSplitRFwd uWire lW hW (sL stB δ)
    rw [ket_cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx c γ (hSS stB δ hSrcB)]
    obtain ⟨cu, _, _, _, _, _, _, _, cg0, cg1⟩ := hClnB
    obtain ⟨_, hEqAux⟩ := auxSpecAt idx c
    have hγh (b : Fin 2) : γ (hW b) =
        (if bOf152 c ((auxMLsAt idx).getD b.val 0) then 1 else 0) *
            if bOf152 c (auxMUAt idx) then 1 else 0 :=
      (stSplitRFwd_hW hhInj hlhNe _ b).trans (congrArg₂ (· * ·) (hLV stB δ b)
          (Function.update_self _ _ _))
    have hγl (b : Fin 2) : γ (lW b) = (if bOf152 c ((auxMLsAt idx).getD b.val 0) then 1 else 0) *
        (1 + if bOf152 c (auxMUAt idx) then 1 else 0) :=
      (stSplitRFwd_lW (hW := hW) hlInj _ b).trans (congrArg₂ (· * ·) (hLV stB δ b)
        (congrArg (1 + ·) (Function.update_self _ _ _)))
