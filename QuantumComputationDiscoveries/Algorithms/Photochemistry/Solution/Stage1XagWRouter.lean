      (∀ b : Fin 2, sL stB δ (hW b) = 0) ∧ sL stB δ (rAuxScr ⟨1, by decide⟩) = 0 ∧
      sL stB δ (rAuxScr ⟨2, by decide⟩) = 0 ∧ sL stB δ (rAuxScr ⟨3, by decide⟩) = 0 := by
    obtain ⟨_, c1, c2, c3, _, _, ch0, ch1, _, _⟩ := hCB
