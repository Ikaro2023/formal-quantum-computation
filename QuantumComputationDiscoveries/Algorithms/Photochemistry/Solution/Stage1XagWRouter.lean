    rcases fin2 b with rfl | rfl
    · exact (congrArg _ hhW0).trans
          ((hOth stB δ h0 (Or.inr (by simp only [h0]; omega))).trans ch0)
    · exact (congrArg _ hhW1).trans
          ((hOth stB δ h1 (Or.inr (by simp only [h1]; omega))).trans ch1)
  let eBranch : Fin 2 → BitAssignment n → ZMod 2 :=
    fun b γ ↦ maskParity ((auxMLsAt idx).getD b.val 0) (fun u : Fin 193 ↦ γ (rSrc u)) 193 le_rfl
  exact (step_circ_mkKetOpW (Var := Var) rWork cOL st₀ (sL st₀) (fun _ ↦ 0) fun δ hz ↦ by
      obtain ⟨cu, _, _, _, cl0, cl1, _, _, _, _⟩ := hCln₀ δ hz
      rw [ket_cAuxOuterLoad rSrc rAuxScr hSrcScr idx (coinFn δ) (st₀ δ) (hSrc₀ δ hz)]
      simp only [sL, i0, i1, iu, cl0, cl1, cu, zero_add]).seq
    ((step_pSplitRBracket (by decide : 0 < 2) v rWork uWire lW hW
      (rAuxScr ⟨1, by decide⟩) (rAuxScr ⟨2, by decide⟩) (rAuxScr ⟨3, by decide⟩) eBranch hInj
      (fun b _ _ h ↦ maskParity_congr_support _ _ _ 193 le_rfl fun u _ _ ↦
        h (rSrc u) (fun _ ↦ hSrcScr u _) (fun _ ↦ hSrcScr u _) (hSrcScr u _))
      (sL st₀) (sL st₁) (fun _ ↦ 0) (fun _ ↦ 0)
      (DynamicCircuit.seq (.circuit cIE) (DynamicCircuit.seq mid (.circuit cIE)))
      (fun δ _ b₁ b₂ hne hb1 ↦ by
        obtain ⟨hD, _⟩ := auxSpecAt idx (coinFn δ)
        have hMB : (bOf152 (coinFn δ) ((auxMLsAt idx).getD b₁.val 0) &&
            bOf152 (coinFn δ) ((auxMLsAt idx).getD b₂.val 0)) = false :=
          (Nat.lt_or_gt_of_ne (Fin.val_ne_of_ne hne)).elim (fun h ↦ hD _ _ h b₂.isLt)
            fun h ↦ (Bool.and_comm _ _).trans (hD _ _ h b₁.isLt)
        rw [hLV st₀ δ b₁] at hb1
        rw [hLV st₀ δ b₂]
        exact (by decide : ∀ x y : Bool, (if x then (1 : ZMod 2) else 0) = 1 → (x && y) = false →
