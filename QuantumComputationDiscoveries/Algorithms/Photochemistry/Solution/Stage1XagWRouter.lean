            Nat.lt_of_lt_of_le hk2 hd⟩).2 &&& deadMask159_160 = 0) →
      ∀ b, b ≠ 159 → b ≠ 160 → (xagEnv c N f₁ (120 + d) hd).testBit b =
          (xagEnv c N f₂ (120 + d) hd).testBit b
