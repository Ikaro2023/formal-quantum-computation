            rw [hSL st₁ δ u, hSL st₀ δ u, hSrc₁ δ hz u, hSrc₀ δ hz u]⟩)
      ((step_circ_mkKetOpW (Var := Var) rWork cIE (fun δ ↦ stSplitRFwd uWire lW hW (sL st₀ δ))
          (fun δ ↦ stAuxStep rAuxOut rAuxScr (coinFn δ) idx (st₀ δ)) (fun _ ↦ 0)
          fun δ hz ↦ hEK st₀ δ (hSrc₀ δ hz) (hCln₀ δ hz)).seq
        (hMid.seq (step_circ_mkKetOpW (Var := Var) rWork cIE
          (fun δ ↦ stAuxStep rAuxOut rAuxScr (coinFn δ) idx (st₁ δ))
          (fun δ ↦ stSplitRFwd uWire lW hW (sL st₁ δ)) (fun _ ↦ 0) fun δ hz ↦ by
