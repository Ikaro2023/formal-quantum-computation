def checkAuxRouterRecon152 (slotBase : ℕ) (mU : ℕ) (mLs mYs : List ℕ) (basis exp : List ℕ)
    (uC : Bool × ℕ) (lCs yCs : List (Bool × ℕ)) (rgCs : List ((Bool × ℕ) × (Bool × ℕ))) : Bool :=
  decide (mLs.length = 2) &&
  decide (mYs.length = 2) &&
  decide (lCs.length = 2) &&
  decide (yCs.length = 2) &&
  decide (rgCs.length = 2) &&
  decide (reconMask basis exp uC.1 uC.2 = mU) &&
  ((List.range 2).all fun b ↦
    let p := auxSlotPairAt (slotBase + b)
    let rc := rgCs.getD b ((false, 0), (false, 0))
    let lc := lCs.getD b (false, 0)
    let yc := yCs.getD b (false, 0); decide (p.1 < 2 ^ 193) &&
    decide (p.2 < 2 ^ 193) &&
    decide (reconMask basis exp lc.1 lc.2 = mLs.getD b 0) &&
    decide (reconMask basis exp yc.1 yc.2 = mYs.getD b 0) &&
    decide (reconMask basis exp rc.1.1 rc.1.2 = p.1) &&
    decide (reconMask basis exp rc.2.1 rc.2.2 = p.2))

theorem auxRouter2_spec_of_cert152 {slotBase : ℕ} {mU : ℕ} {mLs mYs : List ℕ} {basis exp : List ℕ}
    {gcs : List ((Bool × ℕ) × (Bool × ℕ))} {uC : Bool × ℕ} {lCs yCs : List (Bool × ℕ)}
    {rgCs : List ((Bool × ℕ) × (Bool × ℕ))} (hCert : checkCert152 fgates173At basis exp gcs = true)
    (hRecon : checkAuxRouterRecon152 slotBase mU mLs mYs basis exp uC lCs yCs rgCs = true)
    (hTree : checkAuxRouterVec151 basis.length exp.length 2 gcs uC lCs yCs rgCs = true)
    (c : Fin (2 ^ 41)) : (∀ b1 b2, b1 < b2 → b2 < 2 → (bOf152 c (mLs.getD b1 0) &&
    bOf152 c (mLs.getD b2 0)) = false) ∧ (∀ b < 2, (bOf c (auxSlotPairAt (slotBase + b)).1 &&
    bOf c (auxSlotPairAt (slotBase + b)).2) = xor (bOf152 c (mLs.getD b 0) && bOf152 c mU)
    (bOf152 c (mYs.getD b 0))) := by
  let env := e163 c
  have h0 : env.testBit 0 = true := xagEnv_bit0 c.val fgates163 163 le_rfl
  have hexp : ∀ i < exp.length, exp.getD i 0 < 152 := checkCertGen_exp_lt hCert
  obtain ⟨hOnes, hEval⟩ := simVecIdx_evalCoord_eqGen (by decide : 42 + 152 ≤ 194) hCert h0
    fun e he ↦ xagEnv_gate_bit c.val c.isLt fgates163 (checkGatesWf_imp wf_fgates163) 163 le_rfl
      (exp.getD e 0) (Nat.lt_trans (hexp e he) (by decide))
  let z0 := packBits (fun i ↦ oddBits (env &&& basis.getD i 0) 194) basis.length
  simp only [checkAuxRouterVec151, Bool.and_eq_true, List.all_eq_true] at hTree
  simp only [checkAuxRouterRecon152, Bool.and_eq_true, decide_eq_true_eq,
      List.all_eq_true] at hRecon
  rcases hRecon with ⟨⟨⟨⟨⟨⟨_, _⟩, _⟩, _⟩, _⟩, hrU⟩, hRecAll⟩
  have evEq (cd : Bool × ℕ) : evalCoord basis.length exp.length (envStGen 194 basis exp env) cd =
      bOf152 c (reconMask basis exp cd.1 cd.2) :=
    reconMask_oddBitsGen (by decide : 42 + 152 ≤ 194) h0 hexp cd.1 cd.2
  refine ⟨fun b1 b2 hb12 hb2 ↦ ?_, fun b hb ↦ ?_⟩
  · have hBit := congrArg (Nat.testBit · z0) (beq_iff_eq.mp (by
      have hd := hTree.1 b1 (List.mem_range.mpr (Nat.lt_trans hb12 hb2)) b2 (List.mem_range.mpr hb2)
      rwa [ite_eq_left hb12] at hd))
    rwa [Nat.testBit_and, Nat.zero_testBit, hOnes, Bool.and_true, Nat.testBit_and, hEval, hEval,
        evEq, evEq,
      (hRecAll b1 (List.mem_range.mpr (Nat.lt_trans hb12 hb2))).1.1.1.2,
          (hRecAll b2 (List.mem_range.mpr hb2)).1.1.1.2] at hBit
  · rcases hRecAll b (List.mem_range.mpr hb) with ⟨⟨⟨⟨⟨hp1, hp2⟩, hrL⟩, hrY⟩, hrG1⟩, hrG2⟩
    have hBit := congrArg (Nat.testBit · z0) (beq_iff_eq.mp (hTree.2 b (List.mem_range.mpr hb)))
    rw [Nat.testBit_and, Nat.zero_testBit, hOnes, Bool.and_true, Nat.testBit_xor, Nat.testBit_and,
        Nat.testBit_xor, Nat.testBit_and, hEval, hEval, hEval, hEval, hEval, evEq, evEq, evEq, evEq,
            evEq,
        hrG1, hrG2, hrL, hrU, hrY, bOf152_lt193 c _ hp1, bOf152_lt193 c _ hp2] at hBit
    exact bool_eq_of_xor_eq_false hBit

