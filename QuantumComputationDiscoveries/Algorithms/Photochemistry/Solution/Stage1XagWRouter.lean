    rcases eq_or_ne x (rAuxScr h1) with rfl | hxh1
    · rw [Function.update_of_ne hxu, Function.update_self, ← hhW1, hγh 1, Fin.val_one]
    rcases eq_or_ne x (rAuxScr h0) with rfl | hxh0
    · rw [Function.update_of_ne hxu, Function.update_of_ne hxh1, Function.update_self, ← hhW0,
          hγh 0, Fin.val_zero]
    rcases eq_or_ne x (rAuxScr i1) with rfl | hxi1
    · rw [Function.update_of_ne hxu, Function.update_of_ne hxh1, Function.update_of_ne hxh0,
