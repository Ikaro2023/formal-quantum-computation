theorem rgates_tail4_dom (j : Fin 4) :
    let gIdx : Fin 143 := ⟨139 + j.val, by have := j.isLt; omega⟩
    (domKeepMask &&& (rgates gIdx).1 == (rgates gIdx).1) = true ∧
    (domKeepMask &&& (rgates gIdx).2 == (rgates gIdx).2) = true := by
