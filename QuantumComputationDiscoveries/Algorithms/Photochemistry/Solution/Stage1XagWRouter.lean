abbrev e163 (c : Fin (2 ^ 41)) : ℕ := xagEnv c.val 163 fgates163 163 le_rfl

theorem e163_at151 (c : Fin (2 ^ 41)) :
    xagEnv c.val 163 fgates163 151 (by decide) = e151 c :=
  xagEnv_indep_N c.val fgates163 fgates 151 (by decide) le_rfl fun g hg ↦ by
    dsimp only [fgates163, fgates, fgates173At]
    rw [Nat.blt_eq.mpr hg]; rfl

theorem e163_testBit_lt193 (c : Fin (2 ^ 41)) (b : ℕ) (hb : b < 193) : (e163 c).testBit b =
    (e151 c).testBit b :=
  (xagEnv_prefix_testBit c.val 163 fgates163 151 (by decide) 163 le_rfl (by decide) b hb).trans
    (by rw [e163_at151 c])

theorem e163_oddBits_lt193 (c : Fin (2 ^ 41)) (m n : ℕ) (hm : m < 2 ^ 193)
    (hn : 193 ≤ n) : oddBits (e163 c &&& m) n = bOf c m := by
  rw [oddBits_and_eq_of_lt_two_pow hm hn]
  exact oddBits_congr_low _ _ 193 fun i hi ↦ by
    rw [Nat.testBit_and, Nat.testBit_and, e163_testBit_lt193 c i hi]

theorem e163_gate_eq_bOf (c : Fin (2 ^ 41)) (g : ℕ) (hg1 : 151 ≤ g)
    (hg2 : g < 163) : (e163 c).testBit (42 + g) = (bOf c (fgates173At g).1 &&
    bOf c (fgates173At g).2) := by
  have hbit :=
      xagEnv_gate_bit c.val c.isLt fgates163 (checkGatesWf_imp wf_fgates163) 163 le_rfl g hg2
  obtain ⟨h1, h2⟩ := tail22_lt193 g hg1 (by omega)
  dsimp only [fgates163] at hbit
  rw [hbit,
      e163_oddBits_lt193 c _ (42 + g) h1 (by omega),
      e163_oddBits_lt193 c _ (42 + g) h2 (by omega)]

def bOf152 (c : Fin (2 ^ 41)) (m : ℕ) : Bool := oddBits (e163 c &&& m) 194

theorem bOf152_lt193 (c : Fin (2 ^ 41)) (m : ℕ) (hm : m < 2 ^ 193) : bOf152 c m = bOf c m :=
  e163_oddBits_lt193 c m 194 hm (by decide)

theorem bOf_zero (c : Fin (2 ^ 41)) : bOf c 0 = false := by
  dsimp only [bOf]; rw [Nat.and_zero, oddBits_zero]
theorem bOf_one (c : Fin (2 ^ 41)) : bOf c 1 = true := by
  dsimp only [bOf]; have h1 : (1 : ℕ) = 1 <<< 0 := rfl
  rw [h1, oddBits_single_bit (e151 c) 0 193 (by decide)]
  exact xagEnv_bit0 c.val fgates 151 le_rfl

theorem bOf_gate_bit (c : Fin (2 ^ 41)) (g : ℕ) (hg : g < 151) : bOf c (1 <<< (42 + g)) =
    (bOf c (fgatesAtOpt g).1 && bOf c (fgatesAtOpt g).2) := by
  dsimp only [bOf]
  rw [oddBits_single_bit (e151 c) (42 + g) 193 (by omega)]
  have hbit :=
      xagEnv_gate_bit c.val c.isLt fgates (checkGatesWf_imp wf_fgates) 151 le_rfl g hg; obtain ⟨h1,
      h2⟩ := checkGatesWf_imp wf_fgates ⟨g, hg⟩; dsimp only [fgates] at hbit h1 h2
  rw [hbit,
      ← oddBits_and_eq_of_lt_two_pow h1 (by omega : 42 + g ≤ 193),
      ← oddBits_and_eq_of_lt_two_pow h2 (by omega : 42 + g ≤ 193)]

