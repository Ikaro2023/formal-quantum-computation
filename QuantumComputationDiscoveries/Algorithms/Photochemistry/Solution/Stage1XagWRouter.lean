    maskParity mask (fun u : Fin 193 ↦ γ (rSrc u)) 193 le_rfl = if bOf152 c mask then 1 else 0 := by
  let envFn : BitAssignment 193 := fun u ↦ if (e163Dom c).testBit (1 + u.val) then 1 else 0
