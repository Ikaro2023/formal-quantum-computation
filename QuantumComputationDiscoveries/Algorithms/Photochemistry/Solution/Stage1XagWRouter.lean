    wrapDynOnReg v (rPre182 rPre) (xagStepProg 139 g (by omega) p.1 p.2) mid
  else mid

def wrapCustomGGate {Var : Type} {n : ℕ} (v : Var) (rPre : QRegister 276 n) (g a b : ℕ)
    (mid : DynamicCircuit Var n) : DynamicCircuit Var n :=
  if hg : g < 139 then
    wrapDynOnReg v (rPre182 rPre) (customXagStep139 g (by omega) a b) mid
  else mid

def wrapGChunk {Var : Type} {n : ℕ} (v : Var) (rPre : QRegister 276 n) :
    List ℕ → DynamicCircuit Var n → DynamicCircuit Var n
  | [], mid => mid
  | g :: gs, mid => wrapGGate v rPre g (wrapGChunk v rPre gs mid)

def cXorMaskPre {n : ℕ} (rPre : QRegister 276 n) (dst : Fin 276) (mask : ℕ) :
    (k : ℕ) → k ≤ 180 → Circuit n
  | 0, _ => if mask.testBit 0 then Circuit.X (rPre dst) else .identity
  | k + 1, hk =>
      let prev := cXorMaskPre rPre dst mask k (Nat.le_of_succ_le hk)
      if mask.testBit (1 + k) then
        if hne : (⟨k, by omega⟩ : Fin 276) ≠ dst then
          prev ;;ᶜ Circuit.CNOT (rPre ⟨k, by omega⟩) (rPre dst) (rPre.wires.injective.ne hne)
        else prev
      else prev

theorem count_cXorMaskPre {n : ℕ} (rPre : QRegister 276 n) (dst : Fin 276) (mask : ℕ) :
    ∀ (k : ℕ) (hk : k ≤ 180),
      (cXorMaskPre rPre dst mask k hk).count .T = 0 ∧
      (cXorMaskPre rPre dst mask k hk).count .TOFF = 0
  | 0, _ => by dsimp only [cXorMaskPre]; split_ifs <;> simp [Circuit.X]
  | k + 1, hk => by
      obtain ⟨ht, hf⟩ :=
          count_cXorMaskPre rPre dst mask k (Nat.le_of_succ_le hk); dsimp only [cXorMaskPre]
      split_ifs <;> simp [ht, hf, Circuit.CNOT]

theorem cw_cXorMaskPre {n : ℕ} {S : Wire n → Prop} (rPre : QRegister 276 n)
    (hr : ∀ j : Fin 276, S (rPre j)) (dst : Fin 276) (mask : ℕ) :
    ∀ (k : ℕ) (hk : k ≤ 180), CircWires S (cXorMaskPre rPre dst mask k hk)
  | 0, _ => by
      dsimp only [cXorMaskPre]; split_ifs
      · exact cw_1 (hr dst)
      · trivial
  | k + 1, hk => by
      have ih :=
          cw_cXorMaskPre rPre hr dst mask k (Nat.le_of_succ_le hk); dsimp only [cXorMaskPre];
          split_ifs
      · exact ⟨ih, cw_cnot (hr ⟨k, by omega⟩) (hr dst)⟩
      · exact ih
      · exact ih

theorem ket_cXorMaskPre {n : ℕ} [NeZero (2 ^ n)] (rPre : QRegister 276 n)
    (dst : Fin 276) (mask : ℕ)
    (hNoSelf : 180 ≤ dst.val ∨ mask.testBit (1 + dst.val) =
    false) (γ : BitAssignment n) :
    ∀ (k : ℕ) (hk : k ≤ 180), (cXorMaskPre rPre dst mask k hk).eval.1.mulVec (ket γ) =
      ket (Function.update γ (rPre dst) (γ (rPre dst) + maskParity mask (fun u : Fin 180 ↦
          γ (rPre ⟨u.val, Nat.lt_trans u.isLt
        (by decide)⟩)) k hk))
  | 0, _ => by
      dsimp only [cXorMaskPre, maskParity]
      cases mask.testBit 0 <;>
        simp only [Bool.false_eq_true, ↓reduceIte, Circuit.eval_identity, Submonoid.coe_one,
          Matrix.one_mulVec, add_zero, Function.update_eq_self, ket_X]
  | k + 1, hk => by
      have ih := ket_cXorMaskPre rPre dst mask hNoSelf γ k (Nat.le_of_succ_le hk)
      dsimp only [cXorMaskPre, maskParity]
      cases hbt : mask.testBit (1 + k)
      · simp only [Bool.false_eq_true, ↓reduceIte, add_zero, ih]
      · have hne : (⟨k, by omega⟩ : Fin 276) ≠ dst := fun e ↦ by
          obtain rfl : k = dst.val := congrArg Fin.val e
          exact hNoSelf.elim (fun _ ↦ by omega) (Bool.noConfusion ∘ hbt.symm.trans)
        simp only [↓reduceIte, dite_eq_left hne, eval_seq_mulVec, ih, ket_CNOT,
          Function.update_of_ne (rPre.wires.injective.ne hne), Function.update_self,
          Function.update_idem, add_assoc]

theorem findBranchAux_lt {α : Type*} [DecidableEq α] {R : ℕ} {w : Fin R → α} {x : α} {b : Fin R} :
    ∀ (k : ℕ) (hk : k ≤ R), findBranchAux w x k hk = some b → b.val < k
  | 0, _, h => by cases h
  | k + 1, hk, h => by
      dsimp only [findBranchAux] at h
      split_ifs at h with he
      · cases h
        exact Nat.lt_succ_self k
      · exact Nat.lt_succ_of_lt (findBranchAux_lt k (Nat.le_of_succ_le hk) h)

theorem findBranchAux_rPre_none {n R : ℕ} (rPre : QRegister 276 n) {idx : Fin R → Fin 276}
    {x : Fin 276} {k : ℕ} (hk : k ≤ R)
    (h : ∀ b : Fin R, b.val < k → x.val ≠ (idx b).val) : findBranchAux (fun b ↦ rPre (idx b))
        (rPre x) k hk = none := by
  cases hfb : findBranchAux (fun b ↦ rPre (idx b)) (rPre x) k hk with
  | none => rfl
  | some b =>
      exact absurd (findBranchAux_spec k hk hfb)
          (rPre.wires.injective.ne (Fin.ne_of_val_ne (h b (findBranchAux_lt k hk hfb))))
/-! #### Involutive Router Branch Load / Enter Circuits & `wrapRouterEpoch` -/

def xorMaskZMod2 (f : ℕ → ZMod 2) (m : ℕ) : ℕ → ZMod 2
  | 0 => 0
  | j + 1 => xorMaskZMod2 f m j + if m.testBit j then f j else 0

theorem xorMaskZMod2_congr_lt {f g : ℕ → ZMod 2} (m : ℕ) :
    ∀ (k : ℕ), (∀ j < k, f j = g j) → xorMaskZMod2 f m k = xorMaskZMod2 g m k
  | 0, _ => rfl
  | j + 1, h => by
      dsimp only [xorMaskZMod2]
      rw [xorMaskZMod2_congr_lt m j (fun i hi ↦ h i (Nat.lt_succ_of_lt hi))]
      split_ifs
      · rw [h j (Nat.lt_succ_self j)]
      · rfl

theorem xorMaskZMod2_step_aux (b1 b2 b3 : Bool) : (if b2 then (1 : ZMod 2) else 0) +
    (if b1 then if b3 then (1 : ZMod 2) else 0 else 0) =
    if (if b1 then xor b2 b3 else b2) then (1 : ZMod 2) else 0 := by
  cases b1 <;> cases b2 <;> cases b3 <;> decide

theorem xorMaskZMod2_ite (f : ℕ → Bool) (m : ℕ) :
    ∀ (k : ℕ), xorMaskZMod2 (fun j ↦ if f j then (1 : ZMod 2) else 0) m k =
      if xorMaskBool f m k then 1 else 0
  | 0 => rfl
  | j + 1 => by
      dsimp only [xorMaskZMod2, xorMaskBool]; rw [xorMaskZMod2_ite f m j];
      exact xorMaskZMod2_step_aux (m.testBit j) (xorMaskBool f m j) (f j)
theorem xorMaskZMod2_mul_right (f : ℕ → ZMod 2) (u : ZMod 2) (m : ℕ) :
    ∀ (k : ℕ), xorMaskZMod2 (fun j ↦ f j * u) m k = xorMaskZMod2 f m k * u
  | 0 => by simp [xorMaskZMod2]
  | j + 1 => by
      dsimp only [xorMaskZMod2]; rw [xorMaskZMod2_mul_right f u m j]
      split_ifs <;> ring

def cXorHMask {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (dst : Fin 276) (hdst : dst.val < 180) (mh : ℕ) : (j : ℕ) → j ≤ R → Circuit n
  | 0, _ => .identity
  | j + 1, hj =>
      let prev := cXorHMask rPre hsb dst hdst mh j (Nat.le_of_succ_le hj)
      if mh.testBit j then
        let hne : (⟨231 + sb + j, by omega⟩ : Fin 276) ≠ dst :=
          fun e ↦ by have hv := congrArg Fin.val e; dsimp at hv; omega
        prev ;;ᶜ Circuit.CNOT (rPre ⟨231 + sb + j, by omega⟩) (rPre dst)
          (rPre.wires.injective.ne hne)
      else prev

theorem count_cXorHMask {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (dst : Fin 276) (hdst : dst.val < 180) (mh : ℕ) :
    ∀ (j : ℕ) (hj : j ≤ R),
      (cXorHMask rPre hsb dst hdst mh j hj).count .T = 0 ∧
      (cXorHMask rPre hsb dst hdst mh j hj).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | j + 1, hj => by
      obtain ⟨ht, hf⟩ :=
          count_cXorHMask rPre hsb dst hdst mh j (Nat.le_of_succ_le hj); dsimp only [cXorHMask]
      split_ifs <;> simp [ht, hf, Circuit.CNOT]

theorem cw_cXorHMask {n R sb : ℕ} {S : Wire n → Prop} (rPre : QRegister 276 n)
    (hr : ∀ j : Fin 276, S (rPre j)) (hsb : sb + R ≤ 45)
    (dst : Fin 276) (hdst : dst.val < 180) (mh : ℕ) :
    ∀ (j : ℕ) (hj : j ≤ R), CircWires S (cXorHMask rPre hsb dst hdst mh j hj)
  | 0, _ => trivial
  | j + 1, hj => by
      have ih :=
          cw_cXorHMask rPre hr hsb dst hdst mh j (Nat.le_of_succ_le hj); dsimp only [cXorHMask];
          split_ifs
      · exact ⟨ih, cw_cnot (hr _) (hr _)⟩
      · exact ih

def hMaskParity {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45) (mh : ℕ)
    (γ : BitAssignment n) (k : ℕ) : ZMod 2 :=
  xorMaskZMod2 (fun j ↦ if hj : j < R then γ (rPre ⟨231 + sb + j, by omega⟩) else 0) mh k

theorem ket_cXorHMask {n R sb : ℕ} [NeZero (2 ^ n)] (rPre : QRegister 276 n)
    (hsb : sb + R ≤ 45) (dst : Fin 276) (hdst : dst.val < 180) (mh : ℕ)
    (γ : BitAssignment n) :
    ∀ (j : ℕ) (hj : j ≤ R),
      (cXorHMask rPre hsb dst hdst mh j hj).eval.1.mulVec (ket γ) =
        ket (Function.update γ (rPre dst)
          (γ (rPre dst) + hMaskParity rPre hsb mh γ j))
  | 0, _ => by
      simp only [cXorHMask, hMaskParity, xorMaskZMod2, Circuit.eval_identity, Submonoid.coe_one,
        Matrix.one_mulVec, add_zero, Function.update_eq_self]
  | j + 1, hj => by
      have ih := ket_cXorHMask rPre hsb dst hdst mh γ j (Nat.le_of_succ_le hj)
      dsimp only [cXorHMask]
      cases h : mh.testBit j
      · rw [ite_eq_right Bool.false_ne_true, ih]
        dsimp only [hMaskParity, xorMaskZMod2]
        rw [h, ite_eq_right Bool.false_ne_true, add_zero]
      · have hne : (⟨231 + (sb + j), by omega⟩ : Fin 276) ≠ dst :=
          Fin.ne_of_val_ne (by simp only; omega)
        rw [ite_eq_left rfl, eval_seq_mulVec, ih, ket_CNOT]
        dsimp only [hMaskParity, xorMaskZMod2]
        simp only [h, ↓reduceIte, dite_eq_left (by omega : j < R),
          Function.update_of_ne (rPre.wires.injective.ne hne), Function.update_self,
              Function.update_idem, add_assoc]

theorem hMaskParity_congr {n R sb : ℕ} (rPre : QRegister 276 n)
    (hsb : sb + R ≤ 45) (mh : ℕ) {γ₁ γ₂ : BitAssignment n}
    (h : ∀ b : Fin R, γ₁ (rPre ⟨231 + sb + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _)
        (by omega)⟩) =
      γ₂ (rPre ⟨231 + sb + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _) (by omega)⟩)) :
    hMaskParity rPre hsb mh γ₁ R = hMaskParity rPre hsb mh γ₂ R :=
  xorMaskZMod2_congr_lt mh R fun j hj ↦ by
    rw [dite_eq_left hj, dite_eq_left hj]
    exact h ⟨j, hj⟩

theorem routerInj_on_rPre {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45) :
    WOptInj R 1 (fun _ : Fin 1 ↦ rPre ⟨182, by decide⟩)
      (wPairR (fun b ↦ rPre ⟨186 + sb + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _)
          (by omega)⟩)
              (fun b ↦ rPre ⟨231 + sb + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _)
                  (by omega)⟩))
      (rPre ⟨183, by decide⟩) (rPre ⟨184, by decide⟩) (rPre ⟨185, by decide⟩) := by
  have hNe (a b : Fin 276) (h : a.val ≠ b.val) : rPre a ≠ rPre b :=
      rPre.wires.injective.ne (Fin.ne_of_val_ne h)
  have hWNe (k : Fin 276) (hk : k.val < 186) (b : Fin R) (p : Fin 2) :
      wPairR (fun b ↦ rPre ⟨186 + sb + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _)
          (by omega)⟩)
             (fun b ↦ rPre ⟨231 + sb + b.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _)
                 (by omega)⟩) b p ≠ rPre k := by
    have _ := b.isLt
    dsimp only [wPairR]
    split_ifs <;> exact hNe _ _ (by simp only; omega)
  refine ⟨fun b1 p1 b2 p2 e ↦ ?_, fun _ b p ↦ (hWNe _ (by decide) b p).symm,
    fun _ ↦ hNe _ _ (by decide), fun _ ↦ hNe _ _ (by decide), fun _ ↦ hNe _ _ (by decide),
    hWNe _ (by decide), hWNe _ (by decide), hWNe _ (by decide),
    hNe _ _ (by decide), hNe _ _ (by decide), hNe _ _ (by decide)⟩
  have _ : _ ∧ _ ∧ _ ∧ _ := ⟨b1.isLt, b2.isLt, p1.isLt, p2.isLt⟩
  dsimp only [wPairR] at e
  split_ifs at e <;> simp only [rPre.wires.injective.eq_iff, Fin.ext_iff] at e <;>
    exact ⟨Fin.ext (by omega), Fin.ext (by omega)⟩

def cLoadLChain {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (mLs : List ℕ) : (k : ℕ) → k ≤ R → Circuit n
  | 0, _ => .identity
  | k + 1, hk =>
      cLoadLChain rPre hsb mLs k (Nat.le_of_succ_le hk) ;;ᶜ
        cXorMaskPre rPre ⟨186 + sb + k, by omega⟩ (mLs.getD k 0) 180 le_rfl

def cOuterLoad {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45) (mU : ℕ)
    (mLs : List ℕ) : Circuit n :=
  cLoadLChain rPre hsb mLs R le_rfl ;;ᶜ
    cXorMaskPre rPre ⟨182, by decide⟩ mU 180 le_rfl

def cEnterGChain {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (gates mYs maskHs : List ℕ) : (k : ℕ) → k ≤ R → Circuit n
  | 0, _ => .identity
  | k + 1, hk =>
      let prev := cEnterGChain rPre hsb gates mYs maskHs k (Nat.le_of_succ_le hk)
      let g := gates.getD k 0
      if hg : g < 139 then
        (prev ;;ᶜ
          cXorHMask rPre hsb ⟨41 + g, by omega⟩ (by dsimp; omega) (maskHs.getD k 0) R le_rfl) ;;ᶜ
          cXorMaskPre rPre ⟨41 + g, by omega⟩ (mYs.getD k 0) 180 le_rfl
      else prev

def cInnerEnter {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45) (mU : ℕ)
    (gates mYs maskHs : List ℕ) : Circuit n :=
  cEnterGChain rPre hsb gates mYs maskHs R le_rfl ;;ᶜ
    cXorMaskPre rPre ⟨182, by decide⟩ mU 180 le_rfl

def wrapRouterEpoch {Var : Type} {n R sb : ℕ} (v : Var) (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (rc : RouterEpochCfg) (mid : DynamicCircuit Var n) : DynamicCircuit Var n :=
  let uWire := rPre ⟨182, by decide⟩
  let lW : Fin R → Wire n := fun b ↦ rPre ⟨186 + sb + b.val, by have := b.isLt; omega⟩
  let hW : Fin R → Wire n := fun b ↦ rPre ⟨231 + sb + b.val, by have := b.isLt; omega⟩
  let rDum := rPre ⟨183, by decide⟩
  let wDum := rPre ⟨184, by decide⟩
  let qEnc := rPre ⟨185, by decide⟩
  let hInj := routerInj_on_rPre rPre hsb
  let inner :=
      (DynamicCircuit.circuit (cInnerEnter rPre hsb rc.mU rc.gates rc.mYs rc.maskHs)).seq
      (mid.seq (DynamicCircuit.circuit (cInnerEnter rPre hsb rc.mU rc.gates rc.mYs rc.maskHs)))
  (DynamicCircuit.circuit (cOuterLoad rPre hsb rc.mU rc.mLs)).seq
    ((pSplitRBracket v uWire lW hW rDum wDum qEnc hInj inner).seq
      (DynamicCircuit.circuit (cOuterLoad rPre hsb rc.mU rc.mLs)))

theorem count_cLoadLChain {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45) (mLs : List ℕ) :
    ∀ (k : ℕ) (hk : k ≤ R),
      (cLoadLChain rPre hsb mLs k hk).count .T = 0 ∧
      (cLoadLChain rPre hsb mLs k hk).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | k + 1, hk => by
      obtain ⟨t1, f1⟩ := count_cLoadLChain rPre hsb mLs k (Nat.le_of_succ_le hk)
      obtain ⟨t2, f2⟩ := count_cXorMaskPre rPre ⟨186 + sb + k, by omega⟩ (mLs.getD k 0) 180 le_rfl
      dsimp only [cLoadLChain]
      exact ⟨by rw [Circuit.count_seq, t1, t2], by rw [Circuit.count_seq, f1, f2]⟩

theorem cw_cLoadLChain {n R sb : ℕ} {S : Wire n → Prop} (rPre : QRegister 276 n)
    (hr : ∀ j : Fin 276, S (rPre j)) (hsb : sb + R ≤ 45) (mLs : List ℕ) :
    ∀ (k : ℕ) (hk : k ≤ R), CircWires S (cLoadLChain rPre hsb mLs k hk)
  | 0, _ => trivial
  | k + 1, hk =>
    ⟨cw_cLoadLChain rPre hr hsb mLs k (Nat.le_of_succ_le hk), cw_cXorMaskPre rPre hr ⟨186 + sb + k,
        by omega⟩ (mLs.getD k 0) 180 le_rfl⟩

theorem count_cOuterLoad {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45) (mU : ℕ)
    (mLs : List ℕ) :
    (cOuterLoad rPre hsb mU mLs).count .T = 0 ∧ (cOuterLoad rPre hsb mU mLs).count .TOFF = 0 := by
  obtain ⟨t1, f1⟩ := count_cLoadLChain rPre hsb mLs R le_rfl
  obtain ⟨t2, f2⟩ := count_cXorMaskPre rPre ⟨182, by decide⟩ mU 180 le_rfl
  dsimp only [cOuterLoad]
  exact ⟨by rw [Circuit.count_seq, t1, t2], by rw [Circuit.count_seq, f1, f2]⟩

theorem cw_cOuterLoad {n R sb : ℕ} {S : Wire n → Prop} (rPre : QRegister 276 n)
    (hr : ∀ j : Fin 276, S (rPre j))
    (hsb : sb + R ≤ 45) (mU : ℕ) (mLs : List ℕ) : CircWires S (cOuterLoad rPre hsb mU mLs) :=
  ⟨cw_cLoadLChain rPre hr hsb mLs R le_rfl, cw_cXorMaskPre rPre hr ⟨182, by decide⟩ mU 180 le_rfl⟩

theorem count_cEnterGChain {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (gates mYs maskHs : List ℕ) :
    ∀ (k : ℕ) (hk : k ≤ R),
      (cEnterGChain rPre hsb gates mYs maskHs k hk).count .T = 0 ∧
      (cEnterGChain rPre hsb gates mYs maskHs k hk).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | k + 1, hk => by
      obtain ⟨t1, f1⟩ := count_cEnterGChain rPre hsb gates mYs maskHs k (Nat.le_of_succ_le hk)
      dsimp only [cEnterGChain]
      split_ifs with hg
      · obtain ⟨cT, cF⟩ := count_cXorHMask rPre hsb ⟨41 + gates.getD k 0, by omega⟩
          (by dsimp; omega) (maskHs.getD k 0) R le_rfl
        obtain ⟨t2, f2⟩ :=
            count_cXorMaskPre rPre ⟨41 + gates.getD k 0, by omega⟩ (mYs.getD k 0) 180 le_rfl
        exact ⟨by rw [Circuit.count_seq, Circuit.count_seq, t1, cT, t2],
               by rw [Circuit.count_seq, Circuit.count_seq, f1, cF, f2]⟩
      · exact ⟨t1, f1⟩

theorem cw_cEnterGChain {n R sb : ℕ} {S : Wire n → Prop} (rPre : QRegister 276 n)
    (hr : ∀ j : Fin 276, S (rPre j)) (hsb : sb + R ≤ 45) (gates mYs maskHs : List ℕ) :
    ∀ (k : ℕ) (hk : k ≤ R), CircWires S (cEnterGChain rPre hsb gates mYs maskHs k hk)
  | 0, _ => trivial
  | k + 1, hk => by
      have ih := cw_cEnterGChain rPre hr hsb gates mYs maskHs k (Nat.le_of_succ_le hk)
      dsimp only [cEnterGChain]
      split_ifs with hg
      · exact ⟨⟨ih, cw_cXorHMask rPre hr hsb ⟨41 + gates.getD k 0, by omega⟩
            (by simp only; omega) (maskHs.getD k 0) R le_rfl⟩,
               cw_cXorMaskPre rPre hr ⟨41 + gates.getD k 0, by omega⟩ (mYs.getD k 0) 180 le_rfl⟩
      · exact ih

theorem count_cInnerEnter {n R sb : ℕ} (rPre : QRegister 276 n) (hsb : sb + R ≤ 45) (mU : ℕ)
    (gates mYs maskHs : List ℕ) :
    (cInnerEnter rPre hsb mU gates mYs maskHs).count .T = 0 ∧
        (cInnerEnter rPre hsb mU gates mYs maskHs).count .TOFF = 0 := by
  obtain ⟨t1, f1⟩ := count_cEnterGChain rPre hsb gates mYs maskHs R le_rfl
  obtain ⟨t2, f2⟩ := count_cXorMaskPre rPre ⟨182, by decide⟩ mU 180 le_rfl
  dsimp only [cInnerEnter]
  exact ⟨by rw [Circuit.count_seq, t1, t2], by rw [Circuit.count_seq, f1, f2]⟩

theorem cw_cInnerEnter {n R sb : ℕ} {S : Wire n → Prop} (rPre : QRegister 276 n)
    (hr : ∀ j : Fin 276, S (rPre j))
    (hsb : sb + R ≤ 45) (mU : ℕ) (gates mYs maskHs : List ℕ) :
        CircWires S (cInnerEnter rPre hsb mU gates mYs maskHs) :=
  ⟨cw_cEnterGChain rPre hr hsb gates mYs maskHs R le_rfl, cw_cXorMaskPre rPre hr ⟨182,
      by decide⟩ mU 180 le_rfl⟩

theorem ket_cLoadLChain {n R sb : ℕ} [NeZero (2 ^ n)] (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (mLs : List ℕ) (γ : BitAssignment n) :
    ∀ (k : ℕ) (hk : k ≤ R), (cLoadLChain rPre hsb mLs k hk).eval.1.mulVec (ket γ) =
      ket (fun x ↦ match findBranchAux (fun b : Fin R ↦ rPre ⟨186 + sb + b.val,
          Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _) (by omega)⟩) x k hk with
        | some b =>
          γ x + maskParity (mLs.getD b.val 0)
              (fun u : Fin 180 ↦ γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
        | none => γ x)
  | 0, _ => by
      dsimp only [cLoadLChain, findBranchAux]
      simp only [Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec]
  | k + 1, hk => by
      let dst : Fin 276 := ⟨186 + sb + k, by omega⟩
      dsimp only [cLoadLChain]
      rw [eval_seq_mulVec, ket_cLoadLChain rPre hsb mLs γ k (Nat.le_of_succ_le hk),
          ket_cXorMaskPre rPre dst (mLs.getD k 0) (Or.inl (by dsimp [dst]; omega)) _ 180 le_rfl]
      refine congrArg ket (funext fun x ↦ ?_)
      dsimp only [findBranchAux]
      by_cases hx : x = rPre dst
      · rw [ite_eq_left hx, show x = rPre dst from hx, Function.update_self,
            maskParity_congr_support (mLs.getD k 0) _
              (fun u : Fin 180 ↦ γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
              (fun u _ _ ↦ by
                rw [findBranchAux_rPre_none rPre (Nat.le_of_succ_le hk)
                      fun b _ (h : u.val = 186 + sb + b.val) ↦ absurd u.isLt (by omega)]),
            findBranchAux_rPre_none rPre (Nat.le_of_succ_le hk) fun b hb (h : 186 + sb + k = 186 +
                sb + b.val) ↦ by omega]
      · rw [ite_eq_right hx, Function.update_of_ne (show x ≠ rPre dst from hx)]

theorem ket_cOuterLoad {n R sb : ℕ} [NeZero (2 ^ n)] (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (mU : ℕ) (mLs : List ℕ) (γ : BitAssignment n) :
    (cOuterLoad rPre hsb mU mLs).eval.1.mulVec (ket γ) =
      ket (fun x ↦ if x = rPre ⟨182, by decide⟩ then γ x + maskParity mU (fun u : Fin 180 ↦
          γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
        else match findBranch (fun b : Fin R ↦ rPre ⟨186 + sb + b.val,
            Nat.lt_of_lt_of_le (Nat.add_lt_add_left b.isLt _) (by omega)⟩) x with
        | some b =>
          γ x + maskParity (mLs.getD b.val 0)
              (fun u : Fin 180 ↦ γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
        | none => γ x) := by
  dsimp only [cOuterLoad, findBranch]
  rw [eval_seq_mulVec, ket_cLoadLChain rPre hsb mLs γ R le_rfl,
      ket_cXorMaskPre rPre ⟨182, by decide⟩ mU (Or.inl (by decide)) _ 180 le_rfl]
  refine congrArg ket (funext fun x ↦ ?_)
  rcases eq_or_ne x (rPre ⟨182, by decide⟩) with rfl | hxU
  · rw [ite_eq_left rfl, Function.update_self, maskParity_congr_support mU _
          (fun u : Fin 180 ↦ γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
          (fun u _ _ ↦ by
            rw [findBranchAux_rPre_none rPre le_rfl fun b _ (h : u.val = 186 + sb + b.val) ↦
                absurd u.isLt (by omega)]),
        findBranchAux_rPre_none rPre le_rfl fun b _ (h : 182 = 186 + sb + b.val) ↦ by omega]
  · rw [ite_eq_right hxU, Function.update_of_ne hxU]

theorem ket_cEnterGChain {n R sb : ℕ} [NeZero (2 ^ n)] (rPre : QRegister 276 n)
    (hsb : sb + R ≤ 45) (m : ℕ) (gates mYs maskHs : List ℕ)
    (hLenG : gates.length = R) (hPairNe : checkListPairwiseNe gates = true)
    (hGatesOk : ∀ j < R, gates.getD j 0 < 139 ∧ m.testBit (gates.getD j 0) = false)
    (hYsAllow : ∀ j < R, ((mYs.getD j 0) &&& (((1 <<< 42) - 1) ||| (m <<< 42))) == mYs.getD j 0)
    (γ : BitAssignment n) :
    let gW : Fin R → Wire n := fun b ↦
        rPre ⟨41 + gates.getD b.val 0,
        Nat.lt_of_lt_of_le (Nat.add_lt_add_left (hGatesOk b.val b.isLt).1 41) (by decide)⟩
    ∀ (k : ℕ) (hk : k ≤ R), (cEnterGChain rPre hsb gates mYs maskHs k hk).eval.1.mulVec (ket γ) =
      ket (fun x ↦ match findBranchAux gW x k hk with
        | some b => γ x + hMaskParity rPre hsb (maskHs.getD b.val 0) γ R +
            maskParity (mYs.getD b.val 0)
                (fun u : Fin 180 ↦ γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
        | none => γ x) := by
  intro gW k hk
  induction k with
  | zero =>
      dsimp only [cEnterGChain, findBranchAux]
      simp only [Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec]
  | succ k ih =>
      have hk0 := Nat.le_of_succ_le hk
      obtain ⟨hgLt, hgmFalse⟩ := hGatesOk k hk
      let gIdx : Fin 276 := ⟨41 + gates.getD k 0, by omega⟩
      let p180 (δ : BitAssignment n) (u : Fin 180) :=
          δ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)
      dsimp only [cEnterGChain]
      rw [dite_eq_left hgLt, eval_seq_mulVec, eval_seq_mulVec, ih hk0,
          ket_cXorHMask rPre hsb gIdx (by simp only [gIdx]; omega)
              (maskHs.getD k 0) _ R le_rfl,
          ket_cXorMaskPre rPre gIdx (mYs.getD k 0)
              (Or.inr (maskAllow_not_gateBit (hYsAllow k hk) hgmFalse)) _ 180 le_rfl]
      refine congrArg ket (funext fun x ↦ ?_)
      let γk : BitAssignment n := fun y ↦ match findBranchAux gW y k hk0 with
        | some b =>
          γ y + hMaskParity rPre hsb (maskHs.getD b.val 0) γ R + maskParity (mYs.getD b.val 0)
              (p180 γ) 180 le_rfl
        | none => γ y
      let γc :=
          Function.update γk (rPre gIdx)
          (γk (rPre gIdx) + hMaskParity rPre hsb (maskHs.getD k 0) γk R)
      dsimp only [findBranchAux]
      by_cases hx : x = gW ⟨k, hk⟩
      · change Function.update γc (rPre gIdx) (γc (rPre gIdx) + maskParity (mYs.getD k 0)
            (p180 γc) 180 le_rfl) x = _
        rw [ite_eq_left hx, show x = rPre gIdx from hx, Function.update_self,
            maskParity_congr_support (mYs.getD k 0) (p180 γc) (p180 γ) 180 le_rfl fun u _ hbt ↦ by
              have huNe (j : ℕ) (hj : j < R) (hv : u.val = 41 + gates.getD j 0) : False :=
                Bool.noConfusion (hbt.symm.trans ((congrArg (fun v ↦ (mYs.getD k 0).testBit (1 +
                    v)) hv).trans
                  (maskAllow_not_gateBit (hYsAllow k hk) (hGatesOk j hj).2)))
              dsimp only [p180, γc, γk, gIdx]
              rw [Function.update_of_ne (rPre.wires.injective.ne (Fin.ne_of_val_ne (huNe k hk))),
                  findBranchAux_rPre_none rPre hk0 fun b _ ↦ huNe b.val b.isLt]]
        dsimp only [γc, p180]
        rw [Function.update_self, show γk (rPre gIdx) = γ (rPre gIdx) by
              dsimp only [γk, gIdx]
              rw [findBranchAux_rPre_none rPre hk0 fun b hb (h : 41 + gates.getD k 0 = 41 +
                  gates.getD b.val 0) ↦ by
                rw [List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ (by omega)] at h
                exact pairwise_ne_of_check gates hPairNe k b.val (by omega) (by omega) (by omega)
                    (by omega)],
            hMaskParity_congr rPre hsb (maskHs.getD k 0) fun j ↦ by
              dsimp only [γk]
              rw [findBranchAux_rPre_none rPre hk0 fun b _ (h : 231 + sb + j.val = 41 +
                  gates.getD b.val 0) ↦
                absurd (hGatesOk b.val b.isLt).1 (by omega)]]
      · rw [ite_eq_right hx]
        change Function.update γc (rPre gIdx) _ x = γk x
        simp only [γc, Function.update_of_ne (show x ≠ rPre gIdx from hx)]

theorem ket_cInnerEnter {n R sb : ℕ} [NeZero (2 ^ n)] (rPre : QRegister 276 n) (hsb : sb + R ≤ 45)
    (m mU : ℕ) (gates mYs maskHs : List ℕ)
    (hLenG : gates.length = R) (hPairNe : checkListPairwiseNe gates = true)
    (hGatesOk : ∀ j < R, gates.getD j 0 < 139 ∧ m.testBit (gates.getD j 0) = false)
    (hYsAllow : ∀ j < R, ((mYs.getD j 0) &&& (((1 <<< 42) - 1) ||| (m <<< 42))) == mYs.getD j 0)
    (hUAllow : (mU &&& (((1 <<< 42) - 1) ||| (m <<< 42))) == mU) (γ : BitAssignment n) :
    (cInnerEnter rPre hsb mU gates mYs maskHs).eval.1.mulVec (ket γ) =
      ket (fun x ↦ if x = rPre ⟨182, by decide⟩ then γ x + maskParity mU (fun u : Fin 180 ↦
          γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
        else match findBranch (fun b : Fin R ↦ rPre ⟨41 + gates.getD b.val 0,
            Nat.lt_of_lt_of_le (Nat.add_lt_add_left (hGatesOk b.val b.isLt).1 41)
            (by decide)⟩) x with
        | some b => γ x + hMaskParity rPre hsb (maskHs.getD b.val 0) γ R +
            maskParity (mYs.getD b.val 0)
                (fun u : Fin 180 ↦ γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
        | none => γ x) := by
  dsimp only [cInnerEnter, findBranch]
  rw [eval_seq_mulVec,
      ket_cEnterGChain rPre hsb m gates mYs maskHs hLenG hPairNe hGatesOk hYsAllow γ R le_rfl,
      ket_cXorMaskPre rPre ⟨182, by decide⟩ mU (Or.inl (by decide)) _ 180 le_rfl]
  refine congrArg ket (funext fun x ↦ ?_)
  rcases eq_or_ne x (rPre ⟨182, by decide⟩) with rfl | hxU
  · rw [ite_eq_left rfl, Function.update_self, maskParity_congr_support mU _
          (fun u : Fin 180 ↦ γ (rPre ⟨u.val, Nat.lt_trans u.isLt (by decide)⟩)) 180 le_rfl
          (fun u _ hbt ↦ by
            rw [findBranchAux_rPre_none rPre le_rfl fun b _ (hv : u.val = 41 + gates.getD b.val 0) ↦
              Bool.noConfusion (hbt.symm.trans ((congrArg (fun v ↦ mU.testBit (1 + v)) hv).trans
                (maskAllow_not_gateBit hUAllow (hGatesOk b.val b.isLt).2)))]),
        findBranchAux_rPre_none rPre le_rfl
          fun b _ (h : 182 = 41 + gates.getD b.val 0) ↦ absurd (hGatesOk b.val b.isLt).1 (by omega)]
  · rw [ite_eq_right hxU, Function.update_of_ne hxU]

