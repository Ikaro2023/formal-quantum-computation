theorem cw_cAuxOuterLoad {n : ℕ} {S : Wire n → Prop} (rSrc : QRegister 193 n)
    (rAuxScr : QRegister 24 n) (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
