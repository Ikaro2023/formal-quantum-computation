    simp only [sL, Function.update_of_ne (hNeS a iu (by simp only [iu]; omega)),
      Function.update_of_ne (hNeS a i1 (by simp only [i1]; omega)),
      Function.update_of_ne (hNeS a i0 (by simp only [i0]; omega))]
  have hZL {stB : BitAssignment n → BitAssignment n} {δ : BitAssignment n}
