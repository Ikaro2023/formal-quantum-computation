theorem coreMasks_dom : (domKeepMask &&& coreMask0Sym96 == coreMask0Sym96) = true ∧
    (domKeepMask &&& coreMask1Sym96 == coreMask1Sym96) = true := by decide +kernel
theorem writeReg_comm_of_disj {a b n : ℕ} (rA : QRegister a n) (rB : QRegister b n)
    (hd : rA.DisjointWires rB) (β : BitAssignment n) (vA : Fin a → ZMod 2) (vB : Fin b → ZMod 2) :
    writeReg (writeReg β rA vA) rB vB = writeReg (writeReg β rB vB) rA vA := by
  funext x
  by_cases hxA : x ∈ Set.range rA.wires
  · obtain ⟨i, rfl⟩ := hxA
    have hnotB : rA i ∉ Set.range rB.wires := fun ⟨j, hj⟩ ↦ disj_ne hd i j hj.symm
    rw [writeReg_apply_of_not_mem _ rB _ _ hnotB, writeReg_apply_reg, writeReg_apply_reg]
  · by_cases hxB : x ∈ Set.range rB.wires
    · obtain ⟨j, rfl⟩ :=
          hxB; rw [writeReg_apply_reg, writeReg_apply_of_not_mem _ rA _ _ hxA, writeReg_apply_reg]
    · rw [writeReg_apply_of_not_mem _ rB _ _ hxB, writeReg_apply_of_not_mem _ rA _ _ hxA,
          writeReg_apply_of_not_mem _ rA _ _ hxA, writeReg_apply_of_not_mem _ rB _ _ hxB]

def sRevTail4 : Finset (Wire (41 + (143 + 3))) := (sXag 143 139).image (rCoreXag 143).wires
theorem sRevTail4_bounds {u : Wire (41 + (143 + 3))} (hu : u ∈ sRevTail4) : 41 + 139 ≤ u.val ∧
    u.val < 41 + 143 := by
  rcases Finset.mem_image.mp hu with ⟨v, hv, rfl⟩
  rcases Finset.mem_image.mp hv with ⟨j, hjF, rfl⟩
  have hjGe : 139 ≤ j.val := (Finset.mem_filter.mp hjF).2
  simp only [QRegister.block_apply_val, wXagGate]; omega

def cpRevTail4 : ComputeProg (41 + (143 + 3)) :=
  let p0 := mapCPSW (rCoreXag 143) (compileXagRange 143 139 rgates 4 (by decide))
  let p1 :=
      qXorMask1 (rCorePre 143) (wCoreM0 143) (disj_corePre_M0 143) coreMask0Sym96 (41 + 143)
      (corePre_width_le 143)
  let p2 :=
      qXorMask1 (rCorePre 143) (wCoreM1 143) (disj_corePre_M1 143) coreMask1Sym96 (41 + 143)
      (corePre_width_le 143)
  .seq (.seq (.seq p0 p1) p2) (.x (wCoreOne 143))

theorem cpRevTail4_spec : cpRevTail4.numAnd = 4 ∧ cpRevTail4.ValidProg ∅ sRevTail4 := by
  obtain ⟨hN, hF, hV⟩ := compileXagRange_spec 143 139 rgates 4 (by decide)
  have vp0 := validProg_mapCPSW (rCoreXag 143)
    (compileXagRange 143 139 rgates 4 (by decide)) (sXag 143 139) hV
  have fc0 : (mapCPSW (rCoreXag 143)
      (compileXagRange 143 139 rgates 4 (by decide))).finalClean sRevTail4 = ∅ := by
    rw [sRevTail4, ← finalClean_image_mapCPSW, hF];
    have h143 : 139 + 4 = 143 := rfl; rw [h143, sXag_self_empty, Finset.image_empty]
  have n1 :=
      numAnd_qXorMask1_zero (rCorePre 143) (wCoreM0 143)
      (disj_corePre_M0 143) coreMask0Sym96 (41 + 143)
      (corePre_width_le 143); have n2 :=
                                numAnd_qXorMask1_zero (rCorePre 143) (wCoreM1 143)
                                (disj_corePre_M1 143) coreMask1Sym96 (41 + 143)
                                (corePre_width_le 143); obtain ⟨fc1, vp1⟩ :=
                                valid_finalClean_qXorMask1 (rCorePre 143) (wCoreM0 143)
                                (disj_corePre_M0 143) coreMask0Sym96 ∅ (Finset.notMem_empty _)
                                (41 + 143) (corePre_width_le 143); obtain ⟨fc2, vp2⟩ :=
                                valid_finalClean_qXorMask1 (rCorePre 143) (wCoreM1 143)
                                (disj_corePre_M1 143) coreMask1Sym96 ∅ (Finset.notMem_empty _)
                                (41 + 143) (corePre_width_le 143); dsimp only [cpRevTail4,
                                ComputeProg.numAnd, ComputeProg.ValidProg,
                                ComputeProg.finalClean]; rw [numAnd_mapCPSW, hN, n1, n2, fc0, fc1,
                                fc2]
  exact ⟨by omega, ⟨⟨⟨vp0, vp1⟩, vp2⟩, Finset.notMem_empty _, Finset.notMem_empty _⟩⟩

theorem fwdBits_cpRevTail4_eq_cpRevCore (c : Fin (2 ^ 41))
    (α α₀ : BitAssignment (41 + (143 + 3)))
    (hαPre : ∀ u : Fin (41 + 139),
      α ⟨u.val, by omega⟩ =
        if decide (u.val ≠ 67 ∧ u.val ≠ 69) && (env139 c).testBit (1 + u.val) then 1 else 0)
    (hαHi : ∀ u : Fin (41 + (143 + 3)), 41 + 139 ≤ u.val → α u = 0)
    (hα0Coin : ∀ k : Fin 41, α₀ ⟨k.val, by omega⟩ = if c.val.testBit k.val then 1 else 0)
    (hα0Hi : ∀ k : Fin (143 + 3), α₀ ⟨41 + k.val, by omega⟩ = 0) :
    cpRevTail4.fwdBits α =
      domZeroBits (41 + (143 + 3))
        ((cpRevCore 143 rgates coreMask0Sym96 coreMask1Sym96).fwdBits α₀) := by
  have hr (k : Fin (41 + (143 + 2))) : rCoreXag 143 k = ⟨k.val, by omega⟩ :=
      Fin.ext (Nat.zero_add k.val)
  obtain ⟨_, _, hInv140⟩ := xagEnv_invariant c 143 rgates 139 (by decide)
  have hIn140 : (fun k : Fin (41 + (143 + 2)) ↦ α (rCoreXag 143 k)) =
      domZeroBits (41 + (143 + 2))
          ((compileXag 143 rgates 139 (by decide)).fwdBits (coinInitBits (143 + 2) c)) :=
    funext fun k ↦ by
      dsimp only [domZeroBits]
      rw [hInv140 k, ← env139_eq_rev c, hr k]
      by_cases hk : k.val < 41 + 139
      · rw [ite_eq_left hk, hαPre ⟨k.val, hk⟩]
        by_cases hdom : k.val = 67 ∨ k.val = 69 <;>
          simp [hdom, show (k.val ≠ 67 ∧ k.val ≠ 69) ↔ ¬(k.val = 67 ∨ k.val = 69) by omega]
      · rw [ite_eq_right hk, ite_eq_right (by omega)]
        exact hαHi ⟨k.val, Nat.lt_trans k.isLt (by decide)⟩ (Nat.le_of_not_lt hk)
  have hIn0 : (fun k : Fin (41 + (143 + 2)) ↦ α₀ (rCoreXag 143 k)) = coinInitBits (143 + 2) c :=
      funext fun k ↦ by
    rw [hr k]
    dsimp only [coinInitBits]
    by_cases hk : k.val < 41
    · exact (hα0Coin ⟨k.val, hk⟩).trans (ite_eq_left hk).symm
    · have _ := k.isLt
      exact ((congrArg α₀ (Fin.ext (show k.val = 41 + (k.val - 41) by omega))).trans
        (hα0Hi ⟨k.val - 41, by omega⟩)).trans (ite_eq_right hk).symm
  let p0Tail := mapCPSW (rCoreXag 143) (compileXagRange 143 139 rgates 4 (by decide))
  let p0Full := mapCPSW (rCoreXag 143) (compileXag 143 rgates 143 (self_le_nat 143))
  let p1 :=
      qXorMask1 (rCorePre 143) (wCoreM0 143) (disj_corePre_M0 143) coreMask0Sym96 (41 + 143)
      (corePre_width_le 143)
  let p2 :=
      qXorMask1 (rCorePre 143) (wCoreM1 143) (disj_corePre_M1 143) coreMask1Sym96 (41 + 143)
      (corePre_width_le 143)
  let βf := p2.fwdBits (p1.fwdBits (p0Full.fwdBits α₀))
  change (ComputeProg.x (wCoreOne 143)).fwdBits (p2.fwdBits (p1.fwdBits (p0Tail.fwdBits α))) =
    domZeroBits (41 + (143 + 3)) ((ComputeProg.x (wCoreOne 143)).fwdBits βf)
  rw [show p0Tail.fwdBits α = domZeroBits (41 + (143 + 3)) (p0Full.fwdBits α₀) from funext fun w ↦
      by
        by_cases hw : w.val < 41 + (143 + 2)
        · let k : Fin (41 + (143 + 2)) := ⟨w.val, hw⟩
          rw [show w = rCoreXag 143 k from (hr k).symm, fwdBits_mapCPSW_inside, hIn140,
              congrFun (fwdBits_compileXagRange_domZero 143 139 rgates (by decide) (by decide)
                  (by decide) c 4
                (by decide) (fun j hj ↦ rgates_tail4_dom ⟨j, hj⟩)) k]
          dsimp only [domZeroBits, p0Full]
          by_cases hdom : k.val = 67 ∨ k.val = 69 <;>
            simp [hdom, show (rCoreXag 143 k).val = k.val from Nat.zero_add k.val,
                fwdBits_mapCPSW_inside, hIn0]
        · have hOut : ∀ i : Fin (41 + (143 + 2)), w ≠ rCoreXag 143 i :=
            fun i e ↦ hw ((congrArg Fin.val (e.trans (hr i))).symm ▸ i.isLt)
          dsimp only [domZeroBits]
          rw [ite_eq_right (by omega), fwdBits_mapCPSW_outside _ _ α hOut,
              fwdBits_mapCPSW_outside _ _ α₀ hOut,
              show w = wCoreOne 143 from Fin.ext (by simp only [wCoreOne]; omega),
              hαHi (wCoreOne 143) (by simp only [wCoreOne]; omega)]
          exact ((congrArg α₀ (Fin.ext (by simp only [wCoreOne]))).trans (hα0Hi ⟨143 + 2,
              by omega⟩)).symm,
      fwdBits_qXorMask1_domZero (rCorePre 143) (wCoreM0 143)
          (disj_corePre_M0 143) coreMask0Sym96 (41 + 143)
        (corePre_width_le 143) (fun i ↦ Nat.zero_add i.val) (by simp [wCoreM0]) (by simp [wCoreM0])
            (by decide) coreMasks_dom.1,
      fwdBits_qXorMask1_domZero (rCorePre 143) (wCoreM1 143)
          (disj_corePre_M1 143) coreMask1Sym96 (41 + 143)
        (corePre_width_le 143) (fun i ↦ Nat.zero_add i.val) (by simp [wCoreM1]) (by simp [wCoreM1])
            (by decide) coreMasks_dom.2]
  dsimp only [ComputeProg.fwdBits]
  rw [show domZeroBits (41 + (143 + 3)) βf (wCoreOne 143) =
      βf (wCoreOne 143) from ite_eq_right (by simp [wCoreOne])]
  exact domZeroBits_update_of_ne βf (wCoreOne 143) _ (by simp [wCoreOne]) (by simp [wCoreOne])

def dRevInner {Var : Type} {n : ℕ} (v : Var) (rTot : QRegister dLayout n) : DynamicCircuit Var n :=
  let midPairs := fun j : Fin 32 ↦ compileBilinearPairs (midTermsSym96 j)
  let tailPairs := fun s : Fin 5 ↦ compileBilinearPairs (tailTermsSym96 s)
  let dTier1 :=
      xUnloadChunkCzPairsXSeqDyn v (outWireOfReg pos32 (rTot.compose rOutMid32)) 0 (fun s ↦
      midPreXSym96 ⟨s % 32, mod32_lt s⟩)
      (fun s ↦ wirePairsOfReg (rTot.compose (rMidPred 143 hM5_143)) (midPairs ⟨s % 32, mod32_lt s⟩))
      (.circuit .identity) 32
  let dTmpTier1 := wrapDynOnReg v (rTot.compose (rRevTmp 143 hM5_143)) cpRevTmp dTier1
  let dTier2 :=
      xUnloadChunkCzPairsXSeqDyn v (outWireOfReg pos5 (rTot.compose rOutTail5)) 0 (fun s ↦
      tailPreXSym96 ⟨s % 5, mod5_lt s⟩)
      (fun s ↦ wirePairsOfReg (rTot.compose (rTailPred 143 hM5_143)) (tailPairs ⟨s % 5, mod5_lt s⟩))
      (.circuit .identity) 5
  wrapDynOnReg v (rTot.compose (rRevCore 143 hM5_143)) cpRevTail4 (.seq dTmpTier1 dTier2)

theorem dw_dRevInner {Var : Type} {n : ℕ} {S : Wire n → Prop} (v : Var) (rTot : QRegister dLayout n)
    (hOuter : ∀ k : Fin 41, S (rTot (rOuter41Layout k)))
        (hOut40 : ∀ j : Fin 40, S (rTot (rOut40Layout j)))
    (hScr : ∀ k : Fin 1493, k.val < 148 → S (rTot (rScrCompact1493 k))) :
        DynWires S (dRevInner v rTot) := by
  have hMidPred (u : Fin (49 + 143)) : S ((rTot.compose (rMidPred 143 hM5_143)) u) := by
    have _ := u.isLt
    change S (rTot (midPredWireFn 143 hM5_143 u))
    dsimp only [midPredWireFn]
    split_ifs with _ _ h2 _
    · exact hScr _ (by dsimp only; omega)
    · exact hOuter _
    · have _ := Nat.le_of_ble_eq_true h2
      exact hScr _ (by dsimp only; omega)
    · exact hOut40 _
    · exact hScr _ (by dsimp only; omega)
  have hRevCore (i : Fin (41 + (143 + 3))) : S ((rTot.compose (rRevCore 143 hM5_143)) i) := by
    have _ := i.isLt
    change S (rTot (revCoreWireFn 143 hM5_143 i))
    dsimp only [revCoreWireFn]
    split_ifs with h
    · exact hOuter _
    · have _ : ¬i.val < 41 := fun l ↦ by simp [Nat.ble_eq_true_of_le l] at h
      exact hScr _ (by dsimp only; omega)
  have hRevTmp (i : Fin 6) : S ((rTot.compose (rRevTmp 143 hM5_143)) i) := by
    change S (rTot (revTmpWireFn 143 hM5_143 i))
    fin_cases i <;> dsimp only [revTmpWireFn] <;> first | exact hOut40 _ | exact hScr _ (by decide)
  have hPair {K} {rP : QRegister K n} (hP : ∀ u, S (rP u)) {ps} {p}
      (hp : p ∈ wirePairsOfReg rP ps) : S p.1 ∧ S p.2 :=
    let ⟨⟨u1, e1⟩, ⟨u2, e2⟩⟩ := wirePairsOfReg_mem _ _ p hp
    ⟨e1 ▸ hP u1, e2 ▸ hP u2⟩
  exact dynWires_wrapDynOnReg_local v _ hRevCore cpRevTail4 _ ⟨dynWires_wrapDynOnReg_local v _
      hRevTmp cpRevTmp _
      (dynWires_xUnloadChunkX v _ 0 _ _ (fun _ ↦ hOut40 _) (fun _ _ ↦ hPair hMidPred) 32),
     dynWires_xUnloadChunkX v _ 0 _ _ (fun _ ↦ hOut40 _)
       (fun _ _ ↦ hPair (rP := rTot.compose (rTailPred 143 hM5_143)) fun _ ↦ hMidPred _) 5⟩

theorem bitSign_xmu_eq (b : ZMod 2) : XMeasUnld.bitSign b = QubitizationWalkSem.bitSign b := by
  rcases DynCircExt.bit_cases b with rfl | rfl <;> rfl

/--
Sequential CNOT/X parity accumulator from an arbitrary-width source register `rSrc` into `dst` .
-/
def cXorMaskSrc {W n : ℕ} (rSrc : QRegister W n) (dst : Wire n)
    (hne : ∀ u : Fin W, rSrc u ≠ dst) (mask : ℕ) :
    (k : ℕ) → k ≤ W → Circuit n
  | 0, _ => if mask.testBit 0 then Circuit.X dst else .identity
  | k + 1, hk =>
      let prev := cXorMaskSrc rSrc dst hne mask k (Nat.le_of_succ_le hk)
      if mask.testBit (1 + k) then
        prev ;;ᶜ Circuit.CNOT (rSrc ⟨k, hk⟩) dst (hne ⟨k, hk⟩)
      else prev

theorem count_cXorMaskSrc {W n : ℕ} (rSrc : QRegister W n) (dst : Wire n)
    (hne : ∀ u : Fin W, rSrc u ≠ dst) (mask : ℕ) :
    ∀ (k : ℕ) (hk : k ≤ W),
      (cXorMaskSrc rSrc dst hne mask k hk).count .T = 0 ∧
      (cXorMaskSrc rSrc dst hne mask k hk).count .TOFF = 0
  | 0, _ => by
      dsimp only [cXorMaskSrc]
      split_ifs <;> simp [Circuit.X]
  | k + 1, hk => by
      obtain ⟨ht, hf⟩ := count_cXorMaskSrc rSrc dst hne mask k (Nat.le_of_succ_le hk)
      dsimp only [cXorMaskSrc]
      split_ifs <;> simp [ht, hf, Circuit.CNOT]

theorem cw_cXorMaskSrc {W n : ℕ} {S : Wire n → Prop} (rSrc : QRegister W n) (dst : Wire n)
    (hne : ∀ u : Fin W, rSrc u ≠ dst)
    (hSrc : ∀ u : Fin W, S (rSrc u)) (hDst : S dst) (mask : ℕ) :
    ∀ (k : ℕ) (hk : k ≤ W), CircWires S (cXorMaskSrc rSrc dst hne mask k hk)
  | 0, _ => by
      dsimp only [cXorMaskSrc]
      split_ifs
      · exact cw_1 hDst
      · trivial
  | k + 1, hk => by
      have ih := cw_cXorMaskSrc rSrc dst hne hSrc hDst mask k (Nat.le_of_succ_le hk)
      dsimp only [cXorMaskSrc]
      split_ifs
      · exact ⟨ih, cw_cnot (hSrc ⟨k, hk⟩) hDst⟩
      · exact ih

theorem ket_cXorMaskSrc {W n : ℕ} [NeZero (2 ^ n)] (rSrc : QRegister W n) (dst : Wire n)
    (hne : ∀ u : Fin W, rSrc u ≠ dst) (mask : ℕ) (γ : BitAssignment n) :
    ∀ (k : ℕ) (hk : k ≤ W),
      (cXorMaskSrc rSrc dst hne mask k hk).eval.1.mulVec (ket γ) =
        ket (Function.update γ dst
          (γ dst + maskParity mask (fun u : Fin W ↦ γ (rSrc u)) k hk))
  | 0, _ => by
      dsimp only [cXorMaskSrc, maskParity]
      cases mask.testBit 0 <;>
        simp only [Bool.false_eq_true, ↓reduceIte, Circuit.eval_identity, Submonoid.coe_one,
          Matrix.one_mulVec, add_zero, Function.update_eq_self, ket_X]
  | k + 1, hk => by
      have ih := ket_cXorMaskSrc rSrc dst hne mask γ k (Nat.le_of_succ_le hk)
      dsimp only [cXorMaskSrc, maskParity]
      cases mask.testBit (1 + k) <;>
        simp only [Bool.false_eq_true, ↓reduceIte, eval_seq_mulVec, ih, ket_CNOT,
          Function.update_of_ne (hne ⟨k, hk⟩), Function.update_self, Function.update_idem,
          add_zero, add_assoc]

abbrev cXorMaskSrc192 {n : ℕ} (rSrc : QRegister 192 n) (dst : Wire n)
    (hne : ∀ u : Fin 192, rSrc u ≠ dst) (mask : ℕ) (k : ℕ) (hk : k ≤ 192) : Circuit n :=
  cXorMaskSrc rSrc dst hne mask k hk

theorem count_cXorMaskSrc192 {n : ℕ} (rSrc : QRegister 192 n)
    (dst : Wire n) (hne : ∀ u : Fin 192, rSrc u ≠ dst) (mask k : ℕ)
    (hk : k ≤ 192) :
    (cXorMaskSrc192 rSrc dst hne mask k hk).count .T = 0 ∧
        (cXorMaskSrc192 rSrc dst hne mask k hk).count .TOFF = 0 :=
  count_cXorMaskSrc rSrc dst hne mask k hk
theorem cw_cXorMaskSrc192 {n : ℕ} {S : Wire n → Prop} (rSrc : QRegister 192 n)
    (dst : Wire n) (hne : ∀ u : Fin 192, rSrc u ≠ dst)
    (hSrc : ∀ u : Fin 192, S (rSrc u)) (hDst : S dst) (mask k : ℕ)
        (hk : k ≤ 192) : CircWires S (cXorMaskSrc192 rSrc dst hne mask k hk) :=
  cw_cXorMaskSrc rSrc dst hne hSrc hDst mask k hk
theorem ket_cXorMaskSrc192 {n : ℕ} [NeZero (2 ^ n)] (rSrc : QRegister 192 n) (dst : Wire n)
    (hne : ∀ u : Fin 192, rSrc u ≠ dst) (mask : ℕ) (γ : BitAssignment n) (k : ℕ) (hk : k ≤ 192) :
    (cXorMaskSrc192 rSrc dst hne mask k hk).eval.1.mulVec (ket γ) =
      ket (Function.update γ dst
        (γ dst + maskParity mask (fun u : Fin 192 ↦ γ (rSrc u)) k hk)) :=
  ket_cXorMaskSrc rSrc dst hne mask γ k hk

def cPhaseMaskSrc192 {n : ℕ} (rSrc : QRegister 192 n) (dst : Wire n)
    (hne : ∀ u : Fin 192, rSrc u ≠ dst) (mask : ℕ) : Circuit n :=
  (Circuit.H dst ;;ᶜ cXorMaskSrc192 rSrc dst hne mask 192 le_rfl) ;;ᶜ Circuit.H dst

theorem count_cPhaseMaskSrc192 {n : ℕ} (rSrc : QRegister 192 n) (dst : Wire n)
    (hne : ∀ u : Fin 192, rSrc u ≠ dst) (mask : ℕ) : (cPhaseMaskSrc192 rSrc dst hne mask).count .T =
    0 ∧ (cPhaseMaskSrc192 rSrc dst hne mask).count .TOFF = 0 := by
  obtain ⟨ht, hf⟩ :=
      count_cXorMaskSrc192 rSrc dst hne mask 192 le_rfl; dsimp only [cPhaseMaskSrc192]; simp [ht,
      hf, Circuit.H]
theorem cw_cPhaseMaskSrc192 {n : ℕ} {S : Wire n → Prop} (rSrc : QRegister 192 n) (dst : Wire n)
    (hne : ∀ u : Fin 192, rSrc u ≠ dst) (hSrc : ∀ u : Fin 192, S (rSrc u)) (hDst : S dst)
    (mask : ℕ) : CircWires S (cPhaseMaskSrc192 rSrc dst hne mask) :=
    ⟨⟨cw_1 hDst, cw_cXorMaskSrc192 rSrc dst hne hSrc hDst mask 192 le_rfl⟩, cw_1 hDst⟩
theorem ket_cPhaseMaskSrc192 {n : ℕ} [NeZero (2 ^ n)] (rSrc : QRegister 192 n) (dst : Wire n)
    (hne : ∀ u : Fin 192, rSrc u ≠ dst) (mask : ℕ) (β : BitAssignment n) :
    (cPhaseMaskSrc192 rSrc dst hne mask).eval.1.mulVec (ket β) =
    QubitizationWalkSem.bitSign (maskParity mask (fun u : Fin 192 ↦ β (rSrc u)) 192 le_rfl *
    β dst) • ket β := by
  let p := maskParity mask (fun u : Fin 192 ↦ β (rSrc u)) 192 le_rfl
  have hp0 : maskParity mask (fun u : Fin 192 ↦ Function.update β dst 0 (rSrc u)) 192 le_rfl = p :=
      maskParity_congr_support mask _ _ 192 le_rfl (fun u _ _ ↦ Function.update_of_ne (hne u) _ _)
  have hp1 : maskParity mask (fun u : Fin 192 ↦ Function.update β dst 1 (rSrc u)) 192 le_rfl = p :=
      maskParity_congr_support mask _ _ 192 le_rfl (fun u _ _ ↦ Function.update_of_ne (hne u) _ _)
  simp only [cPhaseMaskSrc192, eval_seq_mulVec, XMeasUnld.ket_H, Matrix.mulVec_smul,
      Matrix.mulVec_add, ket_cXorMaskSrc192, hp0, hp1, Function.update_self, Function.update_idem,
      zero_add]; rw [XMeasUnld.cz_Combine p (β dst), bitSign_xmu_eq]
  have hupd : (if β dst = 0 then ket (Function.update β dst 0) else ket (Function.update β dst 1)) =
      ket β := by
    have e := Function.update_eq_self dst β
    rcases XMeasUnld.bit_cases (β dst) with h₂ | h₂ <;> rw [h₂] at e ⊢ <;> simp [e]
  rw [hupd]

theorem step_hadamard_phase_kickback {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ}
    [NeZero (2 ^ n)]
    (rWork : QRegister W n) (uWire : Wire n) (huWork : ∀ q : Fin W, uWire ≠ rWork q)
    (st₀ : BitAssignment n → BitAssignment n) (ph₀ gBit : BitAssignment n → ZMod 2)
    (huId : ∀ δ, (∀ q, δ (rWork q) = 0) → st₀ δ uWire = δ uWire)
    (hstUpd : ∀ δ b, (∀ q, δ (rWork q) = 0) → st₀ (Function.update δ uWire b) =
        Function.update (st₀ δ) uWire b)
    (hphUpd : ∀ δ b, (∀ q, δ (rWork q) = 0) → ph₀ (Function.update δ uWire b) = ph₀ δ)
    (hgUpd : ∀ δ b, (∀ q, δ (rWork q) = 0) → gBit (Function.update δ uWire b) = gBit δ)
    (dInner : DynamicCircuit Var n)
    (hInner : SubspaceStep (mkKetOpW rWork st₀ ph₀)
        (mkKetOpW rWork st₀ (fun δ ↦ ph₀ δ + st₀ δ uWire * gBit δ)) dInner) :
    SubspaceStep (mkKetOpW rWork st₀ ph₀)
        (mkKetOpW rWork (fun δ ↦ Function.update (st₀ δ) uWire (st₀ δ uWire + gBit δ)) ph₀)
      (.seq (.circuit (.H uWire)) (.seq dInner (.circuit (.H uWire)))) := by
  let R₀ := mkKetOpW rWork st₀ ph₀
  let R₁ := mkKetOpW rWork st₀ (fun δ ↦ ph₀ δ + st₀ δ uWire * gBit δ)
  let R₂ := mkKetOpW rWork (fun δ ↦ Function.update (st₀ δ) uWire (st₀ δ uWire + gBit δ)) ph₀
  have hzbIff (β : BitAssignment n) (b : ZMod 2) : (∀ q, Function.update β uWire b (rWork q) = 0) ↔
      ∀ q, β (rWork q) = 0 :=
    forall_congr' fun q ↦ by rw [Function.update_of_ne (huWork q).symm]
  refine (subspaceStep_congr_out (subspaceStep_of_circuit (Var := Var) R₀ (.H uWire))
      (matrix_ext_ket fun β ↦ ?_)).seq
    ((subspaceStep_mul_right (Circuit.H uWire).eval.1 hInner).seq
      (subspaceStep_congr_out (subspaceStep_of_circuit (Var := Var) (R₁ * (Circuit.H uWire).eval.1)
          (.H uWire))
        (matrix_ext_ket fun β ↦ ?_)))
  · simp only [R₀, ← Matrix.mulVec_mulVec, XMeasUnld.ket_H, Matrix.mulVec_smul,
      Matrix.mulVec_add, mkKetOpW_mulVec_ket]
    by_cases hz : ∀ q, β (rWork q) = 0
    · rw [ite_eq_left hz, ite_eq_left ((hzbIff β 0).mpr hz), ite_eq_left ((hzbIff β 1).mpr hz),
          Matrix.mulVec_smul, XMeasUnld.ket_H, huId β hz, hstUpd β 0 hz, hstUpd β 1 hz,
          hphUpd β 0 hz, hphUpd β 1 hz]
      simp only [smul_add, smul_smul]
      exact congrArg₂ (· + ·) (congrArg (· • _) (mul_comm _ _)) (congrArg (· • _) (by ring))
    · simp [hz, (hzbIff β 0).not.mpr hz, (hzbIff β 1).not.mpr hz]
  · simp only [R₁, ← Matrix.mulVec_mulVec, XMeasUnld.ket_H, Matrix.mulVec_smul, Matrix.mulVec_add,
        mkKetOpW_mulVec_ket]
    by_cases hz : ∀ q, β (rWork q) = 0
    · rw [ite_eq_left ((hzbIff β 0).mpr hz), ite_eq_left ((hzbIff β 1).mpr hz), ite_eq_left hz,
          hstUpd β 0 hz, hstUpd β 1 hz, hphUpd β 0 hz, hphUpd β 1 hz, hgUpd β 0 hz, hgUpd β 1 hz]
      simp only [Function.update_self, zero_mul, one_mul, add_zero, Matrix.mulVec_smul,
          XMeasUnld.ket_H, Function.update_idem, ← bitSign_xmu_eq, XMeasUnld.bitSign_add]
      let ψ₀ := ket (Function.update (st₀ β) uWire 0)
      let ψ₁ := ket (Function.update (st₀ β) uWire 1)
      refine Eq.trans (b := XMeasUnld.bitSign (ph₀ β) • (XMeasUnld.sqrtHalf •
          (XMeasUnld.sqrtHalf • (ψ₀ + XMeasUnld.bitSign 0 • ψ₁) +
           XMeasUnld.bitSign (β uWire + gBit β) • (XMeasUnld.sqrtHalf •
             (ψ₀ + PhotochemistrySolution.XMeasUnld.bitSign (1 + 0) • ψ₁))))) (by
        rw [PhotochemistrySolution.XMeasUnld.bitSign_add (β uWire) (gBit β), add_zero]
        generalize XMeasUnld.sqrtHalf • (ψ₀ + XMeasUnld.bitSign 0 • ψ₁) = v₀,
          XMeasUnld.sqrtHalf • (ψ₀ + XMeasUnld.bitSign 1 • ψ₁) = v₁
        simp only [smul_add, smul_smul]
        exact congrArg₂ (· + ·) (congrArg (· • v₀) (by ring)) (congrArg (· • v₁) (by ring))) ?_
      rw [PhotochemistrySolution.XMeasUnld.cz_Combine 0 (β uWire + gBit β) ψ₀ ψ₁,
          show PhotochemistrySolution.XMeasUnld.bitSign (0 * (β uWire + gBit β)) = 1 from
            congrArg PhotochemistrySolution.XMeasUnld.bitSign (zero_mul _), one_smul, huId β hz]
      refine congrArg (PhotochemistrySolution.XMeasUnld.bitSign (ph₀ β) • ·) ?_
      rcases XMeasUnld.bit_cases (β uWire + gBit β) with h | h <;> rw [h] <;> simp [ψ₀, ψ₁]
    · simp [hz, (hzbIff β 0).not.mpr hz, (hzbIff β 1).not.mpr hz]

abbrev e151Dom (c : Fin (2 ^ 41)) : ℕ := e151 c &&& domKeepMask

theorem e151Dom_bit0 (c : Fin (2 ^ 41)) : (e151Dom c).testBit 0 = true := by
  rw [Nat.testBit_and, (xagEnv_invariant c 151 fgates 151 le_rfl).1,
      domKeepMask_testBit 0 (by decide)]
  rfl

theorem env151_maskParity {n : ℕ} (rSrc : QRegister 192 n) (c : Fin (2 ^ 41)) (γ : BitAssignment n)
    (hγ : ∀ u : Fin 192, γ (rSrc u) = if (e151Dom c).testBit (1 + u.val) then 1 else 0) (mask : ℕ)
    (hDom : (domKeepMask &&& mask == mask) = true) : maskParity mask (fun u : Fin 192 ↦
    γ (rSrc u)) 192 le_rfl = if bOf c mask then 1 else 0 := by
  let envFn : BitAssignment 192 := fun u ↦ if (e151Dom c).testBit (1 + u.val) then 1 else 0
  rw [maskParity_congr_support mask _ envFn 192 le_rfl (fun u _ _ ↦ hγ u),
      maskParity_eq_oddBits mask (e151Dom c) envFn
        (e151Dom_bit0 c) (fun _ ↦ rfl) 192 le_rfl]
  have hMaskEq : e151Dom c &&& mask = e151 c &&& mask := by
    dsimp only [e151Dom]; rw [Nat.and_assoc, beq_iff_eq.mp hDom]
  change (if oddBits (e151Dom c &&& mask) 193 then (1 : ZMod 2) else 0) = _
  rw [hMaskEq]; rfl

theorem dom_tail5Mask (k : Fin 5) : (domKeepMask &&& tail5Mask k == tail5Mask k) = true := by
  revert k; decide +kernel

/-! #### `cTail5Xor` (`0 T`, `0 .TOFF`) -/

def cTail5XorAux {n : ℕ} (rSrc : QRegister 192 n) (rO : QRegister 40 n)
    (hSrcO : ∀ (u : Fin 192) (q : Fin 40), rSrc u ≠ rO q) :
    (k : ℕ) → k ≤ 5 → Circuit n
  | 0, _ => .identity
  | k + 1, hk =>
      let s : Fin 5 := ⟨k, hk⟩
      let q : Fin 40 := ⟨tail5OutIdx s, tail5OutIdx_lt40 s⟩
      cTail5XorAux rSrc rO hSrcO k (Nat.le_of_succ_le hk) ;;ᶜ
        cXorMaskSrc192 rSrc (rO q) (fun u ↦ hSrcO u q) (tail5Mask s) 192 le_rfl

theorem count_cTail5XorAux {n : ℕ} (rSrc : QRegister 192 n) (rO : QRegister 40 n)
    (hSrcO : ∀ (u : Fin 192) (q : Fin 40), rSrc u ≠ rO q) :
    ∀ (k : ℕ) (hk : k ≤ 5),
      (cTail5XorAux rSrc rO hSrcO k hk).count .T = 0 ∧
      (cTail5XorAux rSrc rO hSrcO k hk).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | k + 1, hk => by
      obtain ⟨t1, f1⟩ := count_cTail5XorAux rSrc rO hSrcO k (Nat.le_of_succ_le hk)
      obtain ⟨t2, f2⟩ :=
          count_cXorMaskSrc192 rSrc (rO ⟨tail5OutIdx ⟨k, hk⟩, tail5OutIdx_lt40 ⟨k, hk⟩⟩)
          (fun u ↦ hSrcO u _) (tail5Mask ⟨k, hk⟩) 192 le_rfl
      dsimp only [cTail5XorAux]
      exact ⟨by rw [Circuit.count_seq, t1, t2], by rw [Circuit.count_seq, f1, f2]⟩

theorem cw_cTail5XorAux {n : ℕ} {S : Wire n → Prop} (rSrc : QRegister 192 n) (rO : QRegister 40 n)
    (hSrcO : ∀ (u : Fin 192) (q : Fin 40), rSrc u ≠ rO q)
    (hSrc : ∀ u : Fin 192, S (rSrc u)) (hO : ∀ q : Fin 40, S (rO q)) :
    ∀ (k : ℕ) (hk : k ≤ 5), CircWires S (cTail5XorAux rSrc rO hSrcO k hk)
  | 0, _ => trivial
  | k + 1, hk =>
      ⟨cw_cTail5XorAux rSrc rO hSrcO hSrc hO k (Nat.le_of_succ_le hk),
       cw_cXorMaskSrc192 rSrc _ _ hSrc (hO _) _ 192 le_rfl⟩

def stTail5Aux {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (β : BitAssignment n) :
    (k : ℕ) → k ≤ 5 → BitAssignment n
  | 0, _ => β
  | k + 1, hk =>
      let prev := stTail5Aux rO c β k (Nat.le_of_succ_le hk)
      let s : Fin 5 := ⟨k, hk⟩
      let uWire := rO ⟨tail5OutIdx s, tail5OutIdx_lt40 s⟩
      Function.update prev uWire
        (prev uWire + if preCnotBit40 (m40VOpt c) (tail5OutIdx s) then 1 else 0)

theorem stTail5Aux_outside_rO {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (β : BitAssignment n)
    {x : Wire n} (hx : ∀ q : Fin 40, x ≠ rO q) :
    ∀ (k : ℕ) (hk : k ≤ 5), stTail5Aux rO c β k hk x = β x
  | 0, _ => rfl
  | k + 1, hk =>
      (Function.update_of_ne (hx _) _ _).trans (stTail5Aux_outside_rO rO c β hx k (Nat.le_of_succ_le
          hk))

theorem stTail5Aux_other_rO {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (β : BitAssignment n)
    (q : Fin 40) :
    ∀ (k : ℕ) (hk : k ≤ 5), (∀ s : Fin 5, s.val < k → q.val ≠ tail5OutIdx s) →
      stTail5Aux rO c β k hk (rO q) = β (rO q)
  | 0, _, _ => rfl
  | k + 1, hk, hne =>
      (Function.update_of_ne (rO.wires.injective.ne fun e ↦ hne ⟨k, hk⟩ (Nat.lt_succ_self k)
          (congrArg Fin.val e)) _ _).trans
        (stTail5Aux_other_rO rO c β q k (Nat.le_of_succ_le hk) fun s hs ↦
            hne s (Nat.lt_succ_of_lt hs))

theorem stTail5Aux_hit {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (β : BitAssignment n)
    (s : Fin 5) :
    ∀ (k : ℕ) (hk : k ≤ 5), s.val < k →
      stTail5Aux rO c β k hk (rO ⟨tail5OutIdx s, tail5OutIdx_lt40 s⟩) =
        β (rO ⟨tail5OutIdx s, tail5OutIdx_lt40 s⟩) +
          if preCnotBit40 (m40VOpt c) (tail5OutIdx s) then 1 else 0
  | 0, _, hs => absurd hs (Nat.not_lt_zero _)
  | k + 1, hk, hs => by
      dsimp only [stTail5Aux]
      rcases eq_or_ne s ⟨k, hk⟩ with rfl | hne
      · rw [Function.update_self, stTail5Aux_other_rO rO c β _ k (Nat.le_of_succ_le hk)
            fun s' hs' e ↦ Nat.ne_of_lt hs' (congrArg Fin.val (tail5OutIdx_injective e.symm))]
      · rw [Function.update_of_ne (rO.wires.injective.ne fun e ↦
            hne (tail5OutIdx_injective (congrArg Fin.val e)))]
        exact stTail5Aux_hit rO c β s k (Nat.le_of_succ_le hk)
            (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ hs) (Fin.val_ne_of_ne hne))

theorem ket_cTail5XorAux {n : ℕ} [NeZero (2 ^ n)] (rSrc : QRegister 192 n) (rO : QRegister 40 n)
    (hSrcO : ∀ (u : Fin 192) (q : Fin 40), rSrc u ≠ rO q)
    (c : Fin (2 ^ 41)) (β : BitAssignment n)
    (hSrc : ∀ u : Fin 192, β (rSrc u) = if (e151Dom c).testBit (1 + u.val) then 1 else 0) :
    ∀ (k : ℕ) (hk : k ≤ 5),
      (cTail5XorAux rSrc rO hSrcO k hk).eval.1.mulVec (ket β) = ket (stTail5Aux rO c β k hk)
  | 0, _ => by
      simp only [cTail5XorAux, stTail5Aux, Circuit.eval_identity, Submonoid.coe_one,
          Matrix.one_mulVec]
  | k + 1, hk => by
      dsimp only [cTail5XorAux, stTail5Aux]
      rw [eval_seq_mulVec, ket_cTail5XorAux rSrc rO hSrcO c β hSrc k (Nat.le_of_succ_le hk),
          ket_cXorMaskSrc192, env151_maskParity rSrc c _ (fun u ↦
            (stTail5Aux_outside_rO rO c β (hSrcO u) k (Nat.le_of_succ_le hk)).trans (hSrc u))
            (tail5Mask ⟨k, hk⟩) (dom_tail5Mask ⟨k, hk⟩), bOf_tail5 c ⟨k, hk⟩]

/-! #### 32-Step W-Router Gather Chain (`212 T`, `0 .TOFF`) -/

theorem zmod2_gather_step_eq (p l y : Bool) (uVal : ZMod 2) : uVal *
    (if p then (1 : ZMod 2) else 0) + (if y then 1 else 0) * ((if l then 1 else 0) * uVal) = uVal *
    (if xor p (l && y) then 1 else 0) := by
  cases p <;> cases l <;> cases y <;>
    rcases PhotochemistrySolution.XMeasUnld.bit_cases uVal with rfl | rfl <;>
    decide

theorem stTail5Aux_upd_other {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (β : BitAssignment n)
    (q : Fin 40) (b : ZMod 2) :
    ∀ (k : ℕ) (hk : k ≤ 5), (∀ s : Fin 5, s.val < k → q.val ≠ tail5OutIdx s) →
      stTail5Aux rO c (Function.update β (rO q) b) k hk =
        Function.update (stTail5Aux rO c β k hk) (rO q) b
  | 0, _, _ => rfl
  | k + 1, hk, hne => by
      dsimp only [stTail5Aux]
      have hqk : rO ⟨tail5OutIdx ⟨k, hk⟩, tail5OutIdx_lt40 ⟨k, hk⟩⟩ ≠ rO q :=
        rO.wires.injective.ne fun e ↦ hne ⟨k, hk⟩ (by dsimp; omega) (congrArg Fin.val e.symm)
      rw [stTail5Aux_upd_other rO c β q b k (Nat.le_of_succ_le hk)
          (fun s hs ↦ hne s (Nat.lt_succ_of_lt hs)), Function.update_of_ne hqk,
          Function.update_comm hqk]

theorem coinOfAmb_congr {n : ℕ} (rTot : QRegister dLayout n) (δ₁ δ₂ : BitAssignment n)
    (h : ∀ k : Fin 41, δ₁ (rTot (rOuter41Layout k)) = δ₂ (rTot (rOuter41Layout k))) :
    coinOfAmb rTot δ₁ = coinOfAmb rTot δ₂ := by
  refine Fin.ext (Nat.eq_of_testBit_eq fun k ↦ ?_)
  by_cases hk : k < 41
  · have hb :=
        (coinOfAmb_bit rTot δ₁ ⟨k, hk⟩).symm.trans ((h ⟨k, hk⟩).trans (coinOfAmb_bit rTot δ₂ ⟨k,
        hk⟩))
    dsimp only at hb
    cases h1 : (coinOfAmb rTot δ₁).val.testBit k <;> cases h2 :
        (coinOfAmb rTot δ₂).val.testBit k <;>
      simp only [h1, h2] at hb <;> first | rfl | exact absurd hb (by decide)
  · rw [Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (coinOfAmb rTot δ₁).isLt (Nat.pow_le_pow_right
        (by omega) (by omega))),
        Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (coinOfAmb rTot δ₂).isLt (Nat.pow_le_pow_right
            (by omega) (by omega)))]

theorem mid32OutIdx_ne_pureZero (j : Fin 32) : mid32OutIdx j ≠ 35 ∧ mid32OutIdx j ≠ 32 ∧
    mid32OutIdx j ≠ 34 := by
  fin_cases j <;> decide

theorem tail5OutIdx_ne_pureZero (s : Fin 5) : tail5OutIdx s ≠ 35 ∧ tail5OutIdx s ≠ 32 ∧
    tail5OutIdx s ≠ 34 := by
  fin_cases s <;> decide


def preCnotBitFn (f : ℕ → Bool) (k : ℕ) : Bool :=
    xor (f k) (Stage1AsymRevEngine.rawCnotXorSrcs k Stage1AsymRevEngine.preCnotRawPairs40 f)
theorem rawCnotXorSrcs_congr_mem {j : ℕ} {f g : ℕ → Bool} :
    ∀ (ps : List (ℕ × ℕ)), (∀ p ∈ ps, f p.1 = g p.1) →
      PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps f =
        PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps g
  | [], _ => rfl
  | p :: ps, h => by
      dsimp only [PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs]
      rw [h p List.mem_cons_self, rawCnotXorSrcs_congr_mem ps (fun q hq ↦
          h q (List.mem_cons_of_mem p hq))]

theorem rawCnotXorSrcs_eq_false {j : ℕ} (f : ℕ → Bool) :
    ∀ (ps : List (ℕ × ℕ)), (∀ q ∈ ps, (q.2 == j) = false) →
      PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps f = false
  | [], _ => rfl
  | q :: qs, h => by
      dsimp only [PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs]
      rw [h q List.mem_cons_self, rawCnotXorSrcs_eq_false f qs (fun r hr ↦
          h r (List.mem_cons_of_mem q hr))]
      rfl

theorem rawCnotXorSrcs_xor (j : ℕ) (f g : ℕ → Bool) :
    ∀ (ps : List (ℕ × ℕ)),
      PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps (fun k ↦ xor (f k) (g k)) =
        xor (PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps f)
            (PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps g)
  | [] => rfl
  | p :: ps => by
      dsimp only [Stage1AsymRevEngine.rawCnotXorSrcs]; rw [rawCnotXorSrcs_xor j f g ps]
      cases (p.2 == j) <;> cases (f p.1) <;> cases (g p.1) <;>
        cases (PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps f) <;>
        cases (PhotochemistrySolution.Stage1AsymRevEngine.rawCnotXorSrcs j ps g) <;> rfl

theorem preCnot40_src_lt40 :
    ∀ p ∈ PhotochemistrySolution.Stage1AsymRevEngine.preCnotRawPairs40, p.1 < 40 := by decide

theorem preCnot40_src_not_dst :
    ∀ p ∈ PhotochemistrySolution.Stage1AsymRevEngine.preCnotRawPairs40,
      ∀ q ∈ Stage1AsymRevEngine.preCnotRawPairs40, (q.2 == p.1) = false := by decide

theorem preCnotBitFn_congr_lt40 {f g : ℕ → Bool} (h : ∀ u : Fin 40, f u.val = g u.val)
    (u : Fin 40) : preCnotBitFn f u.val = preCnotBitFn g u.val := by
  dsimp only [preCnotBitFn]
  rw [h u, rawCnotXorSrcs_congr_mem _ (fun p hp ↦ h ⟨p.1, preCnot40_src_lt40 p hp⟩)]

theorem preCnotBitFn_invol (f : ℕ → Bool) (k : ℕ) : preCnotBitFn (preCnotBitFn f) k = f k := by
  have hSrc : ∀ p ∈ PhotochemistrySolution.Stage1AsymRevEngine.preCnotRawPairs40,
      preCnotBitFn f p.1 = f p.1 := fun p hp ↦ by
    dsimp only [preCnotBitFn];
    rw [rawCnotXorSrcs_eq_false f _ (preCnot40_src_not_dst p hp), Bool.xor_false]
  have hCongr :
      Stage1AsymRevEngine.rawCnotXorSrcs k Stage1AsymRevEngine.preCnotRawPairs40 (preCnotBitFn f) =
      Stage1AsymRevEngine.rawCnotXorSrcs k Stage1AsymRevEngine.preCnotRawPairs40 f :=
      rawCnotXorSrcs_congr_mem _ hSrc; change xor (preCnotBitFn f k)
      (Stage1AsymRevEngine.rawCnotXorSrcs k Stage1AsymRevEngine.preCnotRawPairs40 (preCnotBitFn f))
      = f k; rw [hCongr]; dsimp only [preCnotBitFn]
  cases (f k) <;>
    cases (Stage1AsymRevEngine.rawCnotXorSrcs k Stage1AsymRevEngine.preCnotRawPairs40 f) <;> rfl

theorem preCnotBitFn_xor (f g : ℕ → Bool) (k : ℕ) : preCnotBitFn (fun i ↦ xor (f i) (g i)) k =
    xor (preCnotBitFn f k) (preCnotBitFn g k) := by
  dsimp only [preCnotBitFn]; rw [rawCnotXorSrcs_xor]
  cases (f k) <;> cases (g k) <;>
    cases (Stage1AsymRevEngine.rawCnotXorSrcs k Stage1AsymRevEngine.preCnotRawPairs40 f) <;>
    cases (Stage1AsymRevEngine.rawCnotXorSrcs k Stage1AsymRevEngine.preCnotRawPairs40 g) <;> rfl

def stPreCnot {n : ℕ} (rO : QRegister 40 n) (β : BitAssignment n) : BitAssignment n :=
    Stage1AsymRevEngine.applyCnotPairs (Stage1AsymRevEngine.cnotWirePairsOfReg rO
    Stage1AsymRevEngine.preCnotRawPairs40) β
