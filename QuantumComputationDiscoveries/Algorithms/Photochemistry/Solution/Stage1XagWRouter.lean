theorem oddBits_eq_shared (x : ℕ) :
    ∀ n, oddBits x n = PhotochemistrySolution.Stage1MaskEngine.oddBits x n
  | 0 => rfl
  | n + 1 => by
      simp [PhotochemistrySolution.CoinWrap.oddBits,
          PhotochemistrySolution.Stage1MaskEngine.oddBits,
        oddBits_eq_shared x n]

theorem oddBits_zero (n : ℕ) : oddBits 0 n = false :=
  (oddBits_eq_shared 0 n).trans (PhotochemistrySolution.Stage1MaskEngine.oddBits_zero n)

theorem oddBits_congr_low (x y n : ℕ) (h : ∀ i < n, x.testBit i = y.testBit i) :
    oddBits x n = oddBits y n := by
  rw [oddBits_eq_shared, oddBits_eq_shared]
  exact PhotochemistrySolution.Stage1MaskEngine.oddBits_congr_low x y n h

theorem oddBits_and_xor (e a b n : ℕ) :
    oddBits (e &&& (a ^^^ b)) n = xor (oddBits (e &&& a) n) (oddBits (e &&& b) n) := by
  simp only [oddBits_eq_shared]
  exact PhotochemistrySolution.Stage1MaskEngine.oddBits_and_xor e a b n

theorem oddBits_and_eq_of_lt_two_pow {e mask m n : ℕ} (h : mask < 2 ^ m) (hmn : m ≤ n) :
    oddBits (e &&& mask) n = oddBits (e &&& mask) m := by
  simp only [oddBits_eq_shared]
  exact PhotochemistrySolution.Stage1MaskEngine.oddBits_and_eq_of_lt_two_pow h hmn

theorem oddBits_single_bit (e b n : ℕ) (hb : b < n) :
    oddBits (e &&& (1 <<< b)) n = e.testBit b :=
  (oddBits_eq_shared _ n).trans (Stage1MaskEngine.oddBits_single_bit e b n hb)

theorem testBit_evalCoordVec (ones : ℕ) (cols : List ℕ) (f : ℕ → Bool) (z M n : ℕ)
    (cd : Bool × ℕ) (hOnes : ones.testBit z = true) (hn : n ≤ M)
    (hf : ∀ i < n, (cols.getD i 0).testBit z = f i) :
    (evalCoordVec ones cols n cd).testBit z = xor cd.1 (oddBits (packBits f M &&& cd.2) n) := by
  rw [oddBits_eq_shared]
  exact Stage1MaskEngine.testBit_evalCoordVec ones cols f z M n cd hOnes hn hf

/-- Bit-packed state vector over `(basis, exp)` at environment bit-width `W`. -/
def envStGen (W : ℕ) (basis exp : List ℕ) (env : ℕ) : ℕ :=
  packBits (fun i ↦
    if i < basis.length then oddBits (env &&& basis.getD i 0) W
    else env.testBit (42 + exp.getD (i - basis.length) 0)) (basis.length + exp.length)

abbrev envSt : List ℕ → List ℕ → ℕ → ℕ := envStGen 181

theorem reconMaskAux_oddBitsGen {G W : ℕ} (hGW : 42 + G ≤ W) {basis exp : List ℕ} {env : ℕ}
    (hexp : ∀ i < exp.length, exp.getD i 0 < G) (comb : ℕ) :
    ∀ (m : ℕ), m ≤ basis.length + exp.length →
      oddBits (envStGen W basis exp env &&& comb) m =
        oddBits (env &&& reconMaskAux (fun i ↦
          if i < basis.length then basis.getD i 0
          else 1 <<< (42 + exp.getD (i - basis.length) 0)) comb m) W
  | 0, _ => by simp [reconMaskAux, oddBits, oddBits_zero]
  | m + 1, hm => by
      dsimp only [reconMaskAux]
      rw [show oddBits (envStGen W basis exp env &&& comb)
          (m + 1) = xor (oddBits (envStGen W basis exp env &&& comb) m)
              ((envStGen W basis exp env &&& comb).testBit m) from rfl,
          oddBits_and_xor, reconMaskAux_oddBitsGen hGW hexp comb m (Nat.le_of_succ_le hm)]
      refine congrArg (xor _) ?_
      dsimp only [envStGen]
      rw [Nat.testBit_and, testBit_packBits, ite_eq_left (by omega : m < basis.length + exp.length)]
      cases comb.testBit m
      · simp [oddBits_zero]
      · rw [Bool.and_true, ite_eq_left rfl]
        split_ifs with hb
        · rfl
        · have _ := hexp (m - basis.length) (by omega)
          exact (oddBits_single_bit env _ W (by omega)).symm

theorem reconMask_oddBitsGen {G W : ℕ} (hGW : 42 + G ≤ W) {basis exp : List ℕ} {env : ℕ}
    (h0 : env.testBit 0 = true)
    (hexp : ∀ i < exp.length, exp.getD i 0 < G) (c0 : Bool) (comb : ℕ) :
    xor c0 (oddBits (envStGen W basis exp env &&& comb) (basis.length + exp.length)) = oddBits
      (env &&& reconMask basis exp c0 comb) W := by
  dsimp only [reconMask]
  rw [oddBits_and_xor, reconMaskAux_oddBitsGen hGW hexp comb (basis.length + exp.length) le_rfl]
  cases c0
  · rw [ite_eq_right Bool.false_ne_true, Nat.and_zero, oddBits_zero]
  · rw [ite_eq_left rfl, show (1 : ℕ) = 1 <<< 0 from rfl, oddBits_single_bit env 0 W (by omega), h0]

theorem reconMask_oddBits {basis exp : List ℕ} {env : ℕ}
    (h0 : env.testBit 0 = true) (hexp : ∀ i < exp.length, exp.getD i 0 < 139) (c0 : Bool)
        (comb : ℕ) :
    xor c0 (oddBits (envSt basis exp env &&& comb) (basis.length + exp.length)) =
      oddBits (env &&& reconMask basis exp c0 comb) 181 :=
  reconMask_oddBitsGen (by decide : 42 + 139 ≤ 181) h0 hexp c0 comb

/-- Boolean XAG certificate checker parameterized by gate-index bound `G`. -/
def checkCertGen (G : ℕ) (gates : ℕ → ℕ × ℕ) (basis exp : List ℕ)
    (gcs : List ((Bool × ℕ) × (Bool × ℕ))) : Bool :=
  let K := basis.length
  let E := exp.length
  (gcs.length == E) &&
  (List.range E).all fun e ↦
    let g := exp.getD e 0
    let gc := gcs.getD e ((false, 0), (false, 0))
    let p := gates g
    decide (g < G) &&
    decide (gc.1.2 < 2 ^ (K + e)) &&
    decide (gc.2.2 < 2 ^ (K + e)) &&
    decide (p.1 < 2 ^ (42 + g)) &&
    decide (p.2 < 2 ^ (42 + g)) &&
    decide (reconMask basis exp gc.1.1 gc.1.2 = p.1) &&
    decide (reconMask basis exp gc.2.1 gc.2.2 = p.2)

abbrev checkCert : (ℕ → ℕ × ℕ) → List ℕ → List ℕ → List ((Bool × ℕ) × (Bool × ℕ)) → Bool :=
  checkCertGen 139

theorem checkCertGen_exp_lt {G : ℕ} {gates : ℕ → ℕ × ℕ}
    {basis exp : List ℕ} {gcs : List ((Bool × ℕ) × (Bool × ℕ))}
    (hCert : checkCertGen G gates basis exp gcs = true)
    (i : ℕ) (hi : i < exp.length) : exp.getD i 0 < G := by
  unfold checkCertGen at hCert
  have hiB := (List.all_eq_true.mp (Bool.and_eq_true_iff.mp hCert).2) i (List.mem_range.mpr hi)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hiB
  exact hiB.1.1.1.1.1.1

def evalCoord (K E : ℕ) (st : ℕ) (c : Bool × ℕ) : Bool := xor c.1 (oddBits (st &&& c.2) (K + E))

theorem simVecIdx_invGen {G W : ℕ} (hGW : 42 + G ≤ W) {gates : ℕ → ℕ × ℕ}
    {basis exp : List ℕ} {gcs : List ((Bool × ℕ) × (Bool × ℕ))}
    {env ones z0 : ℕ} (hCert : checkCertGen G gates basis exp gcs = true)
    (h0 : env.testBit 0 = true) (hOnes : ones.testBit z0 = true)
    (hGates : ∀ e < exp.length, env.testBit (42 + exp.getD e 0) =
    (oddBits (env &&& (gates (exp.getD e 0)).1) (42 + exp.getD e 0) && oddBits
    (env &&& (gates (exp.getD e 0)).2) (42 + exp.getD e 0))) :
    ∀ (d e : ℕ), e + d = exp.length → ∀ (cols : List ℕ), cols.length =
    basis.length + e →
      (∀ i < basis.length + e, (cols.getD i 0).testBit z0 =
    (if i < basis.length then oddBits
        (env &&& basis.getD i 0) W else env.testBit (42 + exp.getD (i - basis.length) 0))) →
      ∀ i < basis.length + exp.length,
          ((simVecIdx (basis.length + e) ones cols (gcs.drop e)).getD i 0).testBit z0 =
        (if i < basis.length then oddBits (env &&& basis.getD i 0) W else env.testBit
    (42 + exp.getD (i - basis.length) 0))
  | 0, e, hed, cols, _, hcols => by
      have _ := beq_iff_eq.mp (Bool.and_eq_true_iff.mp (hCert : (_ && _) = true)).1
      obtain rfl : e = exp.length := by omega
      rwa [List.drop_eq_nil_of_le (by omega : gcs.length ≤ exp.length)]
  | d + 1, e, hed, cols, hlen, hcols => by
      have _ := beq_iff_eq.mp (Bool.and_eq_true_iff.mp (hCert : (_ && _) = true)).1
      have he : e < exp.length := by omega
      have heB :=
          (List.all_eq_true.mp (Bool.and_eq_true_iff.mp (hCert : (_ && _) =
          true)).2) e (List.mem_range.mpr he)
      simp only [Bool.and_eq_true, decide_eq_true_eq] at heB
      rcases heB with ⟨⟨⟨⟨⟨⟨_, hmL⟩, hmR⟩, hp1⟩, hp2⟩, hr1⟩, hr2⟩
      rw [list_drop_eq_getD_cons gcs e (by omega)]
      dsimp only [simVecIdx]
      let gc := gcs.getD e ((false, 0), (false, 0))
      have hvSide (cd : Bool × ℕ) (pSide : ℕ) (hm : cd.2 < 2 ^ (basis.length + e))
          (hp : pSide < 2 ^ (42 + exp.getD e 0)) (hr : reconMask basis exp cd.1 cd.2 = pSide) :
          (evalCoordVec ones cols (basis.length + e) cd).testBit z0 = oddBits (env &&& pSide)
              (42 + exp.getD e 0) := by
        rw [testBit_evalCoordVec ones _ _ z0 (basis.length + exp.length)
            (basis.length + e) cd hOnes (by omega) hcols]
        change xor cd.1 (oddBits (envStGen W basis exp env &&& cd.2) (basis.length + e)) = _
        rw [← oddBits_and_eq_of_lt_two_pow hm
            (by omega : basis.length + e ≤ basis.length + exp.length),
            reconMask_oddBitsGen hGW h0 (checkCertGen_exp_lt hCert), hr,
            oddBits_and_eq_of_lt_two_pow hp (by omega : 42 + exp.getD e 0 ≤ W)]
      rw [show (basis.length + e) + 1 = basis.length + (e + 1) by omega]
      refine simVecIdx_invGen hGW hCert h0 hOnes hGates d (e + 1) (by omega) _
        (by rw [List.length_append, List.length_singleton, hlen, Nat.add_assoc]) fun i hi ↦ ?_
      rw [getD_append_singleton, hlen]
      by_cases hiLt : i < basis.length + e
      · exact (congrArg (Nat.testBit · z0) (ite_eq_left hiLt)).trans (hcols i hiLt)
      · obtain rfl : i = basis.length + e := by omega
        rw [ite_eq_right hiLt, ite_eq_left rfl, Nat.testBit_and, hvSide gc.1 _ hmL hp1 hr1,
            hvSide gc.2 _ hmR hp2 hr2, ← hGates e he, ite_eq_right (by omega),
                Nat.add_sub_cancel_left]


theorem simVecIdx_evalCoord_eqGen {G W : ℕ} (hGW : 42 + G ≤ W)
    {gates : ℕ → ℕ × ℕ} {basis exp : List ℕ} {gcs : List ((Bool × ℕ) ×
  (Bool × ℕ))} {env : ℕ}
    (hCert : checkCertGen G gates basis exp gcs = true)
    (h0 : env.testBit 0 = true)
    (hGates : ∀ e < exp.length, env.testBit (42 + exp.getD e 0) =
    (oddBits (env &&& (gates (exp.getD e 0)).1) (42 + exp.getD e 0) && oddBits
    (env &&& (gates (exp.getD e 0)).2) (42 + exp.getD e 0))) :
    let z0 := packBits (fun i ↦ oddBits (env &&& basis.getD i 0) W) basis.length
    let p := initCols basis.length
    let cols := simVecIdx basis.length p.1 p.2 gcs
    p.1.testBit z0 = true ∧ ∀ cd : Bool × ℕ, (evalCoordVec p.1 cols (basis.length +
      exp.length) cd).testBit z0 =
          evalCoord basis.length exp.length (envStGen W basis exp env) cd := by
  let z0 := packBits (fun i ↦ oddBits (env &&& basis.getD i 0) W) basis.length
  have hz0 : z0 < 2 ^ basis.length := packBits_lt_two_pow _ basis.length
  have hOnes : (initCols basis.length).1.testBit z0 = true := by
    rw [initCols_ones_bit, decide_eq_true hz0]
  have hCols :=
      simVecIdx_invGen hGW hCert h0 hOnes hGates exp.length 0 (Nat.zero_add _)
      (initCols basis.length).2
    (by rw [initCols_length, Nat.add_zero]) fun i hi ↦ by
      rw [Nat.add_zero] at hi
      rw [initCols_col_bit basis.length i z0 hi, decide_eq_true hz0, Bool.true_and,
          testBit_packBits, ite_eq_left hi, ite_eq_left hi]
  simp only [Nat.add_zero, List.drop_zero] at hCols
  exact ⟨hOnes, fun cd ↦
      testBit_evalCoordVec (initCols basis.length).1 _ _ z0 _ _ cd hOnes le_rfl hCols⟩

theorem simVecIdx_evalCoord_eq {gates : ℕ → ℕ × ℕ} {basis exp : List ℕ}
    {gcs : List ((Bool × ℕ) × (Bool × ℕ))} {env : ℕ}
    (hCert : checkCert gates basis exp gcs = true)
    (h0 : env.testBit 0 = true)
    (hGates : ∀ e < exp.length,
      let g := exp.getD e 0
      env.testBit (42 + g) =
        (oddBits (env &&& (gates g).1) (42 + g) && oddBits (env &&& (gates g).2) (42 + g))) :
    let z0 := packBits (fun i ↦ oddBits (env &&& basis.getD i 0) 181) basis.length
    let p := initCols basis.length
    let cols := simVecIdx basis.length p.1 p.2 gcs
    p.1.testBit z0 = true ∧ ∀ cd : Bool × ℕ, (evalCoordVec p.1 cols (basis.length +
      exp.length) cd).testBit z0 = evalCoord basis.length exp.length (envSt basis exp env) cd :=
  simVecIdx_evalCoord_eqGen (by decide : 42 + 139 ≤ 181) hCert h0 hGates

