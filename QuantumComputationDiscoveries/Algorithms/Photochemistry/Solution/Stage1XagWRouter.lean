          Function.update_of_ne hxi1, Function.update_of_ne hxi0]
  have hOth (stB) (δ : BitAssignment n) (a : Fin 24) (ha : (1 ≤ a.val ∧ a.val < 4) ∨ 14 ≤ a.val) :
