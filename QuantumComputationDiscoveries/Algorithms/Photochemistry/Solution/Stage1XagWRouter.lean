theorem xagEnv_indep_N {N₁ N₂ : ℕ} (c : ℕ) (f₁ : Fin N₁ → ℕ × ℕ) (f₂ : Fin N₂ → ℕ × ℕ) :
    ∀ (k : ℕ) (hk₁ : k ≤ N₁) (hk₂ : k ≤ N₂),
      (∀ g (hg : g < k), f₁ ⟨g, Nat.lt_of_lt_of_le hg hk₁⟩ = f₂ ⟨g, Nat.lt_of_lt_of_le hg hk₂⟩) →
      xagEnv c N₁ f₁ k hk₁ = xagEnv c N₂ f₂ k hk₂
  | 0, _, _, _ => rfl
  | k + 1, hk₁, hk₂, hfg => by
      have hgk := hfg k (Nat.lt_succ_self k)
      dsimp only [xagEnv]
      rw [xagEnv_indep_N c f₁ f₂ k (Nat.le_of_succ_le hk₁) (Nat.le_of_succ_le hk₂)
          (fun g hg ↦ hfg g (Nat.lt_succ_of_lt hg)),
          congrArg Prod.fst hgk, congrArg Prod.snd hgk]

theorem xagEnv_prefix_testBit (c N : ℕ) (gates : Fin N → ℕ × ℕ) (k₀ : ℕ) (hk₀ : k₀ ≤ N) :
    ∀ (k : ℕ) (hk : k ≤ N), k₀ ≤ k →
      ∀ b < 42 + k₀, (xagEnv c N gates k hk).testBit b = (xagEnv c N gates k₀ hk₀).testBit b
  | 0, _, hle, _, _ => by
      obtain rfl := Nat.eq_zero_of_le_zero hle
      rfl
  | k + 1, hk, hle, b, hb => by
      rcases eq_or_lt_of_le hle with rfl | hlt
      · rfl
      · have ih := xagEnv_prefix_testBit c N gates k₀ hk₀ k (Nat.le_of_succ_le hk) (by omega) b hb
        dsimp only [xagEnv]
        split_ifs <;>
          simp [Nat.testBit_or, ih, Nat.testBit_shiftLeft, show ¬(b ≥ 42 + k) by omega]

theorem xagEnv_zero_eq {N : ℕ} (c : ℕ) (gates : Fin N → ℕ × ℕ) (h0 : 0 ≤ N) :
    xagEnv c N gates 0 h0 = (1 ||| (c <<< 1)) := rfl

theorem xagEnv_succ_eq {N : ℕ} (c : ℕ) (gates : Fin N → ℕ × ℕ) (k : ℕ) (hk : k + 1 ≤ N) :
    xagEnv c N gates (k + 1) hk =
      let prev := xagEnv c N gates k (Nat.le_of_succ_le hk)
      if oddBits (prev &&& (gates ⟨k, hk⟩).1) (42 + k) && oddBits (prev &&& (gates ⟨k, hk⟩).2)
          (42 + k) then prev ||| (1 <<< (42 +
        k)) else prev := rfl

