theorem xagEnv_eq_off_dead {N : ℕ} {c : ℕ} {f₁ f₂ : Fin N → ℕ × ℕ} :
    ∀ (d : ℕ) (hd : 120 + d ≤ N), (∀ b, b ≠ 159 → b ≠ 160 →
        (xagEnv c N f₁ 120 (by omega)).testBit b = (xagEnv c N f₂ 120
      (by omega)).testBit b) →
