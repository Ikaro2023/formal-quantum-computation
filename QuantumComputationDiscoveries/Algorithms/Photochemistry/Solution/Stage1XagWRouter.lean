            (fun _ ↦
                hNeS iu _ (by simp only [iu]; omega))).trans (Function.update_self _
                _ _),
        zmod2_add_self, Function.update_comm (hOutScr g1 iu), Function.update_comm (hOutScr g0 iu)]
    dsimp only [stAuxStep]
    refine congrArg ket (congrArg (fun f : BitAssignment n ↦ Function.update
      (Function.update f (rAuxOut g0) (auxRawBitVal c g0)) (rAuxOut g1) (auxRawBitVal c g1))
