  | k + 1, hk => by
      dsimp only [sumPrefix]
      rw [← sumPrefix_add f g k (Nat.le_of_succ_le hk)]
      ring
def findBranchAux {α : Type*} [DecidableEq α] {R : ℕ} (w : Fin R → α) (x : α) :
    (k : ℕ) → k ≤ R → Option (Fin R)
  | 0, _ => none
  | k + 1, hk =>
      if x = w ⟨k, hk⟩ then some ⟨k, hk⟩
      else findBranchAux w x k (Nat.le_of_succ_le hk)

theorem findBranchAux_self {α : Type*} [DecidableEq α] {R : ℕ} {w : Fin R → α}
    (hw : Function.Injective w) (b : Fin R) :
    ∀ (k : ℕ) (hk : k ≤ R), b.val < k → findBranchAux w (w b) k hk = some b
  | 0, _, hlt => absurd hlt (Nat.not_lt_zero _)
  | k + 1, hk, hlt => by
      dsimp only [findBranchAux]
      by_cases he : w b = w ⟨k, hk⟩
      · rw [ite_eq_left he]; exact congrArg some (hw he).symm
      · rw [ite_eq_right he]
        have hne : b.val ≠ k := fun ev ↦ he (congrArg w (Fin.ext ev))
        exact findBranchAux_self hw b k (Nat.le_of_succ_le hk) (by omega)

theorem findBranchAux_none {α : Type*} [DecidableEq α] {R : ℕ} {w : Fin R → α} {x : α}
    (h : ∀ b : Fin R, x ≠ w b) :
    ∀ (k : ℕ) (hk : k ≤ R), findBranchAux w x k hk = none
  | 0, _ => rfl
  | k + 1, hk => by
      dsimp only [findBranchAux];
      rw [ite_eq_right (h ⟨k, hk⟩), findBranchAux_none h k (Nat.le_of_succ_le hk)]
theorem findBranchAux_spec {α : Type*} [DecidableEq α] {R : ℕ} {w : Fin R → α} {x : α} {b : Fin R} :
    ∀ (k : ℕ) (hk : k ≤ R), findBranchAux w x k hk = some b → x = w b
  | 0, _, h => by cases h
  | k + 1, hk, h => by
      dsimp only [findBranchAux] at h
      split_ifs at h with he
      · cases h; exact he
      · exact findBranchAux_spec k (Nat.le_of_succ_le hk) h

def findBranch {α : Type*} [DecidableEq α] {R : ℕ} (w : Fin R → α) (x : α) : Option (Fin R) :=
    findBranchAux w x R le_rfl
theorem findBranch_self {α : Type*} [DecidableEq α] {R : ℕ} {w : Fin R → α}
    (hw : Function.Injective w) (b : Fin R) : findBranch w (w b) = some b :=
    findBranchAux_self hw b R le_rfl b.isLt
theorem findBranch_none {α : Type*} [DecidableEq α] {R : ℕ} {w : Fin R → α} {x : α}
    (h : ∀ b : Fin R, x ≠ w b) : findBranch w x = none := findBranchAux_none h R le_rfl
theorem findBranch_spec {α : Type*} [DecidableEq α] {R : ℕ} {w : Fin R → α} {x : α} {b : Fin R}
    (h : findBranch w x = some b) : x = w b := findBranchAux_spec R le_rfl h
def firstActiveAux {R : ℕ} (hR : 0 < R) (f : Fin R → ZMod 2) : (k : ℕ) → k ≤ R → Fin R
  | 0, _ => ⟨0, hR⟩
  | k + 1, hk =>
      if f ⟨k, hk⟩ = 1 then ⟨k, hk⟩
      else firstActiveAux hR f k (Nat.le_of_succ_le hk)

theorem firstActiveAux_unique {R : ℕ} (hR : 0 < R) {f : Fin R → ZMod 2} (b₀ : Fin R)
    (hb₀ : f b₀ = 1) (hOther : ∀ b : Fin R, b ≠ b₀ → f b = 0) :
    ∀ (k : ℕ) (hk : k ≤ R), b₀.val < k → firstActiveAux hR f k hk = b₀
  | 0, _, hlt => absurd hlt (Nat.not_lt_zero _)
  | k + 1, hk, hlt => by
      dsimp only [firstActiveAux]
      by_cases heq : b₀.val = k
      · have hfin : (⟨k, hk⟩ : Fin R) = b₀ := Fin.ext heq.symm; rw [hfin, ite_eq_left hb₀]
      · have hne : (⟨k, hk⟩ : Fin R) ≠ b₀ := fun e ↦ heq (congrArg Fin.val e).symm
        have hf0 : f ⟨k, hk⟩ ≠ 1 := by rw [hOther ⟨k, hk⟩ hne]; decide
        rw [ite_eq_right hf0]
        exact firstActiveAux_unique hR b₀ hb₀ hOther k (Nat.le_of_succ_le hk) (by omega)

def firstActiveBranch {R : ℕ} (hR : 0 < R) (f : Fin R → ZMod 2) : Fin R :=
    firstActiveAux hR f R le_rfl
theorem firstActiveBranch_unique {R : ℕ} (hR : 0 < R) {f : Fin R → ZMod 2} (b₀ : Fin R)
    (hb₀ : f b₀ = 1) (hOther : ∀ b : Fin R, b ≠ b₀ → f b = 0) : firstActiveBranch hR f = b₀ :=
    firstActiveAux_unique hR b₀ hb₀ hOther R le_rfl b₀.isLt
def cCnotChainTo {n R : ℕ} (src : Fin R → Wire n) (dst : Wire n)
    (hne : ∀ b : Fin R, src b ≠ dst) : (k : ℕ) → k ≤ R → Circuit n
  | 0, _ => .identity
  | k + 1, hk =>
      (cCnotChainTo src dst hne k (Nat.le_of_succ_le hk)) ;;ᶜ
        Circuit.CNOT (src ⟨k, hk⟩) dst (hne ⟨k, hk⟩)

theorem count_cCnotChainTo {n R : ℕ} (src : Fin R → Wire n) (dst : Wire n)
    (hne : ∀ b : Fin R, src b ≠ dst) :
    ∀ (k : ℕ) (hk : k ≤ R),
      (cCnotChainTo src dst hne k hk).count .T = 0 ∧
      (cCnotChainTo src dst hne k hk).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | k + 1, hk => by
      obtain ⟨ht, hf⟩ :=
          count_cCnotChainTo src dst hne k (Nat.le_of_succ_le hk); dsimp only [cCnotChainTo];
          simp [ht, hf, Circuit.CNOT]
theorem cw_cCnotChainTo {n R : ℕ} {S : Wire n → Prop} (src : Fin R → Wire n) (dst : Wire n)
    (hne : ∀ b : Fin R, src b ≠ dst) (hSrc : ∀ b : Fin R, S (src b)) (hDst : S dst) :
    ∀ (k : ℕ) (hk : k ≤ R), CircWires S (cCnotChainTo src dst hne k hk)
  | 0, _ => trivial
  | k + 1, hk =>
      ⟨cw_cCnotChainTo src dst hne hSrc hDst k (Nat.le_of_succ_le hk),
       cw_cnot (hSrc ⟨k, hk⟩) hDst⟩

theorem ket_cCnotChainTo {n R : ℕ} [NeZero (2 ^ n)] (src : Fin R → Wire n) (dst : Wire n)
    (hne : ∀ b : Fin R, src b ≠ dst) (γ : BitAssignment n) :
    ∀ (k : ℕ) (hk : k ≤ R),
      (cCnotChainTo src dst hne k hk).eval.1.mulVec (ket γ) =
        ket (Function.update γ dst (γ dst + sumPrefix (fun b ↦ γ (src b)) k hk))
  | 0, _ => by
      dsimp only [cCnotChainTo, sumPrefix]; rw [Circuit.eval_identity];
      simp only [Submonoid.coe_one, Matrix.one_mulVec, add_zero, Function.update_eq_self]
  | k + 1, hk => by
      dsimp only [cCnotChainTo, sumPrefix];
      rw [eval_seq_mulVec, ket_cCnotChainTo src dst hne γ k (Nat.le_of_succ_le hk), ket_CNOT]
      apply congrArg ket; funext x
      by_cases hx : x = dst
      · subst hx; simp only [Function.update_self, Function.update_of_ne (hne ⟨k, hk⟩)]; ring
      · simp only [Function.update_of_ne hx]

def cSplitRPre {n R : ℕ} (lW : Fin R → Wire n) (rDum : Wire n) (hlNe : ∀ b : Fin R, lW b ≠ rDum) :
    Circuit n :=
  Circuit.X rDum ;;ᶜ cCnotChainTo lW rDum hlNe R le_rfl

def cSplitRPost {n R : ℕ} (lW hW : Fin R → Wire n) (rDum : Wire n) (hlNe : ∀ b : Fin R, lW b ≠ rDum)
    (hhNe : ∀ b : Fin R, hW b ≠ rDum) : Circuit n :=
  cCnotChainTo lW rDum hlNe R le_rfl ;;ᶜ
    cCnotChainTo hW rDum hhNe R le_rfl ;;ᶜ
    Circuit.X rDum

def pSplitRBracket {Var : Type} {n R : ℕ} (v : Var) (uWire : Wire n) (lW hW : Fin R → Wire n)
    (rDum wDum qEnc : Wire n) (hInj : WOptInj R 1 (fun _ : Fin 1 ↦ uWire)
    (wPairR lW hW) rDum wDum qEnc) (mid : DynamicCircuit Var n) : DynamicCircuit Var n :=
  let uLo1 : Fin 1 → Wire n := fun _ ↦ uWire
  let wP := wPairR lW hW
  let hlNe : ∀ b : Fin R, lW b ≠ rDum := fun b ↦ hInj.w_ne_rDum b fp1_0R
  let hhNe : ∀ b : Fin R, hW b ≠ rDum := fun b ↦ hInj.w_ne_rDum b fp1_1R
  (DynamicCircuit.circuit (cSplitRPre lW rDum hlNe)).seq
    ((wLastSplitShiftDyn v R 0 uLo1 wP rDum wDum qEnc hInj).seq
      ((DynamicCircuit.circuit (cSplitRPost lW hW rDum hlNe hhNe)).seq
        (mid.seq
          (wUncompTreeDyn v R 1 uLo1 wP hInj.w_inj hInj.uLo_ne_w (.circuit .identity) 1 le_rfl))))

theorem counts_pSplitRBracket {Var : Type} {n R : ℕ} (v : Var) (uWire : Wire n)
    (lW hW : Fin R → Wire n) (rDum wDum qEnc : Wire n) (hInj : WOptInj R 1 (fun _ : Fin 1 ↦ uWire)
    (wPairR lW hW) rDum wDum qEnc) (mid : DynamicCircuit Var n) :
    (pSplitRBracket v uWire lW hW rDum wDum qEnc hInj mid).count .T = (2 * R + 2) + mid.count .T ∧
    (pSplitRBracket v uWire lW hW rDum wDum qEnc hInj mid).count .TOFF = mid.count .TOFF := by
  let uLo1 : Fin 1 → Wire n := fun _ ↦ uWire
  let wP := wPairR lW hW
  let hlNe : ∀ b : Fin R, lW b ≠ rDum := fun b ↦ hInj.w_ne_rDum b fp1_0R
  let hhNe : ∀ b : Fin R, hW b ≠ rDum := fun b ↦ hInj.w_ne_rDum b fp1_1R
  obtain ⟨tS, fS⟩ := count_wLastSplitShiftDyn v R 0 uLo1 wP rDum wDum qEnc hInj; obtain ⟨tU, fU⟩ :=
      count_wUncompTreeDyn_opt v R 1 uLo1 wP hInj.w_inj hInj.uLo_ne_w (.circuit .identity) 1 le_rfl;
      obtain ⟨tCL, fCL⟩ := count_cCnotChainTo lW rDum hlNe R le_rfl; obtain ⟨tCH, fCH⟩ :=
      count_cCnotChainTo hW rDum hhNe R le_rfl
  have hcPreT : (cSplitRPre lW rDum hlNe).count .T = 0 := by simp [cSplitRPre, tCL, Circuit.X]
  have hcPreF : (cSplitRPre lW rDum hlNe).count .TOFF = 0 := by simp [cSplitRPre, fCL, Circuit.X]
  have hcPostT : (cSplitRPost lW hW rDum hlNe hhNe).count .T = 0 := by
    simp [cSplitRPost, tCL, tCH, Circuit.X]
  have hcPostF : (cSplitRPost lW hW rDum hlNe hhNe).count .TOFF = 0 := by
    simp [cSplitRPost, fCL, fCH, Circuit.X]
  have hIdT : ((.circuit .identity : DynamicCircuit Var n)).count .T = 0 := rfl;
  have hIdF : ((.circuit .identity : DynamicCircuit Var n)).count .TOFF = 0 :=
      rfl; dsimp only [pSplitRBracket, DynamicCircuit.count]; rw [hcPreT, hcPreF, tS, fS, hcPostT,
      hcPostF, tU, fU, hIdT, hIdF]
  exact ⟨by omega, by omega⟩

theorem dynWires_pSplitRBracket {Var : Type} {n R : ℕ} {S : Wire n → Prop} (v : Var)
    (uWire : Wire n) (lW hW : Fin R → Wire n) (rDum wDum qEnc : Wire n)
    (hInj : WOptInj R 1 (fun _ : Fin 1 ↦ uWire) (wPairR lW hW) rDum wDum qEnc)
    (mid : DynamicCircuit Var n) (hu : S uWire) (hlW : ∀ b : Fin R, S (lW b))
    (hhW : ∀ b : Fin R, S (hW b)) (hr : S rDum) (hwd : S wDum) (hq : S qEnc)
    (hMid : DynWires S mid) : DynWires S (pSplitRBracket v uWire lW hW rDum wDum qEnc hInj mid)
    := by
  have hwP (b : Fin R) (p : Fin 2) : S (wPairR lW hW b p) := by
    dsimp only [wPairR]
    split_ifs
    · exact hlW b
    · exact hhW b
  exact ⟨⟨cw_1 hr, cw_cCnotChainTo lW rDum _ hlW hr R le_rfl⟩,
    ⟨dw_wLastSplitShiftDyn v R 0 _ _ rDum wDum qEnc hInj (fun _ ↦ hu) hwP hr hwd hq,
    ⟨⟨cw_cCnotChainTo lW rDum _ hlW hr R le_rfl, ⟨cw_cCnotChainTo hW rDum _ hhW hr R le_rfl,
      cw_1 hr⟩⟩, ⟨hMid, dw_wUncompTreeDyn_opt v R 1 _ _ hInj.w_inj hInj.uLo_ne_w (fun _ ↦ hu)
      hwP (rest := .circuit .identity) trivial 1 le_rfl⟩⟩⟩⟩

def clearWires {n R : ℕ} (w : Fin R → Wire n) (β : BitAssignment n) : BitAssignment n :=
  fun x ↦ match findBranch w x with
    | some _ => 0
    | none => β x

theorem clearWires_self {n R : ℕ} {w : Fin R → Wire n} (hw : Function.Injective w)
    (β : BitAssignment n) (b : Fin R) : clearWires w β (w b) = 0 := by
  dsimp only [clearWires]; rw [findBranch_self hw b]
theorem clearWires_other {n R : ℕ} {w : Fin R → Wire n} (β : BitAssignment n) {x : Wire n}
    (hx : ∀ b : Fin R, x ≠ w b) : clearWires w β x = β x := by
  dsimp only [clearWires]; rw [findBranch_none hx]
def stSplitRBasePre {n R : ℕ} (lW : Fin R → Wire n) (rDum : Wire n) (β : BitAssignment n) :
    BitAssignment n :=
    Function.update (clearWires lW β) rDum (1 + sumPrefix (fun b ↦ β (lW b)) R le_rfl)
def stSplitRClear {n R : ℕ} (lW hW : Fin R → Wire n) (β : BitAssignment n) : BitAssignment n :=
    clearWires hW (clearWires lW β)
def stSplitRFwd {n R : ℕ} (uWire : Wire n) (lW hW : Fin R → Wire n) (β : BitAssignment n) :
    BitAssignment n :=
  fun x ↦ match findBranch lW x with
    | some b => β (lW b) * (1 + β uWire)
    | none => match findBranch hW x with
      | some b => β (lW b) * β uWire
      | none => β x

theorem stSplitRFwd_lW {n R : ℕ} {uWire : Wire n} {lW hW : Fin R → Wire n}
    (hlInj : Function.Injective lW) (β : BitAssignment n)
    (b : Fin R) : stSplitRFwd uWire lW hW β (lW b) = β (lW b) * (1 + β uWire) := by
  dsimp only [stSplitRFwd]; rw [findBranch_self hlInj b]
theorem stSplitRFwd_hW {n R : ℕ} {uWire : Wire n} {lW hW : Fin R → Wire n}
    (hhInj : Function.Injective hW) (hlhNe : ∀ b1 b2 : Fin R, lW b1 ≠ hW b2) (β : BitAssignment n)
    (b : Fin R) : stSplitRFwd uWire lW hW β (hW b) = β (lW b) * β uWire := by
  dsimp only [stSplitRFwd]
  rw [findBranch_none (fun b1 e ↦ hlhNe b1 b e.symm), findBranch_self hhInj b]

theorem stSplitRFwd_other {n R : ℕ} {uWire : Wire n} {lW hW : Fin R → Wire n} (β : BitAssignment n)
    {x : Wire n} (hlx : ∀ b : Fin R, x ≠ lW b) (hhx : ∀ b : Fin R, x ≠ hW b) :
    stSplitRFwd uWire lW hW β x = β x := by
  dsimp only [stSplitRFwd]; rw [findBranch_none hlx, findBranch_none hhx]
theorem stSplitRBasePre_rDum {n R : ℕ} (lW : Fin R → Wire n) (rDum : Wire n) (β : BitAssignment n) :
    stSplitRBasePre lW rDum β rDum = 1 + sumPrefix (fun b ↦ β (lW b)) R le_rfl := by
  dsimp only [stSplitRBasePre]; rw [Function.update_self]
theorem stSplitRBasePre_lW {n R : ℕ} {lW : Fin R → Wire n} {rDum : Wire n}
    (hlInj : Function.Injective lW) (hlNeR : ∀ b : Fin R, lW b ≠ rDum) (β : BitAssignment n)
    (b : Fin R) : stSplitRBasePre lW rDum β (lW b) = 0 := by
  dsimp only [stSplitRBasePre]; rw [Function.update_of_ne (hlNeR b), clearWires_self hlInj β b]
theorem stSplitRBasePre_other {n R : ℕ} {lW : Fin R → Wire n} {rDum : Wire n} (β : BitAssignment n)
    {x : Wire n} (hlx : ∀ b : Fin R, x ≠ lW b) (hxR : x ≠ rDum) : stSplitRBasePre lW rDum β x =
    β x := by dsimp only [stSplitRBasePre]; rw [Function.update_of_ne hxR, clearWires_other β hlx]
theorem stSplitRClear_lW {n R : ℕ} {lW hW : Fin R → Wire n} (hlInj : Function.Injective lW)
    (hlhNe : ∀ b1 b2 : Fin R, lW b1 ≠ hW b2) (β : BitAssignment n)
    (b : Fin R) : stSplitRClear lW hW β (lW b) = 0 := by
  dsimp only [stSplitRClear]
  rw [clearWires_other _ (fun b2 ↦ hlhNe b b2), clearWires_self hlInj β b]

theorem stSplitRClear_hW {n R : ℕ} {lW hW : Fin R → Wire n} (hhInj : Function.Injective hW)
    (β : BitAssignment n) (b : Fin R) : stSplitRClear lW hW β (hW b) = 0 := by
  dsimp only [stSplitRClear]; rw [clearWires_self hhInj _ b]
theorem stSplitRClear_other {n R : ℕ} {lW hW : Fin R → Wire n} (β : BitAssignment n) {x : Wire n}
    (hlx : ∀ b : Fin R, x ≠ lW b) (hhx : ∀ b : Fin R, x ≠ hW b) : stSplitRClear lW hW β x =
    β x := by dsimp only [stSplitRClear]; rw [clearWires_other _ hhx, clearWires_other β hlx]
theorem ket_cSplitRPre {n R : ℕ} [NeZero (2 ^ n)] (lW : Fin R → Wire n) (rDum : Wire n)
    (hlNe : ∀ b : Fin R, lW b ≠ rDum) (γ : BitAssignment n) :
    (cSplitRPre lW rDum hlNe).eval.1.mulVec (ket γ) = ket (Function.update γ rDum (γ rDum + 1 +
    sumPrefix (fun b ↦ γ (lW b)) R le_rfl)) := by
  dsimp only [cSplitRPre]; rw [eval_seq_mulVec, ket_X, ket_cCnotChainTo]
  apply congrArg ket; funext x
  by_cases hx : x = rDum
  · subst x
    have hsum : sumPrefix (fun b ↦ Function.update γ rDum (γ rDum + 1) (lW b)) R le_rfl =
        sumPrefix (fun b ↦ γ (lW b)) R le_rfl :=
        sumPrefix_congr (fun b ↦ Function.update_of_ne (hlNe b) _ _) R le_rfl
    simp [hsum]
  · simp [hx]

theorem ket_cSplitRPost {n R : ℕ} [NeZero (2 ^ n)] (lW hW : Fin R → Wire n) (rDum : Wire n)
    (hlNe : ∀ b : Fin R, lW b ≠ rDum) (hhNe : ∀ b : Fin R, hW b ≠ rDum) (γ : BitAssignment n) :
    (cSplitRPost lW hW rDum hlNe hhNe).eval.1.mulVec (ket γ) = ket (Function.update γ rDum (γ rDum +
    sumPrefix (fun b ↦ γ (lW b)) R le_rfl + sumPrefix (fun b ↦ γ (hW b)) R le_rfl + 1)) := by
  dsimp only [cSplitRPost];
  rw [eval_seq_mulVec, eval_seq_mulVec, ket_cCnotChainTo, ket_cCnotChainTo, ket_X]
  apply congrArg ket; funext x
  by_cases hx : x = rDum
  · subst x
    have hsumH : sumPrefix (fun b ↦ Function.update γ rDum (γ rDum + sumPrefix (fun b ↦
        γ (lW b)) R le_rfl) (hW b)) R le_rfl = sumPrefix (fun b ↦ γ (hW b)) R le_rfl :=
        sumPrefix_congr (fun b ↦ Function.update_of_ne (hhNe b) _ _) R le_rfl
    simp [hsumH]
  · simp [hx]

theorem wire_cases_lh {n R : ℕ} (lW hW : Fin R → Wire n) (x : Wire n) :
    (∃ b, x = lW b) ∨ (∃ b, x = hW b) ∨ ((∀ b, x ≠ lW b) ∧ (∀ b, x ≠ hW b)) :=
  if hxl : ∃ b, x = lW b then Or.inl hxl else if hxh : ∃ b, x = hW b then Or.inr (Or.inl hxh)
  else Or.inr (Or.inr ⟨fun b e ↦ hxl ⟨b, e⟩, fun b e ↦ hxh ⟨b, e⟩⟩)

theorem op_mul_mkKetOpW {W n : ℕ} (U : Operator (2 ^ n)) (rWork : QRegister W n)
    (st st' : BitAssignment n → BitAssignment n) (ph : BitAssignment n → ZMod 2)
    (hU : ∀ δ, (∀ k : Fin W, δ (rWork k) = 0) → U.mulVec (ket (st δ)) = ket
      (st' δ)) : U * mkKetOpW rWork st ph = mkKetOpW rWork st' ph :=
  matrix_ext_ket fun δ ↦ by
    rw [← Matrix.mulVec_mulVec, mkKetOpW_mulVec_ket, mkKetOpW_mulVec_ket]
    split_ifs with hz
    · rw [Matrix.mulVec_smul, hU δ hz]
    · simp only [Matrix.mulVec_zero]

set_option maxHeartbeats 800000 in
-- Large circuit/register elaboration requires raised heartbeat limit.
attribute [local irreducible] mkKetOpW oneHotOptPreOp in
theorem step_pSplitRBracket {Var : Type} [Fintype Var] [DecidableEq Var] {W n R : ℕ}
    [NeZero (2 ^ n)]
    (hR : 0 < R) (v : Var) (rWork : QRegister W n) (uWire : Wire n) (lW hW : Fin R → Wire n)
        (rDum wDum qEnc : Wire n)
    (eBranch : Fin R → BitAssignment n → ZMod 2) (hInj : WOptInj R 1 (fun _ : Fin 1 ↦ uWire)
        (wPairR lW hW) rDum wDum qEnc)
    (heIndep : ∀ (b : Fin R) (γ₁ γ₂ : BitAssignment n), (∀ x, (∀ j, x ≠ lW j) → (∀ j, x ≠ hW j) →
        x ≠ rDum → γ₁ x = γ₂ x) →
      eBranch b γ₁ = eBranch b γ₂)
    (st stPost : BitAssignment n → BitAssignment n) (phPre phPost : BitAssignment n → ZMod 2)
        (mid : DynamicCircuit Var n)
    (hMut : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ b₁ b₂ : Fin R, b₁ ≠ b₂ → st δ (lW b₁) = 1 →
        st δ (lW b₂) = 0)
    (hCln : ∀ δ, (∀ q, δ (rWork q) = 0) → (∀ b : Fin R, st δ (hW b) = 0) ∧ st δ rDum = 0 ∧
        st δ wDum = 0 ∧ st δ qEnc = 0)
    (heEq : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ b : Fin R, eBranch b (st δ) = st δ (lW b))
    (hSame : ∀ δ, (∀ q, δ (rWork q) = 0) → stPost δ uWire = st δ uWire ∧
        (∀ b : Fin R, stPost δ (lW b) = st δ (lW b)) ∧
      (∀ b : Fin R, stPost δ (hW b) = st δ (hW b)) ∧ stPost δ rDum = st δ rDum ∧ stPost δ wDum =
          st δ wDum ∧ stPost δ qEnc =
        st δ qEnc ∧
      (∀ b : Fin R, eBranch b (stPost δ) = eBranch b (st δ)))
    (hMid : SubspaceStep (mkKetOpW rWork (fun δ ↦ stSplitRFwd uWire lW hW (st δ)) phPre)
        (mkKetOpW rWork
      (fun δ ↦ stSplitRFwd uWire lW hW (stPost δ)) phPost) mid) :
    SubspaceStep (mkKetOpW rWork st phPre) (mkKetOpW rWork stPost phPost)
        (pSplitRBracket v uWire lW hW rDum wDum qEnc hInj mid) := by
  let uLo1 : Fin 1 → Wire n := fun _ ↦ uWire
  let wP := wPairR lW hW
  let PBase := OptBasePred (@pTrueSplitR n) wDum qEnc
  let sumL (f : BitAssignment n) := sumPrefix (fun b ↦ f (lW b)) R le_rfl
  let hlNeR (b : Fin R) : lW b ≠ rDum := hInj.w_ne_rDum b fp1_0R
  let hhNeR (b : Fin R) : hW b ≠ rDum := hInj.w_ne_rDum b fp1_1R
  obtain ⟨hlInj, hhInj, hlhNe⟩ := wPairR_inj_props hInj.w_inj
  let eAct (γ : BitAssignment n) := sumPrefix (fun b ↦ eBranch b γ) R le_rfl
  let bSF (γ : BitAssignment n) := firstActiveBranch hR (fun b ↦ eBranch b γ)
  let stB1 (δ : BitAssignment n) := stSplitRBasePre lW rDum (st δ)
  let stC2 (δ : BitAssignment n) := stSplitRClear lW hW (stPost δ)
  have hBasePre (stδ : BitAssignment n) (hC : (∀ b : Fin R, stδ (hW b) = 0) ∧ stδ rDum = 0 ∧
      stδ wDum = 0 ∧ stδ qEnc = 0)
      (hE : ∀ b : Fin R, eBranch b stδ = stδ (lW b)) :
      (PBase (stSplitRBasePre lW rDum stδ) ∧ ∀ b p, stSplitRBasePre lW rDum stδ (wP b p) = 0) ∧
      (∀ b : Fin R, eBranch b (stSplitRBasePre lW rDum stδ) = stδ (lW b)) ∧
      stSplitRBasePre lW rDum stδ uWire = stδ uWire ∧
          (actDumZeroR rDum (stSplitRBasePre lW rDum stδ) ↔ sumL stδ = 1) := by
    obtain ⟨hh0, _, hw0, hq0⟩ := hC
    refine ⟨⟨⟨trivial,
      (stSplitRBasePre_other stδ (fun b e ↦
          hInj.w_ne_wDum b fp1_0R e.symm) hInj.rDum_ne_wDum.symm).trans hw0,
      (stSplitRBasePre_other stδ (fun b e ↦
          hInj.w_ne_qEnc b fp1_0R e.symm) hInj.rDum_ne_qEnc.symm).trans hq0⟩, fun b p ↦ ?_⟩,
      fun b ↦ (heIndep b _ stδ fun x hlx _ hxR ↦ stSplitRBasePre_other stδ hlx hxR).trans (hE b),
      stSplitRBasePre_other stδ (fun b ↦ hInj.uLo_ne_w f1_0R b fp1_0R) (hInj.uLo_ne_rDum f1_0R), ?_⟩
    · dsimp only [wP, wPairR]
      split_ifs
      · exact stSplitRBasePre_lW hlInj hlNeR stδ b
      · exact (stSplitRBasePre_other stδ (fun j e ↦ hlhNe j b e.symm) (hhNeR b)).trans (hh0 b)
    · dsimp only [actDumZeroR, sumL]
      rw [stSplitRBasePre_rDum]
      rcases DynCircExt.bit_cases (sumPrefix (fun b ↦ stδ (lW b)) R le_rfl) with hs | hs <;>
          rw [hs] <;> decide
  have hClearPre (δ : BitAssignment n) (hz : ∀ q, δ (rWork q) = 0) :
      (PBase (stC2 δ) ∧ ∀ b p, stC2 δ (wP b p) = 0) ∧ (∀ b, eBranch b (stC2 δ) = st δ (lW b)) ∧
      (actExprOneR eAct (stC2 δ) ↔ sumL (st δ) = 1) ∧ stC2 δ uWire = st δ uWire := by
    obtain ⟨su, _, _, _, sw, sq, se⟩ := hSame δ hz
    obtain ⟨_, _, hw0, hq0⟩ := hCln δ hz
    have heBc (b : Fin R) : eBranch b (stC2 δ) = st δ (lW b) :=
        (heIndep b (stC2 δ) (stPost δ) fun x hlx hhx _ ↦
        stSplitRClear_other (stPost δ) hlx hhx).trans ((se b).trans (heEq δ hz b))
    have hSumEq := sumPrefix_congr heBc R le_rfl
    refine ⟨⟨⟨trivial, (stSplitRClear_other (stPost δ) (fun b e ↦ hInj.w_ne_wDum b fp1_0R e.symm)
        (fun b e ↦ hInj.w_ne_wDum b fp1_1R e.symm)).trans (sw.trans hw0),
      (stSplitRClear_other (stPost δ) (fun b e ↦ hInj.w_ne_qEnc b fp1_0R e.symm)
        (fun b e ↦ hInj.w_ne_qEnc b fp1_1R e.symm)).trans (sq.trans hq0)⟩, fun b p ↦ ?_⟩,
      heBc, ⟨fun h ↦ hSumEq.symm.trans h, fun h ↦ hSumEq.trans h⟩,
      (stSplitRClear_other (stPost δ) (fun b ↦ hInj.uLo_ne_w f1_0R b fp1_0R)
          (fun b ↦ hInj.uLo_ne_w f1_0R b fp1_1R)).trans su⟩
    dsimp only [wP, wPairR]
    split_ifs
    · exact stSplitRClear_lW hlInj hlhNe (stPost δ) b
    · exact stSplitRClear_hW hhInj (stPost δ) b
  have hOneHot (PAct : BitAssignment n → Prop) [DecidablePred PAct] (k : ℕ) (hk : k ≤ 1)
      (f : Fin R → ZMod 2) (β target : BitAssignment n) (hBase : PBase β ∧ ∀ b p, β (wP b p) = 0)
      (hMutF : ∀ b₁ b₂, b₁ ≠ b₂ → f b₁ = 1 → f b₂ = 0) (heB : ∀ b, eBranch b β = f b)
      (hAct : PAct β ↔ sumPrefix f R le_rfl = 1)
      (htL : ∀ b : Fin R, target (lW b) = f b * (1 + if k = 0 then 0 else β uWire))
      (htH : ∀ b : Fin R, target (hW b) = f b * (if k = 0 then 0 else β uWire))
      (htO : ∀ x : Wire n, (∀ b : Fin R, x ≠ lW b) → (∀ b : Fin R, x ≠ hW b) → target x = β x) :
      (oneHotOptPreOp PBase PAct bSF uLo1 wP k hk).mulVec (ket β) = ket target := by
    have hβL (b : Fin R) : β (lW b) = 0 := hBase.2 b fp1_0R
    have hβH (b : Fin R) : β (hW b) = 0 := hBase.2 b fp1_1R
    unfold oneHotOptPreOp
    rw [mkVecOp_mulVec_ket]
    dsimp only [oneHotOptPreVec]
    change (if PBase β ∧ ∀ b p, β (wP b p) = 0 then _ else 0) = _
    rw [ite_eq_left hBase]
    by_cases hEx : ∃ b₀ : Fin R, f b₀ = 1
    · obtain ⟨b₀, hb₀⟩ := hEx
      have hOt (b : Fin R) (hne : b ≠ b₀) : f b = 0 := hMutF b₀ b hne.symm hb₀
      dsimp only [bSF, wP]
      rw [ite_eq_left (hAct.mpr (sumPrefix_single b₀ 1 hb₀ hOt)),
          firstActiveBranch_unique hR b₀ ((heB b₀).trans hb₀)
            (fun b hne ↦ (heB b).trans (hOt b hne)), wPairR_idx]
      have hCs : (idxValPrefix uLo1 β k hk = 0 ∧ (if k = 0 then (0 : ZMod 2) else β uWire) = 0) ∨
          (idxValPrefix uLo1 β k hk = 1 ∧ (if k = 0 then (0 : ZMod 2) else β uWire) = 1) := by
        rcases (by omega : k = 0 ∨ k = 1) with rfl | rfl
        · exact Or.inl ⟨rfl, rfl⟩
        · rcases DynCircExt.bit_cases (β uWire) with hv | hv <;> simp [idxValPrefix, uLo1, hv]
      refine congrArg ket (funext fun x ↦ ?_)
      rcases hCs with ⟨hI, hu⟩ | ⟨hI, hu⟩ <;> simp only [hI, ↓reduceIte, Nat.one_ne_zero] <;>
        rcases wire_cases_lh lW hW x with ⟨b, rfl⟩ | ⟨b, rfl⟩ | ⟨hlx, hhx⟩
      · by_cases hb : b = b₀ <;> simp [hb, htL, hu, hb₀, hβL, hlInj.eq_iff, hOt]
      · simp [htH, hu, hβH, Function.update_of_ne (hlhNe b₀ b).symm]
      · rw [Function.update_of_ne (hlx b₀), htO x hlx hhx]
      · simp [htL, hu, show (1 : ZMod 2) + 1 = 0 from rfl, hβL, Function.update_of_ne (hlhNe b b₀)]
      · by_cases hb : b = b₀ <;> simp [hb, htH, hu, hb₀, hβH, hhInj.eq_iff, hOt]
      · rw [Function.update_of_ne (hhx b₀), htO x hlx hhx]
    · have hzL (b : Fin R) : f b = 0 := (DynCircExt.bit_cases (f b)).resolve_right fun h1 ↦
          hEx ⟨b, h1⟩
      rw [ite_eq_right (fun hp ↦ (by decide : (0 : ZMod 2) ≠ 1)
          ((sumPrefix_zero hzL R le_rfl).symm.trans (hAct.mp hp)))]
      refine congrArg ket (funext fun x ↦ ?_)
      rcases wire_cases_lh lW hW x with ⟨b, rfl⟩ | ⟨b, rfl⟩ | ⟨hlx, hhx⟩
      · rw [hβL b, htL b, hzL b, zero_mul]
      · rw [hβH b, htH b, hzL b, zero_mul]
      · exact (htO x hlx hhx).symm
  dsimp only [pSplitRBracket]
  refine (subspaceStep_congr_out (subspaceStep_of_circuit (Var := Var) _ _) ?_).seq
    ((subspaceStep_mul_right (mkKetOpW rWork stB1 phPre)
      (subspaceStep_wLastSplitShiftDyn v pTrueSplitR (actDumZeroR rDum) bSF uLo1 wP rDum wDum qEnc
        hInj fun γ _ ↦
            by rcases DynCircExt.bit_cases (γ rDum) with h | h <;> simp [actDumZeroR, h])).seq
      ((subspaceStep_congr_out (subspaceStep_of_circuit (Var := Var) _ _) ?_).seq
        (hMid.seq (subspaceStep_congr_in ?_ (subspaceStep_congr_out (subspaceStep_mul_right
            (mkKetOpW rWork stC2 phPost)
          (subspaceStep_wUncompTreeDyn_id_opt v PBase (actExprOneR eAct) bSF uLo1 wP hInj.w_inj
              hInj.uLo_ne_w)) ?_)))))
  · refine (op_mul_mkKetOpW _ rWork st _ phPre fun δ _ ↦ ket_cSplitRPre lW rDum hlNeR (st δ)).trans
      (op_mul_mkKetOpW _ rWork stB1 _ phPre fun δ hz ↦ ?_).symm
    obtain ⟨hh0, hr0, _, _⟩ := hCln δ hz
    obtain ⟨hBaseV, heB0, _, hActD⟩ := hBasePre (st δ) (hCln δ hz) (heEq δ hz)
    refine hOneHot (actDumZeroR rDum) 0 (Nat.zero_le 1) (fun b ↦ st δ (lW b)) (stB1 δ) _
      hBaseV (hMut δ hz) heB0 hActD (fun b ↦ by simp [Function.update_of_ne (hlNeR b)])
      (fun b ↦ by simp [Function.update_of_ne (hhNeR b), hh0 b]) fun x hlx _ ↦ ?_
    dsimp only [stB1]
    rcases eq_or_ne x rDum with rfl | hxR
    · rw [Function.update_self, stSplitRBasePre_rDum, hr0, zero_add]
    · rw [Function.update_of_ne hxR, stSplitRBasePre_other (st δ) hlx hxR]
  · rw [← Matrix.mul_assoc]
    refine op_mul_mkKetOpW _ rWork stB1 _ phPre fun δ hz ↦ ?_
    obtain ⟨_, hr0, _, _⟩ := hCln δ hz
    obtain ⟨hBaseV, heB0, huB0, hActD⟩ := hBasePre (st δ) (hCln δ hz) (heEq δ hz)
    let γ₁ := Function.update (stSplitRFwd uWire lW hW (st δ)) rDum (1 + sumL (st δ))
    rw [← Matrix.mulVec_mulVec, hOneHot (actDumZeroR rDum) 1 le_rfl (fun b ↦ st δ (lW b))
        (stB1 δ) γ₁
      hBaseV (hMut δ hz) heB0 hActD
      (fun b ↦
          by simp [γ₁, stB1, Function.update_of_ne (hlNeR b), stSplitRFwd_lW hlInj (st δ) b, huB0])
      (fun b ↦
          by simp [γ₁, stB1, Function.update_of_ne (hhNeR b), stSplitRFwd_hW hhInj hlhNe (st δ) b,
               huB0])
      (fun x hlx hhx ↦ by
        dsimp only [γ₁, stB1, sumL]
        rcases eq_or_ne x rDum with rfl | hxR
        · rw [Function.update_self, stSplitRBasePre_rDum]
        · rw [Function.update_of_ne hxR, stSplitRFwd_other (st δ) hlx hhx,
              stSplitRBasePre_other (st δ) hlx hxR]), ket_cSplitRPost]
    refine congrArg ket (funext fun x ↦ ?_)
    rcases eq_or_ne x rDum with rfl | hxR
    · rw [Function.update_self, add_assoc (γ₁ _),
          sumPrefix_congr (fun b ↦
              (Function.update_of_ne (hlNeR b) _ _).trans (stSplitRFwd_lW hlInj (st δ) b)) R le_rfl,
          sumPrefix_congr (fun b ↦
              (Function.update_of_ne (hhNeR b) _ _).trans (stSplitRFwd_hW hhInj hlhNe (st δ) b)) R
              le_rfl,
          sumPrefix_add, sumPrefix_congr (fun b ↦ by
            rcases DynCircExt.bit_cases (st δ (lW b)) with hl | hl <;>
              rcases DynCircExt.bit_cases (st δ uWire) with hu | hu <;> rw [hl, hu] <;> decide :
            ∀ b, _ = st δ (lW b)) R le_rfl]
      dsimp only [γ₁, sumL]
      rw [Function.update_self, stSplitRFwd_other (st δ) (fun b e ↦ hlNeR b e.symm)
          (fun b e ↦ hhNeR b e.symm), hr0]
      rcases DynCircExt.bit_cases (sumPrefix (fun b ↦ st δ (lW b)) R le_rfl) with hs | hs <;>
          rw [hs] <;> decide
    · exact (Function.update_of_ne hxR _ _).trans (Function.update_of_ne hxR _ _)
  · exact (op_mul_mkKetOpW _ rWork stC2 _ phPost fun δ hz ↦ by
      obtain ⟨su, sl, _, _, _, _, _⟩ := hSame δ hz
      obtain ⟨hBaseV, heBc, hActBc, huBc⟩ := hClearPre δ hz
      exact hOneHot (actExprOneR eAct) 1 le_rfl (fun b ↦ st δ (lW b)) (stC2 δ)
          (stSplitRFwd uWire lW hW (stPost δ))
        hBaseV (hMut δ hz) heBc hActBc (fun b ↦
            by simp [stSplitRFwd_lW hlInj (stPost δ) b, sl b, su, huBc])
        (fun b ↦ by simp [stSplitRFwd_hW hhInj hlhNe (stPost δ) b, sl b, su, huBc])
        (fun x hlx hhx ↦
            (stSplitRFwd_other (stPost δ) hlx hhx).trans (stSplitRClear_other (stPost δ) hlx
            hhx).symm)).symm
  · refine op_mul_mkKetOpW _ rWork stC2 stPost phPost fun δ hz ↦ ?_
    obtain ⟨_, sl, sh, _, _, _, _⟩ := hSame δ hz
    obtain ⟨hh0, _, _, _⟩ := hCln δ hz
    obtain ⟨hBaseV, heBc, hActBc, _⟩ := hClearPre δ hz
    exact hOneHot (actExprOneR eAct) 0 (Nat.zero_le 1) (fun b ↦ st δ (lW b)) (stC2 δ) (stPost δ)
      hBaseV (hMut δ hz) heBc hActBc (fun b ↦ by simp [sl b]) (fun b ↦ by simp [sh b, hh0 b])
      (fun x hlx hhx ↦ (stSplitRClear_other (stPost δ) hlx hhx).symm)
