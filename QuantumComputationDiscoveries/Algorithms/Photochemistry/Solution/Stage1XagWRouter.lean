        exact congrArg ket (upd3_add_cancel (st₁ δ) (rAuxScr i0) (rAuxScr i1) (rAuxScr iu) _ _ _)))

def wrapAuxChain {Var : Type} {n : ℕ} (v : Var)
    (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (mid : DynamicCircuit Var n) : (k : ℕ) → k ≤ 5 → DynamicCircuit Var n
  | 0, _ => mid
  | k + 1, hk =>
      wrapAuxRouter2 v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr ⟨5 - (k + 1), by omega⟩
        (wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid k (Nat.le_of_succ_le hk))

def stAuxChain {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (γ : BitAssignment n) : (k : ℕ) → k ≤ 5 → BitAssignment n
  | 0, _ => γ
  | k + 1, hk =>
      stAuxStep rAuxOut rAuxScr c ⟨k, hk⟩
        (stAuxChain rAuxOut rAuxScr c γ k (Nat.le_of_succ_le hk))

theorem counts_wrapAuxChain {Var : Type} {n : ℕ} (v : Var)
    (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (mid : DynamicCircuit Var n) :
    ∀ (k : ℕ) (hk : k ≤ 5),
      (wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid k hk).count .T =
        6 * k + mid.count .T ∧
      (wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid k hk).count .TOFF =
        mid.count .TOFF
  | 0, _ => ⟨(Nat.zero_add _).symm, rfl⟩
  | k + 1, hk => by
      obtain ⟨t1, f1⟩ :=
          counts_wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid k
          (Nat.le_of_succ_le hk)
      obtain ⟨t2, f2⟩ :=
          counts_wrapAuxRouter2 v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr ⟨5 - (k + 1),
          by omega⟩
        (wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid k (Nat.le_of_succ_le hk))
      dsimp only [wrapAuxChain]
      exact ⟨by rw [t2, t1]; omega, f2.trans f1⟩

theorem dw_wrapAuxChain {Var : Type} {n : ℕ} {S : Wire n → Prop} (v : Var)
    (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (hSrc : ∀ u : Fin 193, S (rSrc u)) (hOut : ∀ b : Fin 10, S (rAuxOut b))
    (hScr : ∀ i : Fin 24, S (rAuxScr i))
    (mid : DynamicCircuit Var n) (hMid : DynWires S mid) :
    ∀ (k : ℕ) (hk : k ≤ 5),
      DynWires S (wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid k hk)
  | 0, _ => hMid
  | k + 1, hk =>
      dw_wrapAuxRouter2 v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr hSrc hOut hScr _ _
        (dw_wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr hSrc hOut hScr mid hMid k
            (Nat.le_of_succ_le hk))

theorem stAuxChain_outside {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (γ : BitAssignment n) {x : Wire n}
    (hxO : ∀ g : Fin 10, x ≠ rAuxOut g) (hxS : ∀ a : Fin 24, x ≠ rAuxScr a) :
    ∀ (k : ℕ) (hk : k ≤ 5), stAuxChain rAuxOut rAuxScr c γ k hk x = γ x
  | 0, _ => rfl
  | k + 1, hk =>
    (stAuxStep_outside rAuxOut rAuxScr c ⟨k,
        hk⟩ _ hxO hxS).trans (stAuxChain_outside rAuxOut rAuxScr c γ hxO hxS k (Nat.le_of_succ_le
        hk))

theorem stAuxChain_rAuxOut_ge {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (c : Fin (2 ^ 41)) (γ : BitAssignment n) (g : Fin 10) :
    ∀ (k : ℕ) (hk : k ≤ 5), 2 * k ≤ g.val →
      stAuxChain rAuxOut rAuxScr c γ k hk (rAuxOut g) = γ (rAuxOut g)
  | 0, _, _ => rfl
  | k + 1, hk, hge =>
      (stAuxStep_rAuxOut_other rAuxOut rAuxScr hOutScr c ⟨k, hk⟩ _ g
        (by dsimp; omega) (by dsimp; omega)).trans
        (stAuxChain_rAuxOut_ge rAuxOut rAuxScr hOutScr c γ g k (Nat.le_of_succ_le hk) (by omega))

theorem stAuxChain_rAuxOut_lt {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (c : Fin (2 ^ 41)) (γ : BitAssignment n) (g : Fin 10) :
    ∀ (k : ℕ) (hk : k ≤ 5), g.val < 2 * k →
      stAuxChain rAuxOut rAuxScr c γ k hk (rAuxOut g) = auxRawBitVal c g
  | 0, _, hlt => absurd hlt (Nat.not_lt_zero _)
  | k + 1, hk, hlt => by
      dsimp only [stAuxChain]
      by_cases hprev : g.val < 2 * k
      · exact (stAuxStep_rAuxOut_other rAuxOut rAuxScr hOutScr c ⟨k, hk⟩ _ g
          (by dsimp; omega) (by dsimp; omega)).trans
          (stAuxChain_rAuxOut_lt rAuxOut rAuxScr hOutScr c γ g k (Nat.le_of_succ_le hk) hprev)
      · have hb : g.val - 2 * k < 2 := by omega
        have hgEq : g = ⟨2 * (⟨k, hk⟩ : Fin 5).val + (⟨g.val - 2 * k, hb⟩ : Fin 2).val,
                                            by dsimp; omega⟩ :=
          Fin.ext (by dsimp; omega)
        rw [hgEq]; exact stAuxStep_rAuxOut_hit rAuxOut rAuxScr c ⟨k, hk⟩ _ ⟨g.val - 2 * k, hb⟩
theorem stAuxChain_rAuxScr_unused {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (c : Fin (2 ^ 41)) (γ : BitAssignment n) (a : Fin 24) :
    ∀ (k : ℕ) (hk : k ≤ 5),
      (a.val < 4 ∨ (4 + 2 * k ≤ a.val ∧ a.val < 14) ∨ 14 + 2 * k ≤ a.val) →
      stAuxChain rAuxOut rAuxScr c γ k hk (rAuxScr a) = γ (rAuxScr a)
  | 0, _, _ => rfl
  | k + 1, hk, hbd =>
      (stAuxStep_rAuxScr_other rAuxOut rAuxScr hOutScr c ⟨k, hk⟩ _ a
        (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega)).trans
        (stAuxChain_rAuxScr_unused rAuxOut rAuxScr hOutScr c γ a k (Nat.le_of_succ_le hk)
            (by omega))

theorem stAuxChain_eq_step {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (γ : BitAssignment n) {k1 : ℕ} (hk1 : k1 ≤ 5) (idx : Fin 5)
    (heq : k1 = idx.val + 1) :
    stAuxChain rAuxOut rAuxScr c γ k1 hk1 =
      stAuxStep rAuxOut rAuxScr c idx (stAuxChain rAuxOut rAuxScr c γ idx.val (by omega)) := by
  subst heq; rfl
theorem step_wrapAux5 {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rWork : QRegister W n) (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n)
    (rAuxScr : QRegister 24 n) (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i) (hOutScr : ∀ (b : Fin 10)
    (i : Fin 24), rAuxOut b ≠ rAuxScr i) (coinFn : BitAssignment n → Fin (2 ^ 41))
    (st₀ st₁ : BitAssignment n → BitAssignment n) (mid : DynamicCircuit Var n)
    (hSrc₀ : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ u : Fin 193, st₀ δ (rSrc u) =
    if (e163Dom (coinFn δ)).testBit (1 + u.val) then 1 else 0)
    (hSrc₁ : ∀ δ, (∀ q, δ (rWork q) = 0) → ∀ u : Fin 193, st₁ δ (rSrc u) =
    if (e163Dom (coinFn δ)).testBit (1 + u.val) then 1 else 0)
    (hCln₀ : ∀ δ, (∀ q, δ (rWork q) = 0) → (∀ i : Fin 24, st₀ δ (rAuxScr i) = 0) ∧
    (∀ b : Fin 10, st₀ δ (rAuxOut b) = 0)) (hCln₁ : ∀ δ, (∀ q, δ (rWork q) = 0) →
    (∀ i : Fin 24, st₁ δ (rAuxScr i) = 0) ∧ (∀ b : Fin 10, st₁ δ (rAuxOut b) = 0))
    (hMid : SubspaceStep (mkKetOpW rWork (fun δ ↦ stAuxChain rAuxOut rAuxScr (coinFn δ)
    (st₀ δ) 5 le_rfl) (fun _ ↦ 0)) (mkKetOpW rWork (fun δ ↦ stAuxChain rAuxOut rAuxScr (coinFn δ)
    (st₁ δ) 5 le_rfl) (fun _ ↦ 0)) mid) : SubspaceStep (mkKetOpW rWork st₀ (fun _ ↦ 0))
    (mkKetOpW rWork st₁ (fun _ ↦ 0))
    (wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid 5 le_rfl) := by
  suffices hFrom : ∀ (m : ℕ) (hm : m ≤ 5), SubspaceStep
      (mkKetOpW rWork (fun δ ↦ stAuxChain rAuxOut rAuxScr (coinFn δ) (st₀ δ) (5 - m) (by omega))
          (fun _ ↦ 0))
      (mkKetOpW rWork (fun δ ↦ stAuxChain rAuxOut rAuxScr (coinFn δ) (st₁ δ) (5 - m) (by omega))
          (fun _ ↦ 0))
      (wrapAuxChain v rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr mid m hm) from hFrom 5 le_rfl
  intro m hm
  induction m with
  | zero => exact hMid
  | succ m ih =>
      let idx : Fin 5 := ⟨5 - (m + 1), by omega⟩
      obtain ⟨_, hE⟩ : idx.val < 5 ∧ 5 - m = idx.val + 1 := ⟨idx.isLt, by simp only [idx]; omega⟩
      have hClnAt (stB : BitAssignment n → BitAssignment n) (hCB : ∀ δ, (∀ q, δ (rWork q) = 0) →
            (∀ i : Fin 24, stB δ (rAuxScr i) = 0) ∧ ∀ b : Fin 10, stB δ (rAuxOut b) = 0)
          (δ : BitAssignment n) (hz : ∀ q, δ (rWork q) = 0) :
          AuxStepClean rAuxOut rAuxScr idx (stAuxChain rAuxOut rAuxScr (coinFn δ)
              (stB δ) idx.val (by omega)) := by
        obtain ⟨hCS, hCO⟩ := hCB δ hz
        have hs (a : Fin 24) (ha : a.val < 4 ∨ (4 + 2 * idx.val ≤ a.val ∧ a.val < 14) ∨
              14 + 2 * idx.val ≤ a.val := by dsimp <;> omega) :=
          (stAuxChain_rAuxScr_unused rAuxOut rAuxScr hOutScr (coinFn δ)
              (stB δ) a idx.val (by omega) ha).trans (hCS a)
        have ho (g : Fin 10) (hg : 2 * idx.val ≤ g.val := by dsimp <;> omega) :=
          (stAuxChain_rAuxOut_ge rAuxOut rAuxScr hOutScr (coinFn δ)
              (stB δ) g idx.val (by omega) hg).trans (hCO g)
        exact ⟨hs _, hs _, hs _, hs _, hs _, hs _, hs _, hs _, ho _, ho _⟩
      refine step_wrapAuxRouter2 v rWork rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr coinFn _ _ idx
          _
        (fun δ hz u ↦ (stAuxChain_outside rAuxOut rAuxScr _ _ (hSrcOut u)
            (hSrcScr u) _ _).trans (hSrc₀ δ hz u))
        (fun δ hz u ↦ (stAuxChain_outside rAuxOut rAuxScr _ _ (hSrcOut u)
            (hSrcScr u) _ _).trans (hSrc₁ δ hz u))
        (hClnAt st₀ hCln₀) (hClnAt st₁ hCln₁) ?_
      rw [← funext fun δ ↦ stAuxChain_eq_step rAuxOut rAuxScr (coinFn δ) (st₀ δ) (by omega) idx hE,
          ← funext fun δ ↦ stAuxChain_eq_step rAuxOut rAuxScr (coinFn δ) (st₁ δ) (by omega) idx hE]
      exact ih (Nat.le_of_succ_le hm)


/-! #### 5-CNOT `0-T` `b1` Decode Wrapper on `rAuxOut10` (`0 T`, `0 .TOFF`) -/

def cDecodeB1Fwd {n : ℕ} (rAuxOut : QRegister 10 n) : Circuit n :=
  let hNe : ∀ (a b : Fin 10), a ≠ b → rAuxOut a ≠ rAuxOut b := fun a b h ↦
      rAuxOut.wires.injective.ne h
  ((((Circuit.CNOT (rAuxOut 3) (rAuxOut 9) (hNe 3 9 (by decide)) ;;ᶜ
      Circuit.CNOT (rAuxOut 4) (rAuxOut 9) (hNe 4 9 (by decide))) ;;ᶜ
     Circuit.CNOT (rAuxOut 5) (rAuxOut 9) (hNe 5 9 (by decide))) ;;ᶜ
    Circuit.CNOT (rAuxOut 9) (rAuxOut 2) (hNe 9 2 (by decide))) ;;ᶜ
   Circuit.CNOT (rAuxOut 9) (rAuxOut 8) (hNe 9 8 (by decide)))

def cDecodeB1Rev {n : ℕ} (rAuxOut : QRegister 10 n) : Circuit n :=
  let hNe : ∀ (a b : Fin 10), a ≠ b → rAuxOut a ≠ rAuxOut b := fun a b h ↦
      rAuxOut.wires.injective.ne h
  ((((Circuit.CNOT (rAuxOut 9) (rAuxOut 8) (hNe 9 8 (by decide)) ;;ᶜ
      Circuit.CNOT (rAuxOut 9) (rAuxOut 2) (hNe 9 2 (by decide))) ;;ᶜ
     Circuit.CNOT (rAuxOut 5) (rAuxOut 9) (hNe 5 9 (by decide))) ;;ᶜ
    Circuit.CNOT (rAuxOut 4) (rAuxOut 9) (hNe 4 9 (by decide))) ;;ᶜ
   Circuit.CNOT (rAuxOut 3) (rAuxOut 9) (hNe 3 9 (by decide)))

def wrapDecodeB1 {Var : Type} {n : ℕ} (rAuxOut : QRegister 10 n) (mid : DynamicCircuit Var n) :
    DynamicCircuit Var n :=
    DynamicCircuit.seq (.circuit (cDecodeB1Fwd rAuxOut))
    (DynamicCircuit.seq mid (.circuit (cDecodeB1Rev rAuxOut)))
theorem counts_wrapDecodeB1 {Var : Type} {n : ℕ} (rAuxOut : QRegister 10 n)
    (mid : DynamicCircuit Var n) : (wrapDecodeB1 rAuxOut mid).count .T = mid.count .T ∧
    (wrapDecodeB1 rAuxOut mid).count .TOFF = mid.count .TOFF := by
  have hcT (w1 w2 : Wire n) (h : w1 ≠ w2) : (Circuit.CNOT w1 w2 h).count .T = 0 := rfl;
  have hcF (w1 w2 : Wire n) (h : w1 ≠ w2) : (Circuit.CNOT w1 w2 h).count .TOFF = 0 :=
      rfl; dsimp only [wrapDecodeB1, cDecodeB1Fwd, cDecodeB1Rev, DynamicCircuit.count]
  exact ⟨by repeat rw [Circuit.count_seq]; simp only [hcT, zero_add, add_zero],
         by repeat rw [Circuit.count_seq]; simp only [hcF, zero_add, add_zero]⟩

theorem dw_wrapDecodeB1 {Var : Type} {n : ℕ} {S : Wire n → Prop} (rAuxOut : QRegister 10 n)
    (hOut : ∀ b : Fin 10, S (rAuxOut b)) (mid : DynamicCircuit Var n) (hMid : DynWires S mid) :
    DynWires S (wrapDecodeB1 rAuxOut mid) :=
    ⟨⟨⟨⟨⟨cw_cnot (hOut _) (hOut _), cw_cnot (hOut _) (hOut _)⟩, cw_cnot (hOut _) (hOut _)⟩,
    cw_cnot (hOut _) (hOut _)⟩, cw_cnot (hOut _)
    (hOut _)⟩, ⟨hMid, ⟨⟨⟨⟨cw_cnot (hOut _) (hOut _), cw_cnot (hOut _) (hOut _)⟩, cw_cnot (hOut _)
    (hOut _)⟩, cw_cnot (hOut _) (hOut _)⟩, cw_cnot (hOut _) (hOut _)⟩⟩⟩
def stDecodeB1Fwd {n : ℕ} (rAuxOut : QRegister 10 n) (γ : BitAssignment n) : BitAssignment n :=
  let v9 := γ (rAuxOut 9) + γ (rAuxOut 3) + γ (rAuxOut 4) + γ (rAuxOut 5)
  Function.update
    (Function.update
      (Function.update γ (rAuxOut 9) v9)
      (rAuxOut 2) (γ (rAuxOut 2) + v9))
    (rAuxOut 8) (γ (rAuxOut 8) + v9)

theorem stDecodeB1Fwd_outside {n : ℕ} (rAuxOut : QRegister 10 n) (γ : BitAssignment n) {x : Wire n}
    (hxO : ∀ g : Fin 10, x ≠ rAuxOut g) : stDecodeB1Fwd rAuxOut γ x = γ x := by
  dsimp only [stDecodeB1Fwd];
  rw [Function.update_of_ne (hxO 8), Function.update_of_ne (hxO 2), Function.update_of_ne (hxO 9)]
theorem ket_cDecodeB1Fwd {n : ℕ} [NeZero (2 ^ n)] (rAuxOut : QRegister 10 n) (γ : BitAssignment n) :
    (cDecodeB1Fwd rAuxOut).eval.1.mulVec (ket γ) = ket (stDecodeB1Fwd rAuxOut γ) := by
  have hNe (a b : Fin 10) (h : a ≠ b := by decide) : rAuxOut a ≠ rAuxOut b :=
      rAuxOut.wires.injective.ne h
  dsimp only [cDecodeB1Fwd, stDecodeB1Fwd]
  rw [eval_seq_mulVec, eval_seq_mulVec, eval_seq_mulVec, eval_seq_mulVec, ket_CNOT, ket_CNOT,
      Function.update_self, Function.update_of_ne (hNe 4 9), Function.update_idem, ket_CNOT,
      Function.update_self, Function.update_of_ne (hNe 5 9), Function.update_idem, ket_CNOT,
      Function.update_of_ne (hNe 2 9), Function.update_self, ket_CNOT,
      Function.update_of_ne (hNe 8 2), Function.update_of_ne (hNe 8 9),
      Function.update_of_ne (hNe 9 2), Function.update_self]

theorem ket_cDecodeB1Rev_inv {n : ℕ} [NeZero (2 ^ n)] (rAuxOut : QRegister 10 n)
    (γ : BitAssignment n) :
    (cDecodeB1Rev rAuxOut).eval.1.mulVec (ket (stDecodeB1Fwd rAuxOut γ)) = ket γ := by
  have hNe (a b : Fin 10) (h : a ≠ b := by decide) : rAuxOut a ≠ rAuxOut b :=
      rAuxOut.wires.injective.ne h
  have hCan (a b : ZMod 2) : a + b + b = a := by rw [add_assoc, zmod2_add_self, add_zero]
  dsimp only [cDecodeB1Rev, stDecodeB1Fwd]
  rw [eval_seq_mulVec, eval_seq_mulVec, eval_seq_mulVec, eval_seq_mulVec, ket_CNOT,
      Function.update_self, Function.update_idem, Function.update_of_ne (hNe 9 8),
      Function.update_of_ne (hNe 9 2), Function.update_self, hCan, Function.update_comm (hNe 2 8),
      Function.update_comm (hNe 9 8), Function.update_eq_self, ket_CNOT, Function.update_self,
      Function.update_idem, Function.update_of_ne (hNe 9 2), Function.update_self, hCan,
      Function.update_comm (hNe 9 2), Function.update_eq_self, ket_CNOT, Function.update_self,
      Function.update_idem, Function.update_of_ne (hNe 5 9), hCan, ket_CNOT, Function.update_self,
      Function.update_idem, Function.update_of_ne (hNe 4 9), hCan, ket_CNOT, Function.update_self,
      Function.update_idem, Function.update_of_ne (hNe 3 9), hCan, Function.update_eq_self]

theorem zmod2_and_xor4 (l r9 r3 r4 r5 : Bool) :
    (if l && r9 then (1 : ZMod 2) else 0) + (if l && r3 then 1 else 0) +
      (if l && r4 then 1 else 0) + (if l && r5 then 1 else 0) =
      if l && xor (xor (xor r9 r3) r4) r5 then 1 else 0 := by
  cases l <;> cases r9 <;> cases r3 <;> cases r4 <;> cases r5 <;> decide

theorem zmod2_and_xor2 (l rA rB : Bool) :
    (if l && rA then (1 : ZMod 2) else 0) + (if l && rB then 1 else 0) =
      if l && xor rA rB then 1 else 0 := by
  cases l <;> cases rA <;> cases rB <;> decide

theorem stDecodeB1Fwd_rAuxOut_eq {n : ℕ} (rAuxOut : QRegister 10 n) (c : Fin (2 ^ 41))
    (γ : BitAssignment n) (hRaw : ∀ g : Fin 10, γ (rAuxOut g) = auxRawBitVal c g) (b : Fin 10) :
    stDecodeB1Fwd rAuxOut γ (rAuxOut b) = auxDecBitVal c b := by
  have hNe (x y : Fin 10) (h : x ≠ y) : rAuxOut x ≠ rAuxOut y := rAuxOut.wires.injective.ne h
  have hs1 : ∀ g : Fin 10, g ∈ [2, 3, 4, 5, 8, 9] → (auxSlotPairAt g.val).1 = tail5Mask 1 := by
    decide +kernel
  have hf1 : ∀ g : Fin 10, g ∈ [2, 8, 9] → (fgates173At (163 + g.val)).1 = tail5Mask 1 := by
    decide +kernel
  have hf2 : ∀ g : Fin 10, g ∈ [2, 8] → (fgates173At (163 + g.val)).2 =
      ((auxSlotPairAt g.val).2 ^^^ (fgates173At (163 + (9 : Fin 10).val)).2) := by decide +kernel
  have hx2 (k : Fin 10) (hkS : k ∈ [2, 3, 4, 5, 8, 9]) (hkF : k ∈ [2, 8, 9]) (hk2 : k ∈ [2, 8]) :
      γ (rAuxOut k) + auxDecBitVal c 9 = auxDecBitVal c k := by
    rw [hRaw k]
    dsimp only [auxRawBitVal, auxDecBitVal]
    rw [hs1 k hkS, hf1 9 (by decide), hf1 k hkF, hf2 k hk2, bOf_xor]
    exact zmod2_and_xor2 _ _ _
  dsimp only [stDecodeB1Fwd]
  rw [show γ (rAuxOut 9) + γ (rAuxOut 3) + γ (rAuxOut 4) + γ (rAuxOut 5) = auxDecBitVal c 9 by
    rw [hRaw 9, hRaw 3, hRaw 4, hRaw 5]
    dsimp only [auxRawBitVal, auxDecBitVal]
    rw [hs1 9 (by decide), hs1 3 (by decide), hs1 4 (by decide), hs1 5 (by decide),
        hf1 9 (by decide),
        (by decide +kernel : (fgates173At (163 + (9 : Fin 10).val)).2 =
          ((((auxSlotPairAt (9 : Fin 10).val).2 ^^^ (auxSlotPairAt (3 : Fin 10).val).2) ^^^
            (auxSlotPairAt (4 : Fin 10).val).2) ^^^ (auxSlotPairAt (5 : Fin 10).val).2)),
        bOf_xor, bOf_xor, bOf_xor]
    exact zmod2_and_xor4 _ _ _ _ _]
  rcases eq_or_ne b 8 with rfl | hb8
  · exact (Function.update_self _ _ _).trans (hx2 8 (by decide) (by decide) (by decide))
  rcases eq_or_ne b 2 with rfl | hb2
  · exact (Function.update_of_ne (hNe 2 8 hb8) _ _).trans
      ((Function.update_self _ _ _).trans (hx2 2 (by decide) (by decide) (by decide)))
  rcases eq_or_ne b 9 with rfl | hb9
  · rw [Function.update_of_ne (hNe 9 8 hb8), Function.update_of_ne (hNe 9 2 hb2),
        Function.update_self]
  · rw [Function.update_of_ne (hNe b 8 hb8), Function.update_of_ne (hNe b 2 hb2),
        Function.update_of_ne (hNe b 9 hb9), hRaw b]
    dsimp only [auxRawBitVal, auxDecBitVal]
    rw [(by decide +kernel : ∀ k : Fin 10, k ≠ 2 → k ≠ 8 → k ≠ 9 →
      auxSlotPairAt k.val = fgates173At (163 + k.val)) b hb2 hb8 hb9]

theorem step_wrapDecodeB1 {Var : Type} [Fintype Var] [DecidableEq Var] {W n : ℕ} [NeZero (2 ^ n)]
    (rWork : QRegister W n) (rAuxOut : QRegister 10 n)
    (st₀ st₁ : BitAssignment n → BitAssignment n) (mid : DynamicCircuit Var n)
    (hMid : SubspaceStep (mkKetOpW rWork (fun δ ↦ stDecodeB1Fwd rAuxOut (st₀ δ)) (fun _ ↦ 0))
      (mkKetOpW rWork (fun δ ↦ stDecodeB1Fwd rAuxOut (st₁ δ)) (fun _ ↦ 0)) mid) :
    SubspaceStep (mkKetOpW rWork st₀ (fun _ ↦ 0)) (mkKetOpW rWork st₁ (fun _ ↦ 0))
        (wrapDecodeB1 rAuxOut mid) :=
  (step_circ_mkKetOpW (Var := Var) rWork (cDecodeB1Fwd rAuxOut) st₀ _ _ fun δ _ ↦
      ket_cDecodeB1Fwd rAuxOut (st₀ δ)).seq
    (hMid.seq (step_circ_mkKetOpW (Var := Var) rWork (cDecodeB1Rev rAuxOut) _ st₁ _
      fun δ _ ↦ ket_cDecodeB1Rev_inv rAuxOut (st₁ δ)))

/-! #### 2-Step Hadamard-Kickback Stage on Lanes `30, 31` (`2 * 6 = 12 T`, `0 .TOFF`) -/

def hkMLs : List ℕ := [tail5Mask 4 ^^^ tail5Mask 2, ml30Mask]

def hkMYsAt (s : ℕ) : List ℕ :=
    if s = 0 then [0x1000000, 0x7801f820000000001] else [0x2000000, 0xa801f820000000000]
def hkMYs (s : Fin 2) : List ℕ := hkMYsAt s.val

def hkParityBool (c : Fin (2 ^ 41)) (s : Fin 2) : Bool := gatherParityAux c hkMLs (hkMYs s) 2
theorem hk_mutex (c : Fin (2 ^ 41)) (b1 b2 : ℕ) (h12 : b1 < b2) (h2 : b2 < 2) :
    (bOf c (hkMLs.getD b1 0) && bOf c (hkMLs.getD b2 0)) = false := by
  obtain ⟨rfl, rfl⟩ : b1 = 0 ∧ b2 = 1 := ⟨by omega, by omega⟩
  rw [show hkMLs.getD 0 0 = (gatherMLs ⟨30, by decide⟩).getD 2 0 by decide +kernel,
      show hkMLs.getD 1 0 = (gatherMLs ⟨30, by decide⟩).getD 3 0 by decide +kernel]
  exact mid32_gather_mutex c ⟨30, by decide⟩ 2 3 (by decide) (by decide)

theorem dom_hkMLs (b : Fin 2) : (domKeepMask &&& hkMLs.getD b.val 0 == hkMLs.getD b.val 0) =
    true := by
  revert b; decide +kernel

theorem dom_hkMYs (s : Fin 2)
    (b : Fin 2) : (domKeepMask &&& (hkMYs s).getD b.val 0 == (hkMYs s).getD b.val 0) = true := by
  revert s b; decide +kernel

def stHk01 {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (β : BitAssignment n) :
    BitAssignment n :=
  let q0 : Fin 40 := ⟨mid32OutIdx ⟨30, by decide⟩, mid32OutIdx_lt40 ⟨30, by decide⟩⟩
  let q1 : Fin 40 := ⟨mid32OutIdx ⟨31, by decide⟩, mid32OutIdx_lt40 ⟨31, by decide⟩⟩
  let s0 := Function.update β (rO q0) (β (rO q0) + if hkParityBool c 0 then 1 else 0)
  Function.update s0 (rO q1) (s0 (rO q1) + if hkParityBool c 1 then 1 else 0)


theorem stHk01_outside_rO {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (β : BitAssignment n)
    {x : Wire n} (hx : ∀ q : Fin 40, x ≠ rO q) : stHk01 rO c β x = β x := by
  dsimp only [stHk01]; rw [Function.update_of_ne (hx _), Function.update_of_ne (hx _)]
theorem mid32_q30_ne_q31 :
    mid32OutIdx ⟨30, by decide⟩ ≠ mid32OutIdx ⟨31, by decide⟩ := by decide

theorem stHk01_rO_apply {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41))
    (β : BitAssignment n) (q : Fin 40) :
    stHk01 rO c β (rO q) =
      β (rO q) +
        if q.val = mid32OutIdx ⟨31, by decide⟩ then
          if hkParityBool c 1 then 1 else 0
        else if q.val = mid32OutIdx ⟨30, by decide⟩ then
          if hkParityBool c 0 then 1 else 0
        else 0 := by
  dsimp only [stHk01]
  rcases eq_or_ne q ⟨mid32OutIdx ⟨31, by decide⟩, mid32OutIdx_lt40 _⟩ with rfl | h1
  · rw [ite_eq_left rfl, Function.update_self, Function.update_of_ne
        (rO.wires.injective.ne (Fin.ne_of_val_ne mid32_q30_ne_q31.symm))]
  · rw [ite_eq_right (Fin.val_ne_of_ne h1), Function.update_of_ne (rO.wires.injective.ne h1)]
    rcases eq_or_ne q ⟨mid32OutIdx ⟨30, by decide⟩, mid32OutIdx_lt40 _⟩ with rfl | h0
    · rw [ite_eq_left rfl, Function.update_self]
    · rw [ite_eq_right (Fin.val_ne_of_ne h0), Function.update_of_ne (rO.wires.injective.ne h0),
          add_zero]

theorem bOf_w191_imp_b15 (c : Fin (2 ^ 41)) :
    (bOf c (1 <<< 191) && Bool.not (bOf c (tail5Mask 0))) = false := by
  rw [bOf_w191_raw]
  cases bOf c (tail5Mask 0) <;> cases bOf c coreMask0Sym96 <;> rfl

theorem bOf_w192_imp_b1 (c : Fin (2 ^ 41)) :
    (bOf c (1 <<< 192) && Bool.not (bOf c (tail5Mask 1))) = false := by
  rw [bOf_w192_raw]
  cases bOf c (tail5Mask 1) <;> cases bOf c coreMask1Sym96 <;> rfl

theorem bOf_b15_imp_b14 (c : Fin (2 ^ 41)) : (bOf c (tail5Mask 0) &&
    Bool.not (bOf c (tail5Mask 3))) =
    false := by
  rw [bOf_tail5 c 0, bOf_tail5 c 3]; exact (zeroNErem_flag_props (decodeTier1W11Opt1424Coin c)).1
theorem bOf_b1_imp_b33 (c : Fin (2 ^ 41)) : (bOf c (tail5Mask 1) &&
    Bool.not (bOf c (tail5Mask 2))) =
    false := by
  rw [bOf_tail5 c 1, bOf_tail5 c 2];
  exact (zeroNErem_flag_props (decodeTier1W11Opt1424Coin c)).2.1
theorem groupA_taut (w191 b15 b14 y0 y1 : Bool) (h1 : (w191 && Bool.not b15) = false)
    (h2 : (b15 && Bool.not b14) = false) : (w191 && xor b14 w191) = false ∧
    xor (w191 && xor y1 (b15 && y0)) (b15 && y0) = xor (xor b15 w191 && y0)
    (w191 && y1) ∧ xor (w191 && xor y1 (b15 && y0)) (xor b14 w191 && xor y1 (b15 && y0)) =
    xor (xor b15 b14 && y1) (b15 && xor y1 y0) := by
  revert h1 h2
  cases w191 <;> cases b15 <;> cases b14 <;> cases y0 <;> cases y1 <;> decide

theorem groupBQ_taut (w192 b1 b33 b033 y0 y1 y2 : Bool) (h1 : (w192 && Bool.not b1) = false)
    (h2 : (b1 && Bool.not b33) = false) : (w192 && xor b33 w192) = false ∧
    xor (w192 && xor y1 (b1 && y0)) (b1 && y0) = xor (xor b1 w192 && y0)
    (w192 && y1) ∧ xor (xor (w192 && xor y1 (b1 && y0)) (xor b33 w192 && xor y1 (b1 && y0)))
    (b033 && y2) = xor (xor (xor b1 b33 && y1) (b1 && xor y1 y0)) (b033 && y2) := by
  revert h1 h2
  cases w192 <;> cases b1 <;> cases b33 <;> cases b033 <;>
    cases y0 <;> cases y1 <;> cases y2 <;> decide

theorem groupBA_taut (w192 b1 b33 y0 y1 hk0 hk1 : Bool) (h1 : (w192 && Bool.not b1) = false)
    (h2 : (b1 && Bool.not b33) = false) : (xor b33 w192 && w192) = false ∧ xor (xor b33 w192 &&
    xor y0 (b1 && y1)) (b1 && y1) = xor (xor b33 w192 && y0) (w192 && y1) ∧ xor (xor hk0 hk1)
    (xor (w192 && xor y0 (b1 && y1)) (b1 && y1)) = xor (xor (xor (xor b1 w192 && y1)
    (w192 && y0)) hk0) hk1 := by
  revert h1 h2
  cases w192 <;> cases b1 <;> cases b33 <;> cases y0 <;> cases y1 <;>
    cases hk0 <;> cases hk1 <;> decide

def valPairJLo (p : Fin 16) : ℕ :=
    if p.val < 8 then p.val else if p.val < 14 then 16 + (p.val - 8) else 28 + (p.val - 14)
def valPairJHi (p : Fin 16) : ℕ :=
    if p.val < 8 then 8 + p.val else if p.val < 14 then 22 + (p.val - 8) else 30 + (p.val - 14)
theorem valPairJLo_lt32 (p : Fin 16) : valPairJLo p < 32 := by
  have := p.isLt; dsimp only [valPairJLo]; split_ifs <;> omega
theorem valPairJHi_lt32 (p : Fin 16) : valPairJHi p < 32 := by
  have := p.isLt; dsimp only [valPairJHi]; split_ifs <;> omega
theorem valPairOutLoNeHi (p : Fin 16) : mid32OutIdx ⟨valPairJLo p, valPairJLo_lt32 p⟩ ≠
    mid32OutIdx ⟨valPairJHi p, valPairJHi_lt32 p⟩ := by
  fin_cases p <;> decide

def valPairGLo (p : Fin 16) : ℕ :=
    if p.val < 6 then 152 + p.val else if p.val < 8 then 163 + (p.val - 6) else if p.val =
    8 then 158 else if p.val = 9 then 165 else if p.val = 10 then 151 else if p.val =
    11 then 171 else if p.val < 14 then 167 + (p.val - 12) else if p.val = 14 then 172 else 166
def valPairGT (p : Fin 16) : ℕ :=
    if p.val < 12 then 159 + (p.val - 8) else if p.val < 14 then 169 + (p.val - 12) else 159
theorem valPairGLo_bounds (p : Fin 16) : 151 ≤ valPairGLo p ∧ valPairGLo p < 173 := by
  fin_cases p <;> decide

theorem valPairGT_bounds (p : Fin 16) : 151 ≤ valPairGT p ∧ valPairGT p < 173 := by
  fin_cases p <;> decide

def valPairMLs (p : Fin 16) : List ℕ :=
    if p.val < 8 then [1 <<< 191, tail5Mask 3 ^^^ (1 <<< 191)] else if p.val < 14 then [1 <<< 192,
    tail5Mask 2 ^^^ (1 <<< 192)] else [tail5Mask 2 ^^^ (1 <<< 192), 1 <<< 192]
def valPairBaseMask (p : Fin 16) : ℕ :=
    if p.val < 8 then (gatherMYsAt p.val).getD 1 0 else if p.val <
    14 then (gatherMYsAt (16 + (p.val - 8))).getD 1 0 else (gatherMYsAt (28 +
    (p.val - 14))).getD 0 0
def gate173Bit (c : Fin (2 ^ 41)) (g : ℕ) : Bool :=
    bOf c (fgates173At g).1 && bOf c (fgates173At g).2
theorem src214Bit_gate (c : Fin (2 ^ 41)) (g : ℕ) (hg1 : 151 ≤ g) (hg2 : g < 173) :
    src214Bit c ⟨41 + g, by omega⟩ = gate173Bit c g := by
  dsimp only [src214Bit, gate173Bit]
  rw [ite_eq_right (by omega)]
  have hsub : 41 + g - 41 = g := by omega
  rw [hsub]

def valUBool (c : Fin (2 ^ 41)) (p : Fin 16) : Bool :=
    xor (bOf c (valPairBaseMask p)) (gate173Bit c (valPairGLo p))
def valH0Bool (c : Fin (2 ^ 41)) (p : Fin 16) : Bool :=
    bOf c ((valPairMLs p).getD 0 0) && valUBool c p
def valH1Bool (c : Fin (2 ^ 41)) (p : Fin 16) : Bool :=
    bOf c ((valPairMLs p).getD 1 0) && valUBool c p
def valHHiBool (c : Fin (2 ^ 41)) (p : Fin 16) : Bool :=
    if p.val < 14 then xor (valH0Bool c p) (valH1Bool c p) else valH1Bool c p
def valLoBool (c : Fin (2 ^ 41)) (p : Fin 16) : Bool :=
    xor (valH0Bool c p) (gate173Bit c (valPairGLo p))
def valHiBool (c : Fin (2 ^ 41)) (p : Fin 16) : Bool :=
    if p.val < 8 then valHHiBool c p else if p.val < 14 then xor (valHHiBool c p)
    (gate173Bit c (valPairGT p)) else xor (valHHiBool c p) (gate173Bit c (valPairGLo p))
theorem valPair_mutex (c : Fin (2 ^ 41)) (p : Fin 16) (b1 b2 : ℕ) (h12 : b1 < b2)
    (h2 : b2 < 2) : (bOf c ((valPairMLs p).getD b1 0) && bOf c ((valPairMLs p).getD b2 0)) =
    false := by
  obtain ⟨rfl, rfl⟩ : b1 = 0 ∧ b2 = 1 := ⟨by omega, by omega⟩
  dsimp only [valPairMLs]
  split_ifs <;> simp only [list_getD_succ, list_getD_zero, bOf_xor]
  · exact (groupA_taut _ _ _ false false (bOf_w191_imp_b15 c) (bOf_b15_imp_b14 c)).1
  · exact (groupBQ_taut _ _ _ false false false false
      (bOf_w192_imp_b1 c) (bOf_b1_imp_b33 c)).1
  · exact (groupBA_taut _ _ _ false false false false
      (bOf_w192_imp_b1 c) (bOf_b1_imp_b33 c)).1

theorem fgates173_valGLo_A (p : Fin 16) (hp : p.val < 8) : fgates173At (valPairGLo p) =
    (tail5Mask 0, (gatherMYsAt p.val).getD 0 0) := by
  revert p; decide +kernel

theorem mys_hi_A (p : Fin 16) (hp : p.val < 8) : (gatherMYsAt (8 + p.val)).getD 0 0 =
    (gatherMYsAt p.val).getD 1 0 ∧ (gatherMYsAt (8 + p.val)).getD 1 0 =
    ((gatherMYsAt p.val).getD 1 0 ^^^ (gatherMYsAt p.val).getD 0 0) := by
  revert p; decide +kernel

theorem fgates173_valGLo_BQ (p : Fin 16) (hp1 : 8 ≤ p.val) (hp2 : p.val < 14) :
    fgates173At (valPairGLo p) = (tail5Mask 1, (gatherMYsAt (16 + (p.val - 8))).getD 0 0) := by
  revert p; decide +kernel

theorem fgates173_valGT_BQ (p : Fin 16) (hp1 : 8 ≤ p.val) (hp2 : p.val < 14) :
    fgates173At (valPairGT p) = (tail5Mask 4 ^^^ tail5Mask 2,
    (gatherMYsAt (22 + (p.val - 8))).getD 2 0) := by
  revert p; decide +kernel

theorem mys_hi_BQ (p : Fin 16) (hp1 : 8 ≤ p.val) (hp2 : p.val < 14) :
    (gatherMYsAt (22 + (p.val - 8))).getD 0 0 = (gatherMYsAt (16 + (p.val - 8))).getD 1 0 ∧
    (gatherMYsAt (22 + (p.val - 8))).getD 1 0 =
    ((gatherMYsAt (16 + (p.val - 8))).getD 1 0 ^^^ (gatherMYsAt (16 + (p.val - 8))).getD 0 0) := by
  revert p; decide +kernel

theorem fgates173_valGLo_BA (p : Fin 16) (hp : 14 ≤ p.val) : fgates173At (valPairGLo p) =
    (tail5Mask 1, (gatherMYsAt (28 + (p.val - 14))).getD 1 0) ∧
    (gatherMYsAt (30 + (p.val - 14))).getD 0 0 = (gatherMYsAt (28 + (p.val - 14))).getD 1 0 ∧
    (gatherMYsAt (30 + (p.val - 14))).getD 1 0 = (gatherMYsAt (28 + (p.val - 14))).getD 0 0 ∧
    (gatherMYsAt (30 + (p.val - 14))).getD 2 0 = (hkMYsAt (p.val - 14)).getD 0 0 ∧
    (gatherMYsAt (30 + (p.val - 14))).getD 3 0 = (hkMYsAt (p.val - 14)).getD 1 0 := by
  revert p; decide +kernel

theorem gatherMLs_lo_A (p : Fin 16) (hp : p.val < 8) : gatherR ⟨valPairJLo p, valPairJLo_lt32 p⟩ =
    2 ∧ gatherMLs ⟨valPairJLo p, valPairJLo_lt32 p⟩ = [tail5Mask 0 ^^^ (1 <<< 191), 1 <<< 191] := by
  revert p; decide +kernel

theorem gatherMLs_lo_BQ (p : Fin 16) (hp1 : 8 ≤ p.val) (hp2 : p.val < 14) : gatherR ⟨valPairJLo p,
    valPairJLo_lt32 p⟩ = 2 ∧ gatherMLs ⟨valPairJLo p, valPairJLo_lt32 p⟩ =
    [tail5Mask 1 ^^^ (1 <<< 192), 1 <<< 192] := by
  revert p; decide +kernel

theorem gatherMLs_lo_BA (p : Fin 16) (hp : 14 ≤ p.val) : gatherR ⟨valPairJLo p, valPairJLo_lt32 p⟩ =
    2 ∧ gatherMLs ⟨valPairJLo p, valPairJLo_lt32 p⟩ = [tail5Mask 2 ^^^ (1 <<< 192), 1 <<< 192] := by
  revert p; decide +kernel

theorem gatherMLs_hi_A (p : Fin 16) (hp : p.val < 8) : gatherR ⟨valPairJHi p, valPairJHi_lt32 p⟩ =
    2 ∧ gatherMLs ⟨valPairJHi p, valPairJHi_lt32 p⟩ = [tail5Mask 0 ^^^ tail5Mask 3, tail5Mask 0]
    := by
  revert p; decide +kernel

theorem gatherMLs_hi_BQ (p : Fin 16) (hp1 : 8 ≤ p.val) (hp2 : p.val < 14) : gatherR ⟨valPairJHi p,
    valPairJHi_lt32 p⟩ = 3 ∧ gatherMLs ⟨valPairJHi p, valPairJHi_lt32 p⟩ =
    [tail5Mask 1 ^^^ tail5Mask 2, tail5Mask 1, tail5Mask 4 ^^^ tail5Mask 2] := by
  revert p; decide +kernel

theorem gatherMLs_hi_BA (p : Fin 16) (hp : 14 ≤ p.val) : gatherR ⟨valPairJHi p, valPairJHi_lt32 p⟩ =
    4 ∧ gatherMLs ⟨valPairJHi p, valPairJHi_lt32 p⟩ = [tail5Mask 1 ^^^ (1 <<< 192), 1 <<< 192,
    tail5Mask 4 ^^^ tail5Mask 2, ml30Mask] := by
  revert p; decide +kernel

theorem valPair_lo_eq (c : Fin (2 ^ 41)) (p : Fin 16) : valLoBool c p = preCnotBit40 (m40VOpt c)
    (mid32OutIdx ⟨valPairJLo p, valPairJLo_lt32 p⟩) := by
  rw [← mid32_gather_eq c ⟨valPairJLo p, valPairJLo_lt32 p⟩]
  by_cases h8 : p.val < 8
  · have hfg := fgates173_valGLo_A p h8; obtain ⟨hr, hml⟩ := gatherMLs_lo_A p h8
    have hmy : gatherMYs ⟨valPairJLo p, valPairJLo_lt32 p⟩ = gatherMYsAt p.val := by
      rw [gatherMYs_eq_at]; dsimp only [valPairJLo]; rw [ite_eq_left h8]
    dsimp only [valLoBool, valH0Bool, valUBool, valPairMLs, valPairBaseMask, gate173Bit,
        gatherParityBool]; rw [ite_eq_left h8, ite_eq_left h8, hfg, hr, hml,
        hmy]; dsimp only [gatherParityAux]; simp only [list_getD_succ, list_getD_zero,
        Bool.false_xor, bOf_xor]; exact (groupA_taut _ _ _ _ _ (bOf_w191_imp_b15 c)
        (bOf_b15_imp_b14 c)).2.1
  · by_cases h14 : p.val < 14
    · have hp1 : 8 ≤ p.val := by omega
      have hfg := fgates173_valGLo_BQ p hp1 h14; obtain ⟨hr, hml⟩ := gatherMLs_lo_BQ p hp1 h14
      have hmy : gatherMYs ⟨valPairJLo p, valPairJLo_lt32 p⟩ = gatherMYsAt (16 + (p.val - 8)) := by
        rw [gatherMYs_eq_at]; dsimp only [valPairJLo]; rw [ite_eq_right h8, ite_eq_left h14]
      dsimp only [valLoBool, valH0Bool, valUBool, valPairMLs, valPairBaseMask, gate173Bit,
          gatherParityBool];
              rw [ite_eq_right h8, ite_eq_left h14, ite_eq_right h8, ite_eq_left h14, hfg, hr, hml,
          hmy]; dsimp only [gatherParityAux]; simp only [list_getD_succ, list_getD_zero,
          Bool.false_xor, bOf_xor]; exact (groupBQ_taut _ _ _ false _ _ false (bOf_w192_imp_b1 c)
          (bOf_b1_imp_b33 c)).2.1
    · have hp14 : 14 ≤ p.val := by omega
      have hfg := (fgates173_valGLo_BA p hp14).1; obtain ⟨hr, hml⟩ := gatherMLs_lo_BA p hp14
      have hmy : gatherMYs ⟨valPairJLo p, valPairJLo_lt32 p⟩ = gatherMYsAt (28 + (p.val - 14)) := by
        rw [gatherMYs_eq_at]; dsimp only [valPairJLo]; rw [ite_eq_right h8, ite_eq_right h14]
      dsimp only [valLoBool, valH0Bool, valUBool, valPairMLs, valPairBaseMask, gate173Bit,
          gatherParityBool];
              rw [ite_eq_right h8, ite_eq_right h14, ite_eq_right h8, ite_eq_right h14, hfg, hr,
              hml,
          hmy]; dsimp only [gatherParityAux]; simp only [list_getD_succ, list_getD_zero,
          Bool.false_xor, bOf_xor]; exact (groupBA_taut _ _ _ _ _ false false (bOf_w192_imp_b1 c)
          (bOf_b1_imp_b33 c)).2.1
theorem valPair_hi_eq_lt14 (c : Fin (2 ^ 41)) (p : Fin 16) (hp14 : p.val < 14) : valHiBool c p =
    preCnotBit40 (m40VOpt c) (mid32OutIdx ⟨valPairJHi p, valPairJHi_lt32 p⟩) := by
  rw [← mid32_gather_eq c ⟨valPairJHi p, valPairJHi_lt32 p⟩]
  by_cases h8 : p.val < 8
  · have hfg := fgates173_valGLo_A p h8; obtain ⟨hm0, hm1⟩ := mys_hi_A p h8; obtain ⟨hr, hml⟩ :=
        gatherMLs_hi_A p h8
    have hmy : gatherMYs ⟨valPairJHi p, valPairJHi_lt32 p⟩ = gatherMYsAt (8 + p.val) := by
      rw [gatherMYs_eq_at]; dsimp only [valPairJHi]; rw [ite_eq_left h8]
    dsimp only [valHiBool, valHHiBool, valH0Bool, valH1Bool, valUBool, valPairMLs, valPairBaseMask,
        gate173Bit, gatherParityBool];
            rw [ite_eq_left h8, ite_eq_left hp14, ite_eq_left h8, ite_eq_left h8, hfg, hr,
        hml, hmy]; dsimp only [gatherParityAux]; simp only [list_getD_succ, list_getD_zero,
        Bool.false_xor]; rw [hm0,
        hm1]; simp only [bOf_xor]; exact (groupA_taut _ _ _ _ _ (bOf_w191_imp_b15 c)
        (bOf_b15_imp_b14 c)).2.2
  · have hp1 : 8 ≤ p.val := by omega
    have hfgB := fgates173_valGLo_BQ p hp1 hp14;
    have hfgT := fgates173_valGT_BQ p hp1 hp14; obtain ⟨hm0, hm1⟩ :=
        mys_hi_BQ p hp1 hp14; obtain ⟨hr, hml⟩ := gatherMLs_hi_BQ p hp1 hp14
    have hmy : gatherMYs ⟨valPairJHi p, valPairJHi_lt32 p⟩ = gatherMYsAt (22 + (p.val - 8)) := by
      rw [gatherMYs_eq_at]; dsimp only [valPairJHi]; rw [ite_eq_right h8, ite_eq_left hp14]
    dsimp only [valHiBool, valHHiBool, valH0Bool, valH1Bool, valUBool, valPairMLs, valPairBaseMask,
        gate173Bit, gatherParityBool];
            rw [ite_eq_right h8, ite_eq_left hp14, ite_eq_left hp14, ite_eq_right h8,
        ite_eq_left hp14, ite_eq_right h8, ite_eq_left hp14, hfgB, hfgT, hr, hml,
        hmy]; dsimp only [gatherParityAux]; simp only [list_getD_succ, list_getD_zero,
        Bool.false_xor]; rw [hm0,
        hm1]; simp only [bOf_xor]; exact (groupBQ_taut _ _ _ _ _ _ _ (bOf_w192_imp_b1 c)
        (bOf_b1_imp_b33 c)).2.2
theorem valPair_hi_eq_ge14 (c : Fin (2 ^ 41)) (p : Fin 16) (hp14 : 14 ≤ p.val) :
    xor (hkParityBool c ⟨p.val - 14, by have := p.isLt; omega⟩) (valHiBool c p) =
      preCnotBit40 (m40VOpt c) (mid32OutIdx ⟨valPairJHi p, valPairJHi_lt32 p⟩) := by
  rw [← mid32_gather_eq c ⟨valPairJHi p, valPairJHi_lt32 p⟩]
  have h8 : ¬ p.val < 8 := by omega
  have h14 : ¬ p.val < 14 := by omega
  obtain ⟨hfg, hm0, hm1, hm2, hm3⟩ := fgates173_valGLo_BA p hp14; obtain ⟨hr, hml⟩ :=
      gatherMLs_hi_BA p hp14
  have hmy : gatherMYs ⟨valPairJHi p, valPairJHi_lt32 p⟩ = gatherMYsAt (30 + (p.val - 14)) := by
    rw [gatherMYs_eq_at]; dsimp only [valPairJHi]; rw [ite_eq_right h8, ite_eq_right h14]
  dsimp only [hkParityBool, hkMLs, hkMYs, valHiBool, valHHiBool, valH1Bool, valUBool, valPairMLs,
      valPairBaseMask, gate173Bit, gatherParityBool];
          rw [ite_eq_right h8, ite_eq_right h14, ite_eq_right h14,
      ite_eq_right h8, ite_eq_right h14, ite_eq_right h8, ite_eq_right h14, hfg, hr, hml,
      hmy]; dsimp only [gatherParityAux]; simp only [list_getD_succ, list_getD_zero,
      Bool.false_xor]; rw [hm0, hm1, hm2,
      hm3]; simp only [bOf_xor]; exact (groupBA_taut _ _ _ _ _ _ _ (bOf_w192_imp_b1 c)
      (bOf_b1_imp_b33 c)).2.2
def cEmitValDirect {n : ℕ} (rSrc214 : QRegister 214 n) (rO : QRegister 40 n)
    (hSrc214O : ∀ (u : Fin 214) (q : Fin 40), rSrc214 u ≠ rO q) (p : Fin 16) : Circuit n :=
  let qLo : Fin 40 :=
      ⟨mid32OutIdx ⟨valPairJLo p, valPairJLo_lt32 p⟩, mid32OutIdx_lt40 ⟨valPairJLo p,
      valPairJLo_lt32 p⟩⟩
  let qHi : Fin 40 :=
      ⟨mid32OutIdx ⟨valPairJHi p, valPairJHi_lt32 p⟩, mid32OutIdx_lt40 ⟨valPairJHi p,
      valPairJHi_lt32 p⟩⟩
  let gLoIdx : Fin 214 := ⟨41 + valPairGLo p, by have := (valPairGLo_bounds p).2; omega⟩
  let gTIdx : Fin 214 := ⟨41 + valPairGT p, by have := (valPairGT_bounds p).2; omega⟩
  if p.val < 8 then
    Circuit.CNOT (rSrc214 gLoIdx) (rO qLo) (hSrc214O gLoIdx qLo)
  else if p.val < 14 then
    Circuit.CNOT (rSrc214 gLoIdx) (rO qLo) (hSrc214O gLoIdx qLo) ;;ᶜ
    Circuit.CNOT (rSrc214 gTIdx) (rO qHi) (hSrc214O gTIdx qHi)
  else
    Circuit.CNOT (rSrc214 gLoIdx) (rO qLo) (hSrc214O gLoIdx qLo) ;;ᶜ
    Circuit.CNOT (rSrc214 gLoIdx) (rO qHi) (hSrc214O gLoIdx qHi)

def stValStep {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (p : Fin 16) (γ : BitAssignment n) :
    BitAssignment n :=
  let qLo : Fin 40 :=
      ⟨mid32OutIdx ⟨valPairJLo p, valPairJLo_lt32 p⟩, mid32OutIdx_lt40 ⟨valPairJLo p,
      valPairJLo_lt32 p⟩⟩
  let qHi : Fin 40 :=
      ⟨mid32OutIdx ⟨valPairJHi p, valPairJHi_lt32 p⟩, mid32OutIdx_lt40 ⟨valPairJHi p,
      valPairJHi_lt32 p⟩⟩
  Function.update
    (Function.update γ (rO qLo) (γ (rO qLo) + if valLoBool c p then 1 else 0))
    (rO qHi) (γ (rO qHi) + if valHiBool c p then 1 else 0)


theorem stSplitRFwd_upd_other {n R : ℕ} (uWire : Wire n) (lW hW : Fin R → Wire n)
    (β : BitAssignment n) {w : Wire n} (val : ZMod 2) (hwu : w ≠ uWire)
    (hwl : ∀ b : Fin R, w ≠ lW b) (hwh : ∀ b : Fin R, w ≠ hW b) :
    Function.update (stSplitRFwd uWire lW hW β) w val =
    stSplitRFwd uWire lW hW (Function.update β w val) := by
  funext x
  rcases eq_or_ne x w with rfl | hxw
  · rw [Function.update_self, stSplitRFwd_other _ hwl hwh, Function.update_self]
  · have hL (b : Fin R) : Function.update β w val (lW b) = β (lW b) :=
        Function.update_of_ne (hwl b).symm _ _
    rw [Function.update_of_ne hxw]
    dsimp only [stSplitRFwd]
    cases findBranch lW x <;> cases findBranch hW x <;>
      simp only [hL, Function.update_of_ne hwu.symm, Function.update_of_ne hxw]

theorem z2_mul_ite_and (a b : Bool) : (if a then (1 : ZMod 2) else 0) * (if b then 1 else 0) =
    if (a && b) then 1 else 0 := by
  cases a <;> cases b <;> decide

theorem dom_valPairMLs (p : Fin 16)
    (b : Fin 2) : (domKeepMask &&& (valPairMLs p).getD b.val 0 == (valPairMLs p).getD b.val 0) =
    true := by
  revert p b; decide +kernel

theorem dom_valPairBase (p : Fin 16) : (domKeepMask &&& valPairBaseMask p == valPairBaseMask p) =
    true := by
  revert p; decide +kernel

theorem count_cEmitValDirect {n : ℕ} (rSrc214 : QRegister 214 n) (rO : QRegister 40 n)
    (hSrc214O : ∀ (u : Fin 214) (q : Fin 40), rSrc214 u ≠ rO q)
    (p : Fin 16) : (cEmitValDirect rSrc214 rO hSrc214O p).count .T = 0 ∧
    (cEmitValDirect rSrc214 rO hSrc214O p).count .TOFF = 0 := by
  dsimp only [cEmitValDirect]
  split_ifs <;> simp [Circuit.CNOT]

theorem cw_cEmitValDirect {n : ℕ} {S : Wire n → Prop} (rSrc214 : QRegister 214 n)
    (rO : QRegister 40 n) (hSrc214O : ∀ (u : Fin 214) (q : Fin 40), rSrc214 u ≠ rO q)
    (hSrc214 : ∀ u : Fin 214, S (rSrc214 u)) (hO : ∀ q : Fin 40, S (rO q))
    (p : Fin 16) : CircWires S (cEmitValDirect rSrc214 rO hSrc214O p) := by
  dsimp only [cEmitValDirect]; split_ifs
  · exact cw_cnot (hSrc214 _) (hO _)
  · exact ⟨cw_cnot (hSrc214 _) (hO _), cw_cnot (hSrc214 _) (hO _)⟩
  · exact ⟨cw_cnot (hSrc214 _) (hO _), cw_cnot (hSrc214 _) (hO _)⟩

def stValChain {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41)) (γ : BitAssignment n) :
    (k : ℕ) → k ≤ 16 → BitAssignment n
  | 0, _ => γ
  | k + 1, hk =>
      stValStep rO c ⟨k, hk⟩ (stValChain rO c γ k (Nat.le_of_succ_le hk))

theorem stValChain_outside_rO {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41))
    (γ : BitAssignment n) {x : Wire n} (hx : ∀ q : Fin 40, x ≠ rO q) :
    ∀ (k : ℕ) (hk : k ≤ 16), stValChain rO c γ k hk x = γ x
  | 0, _ => rfl
  | k + 1, hk => by
      dsimp only [stValChain, stValStep]
      rw [Function.update_of_ne (hx _), Function.update_of_ne (hx _)]
      exact stValChain_outside_rO rO c γ hx k (Nat.le_of_succ_le hk)

def valStepDelta (c : Fin (2 ^ 41)) (p : Fin 16) (qVal : ℕ) : ZMod 2 :=
    if qVal = mid32OutIdx ⟨valPairJHi p,
    valPairJHi_lt32 p⟩ then if valHiBool c p then 1 else 0 else if qVal = mid32OutIdx ⟨valPairJLo p,
    valPairJLo_lt32 p⟩ then if valLoBool c p then 1 else 0 else 0
def valChainDeltaAux (c : Fin (2 ^ 41)) (qVal : ℕ) : (k : ℕ) → k ≤ 16 → ZMod 2
  | 0, _ => 0
  | k + 1, hk => valChainDeltaAux c qVal k (Nat.le_of_succ_le hk) + valStepDelta c ⟨k, hk⟩ qVal

theorem valChainDeltaAux_eq_sumPrefix (c : Fin (2 ^ 41)) (qVal : ℕ) :
    ∀ (k : ℕ) (hk : k ≤ 16), valChainDeltaAux c qVal k hk = sumPrefix (fun p : Fin 16 ↦
        valStepDelta c p qVal) k hk
  | 0, _ => rfl
  | k + 1, hk =>
    congrArg (· + valStepDelta c ⟨k, hk⟩ qVal)
        (valChainDeltaAux_eq_sumPrefix c qVal k (Nat.le_of_succ_le hk))

theorem stValChain_rO_apply {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41))
    (γ : BitAssignment n) (q : Fin 40) :
    ∀ (k : ℕ) (hk : k ≤ 16),
      stValChain rO c γ k hk (rO q) = γ (rO q) + valChainDeltaAux c q.val k hk
  | 0, _ => (add_zero _).symm
  | k + 1, hk => by
      dsimp only [stValChain, valChainDeltaAux, stValStep, valStepDelta]
      rw [← add_assoc, ← stValChain_rO_apply rO c γ q k (Nat.le_of_succ_le hk)]
      rcases eq_or_ne q ⟨mid32OutIdx ⟨valPairJHi ⟨k, hk⟩, valPairJHi_lt32 _⟩,
          mid32OutIdx_lt40 _⟩ with rfl | hH
      · rw [ite_eq_left rfl, Function.update_self]
      · rw [ite_eq_right (Fin.val_ne_of_ne hH), Function.update_of_ne (rO.wires.injective.ne hH)]
        rcases eq_or_ne q ⟨mid32OutIdx ⟨valPairJLo ⟨k, hk⟩, valPairJLo_lt32 _⟩,
            mid32OutIdx_lt40 _⟩ with rfl | hL
        · rw [ite_eq_left rfl, Function.update_self]
        · rw [ite_eq_right (Fin.val_ne_of_ne hL), Function.update_of_ne (rO.wires.injective.ne hL),
              add_zero]

theorem valStepDelta_mid32 (c : Fin (2 ^ 41)) (p : Fin 16) (j : Fin 32) :
    valStepDelta c p (mid32OutIdx j) =
      if j.val = valPairJHi p then if valHiBool c p then 1 else 0
      else if j.val = valPairJLo p then if valLoBool c p then 1 else 0 else 0 := by
  dsimp only [valStepDelta]
  simp only [show (mid32OutIdx j = mid32OutIdx ⟨valPairJHi p, valPairJHi_lt32 p⟩) ↔ j.val =
      valPairJHi p from
               ⟨fun e ↦ congrArg Fin.val (mid32OutIdx_injective e), fun e ↦
                   congrArg mid32OutIdx (Fin.ext e)⟩,
             show (mid32OutIdx j = mid32OutIdx ⟨valPairJLo p, valPairJLo_lt32 p⟩) ↔ j.val =
                 valPairJLo p from
               ⟨fun e ↦ congrArg Fin.val (mid32OutIdx_injective e), fun e ↦
                   congrArg mid32OutIdx (Fin.ext e)⟩]

theorem stValChain_after_hk_nonmid {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41))
    (β : BitAssignment n) (q : Fin 40) (h : ∀ j : Fin 32, q.val ≠ mid32OutIdx j) :
    stValChain rO c (stHk01 rO c β) 16 le_rfl (rO q) = β (rO q) := by
  rw [stValChain_rO_apply, valChainDeltaAux_eq_sumPrefix,
      sumPrefix_zero (fun p ↦ by simp only [valStepDelta, h, ↓reduceIte]) 16 le_rfl,
      add_zero, stHk01_rO_apply, ite_eq_right (h ⟨31, by decide⟩), ite_eq_right (h ⟨30, by decide⟩),
          add_zero]

theorem stValChain_after_hk_mid32 {n : ℕ} (rO : QRegister 40 n) (c : Fin (2 ^ 41))
    (β : BitAssignment n) (j : Fin 32) :
    stValChain rO c (stHk01 rO c β) 16 le_rfl (rO ⟨mid32OutIdx j, mid32OutIdx_lt40 j⟩) =
      β (rO ⟨mid32OutIdx j, mid32OutIdx_lt40 j⟩) + if preCnotBit40 (m40VOpt c)
          (mid32OutIdx j) then 1 else 0 := by
  obtain ⟨hLH, hLL, hHH⟩ : (∀ p₁ p₂ : Fin 16, valPairJLo p₁ ≠ valPairJHi p₂) ∧
      (∀ p₁ p₂ : Fin 16, p₁ ≠ p₂ → valPairJLo p₁ ≠ valPairJLo p₂) ∧
      (∀ p₁ p₂ : Fin 16, p₁ ≠ p₂ → valPairJHi p₁ ≠ valPairJHi p₂) := by decide +kernel
  rw [stValChain_rO_apply, valChainDeltaAux_eq_sumPrefix, stHk01_rO_apply]
  dsimp only
  rcases (by decide +kernel : ∀ k : Fin 32,
      (∃ p : Fin 16, k.val = valPairJLo p) ∨ (∃ p : Fin 16, k.val = valPairJHi p)) j with
    ⟨p, hpLo⟩ | ⟨p, hpHi⟩
  · obtain rfl : j = ⟨valPairJLo p, valPairJLo_lt32 p⟩ := Fin.ext hpLo
    obtain ⟨hNe1, hNe0⟩ := (by decide +kernel : ∀ q : Fin 16,
      mid32OutIdx ⟨valPairJLo q, valPairJLo_lt32 q⟩ ≠ mid32OutIdx ⟨31, by decide⟩ ∧
      mid32OutIdx ⟨valPairJLo q, valPairJLo_lt32 q⟩ ≠ mid32OutIdx ⟨30, by decide⟩) p
    rw [ite_eq_right hNe1, ite_eq_right hNe0, add_zero, sumPrefix_single p (if valLoBool c p then 1
        else 0)
          (by rw [valStepDelta_mid32, ite_eq_right (hLH p p), ite_eq_left rfl])
          (fun q hne ↦ by
              rw [valStepDelta_mid32, ite_eq_right (hLH p q), ite_eq_right (hLL p q hne.symm)]),
              valPair_lo_eq c p]
  · obtain rfl : j = ⟨valPairJHi p, valPairJHi_lt32 p⟩ := Fin.ext hpHi
    rw [sumPrefix_single p (if valHiBool c p then 1 else 0) (by
        rw [valStepDelta_mid32, ite_eq_left rfl])
          (fun q hne ↦ by
            rw [valStepDelta_mid32, ite_eq_right (hHH p q hne.symm), ite_eq_right (hLH q p).symm])]
    by_cases hp14 : p.val < 14
    · obtain ⟨hNe1, hNe0⟩ := (by decide +kernel : ∀ q : Fin 16, q.val < 14 →
        mid32OutIdx ⟨valPairJHi q, valPairJHi_lt32 q⟩ ≠ mid32OutIdx ⟨31, by decide⟩ ∧
        mid32OutIdx ⟨valPairJHi q, valPairJHi_lt32 q⟩ ≠ mid32OutIdx ⟨30, by decide⟩) p hp14
      rw [ite_eq_right hNe1, ite_eq_right hNe0, add_zero, valPair_hi_eq_lt14 c p hp14]
    · rcases (by decide : ∀ q : Fin 16, ¬q.val < 14 → q = 14 ∨ q = 15) p hp14 with rfl | rfl
      · rw [ite_eq_right (by decide), ite_eq_left (by decide), add_assoc, z2_add_ite_xor]
        exact congrArg (fun b ↦ β _ + if b then 1 else 0) (valPair_hi_eq_ge14 c 14 (by decide))
      · rw [ite_eq_left (by decide), add_assoc, z2_add_ite_xor]
        exact congrArg (fun b ↦ β _ + if b then 1 else 0) (valPair_hi_eq_ge14 c 15 (by decide))


/-!
#### Update-Commute & Off-`rO` Congruence Helpers for `stRt147Step` , `stAuxChain` , `stDecodeB1Fwd`
-/

theorem stAuxStep_upd_outside {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (idx : Fin 5) (γ : BitAssignment n) {w : Wire n} (b : ZMod 2)
    (hwO : ∀ g : Fin 10, w ≠ rAuxOut g) (hwS : ∀ a : Fin 24, w ≠ rAuxScr a) :
    stAuxStep rAuxOut rAuxScr c idx (Function.update γ w b) =
    Function.update (stAuxStep rAuxOut rAuxScr c idx γ) w b := by
  dsimp only [stAuxStep];
  rw [Function.update_comm (hwS _), Function.update_comm (hwS _), Function.update_comm (hwS _),
      Function.update_comm (hwS _), Function.update_comm (hwO _), Function.update_comm (hwO _)]
theorem stAuxChain_upd_outside {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (γ : BitAssignment n) {w : Wire n} (b : ZMod 2)
    (hwO : ∀ g : Fin 10, w ≠ rAuxOut g) (hwS : ∀ a : Fin 24, w ≠ rAuxScr a) :
    ∀ (k : ℕ) (hk : k ≤ 5),
      stAuxChain rAuxOut rAuxScr c (Function.update γ w b) k hk =
        Function.update (stAuxChain rAuxOut rAuxScr c γ k hk) w b
  | 0, _ => rfl
  | k + 1, hk => by
      dsimp only [stAuxChain];
      rw [stAuxChain_upd_outside rAuxOut rAuxScr c γ b hwO hwS k (Nat.le_of_succ_le hk),
          stAuxStep_upd_outside rAuxOut rAuxScr c ⟨k, hk⟩ _ b hwO hwS]
theorem stDecodeB1Fwd_upd_outside {n : ℕ} (rAuxOut : QRegister 10 n) (γ : BitAssignment n)
    {w : Wire n} (b : ZMod 2) (hwO : ∀ g : Fin 10, w ≠ rAuxOut g) :
    stDecodeB1Fwd rAuxOut (Function.update γ w b) =
    Function.update (stDecodeB1Fwd rAuxOut γ) w b := by
  dsimp only [stDecodeB1Fwd];
  rw [Function.update_of_ne (hwO 9).symm, Function.update_of_ne (hwO 3).symm,
      Function.update_of_ne (hwO 4).symm, Function.update_of_ne (hwO 5).symm,
      Function.update_of_ne (hwO 2).symm, Function.update_of_ne (hwO 8).symm,
      Function.update_comm (hwO 9), Function.update_comm (hwO 2), Function.update_comm (hwO 8)]
theorem upd_congr_at {α β : Type*} [DecidableEq α] {f g : α → β} {w x : α} {v : β}
    (h : f x = g x) : Function.update f w v x = Function.update g w v x := by
  by_cases hxw : x = w <;> simp [hxw, h]

theorem stAuxStep_congr_pred {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) (idx : Fin 5) {P : Wire n → Prop} (γ₁ γ₂ : BitAssignment n)
    (hEq : ∀ x, P x → γ₁ x = γ₂ x) :
    ∀ x, P x → stAuxStep rAuxOut rAuxScr c idx γ₁ x = stAuxStep rAuxOut rAuxScr c idx γ₂ x := by
  intro x hx
  dsimp only [stAuxStep]
  exact upd_congr_at (upd_congr_at (upd_congr_at (upd_congr_at (upd_congr_at (upd_congr_at
      (hEq x hx))))))

theorem stAuxChain_congr_pred {n : ℕ} (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n)
    (c : Fin (2 ^ 41)) {P : Wire n → Prop}
    (γ₁ γ₂ : BitAssignment n) (hEq : ∀ x, P x → γ₁ x = γ₂ x) :
    ∀ (k : ℕ) (hk : k ≤ 5) (x : Wire n), P x →
      stAuxChain rAuxOut rAuxScr c γ₁ k hk x = stAuxChain rAuxOut rAuxScr c γ₂ k hk x
  | 0, _, x, hx => hEq x hx
  | k + 1, hk, x, hx =>
      stAuxStep_congr_pred rAuxOut rAuxScr c ⟨k, hk⟩ _ _
        (stAuxChain_congr_pred rAuxOut rAuxScr c γ₁ γ₂ hEq k (Nat.le_of_succ_le hk)) x hx

theorem stDecodeB1Fwd_congr_pred {n : ℕ} (rAuxOut : QRegister 10 n) {P : Wire n → Prop}
    (hOutP : ∀ g : Fin 10, P (rAuxOut g)) (γ₁ γ₂ : BitAssignment n)
    (hEq : ∀ x, P x → γ₁ x = γ₂ x) :
    ∀ x, P x → stDecodeB1Fwd rAuxOut γ₁ x = stDecodeB1Fwd rAuxOut γ₂ x := by
  intro x hx
  dsimp only [stDecodeB1Fwd]
  rw [hEq _ (hOutP 9), hEq _ (hOutP 3), hEq _ (hOutP 4), hEq _ (hOutP 5),
      hEq _ (hOutP 2), hEq _ (hOutP 8)]
  exact upd_congr_at (upd_congr_at (upd_congr_at (hEq x hx)))
theorem env139_eq_fwd163 (c : Fin (2 ^ 41)) :
    env139 c = xagEnv c.val 163 fgates163 139 (by decide) :=
  (env139_eq_fwd c).trans
    (xagEnv_indep_N c.val fgates fgates163 139 (by decide) (by decide) fun g hg ↦ by
      dsimp only [fgates163, fgates, fgates173At]
      rw [Nat.blt_eq.mpr (by omega)]; rfl)

