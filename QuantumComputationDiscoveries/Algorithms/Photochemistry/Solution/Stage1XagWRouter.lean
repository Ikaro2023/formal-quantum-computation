abbrev checkCert151 : (ℕ → ℕ × ℕ) → List ℕ → List ℕ → List ((Bool × ℕ) × (Bool × ℕ)) → Bool :=
  checkCertGen 151

def checkDisjPairsVec151 (K E : ℕ) (gcs : List ((Bool × ℕ) × (Bool × ℕ)))
    (cPairs : List ((Bool × ℕ) × (Bool × ℕ))) : Bool :=
  let p := initCols K
  let ones := p.1
  let cols := simVecIdx K ones p.2 gcs
  let n := K + E
  (List.range cPairs.length).all fun i ↦
    let cp := cPairs.getD i ((false, 0), (false, 0))
    let v1 := evalCoordVec ones cols n cp.1
    let v2 := evalCoordVec ones cols n cp.2
    ((v1 &&& v2) &&& ones) == 0

def checkDisjPairsRecon151 (basis exp : List ℕ) (mPairs : List (ℕ × ℕ))
    (cPairs : List ((Bool × ℕ) × (Bool × ℕ))) : Bool :=
  decide (mPairs.length = cPairs.length) &&
  (List.range mPairs.length).all fun i ↦
    let mp := mPairs.getD i (0, 0)
    let cp :=
        cPairs.getD i ((false, 0), (false, 0)); decide (reconMask basis exp cp.1.1 cp.1.2 = mp.1) &&
    decide (reconMask basis exp cp.2.1 cp.2.2 = mp.2)

theorem disjPairs151_of_cert {basis exp : List ℕ} {gcs : List ((Bool × ℕ) × (Bool × ℕ))}
    {mPairs : List (ℕ × ℕ)} {cPairs : List ((Bool × ℕ) × (Bool × ℕ))}
    (hCert : checkCert151 fgatesAtOpt basis exp gcs = true)
    (hRecon : checkDisjPairsRecon151 basis exp mPairs cPairs = true)
    (hVec : checkDisjPairsVec151 basis.length exp.length gcs cPairs = true) (c : Fin (2 ^ 41))
    (i : ℕ) (hi : i < mPairs.length) : (bOf c (mPairs.getD i (0, 0)).1 &&
    bOf c (mPairs.getD i (0, 0)).2) = false := by
  let env := e151 c
  have h0 : env.testBit 0 = true := xagEnv_bit0 c.val fgates 151 le_rfl
  have hexp := checkCertGen_exp_lt hCert
  obtain ⟨hOnes, hEval⟩ := simVecIdx_evalCoord_eqGen (by decide : 42 + 151 ≤ 193) hCert h0
    fun e he ↦
        xagEnv_gate_bit c.val c.isLt fgates (checkGatesWf_imp wf_fgates) 151 le_rfl (exp.getD e 0)
        (hexp e he)
  simp only [checkDisjPairsRecon151, Bool.and_eq_true, decide_eq_true_eq,
      List.all_eq_true] at hRecon
  have hrI := hRecon.2 i (List.mem_range.mpr hi)
  have evEq (cd : Bool × ℕ) : evalCoord basis.length exp.length (envStGen 193 basis exp env) cd =
      bOf c (reconMask basis exp cd.1 cd.2) :=
    reconMask_oddBitsGen (by decide : 42 + 151 ≤ 193) h0 hexp cd.1 cd.2
  have hBit :=
      congrArg (Nat.testBit
      · (packBits (fun j ↦ oddBits (env &&& basis.getD j 0) 193) basis.length))
    (beq_iff_eq.mp ((List.all_eq_true.mp hVec) i (List.mem_range.mpr (by omega))))
  rwa [Nat.testBit_and, Nat.zero_testBit, hOnes, Bool.and_true, Nat.testBit_and, hEval, hEval, evEq,
      evEq, hrI.1, hrI.2] at hBit

def xorSublist : List ℕ → ℕ → ℕ
  | [], _ => 0
  | z :: zs, comb => (if comb.testBit 0 then z else 0) ^^^ xorSublist zs (comb >>> 1)

theorem bOf_xorSublist_false (c : Fin (2 ^ 41)) :
    ∀ (zs : List ℕ) (comb : ℕ), (∀ z ∈ zs, bOf c z = false) →
      bOf c (xorSublist zs comb) = false
  | [], _, _ => bOf_zero c
  | z :: zs, comb, hz => by
      dsimp only [xorSublist]
      rw [bOf_xor, bOf_xorSublist_false c zs (comb >>> 1)
          (fun x hx ↦ hz x (List.mem_cons_of_mem z hx))]
      cases comb.testBit 0
      · rw [ite_eq_right Bool.false_ne_true, bOf_zero]; rfl
      · rw [ite_eq_left rfl, hz z List.mem_cons_self]; rfl

def checkDominoSteps (f : ℕ → ℕ × ℕ) : List ℕ → List (ℕ × Bool × ℕ) → Bool
  | _, [] => true
  | zs, (g, side, comb) :: rest =>
      decide (g < 151) &&
      decide (xorSublist zs comb = (if side then (f g).2 else (f g).1)) &&
      checkDominoSteps f (zs ++ [1 <<< (42 + g)]) rest

def dominoFinalZs : List ℕ → List (ℕ × Bool × ℕ) → List ℕ
  | zs, [] => zs
  | zs, (g, _, _) :: rest => dominoFinalZs (zs ++ [1 <<< (42 + g)]) rest

theorem dominoSteps_zero (c : Fin (2 ^ 41)) :
    ∀ (zs : List ℕ) (steps : List (ℕ × Bool × ℕ)),
      checkDominoSteps fgatesAtOpt zs steps = true →
      (∀ z ∈ zs, bOf c z = false) →
      ∀ z ∈ dominoFinalZs zs steps, bOf c z = false
  | zs, [], _, hz => hz
  | zs, (g, side, comb) :: rest, hChk, hz => by
      simp only [checkDominoSteps, Bool.and_eq_true, decide_eq_true_eq] at hChk
      rcases hChk with ⟨⟨hg, hComb⟩, hRest⟩
      have _ := (congrArg (bOf c) hComb.symm).trans (bOf_xorSublist_false c zs comb hz)
      refine dominoSteps_zero c _ rest hRest fun x hx ↦
          (List.mem_append.mp hx).elim (hz x) fun hx1 ↦ ?_
      rw [List.mem_singleton.mp hx1, bOf_gate_bit c g hg]
      cases side <;> simp_all


