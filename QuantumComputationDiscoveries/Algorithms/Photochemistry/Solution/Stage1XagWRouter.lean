theorem env163_maskParity193 {n : ℕ} (rSrc : QRegister 193 n) (c : Fin (2 ^ 41))
    (γ : BitAssignment n) (hγ : ∀ u : Fin 193, γ (rSrc u) = if (e163Dom c).testBit (1 +
