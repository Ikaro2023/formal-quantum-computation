/-! ### Part 3: Full XAG Equivalence (`fgates` / `rgates` vs `Opt1416`) & Router Specs -/

theorem xagEnv_bit0 {N : ℕ} (c : ℕ) (gates : Fin N → ℕ × ℕ) :
    ∀ (k : ℕ) (hk : k ≤ N), (xagEnv c N gates k hk).testBit 0 = true
  | 0, _ => by simp [xagEnv]
  | k + 1, hk => by
      dsimp only [xagEnv]; have ih := xagEnv_bit0 c gates k (Nat.le_of_succ_le hk); split_ifs
      · rw [Nat.testBit_or, ih, Bool.true_or]
      · exact ih

theorem xagEnv_above_false {N : ℕ} (c : ℕ) (hc : c < 2 ^ 41) (gates : Fin N → ℕ × ℕ) :
    ∀ (k : ℕ) (hk : k ≤ N) (b : ℕ), 42 + k ≤ b → (xagEnv c N gates k hk).testBit b = false
  | 0, _, b, hb => by
      dsimp only [xagEnv]
      rw [Nat.testBit_or, Nat.testBit_lt_two_pow
          (Nat.lt_of_lt_of_le (by decide : 1 < 2 ^ 42) (Nat.pow_le_pow_right (by omega) hb)),
        Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le (show c <<< 1 < 2 ^ 42 by
          rw [Nat.shiftLeft_eq]
          omega) (Nat.pow_le_pow_right (by omega) hb)), Bool.false_or]
  | k + 1, hk, b, hb => by
      have ih := xagEnv_above_false c hc gates k (Nat.le_of_succ_le hk) b (by omega)
      dsimp only [xagEnv]
      split_ifs <;>
        simp [Nat.testBit_or, ih, Nat.shiftLeft_eq, one_mul, show 42 + k ≠
            b by omega]

theorem xagEnv_gate_bit {N : ℕ} (c : ℕ) (hc : c < 2 ^ 41) (gates : Fin N → ℕ × ℕ)
    (hWf : ∀ j : Fin N, (gates j).1 < 2 ^ (42 + j.val) ∧ (gates j).2 < 2 ^ (42 + j.val)) :
    ∀ (k : ℕ) (hk : k ≤ N) (g : ℕ) (hg : g < k),
      (xagEnv c N gates k hk).testBit (42 + g) =
        (oddBits (xagEnv c N gates k hk &&& (gates ⟨g, Nat.lt_of_lt_of_le hg hk⟩).1) (42 + g) &&
         oddBits (xagEnv c N gates k hk &&& (gates ⟨g, Nat.lt_of_lt_of_le hg hk⟩).2) (42 + g))
  | 0, _, _, hg => absurd hg (Nat.not_lt_zero _)
  | k + 1, hk, g, hg => by
      let p := xagEnv c N gates k (Nat.le_of_succ_le hk)
      have hSL (i) (hi : i < 42 + k) : (xagEnv c N gates (k + 1) hk).testBit i = p.testBit i := by
        dsimp only [xagEnv, p]
        split_ifs <;> simp [Nat.testBit_or, Nat.shiftLeft_eq, one_mul, show 42 + k ≠ i by omega]
      have hME (m) : oddBits (xagEnv c N gates (k + 1) hk &&& m) (42 + g) = oddBits (p &&& m)
          (42 + g) :=
