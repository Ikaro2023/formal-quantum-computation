    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (idx : Fin 5) : (cAuxOuterLoad rSrc rAuxScr hSrcScr idx).count .T = 0 ∧
