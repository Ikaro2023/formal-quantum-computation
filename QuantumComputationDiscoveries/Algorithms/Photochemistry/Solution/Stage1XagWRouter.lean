      (fun δ hz ↦ hZL (hCln₀ δ hz))
      (fun δ hz b ↦ (env163_maskParity193 rSrc (coinFn δ) (sL st₀ δ)
        (fun u ↦ (hSL st₀ δ u).trans (hSrc₀ δ hz u)) _ (dom_auxMLs idx b)).trans (hLV st₀ δ b).symm)
      (fun δ hz ↦ by
        obtain ⟨z0h, z01, z02, z03⟩ := hZL (hCln₀ δ hz)
        obtain ⟨z1h, z11, z12, z13⟩ := hZL (hCln₁ δ hz)
        exact ⟨by simp only [sL, uWire, Function.update_self],
          fun b ↦ by rw [hLV st₁ δ b, hLV st₀ δ b], fun b ↦ (z1h b).trans (z0h b).symm,
          z11.trans z01.symm, z12.trans z02.symm, z13.trans z03.symm,
