      dsimp only [γ, sL]
      rw [stSplitRFwd_other _ (fun _ ↦ hOutScr g _) (fun _ ↦ hOutScr g _),
          Function.update_of_ne (hOutScr g iu), Function.update_of_ne (hOutScr g i1),
              Function.update_of_ne (hOutScr g i0)]
    change ket (Function.update (Function.update (Function.update γ (rAuxOut g0) _) (rAuxOut g1) _)
        (rAuxScr iu) _) = _
    rw [show γ (rAuxOut g0) + γ (rAuxScr h0) +
        (if bOf152 c ((auxMYsAt idx).getD 0 0) then 1 else 0) =
