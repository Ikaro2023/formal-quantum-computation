            rw [← hEK st₁ δ (hSrc₁ δ hz) (hCln₁ δ hz),
                ket_cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx c γ hSrcγ,
