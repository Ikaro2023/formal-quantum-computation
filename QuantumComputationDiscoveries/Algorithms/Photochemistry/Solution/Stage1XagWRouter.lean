theorem pairsParityBool_congr_off_dom {f₁ f₂ : ℕ → Bool}
    (hf : ∀ u, u ≠ 68 → u ≠ 70 → f₁ u = f₂ u) :
    ∀ (ps : List (ℕ × ℕ)), checkNoDomPairs ps = true →
      pairsParityBool f₁ ps = pairsParityBool f₂ ps
  | [], _ => rfl
  | p :: ps, h => by
      dsimp only [checkNoDomPairs] at h;
      obtain ⟨h12, hRest⟩ := Bool.and_eq_true_iff.mp h; obtain ⟨h1, h2⟩ :=
          Bool.and_eq_true_iff.mp h12; obtain ⟨h1a, h1b⟩ :=
          Bool.and_eq_true_iff.mp h1; obtain ⟨h2a, h2b⟩ :=
          Bool.and_eq_true_iff.mp h2; dsimp only [pairsParityBool]; rw [hf p.1 (bne_iff_ne.mp h1a)
          (bne_iff_ne.mp h1b), hf p.2 (bne_iff_ne.mp h2a) (bne_iff_ne.mp h2b),
          pairsParityBool_congr_off_dom hf ps hRest]
