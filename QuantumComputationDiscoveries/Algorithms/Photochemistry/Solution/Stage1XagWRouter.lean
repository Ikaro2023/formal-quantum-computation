    (rAuxScr : QRegister 24 n) (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i) (hOutScr : ∀ (b : Fin 10)
    (i : Fin 24), rAuxOut b ≠ rAuxScr i)
    (idx : Fin 5) : (cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx).count .T = 0 ∧
    (cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx).count .TOFF = 0 := by
