                hγ'Scr h1 (by simp only [h1, iu]; omega),
                add_assoc (γ' (rAuxOut g0)), add_assoc (γ' (rAuxOut g1))]
            exact congrArg ket (upd3_add_cancel γ (rAuxOut g0) (rAuxOut g1)
                (rAuxScr iu) _ _ _))))).seq
      (step_circ_mkKetOpW (Var := Var) rWork cOL (sL st₁) st₁ (fun _ ↦ 0) fun δ hz ↦ by
        obtain ⟨cu, _, _, _, cl0, cl1, _, _, _, _⟩ := hCln₁ δ hz
