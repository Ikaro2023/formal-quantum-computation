def cAuxOuterLoad {n : ℕ} (rSrc : QRegister 193 n) (rAuxScr : QRegister 24 n)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i) (idx : Fin 5) : Circuit n :=
