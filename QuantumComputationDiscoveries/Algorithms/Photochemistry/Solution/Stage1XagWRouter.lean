theorem eq_false_of_bnot_eq_true {b : Bool} (h : (!b) = true) : b = false := by
  cases b <;> cases h; rfl

/-! ### Section 1: `compileXagRange`, `env139`, & Router Semantics Glue -/

def compileXagRange (N k₀ : ℕ) (gates : Fin N → ℕ × ℕ) :
    (d : ℕ) → k₀ + d ≤ N → ComputeProg (41 + (N + 2))
  | 0, _ => .id
  | d + 1, hd =>
      let hd0 : k₀ + d ≤ N := by omega
      let hk : (k₀ + d) + 1 ≤ N := by omega
      .seq (compileXagRange N k₀ gates d hd0)
        (xagStepProg N (k₀ + d) hk (gates ⟨k₀ + d, hk⟩).1 (gates ⟨k₀ + d, hk⟩).2)

theorem compileXagRange_spec (N k₀ : ℕ) (gates : Fin N → ℕ × ℕ) :
    ∀ (d : ℕ) (hd : k₀ + d ≤ N),
      (compileXagRange N k₀ gates d hd).numAnd = d ∧
      ComputeProg.finalClean (sXag N k₀) (compileXagRange N k₀ gates d hd) = sXag N (k₀ + d) ∧
      ComputeProg.ValidProg ∅ (sXag N k₀) (compileXagRange N k₀ gates d hd)
  | 0, _ => by
      have hk0 : k₀ + 0 = k₀ := Nat.add_zero k₀; rw [hk0]; exact ⟨rfl, rfl, trivial⟩
  | d + 1, hd => by
      let hd0 : k₀ + d ≤ N := by omega
      let hk : (k₀ + d) + 1 ≤ N := by omega
      obtain ⟨ihN, ihF, ihV⟩ := compileXagRange_spec N k₀ gates d hd0; obtain ⟨stN, stF, stV⟩ :=
          xagStepProg_spec N (k₀ + d) hk (gates ⟨k₀ + d, hk⟩).1 (gates ⟨k₀ + d,
          hk⟩).2; dsimp only [compileXagRange, ComputeProg.numAnd, ComputeProg.finalClean,
          ComputeProg.ValidProg]; rw [ihN, stN, ihF, stF]
      have hAdd : (k₀ + d) + 1 = k₀ + (d + 1) := by omega
      rw [hAdd]; exact ⟨rfl, rfl, ihV, stV⟩
theorem compileXag_congr_idx (N : ℕ) (gates : Fin N → ℕ × ℕ) {k₁ k₂ : ℕ} (heq : k₁ = k₂)
    (hk₁ : k₁ ≤ N) (hk₂ : k₂ ≤ N) : compileXag N gates k₁ hk₁ = compileXag N gates k₂ hk₂ := by
  subst heq; rfl
theorem xagStepProg_singleton_spec (N k : ℕ) (hk : k + 1 ≤ N) (a b : ℕ) :
    let wG := wXagGate N ⟨k, hk⟩
    (xagStepProg N k hk a b).numAnd = 1 ∧
    ComputeProg.ValidProg ∅ ({wG} : Finset (Wire (41 + (N + 2)))) (xagStepProg N k hk a b) := by
  intro wG; let hk0 := Nat.le_of_succ_le hk;
  have nA :=
      numAnd_qXorMask1_zero (rXagPre N k hk0) (wXagA N)
      (disj_pre_A N k hk0) a (41 +
      k) le_rfl; have nB :=
                   numAnd_qXorMask1_zero (rXagPre N k hk0) (wXagB N)
                   (disj_pre_B N k hk0) b (41 + k) le_rfl
  have hAnG : wXagA N ∉ ({wG} : Finset (Wire (41 + (N + 2)))) :=
    Finset.notMem_singleton.mpr (ne_xag_AG N ⟨k, hk⟩)
  have hBnG : wXagB N ∉ ({wG} : Finset (Wire (41 + (N + 2)))) :=
    Finset.notMem_singleton.mpr (ne_xag_BG N ⟨k, hk⟩)
  obtain ⟨fcA0, vpA0⟩ := valid_finalClean_qXorMask1 (rXagPre N k hk0) (wXagA N)
    (disj_pre_A N k hk0) a {wG} hAnG (41 + k) le_rfl
  obtain ⟨fcB0, vpB0⟩ := valid_finalClean_qXorMask1 (rXagPre N k hk0) (wXagB N)
    (disj_pre_B N k hk0) b {wG} hBnG (41 + k) le_rfl
  obtain ⟨fcB1, vpB1⟩ :=
      valid_finalClean_qXorMask1 (rXagPre N k hk0) (wXagB N)
      (disj_pre_B N k hk0) b ∅ (Finset.notMem_empty _) (41 + k) le_rfl; obtain ⟨fcA1, vpA1⟩ :=
      valid_finalClean_qXorMask1 (rXagPre N k hk0) (wXagA N)
      (disj_pre_A N k hk0) a ∅ (Finset.notMem_empty _)
      (41 + k) le_rfl; have hErase : ({wG} : Finset (Wire (41 + (N + 2)))).erase wG = ∅ :=
                         Finset.erase_singleton wG; dsimp only [xagStepProg, ComputeProg.numAnd,
                         ComputeProg.finalClean, ComputeProg.ValidProg]; rw [nA, nB, fcA0, fcB0,
                         hErase, fcB1]; exact ⟨rfl,
                         ⟨⟨⟨vpA0, vpB0⟩, ⟨Finset.notMem_empty _, Finset.notMem_empty _,
                         Finset.notMem_empty _, Finset.mem_singleton_self wG⟩⟩, vpB1⟩, vpA1⟩
theorem maskParity_congr_support {M : ℕ} (mask : ℕ) (α₁ α₂ : BitAssignment M) :
    ∀ (k : ℕ) (hk : k ≤ M),
      (∀ u : Fin M, u.val < k → mask.testBit (1 + u.val) = true → α₁ u = α₂ u) →
      maskParity mask α₁ k hk = maskParity mask α₂ k hk
  | 0, _, _ => rfl
  | k + 1, hk, hSup => by
      dsimp only [maskParity]
      rw [maskParity_congr_support mask α₁ α₂ k (Nat.le_of_succ_le hk)
        (fun u hu hm ↦ hSup u (by omega) hm)]
      by_cases hb : mask.testBit (1 + k) = true
      · rw [ite_eq_left hb, ite_eq_left hb, hSup ⟨k, hk⟩ (by dsimp; omega) hb]
      · rw [ite_eq_right hb, ite_eq_right hb]

def customXagStep139 (g : ℕ) (hg : g + 1 ≤ 139) (a b : ℕ) : ComputeProg 182 :=
  let pA := qXorMask1 (rXagPre 139 139 le_rfl) (wXagA 139) (disj_pre_A 139 139 le_rfl) a 180 le_rfl
  let pB := qXorMask1 (rXagPre 139 139 le_rfl) (wXagB 139) (disj_pre_B 139 139 le_rfl) b 180 le_rfl
  let gAnd : ComputeProg 182 :=
      .andGate (wXagA 139) (wXagB 139) (wXagGate 139 ⟨g, hg⟩) (ne_xag_AB 139)
      (ne_xag_AG 139 ⟨g, hg⟩) (ne_xag_BG 139 ⟨g, hg⟩)
  .seq (.seq (.seq (.seq pA pB) gAnd) pB) pA

theorem customXagStep139_singleton_spec (g : ℕ) (hg : g + 1 ≤ 139) (a b : ℕ) :
    let wG := wXagGate 139 ⟨g, hg⟩
    (customXagStep139 g hg a b).numAnd = 1 ∧
    ComputeProg.ValidProg ∅ ({wG} : Finset (Wire 182)) (customXagStep139 g hg a b) := by
  intro wG;
  have nA :=
      numAnd_qXorMask1_zero (rXagPre 139 139 le_rfl) (wXagA 139)
      (disj_pre_A 139 139 le_rfl) a 180 le_rfl; have nB :=
                                                  numAnd_qXorMask1_zero (rXagPre 139 139 le_rfl)
                                                  (wXagB 139)
                                                  (disj_pre_B 139 139 le_rfl) b 180 le_rfl
  have hAnG : wXagA 139 ∉ ({wG} : Finset (Wire 182)) :=
    Finset.notMem_singleton.mpr (ne_xag_AG 139 ⟨g, hg⟩)
  have hBnG : wXagB 139 ∉ ({wG} : Finset (Wire 182)) :=
    Finset.notMem_singleton.mpr (ne_xag_BG 139 ⟨g, hg⟩)
  obtain ⟨fcA0, vpA0⟩ := valid_finalClean_qXorMask1 (rXagPre 139 139 le_rfl) (wXagA 139)
    (disj_pre_A 139 139 le_rfl) a {wG} hAnG 180 le_rfl
  obtain ⟨fcB0, vpB0⟩ := valid_finalClean_qXorMask1 (rXagPre 139 139 le_rfl) (wXagB 139)
    (disj_pre_B 139 139 le_rfl) b {wG} hBnG 180 le_rfl
  obtain ⟨fcB1, vpB1⟩ :=
      valid_finalClean_qXorMask1 (rXagPre 139 139 le_rfl) (wXagB 139)
      (disj_pre_B 139 139 le_rfl) b ∅ (Finset.notMem_empty _) 180 le_rfl; obtain ⟨fcA1, vpA1⟩ :=
      valid_finalClean_qXorMask1 (rXagPre 139 139 le_rfl) (wXagA 139)
      (disj_pre_A 139 139 le_rfl) a ∅ (Finset.notMem_empty _) 180 le_rfl;
      have hErase : ({wG} : Finset (Wire 182)).erase wG = ∅ :=
      Finset.erase_singleton wG; dsimp only [customXagStep139, ComputeProg.numAnd,
      ComputeProg.finalClean, ComputeProg.ValidProg]; rw [nA, nB, fcA0, fcB0, hErase,
      fcB1]; exact ⟨rfl, ⟨⟨⟨vpA0, vpB0⟩, ⟨Finset.notMem_empty _, Finset.notMem_empty _,
      Finset.notMem_empty _, Finset.mem_singleton_self wG⟩⟩, vpB1⟩, vpA1⟩
theorem fwdBits_customXagStep139 (g : ℕ) (hg : g + 1 ≤ 139) (a b : ℕ)
    (haNoSelf : a.testBit (1 + (41 + g)) = false)
    (hbNoSelf : b.testBit (1 + (41 + g)) = false)
    (β : BitAssignment 182)
    (hA : β (wXagA 139) = 0) (hB : β (wXagB 139) = 0) (hG : β (wXagGate 139 ⟨g, hg⟩) = 0) :
    let vA := maskParity a (fun i ↦ β (rXagPre 139 139 le_rfl i)) 180 le_rfl
    let vB := maskParity b (fun i ↦ β (rXagPre 139 139 le_rfl i)) 180 le_rfl
    (customXagStep139 g hg a b).fwdBits β = Function.update β (wXagGate 139 ⟨g, hg⟩) (vA * vB) := by
  intro vA vB
  let pA := qXorMask1 (rXagPre 139 139 le_rfl) (wXagA 139) (disj_pre_A 139 139 le_rfl) a 180 le_rfl
  let pB := qXorMask1 (rXagPre 139 139 le_rfl) (wXagB 139) (disj_pre_B 139 139 le_rfl) b 180 le_rfl
  let gAnd : ComputeProg 182 := .andGate (wXagA 139) (wXagB 139) (wXagGate 139 ⟨g, hg⟩)
    (ne_xag_AB 139) (ne_xag_AG 139 ⟨g, hg⟩) (ne_xag_BG 139 ⟨g, hg⟩)
  let fPre := fun i : Fin 180 ↦ β (rXagPre 139 139 le_rfl i)
  let β1 := Function.update β (wXagA 139) (β (wXagA 139) + vA)
  let β2 := Function.update β1 (wXagB 139) (β1 (wXagB 139) + vB)
  let β3 :=
      Function.update β2 (wXagGate 139 ⟨g, hg⟩) (β2 (wXagGate 139 ⟨g, hg⟩) + β2 (wXagA 139) *
      β2 (wXagB 139))
  let β4 := Function.update β3 (wXagB 139) (β3 (wXagB 139) + vB)
  have hneG {m : ℕ} (hNo : m.testBit (1 + (41 + g)) = false) (i : Fin 180)
      (hbt : m.testBit (1 + i.val) = true) : rXagPre 139 139 le_rfl i ≠ wXagGate 139 ⟨g, hg⟩ :=
    fun e ↦ Bool.noConfusion (((congrArg m.testBit (show 1 + (41 + g) = 1 + i.val by
      have hv := congrArg Fin.val e
      simp only [QRegister.block_apply_val, wXagGate] at hv
      omega)).trans hbt).symm.trans hNo)
  change pA.fwdBits (pB.fwdBits (gAnd.fwdBits (pB.fwdBits (pA.fwdBits β)))) = _
  rw [show pA.fwdBits β = β1 from fwdBits_qXorMask1 _ _ _ _ _ _ β,
      show pB.fwdBits β1 = β2 by
        rw [fwdBits_qXorMask1, maskParity_congr_support b _ fPre 180 le_rfl
          fun i _ _ ↦ Function.update_of_ne (disj_pre_A 139 139 le_rfl i) _ _],
      show gAnd.fwdBits β2 = β3 from rfl,
      show pB.fwdBits β3 = β4 by
        rw [fwdBits_qXorMask1, maskParity_congr_support b _ fPre 180 le_rfl fun i _ hbt ↦ by
          simp [β3, β2, β1, fPre, Function.update_of_ne (hneG hbNoSelf i hbt),
            Function.update_of_ne (disj_pre_B 139 139 le_rfl i),
                Function.update_of_ne (disj_pre_A 139 139 le_rfl i)]],
      fwdBits_qXorMask1, maskParity_congr_support a _ fPre 180 le_rfl fun i _ hbt ↦ by
        simp [β4, β3, β2, β1, fPre, Function.update_of_ne (hneG haNoSelf i hbt),
          Function.update_of_ne (disj_pre_B 139 139 le_rfl i),
              Function.update_of_ne (disj_pre_A 139 139 le_rfl i)]]
  funext w
  rcases eq_or_ne w (wXagA 139) with rfl | hwA
  · simp [β4, β3, β2, β1, vA, fPre, Function.update_of_ne (ne_xag_AB 139),
      Function.update_of_ne (ne_xag_AG 139 ⟨g, hg⟩), CharTwo.add_self_eq_zero, hA]
  rcases eq_or_ne w (wXagB 139) with rfl | hwB
  · simp [β4, β3, β2, β1, hwA, Function.update_of_ne (ne_xag_BG 139 ⟨g, hg⟩),
        CharTwo.add_self_eq_zero, hB]
  rcases eq_or_ne w (wXagGate 139 ⟨g, hg⟩) with rfl | hwG
  · simp [β4, β3, β2, β1, hwA, hwB, Function.update_of_ne (ne_xag_AB 139),
        Function.update_of_ne (ne_xag_AB 139).symm, hA, hB, hG]
  · simp [β4, β3, β2, β1, hwA, hwB, hwG]

def domKeepMask : ℕ := ((1 <<< 208) - 1) ^^^ (1 <<< 68) ^^^ (1 <<< 70)

theorem domKeepMask_testBit (b : ℕ) (hb : b < 208) : domKeepMask.testBit b = decide (b ≠ 68 ∧ b ≠
    70) := by
  have hFin : ∀ k : Fin 208, domKeepMask.testBit k.val = decide (k.val ≠ 68 ∧ k.val ≠ 70) := by
    decide +kernel
  exact hFin ⟨b, hb⟩

theorem domKeepMask_not_68_70 {mask u : ℕ} (hDom : (domKeepMask &&& mask == mask) = true)
    (hu : 1 + u < 208) (hbt : mask.testBit (1 + u) = true) : u ≠ 67 ∧ u ≠ 69 := by
  have hEq : domKeepMask &&& mask = mask := beq_iff_eq.mp hDom
  have hb := congrArg (fun x ↦ x.testBit (1 + u)) hEq
  rw [Nat.testBit_and, hbt, Bool.and_true, domKeepMask_testBit (1 + u) hu] at hb;
  have hd := of_decide_eq_true hb; omega
def domZeroBits (W : ℕ) (β : BitAssignment W) : BitAssignment W := fun i ↦
    if i.val = 67 ∨ i.val = 69 then 0 else β i
theorem domZeroBits_update_of_ne {W : ℕ} (β : BitAssignment W) (w : Wire W) (v : ZMod 2)
    (hw67 : w.val ≠ 67) (hw69 : w.val ≠ 69) :
    Function.update (domZeroBits W β) w v = domZeroBits W (Function.update β w v) := funext fun i ↦
        by
  rcases eq_or_ne i w with rfl | hiw
  · dsimp only [domZeroBits]
    rw [Function.update_self, ite_eq_right (by omega), Function.update_self]
  · by_cases hdom : i.val = 67 ∨ i.val = 69 <;> simp only [domZeroBits, hdom, ↓reduceIte,
        Function.update_of_ne hiw]

theorem fwdBits_qXorMask1_domZero {K W : ℕ} (r : QRegister K W) (t : Wire W)
    (hdisj : ∀ i : Fin K, r i ≠ t)
    (mask m : ℕ) (hm : m ≤ K) (hrVal : ∀ i : Fin K, (r i).val = i.val) (ht67 : t.val ≠ 67)
        (ht69 : t.val ≠ 69)
    (hm208 : 1 + m ≤ 208) (hDom : (domKeepMask &&& mask == mask) = true) (β : BitAssignment W) :
    (qXorMask1 r t hdisj mask m hm).fwdBits (domZeroBits W β) =
        domZeroBits W ((qXorMask1 r t hdisj mask m hm).fwdBits β) := by
  rw [fwdBits_qXorMask1, fwdBits_qXorMask1, maskParity_congr_support mask _ (fun i : Fin K ↦
      β (r i)) m hm fun u _ hbt ↦ by
        have _ := domKeepMask_not_68_70 hDom (by omega) hbt
        dsimp only [domZeroBits]
        exact ite_eq_right (by rw [hrVal u]; omega),
      show domZeroBits W β t = β t from ite_eq_right (by omega : ¬(t.val = 67 ∨ t.val = 69)),
      domZeroBits_update_of_ne β t _ ht67 ht69]

theorem fwdBits_xagStepProg_domZero (N k : ℕ) (hk : k + 1 ≤ N) (hk29 : 29 ≤ k)
    (hN208 : 42 + N ≤ 208) (a b : ℕ)
    (hDomA : (domKeepMask &&& a == a) = true) (hDomB : (domKeepMask &&& b == b) = true)
    (β : BitAssignment (41 + (N + 2))) (hA : β (wXagA N) = 0) (hB : β (wXagB N) = 0)
        (hG : β (wXagGate N ⟨k, hk⟩) = 0) :
    (xagStepProg N k hk a b).fwdBits (domZeroBits (41 + (N + 2)) β) = domZeroBits (41 + (N + 2))
        ((xagStepProg N k hk a b).fwdBits β) := by
  have hZ {w : Wire (41 + (N + 2))} (hw : w.val ≠ 67 ∧ w.val ≠ 69) (h0 : β w = 0) :
      domZeroBits (41 + (N + 2)) β w = 0 := (ite_eq_right (by omega)).trans h0
  have hvDom {m : ℕ} (hDom : (domKeepMask &&& m == m) = true) := maskParity_congr_support m
      (fun i ↦ domZeroBits (41 + (N + 2)) β (rXagPre N k (Nat.le_of_succ_le hk) i))
      (fun i ↦ β (rXagPre N k (Nat.le_of_succ_le hk) i)) (41 + k) le_rfl fun u _ hbt ↦ by
        have _ := domKeepMask_not_68_70 hDom (by omega) hbt
        exact ite_eq_right (by simp only [QRegister.block_apply_val, zero_add]; omega)
  rw [fwdBits_xagStepProg N k hk a b _ (hZ (by simp only [wXagA, Fin.val_mk]; omega) hA)
        (hZ (by simp only [wXagB, Fin.val_mk]; omega) hB)
        (hZ (by simp only [wXagGate, Fin.val_mk]; omega) hG),
      fwdBits_xagStepProg N k hk a b β hA hB hG, hvDom hDomA, hvDom hDomB]
  exact domZeroBits_update_of_ne β _ _
    (by simp only [wXagGate, Fin.val_mk]; omega) (by simp only [wXagGate, Fin.val_mk]; omega)

theorem fwdBits_compileXagRange_domZero (N k₀ : ℕ) (gates : Fin N → ℕ × ℕ)
    (hk₀ : k₀ ≤ N) (hk29 : 29 ≤ k₀) (hN208 : 42 + N ≤ 208) (c : Fin (2 ^ 41)) :
    ∀ (d : ℕ) (hd : k₀ + d ≤ N),
      (∀ (j : ℕ) (hj : j < d),
        let gIdx : Fin N := ⟨k₀ + j, by omega⟩
        (domKeepMask &&& (gates gIdx).1 == (gates gIdx).1) = true ∧
        (domKeepMask &&& (gates gIdx).2 == (gates gIdx).2) = true) →
      (compileXagRange N k₀ gates d hd).fwdBits
        (domZeroBits (41 + (N + 2))
            ((compileXag N gates k₀ hk₀).fwdBits (coinInitBits (N + 2) c))) =
      domZeroBits (41 + (N + 2)) ((compileXag N gates (k₀ + d) hd).fwdBits (coinInitBits (N + 2) c))
  | 0, hd, _ => by
      dsimp only [compileXagRange, ComputeProg.fwdBits]
      rw [compileXag_congr_idx N gates (Nat.add_zero k₀).symm hk₀ hd]
  | d + 1, hd, hDomAll => by
      let hk : (k₀ + d) + 1 ≤ N := by omega
      dsimp only [compileXagRange, ComputeProg.fwdBits]
      rw [fwdBits_compileXagRange_domZero N k₀ gates hk₀ hk29 hN208 c d (Nat.le_of_succ_le hk)
          (fun j hj ↦ hDomAll j (by omega))]
      have hZ (w : Wire (41 + (N + 2))) (hw : ¬ w.val < 41 + (k₀ + d)) :
          (compileXag N gates (k₀ + d) (Nat.le_of_succ_le hk)).fwdBits (coinInitBits (N + 2) c) w =
              0 :=
        ((xagEnv_invariant c N gates (k₀ + d) (Nat.le_of_succ_le hk)).2.2 w).trans (ite_eq_right hw)
      obtain ⟨hdA, hdB⟩ := hDomAll d (Nat.lt_succ_self d)
      rw [fwdBits_xagStepProg_domZero N (k₀ + d) hk (by omega) hN208 _ _ hdA hdB _
            (hZ _ (by dsimp [wXagA]; omega)) (hZ _ (by dsimp [wXagB]; omega))
            (hZ _ (by dsimp [wXagGate]; omega)),
          compileXag_congr_idx N gates (by omega : k₀ + (d + 1) = (k₀ + d) + 1) hd hk]
      rfl

def env139 (c : Fin (2 ^ 41)) : ℕ := xagEnv c.val 139 fgatesPrefix139 139 le_rfl
theorem env139_eq_fwd (c : Fin (2 ^ 41)) :
    env139 c = xagEnv c.val 151 fgates 139 (by decide) :=
  xagEnv_indep_N c.val fgatesPrefix139 fgates 139 le_rfl (by decide) (fun _ _ ↦ rfl)
theorem env139_eq_rev (c : Fin (2 ^ 41)) :
    env139 c = xagEnv c.val 143 rgates 139 (by decide) :=
  xagEnv_indep_N c.val fgatesPrefix139 rgates 139 le_rfl (by decide)
      (fun _ hg ↦ (rgates_prefix139_eq hg).symm)
theorem env139_bit0 (c : Fin (2 ^ 41)) : (env139 c).testBit 0 = true :=
    xagEnv_bit0 c.val fgatesPrefix139 139 le_rfl
theorem env139_coinBit (c : Fin (2 ^ 41)) (u : Fin 41) : (env139 c).testBit (1 + u.val) =
    c.val.testBit u.val :=
  (xagEnv_prefix_testBit c.val 139 fgatesPrefix139 0 (Nat.zero_le _) 139 le_rfl (Nat.zero_le _)
      (1 + u.val)
    (Nat.lt_of_lt_of_le (Nat.add_lt_add_left u.isLt 1)
        (by decide))).trans ((xagEnv_zero_testBit c.val c.isLt).2.1 u.val u.isLt)

structure RouterEpochCfg where
  gates : List ℕ
  mU : ℕ
  mLs : List ℕ
  mYs : List ℕ
  maskHs : List ℕ

def RouterEpochSem (R : ℕ) (rc : RouterEpochCfg) : Prop :=
    ∀ c : Fin (2 ^ 41), (∀ (b₁ b₂ : ℕ), b₁ < R → b₂ < R → b₁ ≠ b₂ →
    oddBits (env139 c &&& rc.mLs.getD b₁ 0) 181 = true →
    oddBits (env139 c &&& rc.mLs.getD b₂ 0) 181 = false) ∧ (∀ (b : ℕ), b < R →
    xor (xorMaskBool (fun j ↦ oddBits (env139 c &&& rc.mLs.getD j 0) 181) (rc.maskHs.getD b 0) R &&
    oddBits (env139 c &&& rc.mU) 181) (oddBits (env139 c &&& rc.mYs.getD b 0) 181) =
    (env139 c).testBit (42 + rc.gates.getD b 0))
theorem le_preTail215 : 41 + 235 ≤ 276 := by decide
abbrev rPreTail215 {n : ℕ} (rPre : QRegister 276 n) : QRegister 235 n :=
    rPre.compose (QRegister.block 41 235 le_preTail215)
theorem le_pre182 : 0 + 182 ≤ 276 := by decide
abbrev rPre182 {n : ℕ} (rPre : QRegister 276 n) : QRegister 182 n :=
    rPre.compose (QRegister.block 0 182 le_pre182)
theorem maskAllow_not_gateBit {m mask g : ℕ}
    (hAllow : (mask &&& (((1 <<< 42) - 1) ||| (m <<< 42))) == mask)
    (hmFalse : m.testBit g = false) :
    mask.testBit (1 + (41 + g)) = false := by
  have hLo : ((1 <<< 42) - 1).testBit (42 + g) = false := by
    rw [show (1 : ℕ) <<< 42 = 2 ^ 42 by decide, Nat.testBit_two_pow_sub_one,
        decide_eq_false (by omega)]
  have hAllowFalse : (((1 <<< 42) - 1) ||| (m <<< 42)).testBit (42 + g) = false := by
    rw [Nat.testBit_or, hLo, Bool.false_or, Nat.testBit_shiftLeft,
        decide_eq_true (by omega : 42 + g ≥ 42), Bool.true_and, show 42 + g - 42 = g by omega,
        hmFalse]
  rw [show 1 + (41 + g) = 42 + g by omega, ← beq_iff_eq.mp hAllow, Nat.testBit_and, hAllowFalse,
      Bool.and_false]

theorem zmod2_add_self (a : ZMod 2) : a + a = 0 := by
  rcases DynCircExt.bit_cases a with h | h <;> rw [h] <;> decide

theorem zmod2_ite_mul_b (b1 b2 : Bool) : (if b1 then (1 : ZMod 2) else 0) * (if b2 then 1 else 0) =
    if (b1 && b2) then 1 else 0 := by
  cases b1 <;> cases b2 <;> decide

theorem zmod2_ite_add_b (b1 b2 : Bool) : (if b1 then (1 : ZMod 2) else 0) + (if b2 then 1 else 0) =
    if xor b1 b2 then 1 else 0 := by
  cases b1 <;> cases b2 <;> decide

def checkListPairwiseNe : List ℕ → Bool
  | [] => true
  | x :: xs => (xs.all (fun y ↦ x != y)) && checkListPairwiseNe xs

theorem pairwise_ne_of_check :
    ∀ (xs : List ℕ), checkListPairwiseNe xs = true →
      ∀ (i j : ℕ) (hi : i < xs.length) (hj : j < xs.length), i ≠ j → xs[i] ≠ xs[j]
  | [], _, _, _, hi, _, _ => absurd hi (Nat.not_lt_zero _)
  | x :: xs, hChk, i, j, hi, hj, hne => by
      obtain ⟨hAll, hRest⟩ := Bool.and_eq_true_iff.mp hChk
      have hHead {k : ℕ} (hk : k + 1 < (x :: xs).length) : x ≠ xs[k]'(Nat.lt_of_succ_lt_succ hk) :=
        bne_iff_ne.mp (List.all_eq_true.mp hAll _ (List.getElem_mem _))
      cases i <;> cases j
      · exact absurd rfl hne
      · exact hHead hj
      · exact (hHead hi).symm
      · exact pairwise_ne_of_check xs hRest _ _ (Nat.lt_of_succ_lt_succ hi)
            (Nat.lt_of_succ_lt_succ hj) (hne ∘ congrArg Nat.succ)


