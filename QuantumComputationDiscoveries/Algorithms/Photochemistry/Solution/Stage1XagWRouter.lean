  (cXorMaskSrc rSrc (rAuxScr i0) (fun u ↦ hSrcScr u i0) (mLs.getD 0 0) 193 le_rfl ;;ᶜ
   cXorMaskSrc rSrc (rAuxScr i1) (fun u ↦ hSrcScr u i1) (mLs.getD 1 0) 193 le_rfl) ;;ᶜ
   cXorMaskSrc rSrc (rAuxScr iu) (fun u ↦ hSrcScr u iu) mU 193 le_rfl

def cAuxInnerEnter {n : ℕ} (rSrc : QRegister 193 n) (rAuxOut : QRegister 10 n)
    (rAuxScr : QRegister 24 n) (hSrcOut : ∀ (u : Fin 193) (b : Fin 10), rSrc u ≠ rAuxOut b)
    (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i) (hOutScr : ∀ (b : Fin 10)
    (i : Fin 24), rAuxOut b ≠ rAuxScr i) (idx : Fin 5) : Circuit n :=
  let mYs := auxMYsAt idx
  let mU := auxMUAt idx
  let h0 : Fin 24 := ⟨14 + 2 * idx.val, by have := idx.isLt; omega⟩
  let h1 : Fin 24 := ⟨14 + 2 * idx.val + 1, by have := idx.isLt; omega⟩
  let g0 : Fin 10 := ⟨2 * idx.val, by have := idx.isLt; omega⟩
  let g1 : Fin 10 := ⟨2 * idx.val + 1, by have := idx.isLt; omega⟩
  let iu : Fin 24 := ⟨0, by decide⟩
  ((((Circuit.CNOT (rAuxScr h0) (rAuxOut g0) (hOutScr g0 h0).symm ;;ᶜ
      cXorMaskSrc rSrc (rAuxOut g0) (fun u ↦ hSrcOut u g0) (mYs.getD 0 0) 193 le_rfl) ;;ᶜ
     Circuit.CNOT (rAuxScr h1) (rAuxOut g1) (hOutScr g1 h1).symm) ;;ᶜ
    cXorMaskSrc rSrc (rAuxOut g1) (fun u ↦ hSrcOut u g1) (mYs.getD 1 0) 193 le_rfl) ;;ᶜ
   cXorMaskSrc rSrc (rAuxScr iu) (fun u ↦ hSrcScr u iu) mU 193 le_rfl)

def wrapAuxRouter2 {Var : Type} {n : ℕ} (v : Var) (rSrc : QRegister 193 n)
    (rAuxOut : QRegister 10 n) (rAuxScr : QRegister 24 n) (hSrcOut : ∀ (u : Fin 193)
    (b : Fin 10), rSrc u ≠ rAuxOut b) (hSrcScr : ∀ (u : Fin 193) (i : Fin 24), rSrc u ≠ rAuxScr i)
    (hOutScr : ∀ (b : Fin 10) (i : Fin 24), rAuxOut b ≠ rAuxScr i) (idx : Fin 5)
    (mid : DynamicCircuit Var n) : DynamicCircuit Var n :=
  let uWire := rAuxScr ⟨0, by decide⟩
  let lW : Fin 2 → Wire n := fun b ↦
      rAuxScr ⟨4 + 2 * idx.val + b.val, by have := idx.isLt; have := b.isLt; omega⟩
  let hW : Fin 2 → Wire n := fun b ↦
      rAuxScr ⟨14 + 2 * idx.val + b.val, by have := idx.isLt; have := b.isLt; omega⟩
  let hInj := auxRouterInj rAuxScr idx
  let cOL := cAuxOuterLoad rSrc rAuxScr hSrcScr idx
  let cIE := cAuxInnerEnter rSrc rAuxOut rAuxScr hSrcOut hSrcScr hOutScr idx
  let inner := DynamicCircuit.seq (.circuit cIE) (DynamicCircuit.seq mid (.circuit cIE))
  DynamicCircuit.seq (.circuit cOL)
    (DynamicCircuit.seq
      (pSplitRBracket v uWire lW hW (rAuxScr ⟨1, by decide⟩) (rAuxScr ⟨2, by decide⟩)
        (rAuxScr ⟨3, by decide⟩) hInj inner)
      (.circuit cOL))

