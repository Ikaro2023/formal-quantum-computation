def checkSamePairs (n : ℕ) (f g : ℕ → ℕ × ℕ) : Bool := (List.range n).all fun k ↦ decide (f k = g k)
theorem checkSamePairs_imp {n : ℕ} {f g : ℕ → ℕ × ℕ} (h : checkSamePairs n f g = true) {k : ℕ}
    (hk : k < n) : f k = g k := by
  unfold checkSamePairs at h; rw [List.all_eq_true] at h;
  exact of_decide_eq_true (h k (List.mem_range.mpr hk))
