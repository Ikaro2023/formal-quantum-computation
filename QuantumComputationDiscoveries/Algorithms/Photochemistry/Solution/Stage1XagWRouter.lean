      have hhx (b : Fin 2) : x ≠ hW b := by
        rcases fin2 b with rfl | rfl <;> simp [hhW0, hhW1, hxh0, hxh1]
      dsimp only [γ, sL]
      rw [Function.update_of_ne hxu, stSplitRFwd_other _ hlx hhx, Function.update_of_ne hxu,
