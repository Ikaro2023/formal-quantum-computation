theorem sum_fin_decide_lt_ones {N m : ℕ} (hm : m ≤ N) :
    (∑ y : Fin N, cond (decide (y.val < m)) (1 : ℕ) 0) = m := by
  induction m with
  | zero => simp
  | succ k ih =>
    have hkN : k < N := Nat.lt_of_succ_le hm
    let yk : Fin N := ⟨k, hkN⟩
    have hsplit : ∀ y : Fin N,
        cond (decide (y.val < k + 1)) (1 : ℕ) 0 =
          cond (decide (y.val < k)) 1 0 + cond (y.val == k) 1 0 := fun y ↦ by
      by_cases h1 : y.val < k
      · have h2 : y.val < k + 1 := Nat.lt_succ_of_lt h1
        have h3 : (y.val == k) = false := beq_false_of_ne (Nat.ne_of_lt h1)
        simp [h1, h2, h3]
      · by_cases h3 : y.val = k
        · simp [h3]
        · have h2 : ¬(y.val < k + 1) := by omega
          have h3b : (y.val == k) = false := beq_false_of_ne h3
          simp [h1, h2, h3b]
    have hsingle : (∑ y : Fin N, cond (y.val == k) (1 : ℕ) 0) = 1 := by
      rw [Finset.sum_eq_single yk]
      · simp [yk]
      · intro y _ hne
        have hval : (y.val == k) = false := beq_false_of_ne (fun hv ↦ hne (Fin.ext hv))
        rw [hval]; rfl
      · intro hnot; exact absurd (Finset.mem_univ yk) hnot
    rw [Finset.sum_congr rfl (fun y _ ↦ hsplit y), Finset.sum_add_distrib,
      ih (Nat.le_of_lt hkN), hsingle]


theorem sum_branchGood48_eq (isHead s0 : Bool) :
    (∑ d : Data48Tuple, cond (branchGood48 isHead s0 d) (1 : ℕ) 0) =
      branchCardG48 isHead s0 := by
  have hcond_mul : ∀ a b c : Bool,
      cond (a && b && c) (1 : ℕ) 0 = cond a 1 0 * cond b 1 0 * cond c 1 0 := by
    intro a b c; cases a <;> cases b <;> cases c <;> rfl
  let fJ (b1 : Fin (2 ^ 3)) (fine : Fin (2 ^ 30)) : ℕ :=
    cond (if isHead then true else decide (fine.val < tailKeepSpanOfDp b1)) 1 0
  let fA (ancHi : Fin (2 ^ 7)) : ℕ :=
    cond (if isHead && !s0 then !(basisBits 7 ancHi 0 == 1 && basisBits 7 ancHi 1 == 1)
          else decide (ancHi.val < 109)) 1 0
  let fN (nuc : Fin (2 ^ 8)) : ℕ :=
    cond (if isHead && s0 then !(basisBits 8 nuc 0 == 1 && basisBits 8 nuc 1 == 1)
          else if !isHead && s0 then decide (nuc.val < 217)
          else decide (nuc.val < 218)) 1 0
  have hFactor : (∑ d : Data48Tuple, cond (branchGood48 isHead s0 d) (1 : ℕ) 0) =
      (∑ b1 : Fin (2 ^ 3), ∑ fine : Fin (2 ^ 30), fJ b1 fine) *
      (∑ ancHi : Fin (2 ^ 7), fA ancHi) *
      (∑ nuc : Fin (2 ^ 8), fN nuc) := by
    simp only [Data48Tuple, Fintype.sum_prod_type]
    have h1 : ∀ b1 : Fin (2 ^ 3), ∀ fine : Fin (2 ^ 30),
        (∑ ancHi : Fin (2 ^ 7), ∑ nuc : Fin (2 ^ 8),
          cond (branchGood48 isHead s0 (b1, fine, ancHi, nuc)) (1 : ℕ) 0) =
        fJ b1 fine * ((∑ ancHi : Fin (2 ^ 7), fA ancHi) * (∑ nuc : Fin (2 ^ 8), fN nuc)) := by
      intro b1 fine
      have hpt : ∀ ancHi : Fin (2 ^ 7), ∀ nuc : Fin (2 ^ 8),
          cond (branchGood48 isHead s0 (b1, fine, ancHi, nuc)) (1 : ℕ) 0 =
            fJ b1 fine * (fA ancHi * fN nuc) := fun ancHi nuc ↦ by
        dsimp only [branchGood48, fJ, fA, fN]
        rw [hcond_mul, mul_assoc]
      simp_rw [hpt, ← Finset.mul_sum]
      rw [← Finset.sum_mul]
    simp_rw [h1, ← Finset.sum_mul]
    ring
  rw [hFactor]
  have hcJ : (∑ b1 : Fin (2 ^ 3), ∑ fine : Fin (2 ^ 30), fJ b1 fine) =
      if isHead then 8 * 2 ^ 30 else 6388384375 := by
    have h230 : 2 ^ 30 = 1073741824 := rfl
    cases isHead
    · simp only [Bool.false_eq_true, ↓reduceIte, fJ]
      have hInner : ∀ b1 : Fin (2 ^ 3),
          (∑ fine : Fin (2 ^ 30), cond (decide (fine.val < tailKeepSpanOfDp b1)) (1 : ℕ) 0) =
            tailKeepSpanOfDp b1 := fun b1 ↦ by
        apply sum_fin_decide_lt_ones
        rw [h230]
        fin_cases b1 <;> decide
      rw [Finset.sum_congr rfl (fun b1 _ ↦ hInner b1), Fin.sum_univ_eight]
      rfl
    · simp only [↓reduceIte, fJ, Bool.cond_true, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, smul_eq_mul, mul_one]
      rfl
  have hcA : (∑ ancHi : Fin (2 ^ 7), fA ancHi) = if isHead && !s0 then 96 else 109 := by
    rw [← Fintype.sum_equiv fin128Split16.symm _ fA (fun _ ↦ rfl), Fintype.sum_prod_type]
    dsimp only [fA]
    cases isHead <;> cases s0 <;>
      simp only [Bool.false_eq_true, Bool.not_false, Bool.not_true, Bool.and_true, Bool.and_false,
        ↓reduceIte] <;> decide
  have hcN : (∑ nuc : Fin (2 ^ 8), fN nuc) =
      if isHead && s0 then 192 else if !isHead && s0 then 217 else 218 := by
    rw [← Fintype.sum_equiv fin256Split16.symm _ fN (fun _ ↦ rfl), Fintype.sum_prod_type]
    dsimp only [fN]
    cases isHead <;> cases s0 <;>
      simp only [Bool.false_eq_true, Bool.not_false, Bool.not_true, Bool.and_true, Bool.and_false,
        ↓reduceIte] <;> decide
  have h230' : 2 ^ 30 = 1073741824 := rfl
  rw [hcJ, hcA, hcN]
  cases isHead <;> cases s0 <;> simp only [Bool.false_eq_true, ↓reduceIte, h230'] <;> rfl


