theorem pos80_clean_scr75 (p : BitAssignment 80)
    (h : p ⟨75, by decide⟩ ≠ 0 ∨ p ⟨76, by decide⟩ ≠ 0 ∨
         p ⟨77, by decide⟩ ≠ 0 ∨ p ⟨78, by decide⟩ ≠ 0) :
    muActualFactor80 true false p = 0 := by
  unfold muActualFactor80
  simp only [Bool.not_false, Bool.false_eq_true, ↓reduceIte]
  set q : BitAssignment 80 := flipTailDpScratch80 (p80ClearB0Local p)
  have hc30 : p80ClearB0Local p 30 = p 30 := rfl
  by_cases hp30 : (p 30 == 1) = true
  · have hq_eq : q = p80ClearB0Local p := by
      change (if p80ClearB0Local p 30 == 1 then p80ClearB0Local p else _) = _
      rw [hc30, itePosLocal hp30]
    have hq30 : (q 30 == 1) = true := by rw [hq_eq, hc30]; exact hp30
    rw [itePosLocal hq30]
    by_cases hk : Pos24HeadCoordXor80.bitsVal
        (fun j : Fin 6 ↦ q (pos80SubIdx 63 6 (by decide) j)) < 56
    · rw [ditePosLocal hk]
      have hremF : ((q 75 == 0) && (q 76 == 0) && (q 77 == 0) && (q 78 == 0)) = false := by
        have h75 : q 75 = p ⟨75, by decide⟩ := by rw [hq_eq]; rfl
        have h76 : q 76 = p ⟨76, by decide⟩ := by rw [hq_eq]; rfl
        have h77 : q 77 = p ⟨77, by decide⟩ := by rw [hq_eq]; rfl
        have h78 : q 78 = p ⟨78, by decide⟩ := by rw [hq_eq]; rfl
        rw [h75, h76, h77, h78]
        rcases h with h1 | h2 | h3 | h4
        · exact Bool.eq_false_iff.mpr fun hc ↦ by
            simp only [Bool.and_eq_true, beq_iff_eq] at hc; exact h1 hc.1.1.1
        · exact Bool.eq_false_iff.mpr fun hc ↦ by
            simp only [Bool.and_eq_true, beq_iff_eq] at hc; exact h2 hc.1.1.2
        · exact Bool.eq_false_iff.mpr fun hc ↦ by
            simp only [Bool.and_eq_true, beq_iff_eq] at hc; exact h3 hc.1.2
        · exact Bool.eq_false_iff.mpr fun hc ↦ by
            simp only [Bool.and_eq_true, beq_iff_eq] at hc; exact h4 hc.2
      rw [hremF]
      simp only [Bool.false_and, Bool.false_eq_true, ↓reduceIte]
    · exact diteNegLocal hk
  · have hq_def : q = fun r ↦
        if r.val == 75 then p80ClearB0Local p 75 + p80ClearB0Local p 0
        else if r.val == 76 then p80ClearB0Local p 76 + p80ClearB0Local p 1
        else if r.val == 77 then p80ClearB0Local p 77 + p80ClearB0Local p 2
        else p80ClearB0Local p r := by
      change (if p80ClearB0Local p 30 == 1 then p80ClearB0Local p else _) = _
      rw [hc30, iteNegLocal hp30]
    have hq30 : ¬((q 30 == 1) = true) := by rw [hq_def]; exact hp30
    rw [iteNegLocal hq30]
    by_cases hcond :
        (((decide (∀ j : Fin 12, q (pos80SubIdx 63 12 (by decide) j) = 0) && (q 78 == 0)) &&
          (Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
            q (pos80SubIdx 22 8 (by decide) j)) == 0)) &&
         (Function.update q 62 0 == tailWitnessPayload80
            (Pos24HeadCoordXor80.bitsVal fun j : Fin 3 ↦ q (pos80SubIdx 3 3 (by decide) j))
