private theorem embedUnitary_mulVec_ket_sub {m N : ℕ}
    (r : QRegister m N) (V : Unitary (2 ^ m))
    (α : BitAssignment N) (γ : BitAssignment m)
    (hV : V.1.mulVec (ket (fun i : Fin m ↦ α (r i))) = ket γ) :
    (r.embedUnitary V).1.mulVec (ket α) = ket (ZeroAncillaUSPS3.writeReg α r γ) := by
  rw [QRegister.embedUnitary_val, embedMatrix_mulVec_ket_sub]
  let l₀ : Fin (2 ^ m) := (basisBitsEquiv m).symm γ
  have hEntry : ∀ l : Fin (2 ^ m),
      V.1 l (localIdxSub r α) = if l = l₀ then 1 else 0 := fun l ↦ by
    rw [← ket_localIdxSub_eq r α l V.1, hV, ket_eq_single_local γ]
    by_cases hl : l = l₀
    · subst hl; simp [l₀]
    · dsimp only [l₀] at hl ⊢; simp [hl]
  rw [Finset.sum_eq_single l₀]
  · rw [hEntry l₀, ite_eq_left rfl, one_smul]
    have hb : basisBits m l₀ = γ := (basisBitsEquiv m).apply_symm_apply γ
    rw [hb, writeReg_eq]
  · intro l _ hl
    rw [hEntry l, ite_eq_right hl, zero_smul]
  · intro hmem; exact absurd (Finset.mem_univ l₀) hmem


