  obtain ⟨_, h3⟩ := runMask67_inMask_aux_cert hm (m &&& M)
  apply Nat.eq_of_testBit_eq; intro i
  by_cases hi : M.testBit i = true
  · have hleft : (runMask67 gs m &&& M).testBit i = (runMask67 gs m).testBit i := by
      rw [Nat.testBit_and, hi]; cases (runMask67 gs m).testBit i <;> rfl
    rw [← hleft, h1, Nat.testBit_xor, Nat.testBit_xor, Nat.testBit_and, hi]
    cases m.testBit i <;> cases (runMask67 gs (m &&& M)).testBit i <;> rfl
  · have hf : M.testBit i = false := Bool.eq_false_iff.mpr hi
    have h0 : (m &&& M).testBit i = false := by rw [Nat.testBit_and, hf]; cases m.testBit i <;> rfl
    rw [h2 i hf, Nat.testBit_xor, Nat.testBit_xor, h3 i hf, h0]
    cases m.testBit i <;> rfl


theorem runMask76_cnotOnly_xor :
    ∀ {gs : List RevGate76}, gs.all RevGate76.cnotOnly = true →
      ∀ (a b : ℕ), runMask76 gs (a ^^^ b) = runMask76 gs a ^^^ runMask76 gs b
  | [], _, _, _ => rfl
  | g :: gs, h, a, b => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      cases g with
      | x _ => simp [RevGate76.cnotOnly] at h
      | toff _ _ _ => simp [RevGate76.cnotOnly] at h
      | cnot c t =>
          have hstep : stepMask76 (.cnot c t) (a ^^^ b) =
              stepMask76 (.cnot c t) a ^^^ stepMask76 (.cnot c t) b := by
            apply Nat.eq_of_testBit_eq; intro i
            dsimp only [stepMask76]
            rw [Nat.testBit_xor]
            cases a.testBit c.val <;> cases b.testBit c.val <;>
              simp only [Bool.bne_true, Bool.bne_false, Bool.not_true, Bool.not_false,
                ↓reduceIte, Bool.false_eq_true, Nat.testBit_xor]
            · cases a.testBit i <;> cases b.testBit i <;> cases (2 ^ t.val).testBit i <;> rfl
            · cases a.testBit i <;> cases b.testBit i <;> cases (2 ^ t.val).testBit i <;> rfl
            · cases a.testBit i <;> cases b.testBit i <;> cases (2 ^ t.val).testBit i <;> rfl
          rw [runMask76, hstep, runMask76_cnotOnly_xor h.2, runMask76, runMask76]


theorem runMask76_id_of_lt8192 :
    ∀ {gs : List RevGate76}, gs.all RevGate76.cnotOnlyGe13 = true →
      ∀ {m : ℕ}, m < 8192 → runMask76 gs m = m
  | [], _, _, _ => rfl
  | g :: gs, h, m, hm => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      cases g with
      | x _ => simp [RevGate76.cnotOnlyGe13] at h
      | toff _ _ _ => simp [RevGate76.cnotOnlyGe13] at h
      | cnot c t =>
          simp only [RevGate76.cnotOnlyGe13, decide_eq_true_eq] at h
          have hfalse : m.testBit c.val = false :=
            Nat.testBit_lt_two_pow (lt_of_lt_of_le (by exact hm : m < 2 ^ 13)
              (Nat.pow_le_pow_right (by decide) h.1))
          rw [runMask76, stepMask76, ite_eq_right (by rw [hfalse]; decide)]
          exact runMask76_id_of_lt8192 h.2 hm


theorem checkNatRange_true {f : ℕ → Bool} :
    ∀ (len s x : ℕ), checkNatRange f len s = true → s ≤ x → x < s + len → f x = true
  | 0, _, _, _, hsx, hlt => by omega
  | len + 1, s, x, h, hsx, hlt => by
      simp only [checkNatRange, Bool.and_eq_true] at h
      by_cases heq : x = s
      · subst heq; exact h.1
      · exact checkNatRange_true len (s + 1) x h.2 (by omega) (by omega)


def checkPre1024One (x : ℕ) : Bool :=
  let y76 := runMask76 preFlat76 x
  let y67 := runMask67 preGates67 x
  (y76 &&& maskC0_76 == cAxis10 x 0 * 2 ^ 42) &&
  (y76 &&& maskC1_76 == cAxis10 x 1 * 2 ^ 45) &&
  (y76 &&& maskC2_76 == cAxis10 x 2 * 2 ^ 48) &&
  (y67 &&& maskC0_67_cert == cAxis10 x 0 * 2 ^ 37) &&
  (y67 &&& maskC1_67_cert == cAxis10 x 1 * 2 ^ 40) &&
  (y67 &&& maskC2_67_cert == cAxis10 x 2 * 2 ^ 43) &&
  decide (cAxis10 x 0 < 6) && decide (cAxis10 x 1 < 6) && decide (cAxis10 x 2 < 6)


