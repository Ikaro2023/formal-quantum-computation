private theorem teleHsSplitStitch_onehot {m : ℕ} (L : ℕ) (rFull : QRegister (m + 1) 128)
    (hrVal : ∀ i : Fin m, (qregInit rFull i).val = 69 + i.val)
    (hrInit : ∀ l : Fin m, qregInit rFull l = rFull l.castSucc)
    (cDepth cSplit cFork cNext : Circuit 128)
    (brIdx : List (Fin 20 × TeleSpec)) (flIdx : List (Fin 20))
    (hdisj : PmSplitDisj ((brIdx.map fun p => (scr20_128 p.1, p.2)).map Prod.fst)
      (flIdx.map scr20_128) wPmPar_128 (rFull (Fin.last m)))
    (hDepth : cDepth = (cSplit ;;ᶜ cFork))
    (hSplit : cSplit = cTeleMux L (brIdx.map fun p => (scr20_128 p.1, p.2))
      (flIdx.map scr20_128) wPmPar_128 (rFull (Fin.last m)))
    (pre suf : List (Fin 20 × Fin 20)) (idx i_R : Fin 20) (s : TeleSpec)
    (hFork : cFork = forkChain (rFull (Fin.last m)) (pre ++ (idx, i_R) :: suf) cNext)
    (words : (k : Fin (m + 1)) → Fin (2 ^ k.val) → TeleSpec)
    (hbwd : s.bwdOdds.length = L) (hfwd : s.fwdOdds.length = L)
    (hbrIdx : brIdx.filter (fun p => p.1 == idx) = [(idx, s)])
    (hflIdx : flIdx.filter (fun i => i == idx) = [])
    (huR : idx ≠ i_R) (hPre : forksInactOk idx pre = true)
    (hSufL : forksInactOk idx suf = true) (hSufR : forksInactOk i_R suf = true)
    (htB : 69 + m ≤ (rFull (Fin.last m)).val ∧ (rFull (Fin.last m)).val < 86) (hw : s = words 0 0)
    (hChildL : ∀ γ : BitAssignment 128, OneHotScr21 idx.val γ →
      (∀ l : Fin m, γ (qregInit rFull l) = 0) → cNext.eval.1.mulVec (ket γ) =
        ∑ x : Fin (2 ^ m), teleSbmAmp m (fun k q => words k.succ ⟨q.val, lt_pow_succ_of_lt q⟩) x •
          ket (writeReg γ (qregInit rFull) (basisBits m x)))
    (hChildR : ∀ γ : BitAssignment 128, OneHotScr21 i_R.val γ →
      (∀ l : Fin m, γ (qregInit rFull l) = 0) → cNext.eval.1.mulVec (ket γ) =
        ∑ x : Fin (2 ^ m),
          teleSbmAmp m (fun k q => words k.succ ⟨2 ^ k.val + q.val, add_lt_pow_succ q⟩) x •
            ket (writeReg γ (qregInit rFull) (basisBits m x)))
    (β : BitAssignment 128) (hOH : OneHotScr21 idx.val β)
    (hr : ∀ i : Fin (m + 1), β (rFull i) = 0) :
    cDepth.eval.1.mulVec (ket β) =
      ∑ j : Fin (2 ^ (m + 1)),
        teleSbmAmp (m + 1) words j • ket (writeReg β rFull (basisBits (m + 1) j)) := by
  set t := rFull (Fin.last m)
  set rLow := qregInit rFull
  have hrLow : ∀ l : Fin m, β (rLow l) = 0 := fun l => by
    rw [hrInit l]
    exact hr l.castSucc
  have hbr : (brIdx.map fun p => (scr20_128 p.1, p.2)).filter (fun q => β q.1 == 1) =
      [(scr20_128 idx, s)] :=
    (filter_scr20_branches idx brIdx β hOH).trans
      (congrArg (List.map fun p => (scr20_128 p.1, p.2)) hbrIdx)
  have hfl : (flIdx.map scr20_128).filter (fun q => β q == 1) = [] :=
    (filter_scr20_flips idx flIdx β hOH).trans (congrArg (List.map scr20_128) hflIdx)
  rw [hDepth, MeasureBranchHadamardSem.eval_seq_mulVec, hSplit,
    cTeleMux_mulVec_ket_onehot L _ _ wPmPar_128 t (scr20_128 idx) s hdisj hbwd hfwd β
      (oneHotScr21_wPmPar_zero idx β hOH) (hr (Fin.last m)) hbr hfl,
    Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, hFork,
    forkChain_append t pre ((idx, i_R) :: suf) cNext]
  have hL : (forkChain t pre (forkChain t ((idx, i_R) :: suf) cNext)).eval.1.mulVec (ket β) =
      ∑ x : Fin (2 ^ m), teleSbmAmp m (fun k q => words k.succ ⟨q.val, lt_pow_succ_of_lt q⟩) x •
        ket (writeReg β rLow (basisBits m x)) :=
    forkChain_inact rLow hrVal idx t pre _ _ β hPre htB hOH
      (withUnaryFork_ket_active_zero_sum rLow hrVal idx i_R t (forkChain t suf cNext) _ β
        huR htB hOH (hr (Fin.last m))
        (forkChain_inact rLow hrVal idx t suf cNext _ β hSufL htB hOH (hChildL β hOH hrLow)))
  set β1 := Function.update β t 1
  have hOH1 : OneHotScr21 idx.val β1 := oneHotScr21_update_nonScr idx.val t 1 htB.2 β hOH
  have hrLow1 : ∀ l : Fin m, β1 (rLow l) = 0 := fun l => by
    dsimp only [β1]
    have hne : rLow l ≠ t := fun h => by
      have hv := congrArg Fin.val h
      have hl := l.isLt
      rw [hrVal l] at hv
      omega
    rw [Function.update_of_ne hne, hrLow l]
  set γSw := forkSwap idx i_R β1
  have hOHSw : OneHotScr21 i_R.val γSw := oneHotScr21_forkSwap idx i_R huR β1 hOH1
  have hrSw : ∀ l : Fin m, γSw (rLow l) = 0 := fun l => by
    dsimp only [γSw, forkSwap]
    have h1 : rLow l ≠ scr20_128 idx := fun h => by
      have hv := congrArg Fin.val h
      have hl := l.isLt
      rw [hrVal l, scr20_128_val] at hv
      omega
    have h2 : rLow l ≠ scr20_128 i_R := fun h => by
      have hv := congrArg Fin.val h
      have hl := l.isLt
      rw [hrVal l, scr20_128_val] at hv
      omega
    rw [Function.update_of_ne h1, Function.update_of_ne h2, hrLow1 l]
  have hR : (forkChain t pre (forkChain t ((idx, i_R) :: suf) cNext)).eval.1.mulVec (ket β1) =
      ∑ x : Fin (2 ^ m),
        teleSbmAmp m (fun k q => words k.succ ⟨2 ^ k.val + q.val, add_lt_pow_succ q⟩) x •
          ket (writeReg β1 rLow (basisBits m x)) :=
    forkChain_inact rLow hrVal idx t pre _ _ β1 hPre htB hOH1
      (withUnaryFork_ket_active_one_sum rLow hrVal idx i_R t (forkChain t suf cNext) _ β1
        huR htB hOH1 (Function.update_self _ _ _)
        (forkChain_inact rLow hrVal i_R t suf cNext _ γSw hSufR htB hOHSw (hChildR γSw hOHSw hrSw)))
  rw [hL, hR, hw, ← stitch_teleSbmAmp_succ m rFull words β (hr (Fin.last m))]

private theorem teleHsSplitStitch_zero {m : ℕ} (L : ℕ) (rFull : QRegister (m + 1) 128)
    (hrVal : ∀ i : Fin m, (qregInit rFull i).val = 69 + i.val)
    (hrInit : ∀ l : Fin m, qregInit rFull l = rFull l.castSucc)
    (cDepth cSplit cFork cNext : Circuit 128)
    (brIdx : List (Fin 20 × TeleSpec)) (flIdx : List (Fin 20))
    (hdisj : PmSplitDisj ((brIdx.map fun p => (scr20_128 p.1, p.2)).map Prod.fst)
      (flIdx.map scr20_128) wPmPar_128 (rFull (Fin.last m)))
    (hDepth : cDepth = (cSplit ;;ᶜ cFork))
    (hSplit : cSplit = cTeleMux L (brIdx.map fun p => (scr20_128 p.1, p.2))
      (flIdx.map scr20_128) wPmPar_128 (rFull (Fin.last m)))
    (ps : List (Fin 20 × Fin 20)) (idx : Fin 20)
    (hFork : cFork = forkChain (rFull (Fin.last m)) ps cNext)
    (words : (k : Fin (m + 1)) → Fin (2 ^ k.val) → TeleSpec)
    (hbrIdx : brIdx.filter (fun p => p.1 == idx) = [])
    (hflIdx : flIdx.filter (fun i => i == idx) = []) (hPs : forksInactOk idx ps = true)
    (htB : 69 + m ≤ (rFull (Fin.last m)).val ∧ (rFull (Fin.last m)).val < 86)
    (hw : words 0 0 = teleSpecSkipH)
    (hChild : ∀ γ : BitAssignment 128, OneHotScr21 idx.val γ →
      (∀ l : Fin m, γ (qregInit rFull l) = 0) → cNext.eval.1.mulVec (ket γ) =
        ∑ x : Fin (2 ^ m), teleSbmAmp m (fun k q => words k.succ ⟨q.val, lt_pow_succ_of_lt q⟩) x •
          ket (writeReg γ (qregInit rFull) (basisBits m x)))
    (β : BitAssignment 128) (hOH : OneHotScr21 idx.val β)
    (hr : ∀ i : Fin (m + 1), β (rFull i) = 0) :
    cDepth.eval.1.mulVec (ket β) =
      ∑ j : Fin (2 ^ (m + 1)),
        teleSbmAmp (m + 1) words j • ket (writeReg β rFull (basisBits (m + 1) j)) := by
  have hrLow : ∀ l : Fin m, β (qregInit rFull l) = 0 := fun l => by
    rw [hrInit l]
    exact hr l.castSucc
  have hbr : (brIdx.map fun p => (scr20_128 p.1, p.2)).filter (fun q => β q.1 == 1) = [] :=
    (filter_scr20_branches idx brIdx β hOH).trans
      (congrArg (List.map fun p => (scr20_128 p.1, p.2)) hbrIdx)
  have hfl : (flIdx.map scr20_128).filter (fun q => β q == 1) = [] :=
    (filter_scr20_flips idx flIdx β hOH).trans (congrArg (List.map scr20_128) hflIdx)
  rw [hDepth, MeasureBranchHadamardSem.eval_seq_mulVec, hSplit,
    cTeleMux_mulVec_ket_zero L _ _ wPmPar_128 (rFull (Fin.last m)) hdisj β
      (oneHotScr21_wPmPar_zero idx β hOH) hbr hfl, hFork]
  have hL := forkChain_inact (qregInit rFull) hrVal idx (rFull (Fin.last m)) ps cNext _ β
    hPs htB hOH (hChild β hOH hrLow)
  rw [hL, ← stitch_teleSbmAmp_succ m rFull words β (hr (Fin.last m)), hw,
    teleAlpha0_skipH, teleAlpha1_skipH, one_smul, zero_smul, add_zero]

