          muxHeadBhmtAmp (if s0 then anc else nuc) pidVal (q 62 == 1) *
          teleSbmAmp 6 teleHeadShell64Specs ⟨kVal, bitsVal_lt_two_pow_local _⟩ *
          (w0 ^ 3) * (w0 ^ 2) * (if s0 then w0 ^ 2 else w0 ^ 7)
      else 0
    else 0
  else
    let qClr := clrPid12_80 q
    let qClr0 := Function.update qClr 62 0
    let scratchZero :=
      decide (∀ j : Fin 12, qClr (pos80SubIdx 63 12 (by decide) j) = 0) && (q 78 == 0)
