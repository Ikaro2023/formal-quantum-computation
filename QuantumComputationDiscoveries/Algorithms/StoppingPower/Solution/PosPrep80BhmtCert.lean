theorem writeReg_mkBlock152_outside {m : ℕ} (off : ℕ) (h : off + m ≤ 152)
    (α : BitAssignment 152) (q : BitAssignment m) (w : Wire 152)
    (hw : w.val < off ∨ off + m ≤ w.val) :
    ZeroAncillaUSPS3.writeReg α (mkBlock152 off m h) q w = α w := by
  refine ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ ?_
  rintro ⟨i, rfl⟩
  dsimp [mkBlock152] at hw
  omega


theorem hadamardData48_mulVec_ket_zero (α₀ : BitAssignment 152)
    (h0 : ∀ w ∈ listData48_152, α₀ w = 0) :
    (Circuit.sequence (listData48_152.map Circuit.H)).eval.1.mulVec (ket α₀) =
      ((sqrtHalf : ℂ) ^ 48) • ∑ d : Data48Tuple, ket (writeData48 α₀ d) := by
  have hb1_mem : ∀ i : Fin 3, rB1_152 i ∈ listData48_152 := by decide
  have hfine_mem : ∀ i : Fin 30, rFine30_152 i ∈ listData48_152 := by decide
  have hanc_mem : ∀ i : Fin 7, rAnc7_152 i ∈ listData48_152 := by decide
  have hnuc_mem : ∀ i : Fin 8, rNuc_152 i ∈ listData48_152 := by decide
  rw [listData48_eq_append4]
  simp only [List.map_append]
  rw [sequence_append_mulVec, sequence_append_mulVec, sequence_append_mulVec]
  have hb1 : ∀ i : Fin 3, α₀ (rB1_152 i) = 0 := fun i ↦ h0 _ (hb1_mem i)
  have hfine : ∀ b1 : Fin (2 ^ 3), ∀ i : Fin 30,
      ZeroAncillaUSPS3.writeReg α₀ rB1_152 (basisBits 3 b1) (rFine30_152 i) = 0 := fun b1 i ↦ by
    rw [writeReg_mkBlock152_outside 6 _ _ _ _ (by dsimp [rFine30_152, mkBlock152]; omega)]
    exact h0 _ (hfine_mem i)
  have hanc : ∀ (b1 : Fin (2 ^ 3)) (fine : Fin (2 ^ 30)), ∀ i : Fin 7,
      ZeroAncillaUSPS3.writeReg
        (ZeroAncillaUSPS3.writeReg α₀ rB1_152 (basisBits 3 b1))
        rFine30_152 (basisBits 30 fine) (rAnc7_152 i) = 0 := fun b1 fine i ↦ by
    rw [writeReg_mkBlock152_outside 38 _ _ _ _ (by dsimp [rAnc7_152, mkBlock152]; omega),
      writeReg_mkBlock152_outside 6 _ _ _ _ (by dsimp [rAnc7_152, mkBlock152]; omega)]
    exact h0 _ (hanc_mem i)
  have hnuc : ∀ (b1 : Fin (2 ^ 3)) (fine : Fin (2 ^ 30)) (ancHi : Fin (2 ^ 7)), ∀ i : Fin 8,
      ZeroAncillaUSPS3.writeReg
        (ZeroAncillaUSPS3.writeReg
          (ZeroAncillaUSPS3.writeReg α₀ rB1_152 (basisBits 3 b1))
          rFine30_152 (basisBits 30 fine))
        rAnc7_152 (basisBits 7 ancHi) (rNuc_152 i) = 0 := fun b1 fine ancHi i ↦ by
    rw [writeReg_mkBlock152_outside 21 _ _ _ _ (by dsimp [rNuc_152, mkBlock152]; omega),
      writeReg_mkBlock152_outside 38 _ _ _ _ (by dsimp [rNuc_152, mkBlock152]; omega),
      writeReg_mkBlock152_outside 6 _ _ _ _ (by dsimp [rNuc_152, mkBlock152]; omega)]
    exact h0 _ (hnuc_mem i)
  rw [hadamardList_ofFn_mulVec_ket_zero rB1_152 α₀ hb1,
    Matrix.mulVec_smul, Matrix.mulVec_sum]
  simp only [fun b1 ↦ hadamardList_ofFn_mulVec_ket_zero rFine30_152 _ (hfine b1),
    Matrix.mulVec_smul, Matrix.mulVec_sum]
  simp only [fun b1 fine ↦ hadamardList_ofFn_mulVec_ket_zero rAnc7_152 _ (hanc b1 fine),
    Matrix.mulVec_smul, Matrix.mulVec_sum]
  simp only [fun b1 fine ancHi ↦ hadamardList_ofFn_mulVec_ket_zero rNuc_152 _ (hnuc b1 fine ancHi)]
  simp only [← Finset.smul_sum, smul_smul]
  have hp : (sqrtHalf : ℂ) ^ 3 * ((sqrtHalf : ℂ) ^ 30 * ((sqrtHalf : ℂ) ^ 7 * (sqrtHalf : ℂ) ^ 8)) =
      (sqrtHalf : ℂ) ^ 48 := by ring
  rw [hp]
  apply congrArg (((sqrtHalf : ℂ) ^ 48) • ·)
  simp only [Fintype.sum_prod_type]
  rfl


theorem singleton_embedMatrix_mulVec_ket_zero {N : ℕ} (t : Wire N) (M : Matrix (Fin 2) (Fin 2) ℂ)
    (α : BitAssignment N) (ht : α t = 0) :
    ((QRegister.singleton t).embedMatrix M).mulVec (ket α) =
      M 0 0 • ket α + M 1 0 • ket (Function.update α t 1) := by
  rw [embedMatrix_mulVec_ket_sub]
  have hloc : localIdxSub (QRegister.singleton t) α = (0 : Fin (2 ^ 1)) := by
    apply (basisBitsEquiv 1).injective
    funext i
    fin_cases i
    dsimp [localIdxSub]
    rw [(basisBitsEquiv 1).apply_symm_apply]
    rw [ht]
    rfl
  have hu1 : (Finset.univ : Finset (Fin (2 ^ 1))) = {0, 1} := by decide
  rw [hloc, hu1, Finset.sum_pair (by decide : (0 : Fin (2 ^ 1)) ≠ 1)]
  have h0 : ZeroAncillaUSPS3.writeReg α (QRegister.singleton t) (basisBits 1 0) = α := by
    funext w
    by_cases hw : w = t
    · subst hw
      exact (ZeroAncillaUSPS3.writeReg_apply_reg α (QRegister.singleton w) (basisBits 1 0) 0).trans
        ht.symm
    · exact ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _
        (by rintro ⟨i, hi⟩; fin_cases i; exact hw hi.symm)
  have h1 : ZeroAncillaUSPS3.writeReg α (QRegister.singleton t) (basisBits 1 1) =
      Function.update α t 1 := by
    funext w
    by_cases hw : w = t
    · subst hw
      rw [Function.update_self]
      exact ZeroAncillaUSPS3.writeReg_apply_reg α (QRegister.singleton w) (basisBits 1 1) 0
    · rw [Function.update_of_ne hw]
      exact ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _
        (by rintro ⟨i, hi⟩; fin_cases i; exact hw hi.symm)
  rw [writeReg_eq, writeReg_eq, h0, h1]


theorem writeData48_apply_outside (α : BitAssignment 152) (d : Data48Tuple) (w : Wire 152)
    (hw : w.val < 6 ∨ w.val = 20 ∨ (28 ≤ w.val ∧ w.val < 38) ∨ 68 ≤ w.val) :
    writeData48 α d w = α w := by
  rcases d with ⟨b1, fine, ancHi, nuc⟩
  dsimp only [writeData48]
  rw [writeReg_mkBlock152_outside 12 _ _ _ _ (by omega),
    writeReg_mkBlock152_outside 21 _ _ _ _ (by omega),
