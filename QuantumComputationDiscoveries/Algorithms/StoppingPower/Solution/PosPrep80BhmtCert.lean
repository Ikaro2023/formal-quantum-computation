theorem muSlot2Ideal218_off_projBhmt (p : BitAssignment 80)
    (hne : projBhmt false p ≠ p) :
    muSlot2Ideal218 p = 0 := by
  unfold muSlot2Ideal218
  dsimp only
  let nuc := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j))
  by_cases h216 : nuc < 216
  · rw [ite_eq_left h216]
    have handF : ((nuc &&& 216) == 216) = false :=
      PosPostPrep80L1BoundsS3.nuc_and216_of_lt216 ⟨nuc, bitsVal_lt_two_pow_local _⟩ h216
    dsimp only [nuc] at handF
    unfold muSlot2Ideal216
    suffices PosPostPrep80MergedVepS3.pos80IdealDist false (flipTailDpScratch80 p) = 0 by
      rw [this, mul_zero]
    apply pos80IdealDist_false_zero_of_bad_Bhmt
    have hf30 : flipTailDpScratch80 p 30 = p 30 :=
      PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p 30 (by decide)
    have hfb0 : (fun j : Fin 3 ↦ flipTailDpScratch80 p (pos80SubIdx 3 3 (by decide) j)) =
        fun j : Fin 3 ↦ p (pos80SubIdx 3 3 (by decide) j) :=
      funext fun j ↦
        PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p _ (by dsimp [pos80SubIdx]; omega)
    have hfanc : (fun j : Fin 8 ↦ flipTailDpScratch80 p (pos80SubIdx 14 8 (by decide) j)) =
        fun j : Fin 8 ↦ p (pos80SubIdx 14 8 (by decide) j) :=
      funext fun j ↦
        PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p _ (by dsimp [pos80SubIdx]; omega)
    have hf70 : flipTailDpScratch80 p 70 = p 70 :=
      PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p 70 (by decide)
    have hf71 : flipTailDpScratch80 p 71 = p 71 :=
      PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p 71 (by decide)
    rw [hf30, hfb0, hfanc, hf70, hf71]
    unfold projBhmt at hne
    change (if false then _ else _) ≠ p at hne
    simp only [Bool.false_eq_true, ↓reduceIte] at hne
    by_cases hp30 : (p 30 == 1) = true
    · simp only [hp30, handF, Bool.false_eq_true, ↓reduceIte, (clrMask_eqs_Bhmt p).2.2.2.1] at hne
      rcases clrMask_ne_self_exists_Bhmt maskS2HeadLoBhmt p hne with ⟨i, hi, hpi⟩
      have hi' : (3 ≤ i.val ∧ i.val < 6) ∨ (14 ≤ i.val ∧ i.val < 21) := by
        simpa [maskS2HeadLoBhmt] using hi
      rcases hi' with hb0 | hanc
      · right; right; left
        intro h0
        have := (bitsVal3_eq_zero_iff_Bhmt _).mp h0 ⟨i.val - 3, by omega⟩
        exact hpi (by simpa [pos80SubIdx, show 3 + (i.val - 3) = i.val by omega] using this)
      · right; left; refine ⟨hp30, fun h0 ↦ ?_⟩
        have := (bitsVal8_eq_zero_iff_Bhmt _).mp h0 ⟨i.val - 14, by omega⟩
        exact hpi (by simpa [pos80SubIdx, show 14 + (i.val - 14) = i.val by omega] using this)
    · have hp30f : (p 30 == 1) = false := Bool.eq_false_iff.mpr hp30
      simp only [hp30, handF, Bool.false_eq_true, ↓reduceIte, (clrMask_eqs_Bhmt p).2.2.2.2] at hne
      rcases clrMask_ne_self_exists_Bhmt maskS2TailLoBhmt p hne with ⟨i, hi, hpi⟩
      have hi' : (3 ≤ i.val ∧ i.val < 6) ∨ i.val = 70 ∨ i.val = 71 := by
        simpa [maskS2TailLoBhmt] using hi
      rcases hi' with hb0 | h7071
      · right; right; left
        intro h0
        have := (bitsVal3_eq_zero_iff_Bhmt _).mp h0 ⟨i.val - 3, by omega⟩
        exact hpi (by simpa [pos80SubIdx, show 3 + (i.val - 3) = i.val by omega] using this)
      · right; right; right; refine ⟨hp30f, ?_⟩
        rcases h7071 with h70 | h71
        · left; rwa [show (70 : Wire 80) = i from Fin.ext h70.symm]
        · right; rwa [show (71 : Wire 80) = i from Fin.ext h71.symm]
  · rw [ite_eq_right h216]
    by_cases h218 : nuc < 218
    · rw [ite_eq_left h218]
      have handT : ((nuc &&& 216) == 216) = true :=
        PosPostPrep80L1BoundsS3.nuc_and216_of_216_218 ⟨nuc, bitsVal_lt_two_pow_local _⟩
          (Nat.le_of_not_lt h216) h218
      dsimp only [nuc] at handT
      unfold muSlot2Ideal216
      suffices PosPostPrep80MergedVepS3.pos80IdealDist false
          (flipTailDpScratch80 (p80ClearCosetAndNucLocal p)) = 0 by
        rw [this, mul_zero]
      apply pos80IdealDist_false_zero_of_bad_Bhmt
      let cp := p80ClearCosetAndNucLocal p
      have hcp30 : flipTailDpScratch80 cp 30 = p 30 := by
        rw [PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve cp 30 (by decide)]
        unfold cp p80ClearCosetAndNucLocal; exact ite_eq_right (by decide)
      have hcpanc : (fun j : Fin 8 ↦ flipTailDpScratch80 cp (pos80SubIdx 14 8 (by decide) j)) =
          fun j : Fin 8 ↦ p (pos80SubIdx 14 8 (by decide) j) := by
        funext j
        rw [PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve cp _
          (by dsimp [pos80SubIdx]; omega)]
        unfold cp p80ClearCosetAndNucLocal
        exact ite_eq_right (by dsimp [pos80SubIdx]; omega)
      have hcp70 : flipTailDpScratch80 cp 70 = p 70 := by
        rw [PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve cp 70 (by decide)]
        unfold cp p80ClearCosetAndNucLocal; exact ite_eq_right (by decide)
      have hcp71 : flipTailDpScratch80 cp 71 = p 71 := by
        rw [PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve cp 71 (by decide)]
        unfold cp p80ClearCosetAndNucLocal; exact ite_eq_right (by decide)
      rw [hcp30, hcpanc, hcp70, hcp71]
      unfold projBhmt at hne
      change (if false then _ else _) ≠ p at hne
      simp only [Bool.false_eq_true, ↓reduceIte] at hne
      by_cases hp30 : (p 30 == 1) = true
      · simp only [hp30, handT, ↓reduceIte, (clrMask_eqs_Bhmt p).2.2.1] at hne
        rcases clrMask_ne_self_exists_Bhmt maskS2HeadHiBhmt p hne with ⟨i, hi, hpi⟩
        have hi' : 14 ≤ i.val ∧ i.val < 21 := by simpa [maskS2HeadHiBhmt] using hi
        right; left; refine ⟨hp30, fun h0 ↦ ?_⟩
        have := (bitsVal8_eq_zero_iff_Bhmt _).mp h0 ⟨i.val - 14, by omega⟩
        exact hpi (by simpa [pos80SubIdx, show 14 + (i.val - 14) = i.val by omega] using this)
      · have hp30f : (p 30 == 1) = false := Bool.eq_false_iff.mpr hp30
        simp only [hp30, handT, Bool.false_eq_true, ↓reduceIte, (clrMask_eqs_Bhmt p).2.1] at hne
        rcases clrMask_ne_self_exists_Bhmt maskTail2Bhmt p hne with ⟨i, hi, hpi⟩
        have hi' : i.val = 70 ∨ i.val = 71 := by simpa [maskTail2Bhmt] using hi
        right; right; right; refine ⟨hp30f, ?_⟩
        rcases hi' with h70 | h71
        · left; rwa [show (70 : Wire 80) = i from Fin.ext h70.symm]
        · right; rwa [show (71 : Wire 80) = i from Fin.ext h71.symm]
    · rw [ite_eq_right h218]


theorem muSlot2Ideal218_nclean (p : BitAssignment 80)
    (hn : ¬cleanS2Bhmt p) :
    muSlot2Ideal218 p = 0 := by
  unfold cleanS2Bhmt at hn
  rw [PosPostPrep80L1BoundsS3.p80NucVal_eq_bitsVal, payloadAncNat_eq_pos24_Bhmt] at hn
  unfold muSlot2Ideal218
  dsimp only
  let nuc := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j))
  by_cases h218 : nuc < 218
  · have hbad : ∀ q : BitAssignment 80,
        q 62 = p 62 → q 30 = p 30 →
        (fun j : Fin 8 ↦ q (pos80SubIdx 14 8 (by decide) j)) =
          (fun j : Fin 8 ↦ p (pos80SubIdx 14 8 (by decide) j)) →
        PosPostPrep80MergedVepS3.pos80IdealDist false q = 0 := fun q h62 h30 hanc ↦ by
      apply pos80IdealDist_false_zero_of_bad_Bhmt
      rw [h62, h30, hanc]
      by_cases hp62 : p 62 = 0
      · right; left
        have hor : ¬((p 30 == 1) = false ∨
            Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
              p (pos80SubIdx 14 8 (by decide) j)) < 128) :=
          fun h ↦ hn ⟨hp62, h218, h⟩
        push Not at hor
        refine ⟨Bool.eq_true_of_not_eq_false hor.1, by omega⟩
      · left; exact hp62
    by_cases h216 : nuc < 216
    · rw [ite_eq_left h216]
      unfold muSlot2Ideal216
      rw [hbad (flipTailDpScratch80 p)
        (PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p 62 (by decide))
        (PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p 30 (by decide))
        (funext fun j ↦
          PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve p _ (by dsimp [pos80SubIdx]; omega)),
        mul_zero]
    · rw [ite_eq_right h216, ite_eq_left h218]
      unfold muSlot2Ideal216
      let cp := p80ClearCosetAndNucLocal p
      rw [hbad (flipTailDpScratch80 cp)
        (by
          rw [PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve cp 62 (by decide)]
          unfold cp p80ClearCosetAndNucLocal; exact ite_eq_right (by decide))
        (by
          rw [PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve cp 30 (by decide)]
          unfold cp p80ClearCosetAndNucLocal; exact ite_eq_right (by decide))
        (funext fun j ↦ by
          rw [PosPostPrep80L1BoundsS3.flipTailDpScratch80_preserve cp _
            (by dsimp [pos80SubIdx]; omega)]
          unfold cp p80ClearCosetAndNucLocal
          exact ite_eq_right (by dsimp [pos80SubIdx]; omega)),
        mul_zero]
  · by_cases h216 : nuc < 216
    · omega
    · rw [ite_eq_right h216, ite_eq_right h218]



theorem smToTwosSys_mul_self_Bhmt :
    TwosCompAndWire0Cancel.smToTwosSysUnitary.1 *
      TwosCompAndWire0Cancel.smToTwosSysUnitary.1 = 1 := by
  have h1 : TwosCompAndWire0Cancel.smToTwosSysUnitary.1ᴴ *
      TwosCompAndWire0Cancel.smToTwosSysUnitary.1 = 1 :=
    Unitary.coe_star_mul_self TwosCompAndWire0Cancel.smToTwosSysUnitary
  rwa [Pos24MergedVepPrepAndStitch.smToTwosSysUnitary_sa] at h1


private theorem eq_of_smToTwosSys_conj_Bhmt
    {A B : Operator (2 ^ SpecsAux.SpecMirror.systemQubits)}
    (h : TwosCompAndWire0Cancel.smToTwosSysUnitary.1 * A *
        TwosCompAndWire0Cancel.smToTwosSysUnitary.1 =
      TwosCompAndWire0Cancel.smToTwosSysUnitary.1 * B *
        TwosCompAndWire0Cancel.smToTwosSysUnitary.1) :
    A = B := by
  let S := TwosCompAndWire0Cancel.smToTwosSysUnitary.1
  have hS : S * S = 1 := smToTwosSys_mul_self_Bhmt
  calc A = (S * S) * A * (S * S) := by rw [hS, Matrix.one_mul, Matrix.mul_one]
    _ = S * (S * A * S) * S := by simp only [Matrix.mul_assoc]
    _ = S * (S * B * S) * S := by rw [h]
    _ = (S * S) * B * (S * S) := by simp only [Matrix.mul_assoc]
    _ = B := by rw [hS, Matrix.one_mul, Matrix.mul_one]




