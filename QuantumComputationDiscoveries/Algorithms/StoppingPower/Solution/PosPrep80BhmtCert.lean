    rw [clrPid12_encTailBhmt]
    exact hVT tr.1
  · apply Prod.ext
    · dsimp only [decTailBhmt]
      rw [clrPid12_encTailBhmt]
      exact hLT ts
    · dsimp only [decTailBhmt]
      have hSub : (fun k : Fin 2 ↦ encTailBhmt s0 (ts, pLo) (pos80SubIdx 70 2 (by decide) k)) =
          basisBits 2 pLo := by
