def flipWireFn {k : ℕ} (w : Wire k) (β : BitAssignment k) : BitAssignment k :=
  Function.update β w (β w + 1)

theorem flipWireFn_ne {k : ℕ} {w q : Wire k} (h : q ≠ w) (β : BitAssignment k) :
    flipWireFn w β q = β q := by
  unfold flipWireFn
  exact Function.update_of_ne h _ _


