theorem diagonal_mul_permUnitary_of_eq_Bhmt {N : ℕ} {dec1 dec2 : DecidableEq (Fin N)}
    (fp fq : Fin N → ℂ) (σ : Equiv.Perm (Fin N))
    (hfg : ∀ z, fp (σ z) = fq z) :
    @Matrix.diagonal (Fin N) ℂ dec1 _ fp * (permutationUnitary σ).1 =
      (permutationUnitary σ).1 * @Matrix.diagonal (Fin N) ℂ dec2 _ fq := by
  have hd : ∀ (d1 d2 : DecidableEq (Fin N)) (g : Fin N → ℂ),
      @Matrix.diagonal (Fin N) ℂ d1 _ g = @Matrix.diagonal (Fin N) ℂ d2 _ g :=
    fun d1 d2 g ↦ congrArg (fun d ↦ @Matrix.diagonal (Fin N) ℂ d _ g) (Subsingleton.elim d1 d2)
  have h1 := Pos24Slot2FermionicBridge.diagonal_mul_fwdPermUnitary fp σ
  rw [← Pos24Slot2FermionicBridge.permutationUnitary_eq_fwdPermUnitary σ] at h1
  refine (congrArg (· * _) (hd dec1 (instDecidableEqFin N) fp)).trans (h1.trans (congrArg (_ *
    ·) ?_))
  exact (congrArg (@Matrix.diagonal (Fin N) ℂ (instDecidableEqFin N) _) (funext hfg)).trans
    (hd (instDecidableEqFin N) dec2 fq)


theorem conj_push_to_one_diag_Bhmt {D : ℕ}
    {P P0 N V Dp Dq : Operator D}
    (hPs : Pᴴ = P) (hPinv : Pᴴ * P = 1) (hP0 : P0 = 1)
    (hN : N * P = P * N) (hNa : Nᴴ * P = P * Nᴴ)
    (hV : V * P = P * V) (hVa : Vᴴ * P = P * Vᴴ)
    (hdiag : Dp * P = P * Dq) :
    Pᴴ * (N * (Vᴴ * Dp * V) * Nᴴ) * P =
      P0ᴴ * (N * (Vᴴ * Dq * V) * Nᴴ) * P0 := by
  have hPN : Pᴴ * N = N * Pᴴ := by rw [hPs]; exact hN.symm
  have hPVa : Pᴴ * Vᴴ = Vᴴ * Pᴴ := by rw [hPs]; exact hVa.symm
  have hdc : Pᴴ * Dp * P = Dq := by
    calc Pᴴ * Dp * P
        = Pᴴ * (Dp * P) := Matrix.mul_assoc _ _ _
      _ = (Pᴴ * P) * Dq := by rw [hdiag, ← Matrix.mul_assoc]
      _ = Dq := by rw [hPinv, Matrix.one_mul]
  rw [hP0, Matrix.conjTranspose_one, Matrix.one_mul, Matrix.mul_one]
  calc Pᴴ * (N * (Vᴴ * Dp * V) * Nᴴ) * P
      = (Pᴴ * N) * (Vᴴ * Dp * V) * (Nᴴ * P) := by simp only [Matrix.mul_assoc]
    _ = N * ((Pᴴ * Vᴴ) * Dp * (V * P)) * Nᴴ := by
        rw [hPN, hNa]; simp only [Matrix.mul_assoc]
    _ = N * (Vᴴ * (Pᴴ * Dp * P) * V) * Nᴴ := by
        rw [hPVa, hV]; simp only [Matrix.mul_assoc]
    _ = N * (Vᴴ * Dq * V) * Nᴴ := by rw [hdc]


theorem conj_sum_mul_congr_Bhmt {Y : Type*} [Fintype Y] {D : ℕ}
    (U V : Operator D) (B f g : Y → Operator D)
    (hfg : ∀ y, f y = g y) :
    U * (∑ y : Y, B y * f y) * V = U * (∑ y : Y, B y * g y) * V := by
  have hs : (∑ y : Y, B y * f y) = ∑ y : Y, B y * g y :=
    Finset.sum_congr rfl fun y _ ↦ congrArg (B y * ·) (hfg y)
  rw [hs]


