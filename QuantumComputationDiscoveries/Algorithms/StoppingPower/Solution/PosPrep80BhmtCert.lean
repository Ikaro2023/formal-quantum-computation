theorem evalProg152_map_x_nodup (ws : List (Wire 152)) (hnd : ws.Nodup) (α : BitAssignment 152) :
    evalProg152 (ws.map CleanStep152.x) α = fun w ↦ if w ∈ ws then α w + 1 else α w := by
  induction ws generalizing α with
  | nil => simp [evalProg152]
  | cons q qs ih =>
      obtain ⟨hq_not, hnd_qs⟩ := List.nodup_cons.mp hnd
      simp only [List.map_cons, evalProg152]
      rw [ih hnd_qs]
      funext w
      by_cases hwq : w = q
      · subst hwq
        simp [evalStep152, hq_not]
      · dsimp only [evalStep152]
        rw [Function.update_of_ne hwq]
        simp [hwq]


def zeroReflAccProd (α : BitAssignment 152) : ℕ → ZMod 2
  | 0 => α wEnPos_152
  | k + 1 =>
      zeroReflAccProd α k *
        (if hk : k < 49 then α (listRefl49_152[k]'(by rw [length_listRefl49_152]; exact hk)) +
          1 else 1)


theorem zeroReflAccProd_eq_one_iff (α : BitAssignment 152) :
    ∀ (k : ℕ) (hk : k ≤ 49),
      zeroReflAccProd α k = 1 ↔
        α wEnPos_152 = 1 ∧
        ∀ m (hm : m < k), α (listRefl49_152[m]'(by rw [length_listRefl49_152]; omega)) = 0
  | 0, _ => by simp [zeroReflAccProd]
  | k + 1, hk => by
      have ih := zeroReflAccProd_eq_one_iff α k (by omega)
      have hk49 : k < 49 := by omega
      simp only [zeroReflAccProd, hk49, ↓reduceDIte]
      have hmul : ∀ a b : ZMod 2, a * (b + 1) = 1 ↔ a = 1 ∧ b = 0 := by decide
      rw [hmul, ih]
      refine ⟨fun ⟨⟨he, hall⟩, hlast⟩ ↦ ⟨he, fun m hm ↦ ?_⟩,
        fun ⟨he, hall⟩ ↦ ⟨⟨he, fun m hm ↦ hall m (by omega)⟩, hall k (by omega)⟩⟩
      by_cases hmk : m = k
      · subst hmk; exact hlast
      · exact hall m (by omega)


