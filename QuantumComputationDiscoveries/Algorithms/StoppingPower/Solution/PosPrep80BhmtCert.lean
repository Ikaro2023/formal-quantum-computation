private theorem xor_lt_two_pow_cert {a b k : ℕ} (ha : a < 2 ^ k) (hb : b < 2 ^ k) :
    a ^^^ b < 2 ^ k := by
  have hsh : (a ^^^ b) >>> k = 0 := by
    apply Nat.eq_of_testBit_eq
    intro i
    rw [Nat.testBit_shiftRight, Nat.zero_testBit, Nat.testBit_xor,
      Nat.testBit_lt_two_pow (lt_of_lt_of_le ha (Nat.pow_le_pow_right (by decide) (by omega))),
      Nat.testBit_lt_two_pow (lt_of_lt_of_le hb (Nat.pow_le_pow_right (by decide) (by omega)))]
    rfl
  rw [Nat.shiftRight_eq_div_pow] at hsh
  have hdm := Nat.div_add_mod (a ^^^ b) (2 ^ k)
  simp only [hsh, Nat.mul_zero, Nat.zero_add] at hdm
  rw [← hdm]
  exact Nat.mod_lt _ (Nat.two_pow_pos k)


theorem nat_and_xor_distrib_right76 (a b M : ℕ) :
