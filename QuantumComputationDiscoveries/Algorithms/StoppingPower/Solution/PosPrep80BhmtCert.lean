theorem chIf_mulVec_ket_zero {N : ℕ} (c q : Wire N) (hcq : c ≠ q)
    (β : BitAssignment N) (hc0 : β c = 0) :
    (chIf c q).eval.1.mulVec (ket β) = ket β := by
  rw [chIf, dite_neg_sub hcq]
  exact chCircuit_mulVec_ket_ctrl_zero c q hcq β hc0

theorem chIf_mulVec_ket_one {N : ℕ} (c q : Wire N) (hcq : c ≠ q)
    (β : BitAssignment N) (hc1 : β c = 1) :
    (chIf c q).eval.1.mulVec (ket β) = (Circuit.H q).eval.1.mulVec (ket β) := by
  rw [chIf, dite_neg_sub hcq]
  exact chCircuit_mulVec_ket_ctrl_one c q hcq β hc1


theorem unHadamardList_mulVec_ket_zero {N : ℕ} (c : Wire N) (qs : List (Wire N))
    (hdisj : ∀ q ∈ qs, c ≠ q) (β : BitAssignment N) (hc0 : β c = 0) :
    (unHadamardList c qs).eval.1.mulVec (ket β) = ket β :=
  PosPostPrep80FastSubblocks.unHadamardList_mulVec_ket_zero (N :=
      N) c qs hdisj β hc0

