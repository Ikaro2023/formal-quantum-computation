theorem hmPre_check {mClean : ℕ} (hm : mClean < 8192) :
    let sb := mClean ^^^ (mClean &&& 1023)
    mClean &&& preMask76 = (mClean &&& 1023) ∧
    mClean &&& preMask67_cert = (mClean &&& 1023) ∧
    (sb &&& maskC0_76 = (if mClean.testBit 10 then 1 else 0) * 2 ^ 10) ∧
    (sb &&& maskC1_76 = (if mClean.testBit 11 then 1 else 0) * 2 ^ 11) ∧
    (sb &&& maskC2_76 = (if mClean.testBit 12 then 1 else 0) * 2 ^ 12) ∧
    (sb &&& maskC0_67_cert = (if mClean.testBit 10 then 1 else 0) * 2 ^ 10) ∧
    (sb &&& maskC1_67_cert = (if mClean.testBit 11 then 1 else 0) * 2 ^ 11) ∧
    (sb &&& maskC2_67_cert = (if mClean.testBit 12 then 1 else 0) * 2 ^ 12) := by
  have hx : checkHmPreOne mClean = true := by
    by_cases h1 : mClean < 1024
    · exact checkNatRange_true 1024 0 mClean checkHmPre_chunk0 (Nat.zero_le _) (by omega)
    · by_cases h2 : mClean < 2048
      · exact checkNatRange_true 1024 1024 mClean checkHmPre_chunk1 (by omega) (by omega)
      · by_cases h3 : mClean < 3072
        · exact checkNatRange_true 1024 2048 mClean checkHmPre_chunk2 (by omega) (by omega)
        · by_cases h4 : mClean < 4096
          · exact checkNatRange_true 1024 3072 mClean checkHmPre_chunk3 (by omega) (by omega)
          · by_cases h5 : mClean < 5120
            · exact checkNatRange_true 1024 4096 mClean checkHmPre_chunk4 (by omega) (by omega)
            · by_cases h6 : mClean < 6144
              · exact checkNatRange_true 1024 5120 mClean checkHmPre_chunk5 (by omega) (by omega)
              · by_cases h7 : mClean < 7168
                · exact checkNatRange_true 1024 6144 mClean checkHmPre_chunk6 (by omega) (by omega)
                · exact checkNatRange_true 1024 7168 mClean checkHmPre_chunk7 (by omega) (by omega)
  simp only [checkHmPreOne, Bool.and_eq_true, beq_iff_eq] at hx
  rcases hx with ⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩
  exact ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩


theorem stageC_fin_checks :
    (∀ (c : Fin 6) (neg : Fin 2),
      let r0 := ax0RawDelta76 c.val neg.val
      let d0 := signedCoord128 c.val (neg.val == 1)
      let Δ0 := axisDeltaNat 0 d0
      r0 &&& maskC1_76 = 0 ∧ r0 &&& maskC2_76 = 0 ∧
      r0 < 2 ^ 37 ∧ r0 &&& 8191 = 0 ∧
      runMask76 fanFlat76.reverse r0 = Δ0 ∧
      Δ0 &&& maskC1_67_cert = 0 ∧ Δ0 &&& maskC2_67_cert = 0 ∧
      Δ0 < 2 ^ 37 ∧ Δ0 &&& 8191 = 0 ∧
      runMask67 stageCAxis0_67 ((neg.val * 2 ^ 10) ^^^ (c.val * 2 ^ 37)) =
        ((neg.val * 2 ^ 10) ^^^ (c.val * 2 ^ 37)) ^^^ Δ0) ∧
    (∀ (c : Fin 6) (neg : Fin 2),
      let r1 := ax1RawDelta76 c.val neg.val
      let d1 := signedCoord128 c.val (neg.val == 1)
      let Δ1 := axisDeltaNat 1 d1
      r1 &&& maskC2_76 = 0 ∧ r1 < 2 ^ 37 ∧ r1 &&& 8191 = 0 ∧
      runMask76 fanFlat76.reverse r1 = Δ1 ∧
      Δ1 &&& maskC2_67_cert = 0 ∧ Δ1 < 2 ^ 37 ∧ Δ1 &&& 8191 = 0 ∧
      runMask67 stageCAxis1_67 ((neg.val * 2 ^ 11) ^^^ (c.val * 2 ^ 40)) =
        ((neg.val * 2 ^ 11) ^^^ (c.val * 2 ^ 40)) ^^^ Δ1) ∧
    (∀ (c : Fin 6) (neg : Fin 2),
      let r2 := ax2RawDelta76 c.val neg.val
      let d2 := signedCoord128 c.val (neg.val == 1)
      let Δ2 := axisDeltaNat 2 d2
      r2 < 2 ^ 37 ∧ r2 &&& 8191 = 0 ∧
      runMask76 fanFlat76.reverse r2 = Δ2 ∧
      Δ2 < 2 ^ 37 ∧ Δ2 &&& 8191 = 0 ∧
      runMask67 stageCAxis2_67 ((neg.val * 2 ^ 12) ^^^ (c.val * 2 ^ 43)) =
        ((neg.val * 2 ^ 12) ^^^ (c.val * 2 ^ 43)) ^^^ Δ2) := by
  decide +kernel


private theorem out24_testBit_of_bounds {r : ℕ} (hlt : r < 2 ^ 37) (hlo : r &&& 8191 = 0)
    (i : ℕ) (hi : isOut24Idx i = false) : r.testBit i = false := by
  by_cases hi13 : i < 13
  · have h8191 : (8191 : ℕ).testBit i = true :=
      (by decide : ∀ j : Fin 13, (8191 : ℕ).testBit j.val = true) ⟨i, hi13⟩
    have hz : (r &&& 8191).testBit i = false := by rw [hlo]; exact Nat.zero_testBit i
    rw [Nat.testBit_and, h8191, Bool.and_true] at hz
    exact hz
  · have hge37 : 37 ≤ i := by
      dsimp [isOut24Idx] at hi; rw [decide_eq_false_iff_not] at hi; omega
    exact Nat.testBit_lt_two_pow (lt_of_lt_of_le hlt (Nat.pow_le_pow_right (by decide) hge37))


theorem static_gate_flags_cert :
    fanFlat76.all RevGate76.cnotOnlyGe13 = true ∧
    fanFlat76.reverse.all RevGate76.cnotOnlyGe13 = true ∧
    fanFlat76.reverse.all RevGate76.cnotOnly = true ∧
    preFlat76.all RevGate76.wf = true ∧
    preFlat76.reverse.all RevGate76.noOut24Ctrl = true ∧
    preFlat76.all (RevGate76.inMask preMask76) = true ∧
    ax0Flat76.all (RevGate76.inMask maskC0_76) = true ∧
    ax1Flat76.all (RevGate76.inMask maskC1_76) = true ∧
    ax2Flat76.all (RevGate76.inMask maskC2_76) = true ∧
    preGates67.all RevGate67.wf = true ∧
    preGates67.reverse.all RevGate67.noOut24Ctrl = true ∧
    preGates67.all (RevGate67.inMask preMask67_cert) = true ∧
    stageCAxis0_67.all (RevGate67.inMask maskC0_67_cert) = true ∧
    stageCAxis1_67.all (RevGate67.inMask maskC1_67_cert) = true ∧
    stageCAxis2_67.all (RevGate67.inMask maskC2_67_cert) = true ∧
    fullGates67.all RevGate67.wf = true := by
  decide +kernel


theorem runMask76_eq_runMask67_of_lt8192 {mClean : ℕ} (hm : mClean < 8192) :
    runMask76 (flatten76 revHeadCoord76) mClean = runMask67 fullGates67 mClean ∧
    runMask67 fullGates67 mClean < 2 ^ 37 := by
  rcases static_gate_flags_cert with
    ⟨hFanId, hFanRevId, hFanRevCnot, hPre76Wf, hPre76RevNo, hPre76In,
     hAx0In76, hAx1In76, hAx2In76,
     hPre67Wf, hPre67RevNo, hPre67In, hAx0In67, hAx1In67, hAx2In67, _⟩
  obtain ⟨hSC0, hSC1, hSC2⟩ := stageC_fin_checks
  let x10 : Fin 1024 := ⟨mClean &&& 1023, Nat.lt_succ_of_le Nat.and_le_right⟩
  have hmPre : mClean &&& preMask76 = x10.val ∧ mClean &&& preMask67_cert = x10.val ∧
      ((mClean ^^^ x10.val) &&& maskC0_76 = (if mClean.testBit 10 then 1 else 0) * 2 ^ 10) ∧
      ((mClean ^^^ x10.val) &&& maskC1_76 = (if mClean.testBit 11 then 1 else 0) * 2 ^ 11) ∧
      ((mClean ^^^ x10.val) &&& maskC2_76 = (if mClean.testBit 12 then 1 else 0) * 2 ^ 12) ∧
      ((mClean ^^^ x10.val) &&& maskC0_67_cert = (if mClean.testBit 10 then 1 else 0) * 2 ^ 10) ∧
      ((mClean ^^^ x10.val) &&& maskC1_67_cert = (if mClean.testBit 11 then 1 else 0) * 2 ^ 11) ∧
      ((mClean ^^^ x10.val) &&& maskC2_67_cert = (if mClean.testBit 12 then 1 else 0) * 2 ^ 12) :=
    hmPre_check hm
  rcases hmPre with ⟨hmPre76, hmPre67, hsb0_76, hsb1_76, hsb2_76, hsb0_67, hsb1_67, hsb2_67⟩
  obtain ⟨hy0_76, hy1_76, hy2_76, hy0_67, hy1_67, hy2_67, hc0_lt, hc1_lt, hc2_lt⟩ :=
    pre_masks_and_cAxis10_check x10
  let neg0 : Fin 2 := ⟨if mClean.testBit 10 then 1 else 0, by split_ifs <;> decide⟩
  let neg1 : Fin 2 := ⟨if mClean.testBit 11 then 1 else 0, by split_ifs <;> decide⟩
  let neg2 : Fin 2 := ⟨if mClean.testBit 12 then 1 else 0, by split_ifs <;> decide⟩
  let c0 : Fin 6 := ⟨cAxis10 x10.val 0, hc0_lt⟩
  let c1 : Fin 6 := ⟨cAxis10 x10.val 1, hc1_lt⟩
  let c2 : Fin 6 := ⟨cAxis10 x10.val 2, hc2_lt⟩
  -- Stage-1 76-wire mask decomposition.
  let m1_76 := runMask76 preFlat76 mClean
  have hm1_76_eq : m1_76 = (mClean ^^^ x10.val) ^^^ runMask76 preFlat76 x10.val := by
    dsimp [m1_76]; rw [runMask76_decomp_inMask hPre76In mClean, hmPre76]
  have hm1_C0_76 : m1_76 &&& maskC0_76 = (neg0.val * 2 ^ 10) ^^^ (c0.val * 2 ^ 42) := by
    rw [hm1_76_eq, nat_and_xor_distrib_right76, hsb0_76, hy0_76]
  have hm1_C1_76 : m1_76 &&& maskC1_76 = (neg1.val * 2 ^ 11) ^^^ (c1.val * 2 ^ 45) := by
    rw [hm1_76_eq, nat_and_xor_distrib_right76, hsb1_76, hy1_76]
  have hm1_C2_76 : m1_76 &&& maskC2_76 = (neg2.val * 2 ^ 12) ^^^ (c2.val * 2 ^ 48) := by
    rw [hm1_76_eq, nat_and_xor_distrib_right76, hsb2_76, hy2_76]
  let r0 := ax0RawDelta76 c0.val neg0.val
  let r1 := ax1RawDelta76 c1.val neg1.val
  let r2 := ax2RawDelta76 c2.val neg2.val
  let Δ0 := axisDeltaNat 0 (signedCoord128 c0.val (neg0.val == 1))
  let Δ1 := axisDeltaNat 1 (signedCoord128 c1.val (neg1.val == 1))
  let Δ2 := axisDeltaNat 2 (signedCoord128 c2.val (neg2.val == 1))
  obtain ⟨hr0_C1, hr0_C2, hr0_lt, hr0_lo, hr0_fan, hΔ0_C1, hΔ0_C2, hΔ0_lt, hΔ0_lo, h67_0⟩ :=
    hSC0 c0 neg0
  obtain ⟨hr1_C2, hr1_lt, hr1_lo, hr1_fan, hΔ1_C2, hΔ1_lt, hΔ1_lo, h67_1⟩ := hSC1 c1 neg1
  obtain ⟨hr2_lt, hr2_lo, hr2_fan, hΔ2_lt, hΔ2_lo, h67_2⟩ := hSC2 c2 neg2
  have h76_0 : runMask76 ax0Flat76 m1_76 = m1_76 ^^^ r0 := by
    rw [runMask76_decomp_inMask hAx0In76 m1_76,
      nat_xor_raw_delta76 (runMask76 ax0Flat76 (m1_76 &&& maskC0_76)) (m1_76 &&& maskC0_76),
      nat_xor_decomp_cancel76, hm1_C0_76]; rfl
  have h76_1 : runMask76 ax1Flat76 (m1_76 ^^^ r0) = (m1_76 ^^^ r0) ^^^ r1 := by
    have hM : (m1_76 ^^^ r0) &&& maskC1_76 = (neg1.val * 2 ^ 11) ^^^ (c1.val * 2 ^ 45) := by
      rw [nat_and_xor_of_disjoint76 hr0_C1, hm1_C1_76]
    rw [runMask76_decomp_inMask hAx1In76 (m1_76 ^^^ r0),
      nat_xor_raw_delta76 (runMask76 ax1Flat76 ((m1_76 ^^^ r0) &&& maskC1_76))
        ((m1_76 ^^^ r0) &&& maskC1_76),
      nat_xor_decomp_cancel76, hM]; rfl
  have h76_2 : runMask76 ax2Flat76 ((m1_76 ^^^ r0) ^^^ r1) = ((m1_76 ^^^ r0) ^^^ r1) ^^^ r2 := by
    have hM : ((m1_76 ^^^ r0) ^^^ r1) &&& maskC2_76 = (neg2.val * 2 ^ 12) ^^^ (c2.val * 2 ^ 48) :=
      by
      rw [nat_and_xor_of_disjoint76 hr1_C2, nat_and_xor_of_disjoint76 hr0_C2, hm1_C2_76]
    rw [runMask76_decomp_inMask hAx2In76 ((m1_76 ^^^ r0) ^^^ r1),
      nat_xor_raw_delta76 (runMask76 ax2Flat76 (((m1_76 ^^^ r0) ^^^ r1) &&& maskC2_76))
        (((m1_76 ^^^ r0) ^^^ r1) &&& maskC2_76),
      nat_xor_decomp_cancel76, hM]; rfl
  let rAll := (r0 ^^^ r1) ^^^ r2
  have hrAll_out : ∀ i, isOut24Idx i = false → rAll.testBit i = false := by
    intro i hi
    rw [show rAll = (r0 ^^^ r1) ^^^ r2 from rfl, Nat.testBit_xor, Nat.testBit_xor,
      out24_testBit_of_bounds hr0_lt hr0_lo i hi,
      out24_testBit_of_bounds hr1_lt hr1_lo i hi,
      out24_testBit_of_bounds hr2_lt hr2_lo i hi]
    rfl
  have h76_full : runMask76 (flatten76 revHeadCoord76) mClean = mClean ^^^ ((Δ0 ^^^ Δ1) ^^^ Δ2) :=
    by
    rw [flatten76_revHeadCoord76_eq, runMask76_append, runMask76_append,
      runMask76_id_of_lt8192 hFanId hm, runMask76_append, runMask76_append,
      show runMask76 preFlat76 mClean = m1_76 from rfl,
      runMask76_append, runMask76_append, h76_0, h76_1, h76_2,
      nat_xor_assoc76 m1_76 r0 r1, nat_xor_assoc76 m1_76 (r0 ^^^ r1) r2,
      runMask76_xor_out24 hPre76RevNo m1_76 rAll hrAll_out,
      runMask76_reverse hPre76Wf mClean,
      runMask76_cnotOnly_xor hFanRevCnot mClean rAll,
      runMask76_id_of_lt8192 hFanRevId hm,
      runMask76_cnotOnly_xor hFanRevCnot (r0 ^^^ r1) r2,
      runMask76_cnotOnly_xor hFanRevCnot r0 r1,
      hr0_fan, hr1_fan, hr2_fan]
  -- Stage-1 67-wire mask decomposition.
  let m1_67 := runMask67 preGates67 mClean
  have hm1_67_eq : m1_67 = (mClean ^^^ x10.val) ^^^ runMask67 preGates67 x10.val := by
    dsimp [m1_67]; rw [runMask67_decomp_inMask_cert hPre67In mClean, hmPre67]
  have hm1_C0_67 : m1_67 &&& maskC0_67_cert = (neg0.val * 2 ^ 10) ^^^ (c0.val * 2 ^ 37) := by
    rw [hm1_67_eq, nat_and_xor_distrib_right76, hsb0_67, hy0_67]
  have hm1_C1_67 : m1_67 &&& maskC1_67_cert = (neg1.val * 2 ^ 11) ^^^ (c1.val * 2 ^ 40) := by
    rw [hm1_67_eq, nat_and_xor_distrib_right76, hsb1_67, hy1_67]
  have hm1_C2_67 : m1_67 &&& maskC2_67_cert = (neg2.val * 2 ^ 12) ^^^ (c2.val * 2 ^ 43) := by
    rw [hm1_67_eq, nat_and_xor_distrib_right76, hsb2_67, hy2_67]
  have hStageC0 : runMask67 stageCAxis0_67 m1_67 = m1_67 ^^^ Δ0 := by
    rw [runMask67_decomp_inMask_cert hAx0In67 m1_67, hm1_C0_67, h67_0, nat_xor_decomp_cancel76]
  have hStageC1 : runMask67 stageCAxis1_67 (m1_67 ^^^ Δ0) = (m1_67 ^^^ Δ0) ^^^ Δ1 := by
    have hM : (m1_67 ^^^ Δ0) &&& maskC1_67_cert = (neg1.val * 2 ^ 11) ^^^ (c1.val * 2 ^ 40) := by
      rw [nat_and_xor_of_disjoint76 hΔ0_C1, hm1_C1_67]
    rw [runMask67_decomp_inMask_cert hAx1In67 (m1_67 ^^^ Δ0), hM, h67_1, nat_xor_decomp_cancel76]
  have hStageC2 : runMask67 stageCAxis2_67 ((m1_67 ^^^ Δ0) ^^^ Δ1) =
      ((m1_67 ^^^ Δ0) ^^^ Δ1) ^^^ Δ2 := by
    have hM : ((m1_67 ^^^ Δ0) ^^^ Δ1) &&& maskC2_67_cert =
        (neg2.val * 2 ^ 12) ^^^ (c2.val * 2 ^ 43) := by
      rw [nat_and_xor_of_disjoint76 hΔ1_C2, nat_and_xor_of_disjoint76 hΔ0_C2, hm1_C2_67]
    rw [runMask67_decomp_inMask_cert hAx2In67 ((m1_67 ^^^ Δ0) ^^^ Δ1), hM, h67_2,
      nat_xor_decomp_cancel76]
  let Δ := (Δ0 ^^^ Δ1) ^^^ Δ2
  have hΔ_out : ∀ i, isOut24Idx i = false → Δ.testBit i = false := by
    intro i hi
    rw [show Δ = (Δ0 ^^^ Δ1) ^^^ Δ2 from rfl, Nat.testBit_xor, Nat.testBit_xor,
      out24_testBit_of_bounds hΔ0_lt hΔ0_lo i hi,
      out24_testBit_of_bounds hΔ1_lt hΔ1_lo i hi,
      out24_testBit_of_bounds hΔ2_lt hΔ2_lo i hi]
    rfl
  have h67_full : runMask67 fullGates67 mClean = mClean ^^^ Δ := by
    dsimp only [fullGates67, stageCGates67]
    rw [List.append_assoc, runMask67_append_cert, show runMask67 preGates67 mClean = m1_67 from rfl,
      runMask67_append_cert, List.append_assoc, runMask67_append_cert, hStageC0,
      runMask67_append_cert, hStageC1, hStageC2,
      nat_xor_assoc76 m1_67 Δ0 Δ1, nat_xor_assoc76 m1_67 (Δ0 ^^^ Δ1) Δ2,
      runMask67_xor_out24_cert hPre67RevNo m1_67 Δ hΔ_out,
      runMask67_reverse_cert hPre67Wf mClean]
  have hlt37 : mClean ^^^ Δ < 2 ^ 37 :=
    xor_lt_two_pow_cert (lt_trans hm (by decide))
      (xor_lt_two_pow_cert (xor_lt_two_pow_cert hΔ0_lt hΔ1_lt) hΔ2_lt)
  exact ⟨by rw [h76_full, h67_full], by rw [h67_full]; exact hlt37⟩


private theorem unpackMask67_xor_two_pow_cert (m : ℕ) (t : Fin 67) :
    unpackMask67 (m ^^^ (2 ^ t.val)) =
      Function.update (unpackMask67 m) t (unpackMask67 m t + 1) := by
  funext q
  by_cases hqt : q = t
  · subst hqt
    rw [Function.update_self]
    dsimp only [unpackMask67]
    rw [Nat.testBit_xor, Nat.testBit_two_pow, decide_eq_true rfl]
    cases m.testBit q.val <;> decide
  · rw [Function.update_of_ne hqt]
    have hne : t.val ≠ q.val := fun h ↦ hqt (Fin.ext h.symm)
    dsimp only [unpackMask67]
    rw [Nat.testBit_xor, Nat.testBit_two_pow, decide_eq_false hne]
    cases m.testBit q.val <;> rfl


theorem evolve_compileRev67_unpackMask67_cert :
    ∀ {gs : List RevGate67}, gs.all RevGate67.wf = true → ∀ (m : ℕ),
      (compileRev67 gs).eval.1.mulVec (ket (unpackMask67 m)) =
        ket (unpackMask67 (runMask67 gs m))
  | [], _, m => by
      rw [compileRev67, Circuit.eval_identity, OneMemClass.coe_one, Matrix.one_mulVec, runMask67]
  | g :: gs, hw, m => by
      simp only [List.all_cons, Bool.and_eq_true] at hw
      have hg : g.toCircuit.eval.1.mulVec (ket (unpackMask67 m)) =
          ket (unpackMask67 (stepMask67 g m)) := by
        cases g with
        | x t =>
            dsimp only [RevGate67.toCircuit, stepMask67]
            rw [ket_X, unpackMask67_xor_two_pow_cert]
        | cnot c t =>
            have hct : c ≠ t := by simpa [RevGate67.wf, bne_iff_ne] using hw.1
            have htc : (RevGate67.cnot c t).toCircuit = Circuit.CNOT c t hct := dite_eq_left hct
            rw [htc, ket_CNOT]
            dsimp only [stepMask67]
            change ket (Function.update (unpackMask67 m) t
              (unpackMask67 m t + (if m.testBit c.val then 1 else 0))) = _
            cases m.testBit c.val
            · simp only [Bool.false_eq_true, ↓reduceIte, add_zero, Function.update_eq_self]
            · simp only [↓reduceIte, unpackMask67_xor_two_pow_cert]
        | toff c1 c2 t =>
            have hwf := hw.1
            simp only [RevGate67.wf, Bool.and_eq_true, bne_iff_ne] at hwf
            have htt : (RevGate67.toff c1 c2 t).toCircuit =
                Circuit.TOFF c1 c2 t hwf.1.1 hwf.1.2 hwf.2 := by
              dsimp only [RevGate67.toCircuit]
              rw [dite_eq_left hwf.1.1, dite_eq_left hwf.1.2, dite_eq_left hwf.2]
            rw [htt, ket_TOFF]
            dsimp only [stepMask67]
            change ket (Function.update (unpackMask67 m) t
              (unpackMask67 m t +
                (if m.testBit c1.val then 1 else 0) * (if m.testBit c2.val then 1 else 0))) = _
            cases m.testBit c1.val <;> cases m.testBit c2.val <;>
              simp [unpackMask67_xor_two_pow_cert, Function.update_eq_self]
      rw [compileRev67, eval_seq_mulVec, hg, evolve_compileRev67_unpackMask67_cert hw.2, runMask67]


theorem ket_injective_cert {N : ℕ} {α β : BitAssignment N} (h : ket α = ket β) : α = β := by
  by_contra hne
  have hne_idx : (basisBitsEquiv N).symm α ≠ (basisBitsEquiv N).symm β :=
    (basisBitsEquiv N).symm.injective.ne hne
  have hv := congrFun h ((basisBitsEquiv N).symm α)
  rw [ket_eq_single_local α, ket_eq_single_local β, Pi.single_eq_same,
    Pi.single_eq_of_ne hne_idx] at hv
  exact one_ne_zero hv


theorem head67CleanMap_unpackMask67_of_lt8192 {mClean : ℕ} (hm : mClean < 8192) :
    head67CleanMap (unpackMask67 mClean) = unpackMask67 (runMask67 fullGates67 mClean) := by
  have hClean67 : ∀ j : Fin 30, unpackMask67 mClean ⟨37 + j.val, by omega⟩ = 0 := by
    intro j
    dsimp [unpackMask67]
    have hf : mClean.testBit (37 + j.val) = false :=
      Nat.testBit_lt_two_pow (lt_of_lt_of_le (by exact hm : mClean < 2 ^ 13)
        (Nat.pow_le_pow_right (by decide) (by omega)))
    rw [hf]; rfl
  have h1 := evolve_headCoordXorLocal67_of_clean (unpackMask67 mClean) hClean67
  change headCoordXorLocal67.eval.1.mulVec (ket (unpackMask67 mClean)) =
    ket (head67CleanMap (unpackMask67 mClean)) at h1
  have hdef : headCoordXorLocal67 = compileRev67 fullGates67 := by
    unfold headCoordXorLocal67; rfl
  have hwf67 := static_gate_flags_cert.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2
  rw [hdef,
    evolve_compileRev67_unpackMask67_cert hwf67] at h1
  exact (ket_injective_cert h1).symm


theorem pack13Aux_testBit (γ : BitAssignment 76) :
    ∀ (k : ℕ) (hk : k ≤ 13) (i : ℕ),
      (pack13Aux γ k hk).testBit i =
        if hlt : i < k then decide (γ ⟨i, by omega⟩ = 1) else false
  | 0, _, _ => by simp [pack13Aux]
  | k' + 1, hk, i => by
      dsimp [pack13Aux]
      rw [Nat.testBit_xor, pack13Aux_testBit γ k' (Nat.le_of_succ_le hk) i]
      by_cases hik : i < k'
      · have hik1 : i < k' + 1 := by omega
        have hne : k' ≠ i := by omega
        simp only [hik, hik1, ↓reduceDIte]
        by_cases hb : γ ⟨k', by omega⟩ = 1
        · simp only [hb, ↓reduceIte, Nat.testBit_two_pow, decide_eq_false hne]
          cases decide (γ ⟨i, by omega⟩ = 1) <;> rfl
        · simp only [hb, ↓reduceIte, Nat.zero_testBit]
          cases decide (γ ⟨i, by omega⟩ = 1) <;> rfl
      · by_cases hieq : i = k'
        · subst hieq
          have hnot : ¬(i < i) := Nat.lt_irrefl i
          have hlt1 : i < i + 1 := Nat.lt_succ_self i
          simp only [hnot, hlt1, ↓reduceDIte]
          by_cases hb : γ ⟨i, by omega⟩ = 1 <;> simp [hb]
        · have hnot1 : ¬(i < k' + 1) := by omega
          have hne : k' ≠ i := by omega
          simp only [hik, hnot1, ↓reduceDIte]
          by_cases hb : γ ⟨k', by omega⟩ = 1 <;>
            simp [hb, Nat.testBit_two_pow, decide_eq_false hne]


private theorem pack13Aux_lt (γ : BitAssignment 76) :
    ∀ (k : ℕ) (hk : k ≤ 13), pack13Aux γ k hk < 2 ^ k
  | 0, _ => by simp [pack13Aux]
  | k' + 1, hk => by
      dsimp [pack13Aux]
      have h1 : pack13Aux γ k' (Nat.le_of_succ_le hk) < 2 ^ (k' + 1) :=
        lt_of_lt_of_le (pack13Aux_lt γ k' (Nat.le_of_succ_le hk))
          (Nat.pow_le_pow_right (by decide) (Nat.le_succ k'))
      have h2 : (if γ ⟨k', by omega⟩ = 1 then 2 ^ k' else 0) < 2 ^ (k' + 1) := by
        split_ifs
        · exact Nat.pow_lt_pow_right (by decide) (Nat.lt_succ_self k')
        · exact Nat.two_pow_pos (k' + 1)
      exact xor_lt_two_pow_cert h1 h2


theorem pack13Mask_lt_8192 (γ : BitAssignment 76) : pack13Mask γ < 8192 :=
  pack13Aux_lt γ 13 le_rfl


theorem unpackMask76_pack13Mask_of_lt13 (γ : BitAssignment 76) {i : ℕ} (hi : i < 13) :
    unpackMask76 (pack13Mask γ) ⟨i, by omega⟩ = γ ⟨i, by omega⟩ := by
  dsimp [unpackMask76, pack13Mask]
