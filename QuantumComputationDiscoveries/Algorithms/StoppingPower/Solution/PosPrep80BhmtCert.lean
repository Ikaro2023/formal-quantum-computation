theorem normOfRaw_projBhmt (s0 : Bool) (p : BitAssignment 80) :
    normOfRaw true s0 (projBhmt s0 p) =
      if posPostQOf s0 p 30 == 1 then
        if s0 then p80ClearRange 6 2 (posPostQOf s0 p)
        else p80ClearRange 14 7 (posPostQOf s0 p)
      else clrPid12_80 (posPostQOf s0 p) := by
  rw [posPostQOf_at30_Bhmt s0 p]
  cases s0
  · have hqDef : posPostQOf false p = normOfRaw true false p := posPostQOf_eq_normOfRaw_s3 false p
    rw [hqDef]
    unfold projBhmt
    simp only [Bool.false_eq_true, ↓reduceIte]
    by_cases hp30 : (p 30 == 1) = true
    · simp only [hp30, ↓reduceIte]
      have hBase : normOfRaw true false p = p80ClearB0Local p := by
        unfold normOfRaw flipTailDpScratch80
        have hc30 : (p80ClearB0Local p 30 == 1) = true := hp30
        simp [hc30]
      have hRng : flipTailDpScratch80 (p80ClearRange 14 7 (p80ClearB0Local p)) =
          p80ClearRange 14 7 (p80ClearB0Local p) := by
        unfold flipTailDpScratch80
        have hr30 : (p80ClearRange 14 7 (p80ClearB0Local p) 30 == 1) = true := hp30
        simp [hr30]
      rw [hBase]
      split_ifs
      · unfold normOfRaw
        simp only [Bool.not_false, ↓reduceIte, p80ClearB0Local_clearRange14_Bhmt, hRng]
      · unfold normOfRaw
        simp only [Bool.not_false, ↓reduceIte, p80ClearB0Local_idem_Bhmt,
          p80ClearB0Local_clearRange14_Bhmt, hRng]
    · simp only [hp30, Bool.false_eq_true, ↓reduceIte]
      split_ifs
      · exact normOfRaw_clrPid12 false p
      · have hidem : normOfRaw true false (p80ClearB0Local (clrPid12_80 p)) =
            normOfRaw true false (clrPid12_80 p) := by
          unfold normOfRaw
          simp only [Bool.not_false, ↓reduceIte, p80ClearB0Local_idem_Bhmt]
        rw [hidem]
        exact normOfRaw_clrPid12 false p
  · rw [posPostQOf_eq_normOfRaw_s3 true p]
    unfold projBhmt normOfRaw
    simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]


