theorem openCore128_upd {w : Wire 128}
    (hw : w = wEnHead_128 ∨ w = wEnTail_128 ∨ w = wEnAnc_128 ∨ w = wEnS0Tail_128)
    (β : BitAssignment 128) (b : ZMod 2) (h : openCore128 β) :
    openCore128 (Function.update β w b) := by
  have hne : ∀ u : Wire 128,
      (u.val < 3 ∨ (86 ≤ u.val ∧ u.val < 119) ∨ u.val = 121 ∨ 124 ≤ u.val) → u ≠ w := by
    intro u hu heq
    subst heq
    rcases hw with rfl | rfl | rfl | rfl <;>
      dsimp [wEnHead_128, wEnTail_128, wEnAnc_128, wEnS0Tail_128] at hu <;> omega
  rcases h with ⟨h1, h2, h3, hs, h4, h5, h6, h7, h8⟩
  refine ⟨?_, ?_, ?_, fun j ↦ ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [Function.update_of_ne (hne _ (by right; left; decide)),
      Function.update_of_ne (hne _ (by left; decide)),
      Function.update_of_ne (hne _ (by left; decide)), h1]
  · rw [Function.update_of_ne (hne _ (by right; left; decide)),
      Function.update_of_ne (hne _ (by right; left; decide)),
      Function.update_of_ne (hne _ (by left; decide)), h2]
  · rw [Function.update_of_ne (hne _ (by right; left; decide)),
      Function.update_of_ne (hne _ (by right; left; decide)),
      Function.update_of_ne (hne _ (by right; left; decide)), h3]
  · rw [Function.update_of_ne (hne _ (by right; left; rw [scr30_128_val_cert]; omega)), hs j]
  · rwa [Function.update_of_ne (hne _ (by right; right; left; decide))]
  all_goals
    rwa [Function.update_of_ne (hne _ (by right; right; right; decide))]


theorem openInv128_iff_core (β : BitAssignment 128) :
    OpenInv128 β ↔
      openCore128 β ∧ β wEnHead_128 = 0 ∧ β wEnTail_128 = 0 ∧
        β wEnAnc_128 = 0 ∧ β wEnS0Tail_128 = 0 := by
  unfold OpenInv128 openCore128; tauto


theorem flagsInv128_iff_core (β : BitAssignment 128) :
    FlagsInv128 β ↔
      openCore128 β ∧ β wEnHead_128 = β wEnPos_128 * β wIsHead_128 ∧
        β wEnTail_128 = β wEnPos_128 + β wEnHead_128 ∧
        β wEnS0Tail_128 = β wEnS0_128 * β wEnTail_128 ∧
        β wEnAnc_128 = β wEnPos_128 + β wEnC0_128 * β wIsHead_128 := by
  unfold FlagsInv128 openCore128; tauto


theorem flags2_anc_zmod2_id (e coin0 h : ZMod 2) :
    let s := e * coin0
    let c := e + s
    let wh := e * h
    let wt := e + wh
    let wst := s * wt
    wt + s + wst = e + c * h := by
  rcases bit_cases e with rfl | rfl <;>
    rcases bit_cases coin0 with rfl | rfl <;>
    rcases bit_cases h with rfl | rfl <;> decide


theorem ket_cFlags2AncFast_on_FlInv3 (α : BitAssignment 128) (hα : FlInv3 α) :
    cFlags2AncFast_128.eval.1.mulVec (ket α) =
      ket (Function.update α wEnAnc_128 (α wEnPos_128 + α wEnC0_128 * α wIsHead_128)) := by
  rcases hα with ⟨⟨_, hs, hc, _, _, _, _, _, _⟩, hwh, hwt, hwst, hanc0⟩
  have hid := flags2_anc_zmod2_id (α wEnPos_128) (α wCoin0_128) (α wIsHead_128)
  dsimp only at hid
  rw [← hs, ← hc, ← hwh, ← hwt, ← hwst] at hid
  rw [cFlags2AncFast_128, eval_seq_mulVec, eval_seq_mulVec,
    ket_cnotIf_ne _ _ (by decide), ket_cnotIf_ne _ _ (by decide), ket_cnotIf_ne _ _ (by decide)]
  congr 1; funext w
  by_cases hwa : w = wEnAnc_128
  · subst hwa
    simp only [Function.update_self, hanc0, zero_add,
      Function.update_of_ne (by decide : wEnS0_128 ≠ wEnAnc_128),
      Function.update_of_ne (by decide : wEnS0Tail_128 ≠ wEnAnc_128)]
    exact hid
  · simp [Function.update_of_ne hwa]


theorem ket_cFlags2AncFast_inv_on_FlagsInv (δ : BitAssignment 128) (hδ : FlagsInv128 δ) :
    cFlags2AncFast_128.inverse.eval.1.mulVec (ket δ) =
      ket (Function.update δ wEnAnc_128 0) := by
  rcases (flagsInv128_iff_core δ).mp hδ with
    ⟨⟨_, hs, hc, _, _, _, _, _, _⟩, hwh, hwt, hwst, hanc⟩
  have hid := flags2_anc_zmod2_id (δ wEnPos_128) (δ wCoin0_128) (δ wIsHead_128)
  dsimp only at hid
  rw [← hs, ← hc, ← hwh, ← hwt, ← hwst] at hid
  let δ₀ := Function.update δ wEnAnc_128 0
  have hFl3 : FlInv3 δ₀ :=
    ⟨openCore128_upd (Or.inr (Or.inr (Or.inl rfl))) δ 0 ((flagsInv128_iff_core δ).mp hδ).1,
     by simp [δ₀, Function.update_of_ne (by decide : wEnHead_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnPos_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wIsHead_128 ≠ wEnAnc_128), hwh],
     by simp [δ₀, Function.update_of_ne (by decide : wEnTail_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnPos_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnHead_128 ≠ wEnAnc_128), hwt],
     by simp [δ₀, Function.update_of_ne (by decide : wEnS0Tail_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnS0_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnTail_128 ≠ wEnAnc_128), hwst],
     Function.update_self _ 0 δ⟩
  have hFwd := ket_cFlags2AncFast_on_FlInv3 δ₀ hFl3
  have hUpdEq : Function.update δ₀ wEnAnc_128
      (δ₀ wEnPos_128 + δ₀ wEnC0_128 * δ₀ wIsHead_128) = δ := by
    funext w
    by_cases hwa : w = wEnAnc_128
    · subst hwa
      simp [δ₀, Function.update_self,
        Function.update_of_ne (by decide : wEnPos_128 ≠ wEnAnc_128),
        Function.update_of_ne (by decide : wEnC0_128 ≠ wEnAnc_128),
        Function.update_of_ne (by decide : wIsHead_128 ≠ wEnAnc_128), ← hanc]
    · simp [δ₀, Function.update_of_ne hwa]
  rw [hUpdEq] at hFwd
  conv_lhs => rw [← hFwd, ← mul_mulVec_prog, Circuit.eval_inverse]
  have hL : ((cFlags2AncFast_128.eval)⁻¹).1 * cFlags2AncFast_128.eval.1 = 1 :=
    unitary_inv_mul_val_cert cFlags2AncFast_128.eval
  rw [hL, Matrix.one_mulVec]


theorem ket_cFlags2AncOrig_on_FlInv3 (α : BitAssignment 128) (hα : FlInv3 α) :
    cFlags2AncOrig_128.eval.1.mulVec (ket α) =
      ket (Function.update α wEnAnc_128 (α wEnPos_128 + α wEnC0_128 * α wIsHead_128)) := by
  have hc0h : α wEnC0Head_128 = 0 := hα.1.2.2.2.2.1
  have hanc0 : α wEnAnc_128 = 0 := hα.2.2.2.2
  rw [cFlags2AncOrig_128, eval_seq_mulVec, eval_seq_mulVec, eval_seq_mulVec,
    ket_andComputeIf_of_zero_cert _ _ _ (by decide) (by decide) α hc0h,
    ket_cnotIf_ne _ _ (by decide), ket_cnotIf_ne _ _ (by decide)]
  let γ := Function.update
    (Function.update
      (Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128))
      wEnAnc_128
      (Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128) wEnAnc_128 +
        Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128) wEnPos_128))
    wEnAnc_128
    (Function.update
      (Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128))
      wEnAnc_128
      (Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128) wEnAnc_128 +
        Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128) wEnPos_128) wEnAnc_128 +
      Function.update
        (Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128))
        wEnAnc_128
        (Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128) wEnAnc_128 +
          Function.update α wEnC0Head_128 (α wEnC0_128 * α wIsHead_128) wEnPos_128) wEnC0Head_128)
  have hγ_eq : γ wEnC0Head_128 = γ wEnC0_128 * γ wIsHead_128 := by
    simp [γ, Function.update_of_ne (by decide : wEnC0Head_128 ≠ wEnAnc_128),
      Function.update_of_ne (by decide : wEnC0_128 ≠ wEnAnc_128),
      Function.update_of_ne (by decide : wEnC0_128 ≠ wEnC0Head_128),
      Function.update_of_ne (by decide : wIsHead_128 ≠ wEnAnc_128),
      Function.update_of_ne (by decide : wIsHead_128 ≠ wEnC0Head_128)]
  change ((andComputeIf wEnC0_128 wIsHead_128 wEnC0Head_128).inverse.eval.1).mulVec (ket γ) = _
  rw [ket_andComputeIf_inv_of_eq _ _ _ (by decide) (by decide) γ hγ_eq]
  congr 1; funext w
  by_cases hwa : w = wEnAnc_128
  · subst hwa
    simp [γ, hanc0, Function.update_of_ne (by decide : wEnAnc_128 ≠ wEnC0Head_128),
      Function.update_of_ne (by decide : wEnPos_128 ≠ wEnC0Head_128),
      Function.update_of_ne (by decide : wEnC0Head_128 ≠ wEnAnc_128)]
  · by_cases hwc : w = wEnC0Head_128
    · subst hwc
      simp [hc0h, Function.update_of_ne (by decide : wEnC0Head_128 ≠ wEnAnc_128)]
    · simp [γ, Function.update_of_ne hwa, Function.update_of_ne hwc]


theorem ket_cFlags2AncOrig_inv_on_FlagsInv (δ : BitAssignment 128) (hδ : FlagsInv128 δ) :
    cFlags2AncOrig_128.inverse.eval.1.mulVec (ket δ) =
      ket (Function.update δ wEnAnc_128 0) := by
  rcases (flagsInv128_iff_core δ).mp hδ with ⟨hcore, hwh, hwt, hwst, hanc⟩
  let δ₀ := Function.update δ wEnAnc_128 0
  have hFl3 : FlInv3 δ₀ :=
    ⟨openCore128_upd (Or.inr (Or.inr (Or.inl rfl))) δ 0 hcore,
     by simp [δ₀, Function.update_of_ne (by decide : wEnHead_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnPos_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wIsHead_128 ≠ wEnAnc_128), hwh],
     by simp [δ₀, Function.update_of_ne (by decide : wEnTail_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnPos_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnHead_128 ≠ wEnAnc_128), hwt],
     by simp [δ₀, Function.update_of_ne (by decide : wEnS0Tail_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnS0_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnTail_128 ≠ wEnAnc_128), hwst],
     Function.update_self _ 0 δ⟩
  have hFwd := ket_cFlags2AncOrig_on_FlInv3 δ₀ hFl3
  have hUpdEq : Function.update δ₀ wEnAnc_128
      (δ₀ wEnPos_128 + δ₀ wEnC0_128 * δ₀ wIsHead_128) = δ := by
    funext w
    by_cases hwa : w = wEnAnc_128
    · subst hwa
      simp [δ₀, Function.update_self,
        Function.update_of_ne (by decide : wEnPos_128 ≠ wEnAnc_128),
        Function.update_of_ne (by decide : wEnC0_128 ≠ wEnAnc_128),
        Function.update_of_ne (by decide : wIsHead_128 ≠ wEnAnc_128), ← hanc]
    · simp [δ₀, Function.update_of_ne hwa]
  rw [hUpdEq] at hFwd
  conv_lhs => rw [← hFwd, ← mul_mulVec_prog, Circuit.eval_inverse]
  have hL : ((cFlags2AncOrig_128.eval)⁻¹).1 * cFlags2AncOrig_128.eval.1 = 1 :=
    unitary_inv_mul_val_cert cFlags2AncOrig_128.eval
  rw [hL, Matrix.one_mulVec]


theorem upd_comm128 {α : Type*} (f : Wire 128 → α) {w₁ w₂ : Wire 128}
    (hne : w₁ ≠ w₂) (v₁ v₂ : α) :
    Function.update (Function.update f w₁ v₁) w₂ v₂ =
      Function.update (Function.update f w₂ v₂) w₁ v₁ := by
  funext u
  by_cases h₂ : u = w₂
  · subst h₂; simp [Function.update_of_ne hne.symm]
  · by_cases h₁ : u = w₁
    · subst h₁; simp [Function.update_of_ne hne]
    · simp [Function.update_of_ne h₁, Function.update_of_ne h₂]


theorem upd_idem128 {α : Type*} (f : Wire 128 → α) (w : Wire 128) (v₁ v₂ : α) :
    Function.update (Function.update f w v₁) w v₂ = Function.update f w v₂ := by
  funext u
  by_cases h : u = w <;> simp [h]


theorem upd_self128 {α : Type*} (f : Wire 128 → α) (w : Wire 128) {v : α} (hv : f w = v) :
    Function.update f w v = f := by
  funext u
  by_cases h : u = w
  · subst h; simp [hv]
  · simp [Function.update_of_ne h]


theorem count_toff_wrapDyn {Var : Type} {n : ℕ} (p : CleanComputeProg)
    (v : Var) (rFull128 : QRegister 128 n) (body : DynamicCircuit Var n) :
    (p.wrapDyn v rFull128 body).count PrimitiveGate.TOFF = body.count PrimitiveGate.TOFF := by
  induction p generalizing body with
  | id => rfl
  | x q => exact count_toff_mkWithCliffDyn rFull128 (Circuit.X q) rfl body
  | cnot c t => exact count_toff_mkWithCliffDyn rFull128 (cnotIf c t) (count_toff_cnotIf c t) body
  | tempAnd c₁ c₂ anc =>
      dsimp only [CleanComputeProg.wrapDyn]
      split_ifs with h
      · exact count_toff_mkWithTempAndDyn v rFull128 c₁ c₂ anc h.1 h.2.1 h.2.2 body
      · rfl
  | seq p₁ p₂ ih₁ ih₂ =>
      dsimp only [CleanComputeProg.wrapDyn]
      rw [ih₁, ih₂]


theorem count_t_wrapDyn_le {Var : Type} {n : ℕ} (p : CleanComputeProg)
    (v : Var) (rFull128 : QRegister 128 n) (body : DynamicCircuit Var n) :
    (p.wrapDyn v rFull128 body).count PrimitiveGate.T ≤
      4 * p.numTempAnd + body.count PrimitiveGate.T := by
  induction p generalizing body with
  | id => simp [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd]
  | x q =>
      simp [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd,
        count_t_mkWithCliffDyn rFull128 (Circuit.X q) rfl]
  | cnot c t =>
      simp [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd,
        count_t_mkWithCliffDyn rFull128 (cnotIf c t) (count_t_cnotIf c t)]
  | tempAnd c₁ c₂ anc =>
      dsimp only [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd]
      split_ifs with h
      · simp
      · omega
  | seq p₁ p₂ ih₁ ih₂ =>
      dsimp only [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd]
      have h1 := ih₁ (p₂.wrapDyn v rFull128 body)
      have h2 := ih₂ body
      omega


theorem isCleanList_eq_true_iff {clean : List (Wire 128)} {w : Wire 128} :
    isCleanList clean w = true ↔ w ∈ clean := by
  simp only [isCleanList, List.any_eq_true, decide_eq_true_eq]
  exact ⟨fun ⟨x, hx, heq⟩ ↦ heq ▸ hx, fun hw ↦ ⟨w, hw, rfl⟩⟩


theorem mem_dropCleanList_iff {clean : List (Wire 128)} {q w : Wire 128} :
    w ∈ dropCleanList clean q ↔ w ≠ q ∧ w ∈ clean := by
  simp only [dropCleanList, List.mem_filter, decide_eq_true_eq, and_comm]


theorem bhmt_post_respectsClean (p : CleanComputeProg)
    (clean : List (Wire 128)) (S : BitAssignment 128 → Prop)
    (hResp : RespectsClean clean S) (hOk : (p.checkProg clean).1 = true) :
    RespectsClean (p.checkProg clean).2 (p.PostInv S) := by
  induction p generalizing clean S with
  | id => exact hResp
  | x q =>
      dsimp only [CleanComputeProg.checkProg, CleanComputeProg.PostInv]
      refine ⟨fun δ hS w hw ↦ ?_, ?_, fun δ b hS ↦ ?_⟩
      · obtain ⟨hne, hcw⟩ := mem_dropCleanList_iff.mp hw
        have h0 := hResp.1 _ hS w hcw
        rwa [Function.update_of_ne hne] at h0
      · intro hmem
        exact hResp.2.1 (mem_dropCleanList_iff.mp hmem).2
      · dsimp only at hS ⊢
        by_cases hq : q = wSubReject_128
        · subst hq
          rw [Function.update_self, upd_idem128]
          have h1 := hResp.2.2 (Function.update δ wSubReject_128 (δ wSubReject_128 + 1)) (b + 1) hS
          rwa [upd_idem128] at h1
        · rw [Function.update_of_ne hq, upd_comm128 _ (Ne.symm hq)]
          exact hResp.2.2 _ b hS
  | cnot c t =>
      dsimp only [CleanComputeProg.checkProg, CleanComputeProg.PostInv] at hOk ⊢
      obtain ⟨hct, hcSub, htSub⟩ := of_decide_eq_true hOk
      refine ⟨fun δ hS w hw ↦ ?_, ?_, fun δ b hS ↦ ?_⟩
      · obtain ⟨hne, hcw⟩ := mem_dropCleanList_iff.mp hw
        have h0 := hResp.1 _ hS w hcw
        rwa [Function.update_of_ne hne] at h0
      · intro hmem
        exact hResp.2.1 (mem_dropCleanList_iff.mp hmem).2
      · dsimp only at hS ⊢
        rw [Function.update_of_ne htSub, Function.update_of_ne hcSub,
          upd_comm128 _ (Ne.symm htSub)]
        exact hResp.2.2 _ b hS
  | tempAnd c₁ c₂ anc =>
      dsimp only [CleanComputeProg.checkProg, CleanComputeProg.PostInv] at hOk ⊢
      rw [Bool.and_eq_true] at hOk
      obtain ⟨_, _, _, hc₁Sub, hc₂Sub, haSub⟩ := of_decide_eq_true hOk.2
      refine ⟨fun δ hS w hw ↦ ?_, ?_, fun δ b hS ↦ ?_⟩
      · obtain ⟨hne, hcw⟩ := mem_dropCleanList_iff.mp hw
        have h0 := hResp.1 _ hS.1 w hcw
        rwa [Function.update_of_ne hne] at h0
      · intro hmem
        exact hResp.2.1 (mem_dropCleanList_iff.mp hmem).2
      · dsimp only at hS ⊢
        refine ⟨?_, ?_⟩
        · rw [upd_comm128 _ (Ne.symm haSub)]
          exact hResp.2.2 _ b hS.1
        · rw [Function.update_of_ne haSub, Function.update_of_ne hc₁Sub,
            Function.update_of_ne hc₂Sub, hS.2]
  | seq p₁ p₂ ih₁ ih₂ =>
      dsimp only [CleanComputeProg.checkProg, CleanComputeProg.PostInv] at hOk ⊢
      rw [Bool.and_eq_true] at hOk
      exact ih₂ (p₁.checkProg clean).2 (p₁.PostInv S) (ih₁ clean S hResp hOk.1) hOk.2


private theorem DynPair128.bhmt_cleanCompute {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    {v : Var} {rFull128 : QRegister 128 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (p : CleanComputeProg) (clean : List (Wire 128)) (S : BitAssignment 128 → Prop)
    (hResp : RespectsClean clean S) (hOk : (p.checkProg clean).1 = true)
    {t : ℕ} {bFwd bInv : DynamicCircuit Var n} {U_body : Unitary (2 ^ 128)}
    (hb : DynPair128 v rFull128 rExtra9 (p.PostInv S) t bFwd bInv U_body) :
    DynPair128 v rFull128 rExtra9 S (t + 4 * p.numTempAnd)
      (p.wrapDyn v rFull128 bFwd)
      (p.wrapDyn v rFull128 bInv)
      (p.toCircuit.inverse.eval * U_body * p.toCircuit.eval) := by
  induction p generalizing clean S t bFwd bInv U_body with
  | id =>
      dsimp only [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd,
        CleanComputeProg.toCircuit, CleanComputeProg.PostInv] at hb ⊢
      have hId : (Circuit.identity : Circuit 128).inverse.eval * U_body *
          (Circuit.identity : Circuit 128).eval = U_body := by
        have h1 : (Circuit.identity : Circuit 128).eval = 1 := rfl
        rw [Circuit.eval_inverse, h1, inv_one, one_mul, mul_one]
      simpa only [Nat.mul_zero, Nat.add_zero] using hb.congr_unitary hId.symm
  | x q =>
      dsimp only [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd,
        CleanComputeProg.toCircuit, CleanComputeProg.PostInv, mkWithCliffDyn] at hb ⊢
      have hp := DynPair128.withCliff hDisjExtra (Circuit.X q) rfl rfl
        (S_pre := S) (S_mid := fun δ ↦ S (Function.update δ q (δ q + 1)))
        (fun α hα ↦ by
          rw [ket_X]
          refine ket_mem_ketSpan ?_
          have hrestore :
              Function.update (Function.update α q (α q + 1)) q
                (Function.update α q (α q + 1) q + 1) = α := by
            rw [Function.update_self, upd_idem128, add_assoc, CharTwo.add_self_eq_zero, add_zero]
            exact upd_self128 α q rfl
          rwa [hrestore])
        (fun δ hδ ↦ by
          have heq : (Circuit.X q).inverse.eval.1.mulVec (ket δ) =
              (Circuit.X q).eval.1.mulVec (ket δ) :=
            congrArg (fun U : Unitary (2 ^ 128) ↦ U.1.mulVec (ket δ)) (X_inv_eval q)
          rw [heq, ket_X]
          exact ket_mem_ketSpan hδ)
        hb
      simpa only [Nat.mul_zero, Nat.add_zero] using hp
  | cnot c tgt =>
      dsimp only [CleanComputeProg.checkProg] at hOk
      obtain ⟨hct, _, _⟩ := of_decide_eq_true hOk
      dsimp only [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd,
        CleanComputeProg.toCircuit, CleanComputeProg.PostInv, mkWithCliffDyn] at hb ⊢
      have hp := DynPair128.withCliff hDisjExtra (cnotIf c tgt)
        (count_toff_cnotIf c tgt) (count_t_cnotIf c tgt)
        (S_pre := S) (S_mid := fun δ ↦ S (Function.update δ tgt (δ tgt + δ c)))
        (fun α hα ↦ by
          rw [ket_cnotIf_ne c tgt hct]
          refine ket_mem_ketSpan ?_
          have hrestore :
              Function.update (Function.update α tgt (α tgt + α c)) tgt
                (Function.update α tgt (α tgt + α c) tgt +
                  Function.update α tgt (α tgt + α c) c) = α := by
            rw [Function.update_self, Function.update_of_ne hct, upd_idem128,
              add_assoc, CharTwo.add_self_eq_zero, add_zero]
            exact upd_self128 α tgt rfl
          rwa [hrestore])
        (fun δ hδ ↦ by
          rw [ket_cnotIf_inv_ne c tgt hct]
          exact ket_mem_ketSpan hδ)
        hb
      simpa only [Nat.mul_zero, Nat.add_zero] using hp
  | tempAnd c₁ c₂ anc =>
      dsimp only [CleanComputeProg.checkProg] at hOk
      rw [Bool.and_eq_true] at hOk
      have hAncMem : anc ∈ clean := isCleanList_eq_true_iff.mp hOk.1
      obtain ⟨h₁₂, h₁a, h₂a, _, _, _⟩ := of_decide_eq_true hOk.2
      have hcond : c₁ ≠ c₂ ∧ c₁ ≠ anc ∧ c₂ ≠ anc := ⟨h₁₂, h₁a, h₂a⟩
      dsimp only [CleanComputeProg.wrapDyn, CleanComputeProg.numTempAnd,
        CleanComputeProg.toCircuit, CleanComputeProg.PostInv] at hb ⊢
      rw [dite_eq_left hcond, dite_eq_left hcond]
      dsimp only [mkWithTempAndDyn]
      have hp := DynPair128.withTempAnd hDisjExtra c₁ c₂ anc h₁₂ h₁a h₂a
        (S_pre := S)
        (S_mid := fun δ ↦ S (Function.update δ anc 0) ∧ δ anc = δ c₁ * δ c₂)
        (fun α hα ↦ hResp.1 α hα anc hAncMem)
        (fun _ hδ ↦ hδ.2)
        (fun α hα ↦ by
          refine ⟨?_, ?_⟩
          · rw [upd_idem128, upd_self128 α anc (hResp.1 α hα anc hAncMem)]
            exact hα
          · simp [Function.update_self, Function.update_of_ne h₁a, Function.update_of_ne h₂a])
        (fun _ hδ ↦ hδ.1)
        hb
      simpa only [Nat.mul_one] using hp
  | seq p₁ p₂ ih₁ ih₂ =>
      dsimp only [CleanComputeProg.checkProg] at hOk
      rw [Bool.and_eq_true] at hOk
      have hResp₁ := bhmt_post_respectsClean p₁ clean S hResp hOk.1
      have hp₂ := ih₂ (p₁.checkProg clean).2 (p₁.PostInv S) hResp₁ hOk.2 hb
      have hp₁ := ih₁ clean S hResp hOk.1 hp₂
      have hUEq :
          p₁.toCircuit.inverse.eval *
            (p₂.toCircuit.inverse.eval * U_body * p₂.toCircuit.eval) *
            p₁.toCircuit.eval =
          (p₁.toCircuit ;;ᶜ p₂.toCircuit).inverse.eval * U_body *
            (p₁.toCircuit ;;ᶜ p₂.toCircuit).eval := by
        simp only [Circuit.eval_seq, Circuit.eval_inverse, unitary_mul_inv_rev, unitary_mul_assoc]
      exact (hp₁.congr_unitary hUEq).mono_t (by dsimp [CleanComputeProg.numTempAnd]; omega)


theorem respectsClean_initClean128 : RespectsClean initClean128 FlagsInv128 := by
  refine ⟨fun α hα w hw ↦ ?_, by decide, flagsInv_indep_payload_not36 (by decide)⟩
  rcases (flagsInv128_iff_core α).mp hα with
    ⟨⟨_, _, _, hs, _, h124, h125, h126, h127⟩, _, _, _, _⟩
  rcases List.mem_append.mp hw with h1 | h2
  · obtain ⟨j, _, rfl⟩ := List.mem_map.mp h1
    exact hs j
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at h2
    rcases h2 with rfl | rfl | rfl | rfl
    · exact h124
    · exact h125
    · exact h126
    · exact h127



theorem count_toff_dFinishXorFwd {Var : Type} {n : ℕ} (v : Var)
