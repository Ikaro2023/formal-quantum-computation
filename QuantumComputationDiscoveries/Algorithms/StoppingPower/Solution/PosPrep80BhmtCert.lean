  | r8 => exact (hδ0_out wEnC0Head_152 (by decide) (by decide)).trans hc0h_b
  | r9 => exact (hδ0_out wEnS4Head_152 (by decide) (by decide)).trans hs4h_b
  | r10 => exact (hδ0_out wEnTail_152 (by decide) (by decide)).trans het_b
  | r11 => exact (hδ0_out (scr21_152 0) (by decide) (by decide)).trans (hscr21 0)
  | r12 => exact (hδ0_out (scr21_152 1) (by decide) (by decide)).trans (hscr21 1)
