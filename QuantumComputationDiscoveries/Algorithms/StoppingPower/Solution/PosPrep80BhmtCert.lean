theorem norm_sq_toMatrix_00 (m : Mat2Zw) :
    let p := zwMul m.m00 (zwConj m.m00)
    ‖m.toMatrix 0 0‖ ^ 2 = ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((2 : ℝ) ^ m.h) := by
  let p := zwMul m.m00 (zwConj m.m00)
  have h00 : m.toMatrix 0 0 = ((MeasureBranchHadamardSem.sqrtHalf : ℂ) ^ m.h) * m.m00.toComplex :=
    by
    simp [Mat2Zw.toMatrix]
  have hsh_norm : ‖(MeasureBranchHadamardSem.sqrtHalf : ℂ) ^ m.h‖ ^ 2 = 1 / ((2 : ℝ) ^ m.h) := by
    have hsq : ((MeasureBranchHadamardSem.sqrtHalf : ℂ) ^ m.h) *
        star ((MeasureBranchHadamardSem.sqrtHalf : ℂ) ^ m.h) = (1 / 2 : ℂ) ^ m.h := by
      rw [star_pow, MeasureBranchHadamardSem.star_sqrtHalf, ← mul_pow,
        MeasureBranchHadamardSem.sqrtHalf_mul_sqrtHalf]
    have hns := congrArg Complex.re hsq
    rw [Complex.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, Complex.ofReal_re] at hns
    have hrhs : ((1 / 2 : ℂ) ^ m.h).re = 1 / ((2 : ℝ) ^ m.h) := by
      have hc : ((1 / 2 : ℂ) ^ m.h) = (((1 / (2 : ℝ) ^ m.h : ℝ) : ℂ)) := by
        push_cast; rw [_root_.one_div_pow]
      rw [hc, Complex.ofReal_re]
    exact hns.trans hrhs
  change ‖m.toMatrix 0 0‖ ^ 2 = ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((2 : ℝ) ^ m.h)
  rw [h00, norm_mul, mul_pow, hsh_norm, normSq_zw_eq m.m00]
  dsimp only [p]
  ring


theorem bhmt1_defect_eq (sSq : ℝ) :
    1 - sSq * (3 - 4 * sSq) ^ 2 = (1 - sSq) * (1 - 4 * sSq) ^ 2 := by
  ring


def checkTeleBhmtCert (m : Mat2Zw) (gn gd k32 : ℕ) : Bool :=
  let p := zwMul m.m00 (zwConj m.m00)
  let powH : ℤ := ((2 ^ m.h : ℕ) : ℤ)
  let pow32 : ℤ := ((2 ^ 32 : ℕ) : ℤ)
  let gnZ : ℤ := (gn : ℤ)
  let gdZ : ℤ := (gd : ℤ)
  let kZ : ℤ := (k32 : ℤ)
  -- (1) 249 * gd * 2^h <= 1000 * gn * (c0 + c1 * sqrt(2))
  -- <=> (-1000 * gn * c1) * sqrt(2) <= 1000 * gn * c0 - 249 * gd * 2^h
  let chkLo := leSqrt2Int (-1000 * gnZ * p.c1) (1000 * gnZ * p.c0 - 249 * gdZ * powH)
  -- (2) gn * (c0 + c1 * sqrt(2)) <= gd * 2^h
  -- <=> (gn * c1) * sqrt(2) <= gd * 2^h - gn * c0
  let chkHi := leSqrt2Int (gnZ * p.c1) (gdZ * powH - gnZ * p.c0)
  -- (3) |4 * gn * (c0 + c1 * sqrt(2)) * 2^32 - gd * 2^h * 2^32| <= k32 * gd * 2^h
  let bigA := 4 * gnZ * p.c0 * pow32 - gdZ * powH * pow32
  let bigB := 4 * gnZ * p.c1 * pow32
  let bigM := kZ * gdZ * powH
  chkLo && chkHi && leSqrt2Int bigB (bigM - bigA) && leSqrt2Int (-bigB) (bigM + bigA)


theorem teleBhmt_bounds_of_cert (bOdds fOdds : List (Fin 4)) (mx mz fl : Bool)
    (m : Mat2Zw) (gn gd k32 : ℕ)
    (heval : teleCoreMatZw bOdds fOdds mx mz fl = m)
    (hgd : 0 < gd)
    (hchk : checkTeleBhmtCert m gn gd k32 = true) :
    let sSq : ℝ := ((gn : ℝ) / (gd : ℝ)) * ‖teleCoreMat bOdds fOdds mx mz fl 0 0‖ ^ 2
    (0 ≤ sSq ∧ sSq ≤ 1) ∧
      (0 ≤ sSq * (3 - 4 * sSq) ^ 2 ∧ sSq * (3 - 4 * sSq) ^ 2 ≤ 1) ∧
      2 * (1 - sSq * (3 - 4 * sSq) ^ 2) ≤
        2 * (751 / 1000 : ℝ) * ((k32 : ℝ) / (2 : ℝ) ^ 32) ^ 2 := by
  intro sSq
  let p := zwMul m.m00 (zwConj m.m00)
  have hp0 : ‖teleCoreMat bOdds fOdds mx mz fl 0 0‖ ^ 2 =
      ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((2 : ℝ) ^ m.h) := by
    rw [← toMatrix_teleCoreMatZw, heval]
    exact norm_sq_toMatrix_00 m
  simp only [checkTeleBhmtCert, Bool.and_eq_true] at hchk
  rcases hchk with ⟨⟨⟨hLoB, hHiB⟩, hUB⟩, hLB⟩
  have hLo := leSqrt2Int_sound _ _ hLoB
  have hHi := leSqrt2Int_sound _ _ hHiB
  have hU := leSqrt2Int_sound _ _ hUB
  have hL := leSqrt2Int_sound _ _ hLB
  push_cast at hLo hHi hU hL
  have hgdR : (0 : ℝ) < (gd : ℝ) := by exact_mod_cast hgd
  have hpowHR : (0 : ℝ) < (2 : ℝ) ^ m.h := by positivity
  have hpow32R : (0 : ℝ) < (2 : ℝ) ^ 32 := by positivity
  have hdenR : (0 : ℝ) < (gd : ℝ) * (2 : ℝ) ^ m.h := by positivity
  have hsEq : sSq = (gn : ℝ) * ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((gd : ℝ) * (2 : ℝ) ^ m.h) := by
    dsimp only [sSq]
    rw [hp0]
    field_simp [hgdR.ne', hpowHR.ne']
  have hs249 : (249 : ℝ) / 1000 ≤ sSq := by
    rw [hsEq, div_le_div_iff₀ (by norm_num) hdenR]
    linarith
  have hs0 : 0 ≤ sSq := by linarith
  have hs1 : sSq ≤ 1 := by
    rw [hsEq, div_le_iff₀ hdenR]
    linarith
  have h1ms : 1 - sSq ≤ 751 / 1000 := by linarith
  have h1ms_nn : 0 ≤ 1 - sSq := by linarith
  have hAbs : |4 * sSq - 1| ≤ (k32 : ℝ) / (2 : ℝ) ^ 32 := by
    have hden32 : (0 : ℝ) < (gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32 := by positivity
    rw [abs_le]
    constructor
    · suffices hmul : (-((k32 : ℝ) / (2 : ℝ) ^ 32)) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) ≤
          (4 * sSq - 1) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) by
        exact le_of_mul_le_mul_right hmul hden32
      have hl : (-((k32 : ℝ) / (2 : ℝ) ^ 32)) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) =
          -(k32 : ℝ) * (gd : ℝ) * (2 : ℝ) ^ m.h := by
        field_simp [hpow32R.ne']
      have hr : (4 * sSq - 1) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) =
          4 * (gn : ℝ) * (p.c0 : ℝ) * (2 : ℝ) ^ 32 - (gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32 +
            4 * (gn : ℝ) * (p.c1 : ℝ) * (2 : ℝ) ^ 32 * √2 := by
        rw [hsEq]
        field_simp [hgdR.ne', hpowHR.ne']
        ring
      rw [hl, hr]
      linarith
    · suffices hmul : (4 * sSq - 1) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) ≤
          ((k32 : ℝ) / (2 : ℝ) ^ 32) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) by
        exact le_of_mul_le_mul_right hmul hden32
      have hr : ((k32 : ℝ) / (2 : ℝ) ^ 32) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) =
          (k32 : ℝ) * (gd : ℝ) * (2 : ℝ) ^ m.h := by
        field_simp [hpow32R.ne']
      have hl : (4 * sSq - 1) * ((gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32) =
          4 * (gn : ℝ) * (p.c0 : ℝ) * (2 : ℝ) ^ 32 - (gd : ℝ) * (2 : ℝ) ^ m.h * (2 : ℝ) ^ 32 +
            4 * (gn : ℝ) * (p.c1 : ℝ) * (2 : ℝ) ^ 32 * √2 := by
        rw [hsEq]
        field_simp [hgdR.ne', hpowHR.ne']
        ring
      rw [hl, hr]
      linarith
  have hSq : (1 - 4 * sSq) ^ 2 ≤ ((k32 : ℝ) / (2 : ℝ) ^ 32) ^ 2 := by
    have heq : (1 - 4 * sSq) ^ 2 = |4 * sSq - 1| ^ 2 := by
      rw [sq_abs]; ring
    rw [heq]
    exact pow_le_pow_left₀ (abs_nonneg _) hAbs 2
  have hq0 : 0 ≤ sSq * (3 - 4 * sSq) ^ 2 := mul_nonneg hs0 (sq_nonneg _)
  have hq1 : sSq * (3 - 4 * sSq) ^ 2 ≤ 1 := by
    have hd := bhmt1_defect_eq sSq
    have hnn : 0 ≤ (1 - sSq) * (1 - 4 * sSq) ^ 2 := mul_nonneg h1ms_nn (sq_nonneg _)
    linarith
  refine ⟨⟨hs0, hs1⟩, ⟨hq0, hq1⟩, ?_⟩
  rw [bhmt1_defect_eq sSq]
  have hprod : (1 - sSq) * (1 - 4 * sSq) ^ 2 ≤ (751 / 1000 : ℝ) * ((k32 : ℝ) / (2 : ℝ) ^ 32) ^ 2 :=
    mul_le_mul h1ms hSq (sq_nonneg _) (by norm_num)
  linarith

