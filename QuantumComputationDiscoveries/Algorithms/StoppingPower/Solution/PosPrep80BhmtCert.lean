theorem stepMask76_xor_out24 {g : RevGate76} (hno : g.noOut24Ctrl = true)
    (m δ : ℕ) (hδ : ∀ i, isOut24Idx i = false → δ.testBit i = false) :
    stepMask76 g (m ^^^ δ) = (stepMask76 g m) ^^^ δ := by
  cases g with
  | x t => exact nat_xor_right_comm76 m δ (2 ^ t.val)
  | cnot c t =>
      have hc0 : isOut24Idx c.val = false := by simpa [RevGate76.noOut24Ctrl] using hno
      have htb : (m ^^^ δ).testBit c.val = m.testBit c.val := by
        rw [Nat.testBit_xor, hδ c.val hc0]; cases m.testBit c.val <;> rfl
      dsimp only [stepMask76]; rw [htb]
      cases m.testBit c.val
      · rfl
      · exact nat_xor_right_comm76 m δ (2 ^ t.val)
  | toff c1 c2 t =>
      simp only [RevGate76.noOut24Ctrl, Bool.and_eq_true, Bool.not_eq_true'] at hno
      have htb1 : (m ^^^ δ).testBit c1.val = m.testBit c1.val := by
        rw [Nat.testBit_xor, hδ c1.val hno.1]; cases m.testBit c1.val <;> rfl
      have htb2 : (m ^^^ δ).testBit c2.val = m.testBit c2.val := by
        rw [Nat.testBit_xor, hδ c2.val hno.2]; cases m.testBit c2.val <;> rfl
      dsimp only [stepMask76]; rw [htb1, htb2]
      cases (m.testBit c1.val && m.testBit c2.val)
      · rfl
      · exact nat_xor_right_comm76 m δ (2 ^ t.val)


