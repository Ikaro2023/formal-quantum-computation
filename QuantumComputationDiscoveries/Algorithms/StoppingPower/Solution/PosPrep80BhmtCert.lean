def evalStep22 (st : Step22) (s : St22) : St22 :=
  match st with
  | .x q => setB22 s q (!getB22 s q)
  | .cnot c t => setB22 s t (bne (getB22 s t) (getB22 s c))
  | .tempAnd c1 c2 anc => setB22 s anc (bne (getB22 s anc) (getB22 s c1 && getB22 s c2))


def evalProg22 : List Step22 → St22 → St22
  | [], s => s
  | st :: rest, s => evalProg22 rest (evalStep22 st s)


theorem evalProg22_append (p₁ p₂ : List Step22) (s : St22) :
    evalProg22 (p₁ ++ p₂) s = evalProg22 p₂ (evalProg22 p₁ s) := by
  induction p₁ generalizing s with
  | nil => rfl
  | cons st rest ih => exact ih (evalStep22 st s)


def liftStep22 (emb : Reg22 → Wire 152) : Step22 → CleanStep152
  | .x q => .x (emb q)
  | .cnot c t => .cnot (emb c) (emb t)
  | .tempAnd c1 c2 anc => .tempAnd (emb c1) (emb c2) (emb anc)


theorem evalStep152_liftStep22 {emb : Reg22 → Wire 152}
    (hinj : ∀ i j, emb i = emb j → i = j)
    (st : Step22) (γ : BitAssignment 152) (s : St22)
    (hγ : ∀ i, γ (emb i) = b2z (getB22 s i)) (i : Reg22) :
    evalStep152 (liftStep22 emb st) γ (emb i) = b2z (getB22 (evalStep22 st s) i) := by
  cases st with
  | x q =>
      dsimp only [liftStep22, evalStep152, evalStep22]
      rw [getB22_setB22]
      by_cases h : i = q
      · subst h; rw [ite_eq_left rfl, Function.update_self, hγ, b2z_not]
      · have hne : emb i ≠ emb q := fun he ↦ h (hinj i q he)
        rw [ite_eq_right h, Function.update_of_ne hne, hγ]
  | cnot c t =>
      dsimp only [liftStep22, evalStep152, evalStep22]
      rw [getB22_setB22]
      by_cases h : i = t
      · subst h; rw [ite_eq_left rfl, Function.update_self, hγ, hγ, b2z_bne]
      · have hne : emb i ≠ emb t := fun he ↦ h (hinj i t he)
        rw [ite_eq_right h, Function.update_of_ne hne, hγ]
  | tempAnd c1 c2 anc =>
      dsimp only [liftStep22, evalStep152, evalStep22]
      rw [getB22_setB22]
      by_cases h : i = anc
      · subst h; rw [ite_eq_left rfl, Function.update_self, hγ, hγ, hγ, b2z_bne, b2z_and]
      · have hne : emb i ≠ emb anc := fun he ↦ h (hinj i anc he)
        rw [ite_eq_right h, Function.update_of_ne hne, hγ]


theorem evalProg152_lift22 {emb : Reg22 → Wire 152}
    (hinj : ∀ i j, emb i = emb j → i = j)
    (prog : List Step22) (γ : BitAssignment 152) (s : St22)
    (hγ : ∀ i, γ (emb i) = b2z (getB22 s i)) :
    ∀ i, evalProg152 (prog.map (liftStep22 emb)) γ (emb i) =
      b2z (getB22 (evalProg22 prog s) i) := by
  induction prog generalizing γ s with
  | nil => exact hγ
  | cons st rest ih =>
      exact ih (evalStep152 (liftStep22 emb st) γ) (evalStep22 st s)
        (evalStep152_liftStep22 hinj st γ s hγ)


