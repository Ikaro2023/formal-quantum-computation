def AtMostOneScr20 (α : BitAssignment 128) : Prop :=
  (∑ i : Fin 20, (α (scr20_128 i)).val) ≤ 1


theorem scr20_128_injective : Function.Injective scr20_128 := by
  intro i j h
  fin_cases i <;> fin_cases j <;> first | rfl | exact absurd h (by decide)


theorem fork_bit_val_preserved (xa xb xk : ZMod 2) (h : xb = (xa + xb) * xk) :
    xa.val + xb.val = (xa + xb).val + (0 : ZMod 2).val := by
  have h11 : (1 : ZMod 2) + 1 = 0 := rfl
  rcases bit_cases xa with rfl | rfl <;>
    rcases bit_cases xb with rfl | rfl
  · rfl
  · rfl
  · rfl
  · rw [h11, zero_mul] at h
    exact absurd h one_ne_zero


theorem atMostOneScr20_pair_ne {α : BitAssignment 128} (h : AtMostOneScr20 α)
    {R : ℕ} (idx : Fin R → Fin 20) (hInj : Function.Injective idx) :
    ∀ i j : Fin R, i ≠ j → ¬ (α (scr20_128 (idx i)) = 1 ∧ α (scr20_128 (idx j)) = 1) := by
  intro i j hij ⟨hi, hj⟩
  have hne : idx i ≠ idx j := hInj.ne hij
  have h1 := Finset.add_sum_erase Finset.univ (fun u : Fin 20 ↦ (α (scr20_128 u)).val)
    (Finset.mem_univ (idx i))
  have h2 := Finset.add_sum_erase (Finset.univ.erase (idx i))
    (fun u : Fin 20 ↦ (α (scr20_128 u)).val)
    (Finset.mem_erase.mpr ⟨hne.symm, Finset.mem_univ (idx j)⟩)
  have hsum : (∑ u : Fin 20, (α (scr20_128 u)).val) ≥ 2 := by
    rw [← h1, ← h2, hi, hj, ZMod.val_one]; omega
  exact absurd h (by dsimp [AtMostOneScr20]; omega)


theorem atMostOneScr20_hsInv0 : ∀ α, HsInv_0 α → AtMostOneScr20 α := by
  intro α hα
  dsimp only [AtMostOneScr20]
  rw [Finset.sum_eq_single (0 : Fin 20)]
  · exact Nat.lt_succ_iff.mp (ZMod.val_lt _)
  · intro i _ hi0
    have hmem : scr20_128 i ∈ hsClean_0 := by
      fin_cases i <;> first | exact absurd rfl hi0 | decide
    rw [hsResp_0.1 α hα _ hmem]; rfl
  · intro h; exact absurd (Finset.mem_univ _) h


theorem atMostOneScr20_pForkStep {a b : Fin 20} (hab : a ≠ b) (k : Fin 6)
    {S : BitAssignment 128 → Prop}
    (hS : ∀ α, S α → AtMostOneScr20 α)
    (_hb0 : ∀ α, S α → α (scr20_128 b) = 0) :
    ∀ δ, (pForkStep (scr20_128 a) (rK_128 k) (scr20_128 b)).PostInv S δ → AtMostOneScr20 δ := by
  intro δ hPost
  have hw_ab : scr20_128 a ≠ scr20_128 b := scr20_128_injective.ne hab
  have hk_a : rK_128 k ≠ scr20_128 a := by
    fin_cases k <;> fin_cases a <;> decide
  dsimp only [pForkStep, CleanComputeProg.PostInv] at hPost
  let γ := Function.update δ (scr20_128 a) (δ (scr20_128 a) + δ (scr20_128 b))
  let α := Function.update γ (scr20_128 b) 0
  have hSα : S α := hPost.1
  have hEq : δ (scr20_128 b) = (δ (scr20_128 a) + δ (scr20_128 b)) * δ (rK_128 k) := by
    have h := hPost.2
    change γ (scr20_128 b) = γ (scr20_128 a) * γ (rK_128 k) at h
    dsimp only [γ] at h
    rwa [Function.update_of_ne hw_ab.symm, Function.update_self, Function.update_of_ne hk_a] at h
  have hα_b : α (scr20_128 b) = 0 := Function.update_self _ _ _
  have hα_a : α (scr20_128 a) = δ (scr20_128 a) + δ (scr20_128 b) := by
    dsimp only [α, γ]
    rw [Function.update_of_ne hw_ab, Function.update_self]
  have hPairVal : (δ (scr20_128 a)).val + (δ (scr20_128 b)).val =
      (α (scr20_128 a)).val + (α (scr20_128 b)).val := by
    rw [hα_a, hα_b]
    exact fork_bit_val_preserved _ _ _ hEq
  have hd1 := Finset.add_sum_erase Finset.univ (fun u : Fin 20 ↦ (δ (scr20_128 u)).val)
    (Finset.mem_univ a)
  have hd2 := Finset.add_sum_erase (Finset.univ.erase a) (fun u : Fin 20 ↦ (δ (scr20_128 u)).val)
    (Finset.mem_erase.mpr ⟨hab.symm, Finset.mem_univ b⟩)
  have ha1 := Finset.add_sum_erase Finset.univ (fun u : Fin 20 ↦ (α (scr20_128 u)).val)
    (Finset.mem_univ a)
  have ha2 := Finset.add_sum_erase (Finset.univ.erase a) (fun u : Fin 20 ↦ (α (scr20_128 u)).val)
    (Finset.mem_erase.mpr ⟨hab.symm, Finset.mem_univ b⟩)
  have hRest : ∑ u ∈ (Finset.univ.erase a).erase b, (δ (scr20_128 u)).val =
      ∑ u ∈ (Finset.univ.erase a).erase b, (α (scr20_128 u)).val := by
    refine Finset.sum_congr rfl fun u hu ↦ ?_
    have hub : u ≠ b := (Finset.mem_erase.mp hu).1
    have hua : u ≠ a := (Finset.mem_erase.mp (Finset.mem_erase.mp hu).2).1
    dsimp only [α, γ]
    rw [Function.update_of_ne (scr20_128_injective.ne hub),
      Function.update_of_ne (scr20_128_injective.ne hua)]
  dsimp only [AtMostOneScr20]
  have hTot : (∑ u : Fin 20, (δ (scr20_128 u)).val) = ∑ u : Fin 20, (α (scr20_128 u)).val := by
    rw [← hd1, ← hd2, ← ha1, ← ha2, hRest]
    omega
  rw [hTot]
  exact hS α hSα


