theorem muxFlagsInv152_wireIndep_payload_not36 (w : Wire 152)
    (hlo : 6 ≤ w.val) (hhi : w.val < 86) (hne36 : w ≠ wIsHead_152) :
    WireIndepSub MuxFlagsInv152 w := by
