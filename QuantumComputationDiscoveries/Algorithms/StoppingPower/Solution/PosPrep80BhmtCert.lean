theorem pHeadCoord76_gm18_evalBits_eq_head67CleanMap (γ : BitAssignment 76)
    (hClean : cleanRem 76 39 γ) :
    (∀ i : Fin 67,
      pHeadCoord76_gm18.evalBits γ (Fin.castAdd 9 i) =
        head67CleanMap (fun k : Fin 67 ↦ γ (Fin.castAdd 9 k)) i) ∧
    (∀ j : Fin 9, pHeadCoord76_gm18.evalBits γ (Fin.natAdd 67 j) = 0) := by
  let m := pack13Mask γ
  have hm : m < 8192 := pack13Mask_lt_8192 γ
  let δ76 : BitAssignment 76 := fun w ↦ if isOut24Wire76 w then γ w else 0
  have hδ76_out : ∀ w : Wire 76, isOut24Wire76 w = false → δ76 w = 0 := by
    intro w hw; dsimp [δ76]; rw [hw]
    rfl
  have hγ_decomp : γ = unpackMask76 m + δ76 := by
    funext w
    change γ w = unpackMask76 m w + δ76 w
    by_cases hw13 : w.val < 13
    · have hout : isOut24Wire76 w = false := by
        dsimp [isOut24Wire76]; rw [decide_eq_false_iff_not]; omega
      have heqw : w = ⟨w.val, by omega⟩ := rfl
      rw [hδ76_out w hout, add_zero, heqw, unpackMask76_pack13Mask_of_lt13 γ hw13]
    · by_cases hw37 : w.val < 37
      · have hout : isOut24Wire76 w = true := by
          dsimp [isOut24Wire76]; rw [decide_eq_true_eq]; omega
        have hz : unpackMask76 m w = 0 :=
          unpackMask76_pack13Mask_of_ge13 γ (Nat.le_of_not_lt hw13) w.isLt
        simp only [δ76, hout, ↓reduceIte, hz, zero_add]
      · have hout : isOut24Wire76 w = false := by
          dsimp [isOut24Wire76]; rw [decide_eq_false_iff_not]; omega
        have hz : unpackMask76 m w = 0 :=
          unpackMask76_pack13Mask_of_ge13 γ (by omega) w.isLt
        rw [hδ76_out w hout, hz, add_zero]
        exact hClean w (by omega)
  obtain ⟨hRunEq, hRunLt37⟩ := runMask76_gm18_eq_runMask67_of_lt8192 hm
  have hEvalClean :
      pHeadCoord76_gm18.evalBits (unpackMask76 m) = unpackMask76 (runMask67 fullGates67 m) := by
    change (compile76 revHeadCoord76_gm18).evalBits (unpackMask76 m) = _
    rw [compile76_evalBits_unpackMask76 revHeadCoord76_gm18 wfRevProg76_revHeadCoord76_gm18 m,
      hRunEq]
  have hEvalFull :
      pHeadCoord76_gm18.evalBits γ = unpackMask76 (runMask67 fullGates67 m) + δ76 := by
    conv_lhs => rw [hγ_decomp]
    rw [pHeadCoord76_gm18_evalBits_add_out24 (unpackMask76 m) δ76 hδ76_out, hEvalClean]
  let γ67 : BitAssignment 67 := fun k ↦ γ (Fin.castAdd 9 k)
  let δ67 : BitAssignment 67 := fun k ↦ if isOut24Idx k.val then γ67 k else 0
  have hδ67_out : ∀ k : Fin 67, isOut24Idx k.val = false → δ67 k = 0 := by
    intro k hk; dsimp [δ67]; rw [hk]
    rfl
  have hγ67_decomp : γ67 = unpackMask67 m + δ67 := by
    funext k
    change γ (Fin.castAdd 9 k) = unpackMask67 m k + δ67 k
    by_cases hk13 : k.val < 13
    · have hout : isOut24Idx k.val = false := by
        dsimp [isOut24Idx]; rw [decide_eq_false_iff_not]; omega
      rw [hδ67_out k hout, add_zero]
      exact (unpackMask67_pack13Mask_of_lt13 γ hk13).symm
    · by_cases hk37 : k.val < 37
      · have hout : isOut24Idx k.val = true := by
          dsimp [isOut24Idx]; rw [decide_eq_true_eq]; omega
        have hz : unpackMask67 m k = 0 :=
          unpackMask67_pack13Mask_of_ge13 γ (Nat.le_of_not_lt hk13) k.isLt
        simp only [δ67, hout, ↓reduceIte, hz, zero_add]; rfl
      · have hout : isOut24Idx k.val = false := by
          dsimp [isOut24Idx]; rw [decide_eq_false_iff_not]; omega
        have hz : unpackMask67 m k = 0 :=
          unpackMask67_pack13Mask_of_ge13 γ (by omega) k.isLt
        rw [hδ67_out k hout, hz, add_zero]
        exact hClean (Fin.castAdd 9 k) (by dsimp; omega)
  refine ⟨fun i ↦ ?_, fun j ↦ ?_⟩
  · rw [hEvalFull]
    change unpackMask76 (runMask67 fullGates67 m) (Fin.castAdd 9 i) +
        δ76 (Fin.castAdd 9 i) = head67CleanMap γ67 i
    have hUnpEq :
        unpackMask76 (runMask67 fullGates67 m) (Fin.castAdd 9 i) =
          unpackMask67 (runMask67 fullGates67 m) i := rfl
    have hδEq : δ76 (Fin.castAdd 9 i) = δ67 i := rfl
    rw [hUnpEq, hδEq, hγ67_decomp, head67CleanMap_add_out24 _ δ67 hδ67_out,
      head67CleanMap_unpackMask67_of_lt8192 hm]
    rfl
  · rw [hEvalFull]
    change unpackMask76 (runMask67 fullGates67 m) (Fin.natAdd 67 j) +
        δ76 (Fin.natAdd 67 j) = 0
    have hout : isOut24Wire76 (Fin.natAdd 67 j) = false := by
      dsimp [isOut24Wire76]; rw [decide_eq_false_iff_not]; omega
    rw [hδ76_out _ hout, add_zero]
    dsimp [unpackMask76]
    have htb : (runMask67 fullGates67 m).testBit (67 + j.val) = false :=
