theorem not_badAncBool_eq_goodAncPred152 (α : BitAssignment 152) :
    (!badAncBool (α (rAnc_152 1) == 1) (α (rAnc_152 2) == 1) (α (rAnc_152 3) == 1)
        (α (rAnc_152 4) == 1) (α (rAnc_152 5) == 1) (α (rAnc_152 6) == 1)
        (α (rAnc_152 7) == 1) (α wEnC0Head_152 == 1)) =
      goodAncPred152 α := by
  have hpoly : b2z (badAncBool (α (rAnc_152 1) == 1) (α (rAnc_152 2) == 1)
      (α (rAnc_152 3) == 1) (α (rAnc_152 4) == 1) (α (rAnc_152 5) == 1)
      (α (rAnc_152 6) == 1) (α (rAnc_152 7) == 1) (α wEnC0Head_152 == 1)) =
      b2z (!goodAncPred152 α) := by
    rw [b2z_badAncBool]
    simp only [← zmod2_eq_b2z]
    rw [badAncPoly_eq α]
    unfold goodAncPred152
    by_cases hc : α wEnC0Head_152 = 1
    · rcases bit_cases (α (rAnc_152 1)) with h1 | h1 <;>
        rcases bit_cases (α (rAnc_152 2)) with h2 | h2 <;>
        simp [hc, b2z]
    · by_cases ha : anc8Val152 α < 218 <;> simp [hc, ha, b2z]
  have hbad := b2z_inj hpoly
  rw [hbad, Bool.not_not]


theorem not_badNucBool_eq_goodNucPred152 (α : BitAssignment 152) :
    (!badNucBool (α (rNuc_152 0) == 1) (α (rNuc_152 1) == 1) (α (rNuc_152 2) == 1)
        (α (rNuc_152 3) == 1) (α (rNuc_152 4) == 1) (α (rNuc_152 5) == 1)
        (α (rNuc_152 6) == 1) (α (rNuc_152 7) == 1)
        (α wEnS4Head_152 == 1) (α wEnS0Tail_152 == 1)) =
      goodNucPred152 α := by
  have hpoly : b2z (badNucBool (α (rNuc_152 0) == 1) (α (rNuc_152 1) == 1)
      (α (rNuc_152 2) == 1) (α (rNuc_152 3) == 1) (α (rNuc_152 4) == 1)
      (α (rNuc_152 5) == 1) (α (rNuc_152 6) == 1) (α (rNuc_152 7) == 1)
      (α wEnS4Head_152 == 1) (α wEnS0Tail_152 == 1)) =
      b2z (!goodNucPred152 α) := by
    rw [b2z_badNucBool]
    simp only [← zmod2_eq_b2z]
    rw [badNucPoly_eq α]
    unfold goodNucPred152
    by_cases hs4 : α wEnS4Head_152 = 1
    · rcases bit_cases (α (rNuc_152 0)) with h0 | h0 <;>
        rcases bit_cases (α (rNuc_152 1)) with h1 | h1 <;>
        simp [hs4, b2z]
    · by_cases hs0 : α wEnS0Tail_152 = 1
      · by_cases hn : nuc8Val152 α < 217 <;> simp [hs4, hs0, hn, b2z]
      · by_cases hn : nuc8Val152 α < 218 <;> simp [hs4, hs0, hn, b2z]
  have hbad := b2z_inj hpoly
  rw [hbad, Bool.not_not]


theorem muxFlagsInv152_bool_flags {α : BitAssignment 152} (hα : MuxFlagsInv152 α) :
    let ep := α wEnPos_152 == 1
    let ih := α wIsHead_152 == 1
    let c0 := α wCoin0_152 == 1
    α wEnTail_152 = b2z (etBool ep ih) ∧
    α wEnS0Tail_152 = b2z (s0tBool ep ih c0) ∧
    α wEnS4Head_152 = b2z (s4hBool ep ih c0) ∧
    α wEnC0Head_152 = b2z (c0hBool ep ih c0) := by
  intro ep ih c0
  rcases hα with ⟨hFl, _, hs4h_eq, hc0h_eq, _, _⟩
  obtain ⟨⟨_, hes0, _, heh, het, hs0t, _, _, _, _, _, _⟩, _⟩ := (flagsInv_iff _).mp hFl
  have hr_c0 : rSub128 wCoin0_128 = wCoin0_152 := by ext; rw [rSub128_val]; rfl
  have hr_ih : rSub128 wIsHead_128 = wIsHead_152 := by ext; rw [rSub128_val]; rfl
  rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
    Function.update_of_ne (by decide), rSub128_wEnS0, rSub128_wEnPos, hr_c0] at hes0
  rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
    Function.update_of_ne (by decide), rSub128_wEnHead, rSub128_wEnPos, hr_ih] at heh
  rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
    Function.update_of_ne (by decide), rSub128_wEnTail, rSub128_wEnPos, rSub128_wEnHead] at het
  rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
    Function.update_of_ne (by decide), rSub128_wEnS0Tail, rSub128_wEnS0, rSub128_wEnTail] at hs0t
  have hep_b : α wEnPos_152 = b2z ep := zmod2_eq_b2z _
  have hih_b : α wIsHead_152 = b2z ih := zmod2_eq_b2z _
  have hc0_b : α wCoin0_152 = b2z c0 := zmod2_eq_b2z _
  have het_b : α wEnTail_152 = b2z (etBool ep ih) := by
    rw [het, heh, hep_b, hih_b, ← b2z_and, ← b2z_bne]; rfl
  have hs0t_b : α wEnS0Tail_152 = b2z (s0tBool ep ih c0) := by
    rw [hs0t, hes0, hep_b, hc0_b, het_b, ← b2z_and, ← b2z_and]; rfl
  have hs4h_b : α wEnS4Head_152 = b2z (s4hBool ep ih c0) := by
    rw [hs4h_eq, hes0, hep_b, hc0_b, hs0t_b, ← b2z_and, ← b2z_bne]; rfl
  have hc0h_b : α wEnC0Head_152 = b2z (c0hBool ep ih c0) := by
    rw [hc0h_eq, heh, hep_b, hih_b, hs4h_b, ← b2z_and, ← b2z_bne]; rfl
  exact ⟨het_b, hs0t_b, hs4h_b, hc0h_b⟩


