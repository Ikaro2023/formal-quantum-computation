private theorem ket_localIdxProg_eq {k n : ℕ} (r : QRegister k n) (β : BitAssignment n)
    (l : Fin (2 ^ k)) :
    ∀ M : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ,
      M.mulVec (ket (fun i ↦ β (r i))) l = M l (localIdxProg r β) := by
  intro M
  rw [ket_eq_single_local, Matrix.mulVec_single_one]; rfl


private theorem mulVec_eq_sum_ket {k : ℕ} (ψ : Fin (2 ^ k) → ℂ) :
    ψ = ∑ x : Fin (2 ^ k), ψ x • ket (basisBits k x) := by
  funext y
  rw [Finset.sum_apply]
  have hterm : ∀ x : Fin (2 ^ k),
      (ψ x • ket (basisBits k x)) y = if y = x then ψ x else 0 := by
    intro x
    rw [Pi.smul_apply, smul_eq_mul, ket_eq_single_local]
    have hsymm : (basisBitsEquiv k).symm (basisBits k x) = x :=
      (basisBitsEquiv k).symm_apply_apply x
    rw [hsymm]
    by_cases hyx : y = x <;> simp [hyx]
  simp_rw [hterm]
  simp


private theorem embedUnitary_mul_diagProj_Lift128_eq {n : ℕ}
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (S : BitAssignment 128 → Prop) (U₁ U₂ : Unitary (2 ^ 128))
    (hEq : U₁.1 * diagProj S = U₂.1 * diagProj S) :
    (rFull128.embedUnitary U₁).1 * diagProj (Lift128 rFull128 rExtra9 S) =
      (rFull128.embedUnitary U₂).1 * diagProj (Lift128 rFull128 rExtra9 S) := by
  apply matrix_ext_ket; intro β
  simp only [mul_mulVec_prog, diagProj_mulVec_ket]
  by_cases hL : Lift128 rFull128 rExtra9 S β
  · simp only [hL, ↓reduceIte, QRegister.embedUnitary_val, embedMatrix_mulVec_ket_prog]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    have hcol : U₁.1 l (localIdxProg rFull128 β) = U₂.1 l (localIdxProg rFull128 β) := by
      rw [← ket_localIdxProg_eq rFull128 β l U₁.1, ← ket_localIdxProg_eq rFull128 β l U₂.1]
      have hv := congrArg (fun M ↦ M.mulVec (ket (fun i ↦ β (rFull128 i))) l) hEq
      simp only [mul_mulVec_prog, diagProj_mulVec_ket, hL.1, ↓reduceIte] at hv
      exact hv
    rw [hcol]
  · simp only [hL, ↓reduceIte, Matrix.mulVec_zero]


private theorem diagProj_Lift128_mul_embedUnitary {n : ℕ}
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (S₁ S₂ : BitAssignment 128 → Prop) (U : Unitary (2 ^ 128))
    (hPres : diagProj S₂ * (U.1 * diagProj S₁) = U.1 * diagProj S₁) :
    diagProj (Lift128 rFull128 rExtra9 S₂) *
        ((rFull128.embedUnitary U).1 * diagProj (Lift128 rFull128 rExtra9 S₁)) =
      (rFull128.embedUnitary U).1 * diagProj (Lift128 rFull128 rExtra9 S₁) := by
  apply matrix_ext_ket; intro β
  simp only [mul_mulVec_prog, diagProj_mulVec_ket]
  by_cases hL : Lift128 rFull128 rExtra9 S₁ β
  · simp only [hL, ↓reduceIte, QRegister.embedUnitary_val, embedMatrix_mulVec_ket_prog,
      Matrix.mulVec_sum, Matrix.mulVec_smul]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    by_cases hnz : U.1 l (localIdxProg rFull128 β) = 0
    · simp only [hnz, zero_smul]
    · have hS₂ : S₂ (basisBits 128 l) := by
        have hv := congrArg (fun M ↦ M.mulVec (ket (fun i ↦ β (rFull128 i))) l) hPres
        simp only [mul_mulVec_prog, diagProj_mulVec_ket, hL.1, ↓reduceIte] at hv
        exact mem_of_diagProj_mulVec_eq hv (by rwa [ket_localIdxProg_eq])
      have hLift₂ : Lift128 rFull128 rExtra9 S₂ (writeRegProg β rFull128 (basisBits 128 l)) := by
        refine ⟨?_, fun j ↦ ?_⟩
        · have heq : (fun i ↦ writeRegProg β rFull128 (basisBits 128 l) (rFull128 i)) =
              basisBits 128 l := by
            funext i; exact writeRegProg_apply_reg _ _ _ i
          rwa [heq]
        · have hnot : rExtra9 j ∉ Set.range rFull128.wires := by
            rintro ⟨i, hi⟩
            exact hDisjExtra.ne i j hi
          rw [writeRegProg_apply_of_not_mem _ _ _ _ hnot, hL.2 j]
      rw [diagProj_mulVec_ket, ite_eq_left hLift₂]
  · simp only [hL, ↓reduceIte, Matrix.mulVec_zero]


theorem ket_andComputeIf_of_zero_cert {N : ℕ} (c₁ c₂ anc : Wire N)
    (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc) (α : BitAssignment N) (h0 : α anc = 0) :
    (andComputeIf c₁ c₂ anc).eval.1.mulVec (ket α) =
      ket (Function.update α anc (α c₁ * α c₂)) := by
  simp only [andComputeIf, h₁a, h₂a, ↓reduceDIte]
  exact ket_andCompute_of_zero c₁ c₂ anc h₁a h₂a α h0


theorem ket_andComputeIf_inv_of_eq {N : ℕ} (c₁ c₂ anc : Wire N)
    (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc) (δ : BitAssignment N) (heq : δ anc = δ c₁ * δ c₂) :
    (andComputeIf c₁ c₂ anc).inverse.eval.1.mulVec (ket δ) =
      ket (Function.update δ anc 0) := by
  let δ₀ := Function.update δ anc 0
  have h0 : δ₀ anc = 0 := Function.update_self anc 0 δ
  have hc₁ : δ₀ c₁ = δ c₁ := Function.update_of_ne h₁a 0 δ
  have hc₂ : δ₀ c₂ = δ c₂ := Function.update_of_ne h₂a 0 δ
  have hupd : Function.update δ₀ anc (δ₀ c₁ * δ₀ c₂) = δ := by
    rw [hc₁, hc₂, ← heq]
    funext w
    by_cases hw : w = anc
    · subst hw; simp [δ₀]
    · simp [δ₀, Function.update_of_ne hw]
  have hFwd : (andComputeIf c₁ c₂ anc).eval.1.mulVec (ket δ₀) = ket δ := by
    rw [ket_andComputeIf_of_zero_cert c₁ c₂ anc h₁a h₂a δ₀ h0, hupd]
  rw [← hFwd, ← mul_mulVec_prog, Circuit.eval_inverse]
  have hL : ((andComputeIf c₁ c₂ anc).eval⁻¹).1 * (andComputeIf c₁ c₂ anc).eval.1 = 1 :=
    unitary_inv_mul_val_cert (andComputeIf c₁ c₂ anc).eval
  rw [hL, Matrix.one_mulVec]


def rHead76Of {n : ℕ} (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
