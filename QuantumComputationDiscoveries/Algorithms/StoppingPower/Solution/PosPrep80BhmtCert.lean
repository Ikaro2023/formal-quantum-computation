theorem evalProg152_pJa8_stage {α δ0 : BitAssignment 152} (hα : MuxFlagsInv152 α)
    (hδ0_out : ∀ w : Wire 152, ¬(86 ≤ w.val ∧ w.val < 116) → ¬(124 ≤ w.val ∧ w.val < 128) →
      δ0 w = α w)
    (hc29_δ0 : δ0 (scr30_152 29) = b2z (!decide (fine30Val152 α < mThresh4 (dpPop3_152 α)))) :
    evalProg152 pJa8Steps152 δ0 (scr21_152 16) = 0 ∧
    evalProg152 pJa8Steps152 δ0 (scr21_152 17) = 0 ∧
    evalProg152 pJa8Steps152 δ0 (scr21_152 18) =
      b2z ((α wEnPos_152 == 1) && goodJointPred152 α && goodAncPred152 α) := by
  obtain ⟨het_b, _, hs4h_b, hc0h_b⟩ := muxFlagsInv152_bool_flags hα
  obtain ⟨hδ1_16, hδ1_17, hδ1_18⟩ := evalProg152_pJa8_bool δ0
    (α (rAnc_152 1) == 1) (α (rAnc_152 2) == 1) (α (rAnc_152 3) == 1)
    (α (rAnc_152 4) == 1) (α (rAnc_152 5) == 1) (α (rAnc_152 6) == 1)
    (α (rAnc_152 7) == 1) (!decide (fine30Val152 α < mThresh4 (dpPop3_152 α)))
    (α wEnPos_152 == 1) (α wIsHead_152 == 1) (α wCoin0_152 == 1)
    (initJa_of_out (!decide (fine30Val152 α < mThresh4 (dpPop3_152 α)))
      het_b hs4h_b hc0h_b hα.2.2.2.2.1 hδ0_out hc29_δ0)
  have hc0h_beq : c0hBool (α wEnPos_152 == 1) (α wIsHead_152 == 1) (α wCoin0_152 == 1) =
      (α wEnC0Head_152 == 1) := by
    apply b2z_inj; rw [← hc0h_b, ← zmod2_eq_b2z]
  have het_beq : etBool (α wEnPos_152 == 1) (α wIsHead_152 == 1) =
      (α wEnTail_152 == 1) := by
    apply b2z_inj; rw [← het_b, ← zmod2_eq_b2z]
  have hJoint : (!((!decide (fine30Val152 α < mThresh4 (dpPop3_152 α))) &&
      etBool (α wEnPos_152 == 1) (α wIsHead_152 == 1))) = goodJointPred152 α := by
    rw [het_beq]
    exact goodJoint_bool_eq (α wEnTail_152 == 1)
      (decide (fine30Val152 α < mThresh4 (dpPop3_152 α)))
  have hAnc : (!badAncBool (α (rAnc_152 1) == 1) (α (rAnc_152 2) == 1)
      (α (rAnc_152 3) == 1) (α (rAnc_152 4) == 1) (α (rAnc_152 5) == 1)
      (α (rAnc_152 6) == 1) (α (rAnc_152 7) == 1)
      (c0hBool (α wEnPos_152 == 1) (α wIsHead_152 == 1) (α wCoin0_152 == 1))) =
      goodAncPred152 α := by
    rw [hc0h_beq]
    exact not_badAncBool_eq_goodAncPred152 α
  rw [hJoint, hAnc] at hδ1_18
  exact ⟨hδ1_16, hδ1_17, hδ1_18⟩


