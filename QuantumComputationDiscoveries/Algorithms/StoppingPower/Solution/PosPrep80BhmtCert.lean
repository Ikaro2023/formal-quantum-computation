theorem writeOut24_preserves_nonOut24 :
    ∀ (ops : List CliffOp76), ops.all checkWriteOut24Op76 = true →
      ∀ (β : BitAssignment 76) (w : Wire 76), isOut24Wire76 w = false →
        (compileCliff76 ops).eval β w = β w
  | [], _, _, _, _ => rfl
  | op :: ops, h, β, w, hw => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      simp only [compileCliff76, CliffProg.eval]
      rw [writeOut24_preserves_nonOut24 ops h.2 _ w hw]
      cases op with
      | x q =>
          have hq : isOut24Wire76 q = true := h.1
          have hne : w ≠ q := fun heq ↦ by rw [heq, hq] at hw; cases hw
          simp [compileCliffOp76, CliffProg.eval, Function.update_of_ne hne]
      | cnot c t =>
          simp only [checkWriteOut24Op76, Bool.and_eq_true, decide_eq_true_eq] at h
          have ht : isOut24Wire76 t = true := h.1.2
          have hne : w ≠ t := fun heq ↦ by rw [heq, ht] at hw; cases hw
          simp [compileCliffOp76_cnot_ne h.1.1.1, CliffProg.eval, Function.update_of_ne hne]


theorem scopedCliff_supportsBelow (bound : ℕ) :
    ∀ (ops : List CliffOp76), ops.all (checkScopedOp76 bound) = true →
      (compileCliff76 ops).SupportsBelow bound
  | [], _ => trivial
  | op :: ops, h => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      refine ⟨?_, scopedCliff_supportsBelow bound ops h.2⟩
      cases op with
      | x q =>
          simp only [checkScopedOp76, Bool.and_eq_true, decide_eq_true_eq] at h
          exact h.1.1
      | cnot c t =>
          simp only [checkScopedOp76, Bool.and_eq_true, decide_eq_true_eq] at h
          simp [compileCliffOp76_cnot_ne h.1.1.1.1.1, CliffProg.SupportsBelow, h.1.1.1.1.2,
            h.1.1.1.2]


theorem scopedCliff_preserves_out24_and_depends_nonOut24 (bound : ℕ) :
    ∀ (ops : List CliffOp76), ops.all (checkScopedOp76 bound) = true →
      (∀ (β : BitAssignment 76) (w : Wire 76), isOut24Wire76 w = true →
        (compileCliff76 ops).eval β w = β w ∧ (compileCliff76 ops).inv.eval β w = β w) ∧
      (∀ (β₁ β₂ : BitAssignment 76),
        (∀ u : Wire 76, isOut24Wire76 u = false → β₁ u = β₂ u) →
        ∀ (w : Wire 76), isOut24Wire76 w = false →
          (compileCliff76 ops).inv.eval β₁ w = (compileCliff76 ops).inv.eval β₂ w)
  | [], _ => ⟨fun _ _ _ ↦ ⟨rfl, rfl⟩, fun _ _ hEq w hw ↦ hEq w hw⟩
  | op :: ops, h => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      obtain ⟨ihOut, ihDep⟩ := scopedCliff_preserves_out24_and_depends_nonOut24 bound ops h.2
      have hopOut : ∀ (β : BitAssignment 76) (w : Wire 76), isOut24Wire76 w = true →
          (compileCliffOp76 op).eval β w = β w ∧ (compileCliffOp76 op).inv.eval β w = β w := by
        intro β w hw
        cases op with
        | x q =>
            simp only [checkScopedOp76, Bool.and_eq_true, Bool.not_eq_true'] at h
            have hne : w ≠ q := fun heq ↦ by rw [heq, h.1.2] at hw; cases hw
            simp [compileCliffOp76, CliffProg.inv, CliffProg.eval, Function.update_of_ne hne]
        | cnot c t =>
            simp only [checkScopedOp76, Bool.and_eq_true, Bool.not_eq_true', decide_eq_true_eq] at h
            have hne : w ≠ t := fun heq ↦ by rw [heq, h.1.2] at hw; cases hw
            simp [compileCliffOp76_cnot_ne h.1.1.1.1.1, CliffProg.inv, CliffProg.eval,
              Function.update_of_ne hne]
      have hopDep : ∀ (β₁ β₂ : BitAssignment 76),
          (∀ u : Wire 76, isOut24Wire76 u = false → β₁ u = β₂ u) →
          ∀ (w : Wire 76), isOut24Wire76 w = false →
            (compileCliffOp76 op).inv.eval β₁ w = (compileCliffOp76 op).inv.eval β₂ w := by
        intro β₁ β₂ hEq w hw
        cases op with
        | x q =>
            dsimp only [compileCliffOp76, CliffProg.inv, CliffProg.eval]
            by_cases hwq : w = q
            · subst hwq; simp [hEq w hw]
            · simp [Function.update_of_ne hwq, hEq w hw]
        | cnot c t =>
            simp only [checkScopedOp76, Bool.and_eq_true, Bool.not_eq_true', decide_eq_true_eq] at h
            simp only [compileCliffOp76_cnot_ne h.1.1.1.1.1, CliffProg.inv, CliffProg.eval]
            by_cases hwt : w = t
            · subst hwt; simp [hEq w hw, hEq c h.1.1.2]
            · simp [Function.update_of_ne hwt, hEq w hw]
      refine ⟨fun β w hw ↦ ?_, fun β₁ β₂ hEq w hw ↦ ?_⟩
      · simp only [compileCliff76, CliffProg.inv, CliffProg.eval]
        rw [(ihOut _ w hw).1, (hopOut β w hw).1, (hopOut _ w hw).2, (ihOut β w hw).2]
        exact ⟨rfl, rfl⟩
      · simp only [compileCliff76, CliffProg.inv, CliffProg.eval]
        exact hopDep _ _ (fun u hu ↦ ihDep β₁ β₂ hEq u hu) w hw


theorem checkCore76_sound :
    ∀ (p : RevProg76) (rem : ℕ), rem ≤ 39 → checkCore76 rem p = true →
      ValidCleanRem 76 rem (compile76 p) ∧
      (∀ (β : BitAssignment 76), cleanRem 76 rem β →
        ∀ (w : Wire 76), isOut24Wire76 w = false → (compile76 p).evalBits β w = β w)
  | .nil, _, _, _ => ⟨trivial, fun _ _ _ _ ↦ rfl⟩
  | .cliff ops, _, _, h =>
      ⟨trivial, fun β _ w hw ↦ writeOut24_preserves_nonOut24 ops h β w hw⟩
  | .seq p₁ p₂, rem, hrem, h => by
      have hrem76 : rem ≤ 76 := Nat.le_trans hrem (by decide)
      simp only [checkCore76, Bool.and_eq_true] at h
      obtain ⟨hv₁, hp₁⟩ := checkCore76_sound p₁ rem hrem h.1
      obtain ⟨hv₂, hp₂⟩ := checkCore76_sound p₂ rem hrem h.2
      have hCleanMid : ∀ β : BitAssignment 76, cleanRem 76 rem β →
          cleanRem 76 rem ((compile76 p₁).evalBits β) := by
        intro β hβ w hw
        have hout : isOut24Wire76 w = false := by
          dsimp [isOut24Wire76]; rw [decide_eq_false_iff_not]; omega
        rw [hp₁ β hβ w hout]
        exact hβ w hw
      exact ⟨⟨rem, hrem76, hv₁, hv₂, hCleanMid⟩, fun β hβ w hw ↦ by
        simp only [compile76, TempPhaseProg.evalBits]
        rw [hp₂ _ (hCleanMid β hβ) w hw, hp₁ β hβ w hw]⟩
  | .withCliff ops body, rem, hrem, h => by
      have hrem76 : rem ≤ 76 := Nat.le_trans hrem (by decide)
      simp only [checkCore76, Bool.and_eq_true] at h
      obtain ⟨hvB, hpB⟩ := checkCore76_sound body rem hrem h.2
      let c := compileCliff76 ops
      have hSup : c.SupportsBelow (76 - rem) := scopedCliff_supportsBelow (76 - rem) ops h.1
      obtain ⟨_, hDep⟩ := scopedCliff_preserves_out24_and_depends_nonOut24 (76 - rem) ops h.1
      have hCleanC : ∀ β : BitAssignment 76, cleanRem 76 rem β → cleanRem 76 rem (c.eval β) := by
        intro β hβ w hw
        rw [CliffProg.eval_outside c hSup β w hw]
        exact hβ w hw
      have hPres : ∀ (β : BitAssignment 76), cleanRem 76 rem β →
          ∀ (w : Wire 76), isOut24Wire76 w = false →
            (compile76 (.withCliff ops body)).evalBits β w = β w := by
        intro β hβ w hw
        simp only [compile76, TempPhaseProg.evalBits]
        let β₁ := c.eval β
        let β₂ := (compile76 body).evalBits β₁
        have hEq12 : ∀ u : Wire 76, isOut24Wire76 u = false → β₂ u = β₁ u :=
          fun u hu ↦ hpB β₁ (hCleanC β hβ) u hu
        rw [hDep β₂ β₁ hEq12 w hw]
        change c.inv.eval (c.eval β) w = β w
        rw [CliffProg.inv_eval]
      have hCleanAfterBody : ∀ γ : BitAssignment 76, cleanRem 76 rem γ →
          cleanRem 76 rem ((compile76 body).evalBits γ) := by
        intro γ hγ w hw
        have hout : isOut24Wire76 w = false := by
          dsimp [isOut24Wire76]; rw [decide_eq_false_iff_not]; omega
        rw [hpB γ hγ w hout]
        exact hγ w hw
      refine ⟨⟨rem, hrem76, trivial, ⟨rem, hrem76, hvB, trivial, hCleanAfterBody⟩, hCleanC⟩, hPres⟩
  | .tempAnd c₁ c₂ anc body, rem, _, h => by
      simp only [checkCore76, Bool.and_eq_true, Bool.not_eq_true', decide_eq_true_eq] at h
      rcases h with ⟨⟨⟨⟨⟨⟨⟨⟨h12, h1a⟩, h2a⟩, hanc37⟩, hancLo⟩, hc1Out⟩, hc2Out⟩, hancOut⟩, hBody⟩
      let rem' := 76 - (anc.val + 1)
      have hrem' : rem' ≤ 39 := by omega
      obtain ⟨hvB, hpB⟩ := checkCore76_sound body rem' hrem' hBody
      have hValid : ValidCleanRem 76 rem (compile76 (.tempAnd c₁ c₂ anc body)) := by
        rw [compile76_tempAnd_ne h12 h1a h2a]
        refine ⟨hancLo, hvB, fun β₁ hβ₁ ↦ ?_⟩
        exact ⟨hpB β₁ hβ₁ c₁ hc1Out, hpB β₁ hβ₁ c₂ hc2Out, hpB β₁ hβ₁ anc hancOut⟩
      refine ⟨hValid, fun β hβ w hw ↦ ?_⟩
      rw [compile76_tempAnd_ne h12 h1a h2a]
      dsimp [TempPhaseProg.evalBits]
      let β₁ := Function.update β anc (β anc + β c₁ * β c₂)
      have hβ₁ : cleanRem 76 rem' β₁ := by
        intro u hu
        have hne : u ≠ anc := wire_ne_of_gt (by dsimp [rem'] at hu; omega)
        dsimp [β₁]
        rw [Function.update_of_ne hne]
        exact hβ u (by dsimp [rem'] at hu; omega)
      change Function.update ((compile76 body).evalBits β₁) anc
        ((compile76 body).evalBits β₁ anc +
          (compile76 body).evalBits β₁ c₁ * (compile76 body).evalBits β₁ c₂) w = β w
      by_cases hwa : w = anc
      · subst hwa
        rw [Function.update_self, hpB β₁ hβ₁ w hancOut, hpB β₁ hβ₁ c₁ hc1Out,
          hpB β₁ hβ₁ c₂ hc2Out]
        simp only [β₁, Function.update_self, Function.update_of_ne h1a, Function.update_of_ne h2a]
        rw [add_assoc, CharTwo.add_self_eq_zero, add_zero]
      · rw [Function.update_of_ne hwa, hpB β₁ hβ₁ w hw]
        dsimp [β₁]
        rw [Function.update_of_ne hwa]


theorem fanCnot76_props :
    ∀ (ops : List CliffOp76), ops.all checkFanCnot76 = true →
      (compileCliff76 ops).SupportsBelow 37 ∧
      (∀ (β₁ β₂ : BitAssignment 76),
        (compileCliff76 ops).eval (β₁ + β₂) = (compileCliff76 ops).eval β₁ +
          (compileCliff76 ops).eval β₂ ∧
        (compileCliff76 ops).inv.eval (β₁ + β₂) =
          (compileCliff76 ops).inv.eval β₁ + (compileCliff76 ops).inv.eval β₂) ∧
      (∀ (β : BitAssignment 76) (w : Wire 76), isOut24Wire76 w = false →
        (compileCliff76 ops).eval β w = β w ∧ (compileCliff76 ops).inv.eval β w = β w)
  | [], _ => ⟨trivial, fun _ _ ↦ ⟨rfl, rfl⟩, fun _ _ _ ↦ ⟨rfl, rfl⟩⟩
  | op :: ops, h => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      obtain ⟨ihSup, ihLin, ihNon⟩ := fanCnot76_props ops h.2
      cases op with
      | x q => simp [checkFanCnot76] at h
      | cnot c t =>
          simp only [checkFanCnot76, Bool.and_eq_true, decide_eq_true_eq] at h
          rcases h.1 with ⟨⟨hct, hcOut⟩, htOut⟩
          have hc37 : c.val < 37 := by
            dsimp [isOut24Wire76] at hcOut; rw [decide_eq_true_eq] at hcOut; omega
          have ht37 : t.val < 37 := by
            dsimp [isOut24Wire76] at htOut; rw [decide_eq_true_eq] at htOut; omega
          have hopLin : ∀ (α₁ α₂ : BitAssignment 76),
              (compileCliffOp76 (.cnot c t)).eval (α₁ + α₂) =
                (compileCliffOp76 (.cnot c t)).eval α₁ + (compileCliffOp76 (.cnot c t)).eval α₂ :=
                  by
            intro α₁ α₂; funext w
            simp only [compileCliffOp76_cnot_ne hct, CliffProg.eval]
            by_cases hwt : w = t
            · subst hwt; simp only [Function.update_self, Pi.add_apply]; ring
            · simp only [Function.update_of_ne hwt, Pi.add_apply]
          have hopInv : (compileCliffOp76 (.cnot c t)).inv = compileCliffOp76 (.cnot c t) := by
            simp [compileCliffOp76_cnot_ne hct, CliffProg.inv]
          have hopNon : ∀ (α : BitAssignment 76) (w : Wire 76), isOut24Wire76 w = false →
              (compileCliffOp76 (.cnot c t)).eval α w = α w := by
            intro α w hw
            have hne : w ≠ t := fun heq ↦ by rw [heq, htOut] at hw; cases hw
            simp [compileCliffOp76_cnot_ne hct, CliffProg.eval, Function.update_of_ne hne]
          refine ⟨⟨by simp [compileCliffOp76_cnot_ne hct, CliffProg.SupportsBelow, hc37, ht37],
            ihSup⟩,
            fun β₁ β₂ ↦ ?_, fun β w hw ↦ ?_⟩
          · simp only [compileCliff76, CliffProg.inv, CliffProg.eval, hopInv]
            rw [hopLin β₁ β₂, (ihLin _ _).1, (ihLin β₁ β₂).2, hopLin]
            exact ⟨rfl, rfl⟩
          · simp only [compileCliff76, CliffProg.inv, CliffProg.eval, hopInv]
            rw [(ihNon _ w hw).1, hopNon β w hw, hopNon _ w hw, (ihNon β w hw).2]
            exact ⟨rfl, rfl⟩


theorem writeOut24_add_out24 :
    ∀ (ops : List CliffOp76), ops.all checkWriteOut24Op76 = true →
      ∀ (β δ : BitAssignment 76), (∀ w : Wire 76, isOut24Wire76 w = false → δ w = 0) →
        (compileCliff76 ops).eval (β + δ) = (compileCliff76 ops).eval β + δ
  | [], _, _, _, _ => rfl
  | op :: ops, h, β, δ, hδ => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      simp only [compileCliff76, CliffProg.eval]
      have hop : (compileCliffOp76 op).eval (β + δ) = (compileCliffOp76 op).eval β + δ := by
        funext w
        cases op with
        | x q =>
            simp only [compileCliffOp76, CliffProg.eval]
            by_cases hwq : w = q
            · subst hwq; simp only [Function.update_self, Pi.add_apply]; ring
            · simp only [Function.update_of_ne hwq, Pi.add_apply]
        | cnot c t =>
            simp only [checkWriteOut24Op76, Bool.and_eq_true, Bool.not_eq_true',
              decide_eq_true_eq] at h
            simp only [compileCliffOp76_cnot_ne h.1.1.1, CliffProg.eval]
            by_cases hwt : w = t
            · subst hwt
              simp only [Function.update_self, Pi.add_apply, hδ c h.1.1.2, add_zero]
              ring
            · simp only [Function.update_of_ne hwt, Pi.add_apply]
      rw [hop, writeOut24_add_out24 ops h.2 _ δ hδ]


theorem scopedCliff_add_out24 (bound : ℕ) :
    ∀ (ops : List CliffOp76), ops.all (checkScopedOp76 bound) = true →
      ∀ (β δ : BitAssignment 76), (∀ w : Wire 76, isOut24Wire76 w = false → δ w = 0) →
        (compileCliff76 ops).eval (β + δ) = (compileCliff76 ops).eval β + δ ∧
        (compileCliff76 ops).inv.eval (β + δ) = (compileCliff76 ops).inv.eval β + δ
  | [], _, _, _, _ => ⟨rfl, rfl⟩
  | op :: ops, h, β, δ, hδ => by
      simp only [List.all_cons, Bool.and_eq_true] at h
      have ih := scopedCliff_add_out24 bound ops h.2
      have hop : ∀ γ : BitAssignment 76,
          (compileCliffOp76 op).eval (γ + δ) = (compileCliffOp76 op).eval γ + δ ∧
          (compileCliffOp76 op).inv.eval (γ + δ) = (compileCliffOp76 op).inv.eval γ + δ := by
        intro γ
        cases op with
        | x q =>
            simp only [checkScopedOp76, Bool.and_eq_true, Bool.not_eq_true'] at h
            have heq : Function.update (γ + δ) q ((γ + δ) q + 1) =
                Function.update γ q (γ q + 1) + δ := by
              funext w
              by_cases hwq : w = q
              · subst hwq; simp only [Function.update_self, Pi.add_apply, hδ w h.1.2, add_zero]
              · simp only [Function.update_of_ne hwq, Pi.add_apply]
            exact ⟨heq, heq⟩
        | cnot c t =>
            simp only [checkScopedOp76, Bool.and_eq_true, Bool.not_eq_true', decide_eq_true_eq] at h
            have heq : Function.update (γ + δ) t ((γ + δ) t + (γ + δ) c) =
                Function.update γ t (γ t + γ c) + δ := by
              funext w
              by_cases hwt : w = t
              · subst hwt
                simp only [Function.update_self, Pi.add_apply, hδ w h.1.2, hδ c h.1.1.2, add_zero]
              · simp only [Function.update_of_ne hwt, Pi.add_apply]
            simp only [compileCliffOp76_cnot_ne h.1.1.1.1.1, CliffProg.inv, CliffProg.eval]
            exact ⟨heq, heq⟩
      simp only [compileCliff76, CliffProg.inv, CliffProg.eval]
      rw [(hop β).1, (ih _ δ hδ).1, (ih β δ hδ).2, (hop _).2]
      exact ⟨rfl, rfl⟩


theorem checkCore76_add_out24 :
    ∀ (p : RevProg76) (rem : ℕ), checkCore76 rem p = true →
      ∀ (β δ : BitAssignment 76), (∀ w : Wire 76, isOut24Wire76 w = false → δ w = 0) →
        (compile76 p).evalBits (β + δ) = (compile76 p).evalBits β + δ
  | .nil, _, _, _, _, _ => rfl
  | .cliff ops, _, h, β, δ, hδ => writeOut24_add_out24 ops h β δ hδ
  | .seq p₁ p₂, rem, h, β, δ, hδ => by
      simp only [checkCore76, Bool.and_eq_true] at h
      simp only [compile76, TempPhaseProg.evalBits,
        checkCore76_add_out24 p₁ rem h.1 β δ hδ,
        checkCore76_add_out24 p₂ rem h.2 _ δ hδ]
  | .withCliff ops body, rem, h, β, δ, hδ => by
      simp only [checkCore76, Bool.and_eq_true] at h
      simp only [compile76, TempPhaseProg.evalBits,
        (scopedCliff_add_out24 (76 - rem) ops h.1 β δ hδ).1,
        checkCore76_add_out24 body rem h.2 _ δ hδ,
        (scopedCliff_add_out24 (76 - rem) ops h.1 _ δ hδ).2]
  | .tempAnd c₁ c₂ anc body, rem, h, β, δ, hδ => by
      simp only [checkCore76, Bool.and_eq_true, Bool.not_eq_true', decide_eq_true_eq] at h
      rcases h with ⟨⟨⟨⟨⟨⟨⟨⟨h12, h1a⟩, h2a⟩, _⟩, _⟩, hc1Out⟩, hc2Out⟩, hancOut⟩, hBody⟩
      have hupd : ∀ γ : BitAssignment 76,
          Function.update (γ + δ) anc ((γ + δ) anc + (γ + δ) c₁ * (γ + δ) c₂) =
            Function.update γ anc (γ anc + γ c₁ * γ c₂) + δ := by
        intro γ; funext w
        by_cases hwa : w = anc
        · subst hwa
          simp only [Function.update_self, Pi.add_apply, hδ w hancOut, hδ c₁ hc1Out, hδ c₂ hc2Out,
            add_zero]
        · simp only [Function.update_of_ne hwa, Pi.add_apply]
      rw [compile76_tempAnd_ne h12 h1a h2a]
      dsimp only [TempPhaseProg.evalBits]
      rw [hupd β, checkCore76_add_out24 body (76 - (anc.val + 1)) hBody _ δ hδ, hupd]


private theorem runMask76_append :
    ∀ (l₁ l₂ : List RevGate76) (m : ℕ),
      runMask76 (l₁ ++ l₂) m = runMask76 l₂ (runMask76 l₁ m)
  | [], _, _ => rfl
  | _ :: l₁, l₂, m => runMask76_append l₁ l₂ (stepMask76 _ m)


private theorem runMask67_append_cert :
    ∀ (l₁ l₂ : List RevGate67) (m : ℕ),
      runMask67 (l₁ ++ l₂) m = runMask67 l₂ (runMask67 l₁ m)
  | [], _, _ => rfl
  | _ :: l₁, l₂, m => runMask67_append_cert l₁ l₂ (stepMask67 _ m)


private theorem unpackMask76_xor_two_pow (m : ℕ) (t : Fin 76) :
    unpackMask76 (m ^^^ (2 ^ t.val)) =
      Function.update (unpackMask76 m) t (unpackMask76 m t + 1) := by
  funext q
  by_cases hqt : q = t
  · subst hqt
    rw [Function.update_self]
    dsimp only [unpackMask76]
    rw [Nat.testBit_xor, Nat.testBit_two_pow, decide_eq_true rfl]
    cases m.testBit q.val <;> decide
  · rw [Function.update_of_ne hqt]
    have hne : t.val ≠ q.val := fun h ↦ hqt (Fin.ext h.symm)
    dsimp only [unpackMask76]
    rw [Nat.testBit_xor, Nat.testBit_two_pow, decide_eq_false hne]
    cases m.testBit q.val <;> rfl


theorem compileCliffOp76_eval_unpackMask76 (op : CliffOp76) (hw : wfCliffOp76 op = true)
    (m : ℕ) :
    (compileCliffOp76 op).eval (unpackMask76 m) =
      unpackMask76 (stepMask76 (flattenOp76 op) m) ∧
    (compileCliffOp76 op).inv.eval (unpackMask76 m) =
      unpackMask76 (stepMask76 (flattenOp76 op) m) := by
  cases op with
  | x q =>
      simp only [compileCliffOp76, CliffProg.inv, CliffProg.eval, flattenOp76, stepMask76]
      rw [unpackMask76_xor_two_pow]
      exact ⟨rfl, rfl⟩
  | cnot c t =>
      simp only [wfCliffOp76, decide_eq_true_eq] at hw
      simp only [compileCliffOp76_cnot_ne hw, CliffProg.inv, CliffProg.eval,
        flattenOp76, stepMask76]
      have heq : Function.update (unpackMask76 m) t (unpackMask76 m t + unpackMask76 m c) =
          unpackMask76 (if m.testBit c.val then m ^^^ (2 ^ t.val) else m) := by
        dsimp only [unpackMask76]
        cases hc : m.testBit c.val
        · simp only [Bool.false_eq_true, ↓reduceIte, add_zero]
          exact Function.update_eq_self t (unpackMask76 m)
        · simp only [↓reduceIte]
          exact (unpackMask76_xor_two_pow m t).symm
      exact ⟨heq, heq⟩


theorem compileCliff76_eval_unpackMask76 :
    ∀ (ops : List CliffOp76), ops.all wfCliffOp76 = true → ∀ (m : ℕ),
      (compileCliff76 ops).eval (unpackMask76 m) =
        unpackMask76 (runMask76 (flattenCliff76 ops) m) ∧
      (compileCliff76 ops).inv.eval (unpackMask76 m) =
        unpackMask76 (runMask76 (flattenCliff76 ops).reverse m)
  | [], _, _ => ⟨rfl, rfl⟩
  | op :: ops, hw, m => by
      simp only [List.all_cons, Bool.and_eq_true] at hw
      have hfc : flattenCliff76 (op :: ops) = flattenOp76 op :: flattenCliff76 ops := rfl
      refine ⟨?_, ?_⟩
      · simp only [compileCliff76, CliffProg.eval, hfc, runMask76]
        rw [(compileCliffOp76_eval_unpackMask76 op hw.1 m).1,
          (compileCliff76_eval_unpackMask76 ops hw.2 _).1]
      · simp only [compileCliff76, CliffProg.inv, CliffProg.eval, hfc, List.reverse_cons]
