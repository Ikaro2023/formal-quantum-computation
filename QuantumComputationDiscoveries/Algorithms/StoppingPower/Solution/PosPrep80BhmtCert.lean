theorem fin_sum_restrict_zero {n M : ℕ} {V : Type*} [AddCommMonoid V]
    (hMN : M ≤ n) (f : Fin n → V)
    (hzero : ∀ j : Fin n, M ≤ j.val → f j = 0) :
    (∑ j : Fin n, f j) =
      ∑ k : Fin M, f ⟨k.val, Nat.lt_of_lt_of_le k.isLt hMN⟩ := by
  let emb : Fin M ↪ Fin n :=
    ⟨fun k ↦ ⟨k.val, Nat.lt_of_lt_of_le k.isLt hMN⟩,
     fun a b h ↦ by cases a; cases b; injection h with h'; exact Fin.ext h'⟩
  symm
  refine (Finset.sum_map Finset.univ emb f).symm.trans ?_
  refine Finset.sum_subset (Finset.subset_univ _) fun j _ hj ↦ ?_
  have hge : M ≤ j.val := by
    by_contra hlt
    exact hj (Finset.mem_map.mpr ⟨⟨j.val, Nat.lt_of_not_ge hlt⟩, Finset.mem_univ _, Fin.ext rfl⟩)
  exact hzero j hge


