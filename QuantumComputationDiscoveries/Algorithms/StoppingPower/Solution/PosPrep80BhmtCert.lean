        _ = (u e).1 * (P * (((tail.map g).map u).prod).1) := congrArg ((u e).1 * ·) hih
        _ = ((u e).1 * P) * (((tail.map g).map u).prod).1 := (Matrix.mul_assoc _ _ _).symm
        _ = (P * (u (g e)).1) * (((tail.map g).map u).prod).1 := congrArg (· * _) he
