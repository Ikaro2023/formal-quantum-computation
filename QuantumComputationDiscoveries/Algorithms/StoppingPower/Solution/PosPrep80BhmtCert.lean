private theorem writeData48_regs (α : BitAssignment 152) (b1 : Fin (2 ^ 3)) (fine : Fin (2 ^ 30))
    (ancHi : Fin (2 ^ 7)) (nuc : Fin (2 ^ 8)) :
    let δ := writeData48 α (b1, fine, ancHi, nuc)
    (∀ j : Fin 3, δ (rB1_152 j) = basisBits 3 b1 j) ∧
    (∀ j : Fin 30, δ (rFine30_152 j) = basisBits 30 fine j) ∧
    (∀ j : Fin 7, δ (rAnc7_152 j) = basisBits 7 ancHi j) ∧
    (∀ j : Fin 8, δ (rNuc_152 j) = basisBits 8 nuc j) := by
  intro δ
  refine ⟨fun j ↦ ?_, fun j ↦ ?_, fun j ↦ ?_, fun j ↦ ?_⟩
  · dsimp only [δ, writeData48]
    rw [writeReg_mkBlock152_outside 12 _ _ _ _ (by dsimp [rB1_152, mkBlock152]; omega),
      writeReg_mkBlock152_outside 21 _ _ _ _ (by dsimp [rB1_152, mkBlock152]; omega),
      writeReg_mkBlock152_outside 38 _ _ _ _ (by dsimp [rB1_152, mkBlock152]; omega),
      ZeroAncillaUSPS3.writeReg_apply_reg]
  · dsimp only [δ, writeData48]
    rw [writeReg_mkBlock152_outside 12 _ _ _ _ (by dsimp [rFine30_152, mkBlock152]; omega),
      writeReg_mkBlock152_outside 21 _ _ _ _ (by dsimp [rFine30_152, mkBlock152]; omega),
      ZeroAncillaUSPS3.writeReg_apply_reg]
  · dsimp only [δ, writeData48]
    rw [writeReg_mkBlock152_outside 12 _ _ _ _ (by dsimp [rAnc7_152, mkBlock152]; omega),
      ZeroAncillaUSPS3.writeReg_apply_reg]
  · dsimp only [δ, writeData48]
    rw [ZeroAncillaUSPS3.writeReg_apply_reg]


theorem writeData48_injective (α : BitAssignment 152) :
    Function.Injective (writeData48 α) := by
  rintro ⟨b1, fine, ancHi, nuc⟩ ⟨b1', fine', ancHi', nuc'⟩ h
  obtain ⟨hb1, hfine, hanc, hnuc⟩ := writeData48_regs α b1 fine ancHi nuc
  obtain ⟨hb1', hfine', hanc', hnuc'⟩ := writeData48_regs α b1' fine' ancHi' nuc'
  have eb1 : b1 = b1' := (basisBitsEquiv 3).injective (funext fun j ↦ by
    change basisBits 3 b1 j = basisBits 3 b1' j
    rw [← hb1 j, ← hb1' j, h])
  have efine : fine = fine' := (basisBitsEquiv 30).injective (funext fun j ↦ by
    change basisBits 30 fine j = basisBits 30 fine' j
    rw [← hfine j, ← hfine' j, h])
  have eanc : ancHi = ancHi' := (basisBitsEquiv 7).injective (funext fun j ↦ by
    change basisBits 7 ancHi j = basisBits 7 ancHi' j
    rw [← hanc j, ← hanc' j, h])
  have enuc : nuc = nuc' := (basisBitsEquiv 8).injective (funext fun j ↦ by
    change basisBits 8 nuc j = basisBits 8 nuc' j
    rw [← hnuc j, ← hnuc' j, h])
  subst eb1 efine eanc enuc
  rfl


theorem muxFlagsInv152_writeData48 {α : BitAssignment 152} (hMux : MuxFlagsInv152 α)
    (d : Data48Tuple) :
    MuxFlagsInv152 (writeData48 α d) := by
  rcases hMux with ⟨hFl, hc0t, hs4h, hc0h, hscr21, htele⟩
  obtain ⟨hCore, hscr30⟩ := (flagsInv_iff _).mp hFl
  have hout : ∀ w : Wire 152, (w.val < 6 ∨ w = wIsHead_152 ∨ 86 ≤ w.val) →
      writeData48 α d w = α w := fun w hw ↦ by
    refine writeData48_apply_outside α d w ?_
    rcases hw with h1 | rfl | h3
    · exact Or.inl (by omega)
    · exact Or.inr (Or.inr (Or.inl (by decide)))
    · exact Or.inr (Or.inr (Or.inr (by omega)))
  have hFl' : FlagsInv128 (Function.update (fun i ↦ writeData48 α d (rSub128 i)) wEnC0Head_128 0) :=
    by
    apply (flagsInv_iff _).mpr
    have heqSub : ∀ i : Fin 128, (i.val < 6 ∨ i = wIsHead_128 ∨ 86 ≤ i.val) →
        Function.update (fun k ↦ writeData48 α d (rSub128 k)) wEnC0Head_128 0 i =
          Function.update (fun k ↦ α (rSub128 k)) wEnC0Head_128 0 i := fun i hi ↦ by
      by_cases hic : i = wEnC0Head_128
      · subst hic; simp
      · rw [Function.update_of_ne hic, Function.update_of_ne hic]
        refine hout (rSub128 i) ?_
        rcases hi with h1 | rfl | h3
        · exact Or.inl (by rw [rSub128_val]; exact h1)
        · exact Or.inr (Or.inl (by ext; rw [rSub128_val]; rfl))
        · exact Or.inr (Or.inr (by rw [rSub128_val]; exact h3))
    refine ⟨?_, fun j ↦ ?_⟩
    · dsimp only [flagsCore_of_flagsInv] at hCore ⊢
      rw [heqSub wEnPos_128 (Or.inr (Or.inr (by decide))),
        heqSub wCoin1_128 (Or.inl (by decide)),
        heqSub wCoin2_128 (Or.inl (by decide)),
        heqSub wEnS0_128 (Or.inr (Or.inr (by decide))),
        heqSub wCoin0_128 (Or.inl (by decide)),
        heqSub wEnC0_128 (Or.inr (Or.inr (by decide))),
        heqSub wEnHead_128 (Or.inr (Or.inr (by decide))),
        heqSub wIsHead_128 (Or.inr (Or.inl rfl)),
        heqSub wEnTail_128 (Or.inr (Or.inr (by decide))),
        heqSub wEnS0Tail_128 (Or.inr (Or.inr (by decide))),
        heqSub wEnAnc_128 (Or.inr (Or.inr (by decide))),
        heqSub wEnC0Head_128 (Or.inr (Or.inr (by decide))),
        heqSub wPopT01_128 (Or.inr (Or.inr (by decide))),
        heqSub wPopMaj_128 (Or.inr (Or.inr (by decide))),
        heqSub wPopPar_128 (Or.inr (Or.inr (by decide))),
        heqSub wBrTop_128 (Or.inr (Or.inr (by decide)))]
      exact hCore
    · rw [heqSub (scr30_128 j) (Or.inr (Or.inr (by rw [scr30_128_val]; omega)))]
      exact hscr30 j
  refine ⟨hFl', ?_, ?_, ?_, fun j ↦ ?_, ?_⟩
  · rw [hout _ (Or.inr (Or.inr (by decide))), hout _ (Or.inr (Or.inr (by decide))),
      hout _ (Or.inr (Or.inr (by decide))), hc0t]
  · rw [hout _ (Or.inr (Or.inr (by decide))), hout _ (Or.inr (Or.inr (by decide))),
      hout _ (Or.inr (Or.inr (by decide))), hs4h]
  · rw [hout _ (Or.inr (Or.inr (by decide))), hout _ (Or.inr (Or.inr (by decide))),
      hout _ (Or.inr (Or.inr (by decide))), hc0h]
  · rw [hout _ (Or.inr (Or.inr (by dsimp [scr21_152, mkBlock152]; omega))), hscr21 j]
  · rw [hout _ (Or.inr (Or.inr (by decide))), htele]


