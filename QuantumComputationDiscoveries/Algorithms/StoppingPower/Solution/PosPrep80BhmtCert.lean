/-- Structural boolean check that every gate in a `128`-wire circuit avoids `[3 .. 6)`. -/
private def w7lpCircuitDisj3To6Bool : Circuit 128 → Bool
  | .identity => true
  | .gate (k := k) _ r => (List.finRange k).all fun i ↦ decide ((r i).val < 3 ∨ 6 ≤ (r i).val)
  | .seq c₁ c₂ => w7lpCircuitDisj3To6Bool c₁ && w7lpCircuitDisj3To6Bool c₂

/-- Extracted `[3 .. 6)` computational basis bits on `128` wires. -/
private def w7lpBits3To6_128 (x : Fin (2 ^ 128)) : Fin 3 → ZMod 2 :=
  fun t ↦ basisBits 128 x ⟨3 + t.val, by have := t.isLt; omega⟩

private theorem w7lp_preservesBits3To6_embedMatrix_disj {k : ℕ} {r : QRegister k 128}
    (hr : ∀ i : Fin k, (r i).val < 3 ∨ 6 ≤ (r i).val)
    (A : Operator (2 ^ k)) :
    PreservesFeature w7lpBits3To6_128 (r.embedMatrix A) := by
  intro x y hne
  by_cases hAgree : (r.basisSplitEquiv x).2 = (r.basisSplitEquiv y).2
  · have hOut : r.AgreeOutside x y := (r.basisSplit_environment_eq_iff x y).mp hAgree
    funext t
    dsimp only [w7lpBits3To6_128]
    refine hOut ⟨3 + t.val, by have := t.isLt; omega⟩ ?_
    rintro ⟨idx, hidx⟩
    have hv := congrArg Fin.val hidx
    have ht := t.isLt
    dsimp only at hv
    rcases hr idx with hlt | hge <;> omega
  · simp only [QRegister.embedMatrix_apply, hAgree, ↓reduceIte, mul_zero] at hne
    exact False.elim (hne rfl)

private theorem w7lp_preservesBits3To6_of_circuitDisj3To6Bool :
    ∀ (c : Circuit 128), w7lpCircuitDisj3To6Bool c = true →
      PreservesFeature w7lpBits3To6_128 c.eval.1
  | .identity, _ => PreservesFeature.one _
  | .gate (k := k) _ r, h => by
      rw [Circuit.eval_gate, QRegister.embedUnitary_val]
      have hall := List.all_eq_true.mp h
      exact w7lp_preservesBits3To6_embedMatrix_disj
        (fun idx ↦ of_decide_eq_true (hall idx (List.mem_finRange idx))) _
  | .seq c₁ c₂, h => by
      rw [Circuit.eval_seq, Submonoid.coe_mul]
      have h12 := Bool.and_eq_true_iff.mp h
      exact (w7lp_preservesBits3To6_of_circuitDisj3To6Bool c₂ h12.2).mul
        (w7lp_preservesBits3To6_of_circuitDisj3To6Bool c₁ h12.1)

private theorem w7lp_preservesBits3To6_seq {c₁ c₂ : Circuit 128}
    (h₁ : PreservesFeature w7lpBits3To6_128 c₁.eval.1)
    (h₂ : PreservesFeature w7lpBits3To6_128 c₂.eval.1) :
    PreservesFeature w7lpBits3To6_128 (c₁.seq c₂).eval.1 := by
  rw [Circuit.eval_seq, Submonoid.coe_mul]
  exact h₂.mul h₁

