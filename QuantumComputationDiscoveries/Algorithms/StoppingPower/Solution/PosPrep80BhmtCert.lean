theorem finRange_split_swap_Bhmt (n : ℕ) (anc : Fin (n + 1)) (hpos : 0 < anc.val) :
    ∃ L_mid L_hi : List (Fin (n + 1)),
      List.finRange (n + 1) = (0 : Fin (n + 1)) :: (L_mid ++ anc :: L_hi) ∧
        (∀ s ∈ L_mid, s ≠ (0 : Fin (n + 1)) ∧ s ≠ anc) ∧
        (∀ s ∈ L_hi, s ≠ (0 : Fin (n + 1)) ∧ s ≠ anc) := by
  let FR := List.finRange (n + 1)
  have hlen : FR.length = n + 1 := List.length_finRange
  have hanc_lt : anc.val < FR.length := by rw [hlen]; exact anc.isLt
  let T := FR.take anc.val
  have hT_len : T.length = anc.val := by rw [List.length_take, hlen]; omega
  have hT_pos : 0 < T.length := by omega
  have hT_split : T = (0 : Fin (n + 1)) :: T.drop 1 := by
    have hd : T.drop 0 = T[0]'hT_pos :: T.drop (0 + 1) := List.drop_eq_getElem_cons hT_pos
    have h0 : T[0]'hT_pos = (0 : Fin (n + 1)) := by
      have ht0 : T[0]'hT_pos = FR[0]'(by rw [hlen]; omega) := List.getElem_take
      rw [ht0]
      exact List.getElem_finRange (by rw [hlen]; omega)
    rw [h0] at hd
    exact hd
  have hD_split : FR.drop anc.val = anc :: FR.drop (anc.val + 1) := by
    have hd := List.drop_eq_getElem_cons hanc_lt
    have ha : FR[anc.val]'hanc_lt = anc := by
      have hfn : FR[anc.val]'hanc_lt = ⟨anc.val, anc.isLt⟩ := List.getElem_finRange hanc_lt
      exact hfn
    rw [ha] at hd
    exact hd
  have hFR_eq : FR = (0 : Fin (n + 1)) :: (T.drop 1 ++ anc :: FR.drop (anc.val + 1)) := by
    have hap : FR = T ++ FR.drop anc.val := (List.take_append_drop anc.val FR).symm
    rw [hT_split, hD_split, List.cons_append] at hap
    exact hap
  refine ⟨T.drop 1, FR.drop (anc.val + 1), hFR_eq, fun s hs ↦ ?_, fun s hs ↦ ?_⟩
  · rcases List.mem_iff_getElem.mp hs with ⟨k, hk, hsk⟩
    rw [List.length_drop, hT_len] at hk
    have h1 : (T.drop 1)[k]'(by rw [List.length_drop, hT_len]; exact hk) =
        T[1 + k]'(by rw [hT_len]; omega) := List.getElem_drop
    have h2 : T[1 + k]'(by rw [hT_len]; omega) = FR[1 + k]'(by
      rw [hlen]; have := anc.isLt; omega) :=
      List.getElem_take
    have h3 : FR[1 + k]'(by rw [hlen]; have := anc.isLt; omega) =
        ⟨1 + k, by have := anc.isLt; omega⟩ := List.getElem_finRange _
    have hs_eq : s = ⟨1 + k, by have := anc.isLt; omega⟩ := by
      rw [← hsk, h1, h2, h3]
    have hv : s.val = 1 + k := congrArg Fin.val hs_eq
    exact ⟨fun h0 ↦ by have := congrArg Fin.val h0; change s.val = 0 at this; omega,
      fun ha ↦ by have := congrArg Fin.val ha; omega⟩
  · rcases List.mem_iff_getElem.mp hs with ⟨k, hk, hsk⟩
    rw [List.length_drop, hlen] at hk
    have h1 : (FR.drop (anc.val + 1))[k]'(by rw [List.length_drop, hlen]; exact hk) =
        FR[anc.val + 1 + k]'(by rw [hlen]; omega) := List.getElem_drop
    have h2 : FR[anc.val + 1 + k]'(by rw [hlen]; omega) =
        ⟨anc.val + 1 + k, by omega⟩ := List.getElem_finRange _
    have hs_eq : s = ⟨anc.val + 1 + k, by omega⟩ := by
      rw [← hsk, h1, h2]
    have hv : s.val = anc.val + 1 + k := congrArg Fin.val hs_eq
    exact ⟨fun h0 ↦ by have := congrArg Fin.val h0; change s.val = 0 at this; omega,
      fun ha ↦ by have := congrArg Fin.val ha; omega⟩


theorem list_prod_swap_comm_gen_Bhmt {M : Type*} [Monoid M] {α : Type*} (u : α → M)
    (a b : α) (L_mid L_hi : List α)
    (hM_b : (L_mid.map u).prod * u b = u b * (L_mid.map u).prod)
    (hM_a : (L_mid.map u).prod * u a = u a * (L_mid.map u).prod)
    (hab : u b * u a = u a * u b) :
    ((b :: (L_mid ++ a :: L_hi)).map u).prod =
      ((a :: (L_mid ++ b :: L_hi)).map u).prod := by
  simp only [List.map_cons, List.map_append, List.prod_cons, List.prod_append]
  calc u b * ((L_mid.map u).prod * (u a * (L_hi.map u).prod))
      = (u b * (L_mid.map u).prod) * u a * (L_hi.map u).prod := by simp only [mul_assoc]
    _ = (L_mid.map u).prod * (u b * u a) * (L_hi.map u).prod := by
      rw [← hM_b]; simp only [mul_assoc]
    _ = ((L_mid.map u).prod * u a) * u b * (L_hi.map u).prod := by rw [hab]; simp only [mul_assoc]
    _ = u a * ((L_mid.map u).prod * (u b * (L_hi.map u).prod)) := by
      rw [hM_a]; simp only [mul_assoc]


private theorem list_map_rEl_mul_pe_Bhmt (g : Equiv.Perm (Fin SpecsAux.SpecMirror.numElectrons))
