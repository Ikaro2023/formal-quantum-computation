      congrFun hSub 1
    dsimp only [encTailBhmt, decTailBhmt]
    rw [hEq0, hb0, hb1]
    funext idx
    by_cases hi71 : idx = 71
    · subst hi71; simp [clrPid12_80]
    · by_cases hi70 : idx = 70
      · subst hi70; simp [clrPid12_80]
      · simp [clrPid12_80, hi70, hi71]


