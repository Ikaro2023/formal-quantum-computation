theorem ket_cnotIf_inv_ne {N : ℕ} (c t : Wire N) (hct : c ≠ t) (β : BitAssignment N) :
    (cnotIf c t).inverse.eval.1.mulVec (ket β) = ket (Function.update β t (β t + β c)) := by
  let β' := Function.update β t (β t + β c)
  have hFwd : (cnotIf c t).eval.1.mulVec (ket β') = ket β := by
    rw [ket_cnotIf_ne c t hct β']
    congr 1; funext w
    by_cases hwt : w = t
    · subst hwt
      simp only [β', Function.update_self, Function.update_of_ne hct, add_assoc,
        CharTwo.add_self_eq_zero, add_zero]
    · simp [β', Function.update_of_ne hwt]
  conv_lhs => rw [← hFwd, ← mul_mulVec_prog, Circuit.eval_inverse]
  have hL : ((cnotIf c t).eval⁻¹).1 * (cnotIf c t).eval.1 = 1 :=
    unitary_inv_mul_val_cert (cnotIf c t).eval
  rw [hL, Matrix.one_mulVec]


