def forceB {α : Type} (x : Bool) (f : Bool → α) : α :=
  match x with
  | true => f true
  | false => f false


theorem forceB_eq {α : Type} (x : Bool) (f : Bool → α) : forceB x f = f x := by
  cases x <;> rfl


def b2z (b : Bool) : ZMod 2 := if b then 1 else 0


theorem b2z_not (b : Bool) : b2z (!b) = b2z b + 1 := by cases b <;> decide

theorem b2z_bne (a b : Bool) : b2z (bne a b) = b2z a + b2z b := by cases a <;> cases b <;> decide

theorem b2z_and (a b : Bool) : b2z (a && b) = b2z a * b2z b := by cases a <;> cases b <;> decide

theorem b2z_inj {a b : Bool} (h : b2z a = b2z b) : a = b := by
  cases a <;> cases b <;> revert h <;> decide

theorem zmod2_eq_b2z (x : ZMod 2) : x = b2z (x == 1) := by
  rcases bit_cases x with rfl | rfl <;> decide


