    {α : BitAssignment 152} (hα : MuxFlagsInv152 α) : α w = 0 := by
  rcases hα with ⟨hFl, _, _, _, hscr21, htele⟩
  obtain ⟨hCore, hscr30⟩ := (flagsInv_iff _).mp hFl
  rcases hCore with ⟨_, _, _, _, _, _, _, _, ht01, hmaj, hpar, htop⟩
  by_cases h1 : 86 ≤ w.val ∧ w.val < 116
  · let j : Fin 30 := ⟨w.val - 86, by omega⟩
    have hw : w = scr30_152 j := by ext; dsimp [scr30_152, mkBlock152, j]; omega
    have hne : scr30_128 j ≠ wEnC0Head_128 := by
      intro h; have hval : (scr30_128 j).val = wEnC0Head_128.val := congrArg Fin.val h
      change 86 + j.val = 121 at hval; omega
    have hj0 := hscr30 j
    rw [Function.update_of_ne hne, rSub128_scr30] at hj0
    rw [hw]; exact hj0
  · by_cases h2 : 124 ≤ w.val ∧ w.val < 128
    · rcases (by omega : w.val = 124 ∨ w.val = 125 ∨ w.val = 126 ∨ w.val = 127) with
      hv | hv | hv | hv
