theorem comm_of_unit_smul_comm_Bhmt {D : ℕ} (ζ : ℂ) (hζ : star ζ * ζ = 1)
    (A P : Operator D) (hc : (ζ • A) * P = P * (ζ • A)) :
    A * P = P * A := by
  rw [Matrix.smul_mul, Matrix.mul_smul] at hc
  calc A * P
      = (star ζ * ζ) • (A * P) := by rw [hζ, one_smul]
    _ = star ζ • (ζ • (A * P)) := (smul_smul (star ζ) ζ (A * P)).symm
    _ = star ζ • (ζ • (P * A)) := by rw [hc]
    _ = (star ζ * ζ) • (P * A) := smul_smul (star ζ) ζ (P * A)
    _ = P * A := by rw [hζ, one_smul]


theorem diag_comm_permUnitary_of_eq_Bhmt {N : ℕ} {dec : DecidableEq (Fin N)}
