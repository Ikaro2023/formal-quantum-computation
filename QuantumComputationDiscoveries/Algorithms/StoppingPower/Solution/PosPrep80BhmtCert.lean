theorem headGeneralPayload80_beq_clearNuc2 (q : BitAssignment 80) (b0Val anc : ℕ) (k : Fin 56)
    (pidVal : ℕ) (sm : Fin 8) (th rej0 : Bool)
    (hnuc : Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ q (pos80SubIdx 6 8 (by decide) j)) < 4) :
    (Function.update (p80ClearRange 6 2 q) 62 0 ==
        headGeneralPayload80 b0Val 0 anc k pidVal sm th rej0) =
      (Function.update q 62 0 ==
        headGeneralPayload80 b0Val
          (Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ q (pos80SubIdx 6 8 (by decide) j)))
          anc k pidVal sm th rej0) := by
  let γ : BitAssignment 8 := fun j ↦ q (pos80SubIdx 6 8 (by decide) j)
  have hlo := (bitsVal8_clear_lo2_props γ).2 hnuc
  apply Bool.eq_iff_iff.mpr
  simp only [beq_iff_eq]
  constructor <;> intro heq <;> funext idx
  · by_cases h : 6 ≤ idx.val ∧ idx.val < 14
    · have hne62 : idx ≠ 62 := fun hc ↦ by subst hc; omega
      have hj : pos80SubIdx 6 8 (by decide) ⟨idx.val - 6, by omega⟩ = idx :=
        Fin.ext (by dsimp [pos80SubIdx]; omega)
      rw [Function.update_of_ne hne62,
        (headGeneralPayload80_nuc_slice b0Val (Pos24HeadCoordXor80.bitsVal γ) 0 anc k pidVal sm th
          rej0 idx).1 h]
      have hγ : q idx = γ ⟨idx.val - 6, by omega⟩ := congrArg q hj.symm
      rw [hγ]
      exact (bitsVal8_z2BitOfNat_self γ ⟨idx.val - 6, by omega⟩).symm
    · have h1 := congrFun heq idx
      have hu : Function.update (p80ClearRange 6 2 q) 62 0 idx = Function.update q 62 0 idx := by
        by_cases h62 : idx = 62
        · subst h62; simp
        · rw [Function.update_of_ne h62, Function.update_of_ne h62]
          unfold p80ClearRange
          exact ite_eq_right (by omega)
      rw [hu,
        (headGeneralPayload80_nuc_slice b0Val 0 (Pos24HeadCoordXor80.bitsVal γ) anc k pidVal sm th
        rej0 idx).2 h] at h1
      exact h1
  · by_cases h : 6 ≤ idx.val ∧ idx.val < 14
    · have hne62 : idx ≠ 62 := fun hc ↦ by subst hc; omega
      have hj : pos80SubIdx 6 8 (by decide) ⟨idx.val - 6, by omega⟩ = idx :=
        Fin.ext (by dsimp [pos80SubIdx]; omega)
      rw [Function.update_of_ne hne62,
        (headGeneralPayload80_nuc_slice b0Val 0 0 anc k pidVal sm th rej0 idx).1 h]
      have hclr : p80ClearRange 6 2 q idx =
          (if (⟨idx.val - 6, by omega⟩ : Fin 8).val < 2 then 0 else γ ⟨idx.val - 6, by omega⟩) := by
        dsimp only [p80ClearRange, γ]
        rw [hj]
        by_cases h8 : idx.val < 8
        · rw [ite_eq_left ⟨h.1, by omega⟩, ite_eq_left (by omega)]
        · rw [ite_eq_right (by omega), ite_eq_right (by omega)]
      rw [hclr]
      exact hlo ⟨idx.val - 6, by omega⟩
    · have h1 := congrFun heq idx
      have hu : Function.update (p80ClearRange 6 2 q) 62 0 idx = Function.update q 62 0 idx := by
        by_cases h62 : idx = 62
        · subst h62; simp
        · rw [Function.update_of_ne h62, Function.update_of_ne h62]
          unfold p80ClearRange
          exact ite_eq_right (by omega)
      rw [hu,
        (headGeneralPayload80_nuc_slice b0Val 0 (Pos24HeadCoordXor80.bitsVal γ) anc k pidVal sm th
        rej0 idx).2 h]
      exact h1


