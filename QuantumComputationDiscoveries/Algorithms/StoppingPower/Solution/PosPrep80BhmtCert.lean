  apply mul_eq_one_iff_inv_eq.mp
  apply Subtype.ext
  apply matrix_ext_ket; intro β
  simp only [Submonoid.coe_mul, OneMemClass.coe_one, Matrix.one_mulVec,
    mul_mulVec_prog, ket_X]
  congr 1; funext w
  by_cases hw : w = q
  · subst hw; simp [add_assoc, CharTwo.add_self_eq_zero, add_zero]
  · simp [Function.update_of_ne hw]


