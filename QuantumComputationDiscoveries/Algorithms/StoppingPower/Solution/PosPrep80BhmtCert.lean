def teleA1Zw (mx mz fl : Bool) (mf mb : Mat2Zw) : Zw :=
  let v0 := if mx then zwConj mb.m01 else zwConj mb.m00
  let v1 := if mx then zwConj mb.m00 else zwConj mb.m01
  let u1 := if mz then zwNeg v1 else v1
  if fl then zwAdd (zwMul mf.m00 v0) (zwMul mf.m01 u1)
  else zwAdd (zwMul mf.m10 v0) (zwMul mf.m11 u1)


theorem norm_sq_teleAlpha1_of_eval (s : TeleSpec) (mf mb : Mat2Zw)
    (hf : evalList (oddsToHst s.fwdOdds) matId = mf)
    (hb : evalList (oddsToHst s.bwdOdds) matId = mb) :
    let a1 := teleA1Zw s.mx s.mz s.fl mf mb
    let p := zwMul a1 (zwConj a1)
    ‖teleAlpha1 s‖ ^ 2 = ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((2 : ℝ) ^ (mf.h + mb.h)) := by
  let a1 := teleA1Zw s.mx s.mz s.fl mf mb
  let p := zwMul a1 (zwConj a1)
  have ha1 : teleAlpha1 s =
      telePhase s * ((MeasureBranchHadamardSem.sqrtHalf : ℂ) ^ (mf.h + mb.h)) * a1.toComplex := by
    dsimp only [a1]
    cases hmx : s.mx <;> cases hmz : s.mz <;> cases hfl : s.fl <;> (
      simp only [teleAlpha1, teleMat2, teleCoreMat, hmx, hmz, hfl, Bool.false_eq_true, ↓reduceIte]
      rw [wordMatrix2, hf, wordMatrix2, hb]
      simp only [pauliXPow, pauliZPow, show (1 : ZMod 2) ≠ 0 by decide, ↓reduceIte,
        Mat2Zw.toMatrix, teleA1Zw, Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
        Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, star_mul, star_pow,
        MeasureBranchHadamardSem.star_sqrtHalf, pow_add]
      dsimp
      simp only [toComplex_zwAdd, toComplex_zwMul, toComplex_zwConj, toComplex_zwNeg,
        Complex.star_def]
      ring)
  change ‖teleAlpha1 s‖ ^ 2 = ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((2 : ℝ) ^ (mf.h + mb.h))
  rw [ha1, norm_mul, norm_mul, mul_pow, mul_pow, telePhase_norm_sq s, one_mul, normSq_zw_eq a1]
  have hsh_norm : ‖(MeasureBranchHadamardSem.sqrtHalf : ℂ)‖ ^ 2 = 1 / 2 := by
    have hc : (MeasureBranchHadamardSem.sqrtHalf : ℂ) *
        star (MeasureBranchHadamardSem.sqrtHalf : ℂ) = 1 / 2 := by
      rw [MeasureBranchHadamardSem.star_sqrtHalf, MeasureBranchHadamardSem.sqrtHalf_mul_sqrtHalf]
    have hre := congrArg Complex.re hc
    rw [Complex.star_def, Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq] at hre
    norm_num at hre ⊢
    exact hre
  have hpow_norm : ‖(MeasureBranchHadamardSem.sqrtHalf : ℂ) ^ (mf.h + mb.h)‖ ^ 2 =
      1 / ((2 : ℝ) ^ (mf.h + mb.h)) := by
    rw [norm_pow, ← pow_mul, mul_comm _ 2, pow_mul, hsh_norm, div_pow, one_pow]
  rw [hpow_norm]
  dsimp only [p]
  ring


def checkTeleMat (mx mz fl : Bool) (mf mb : Mat2Zw) (num den powPe powB : ℤ) : Bool :=
  let a1 := teleA1Zw mx mz fl mf mb
  let p := zwMul a1 (zwConj a1)
  let bigA := (p.c0 * den - num * powPe) * powB
  let bigB := (p.c1 * den) * powB
  let bigR := den * powPe
  leSqrt2Int bigB (bigR - bigA) && leSqrt2Int (-bigB) (bigR + bigA)


private theorem norm_sq_teleAlpha1_sub_div_le_powB (s : TeleSpec) (mf mb : Mat2Zw) (num den powB :
    ℕ)
    (hf : evalList (oddsToHst s.fwdOdds) matId = mf)
    (hb : evalList (oddsToHst s.bwdOdds) matId = mb)
    (hden : 0 < den) (hpowB : 0 < powB)
    (hchk : checkTeleMat s.mx s.mz s.fl mf mb (num : ℤ) (den : ℤ)
      (((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℤ) ((powB : ℕ) : ℤ) = true) :
    |‖teleAlpha1 s‖ ^ 2 - (num : ℝ) / (den : ℝ)| ≤ 1 / (powB : ℝ) := by
  have hpowPe : (((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℝ) = (2 : ℝ) ^ (mf.h + mb.h) := by
    push_cast
    rw [pow_add]
  let a1 := teleA1Zw s.mx s.mz s.fl mf mb
  let p := zwMul a1 (zwConj a1)
  have hnorm : ‖teleAlpha1 s‖ ^ 2 = ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((2 : ℝ) ^ (mf.h + mb.h)) :=
    norm_sq_teleAlpha1_of_eval s mf mb hf hb
  simp only [checkTeleMat, Bool.and_eq_true] at hchk
  have hU := leSqrt2Int_sound _ _ hchk.1
  have hL := leSqrt2Int_sound _ _ hchk.2
  have hpowPeZ : (((((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℤ) : ℝ)) = (2 : ℝ) ^ (mf.h + mb.h) := by
    exact_mod_cast hpowPe
  push_cast at hU hL hpowPeZ
  rw [hpowPeZ] at hU hL
  have hposDen : (0 : ℝ) < (den : ℝ) := by exact_mod_cast hden
  have hposPe : (0 : ℝ) < (2 : ℝ) ^ (mf.h + mb.h) := by positivity
  have hposB : (0 : ℝ) < (powB : ℝ) := by exact_mod_cast hpowB
  have hprodPos : (0 : ℝ) < (den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ) := by positivity
  rw [hnorm, abs_le]
  constructor
  · rw [le_sub_iff_add_le]
    suffices hmul : (-(1 / (powB : ℝ)) + (num : ℝ) / (den : ℝ)) *
        ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) ≤
        (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h)) *
        ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) by
      exact le_of_mul_le_mul_right hmul hprodPos
    have lhs_eq : (-(1 / (powB : ℝ)) + (num : ℝ) / (den : ℝ)) *
        ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) =
        -(den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) + (num : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ) :=
          by
      field_simp [hposDen.ne', hposB.ne']
    have rhs_eq : (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h)) *
        ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) =
        (p.c0 : ℝ) * (den : ℝ) * (powB : ℝ) +
          (p.c1 : ℝ) * (den : ℝ) * (powB : ℝ) * √2 := by
      field_simp [hposPe.ne']
    rw [lhs_eq, rhs_eq]
    linarith
  · suffices hmul : (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h) -
        (num : ℝ) / (den : ℝ)) * ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) ≤
        (1 / (powB : ℝ)) * ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) by
      exact le_of_mul_le_mul_right hmul hprodPos
    have lhs_eq : (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h) -
        (num : ℝ) / (den : ℝ)) * ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) =
        ((p.c0 : ℝ) * (den : ℝ) - (num : ℝ) * (2 : ℝ) ^ (mf.h + mb.h)) * (powB : ℝ) +
          (p.c1 : ℝ) * (den : ℝ) * (powB : ℝ) * √2 := by
      field_simp [hposDen.ne', hposPe.ne']; ring
    have rhs_eq : (1 / (powB : ℝ)) * ((den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) * (powB : ℝ)) =
        (den : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) := by
      field_simp [hposB.ne']
    rw [lhs_eq, rhs_eq]
    linarith


def checkTeleScaled48 (mx mz fl : Bool) (mf mb : Mat2Zw) (S wR eSplit powPe : ℤ) : Bool :=
  let a1 := teleA1Zw mx mz fl mf mb
  let p := zwMul a1 (zwConj a1)
  let bigA := (S * p.c0 - wR * powPe) * (2 : ℤ) ^ 48
  let bigB := (S * p.c1) * (2 : ℤ) ^ 48
  let bigR := eSplit * powPe
  leSqrt2Int bigB (bigR - bigA) && leSqrt2Int (-bigB) (bigR + bigA)


private theorem scaled_teleAlpha1_err_48 (s : TeleSpec) (mf mb : Mat2Zw) (S wR eSplit : ℕ)
    (hf : evalList (oddsToHst s.fwdOdds) matId = mf)
    (hb : evalList (oddsToHst s.bwdOdds) matId = mb)
    (hchk : checkTeleScaled48 s.mx s.mz s.fl mf mb (S : ℤ) (wR : ℤ) (eSplit : ℤ)
      (((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℤ) = true) :
    |(S : ℝ) * ‖teleAlpha1 s‖ ^ 2 - (wR : ℝ)| ≤ (eSplit : ℝ) / (2 : ℝ) ^ 48 := by
  have hpowPe : (((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℝ) = (2 : ℝ) ^ (mf.h + mb.h) := by
    push_cast
    rw [pow_add]
  let a1 := teleA1Zw s.mx s.mz s.fl mf mb
  let p := zwMul a1 (zwConj a1)
  have hnorm : ‖teleAlpha1 s‖ ^ 2 = ((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / ((2 : ℝ) ^ (mf.h + mb.h)) :=
    norm_sq_teleAlpha1_of_eval s mf mb hf hb
  simp only [checkTeleScaled48, Bool.and_eq_true] at hchk
  have hU := leSqrt2Int_sound _ _ hchk.1
  have hL := leSqrt2Int_sound _ _ hchk.2
  have hpowPeZ : (((((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℤ) : ℝ)) = (2 : ℝ) ^ (mf.h + mb.h) := by
    exact_mod_cast hpowPe
  push_cast at hU hL hpowPeZ
  rw [hpowPeZ] at hU hL
  try rw [show (281474976710656 : ℝ) = (2 : ℝ) ^ 48 by norm_num] at hU hL
  have hposPe : (0 : ℝ) < (2 : ℝ) ^ (mf.h + mb.h) := by positivity
  have hpos48 : (0 : ℝ) < (2 : ℝ) ^ 48 := by positivity
  have hprodPos : (0 : ℝ) < (2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48 := by positivity
  rw [hnorm, abs_le]
  constructor
  · rw [le_sub_iff_add_le]
    suffices hmul : (-((eSplit : ℝ) / (2 : ℝ) ^ 48) + (wR : ℝ)) *
        ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) ≤
        ((S : ℝ) * (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h))) *
        ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) by
      exact le_of_mul_le_mul_right hmul hprodPos
    have lhs_eq : (-((eSplit : ℝ) / (2 : ℝ) ^ 48) + (wR : ℝ)) *
        ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) =
        -(eSplit : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) + (wR : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) *
          (2 : ℝ) ^ 48 := by
      field_simp [hpos48.ne']
    have rhs_eq : ((S : ℝ) * (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h))) *
        ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) =
        (S : ℝ) * (p.c0 : ℝ) * (2 : ℝ) ^ 48 +
          (S : ℝ) * (p.c1 : ℝ) * (2 : ℝ) ^ 48 * √2 := by
      field_simp [hposPe.ne']
    rw [lhs_eq, rhs_eq]
    linarith
  · suffices hmul : ((S : ℝ) * (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h)) -
        (wR : ℝ)) * ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) ≤
        ((eSplit : ℝ) / (2 : ℝ) ^ 48) * ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) by
      exact le_of_mul_le_mul_right hmul hprodPos
    have lhs_eq : ((S : ℝ) * (((p.c0 : ℝ) + (p.c1 : ℝ) * √2) / (2 : ℝ) ^ (mf.h + mb.h)) -
        (wR : ℝ)) * ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) =
        ((S : ℝ) * (p.c0 : ℝ) - (wR : ℝ) * (2 : ℝ) ^ (mf.h + mb.h)) * (2 : ℝ) ^ 48 +
          (S : ℝ) * (p.c1 : ℝ) * (2 : ℝ) ^ 48 * √2 := by
      field_simp [hposPe.ne']; ring
    have rhs_eq : ((eSplit : ℝ) / (2 : ℝ) ^ 48) * ((2 : ℝ) ^ (mf.h + mb.h) * (2 : ℝ) ^ 48) =
        (eSplit : ℝ) * (2 : ℝ) ^ (mf.h + mb.h) := by
      field_simp [hpos48.ne']
    rw [lhs_eq, rhs_eq]
    linarith

private def checkTeleSpecScaled48 (s : TeleSpec) (S wR eSplit : ℕ) : Bool :=
  let mf := evalList (oddsToHst s.fwdOdds) matId
  let mb := evalList (oddsToHst s.bwdOdds) matId
  checkTeleScaled48 s.mx s.mz s.fl mf mb (S : ℤ) (wR : ℤ) (eSplit : ℤ)
    (((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℤ)

private theorem teleSpec_scaled_err_48 (s : TeleSpec) (S wR eSplit : ℕ)
    (hchk : checkTeleSpecScaled48 s S wR eSplit = true) :
    |(S : ℝ) * ‖teleAlpha1 s‖ ^ 2 - (wR : ℝ)| ≤ (eSplit : ℝ) / (2 : ℝ) ^ 48 :=
  scaled_teleAlpha1_err_48 s _ _ S wR eSplit rfl rfl hchk

private def checkTeleSpecPowB (s : TeleSpec) (num den powB : ℕ) : Bool :=
  let mf := evalList (oddsToHst s.fwdOdds) matId
  let mb := evalList (oddsToHst s.bwdOdds) matId
  checkTeleMat s.mx s.mz s.fl mf mb (num : ℤ) (den : ℤ)
    (((2 ^ mf.h : ℕ) * (2 ^ mb.h : ℕ) : ℕ) : ℤ) ((powB : ℕ) : ℤ)

private theorem teleSpec_err_powB (s : TeleSpec) (num den powB : ℕ)
    (hden : 0 < den) (hpowB : 0 < powB) (hchk : checkTeleSpecPowB s num den powB = true) :
    |‖teleAlpha1 s‖ ^ 2 - (num : ℝ) / (den : ℝ)| ≤ 1 / (powB : ℝ) :=
  norm_sq_teleAlpha1_sub_div_le_powB s _ _ num den powB rfl rfl hden hpowB hchk


noncomputable def teleSbmAmp : (m : ℕ) → ((d : Fin m) → Fin (2 ^ d.val) → TeleSpec) →
    Fin (2 ^ m) → ℂ
  | 0, _, _ => 1
  | m + 1, words, j =>
    let wordsL : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨p.val, lt_pow_succ_of_lt p⟩
    let wordsR : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨2 ^ d.val + p.val, add_lt_pow_succ p⟩
    if hlt : j.val < 2 ^ m then
      teleAlpha0 (words 0 0) * teleSbmAmp m wordsL ⟨j.val, hlt⟩
    else
      teleAlpha1 (words 0 0) * teleSbmAmp m wordsR ⟨j.val - 2 ^ m, sub_pow_lt_of_not_lt j hlt⟩

private theorem norm_sq_sum_teleSbmAmp (m : ℕ) (words : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec) :
    ∑ j : Fin (2 ^ m), ‖teleSbmAmp m words j‖ ^ 2 = 1 := by
  induction m with
  | zero => simp [teleSbmAmp]
  | succ m ih =>
    let wordsL : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨p.val, lt_pow_succ_of_lt p⟩
    let wordsR : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨2 ^ d.val + p.val, add_lt_pow_succ p⟩
    rw [fin_sum_pow_succ]
    have hL : (∑ x : Fin (2 ^ m), ‖teleSbmAmp (m + 1) words ⟨x.val, lt_pow_succ_of_lt x⟩‖ ^ 2) =
        ‖teleAlpha0 (words 0 0)‖ ^ 2 * ∑ x : Fin (2 ^ m), ‖teleSbmAmp m wordsL x‖ ^ 2 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      simp [teleSbmAmp, wordsL, x.isLt, mul_pow]
    have hR : (∑ x : Fin (2 ^ m), ‖teleSbmAmp (m + 1) words ⟨2 ^ m + x.val,
      add_lt_pow_succ x⟩‖ ^ 2) =
        ‖teleAlpha1 (words 0 0)‖ ^ 2 * ∑ x : Fin (2 ^ m), ‖teleSbmAmp m wordsR x‖ ^ 2 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      have hlt : ¬ (2 ^ m + x.val < 2 ^ m) := by omega
      simp [teleSbmAmp, wordsR, hlt, mul_pow]
    rw [hL, hR, ih wordsL, ih wordsR, mul_one, mul_one]
    exact norm_sq_teleAlpha0_add_teleAlpha1 (words 0 0)


def TeleSbmTreeCertW : (m : ℕ) → ((d : Fin m) → Fin (2 ^ d.val) → TeleSpec) →
    (Fin (2 ^ m) → ℕ) → ℕ → ℕ → Prop
  | 0, _, W, S, _ => W 0 = S
  | m + 1, words, W, S, errNat =>
    let WL : Fin (2 ^ m) → ℕ := fun x => W ⟨x.val, lt_pow_succ_of_lt x⟩
    let WR : Fin (2 ^ m) → ℕ := fun x => W ⟨2 ^ m + x.val, add_lt_pow_succ x⟩
    let wordsL : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨p.val, lt_pow_succ_of_lt p⟩
    let wordsR : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨2 ^ d.val + p.val, add_lt_pow_succ p⟩
    ∃ wL wR : ℕ, wL + wR = S ∧
      (if wL = 0 then words 0 0 = teleSpecFlip ∧ (∀ x,
        WL x = 0) ∧ TeleSbmTreeCertW m wordsR WR wR errNat
       else if wR = 0 then words 0 0 = teleSpecSkipH ∧ (∀ x,
         WR x = 0) ∧ TeleSbmTreeCertW m wordsL WL wL errNat
       else ∃ eSplit eL eR : ℕ,
         eL + eR + 2 * eSplit ≤ errNat ∧
         |(S : ℝ) * ‖teleAlpha1 (words 0 0)‖ ^ 2 - (wR : ℝ)| ≤ (eSplit : ℝ) / (2 : ℝ) ^ 48 ∧
         TeleSbmTreeCertW m wordsL WL wL eL ∧
         TeleSbmTreeCertW m wordsR WR wR eR)
local instance bhmt_instDecidableTeleSbmTreeCertWZero (words : (d : Fin 0) → Fin (2 ^ d.val) →
    TeleSpec)
    (W : Fin (2 ^ 0) → ℕ) (S errNat : ℕ) : Decidable (TeleSbmTreeCertW 0 words W S errNat) :=
  inferInstanceAs (Decidable (W 0 = S))

private theorem TeleSbmTreeCertW.sound {m : ℕ} {words : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec}
    {W : Fin (2 ^ m) → ℕ} {S errNat : ℕ}
    (hcert : TeleSbmTreeCertW m words W S errNat) (hS : 0 < S) :
    (∑ j : Fin (2 ^ m), W j = S) ∧
    (∀ j : Fin (2 ^ m), W j = 0 → teleSbmAmp m words j = 0) ∧
    (∑ j : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp m words j‖ ^ 2 - (W j : ℝ)| ≤
      (errNat : ℝ) / (2 : ℝ) ^ 48) := by
  induction m generalizing S errNat with
  | zero =>
    have hW0 : W 0 = S := hcert
    have hj0 : ∀ j : Fin (2 ^ 0), j = 0 := fun j => Fin.ext (by have := j.isLt; omega)
    refine ⟨?_, fun j hj => by rw [hj0 j] at hj; omega, ?_⟩
    · calc ∑ j : Fin (2 ^ 0), W j = ∑ _ : Fin (2 ^ 0), S :=
            Finset.sum_congr rfl fun j _ => by rw [hj0 j, hW0]
        _ = S := by simp
    · have hterm : ∀ j : Fin (2 ^ 0), |(S : ℝ) * ‖teleSbmAmp 0 words j‖ ^ 2 - (W j : ℝ)| = 0 :=
      fun j => by
        rw [hj0 j, hW0]
        simp [teleSbmAmp]
      rw [Finset.sum_eq_zero fun j _ => hterm j]
      positivity
  | succ m ih =>
    obtain ⟨wL, wR, hwsum, hbody⟩ := hcert
    let WL : Fin (2 ^ m) → ℕ := fun x => W ⟨x.val, lt_pow_succ_of_lt x⟩
    let WR : Fin (2 ^ m) → ℕ := fun x => W ⟨2 ^ m + x.val, add_lt_pow_succ x⟩
    let wordsL : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨p.val, lt_pow_succ_of_lt p⟩
    let wordsR : (d : Fin m) → Fin (2 ^ d.val) → TeleSpec :=
      fun d p => words d.succ ⟨2 ^ d.val + p.val, add_lt_pow_succ p⟩
    by_cases hwL : wL = 0
    · simp only [hwL, ↓reduceIte] at hbody
      rcases hbody with ⟨hw0, hWL0, hcertR⟩
      have hwR_eq : wR = S := by omega
      rcases ih hcertR (by omega) with ⟨hsumR, hzeroR, herrR⟩
      refine ⟨?_, ?_, ?_⟩
      · rw [fin_sum_pow_succ, Finset.sum_eq_zero fun x _ => hWL0 x, zero_add, hsumR]
        exact hwR_eq
      · intro j hj
        by_cases hlt : j.val < 2 ^ m
        · simp [teleSbmAmp, hlt, hw0]
        · simp only [teleSbmAmp, hlt, ↓reduceDIte]
          have hx0 : WR ⟨j.val - 2 ^ m, sub_pow_lt_of_not_lt j hlt⟩ = 0 := by
            have hjeq : (⟨2 ^ m + (j.val - 2 ^ m), add_lt_pow_succ ⟨j.val - 2 ^ m,
              sub_pow_lt_of_not_lt j hlt⟩⟩ : Fin (2 ^ (m + 1))) = j :=
              Fin.ext (Nat.add_sub_cancel' (Nat.le_of_not_lt hlt))
            simpa [WR, hjeq] using hj
          rw [hzeroR _ hx0, mul_zero]
      · rw [fin_sum_pow_succ]
        have hl0 : (∑ x : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp (m + 1) words ⟨x.val,
          lt_pow_succ_of_lt x⟩‖ ^ 2 -
            (WL x : ℝ)|) = 0 := by
          refine Finset.sum_eq_zero fun x _ => ?_
          simp [WL, teleSbmAmp, x.isLt, hw0, hWL0 x]
        have ha1_one : ‖teleAlpha1 teleSpecFlip‖ ^ 2 = 1 := by
          simp
        have hr_eq : (∑ x : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp (m + 1) words ⟨2 ^ m + x.val,
          add_lt_pow_succ x⟩‖ ^ 2 -
            (WR x : ℝ)|) =
            ∑ x : Fin (2 ^ m), |(wR : ℝ) * ‖teleSbmAmp m wordsR x‖ ^ 2 - (WR x : ℝ)| := by
          refine Finset.sum_congr rfl fun x _ => ?_
          have hlt : ¬ (2 ^ m + x.val < 2 ^ m) := by omega
          simp [teleSbmAmp, wordsR, hlt, hw0, hwR_eq]
        dsimp only [WL, WR] at hl0 hr_eq
        rw [hl0, zero_add, hr_eq]
        exact herrR
    · simp only [hwL, ↓reduceIte] at hbody
      by_cases hwR : wR = 0
      · simp only [hwR, ↓reduceIte] at hbody
        rcases hbody with ⟨hw0, hWR0, hcertL⟩
        have hwL_eq : wL = S := by omega
        rcases ih hcertL (by omega) with ⟨hsumL, hzeroL, herrL⟩
        refine ⟨?_, ?_, ?_⟩
        · rw [fin_sum_pow_succ, Finset.sum_eq_zero fun x _ => hWR0 x, add_zero, hsumL]
          exact hwL_eq
        · intro j hj
          by_cases hlt : j.val < 2 ^ m
          · simp only [teleSbmAmp, hlt, ↓reduceDIte]
            rw [hzeroL ⟨j.val, hlt⟩ hj, mul_zero]
          · simp [teleSbmAmp, hlt, hw0]
        · rw [fin_sum_pow_succ]
          have hr0 : (∑ x : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp (m + 1) words ⟨2 ^ m + x.val,
            add_lt_pow_succ x⟩‖ ^ 2 -
              (WR x : ℝ)|) = 0 := by
            refine Finset.sum_eq_zero fun x _ => ?_
            have hlt : ¬ (2 ^ m + x.val < 2 ^ m) := by omega
            simp [WR, teleSbmAmp, hlt, hw0, hWR0 x]
          have ha0_one : ‖teleAlpha0 teleSpecSkipH‖ ^ 2 = 1 := by
            simp
          have hl_eq : (∑ x : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp (m + 1) words ⟨x.val,
            lt_pow_succ_of_lt x⟩‖ ^ 2 -
              (WL x : ℝ)|) =
              ∑ x : Fin (2 ^ m), |(wL : ℝ) * ‖teleSbmAmp m wordsL x‖ ^ 2 - (WL x : ℝ)| := by
            refine Finset.sum_congr rfl fun x _ => ?_
            simp [teleSbmAmp, wordsL, x.isLt, hw0, hwL_eq]
          dsimp only [WL, WR] at hl_eq hr0
          rw [hr0, add_zero, hl_eq]
          exact herrL
      · simp only [hwR, ↓reduceIte] at hbody
        rcases hbody with ⟨eSplit, eL, eR, heSum, hsplit1, hcertL, hcertR⟩
        rcases ih hcertL (by omega) with ⟨hsumL, hzeroL, herrL⟩
        rcases ih hcertR (by omega) with ⟨hsumR, hzeroR, herrR⟩
        refine ⟨?_, ?_, ?_⟩
        · rw [fin_sum_pow_succ, hsumL, hsumR]
          exact hwsum
        · intro j hj
          by_cases hlt : j.val < 2 ^ m
          · simp only [teleSbmAmp, hlt, ↓reduceDIte]
            rw [hzeroL ⟨j.val, hlt⟩ hj, mul_zero]
          · simp only [teleSbmAmp, hlt, ↓reduceDIte]
            have hx0 : WR ⟨j.val - 2 ^ m, sub_pow_lt_of_not_lt j hlt⟩ = 0 := by
              have hjeq : (⟨2 ^ m + (j.val - 2 ^ m), add_lt_pow_succ ⟨j.val - 2 ^ m,
                sub_pow_lt_of_not_lt j hlt⟩⟩ : Fin (2 ^ (m + 1))) = j :=
                Fin.ext (Nat.add_sub_cancel' (Nat.le_of_not_lt hlt))
              simpa [WR, hjeq] using hj
            rw [hzeroR _ hx0, mul_zero]
        · rw [fin_sum_pow_succ]
          have hnorm01 := norm_sq_teleAlpha0_add_teleAlpha1 (words 0 0)
          have hwsumR : (wL : ℝ) + (wR : ℝ) = (S : ℝ) := by exact_mod_cast hwsum
          have hsplit0 : |(S : ℝ) * ‖teleAlpha0 (words 0 0)‖ ^ 2 - (wL : ℝ)| ≤
              (eSplit : ℝ) / (2 : ℝ) ^ 48 := by
            have heq : (S : ℝ) * ‖teleAlpha0 (words 0 0)‖ ^ 2 - (wL : ℝ) =
                -((S : ℝ) * ‖teleAlpha1 (words 0 0)‖ ^ 2 - (wR : ℝ)) := by
              have hmul : (S : ℝ) * (‖teleAlpha0 (words 0 0)‖ ^ 2 + ‖teleAlpha1 (words 0 0)‖ ^ 2) =
                  (S : ℝ) := by rw [hnorm01, mul_one]
              linarith
            rw [heq, abs_neg]
            exact hsplit1
          have hl_eq : (∑ x : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp (m + 1) words ⟨x.val,
            lt_pow_succ_of_lt x⟩‖ ^ 2 -
              (WL x : ℝ)|) =
              ∑ x : Fin (2 ^ m),
                |(S : ℝ) * (‖teleAlpha0 (words 0 0)‖ ^ 2 * ‖teleSbmAmp m wordsL x‖ ^ 2) -
                (WL x : ℝ)| := by
            refine Finset.sum_congr rfl fun x _ => ?_
            simp [teleSbmAmp, wordsL, x.isLt, mul_pow]
          have hr_eq : (∑ x : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp (m + 1) words ⟨2 ^ m + x.val,
            add_lt_pow_succ x⟩‖ ^ 2 -
              (WR x : ℝ)|) =
              ∑ x : Fin (2 ^ m),
                |(S : ℝ) * (‖teleAlpha1 (words 0 0)‖ ^ 2 * ‖teleSbmAmp m wordsR x‖ ^ 2) -
                (WR x : ℝ)| := by
            refine Finset.sum_congr rfl fun x _ => ?_
            have hlt : ¬ (2 ^ m + x.val < 2 ^ m) := by omega
            simp [teleSbmAmp, wordsR, hlt, mul_pow]
          have hbL := scaled_half_sbm_bound S wL (‖teleAlpha0 (words 0 0)‖ ^ 2)
            (fun x => ‖teleSbmAmp m wordsL x‖ ^ 2) WL
            ((eL : ℝ) / (2 : ℝ) ^ 48) ((eSplit : ℝ) / (2 : ℝ) ^ 48)
            (fun _ => by positivity) (norm_sq_sum_teleSbmAmp m wordsL) hsplit0 herrL
          have hbR := scaled_half_sbm_bound S wR (‖teleAlpha1 (words 0 0)‖ ^ 2)
            (fun x => ‖teleSbmAmp m wordsR x‖ ^ 2) WR
            ((eR : ℝ) / (2 : ℝ) ^ 48) ((eSplit : ℝ) / (2 : ℝ) ^ 48)
            (fun _ => by positivity) (norm_sq_sum_teleSbmAmp m wordsR) hsplit1 herrR
          dsimp only [WL, WR] at hl_eq hr_eq
          rw [hl_eq, hr_eq]
          have heSumR : (eL : ℝ) + (eR : ℝ) + 2 * (eSplit : ℝ) ≤ (errNat : ℝ) := by
            exact_mod_cast heSum
          calc _ ≤ ((eL : ℝ) / (2 : ℝ) ^ 48 + (eSplit : ℝ) / (2 : ℝ) ^ 48) +
                ((eR : ℝ) / (2 : ℝ) ^ 48 + (eSplit : ℝ) / (2 : ℝ) ^ 48) := add_le_add hbL hbR
            _ = ((eL : ℝ) + (eR : ℝ) + 2 * (eSplit : ℝ)) / (2 : ℝ) ^ 48 := by ring
            _ ≤ (errNat : ℝ) / (2 : ℝ) ^ 48 :=
                div_le_div_of_nonneg_right heSumR (by positivity)

private theorem TeleSbmTreeCertW.l1_err_le {m : ℕ} {words : (d : Fin m) → Fin (2 ^ d.val) →
    TeleSpec}
    {W : Fin (2 ^ m) → ℕ} {S errNat : ℕ}
    (hcert : TeleSbmTreeCertW m words W S errNat) (hS : 0 < S) :
    ∑ j : Fin (2 ^ m), |‖teleSbmAmp m words j‖ ^ 2 - (W j : ℝ) / (S : ℝ)| ≤
      (errNat : ℝ) / ((S : ℝ) * (2 : ℝ) ^ 48) := by
  have hSR : (0 : ℝ) < (S : ℝ) := by exact_mod_cast hS
  have hscaled := (hcert.sound hS).2.2
  have hrew : (∑ j : Fin (2 ^ m), |‖teleSbmAmp m words j‖ ^ 2 - (W j : ℝ) / (S : ℝ)|) =
      (∑ j : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp m words j‖ ^ 2 - (W j : ℝ)|) / (S : ℝ) := by
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hid : ‖teleSbmAmp m words j‖ ^ 2 - (W j : ℝ) / (S : ℝ) =
        ((S : ℝ) * ‖teleSbmAmp m words j‖ ^ 2 - (W j : ℝ)) / (S : ℝ) := by
      field_simp [hSR.ne']
    rw [hid, abs_div, abs_of_pos hSR]
  rw [hrew]
  calc (∑ j : Fin (2 ^ m), |(S : ℝ) * ‖teleSbmAmp m words j‖ ^ 2 - (W j : ℝ)|) / (S : ℝ)
      ≤ ((errNat : ℝ) / (2 : ℝ) ^ 48) / (S : ℝ) := div_le_div_of_nonneg_right hscaled hSR.le
    _ = (errNat : ℝ) / ((S : ℝ) * (2 : ℝ) ^ 48) := by rw [div_div, mul_comm]


