private theorem dFinishXorPair {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9) :
    DynPair128 v rFull128 rExtra9 FlagsInv128 24
      (dFinishXorFwd v rFull128 rExtra9 hDisjExtra)
      (dFinishXorInv v rFull128 rExtra9 hDisjExtra)
      (cFinishXorToff_128 true).eval := by
  have f1 := DynPair128.toffIf_extra0 (v := v) (S := FlagsInv128) hDisjExtra
    wEnS0Tail_128 (rB1_128 ⟨0, by decide⟩) (wP80_128 ⟨75, by decide⟩)
    (by decide) (by decide) (by decide) (flagsInv_indep_payload_not36 (by decide))
  have f2 := DynPair128.toffIf_extra0 (v := v) (S := FlagsInv128) hDisjExtra
    wEnS0Tail_128 (rB1_128 ⟨1, by decide⟩) (wP80_128 ⟨76, by decide⟩)
    (by decide) (by decide) (by decide) (flagsInv_indep_payload_not36 (by decide))
  have f3 := DynPair128.toffIf_extra0 (v := v) (S := FlagsInv128) hDisjExtra
    wEnS0Tail_128 (rB1_128 ⟨2, by decide⟩) (wP80_128 ⟨77, by decide⟩)
    (by decide) (by decide) (by decide) (flagsInv_indep_payload_not36 (by decide))
  have f4 := DynPair128.toffIf_extra0 (v := v) (S := FlagsInv128) hDisjExtra
    wEnS0_128 (rB0_128 ⟨0, by decide⟩) (rB1_128 ⟨0, by decide⟩)
    (by decide) (by decide) (by decide) (flagsInv_indep_payload_not36 (by decide))
  have f5 := DynPair128.toffIf_extra0 (v := v) (S := FlagsInv128) hDisjExtra
    wEnS0_128 (rB0_128 ⟨1, by decide⟩) (rB1_128 ⟨1, by decide⟩)
    (by decide) (by decide) (by decide) (flagsInv_indep_payload_not36 (by decide))
  have f6 := DynPair128.toffIf_extra0 (v := v) (S := FlagsInv128) hDisjExtra
    wEnS0_128 (rB0_128 ⟨2, by decide⟩) (rB1_128 ⟨2, by decide⟩)
    (by decide) (by decide) (by decide) (flagsInv_indep_payload_not36 (by decide))
  have hSeq :=
    DynPair128.seq hDisjExtra f1
      (DynPair128.seq hDisjExtra f2
        (DynPair128.seq hDisjExtra f3
          (DynPair128.seq hDisjExtra f4
            (DynPair128.seq hDisjExtra f5 f6))))
  have hUEq :
      ((toffIf wEnS0_128 (rB0_128 ⟨2, by decide⟩) (rB1_128 ⟨2, by decide⟩)).eval *
        (toffIf wEnS0_128 (rB0_128 ⟨1, by decide⟩) (rB1_128 ⟨1, by decide⟩)).eval *
        (toffIf wEnS0_128 (rB0_128 ⟨0, by decide⟩) (rB1_128 ⟨0, by decide⟩)).eval *
        (toffIf wEnS0Tail_128 (rB1_128 ⟨2, by decide⟩) (wP80_128 ⟨77, by decide⟩)).eval *
        (toffIf wEnS0Tail_128 (rB1_128 ⟨1, by decide⟩) (wP80_128 ⟨76, by decide⟩)).eval *
        (toffIf wEnS0Tail_128 (rB1_128 ⟨0, by decide⟩) (wP80_128 ⟨75, by decide⟩)).eval) =
      (cFinishXorToff_128 true).eval := by
    simp only [cFinishXorToff_128, ↓reduceIte, Circuit.eval_seq, unitary_mul_assoc]
  exact (hSeq.congr_unitary (by simpa only [unitary_mul_assoc] using hUEq)).mono_t (by decide)


theorem bhmt_wireIndep_postInv (p : CleanComputeProg)
    {S : BitAssignment 128 → Prop} {w : Wire 128}
    (hnt : p.touchesWire w = false) (hS : WireIndep S w) :
    WireIndep (p.PostInv S) w := by
  induction p generalizing S with
  | id => exact hS
  | x q =>
      dsimp only [CleanComputeProg.touchesWire, CleanComputeProg.PostInv] at hnt ⊢
      have hqw : q ≠ w := of_decide_eq_false hnt
      intro δ b hδ
      rw [Function.update_of_ne hqw, upd_comm128 _ (Ne.symm hqw)]
      exact hS _ b hδ
  | cnot c t =>
      dsimp only [CleanComputeProg.touchesWire, CleanComputeProg.PostInv] at hnt ⊢
      have hct := of_decide_eq_false hnt
      have hcw : c ≠ w := fun h ↦ hct (Or.inl h)
      have htw : t ≠ w := fun h ↦ hct (Or.inr h)
      intro δ b hδ
      rw [Function.update_of_ne htw, Function.update_of_ne hcw, upd_comm128 _ (Ne.symm htw)]
      exact hS _ b hδ
  | tempAnd c₁ c₂ anc =>
      dsimp only [CleanComputeProg.touchesWire, CleanComputeProg.PostInv] at hnt ⊢
      have hca := of_decide_eq_false hnt
      have hc₁w : c₁ ≠ w := fun h ↦ hca (Or.inl h)
      have hc₂w : c₂ ≠ w := fun h ↦ hca (Or.inr (Or.inl h))
      have haw : anc ≠ w := fun h ↦ hca (Or.inr (Or.inr h))
      intro δ b ⟨h1, h2⟩
      refine ⟨?_, ?_⟩
      · rw [upd_comm128 _ (Ne.symm haw)]
        exact hS _ b h1
      · rw [Function.update_of_ne haw, Function.update_of_ne hc₁w, Function.update_of_ne hc₂w]
        exact h2
  | seq p₁ p₂ ih₁ ih₂ =>
      dsimp only [CleanComputeProg.touchesWire, CleanComputeProg.PostInv] at hnt ⊢
      rcases Bool.or_eq_false_iff.mp hnt with ⟨h1, h2⟩
      exact ih₂ h2 (ih₁ h1 hS)


