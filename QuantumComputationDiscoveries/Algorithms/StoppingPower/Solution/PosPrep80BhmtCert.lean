private theorem sum_teleSbmAmp_one (words : (k : Fin 1) → Fin (2 ^ k.val) → TeleSpec)
    (β : BitAssignment 128) (hr : ∀ i : Fin 1, β (rKSub1 i) = 0) :
    teleAlpha0 (words 0 0) • ket β +
        teleAlpha1 (words 0 0) • ket (Function.update β (rK_128 ⟨0, by decide⟩) 1) =
      ∑ j : Fin (2 ^ 1), teleSbmAmp 1 words j • ket (writeReg β rKSub1 (basisBits 1 j)) := by
  have htwo : (∑ j : Fin (2 ^ 1), teleSbmAmp 1 words j • ket (writeReg β rKSub1 (basisBits 1 j))) =
      teleSbmAmp 1 words 0 • ket (writeReg β rKSub1 (basisBits 1 0)) +
      teleSbmAmp 1 words 1 • ket (writeReg β rKSub1 (basisBits 1 1)) := Fin.sum_univ_two _
  rw [htwo]
  have hw0 : writeReg β rKSub1 (basisBits 1 0) = β :=
    writeReg_self β rKSub1 (fun i ↦ by rw [hr i]; fin_cases i; rfl)
  have hw1 : writeReg β rKSub1 (basisBits 1 1) = Function.update β (rK_128 ⟨0, by decide⟩) 1 := by
    funext w
    by_cases hw : w = rK_128 ⟨0, by decide⟩
    · subst hw
      change writeReg β rKSub1 (basisBits 1 1) (rKSub1 0) = _
      rw [writeReg_apply_reg, Function.update_self]; rfl
    · have hnot : w ∉ Set.range rKSub1.wires := by
        rintro ⟨i, rfl⟩; fin_cases i; exact hw rfl
      rw [writeReg_apply_of_not_mem _ _ _ _ hnot, Function.update_of_ne hw]
  have ha0 : teleSbmAmp 1 words 0 = teleAlpha0 (words 0 0) := by simp [teleSbmAmp]
  have ha1 : teleSbmAmp 1 words 1 = teleAlpha1 (words 0 0) := by simp [teleSbmAmp]
  rw [hw0, hw1, ha0, ha1]


private theorem stitch_teleSbmAmp_succ (m : ℕ) (r : QRegister (m + 1) 128)
    (words : (k : Fin (m + 1)) → Fin (2 ^ k.val) → TeleSpec)
    (β : BitAssignment 128) (hrTop : β (r (Fin.last m)) = 0) :
    teleAlpha0 (words 0 0) •
        (∑ x : Fin (2 ^ m),
          teleSbmAmp m (fun k q => words k.succ ⟨q.val, lt_pow_succ_of_lt q⟩) x •
            ket (writeReg β (qregInit r) (basisBits m x))) +
      teleAlpha1 (words 0 0) •
        (∑ x : Fin (2 ^ m),
          teleSbmAmp m (fun k q => words k.succ ⟨2 ^ k.val + q.val, add_lt_pow_succ q⟩) x •
            ket (writeReg (Function.update β (r (Fin.last m)) 1) (qregInit r) (basisBits m x))) =
      ∑ j : Fin (2 ^ (m + 1)),
        teleSbmAmp (m + 1) words j • ket (writeReg β r (basisBits (m + 1) j)) := by
  rw [Finset.smul_sum, Finset.smul_sum, fin_sum_pow_succ]
  have hβ0 : β = Function.update β (r (Fin.last m)) 0 := by
    funext w; by_cases hw : w = r (Fin.last m) <;> simp [hw, hrTop]
  congr 1
  · refine Finset.sum_congr rfl fun x _ ↦ ?_
    rw [smul_smul, hβ0,
      writeReg_split_msb β r 0 x ⟨x.val, lt_pow_succ_of_lt x⟩ (by simp), ← hβ0]
    simp [teleSbmAmp, x.isLt]
  · refine Finset.sum_congr rfl fun x _ ↦ ?_
    rw [smul_smul,
      writeReg_split_msb β r 1 x ⟨2 ^ m + x.val, add_lt_pow_succ x⟩ (by simp)]
    have hlt : ¬ (2 ^ m + x.val < 2 ^ m) := by omega
    simp [teleSbmAmp, hlt]


