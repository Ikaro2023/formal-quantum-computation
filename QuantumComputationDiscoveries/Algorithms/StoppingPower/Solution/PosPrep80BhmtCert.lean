  have hi : rCleanAct0 86 66 152 muxPostHwa i = Fin.castAdd 66 i := by
    ext
    dsimp [rCleanAct0, PosPostPrep80CertS3Alt.qreg_block_apply]
    omega
  rw [hi, QRegister.concat_apply_left]


theorem subLift152_clean66_of_work_zero {n : ℕ}
    (rAct86 : QRegister 86 n) (rWork : QRegister 128 n)
    (hDisj86 : rAct86.DisjointWires rWork)
    (β : BitAssignment n) (hw : ∀ i : Fin 128, β (rWork i) = 0) :
    SubLift152 (rAct86.concat (rWork.slice 0 66 (by decide)) (hDisj86.compose_right _))
      (rWork.slice 66 9 (by decide)) Clean66_152 β := by
  refine ⟨fun u hu ↦ ?_, fun j ↦ ?_⟩
  · have hu' : u = Fin.natAdd 86 (⟨u.val - 86, by omega⟩ : Fin 66) := by
      ext; change u.val = 86 + (u.val - 86); omega
    rw [hu']; dsimp only; rw [QRegister.concat_apply_right, QRegister.slice_apply]
    exact hw _
  · rw [QRegister.slice_apply]; exact hw _


