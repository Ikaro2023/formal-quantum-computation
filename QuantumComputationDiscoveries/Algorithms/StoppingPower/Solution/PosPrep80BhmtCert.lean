      have heq2 : p 2 = p ⟨77, by decide⟩ + p 2 := by
        have e2 := congrFun htw ⟨2, by decide⟩
        have e77 := congrFun htw ⟨77, by decide⟩
        have q2 : Function.update q 62 0 ⟨2, by decide⟩ = p 2 := by
          rw [Function.update_of_ne (by decide), hq_def]; rfl
        have q77 : Function.update q 62 0 ⟨77, by decide⟩ = p ⟨77, by decide⟩ + p 2 := by
          rw [Function.update_of_ne (by decide), hq_def]; rfl
        rw [q2] at e2; rw [q77] at e77
        dsimp [tailWitnessPayload80] at e2 e77
        rw [hxor0] at e2
        exact e2.trans e77.symm
      have hp75 : p ⟨75, by decide⟩ = 0 := add_right_cancel (heq0.symm.trans (zero_add (p 0)).symm)
      have hp76 : p ⟨76, by decide⟩ = 0 := add_right_cancel (heq1.symm.trans (zero_add (p 1)).symm)
      have hp77 : p ⟨77, by decide⟩ = 0 := add_right_cancel (heq2.symm.trans (zero_add (p 2)).symm)
      rcases h with h1 | h2 | h3 | h4
      · exact h1 hp75
      · exact h2 hp76
      · exact h3 hp77
      · exact h4 hq78
    · rw [iteNegLocal hcond]


