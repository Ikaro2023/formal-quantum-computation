theorem muActualFactor80_true_eq_normOfRaw (s0 : Bool) (r : BitAssignment 80) :
    muActualFactor80 true s0 r =
      let b0Raw := Pos24HeadCoordXor80.bitsVal (fun j : Fin 3 ↦ r (pos80SubIdx 3 3 (by decide) j))
      let q := normOfRaw true s0 r
      let b0Val := Pos24HeadCoordXor80.bitsVal (fun j : Fin 3 ↦ q (pos80SubIdx 3 3 (by decide) j))
      let nuc := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ q (pos80SubIdx 6 8 (by decide) j))
      let anc := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ q (pos80SubIdx 14 8 (by decide) j))
      let part := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ q (pos80SubIdx 22 8 (by decide) j))
      let fine30 := Pos24HeadCoordXor80.bitsVal (fun j : Fin 30 ↦
        q (pos80SubIdx 32 30 (by decide) j))
      let splitWord := if s0 then isHeadS0TrueSpec else isHeadS0FalseSpec
      let pB0 : ℝ :=
        if s0 then (1 / 8 : ℝ)
        else if (nuc &&& 216) == 216 then (1 / 8 : ℝ) else (if b0Raw == 0 then 1 else 0)
      let q0 := Function.update q 62 0
      if q 30 == 1 then
        let kVal := Pos24HeadCoordXor80.bitsVal (fun j : Fin 6 ↦ q (pos80SubIdx 63 6 (by decide) j))
        let pidVal := Pos24HeadCoordXor80.bitsVal (fun j : Fin 3 ↦
          q (pos80SubIdx 69 3 (by decide) j))
        let smVal := Pos24HeadCoordXor80.bitsVal (fun j : Fin 3 ↦
          q (pos80SubIdx 72 3 (by decide) j))
        let remZero := (q 75 == 0) && (q 76 == 0) && (q 77 == 0) && (q 78 == 0)
        let metaRouteOk := (part == 0) && (if s0 then nuc == 0 else anc == 0)
        if hk : kVal < 56 then
          let k : Fin 56 := ⟨kVal, hk⟩
          let sm : Fin 8 := ⟨smVal, Pos24HeadCoordXor80.bitsVal3_lt8 _⟩
          if remZero && metaRouteOk &&
              (q0 == headGeneralPayload80 b0Val nuc anc k pidVal sm (q 31 == 1) (q 79 == 1)) then
            ‖teleAlpha0 splitWord‖ ^ 2 * pB0 *
              muxHeadBhmtProb (if s0 then anc else nuc) pidVal (q 62 == 1) *
              ‖teleSbmAmp 6 teleHeadShell64Specs ⟨kVal, bitsVal_lt_two_pow_local _⟩‖ ^ 2 *
              (1 / 8 : ℝ) * (1 / 4 : ℝ)
          else 0
        else 0
      else
        let scratchZero :=
          decide (∀ j : Fin 12, q (pos80SubIdx 63 12 (by decide) j) = 0) && (q 78 == 0)
        let dpVal := Pos24HeadCoordXor80.bitsVal (fun j : Fin 3 ↦
          q (pos80SubIdx 75 3 (by decide) j))
        let dp : Fin 8 := ⟨dpVal, Pos24HeadCoordXor80.bitsVal3_lt8 _⟩
        let auxOk := if s0 then (nuc == 0) else (part == 0)
        if scratchZero && auxOk &&
            (q0 == tailWitnessPayload80 b0Val nuc anc part dp fine30 (q 31 == 1) (q 79 == 1)) then
          ‖teleAlpha1 splitWord‖ ^ 2 * pB0 *
            muxTailBhmtProb s0 anc (if s0 then part else nuc) dp fine30 (q 62 == 1) *
            (1 / 4 : ℝ)
        else 0 := by
  unfold muActualFactor80 normOfRaw
  cases s0 <;> rfl


theorem fiberWeight_mul_pB0_projBhmt (s0 : Bool) (p : BitAssignment 80) :
    let r := projBhmt s0 p
    let b0Raw := Pos24HeadCoordXor80.bitsVal (fun j : Fin 3 ↦ r (pos80SubIdx 3 3 (by decide) j))
    let q := normOfRaw true s0 r
    let nuc := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ q (pos80SubIdx 6 8 (by decide) j))
    fiberWeightBhmt s0 p *
      (if s0 then (1 / 8 : ℝ)
       else if (nuc &&& 216) == 216 then (1 / 8 : ℝ) else (if b0Raw == 0 then 1 else 0)) =
      if posPostQOf s0 p 30 == 1 then
        (1 / 8 : ℝ) * (if s0 then (1 / 4 : ℝ) else (1 / 128 : ℝ))
      else
        (1 / 8 : ℝ) * (1 / 4 : ℝ) := by
  dsimp only
  rw [normOfRaw_projBhmt s0 p, posPostQOf_at30_Bhmt s0 p]
  cases s0
  · have hnucQ : (fun j : Fin 8 ↦ posPostQOf false p (pos80SubIdx 6 8 (by decide) j)) =
        fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j) := by
      funext j
      rw [posPostQOf_eq_normOfRaw_s3 false p]
      change flipTailDpScratch80 (p80ClearB0Local p) (pos80SubIdx 6 8 (by decide) j) =
        p (pos80SubIdx 6 8 (by decide) j)
      unfold flipTailDpScratch80
      have hc30 : p80ClearB0Local p 30 = p 30 := rfl
      rw [hc30]
      by_cases hp30 : (p 30 == 1) = true
      · rw [ite_eq_left hp30]
        unfold p80ClearB0Local
        exact ite_eq_right (by dsimp [pos80SubIdx]; omega)
      · rw [ite_eq_right hp30]
        have n75 : ((pos80SubIdx 6 8 (by decide) j).val == 75) = false :=
          beq_false_of_ne (by dsimp [pos80SubIdx]; omega)
        have n76 : ((pos80SubIdx 6 8 (by decide) j).val == 76) = false :=
          beq_false_of_ne (by dsimp [pos80SubIdx]; omega)
        have n77 : ((pos80SubIdx 6 8 (by decide) j).val == 77) = false :=
          beq_false_of_ne (by dsimp [pos80SubIdx]; omega)
        rw [n75, n76, n77]
        simp only [Bool.false_eq_true, ↓reduceIte]
        unfold p80ClearB0Local
        exact ite_eq_right (by dsimp [pos80SubIdx]; omega)
    have hb0Zero : ∀ x : BitAssignment 80,
        Pos24HeadCoordXor80.bitsVal (fun j : Fin 3 ↦
          p80ClearB0Local x (pos80SubIdx 3 3 (by decide) j)) = 0 :=
      fun x ↦ by
        have hf : (fun j : Fin 3 ↦ p80ClearB0Local x (pos80SubIdx 3 3 (by decide) j)) = fun _ ↦ 0 :=
          by
          funext j; fin_cases j <;> rfl
        rw [hf]; exact bitsVal_zero_local
    unfold fiberWeightBhmt projBhmt
    simp only [Bool.false_eq_true, ↓reduceIte]
    by_cases hp30 : (p 30 == 1) = true
    · simp only [hp30, ↓reduceIte]
      have hn1 : (fun j : Fin 8 ↦
        p80ClearRange 14 7 (posPostQOf false p) (pos80SubIdx 6 8 (by decide) j)) =
          fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j) := by
        funext j
        unfold p80ClearRange
        rw [ite_eq_right (by dsimp [pos80SubIdx]; omega)]
        exact congrFun hnucQ j
      rw [hn1]
      by_cases h216 : ((Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
        p (pos80SubIdx 6 8 (by decide) j)) &&& 216) == 216) = true
      · simp only [h216, ↓reduceIte]; norm_num
