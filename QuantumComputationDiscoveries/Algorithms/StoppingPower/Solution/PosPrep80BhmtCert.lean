theorem ite_pos_sub {α : Sort _} {P : Prop} {inst : Decidable P} {a b : α} (h : P) :
    @ite α P inst a b = a :=
  PosPostPrep80FastSubblocks.ite_pos_sub (α := α) (P := P) (inst :=
      inst) (a := a) (b := b) h

theorem ite_neg_sub {α : Sort _} {P : Prop} {inst : Decidable P} {a b : α} (h : ¬P) :
    @ite α P inst a b = b :=
  PosPostPrep80FastSubblocks.ite_neg_sub (α := α) (P := P) (inst :=
      inst) (a := a) (b := b) h

theorem dite_neg_sub {α : Sort _} {P : Prop} {inst : Decidable P}
    {a : P → α} {b : ¬P → α} (h : ¬P) :
    @dite α P inst a b = b h :=
  PosPostPrep80FastSubblocks.dite_neg_sub (α := α) (P := P) (inst
      := inst) (a := a) (b := b) h

theorem qreg_ext_sub {k n : ℕ} {r s : QRegister k n} (h : ∀ i, r i = s i) : r = s :=
  QRegister.ext (Function.Embedding.ext h)

theorem mul_mulVec_sub {M : ℕ} (A B : Matrix (Fin M) (Fin M) ℂ) (v : Fin M → ℂ) :
    (A * B).mulVec v = A.mulVec (B.mulVec v) :=
  (Matrix.mulVec_mulVec v A B).symm

private theorem diagonal_mulVec_ket_sub {N : ℕ} (f : Fin (2 ^ N) → ℂ) (β : BitAssignment N) :
    (Matrix.diagonal f).mulVec (ket β) = f ((basisBitsEquiv N).symm β) • ket β :=
  PosPostPrep80FastSubblocks.diagonal_mulVec_ket_sub (N := N) f β

/-- Local basis index extracted from `β` along `r`. -/
noncomputable abbrev localIdxSub {k n : ℕ} (r : QRegister k n) (β : BitAssignment n) :
    Fin (2 ^ k) :=
  (basisBitsEquiv k).symm (fun i ↦ β (r i))

private theorem embedMatrix_mulVec_ket_sub {k n : ℕ} (r : QRegister k n)
    (A : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) (β : BitAssignment n) :
    (r.embedMatrix A).mulVec (ket β) =
      ∑ l : Fin (2 ^ k),
        A l (localIdxSub r β) • ket (ZeroAncillaUSP.writeReg β r (basisBits k l)) :=
  PosPostPrep80FastSubblocks.embedMatrix_mulVec_ket_sub (k := k) (n
      := n) r A β

private theorem ket_localIdxSub_eq {k n : ℕ} (r : QRegister k n) (β : BitAssignment n)
    (l : Fin (2 ^ k)) (M : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) :
    M.mulVec (ket (fun i ↦ β (r i))) l = M l (localIdxSub r β) := by
  rw [ket_eq_single_local, Matrix.mulVec_single_one]; rfl

private theorem mulVec_eq_sum_ket_sub {k : ℕ} (ψ : Fin (2 ^ k) → ℂ) :
    ψ = ∑ x : Fin (2 ^ k), ψ x • ket (basisBits k x) :=
  PosPostPrep80FastSubblocks.mulVec_eq_sum_ket_sub (k := k) ψ

/-- Linear span of computational basis states `ket β` satisfying `P β`. -/
noncomputable def KetSpanSub {n : ℕ} (P : BitAssignment n → Prop) :
    Submodule ℂ (Fin (2 ^ n) → ℂ) :=
  Submodule.span ℂ { ψ | ∃ β : BitAssignment n, P β ∧ ψ = ket β }

/-- Static circuit `c` maps every basis state `ket β` satisfying `P β` into `KetSpanSub Q`. -/
def PreservesSpanSub {n : ℕ} (P Q : BitAssignment n → Prop) (c : Circuit n) : Prop :=
  ∀ β : BitAssignment n, P β → c.eval.1.mulVec (ket β) ∈ KetSpanSub Q

/-- Predicate `P` is invariant under arbitrary updates to wire `w`. -/
def WireIndepSub {n : ℕ} (P : BitAssignment n → Prop) (w : Wire n) : Prop :=
  ∀ (β : BitAssignment n) (b : ZMod 2), P β → P (Function.update β w b)

theorem ket_mem_ketSpanSub {n : ℕ} {P : BitAssignment n → Prop} {β : BitAssignment n}
    (h : P β) : ket β ∈ KetSpanSub P :=
  Submodule.subset_span ⟨β, h, rfl⟩

theorem preservesSpanSub_id {n : ℕ} {P : BitAssignment n → Prop} :
    PreservesSpanSub P P (Circuit.identity : Circuit n) :=
  PosPostPrep80FastSubblocks.preservesSpanSub_id (n := n) (P := P)

theorem preservesSpanSub_singleton_matrix {n : ℕ} {P : BitAssignment n → Prop}
    (q : Wire n) (hq : WireIndepSub P q) (M : Matrix (Fin 2) (Fin 2) ℂ) (β : BitAssignment n)
    (hβ : P β) :
    ((QRegister.singleton q).embedMatrix M).mulVec (ket β) ∈ KetSpanSub P :=
  PosPostPrep80FastSubblocks.preservesSpanSub_singleton_matrix (n
      := n) (P := P) q hq M β hβ

theorem preservesSpanSub_cnotIf {n : ℕ} {P : BitAssignment n → Prop}
    (c t : Wire n) (ht : WireIndepSub P t) :
    PreservesSpanSub P P (cnotIf c t) :=
  PosPostPrep80FastSubblocks.preservesSpanSub_cnotIf (n := n) (P :=
      P) c t ht

theorem inv_mulVec_ket_of_fwd_sub {n : ℕ} (c : Circuit n) (β₀ β₁ : BitAssignment n)
    (hFwd : c.eval.1.mulVec (ket β₀) = ket β₁) :
    c.inverse.eval.1.mulVec (ket β₁) = ket β₀ :=
  PosPostPrep80FastSubblocks.inv_mulVec_ket_of_fwd_sub (n := n) c
      β₀ β₁ hFwd

theorem unitary_mul_assoc_sub {M : ℕ} (A B C : Unitary M) :
    A * B * C = A * (B * C) :=
  mul_assoc A B C

theorem unitary_mul_inv_rev_sub {M : ℕ} (A B : Unitary M) :
    (A * B)⁻¹ = B⁻¹ * A⁻¹ :=
  _root_.mul_inv_rev A B

