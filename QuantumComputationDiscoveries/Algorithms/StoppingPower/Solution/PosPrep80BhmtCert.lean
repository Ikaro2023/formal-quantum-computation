private theorem DynPair152.symm {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^
    n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    {S : BitAssignment 152 → Prop} {t : ℕ}
    {dFwd dInv : DynamicCircuit Var n} {U : Unitary (2 ^ 152)}
    (hp : DynPair152 v rFull152 rExtra9 S t dFwd dInv U) :
    DynPair152 v rFull152 rExtra9 S t dInv dFwd U⁻¹ :=
  { toffFwd := hp.toffInv
    toffInv := hp.toffFwd
    tFwd := hp.tInv
    tInv := hp.tFwd
    storeFwd := hp.storeInv
    storeInv := hp.storeFwd
    presLoc := subDiagProj_mul_inv_of_self S U hp.presLoc
    realFwd := hp.realInv
    realInv := by rw [inv_inv]; exact hp.realFwd }


theorem preservesSpanSub_H_wire {N : ℕ} {S : BitAssignment N → Prop} {q : Wire N}
    (hInd : WireIndepSub S q) : PreservesSpanSub S S (Circuit.H q) := by
  intro α hα
  rw [ket_H q α]
  exact (KetSpanSub S).smul_mem sqrtHalf
    ((KetSpanSub S).add_mem
      (ket_mem_ketSpanSub (hInd α 0 hα))
      ((KetSpanSub S).smul_mem _ (ket_mem_ketSpanSub (hInd α 1 hα))))


theorem preservesSpanSub_seq_sub {N : ℕ} {S₁ S₂ S₃ : BitAssignment N → Prop}
    {c₁ c₂ : Circuit N} (h₁ : PreservesSpanSub S₁ S₂ c₁) (h₂ : PreservesSpanSub S₂ S₃ c₂) :
    PreservesSpanSub S₁ S₃ (c₁ ;;ᶜ c₂) := by
  intro α hα
  rw [eval_seq_mulVec]
  have hv := h₁ α hα
  revert hv
  generalize c₁.eval.1.mulVec (ket α) = v
  intro hv
  induction hv using Submodule.span_induction with
  | mem x hx =>
      rcases hx with ⟨γ, hγ, rfl⟩
      exact h₂ γ hγ
  | zero => rw [Matrix.mulVec_zero]; exact (KetSpanSub S₃).zero_mem
  | add x y _ _ ihx ihy => rw [Matrix.mulVec_add]; exact (KetSpanSub S₃).add_mem ihx ihy
