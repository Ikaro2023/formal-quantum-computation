    (hCToff : C.count PrimitiveGate.TOFF = 0)
    (hCT : C.count PrimitiveGate.T = 0)
    (hCFwd : PreservesSpan S_pre S_mid C)
    (hCBwd : PreservesSpan S_mid S_pre C.inverse)
    {bFwd bInv : DynamicCircuit Var n} {U_body : Unitary (2 ^ 152)}
    (hb : DynPair152 v rFull152 rExtra9 (Lift128To152 S_mid) t bFwd bInv U_body) :
    DynPair152 v rFull152 rExtra9 (Lift128To152 S_pre) t
      (mkWithCliffDyn (rFull152.compose rSub128) C bFwd)
      (mkWithCliffDyn (rFull152.compose rSub128) C bInv)
      (rSub128.embedUnitary C.inverse.eval * U_body * rSub128.embedUnitary C.eval) := by
  let rSub := rFull152.compose rSub128
  let P_preL := subDiagProj (SubLift152 rFull152 rExtra9 (Lift128To152 S_pre))
  let P_midL := subDiagProj (SubLift152 rFull152 rExtra9 (Lift128To152 S_mid))
  have hPpre_herm : P_preLᴴ = P_preL := subDiagProj_conjTranspose _
  have hPmid_herm : P_midLᴴ = P_midL := subDiagProj_conjTranspose _
  have hCFwd_128 : diagProj S_mid * (C.eval.1 * diagProj S_pre) = C.eval.1 * diagProj S_pre :=
    diagProj_mul_of_preservesSpan hCFwd
  have hCBwd_128 :
      diagProj S_pre * (C.inverse.eval.1 * diagProj S_mid) = C.inverse.eval.1 * diagProj S_mid :=
    diagProj_mul_of_preservesSpan hCBwd
  have hCFwd_loc := subDiagProj_Lift128To152_mul_embedSub128 S_pre S_mid C.eval hCFwd_128
  have hCBwd_loc := subDiagProj_Lift128To152_mul_embedSub128 S_mid S_pre C.inverse.eval hCBwd_128
  have hCFwd_L := subDiagProj_SubLift152_mul_embedUnitary rFull152 rExtra9 hDisjExtra
    (Lift128To152 S_pre) (Lift128To152 S_mid) (rSub128.embedUnitary C.eval) hCFwd_loc
  have hEvC : (C.onRegister rSub).eval = rFull152.embedUnitary (rSub128.embedUnitary C.eval) := by
    rw [Circuit.eval_onRegister, QRegister.embedUnitary_compose]
  have hEvCI : (C.inverse.onRegister rSub).eval =
      rFull152.embedUnitary (rSub128.embedUnitary C.inverse.eval) := by
    rw [Circuit.eval_onRegister, QRegister.embedUnitary_compose]
  have hCFwd_onReg : P_midL * ((C.onRegister rSub).eval.1 * P_preL) =
      (C.onRegister rSub).eval.1 * P_preL := by
    rw [hEvC]; exact hCFwd_L
  have hStepFwd := realizesCleanUnitary_sandwich_circuit_sub hPpre_herm hPmid_herm
    (C.onRegister rSub) (C.inverse.onRegister rSub) hCFwd_onReg hb.realFwd
  have hStepInv := realizesCleanUnitary_sandwich_circuit_sub hPpre_herm hPmid_herm
    (C.onRegister rSub) (C.inverse.onRegister rSub) hCFwd_onReg hb.realInv
  have hEmbFwd :
      ((C.inverse.onRegister rSub).eval * rFull152.embedUnitary U_body) *
          (C.onRegister rSub).eval =
        rFull152.embedUnitary
          (rSub128.embedUnitary C.inverse.eval * U_body * rSub128.embedUnitary C.eval) := by
    rw [hEvC, hEvCI, ← rFull152.embedUnitary_mul, ← rFull152.embedUnitary_mul]
  have hU_inv_eq :
      (rSub128.embedUnitary C.inverse.eval * U_body * rSub128.embedUnitary C.eval)⁻¹ =
        rSub128.embedUnitary C.inverse.eval * U_body⁻¹ * rSub128.embedUnitary C.eval := by
    rw [unitary_mul_inv_rev_sub, unitary_mul_inv_rev_sub,
      embedUnitary_inv_eq rSub128 C.eval, embedUnitary_inv_eq rSub128 C.inverse.eval,
      Circuit.eval_inverse, inv_inv, ← unitary_mul_assoc_sub]
  have hEmbInv :
      ((C.inverse.onRegister rSub).eval * rFull152.embedUnitary U_body⁻¹) *
          (C.onRegister rSub).eval =
        rFull152.embedUnitary
          (rSub128.embedUnitary C.inverse.eval * U_body * rSub128.embedUnitary C.eval)⁻¹ := by
    rw [hEvC, hEvCI, hU_inv_eq, ← rFull152.embedUnitary_mul, ← rFull152.embedUnitary_mul]
  exact {
    toffFwd := by rw [count_toff_mkWithCliffDyn rSub C hCToff]; exact hb.toffFwd
    toffInv := by rw [count_toff_mkWithCliffDyn rSub C hCToff]; exact hb.toffInv
    tFwd := by rw [count_t_mkWithCliffDyn rSub C hCT]; exact hb.tFwd
    tInv := by rw [count_t_mkWithCliffDyn rSub C hCT]; exact hb.tInv
    storeFwd := PreservesStoreConst.seq (PreservesStoreConst.circuit _)
      (PreservesStoreConst.seq hb.storeFwd (PreservesStoreConst.circuit _))
    storeInv := PreservesStoreConst.seq (PreservesStoreConst.circuit _)
      (PreservesStoreConst.seq hb.storeInv (PreservesStoreConst.circuit _))
    presLoc := by
      let ECI := rSub128.embedUnitary C.inverse.eval
      let EC := rSub128.embedUnitary C.eval
      calc subDiagProj (Lift128To152 S_pre) * ((ECI * U_body * EC).1 *
        subDiagProj (Lift128To152 S_pre))
          = subDiagProj (Lift128To152 S_pre) * (ECI.1 * (U_body.1 * (EC.1 *
            subDiagProj (Lift128To152 S_pre)))) := by
              simp only [Submonoid.coe_mul, Matrix.mul_assoc]
        _ = subDiagProj (Lift128To152 S_pre) * (ECI.1 * (U_body.1 *
              (subDiagProj (Lift128To152 S_mid) * (EC.1 * subDiagProj (Lift128To152 S_pre))))) := by
              rw [hCFwd_loc]
        _ = subDiagProj (Lift128To152 S_pre) * (ECI.1 *
              ((U_body.1 * subDiagProj (Lift128To152 S_mid)) * (EC.1 *
                subDiagProj (Lift128To152 S_pre)))) := by
              simp only [Matrix.mul_assoc]
        _ = subDiagProj (Lift128To152 S_pre) * (ECI.1 *
              ((subDiagProj (Lift128To152 S_mid) * (U_body.1 * subDiagProj (Lift128To152 S_mid))) *
                (EC.1 * subDiagProj (Lift128To152 S_pre)))) := by
              rw [hb.presLoc]
        _ = (subDiagProj (Lift128To152 S_pre) * (ECI.1 * subDiagProj (Lift128To152 S_mid))) *
              ((U_body.1 * subDiagProj (Lift128To152 S_mid)) * (EC.1 *
                subDiagProj (Lift128To152 S_pre))) := by
              simp only [Matrix.mul_assoc]
        _ = (ECI.1 * subDiagProj (Lift128To152 S_mid)) *
              ((U_body.1 * subDiagProj (Lift128To152 S_mid)) * (EC.1 *
                subDiagProj (Lift128To152 S_pre))) := by
              rw [hCBwd_loc]
        _ = ECI.1 * ((subDiagProj (Lift128To152 S_mid) * (U_body.1 *
          subDiagProj (Lift128To152 S_mid))) *
              (EC.1 * subDiagProj (Lift128To152 S_pre))) := by simp only [Matrix.mul_assoc]
        _ = ECI.1 * ((U_body.1 * subDiagProj (Lift128To152 S_mid)) * (EC.1 *
          subDiagProj (Lift128To152 S_pre))) := by
              rw [hb.presLoc]
        _ = ECI.1 * (U_body.1 * (subDiagProj (Lift128To152 S_mid) * (EC.1 *
          subDiagProj (Lift128To152 S_pre)))) := by
              simp only [Matrix.mul_assoc]
        _ = (ECI * U_body * EC).1 * subDiagProj (Lift128To152 S_pre) := by
              dsimp only [ECI, EC]; rw [hCFwd_loc]; simp only [Submonoid.coe_mul, Matrix.mul_assoc]
    realFwd := hEmbFwd ▸ hStepFwd
    realInv := hEmbInv ▸ hStepInv
  }


open Classical in
private theorem DynPair152_withTempAnd128 {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    (c₁ c₂ anc : Wire 128) (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    {S_pre S_mid : BitAssignment 128 → Prop} {t : ℕ}
    (hPreZero : ∀ α, S_pre α → α anc = 0)
    (hMidEq : ∀ δ, S_mid δ → δ anc = δ c₁ * δ c₂)
    (hStepFwd : ∀ α, S_pre α → S_mid (Function.update α anc (α c₁ * α c₂)))
    (hStepBwd : ∀ δ, S_mid δ → S_pre (Function.update δ anc 0))
    {bFwd bInv : DynamicCircuit Var n} {U_body : Unitary (2 ^ 152)}
    (hb : DynPair152 v rFull152 rExtra9 (Lift128To152 S_mid) t bFwd bInv U_body) :
    DynPair152 v rFull152 rExtra9 (Lift128To152 S_pre) (t + 4)
      (mkWithTempAndDyn v (rFull152.compose rSub128) c₁ c₂ anc h₁₂ h₁a h₂a bFwd)
      (mkWithTempAndDyn v (rFull152.compose rSub128) c₁ c₂ anc h₁₂ h₁a h₂a bInv)
      (rSub128.embedUnitary (andComputeIf c₁ c₂ anc).inverse.eval * U_body *
        rSub128.embedUnitary (andComputeIf c₁ c₂ anc).eval) := by
  have h₁₂' : rSub128 c₁ ≠ rSub128 c₂ := rSub128.wires.injective.ne h₁₂
  have h₁a' : rSub128 c₁ ≠ rSub128 anc := rSub128.wires.injective.ne h₁a
  have h₂a' : rSub128 c₂ ≠ rSub128 anc := rSub128.wires.injective.ne h₂a
  have hPull : ∀ (α : BitAssignment 152) (b : ZMod 2),
      (fun i ↦ Function.update α (rSub128 anc) b (rSub128 i)) =
        Function.update (fun i ↦ α (rSub128 i)) anc b := by
    intro α b; funext i
    by_cases hia : i = anc
    · subst hia; simp
    · rw [Function.update_of_ne (rSub128.wires.injective.ne hia), Function.update_of_ne hia]
  have hAncLt : ∀ w : Wire 152, 128 ≤ w.val → w ≠ rSub128 anc := fun w hw h ↦ by
    have hv := congrArg Fin.val h; rw [rSub128_val] at hv; have := anc.isLt; omega
  have hPairT := DynPair152.withTempAnd hDisjExtra
    (rSub128 c₁) (rSub128 c₂) (rSub128 anc) h₁₂' h₁a' h₂a'
    (S_pre := Lift128To152 S_pre) (S_mid := Lift128To152 S_mid)
    (fun α h ↦ hPreZero _ h.1)
    (fun δ h ↦ hMidEq _ h.1)
    (fun α ⟨h1, h2⟩ ↦ ⟨by rw [hPull]; exact hStepFwd _ h1,
      fun w hw ↦ by rw [Function.update_of_ne (hAncLt w hw), h2 w hw]⟩)
    (fun δ ⟨h1, h2⟩ ↦ ⟨by rw [hPull]; exact hStepBwd _ h1,
      fun w hw ↦ by rw [Function.update_of_ne (hAncLt w hw), h2 w hw]⟩)
    hb
  have hDynEq : ∀ b : DynamicCircuit Var n,
      mkWithTempAndDyn152 v rFull152 (rSub128 c₁) (rSub128 c₂) (rSub128 anc) h₁₂' h₁a' h₂a' b =
        mkWithTempAndDyn v (rFull152.compose rSub128) c₁ c₂ anc h₁₂ h₁a h₂a b :=
    fun _ ↦ rfl
  rw [hDynEq bFwd, hDynEq bInv] at hPairT
  refine hPairT.congr_fwd fun α hα ↦ ?_
  let T_loc := (Circuit.TOFF (rSub128 c₁) (rSub128 c₂) (rSub128 anc) h₁₂' h₁a' h₂a').eval
  simp only [Submonoid.coe_mul, mul_mulVec_sub]
  have hIn₁ : T_loc.1.mulVec (ket α) =
      ket (Function.update α (rSub128 anc) (α (rSub128 c₁) * α (rSub128 c₂))) := by
    dsimp only [T_loc]
    rw [ket_TOFF, hPreZero _ hα.1, zero_add]
  have hIn₂ : (rSub128.embedUnitary (andComputeIf c₁ c₂ anc).eval).1.mulVec (ket α) =
      ket (Function.update α (rSub128 anc) (α (rSub128 c₁) * α (rSub128 c₂))) := by
    rw [embedUnitary_mulVec_ket_sub rSub128 _ α _
      (ket_andComputeIf_of_zero_cert c₁ c₂ anc h₁a h₂a _ (hPreZero _ hα.1)),
      writeReg_update_sub]
  rw [hIn₁, hIn₂]
  let α_mid := Function.update α (rSub128 anc) (α (rSub128 c₁) * α (rSub128 c₂))
  have hα_mid : Lift128To152 S_mid α_mid :=
    ⟨by dsimp only [α_mid]; rw [hPull]; exact hStepFwd _ hα.1,
     fun w hw ↦ by dsimp only [α_mid]; rw [Function.update_of_ne (hAncLt w hw), hα.2 w hw]⟩
  let ψ := U_body.1.mulVec (ket α_mid)
  have hψ_pres : (subDiagProj (Lift128To152 S_mid)).mulVec ψ = ψ := by
    have hv := congrArg (fun M ↦ M.mulVec (ket α_mid)) hb.presLoc
    simp only [mul_mulVec_sub, subDiagProj_mulVec_ket, hα_mid, ↓reduceIte] at hv
    exact hv
  change T_loc.1.mulVec ψ =
    (rSub128.embedUnitary (andComputeIf c₁ c₂ anc).inverse.eval).1.mulVec ψ
  rw [mulVec_eq_sum_ket_sub ψ, Matrix.mulVec_sum, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  by_cases hx0 : ψ x = 0
  · simp only [hx0, zero_smul, Matrix.mulVec_zero]
  · rw [Matrix.mulVec_smul, Matrix.mulVec_smul]
    have hSx : Lift128To152 S_mid (basisBits 152 x) :=
      mem_of_subDiagProj_mulVec_eq (congrFun hψ_pres x) hx0
    let δ := basisBits 152 x
    have hOut₁ : T_loc.1.mulVec (ket δ) = ket (Function.update δ (rSub128 anc) 0) := by
      have hz : δ (rSub128 anc) + δ (rSub128 c₁) * δ (rSub128 c₂) = 0 := by
        dsimp only [δ]; rw [hMidEq _ hSx.1, CharTwo.add_self_eq_zero]
      dsimp only [T_loc]; rw [ket_TOFF, hz]
    have hOut₂ : (rSub128.embedUnitary (andComputeIf c₁ c₂ anc).inverse.eval).1.mulVec (ket δ) =
        ket (Function.update δ (rSub128 anc) 0) := by
      rw [embedUnitary_mulVec_ket_sub rSub128 _ δ _
        (ket_andComputeIf_inv_of_eq c₁ c₂ anc h₁a h₂a _ (hMidEq _ hSx.1)),
        writeReg_update_sub]
    change ψ x • T_loc.1.mulVec (ket δ) =
      ψ x • (rSub128.embedUnitary (andComputeIf c₁ c₂ anc).inverse.eval).1.mulVec (ket δ)
    rw [hOut₁, hOut₂]


open Classical in
private theorem DynPair152_congr_sandwich128 {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    {S_pre S_mid : BitAssignment 128 → Prop} {t : ℕ}
    {dFwd dInv : DynamicCircuit Var n}
    {C₁ C₂ : Circuit 128} {U_body : Unitary (2 ^ 152)}
    (hPresBody : subDiagProj (Lift128To152 S_mid) *
        (U_body.1 * subDiagProj (Lift128To152 S_mid)) =
      U_body.1 * subDiagProj (Lift128To152 S_mid))
    (hp : DynPair152 v rFull152 rExtra9 (Lift128To152 S_pre) t dFwd dInv
      (rSub128.embedUnitary C₁.inverse.eval * U_body * rSub128.embedUnitary C₁.eval))
    (hStep : ∀ β, S_pre β → ∃ β_mid, S_mid β_mid ∧
      C₁.eval.1.mulVec (ket β) = ket β_mid ∧ C₂.eval.1.mulVec (ket β) = ket β_mid)
    (hInv : ∀ γ, S_mid γ → ∃ γ_out,
      C₁.inverse.eval.1.mulVec (ket γ) = ket γ_out ∧
      C₂.inverse.eval.1.mulVec (ket γ) = ket γ_out) :
    DynPair152 v rFull152 rExtra9 (Lift128To152 S_pre) t dFwd dInv
      (rSub128.embedUnitary C₂.inverse.eval * U_body * rSub128.embedUnitary C₂.eval) := by
  refine hp.congr_fwd fun α hα ↦ ?_
  obtain ⟨β_mid, hβ_mid, hIn₁, hIn₂⟩ := hStep (fun i ↦ α (rSub128 i)) hα.1
  simp only [Submonoid.coe_mul, mul_mulVec_sub]
  rw [embedUnitary_mulVec_ket_sub rSub128 _ α β_mid hIn₁,
    embedUnitary_mulVec_ket_sub rSub128 _ α β_mid hIn₂]
  let α_mid := ZeroAncillaUSPS3.writeReg α rSub128 β_mid
  have hα_mid : Lift128To152 S_mid α_mid := by
    refine ⟨?_, fun w hw ↦ ?_⟩
    · have heq : (fun i ↦ α_mid (rSub128 i)) = β_mid := by
        funext i; exact ZeroAncillaUSPS3.writeReg_apply_reg _ _ _ i
      rwa [heq]
    · have hnot : ¬∃ i : Fin 128, rSub128 i = w := by
        rintro ⟨i, rfl⟩; have hv := rSub128_val i; omega
      dsimp only [α_mid]
      rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hnot, hα.2 w hw]
  let ψ := U_body.1.mulVec (ket α_mid)
  have hψ_pres : (subDiagProj (Lift128To152 S_mid)).mulVec ψ = ψ := by
    have hv := congrArg (fun M ↦ M.mulVec (ket α_mid)) hPresBody
    simp only [mul_mulVec_sub, subDiagProj_mulVec_ket, hα_mid, ↓reduceIte] at hv
    exact hv
  change (rSub128.embedUnitary C₁.inverse.eval).1.mulVec ψ =
    (rSub128.embedUnitary C₂.inverse.eval).1.mulVec ψ
  rw [mulVec_eq_sum_ket_sub ψ, Matrix.mulVec_sum, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  by_cases hx0 : ψ x = 0
  · simp only [hx0, zero_smul, Matrix.mulVec_zero]
  · rw [Matrix.mulVec_smul, Matrix.mulVec_smul]
    have hSx : Lift128To152 S_mid (basisBits 152 x) :=
      mem_of_subDiagProj_mulVec_eq (congrFun hψ_pres x) hx0
    let δ := basisBits 152 x
    obtain ⟨γ_out, hO₁, hO₂⟩ := hInv (fun i ↦ δ (rSub128 i)) hSx.1
    change ψ x • (rSub128.embedUnitary C₁.inverse.eval).1.mulVec (ket δ) =
      ψ x • (rSub128.embedUnitary C₂.inverse.eval).1.mulVec (ket δ)
    rw [embedUnitary_mulVec_ket_sub rSub128 _ δ γ_out hO₁,
      embedUnitary_mulVec_ket_sub rSub128 _ δ γ_out hO₂]


