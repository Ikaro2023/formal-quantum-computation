          rw [Function.update_self]
      rw [hSub]
      exact (basisBitsEquiv 2).symm_apply_apply pLo
  · dsimp only [validTailBhmt] at hV
    have hEq0 := hRT (clrPid12_80 p) hV
    have hSub : basisBits 2 ((basisBitsEquiv 2).symm
        (fun k : Fin 2 ↦ p (pos80SubIdx 70 2 (by decide) k))) =
