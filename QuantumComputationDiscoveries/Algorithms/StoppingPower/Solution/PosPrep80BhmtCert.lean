  let q1 := s0t * (n01 + n0) + n1
  let q2 := n2 * q1 + n2 + q1
  let q3 := n3 * n4
  let q4 := q3 * q2
  let q5 := n5 * q4 + n5 + q4
  let q6 := n6 * n7
