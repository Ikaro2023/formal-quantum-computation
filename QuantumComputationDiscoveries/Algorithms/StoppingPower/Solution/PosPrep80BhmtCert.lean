      b2z (ep && !(c29 && etBool ep ih) && !badAncBool a1 a2 a3 a4 a5 a6 a7 (c0hBool ep ih c0)) :=
        by
  have hSimJa := evalProg152_lift22 embJa_inj jaProg22 δ0 _ hInitJa
  obtain ⟨hja16, hja17, hja18⟩ := jaProg22_spec a1 a2 a3 a4 a5 a6 a7 c29 ep ih c0
  refine ⟨?_, ?_, ?_⟩
  · change evalProg152 (jaProg22.map (liftStep22 embJa)) δ0 (embJa .r19) = 0
    rw [hSimJa .r19, hja16]; rfl
  · change evalProg152 (jaProg22.map (liftStep22 embJa)) δ0 (embJa .r20) = 0
    rw [hSimJa .r20, hja17]; rfl
  · change evalProg152 (jaProg22.map (liftStep22 embJa)) δ0 (embJa .r21) = _
    rw [hSimJa .r21, hja18]


theorem evalProg152_pGoodNuc8_bool (δ1 : BitAssignment 152)
