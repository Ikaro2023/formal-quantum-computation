def encHeadSub80 (isMerged218 s0 : Bool) (hs : HeadSubTuple) : BitAssignment 80 :=
  Function.update (encHead80 isMerged218 s0 hs.1) 62 (if hs.2 then 1 else 0)


def validHeadSub80 (isMerged218 s0 : Bool) (p : BitAssignment 80) : Bool :=
  validHead80 isMerged218 s0 (Function.update p 62 0)


def decHeadSub80 (isMerged218 s0 : Bool) (p : BitAssignment 80) : HeadSubTuple :=
  (decHead80 isMerged218 s0 (Function.update p 62 0), p 62 == 1)


theorem encHead80_at62 (isMerged218 s0 : Bool) (t : HeadTuple) :
    encHead80 isMerged218 s0 t 62 = 0 := by
  rcases t with ⟨u2, sm, nuc, b0, anc, bAux, k, pid⟩
  have hNorm62 : headNormQ s0 (u2, sm, nuc, b0, anc, bAux, k, pid) 62 = 0 :=
    headJointPayload80_at62 _ _ _ _ _ _ _ _ _
  have hNorm30 : headNormQ s0 (u2, sm, nuc, b0, anc, bAux, k, pid) 30 = 1 :=
    headJointPayload80_at30 _ _ _ _ _ _ _ _ _
  cases s0
  · simp only [encHead80, rawFromNorm, Bool.not_false, ↓reduceIte]
    rw [dite_eq_right (by decide : ¬(3 ≤ (62 : Fin 80).val ∧ (62 : Fin 80).val < 6))]
    cases isMerged218
    · exact hNorm62
    · simp only [↓reduceIte, flipTailDpScratch80, hNorm30, eq_self]
      exact hNorm62
  · exact hNorm62


theorem head_sub_bijection_props (isMerged218 s0 : Bool) :
    (∀ hs : HeadSubTuple, validHeadSub80 isMerged218 s0 (encHeadSub80 isMerged218 s0 hs) = true) ∧
    (∀ hs : HeadSubTuple, decHeadSub80 isMerged218 s0 (encHeadSub80 isMerged218 s0 hs) = hs) ∧
    (∀ p : BitAssignment 80, validHeadSub80 isMerged218 s0 p = true →
      encHeadSub80 isMerged218 s0 (decHeadSub80 isMerged218 s0 p) = p) := by
  obtain ⟨hVH, hLH, hRH⟩ := head_bijection_props isMerged218 s0
  have hClrEnc : ∀ hs : HeadSubTuple,
      Function.update (encHeadSub80 isMerged218 s0 hs) 62 0 = encHead80 isMerged218 s0 hs.1 :=
    fun ⟨t, bSub⟩ ↦ by
      dsimp only [encHeadSub80]
      rw [Function.update_idem,
        Function.update_eq_self_iff.mpr (encHead80_at62 isMerged218 s0 t).symm]
  refine ⟨fun hs ↦ ?_, fun ⟨t, bSub⟩ ↦ ?_, fun p hV ↦ ?_⟩
  · dsimp only [validHeadSub80]
    rw [hClrEnc hs]
    exact hVH hs.1
  · apply Prod.ext
    · dsimp only [decHeadSub80]
      rw [hClrEnc (t, bSub)]
      exact hLH t
    · dsimp only [decHeadSub80, encHeadSub80]
      rw [Function.update_self]
      cases bSub <;> rfl
  · dsimp only [validHeadSub80] at hV
    have hEq0 := hRH (Function.update p 62 0) hV
    dsimp only [encHeadSub80, decHeadSub80]
    rw [hEq0, Function.update_idem]
    have hb : (if p 62 == 1 then (1 : ZMod 2) else 0) = p 62 := by
      rcases bit_cases (p 62) with h0 | h1
      · rw [h0]; rfl
      · rw [h1]; rfl
    rw [hb, Function.update_eq_self]


theorem headCoordXorSub80Fn_update62 (p : BitAssignment 80) (b : ZMod 2) :
    Pos24HeadCoordXor80.headCoordXorSub80Fn (Function.update p 62 b) =
      Function.update (Pos24HeadCoordXor80.headCoordXorSub80Fn p) 62 b := by
  have hm30 : Function.update p 62 b 30 = p 30 := by
    rw [Function.update_of_ne (by decide)]
  have hm63 : (fun i : Fin 6 ↦
    Function.update p 62 b ⟨63 + i.val, Pos24HeadCoordXor80.idx63_lt80 i⟩) =
      fun i : Fin 6 ↦ p ⟨63 + i.val, Pos24HeadCoordXor80.idx63_lt80 i⟩ :=
    funext fun i ↦ by
      rw [Function.update_of_ne (by intro h; have := congrArg Fin.val h; dsimp at this; omega)]
  have hm69 : (fun i : Fin 3 ↦
    Function.update p 62 b ⟨69 + i.val, Pos24HeadCoordXor80.idx69_lt80 i⟩) =
      fun i : Fin 3 ↦ p ⟨69 + i.val, Pos24HeadCoordXor80.idx69_lt80 i⟩ :=
    funext fun i ↦ by
      rw [Function.update_of_ne (by intro h; have := congrArg Fin.val h; dsimp at this; omega)]
  have hm72 : (fun i : Fin 3 ↦
    Function.update p 62 b ⟨72 + i.val, Pos24HeadCoordXor80.idx72_lt80 i⟩) =
      fun i : Fin 3 ↦ p ⟨72 + i.val, Pos24HeadCoordXor80.idx72_lt80 i⟩ :=
    funext fun i ↦ by
      rw [Function.update_of_ne (by intro h; have := congrArg Fin.val h; dsimp at this; omega)]
  funext q
  by_cases hq : q = 62
  · subst hq
    rw [Function.update_self]
    unfold Pos24HeadCoordXor80.headCoordXorSub80Fn
    rw [dite_eq_right (by decide : ¬((62 : Fin 80).val < 3)),
      dite_eq_right (by decide : ¬(32 ≤ (62 : Fin 80).val ∧ (62 : Fin 80).val < 53)),
      Function.update_self]
  · rw [Function.update_of_ne hq]
    unfold Pos24HeadCoordXor80.headCoordXorSub80Fn
    rw [hm30, hm63, hm69, hm72]
    simp only [Function.update_of_ne hq]


