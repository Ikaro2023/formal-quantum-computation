def teleCoreMatZw (bOdds fOdds : List (Fin 4)) (mx mz fl : Bool) : Mat2Zw :=
  matZwMul (matZwXPow fl)
    (matZwMul (evalList (oddsToHst fOdds) matId)
      (matZwMul (matZwZPow mz)
        (matZwMul (matZwXPow mx)
          (matZwAdj (evalList (oddsToHst bOdds) matId)))))


theorem toMatrix_teleCoreMatZw (bOdds fOdds : List (Fin 4)) (mx mz fl : Bool) :
    (teleCoreMatZw bOdds fOdds mx mz fl).toMatrix = teleCoreMat bOdds fOdds mx mz fl := by
  unfold teleCoreMatZw teleCoreMat wordMatrix2
  rw [toMatrix_matZwMul, toMatrix_matZwMul, toMatrix_matZwMul, toMatrix_matZwMul,
    toMatrix_matZwXPow, toMatrix_matZwZPow, toMatrix_matZwXPow, toMatrix_matZwAdj]
