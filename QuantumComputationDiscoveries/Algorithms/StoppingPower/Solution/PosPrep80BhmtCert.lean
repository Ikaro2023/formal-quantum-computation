      set dpv := (⟨Pos24HeadCoordXor80.bitsVal
        fun j : Fin 3 ↦ q (pos80SubIdx 75 3 (by decide) j), bitsVal3_lt8 _⟩ : Fin 8)
      have hxor0 : 0 ^^^ dpv.val = dpv.val := Nat.zero_xor dpv.val
      have heq0 : p 0 = p ⟨75, by decide⟩ + p 0 := by
        have e0 := congrFun htw ⟨0, by decide⟩
        have e75 := congrFun htw ⟨75, by decide⟩
        have q0 : Function.update q 62 0 ⟨0, by decide⟩ = p 0 := by
          rw [Function.update_of_ne (by decide), hq_def]; rfl
        have q75 : Function.update q 62 0 ⟨75, by decide⟩ = p ⟨75, by decide⟩ + p 0 := by
          rw [Function.update_of_ne (by decide), hq_def]; rfl
        rw [q0] at e0; rw [q75] at e75
        dsimp [tailWitnessPayload80] at e0 e75
        rw [hxor0] at e0
        exact e0.trans e75.symm
      have heq1 : p 1 = p ⟨76, by decide⟩ + p 1 := by
        have e1 := congrFun htw ⟨1, by decide⟩
        have e76 := congrFun htw ⟨76, by decide⟩
        have q1 : Function.update q 62 0 ⟨1, by decide⟩ = p 1 := by
