noncomputable def branchMuxMat (isHead s0 : Bool) : Matrix (Fin 2) (Fin 2) ℂ :=
  if isHead then matMuxHead else if s0 then matMuxS4Tail else matMuxS2Tail


noncomputable def branchSSq (isHead s0 : Bool) : ℝ :=
  if isHead then sSqHead11 else if s0 then sSqS4Tail11 else sSqS2Tail11


def branchCardG48 (isHead s0 : Bool) : ℕ :=
  if isHead then
    if s0 then 8 * 2 ^ 30 * 109 * 192 else 8 * 2 ^ 30 * 96 * 218
  else
    if s0 then 6388384375 * 109 * 217 else 6388384375 * 109 * 218


theorem branchCardG48_mul_norm_sq_eq (isHead s0 : Bool) :
    ((branchCardG48 isHead s0 : ℕ) : ℝ) / (2 : ℝ) ^ 48 * ‖branchMuxMat isHead s0 0 0‖ ^ 2 =
      branchSSq isHead s0 := by
  dsimp only [branchMuxMat, branchSSq, branchCardG48]
  cases isHead <;> cases s0
  · simp only [Bool.false_eq_true, ↓reduceIte, norm_matMuxS2Tail_00_sq]
    unfold sSqS2Tail11; norm_num
  · simp only [Bool.false_eq_true, ↓reduceIte, norm_matMuxS4Tail_00_sq]
    unfold sSqS4Tail11; norm_num
  · simp only [↓reduceIte, Bool.false_eq_true, norm_matMuxHead_00_sq]
    unfold sSqHead11; norm_num
  · simp only [↓reduceIte, norm_matMuxHead_00_sq]
    unfold sSqHead11; norm_num


section SecBhmt48Fast
abbrev rAnc7_152 : QRegister 7 152 := mkBlock152 21 7 (by decide)


abbrev Data48Tuple : Type := Fin (2 ^ 3) × Fin (2 ^ 30) × Fin (2 ^ 7) × Fin (2 ^ 8)


noncomputable def writeData48 (α : BitAssignment 152) (d : Data48Tuple) : BitAssignment 152 :=
  let (b1, fine, ancHi, nuc) := d
  ZeroAncillaUSPS3.writeReg
    (ZeroAncillaUSPS3.writeReg
      (ZeroAncillaUSPS3.writeReg
        (ZeroAncillaUSPS3.writeReg α rB1_152 (basisBits 3 b1))
        rFine30_152 (basisBits 30 fine))
      rAnc7_152 (basisBits 7 ancHi))
    rNuc_152 (basisBits 8 nuc)


noncomputable def writeData49 (α : BitAssignment 152) (d : Data48Tuple) (bRej : Bool) :
    BitAssignment 152 :=
  Function.update (writeData48 α d) wSubReject_152 (if bRej then 1 else 0)


def branchGood48 (isHead s0 : Bool) (d : Data48Tuple) : Bool :=
  let (b1, fine, ancHi, nuc) := d
  let gJoint := if isHead then true else decide (fine.val < tailKeepSpanOfDp b1)
  let gAnc :=
    if isHead && !s0 then
      !(basisBits 7 ancHi 0 == 1 && basisBits 7 ancHi 1 == 1)
    else
      decide (ancHi.val < 109)
  let gNuc :=
    if isHead && s0 then
      !(basisBits 8 nuc 0 == 1 && basisBits 8 nuc 1 == 1)
    else if !isHead && s0 then
      decide (nuc.val < 217)
    else
      decide (nuc.val < 218)
  gJoint && gAnc && gNuc


noncomputable def bhmt48RawAmp (isHead s0 : Bool) (d : Data48Tuple) (bRej : Bool) : ℂ :=
  let sSq := branchSSq isHead s0
  let M := branchMuxMat isHead s0
  if !bRej then
    if branchGood48 isHead s0 d then
      ((3 - 4 * sSq : ℝ) : ℂ) * ((sqrtHalf : ℂ) ^ 48) * M 0 0
    else
      ((1 - 4 * sSq : ℝ) : ℂ) * ((sqrtHalf : ℂ) ^ 48) * M 0 0
  else
    ((1 - 4 * sSq : ℝ) : ℂ) * ((sqrtHalf : ℂ) ^ 48) * M 1 0


private theorem sequence_append_mulVec {N : ℕ} (cs₁ cs₂ : List (Circuit N)) (v : Fin (2 ^ N) → ℂ) :
    (Circuit.sequence (cs₁ ++ cs₂)).eval.1.mulVec v =
      (Circuit.sequence cs₂).eval.1.mulVec ((Circuit.sequence cs₁).eval.1.mulVec v) := by
  induction cs₁ generalizing v with
  | nil =>
      simp [Circuit.sequence]
  | cons c cs ih =>
      rw [List.cons_append, Circuit.sequence, Circuit.sequence,
        eval_seq_mulVec, eval_seq_mulVec, ih]


theorem hadamard_wire_mulVec_ket_zero {N : ℕ} (q : Wire N) (β : BitAssignment N)
    (hq : β q = 0) :
    (Circuit.H q).eval.1.mulVec (ket β) =
      (sqrtHalf : ℂ) • (ket (Function.update β q 0) + ket (Function.update β q 1)) := by
  rw [ket_H, hq]
  have hb0 : bitSign (0 : ZMod 2) = 1 := rfl
  have hup0 : Function.update β q 0 = β := by rw [← hq]; exact Function.update_eq_self q β
  rw [hb0, one_smul, hup0]


private theorem hadamardList_ofFn_mulVec_ket_zero {m N : ℕ} (r : QRegister m N)
    (β : BitAssignment N) (h0 : ∀ i : Fin m, β (r i) = 0) :
    (Circuit.sequence ((List.ofFn r.wires).map Circuit.H)).eval.1.mulVec (ket β) =
      ((sqrtHalf : ℂ) ^ m) •
        ∑ x : Fin (2 ^ m), ket (ZeroAncillaUSPS3.writeReg β r (basisBits m x)) := by
  induction m generalizing β with
  | zero =>
      have hnil : (List.ofFn r.wires).map Circuit.H = [] := by simp
      rw [hnil]
      have hself : ∀ x : Fin (2 ^ 0), ZeroAncillaUSPS3.writeReg β r (basisBits 0 x) = β :=
        fun _ ↦ funext fun w ↦
          ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (by rintro ⟨i, _⟩; exact Fin.elim0 i)
      simp [Circuit.sequence, hself]
  | succ m ih =>
      let rTail : QRegister m N := r.compose (QRegister.block 1 m (by omega))
      have hTail_eq : ∀ j : Fin m, rTail j = r j.succ := fun j ↦ by
        dsimp [rTail, QRegister.compose, QRegister.compose_apply,
          PosPostPrep80CertS3Alt.qreg_compose_wires,
          PosPostPrep80CertS3Alt.qreg_whole_wires,
          PosPostPrep80CertS3Alt.emb_trans_apply,
          PosPostPrep80CertS3Alt.emb_refl_apply,
          PosPostPrep80CertS3Alt.emb_mk_apply,
          PosPostPrep80CertS3Alt.qreg_block_apply,
          PosPostPrep80CertS3Alt.qreg_block_wires_apply]
        congr 1; ext; dsimp; omega
      have hList : (List.ofFn r.wires).map Circuit.H =
          Circuit.H (r 0) :: (List.ofFn rTail.wires).map Circuit.H := by
        rw [List.ofFn_succ, List.map_cons]
        congr 1
        exact congrArg (List.map Circuit.H)
          (congrArg List.ofFn (funext fun j ↦ (hTail_eq j).symm))
      have h0_tail : ∀ b₀ : ZMod 2, ∀ j : Fin m,
          Function.update β (r 0) b₀ (rTail j) = 0 := fun b₀ j ↦ by
        rw [hTail_eq j, Function.update_of_ne (r.wires.injective.ne (Fin.succ_ne_zero j)),
          h0 j.succ]
      rw [hList, Circuit.sequence, eval_seq_mulVec,
        hadamard_wire_mulVec_ket_zero (r 0) β (h0 0),
        Matrix.mulVec_smul, Matrix.mulVec_add,
        ih rTail (Function.update β (r 0) 0) (h0_tail 0),
        ih rTail (Function.update β (r 0) 1) (h0_tail 1),
        ← smul_add, smul_smul, ← pow_succ' (sqrtHalf : ℂ) m]
      apply congrArg (((sqrtHalf : ℂ) ^ (m + 1)) • ·)
      change (∑ x : Fin (2 ^ m),
        ket (ZeroAncillaUSPS3.writeReg (Function.update β (r 0) 0) rTail ((basisBitsEquiv m) x))) +
          (∑ x : Fin (2 ^ m),
            ket (ZeroAncillaUSPS3.writeReg (Function.update β (r 0) 1) rTail ((basisBitsEquiv m)
            x))) =
        ∑ x : Fin (2 ^ (m + 1)), ket (ZeroAncillaUSPS3.writeReg β r ((basisBitsEquiv (m + 1)) x))
      rw [(basisBitsEquiv m).sum_comp
            (fun b ↦ ket (ZeroAncillaUSPS3.writeReg (Function.update β (r 0) 0) rTail b)),
          (basisBitsEquiv m).sum_comp
            (fun b ↦ ket (ZeroAncillaUSPS3.writeReg (Function.update β (r 0) 1) rTail b)),
          (basisBitsEquiv (m + 1)).sum_comp
            (fun b ↦ ket (ZeroAncillaUSPS3.writeReg β r b))]
      let eCons : ZMod 2 × BitAssignment m ≃ BitAssignment (m + 1) :=
        { toFun := fun p ↦ Fin.cons p.1 p.2
          invFun := fun q ↦ (q 0, fun j ↦ q j.succ)
          left_inv := fun p ↦ Prod.ext (by simp) (funext fun j ↦ by simp)
          right_inv := fun q ↦ funext fun i ↦ Fin.cases rfl (fun _ ↦ rfl) i }
      symm
      rw [← eCons.sum_comp (fun b ↦ ket (ZeroAncillaUSPS3.writeReg β r b))]
      dsimp only [eCons, Equiv.coe_fn_mk]
      simp only [Fintype.sum_prod_type, unH_tailReg_mem_range r β]
      have hu2 : (Finset.univ : Finset (ZMod 2)) = {0, 1} := by decide
      rw [hu2, Finset.sum_pair (by decide : (0 : ZMod 2) ≠ 1)]


theorem listData48_eq_append4 :
    listData48_152 =
      List.ofFn rB1_152.wires ++ List.ofFn rFine30_152.wires ++
        List.ofFn rAnc7_152.wires ++ List.ofFn rNuc_152.wires := by
