  obtain ⟨hSC0, hSC1, hSC2⟩ := stageC_fin_checks
  let x10 : Fin 1024 := ⟨mClean &&& 1023, Nat.lt_succ_of_le Nat.and_le_right⟩
  rcases hmPre_check hm with ⟨hmPre76, hmPre67, hsb0_76, hsb1_76, hsb2_76, hsb0_67, hsb1_67,
    hsb2_67⟩
