      (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih)
      false false false false false false false false false false false)) .r20 = false ∧
    getB22 (evalProg22 jaProg22 (St22.mk a1 a2 a3 a4 a5 a6 a7 c29
      (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih)
      false false false false false false false false false false false)) .r21 =
      (ep && !(c29 && etBool ep ih) && !badAncBool a1 a2 a3 a4 a5 a6 a7 (c0hBool ep ih c0)) := by
  have hrun :
      (getB22 (evalProg22 jaProg22 (St22.mk a1 a2 a3 a4 a5 a6 a7 c29
          (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih)
          false false false false false false false false false false false)) .r19,
        getB22 (evalProg22 jaProg22 (St22.mk a1 a2 a3 a4 a5 a6 a7 c29
          (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih)
          false false false false false false false false false false false)) .r20,
        getB22 (evalProg22 jaProg22 (St22.mk a1 a2 a3 a4 a5 a6 a7 c29
          (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih)
          false false false false false false false false false false false)) .r21) =
        jaS1 a1 a2 a5 c29 (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih)
          (a3 && a4) (a6 && a7)
          false false false false false false false false false := by
    rw [jaProg22_eq_rest0, jaRest0, evalProg22_append, eval_jaC0]
    simp only [Bool.false_bne]
    exact eval_jaRest1 a1 a2 a3 a4 a5 a6 a7 c29
      (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih) (a3 && a4) (a6 && a7)
      false false false false false false false false false
  have hspec := jaS1_spec ep ih c0 c29 a1 a2 (a3 && a4) a5 (a6 && a7)
  have hbad : badAncBool a1 a2 (a3 && a4) true a5 (a6 && a7) true (c0hBool ep ih c0) =
      badAncBool a1 a2 a3 a4 a5 a6 a7 (c0hBool ep ih c0) := by
    dsimp only [badAncBool]; simp only [Bool.and_true]
  rw [hbad] at hspec
  have htot := hrun.trans hspec
  exact ⟨congrArg Prod.fst htot, congrArg (fun p ↦ p.2.1) htot, congrArg (fun p ↦ p.2.2) htot⟩


theorem nucProg22_spec (n0 n1 n2 n3 n4 n5 n6 n7 s4h s0t : Bool)
    (hnot : !(s4h && s0t) = true) :
    getB22 (evalProg22 nucProg22 (St22.mk n0 n1 n2 n3 n4 n5 n6 n7 s4h s0t
      false false false false false false false false false false false false)) .r20 =
