theorem badNucPoly_eq (α : BitAssignment 152) :
    badNucPoly (α (rNuc_152 0)) (α (rNuc_152 1)) (α (rNuc_152 2)) (α (rNuc_152 3))
        (α (rNuc_152 4)) (α (rNuc_152 5)) (α (rNuc_152 6)) (α (rNuc_152 7))
        (α wEnS4Head_152) (α wEnS0Tail_152) =
      if α wEnS4Head_152 = 1 then
        if α (rNuc_152 0) = 1 ∧ α (rNuc_152 1) = 1 then 1 else 0
      else if α wEnS0Tail_152 = 1 then
        if nuc8Val152 α < 217 then 0 else 1
      else
        if nuc8Val152 α < 218 then 0 else 1 := by
  rw [badNucPoly_bits, ← nuc8Val152_expand α]


def goodJointPred152 (α : BitAssignment 152) : Bool :=
