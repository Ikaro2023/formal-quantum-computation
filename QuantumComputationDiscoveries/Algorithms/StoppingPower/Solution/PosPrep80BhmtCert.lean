theorem pre_masks_gm18_eq_orig (x : Fin 1024) :
    let yNew := runMask76 preFlat76_gm18 x.val
    let yOld := runMask76 preFlat76 x.val
    (yNew &&& maskC0_76 = yOld &&& maskC0_76) ∧
    (yNew &&& maskC1_76 = yOld &&& maskC1_76) ∧
    (yNew &&& maskC2_76 = yOld &&& maskC2_76) := by
  rcases preFlat76_gm18_submasks_cert with ⟨hS1BNew, hS1BOld, hSB⟩
  rcases maskS1B_disj_compl_sb_maskC_gm18 with ⟨hD0, hD1, hD2⟩
  have h1a : checkS1A1024One_gm18 x.val = true :=
    checkNatRange_true 1024 0 x.val checkS1A1024_gm18_cert (Nat.zero_le _) (by
      have := x.isLt; omega)
  simp only [checkS1A1024One_gm18, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h1a
  let m1a := runMask76 s1aFlat76_gm18 x.val
  let k := ((Nat.shiftRight m1a 1) &&& 7) ||| (((Nat.shiftRight m1a 39) &&& 7) * 8)
  have h64 : checkS1B64One_gm18 k = true :=
    checkNatRange_true 64 0 k checkS1B64_gm18_cert (Nat.zero_le _) h1a.2
  simp only [checkS1B64One_gm18, beq_iff_eq] at h64
  let m2New := runMask76 s1bFlat76_gm18 m1a
  let m2Old := runMask76 s1bFlat76_orig_gm18 m1a
  have hm2New : m2New = (m1a ^^^ (m1a &&&
    maskS1B_gm18)) ^^^ runMask76 s1bFlat76_gm18 (packS1B64_gm18 k) := by
    dsimp [m2New]; rw [runMask76_decomp_inMask hS1BNew m1a, h1a.1]
  have hm2Old : m2Old = (m1a ^^^ (m1a &&&
    maskS1B_gm18)) ^^^ runMask76 s1bFlat76_orig_gm18 (packS1B64_gm18 k) := by
    dsimp [m2Old]; rw [runMask76_decomp_inMask hS1BOld m1a, h1a.1]
  have hm2SB : m2New &&& maskSB_gm18 = m2Old &&& maskSB_gm18 := by
    rw [hm2New, hm2Old, nat_and_xor_distrib_right76 (m1a ^^^ (m1a &&& maskS1B_gm18)),
      nat_and_xor_distrib_right76 (m1a ^^^ (m1a &&& maskS1B_gm18)), h64]
  have hyNew : runMask76 preFlat76_gm18 x.val =
      (m2New ^^^ (m2New &&& maskSB_gm18)) ^^^ runMask76 sbFlat76_gm18 (m2Old &&& maskSB_gm18) := by
    change runMask76 (s1aFlat76_gm18 ++ s1bFlat76_gm18 ++ sbFlat76_gm18) x.val = _
    rw [runMask76_append, runMask76_append,
      show runMask76 s1bFlat76_gm18 (runMask76 s1aFlat76_gm18 x.val) = m2New from rfl,
      runMask76_decomp_inMask hSB m2New, hm2SB]
  have hyOld : runMask76 preFlat76 x.val =
      (m2Old ^^^ (m2Old &&& maskSB_gm18)) ^^^ runMask76 sbFlat76_gm18 (m2Old &&& maskSB_gm18) := by
    rw [preFlat76_orig_split_gm18, runMask76_append, runMask76_append,
      show runMask76 s1bFlat76_orig_gm18 (runMask76 s1aFlat76_gm18 x.val) = m2Old from rfl,
      runMask76_decomp_inMask hSB m2Old]
  have hEqMask : ∀ M : ℕ, (maskS1B_gm18 ^^^ (maskS1B_gm18 &&& maskSB_gm18)) &&& M = 0 →
      runMask76 preFlat76_gm18 x.val &&& M = runMask76 preFlat76 x.val &&& M := by
    intro M hDisjM
    rw [hyNew, hyOld,
      nat_and_xor_distrib_right76 (m2New ^^^ (m2New &&& maskSB_gm18)),
      nat_and_xor_distrib_right76 (m2Old ^^^ (m2Old &&& maskSB_gm18))]
    refine congrArg (fun z ↦ z ^^^ (runMask76 sbFlat76_gm18 (m2Old &&& maskSB_gm18) &&& M)) ?_
    apply Nat.eq_of_testBit_eq; intro i
    rw [Nat.testBit_and, Nat.testBit_and]
    by_cases hMi : M.testBit i = true
    · rw [hMi, Bool.and_true, Bool.and_true]
      by_cases hsb : maskSB_gm18.testBit i = true
      · simp only [Nat.testBit_xor, Nat.testBit_and, hsb, Bool.and_true]
        cases m2New.testBit i <;> cases m2Old.testBit i <;> rfl
      · have hsbf : maskSB_gm18.testBit i = false := Bool.eq_false_iff.mpr hsb
        have hz : ((maskS1B_gm18 ^^^ (maskS1B_gm18 &&& maskSB_gm18)) &&& M).testBit i = false := by
          rw [hDisjM, Nat.zero_testBit]
        rw [Nat.testBit_and, hMi, Bool.and_true, Nat.testBit_xor, Nat.testBit_and, hsbf] at hz
        have hz1 : maskS1B_gm18.testBit i = false := by
          cases htb : maskS1B_gm18.testBit i
          · rfl
          · rw [htb] at hz; cases hz
        obtain ⟨_, hOutNew⟩ := runMask76_inMask_aux hS1BNew m1a
        obtain ⟨_, hOutOld⟩ := runMask76_inMask_aux hS1BOld m1a
        rw [Nat.testBit_xor, Nat.testBit_and, Nat.testBit_xor, Nat.testBit_and, hsbf,
          hOutNew i hz1, hOutOld i hz1]
    · have hf : M.testBit i = false := Bool.eq_false_iff.mpr hMi
      rw [hf, Bool.and_false, Bool.and_false]
  exact ⟨hEqMask maskC0_76 hD0, hEqMask maskC1_76 hD1, hEqMask maskC2_76 hD2⟩


theorem pre_masks_gm18_check (x : Fin 1024) :
    let y76 := runMask76 preFlat76_gm18 x.val
    (y76 &&& maskC0_76 = cAxis10 x.val 0 * 2 ^ 42) ∧
    (y76 &&& maskC1_76 = cAxis10 x.val 1 * 2 ^ 45) ∧
