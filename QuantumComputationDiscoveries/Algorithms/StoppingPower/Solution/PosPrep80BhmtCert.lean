def ancSplitEquiv : ZMod 2 × Fin (2 ^ 7) ≃ Fin (2 ^ 8) where
  toFun p := ⟨p.1.val + 2 * p.2.val, by have := ZMod.val_lt p.1; omega⟩
  invFun x := (if x.val % 2 == 1 then 1 else 0, ⟨x.val / 2, by omega⟩)
  left_inv := by
    rintro ⟨b, hi⟩
    obtain ⟨⟨a, c⟩, rfl⟩ := fin128Split16.symm.surjective hi
    fin_cases b <;> fin_cases a <;> revert c <;> decide
  right_inv := by
    intro x
    obtain ⟨⟨a, c⟩, rfl⟩ := fin256Split16.symm.surjective x
    fin_cases a <;> revert c <;> decide


def fin128SplitEquiv : Fin (2 ^ 7) ≃ Fin (2 ^ 2) × Fin (2 ^ 5) where
  toFun x := (⟨x.val % 4, by omega⟩, ⟨x.val / 4, by omega⟩)
  invFun p := ⟨p.1.val + 4 * p.2.val, by omega⟩
  left_inv x := Fin.ext (by dsimp; omega)
  right_inv p := Prod.ext (Fin.ext (by dsimp; omega)) (Fin.ext (by dsimp; omega))


private theorem basisBits_ancSplitEquiv (b0 : ZMod 2) (hi : Fin (2 ^ 7)) :
    basisBits 8 (ancSplitEquiv (b0, hi)) ⟨0, by decide⟩ = b0 ∧
    ∀ j : Fin 7, basisBits 8 (ancSplitEquiv (b0, hi)) ⟨j.val + 1, by omega⟩ = basisBits 7 hi j := by
  obtain ⟨⟨a, c⟩, rfl⟩ := fin128Split16.symm.surjective hi
  fin_cases a <;> revert b0 c <;> decide


private theorem ancHi_lt109_iff (b0 : ZMod 2) (hi : Fin (2 ^ 7)) :
    decide (hi.val < 109) = decide ((ancSplitEquiv (b0, hi)).val < 218) := by
