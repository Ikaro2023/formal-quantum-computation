def eFin32Split : Fin (2 ^ 4) × ZMod 2 ≃ Fin (2 ^ 5) where
  toFun p := ⟨p.1.val + 16 * p.2.val, by have := ZMod.val_lt p.2; omega⟩
  invFun x := (⟨x.val % 16, by omega⟩, if x.val / 16 == 1 then 1 else 0)
  left_inv := by rintro ⟨a4, b⟩; fin_cases b <;> revert a4 <;> decide
  right_inv := by
    intro x; obtain ⟨⟨a, c⟩, rfl⟩ := fin32Split16.symm.surjective x
    fin_cases a <;> revert c <;> decide


def eAnc7 : ZMod 2 × Fin (2 ^ 2) × Fin (2 ^ 4) ≃ Fin (2 ^ 7) where
  toFun p := ⟨p.1.val + 2 * p.2.1.val + 8 * p.2.2.val, by have := ZMod.val_lt p.1; omega⟩
