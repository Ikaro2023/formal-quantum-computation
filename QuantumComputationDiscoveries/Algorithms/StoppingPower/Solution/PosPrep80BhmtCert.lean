private theorem wp_measureAndBranchSeq_exact_wfork
    {Var : Type} [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)] (v : Var)
    (Θ : CQAssertionCompat Var (2 ^ n)) (hΘ : ∀ σ val, Θ (Function.update σ v val) = Θ σ) :
    ∀ (m : ℕ) (qs : Fin m → Wire n)
      (fixup : (Fin m → Bool) → DynamicCircuit Var n),
      (∀ g (Ψ : CQAssertionCompat Var (2 ^ n)),
        (∀ σ val, Ψ (Function.update σ v val) = Ψ σ) →
        ∀ σ val, wp (fixup g).compile Ψ (Function.update σ v val) = wp (fixup g).compile Ψ σ) →
      ∀ (σ : Store Var),
        (wp (measureAndBranchSeq v m (fun r ↦ QRegister.singleton (qs r)) fixup).compile Θ σ).1 =
          ∑ g : Fin m → Bool,
            ((wp (fixup g).compile Θ σ).1).conj (projOutcomeAll m qs g)ᴴ
  | 0, _, fixup, _, σ => by
      have huniv : (@Finset.univ (Fin 0 → Bool) _) = {Fin.elim0} :=
        Finset.eq_singleton_iff_unique_mem.mpr
          ⟨Finset.mem_univ _, fun g _ ↦ Subsingleton.elim g Fin.elim0⟩
      rw [huniv, Finset.sum_singleton]
      conv_lhs => unfold measureAndBranchSeq
      simp [projOutcomeAll]
  | m + 1, qs, fixup, hfix, σ => by
      have hsubst0 : σ.subst v 0 = Function.update σ v 0 := by
        funext y; simp [Store.subst, Function.update]
      have hsubst1 : σ.subst v 1 = Function.update σ v 1 := by
        funext y; simp [Store.subst, Function.update]
      let P₀ := (QRegister.singleton (qs 0)).basisOutcomeProjector 0
      let P₁ := (QRegister.singleton (qs 0)).basisOutcomeProjector 1
      have hmeas :
          (wp (measureAndBranchSeq v (m + 1) (fun r ↦ QRegister.singleton (qs r)) fixup).compile
              Θ σ).1 =
            (wp (measureAndBranchSeq v m (fun i ↦ QRegister.singleton (qs i.succ))
              (fun rest ↦
                fixup (Fin.cons false rest))).compile Θ (Function.update σ v 0)).1.conj P₀ᴴ +
            (wp (measureAndBranchSeq v m (fun i ↦ QRegister.singleton (qs i.succ))
              (fun rest ↦
                fixup (Fin.cons true rest))).compile Θ (Function.update σ v 1)).1.conj P₁ᴴ := by
        simp only [measureAndBranchSeq, DynamicCircuit.compile_seq, DynamicCircuit.compile_measure,
          DynamicCircuit.compile_qIf, wp_qSeq, wp_qIf, QProg.measureRegister, wp_qMeasure_apply,
          qMeasure_obs_map_coe, CQAssertionCompat.subst_apply]
        change ∑ o : Fin 2, _ = _
        rw [Fin.sum_univ_two]
        simp [qMeasure_outcome_herm_eq_conj, hsubst0, hsubst1,
          QRegister.computationalBasisMeasurement_apply, P₀, P₁]
      have hupdF := wp_measureAndBranchSeq_update_self v m
        (fun i ↦ QRegister.singleton (qs i.succ))
        (fun rest ↦ fixup (Fin.cons false rest))
        (fun rest ↦ hfix (Fin.cons false rest)) Θ hΘ σ 0
      have hupdT := wp_measureAndBranchSeq_update_self v m
        (fun i ↦ QRegister.singleton (qs i.succ))
        (fun rest ↦ fixup (Fin.cons true rest))
        (fun rest ↦ hfix (Fin.cons true rest)) Θ hΘ σ 1
      have ihF := wp_measureAndBranchSeq_exact_wfork v Θ hΘ m (fun i ↦ qs i.succ)
        (fun rest ↦ fixup (Fin.cons false rest))
        (fun rest ↦ hfix (Fin.cons false rest)) σ
      have ihT := wp_measureAndBranchSeq_exact_wfork v Θ hΘ m (fun i ↦ qs i.succ)
        (fun rest ↦ fixup (Fin.cons true rest))
        (fun rest ↦ hfix (Fin.cons true rest)) σ
      rw [hmeas, hupdF, hupdT, ihF, ihT, map_sum, map_sum]
      have hsplit :
          (∑ g : Fin (m + 1) → Bool,
              ((wp (fixup g).compile Θ σ).1).conj (projOutcomeAll (m + 1) qs g)ᴴ) =
            (∑ rest : Fin m → Bool,
                ((wp (fixup (Fin.cons false rest)).compile Θ σ).1).conj
                  (projOutcomeAll (m + 1) qs (Fin.cons false rest))ᴴ) +
              (∑ rest : Fin m → Bool,
                ((wp (fixup (Fin.cons true rest)).compile Θ σ).1).conj
                  (projOutcomeAll (m + 1) qs (Fin.cons true rest))ᴴ) := by
        rw [← (Fin.consEquiv (fun _ : Fin (m + 1) ↦ Bool)).sum_comp, Fintype.sum_prod_type,
          Fintype.sum_bool, add_comm]
        rfl
      rw [hsplit]
      congr 1
      · apply Finset.sum_congr rfl
        intro rest _
        simp only [projOutcomeAll, Fin.cons_zero, Fin.cons_succ, Bool.false_eq_true, ↓reduceIte,
          conjTranspose_mul, conj_conj]
        try rfl
      · apply Finset.sum_congr rfl
        intro rest _
        simp only [projOutcomeAll, Fin.cons_zero, Fin.cons_succ, ↓reduceIte,
          conjTranspose_mul, conj_conj]
        try rfl


