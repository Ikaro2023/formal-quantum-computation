def p80ClearRange (off len : ℕ) (p : BitAssignment 80) : BitAssignment 80 :=
  fun q ↦ if off ≤ q.val ∧ q.val < off + len then 0 else p q


def projBhmt (s0 : Bool) (p : BitAssignment 80) : BitAssignment 80 :=
  let nuc := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j))
  if s0 then
    if p 30 == 1 then p80ClearRange 6 2 p
    else clrPid12_80 p
  else
    if p 30 == 1 then
      if (nuc &&& 216) == 216 then p80ClearRange 14 7 p
      else p80ClearB0Local (p80ClearRange 14 7 p)
    else
      if (nuc &&& 216) == 216 then clrPid12_80 p
      else p80ClearB0Local (clrPid12_80 p)


noncomputable def fiberWeightBhmt (s0 : Bool) (p : BitAssignment 80) : ℝ :=
  let nuc := Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j))
  if s0 then (1 / 4 : ℝ)
  else if p 30 == 1 then
    if (nuc &&& 216) == 216 then (1 / 128 : ℝ) else (1 / 1024 : ℝ)
  else
    if (nuc &&& 216) == 216 then (1 / 4 : ℝ) else (1 / 32 : ℝ)


noncomputable def muBhmt (s0 : Bool) (p : BitAssignment 80) : ℝ :=
  fiberWeightBhmt s0 p * muActualFactor80 true s0 (projBhmt s0 p)


