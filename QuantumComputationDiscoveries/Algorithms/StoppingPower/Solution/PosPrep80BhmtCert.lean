    rw [sq]
    exact MeasureBranchHadamardSem.sqrtHalf_mul_sqrtHalf
  rcases MeasureBranchHadamardSem.bit_cases b with rfl | rfl
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [pauliXPow, pauliZPow, ↓reduceIte, Matrix.mul_one,
        wordMatrix2, evalList, matId, zwAdd, zwSub, Mat2Zw.toMatrix,
        Matrix.mul_apply, Fin.sum_univ_two, Matrix.smul_apply, smul_eq_mul,
        Zw.toComplex, Matrix.one_apply] <;>
      dsimp <;> ring_nf <;> rw [hsh2] <;> norm_num
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [pauliXPow, pauliZPow, show (1 : ZMod 2) ≠ 0 by decide, ↓reduceIte,
        wordMatrix2, evalList, matId, zwAdd, zwSub, Mat2Zw.toMatrix,
        Matrix.mul_apply, Fin.sum_univ_two, Matrix.smul_apply, smul_eq_mul,
        Zw.toComplex] <;>
      dsimp <;> ring_nf <;> rw [hsh2] <;> norm_num


noncomputable def telePhase (s : TeleSpec) : ℂ :=
  oddsPhase s.fwdOdds * star (oddsPhase s.bwdOdds)


theorem telePhase_mul_star (s : TeleSpec) : telePhase s * star (telePhase s) = 1 := by
  dsimp [telePhase]
  simp only [map_mul, Complex.conj_conj]
  calc (oddsPhase s.fwdOdds * (starRingEnd ℂ) (oddsPhase s.bwdOdds)) *
        ((starRingEnd ℂ) (oddsPhase s.fwdOdds) * oddsPhase s.bwdOdds)
      = (oddsPhase s.fwdOdds * star (oddsPhase s.fwdOdds)) *
          (oddsPhase s.bwdOdds * star (oddsPhase s.bwdOdds)) := by
          simp only [Complex.star_def]; ring
    _ = 1 * 1 := by rw [oddsPhase_mul_star, oddsPhase_mul_star]
    _ = 1 := mul_one 1


theorem telePhase_norm_sq (s : TeleSpec) : ‖telePhase s‖ ^ 2 = 1 := by
  have h := congrArg Complex.re (telePhase_mul_star s)
  rw [Complex.star_def, Complex.mul_conj, Complex.ofReal_re, Complex.one_re,
    Complex.normSq_eq_norm_sq] at h
  exact h


noncomputable def teleCoreMat (mx mz fl : ZMod 2) (Uf Ub : Matrix (Fin 2) (Fin 2) ℂ) :
    Matrix (Fin 2) (Fin 2) ℂ :=
  pauliXPow fl * Uf * pauliZPow mz * pauliXPow mx * Ubᴴ


theorem teleCoreMat_unitary (mx mz fl : ZMod 2) (Uf Ub : Matrix (Fin 2) (Fin 2) ℂ)
    (hUf : Uf * Ufᴴ = 1) (hUb : Ub * Ubᴴ = 1) :
    teleCoreMat mx mz fl Uf Ub * (teleCoreMat mx mz fl Uf Ub)ᴴ = 1 := by
  have hUb' : Ubᴴ * Ub = 1 := mul_eq_one_comm.mp hUb
  dsimp [teleCoreMat]
  simp only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose]
  calc pauliXPow fl * Uf * pauliZPow mz * pauliXPow mx * Ubᴴ *
        (Ub * ((pauliXPow mx)ᴴ * ((pauliZPow mz)ᴴ * (Ufᴴ * (pauliXPow fl)ᴴ))))
      = pauliXPow fl * (Uf * (pauliZPow mz * (pauliXPow mx * (Ubᴴ * Ub) * (pauliXPow mx)ᴴ) *
          (pauliZPow mz)ᴴ) * Ufᴴ) * (pauliXPow fl)ᴴ := by
          simp only [Matrix.mul_assoc]
    _ = pauliXPow fl * (Uf * (pauliZPow mz * (pauliZPow mz)ᴴ) * Ufᴴ) * (pauliXPow fl)ᴴ := by
          rw [hUb', Matrix.mul_one, pauliXPow_unitary, Matrix.mul_one]
    _ = pauliXPow fl * (Uf * Ufᴴ) * (pauliXPow fl)ᴴ := by
          rw [pauliZPow_unitary, Matrix.mul_one]
    _ = 1 := by rw [hUf, Matrix.mul_one, pauliXPow_unitary]


noncomputable def teleMat2 (s : TeleSpec) : Matrix (Fin 2) (Fin 2) ℂ :=
  telePhase s • teleCoreMat
    (if s.mx then 1 else 0) (if s.mz then 1 else 0) (if s.fl then 1 else 0)
    (wordMatrix2 (oddsToHst s.fwdOdds)) (wordMatrix2 (oddsToHst s.bwdOdds))


theorem teleMat2_unitary (s : TeleSpec) : teleMat2 s * (teleMat2 s)ᴴ = 1 := by
  dsimp [teleMat2]
  rw [Matrix.conjTranspose_smul, Matrix.smul_mul, Matrix.mul_smul, smul_smul,
    telePhase_mul_star, one_smul]
  exact teleCoreMat_unitary _ _ _ _ _ (wordMatrix2_unitary _) (wordMatrix2_unitary _)


noncomputable def teleAlpha0 (s : TeleSpec) : ℂ := teleMat2 s 0 0

noncomputable def teleAlpha1 (s : TeleSpec) : ℂ := teleMat2 s 1 0


theorem norm_sq_teleAlpha0_add_teleAlpha1 (s : TeleSpec) :
    ‖teleAlpha0 s‖ ^ 2 + ‖teleAlpha1 s‖ ^ 2 = 1 := by
  have hM : (teleMat2 s)ᴴ * teleMat2 s = 1 := mul_eq_one_comm.mp (teleMat2_unitary s)
  have h00 := congrArg (fun A => A 0 0) hM
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
    Matrix.one_apply_eq] at h00
  have hnorm (z : ℂ) : star z * z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
    rw [mul_comm, Complex.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  rw [hnorm (teleMat2 s 0 0), hnorm (teleMat2 s 1 0), ← Complex.ofReal_add] at h00
  exact Complex.ofReal_injective (by simpa [teleAlpha0, teleAlpha1] using h00)


