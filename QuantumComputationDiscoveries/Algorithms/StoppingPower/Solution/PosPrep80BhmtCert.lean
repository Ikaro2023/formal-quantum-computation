        (α (rAnc_152 1) == 1) (α (rAnc_152 2) == 1) (α (rAnc_152 3) == 1)
        (α (rAnc_152 4) == 1) (α (rAnc_152 5) == 1) (α (rAnc_152 6) == 1)
        (α (rAnc_152 7) == 1) c29
        (c0hBool (α wEnPos_152 == 1) (α wIsHead_152 == 1) (α wCoin0_152 == 1))
        (s4hBool (α wEnPos_152 == 1) (α wIsHead_152 == 1) (α wCoin0_152 == 1))
        (etBool (α wEnPos_152 == 1) (α wIsHead_152 == 1))
        false false false false false false false false false false false) i) := by
  cases i with
  | r0 => exact (hδ0_out (rAnc_152 1) (by decide) (by decide)).trans (zmod2_eq_b2z _)
  | r1 => exact (hδ0_out (rAnc_152 2) (by decide) (by decide)).trans (zmod2_eq_b2z _)
