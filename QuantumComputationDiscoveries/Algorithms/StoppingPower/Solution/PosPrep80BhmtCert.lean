theorem norm_sq_muxHeadBhmtAmp (U pidVal : ℕ) (bRej : Bool) :
    ‖muxHeadBhmtAmp U pidVal bRej‖ ^ 2 = muxHeadBhmtProb U pidVal bRej := by
  have hrealSq : ∀ r : ℝ, ‖((r : ℝ) : ℂ)‖ ^ 2 = r ^ 2 := fun r ↦ by
    rw [Complex.norm_real, Real.norm_eq_abs, sq_abs]
  have hpow11 : ‖(sqrtHalf : ℂ) ^ 11‖ ^ 2 = (1 : ℝ) / 2048 := by
    rw [norm_pow, ← pow_right_comm, norm_sq_sqrtHalf_local]
    norm_num
  have hsSq : ((1308 : ℕ) : ℝ) / (2 : ℝ) ^ 11 * ‖matMuxHead 0 0‖ ^ 2 = sSqHead11 := by
    rw [norm_matMuxHead_00_sq]
    unfold sSqHead11
    norm_num
  unfold muxHeadBhmtAmp muxHeadBhmtProb
  dsimp only
  cases bRej
  · simp only [Bool.not_false, ↓reduceIte]
    by_cases hg : (U < 218 && pidVal < 6) = true
    · simp only [hg, ↓reduceIte]
