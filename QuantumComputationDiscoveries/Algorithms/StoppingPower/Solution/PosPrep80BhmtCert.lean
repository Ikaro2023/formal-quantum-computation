private theorem bhmt48RawAmp_tail_eq (s0 : Bool) (bAnc0 : ZMod 2)
    (dp : Fin (2 ^ 3)) (fine : Fin (2 ^ 30)) (ancHi : Fin (2 ^ 7)) (v8 : Fin (2 ^ 8))
    (bRej : Bool) :
    (sqrtHalf : ℂ) * bhmt48RawAmp false s0 (dp, fine, ancHi, v8) bRej =
      muxTailBhmtAmp s0 (ancSplitEquiv (bAnc0, ancHi)).val v8.val dp fine.val bRej := by
  have hp49 : (sqrtHalf : ℂ) * (sqrtHalf : ℂ) ^ 48 = (sqrtHalf : ℂ) ^ 49 := (pow_succ' _ 48).symm
  have hanc := ancHi_lt109_iff bAnc0 ancHi
  dsimp only [bhmt48RawAmp, branchGood48, branchSSq, branchMuxMat, muxTailBhmtAmp]
  cases s0 <;> cases bRej
  · simp only [Bool.false_eq_true, Bool.not_false, Bool.and_false, ↓reduceIte, hanc]
    by_cases h1 : (ancSplitEquiv (bAnc0, ancHi)).val < 218 <;>
    by_cases h2 : v8.val < 218 <;>
    by_cases h3 : fine.val < tailKeepSpanOfDp dp <;>
      simp [h1, h2, h3, ← hp49] <;> ring
  · simp only [Bool.false_eq_true, Bool.not_true, ↓reduceIte, ← hp49]; ring
  · simp only [Bool.false_eq_true, Bool.not_false, Bool.not_true, Bool.false_and, Bool.and_true,
      ↓reduceIte, hanc]
    by_cases h1 : (ancSplitEquiv (bAnc0, ancHi)).val < 218 <;>
    by_cases h2 : v8.val < 217 <;>
    by_cases h3 : fine.val < tailKeepSpanOfDp dp <;>
      simp [h1, h2, h3, ← hp49] <;> ring
  · simp only [Bool.false_eq_true, Bool.not_true, ↓reduceIte, ← hp49]; ring


private theorem bhmt48RawAmp_head_s0False_eq (bPid0 : ZMod 2)
    (b1 : Fin (2 ^ 3)) (fine : Fin (2 ^ 30)) (aLo : Fin (2 ^ 2)) (aHi : Fin (2 ^ 5))
    (nuc : Fin (2 ^ 8)) (bRej : Bool) :
    (sqrtHalf : ℂ) * (sqrtHalf : ℂ) *
      bhmt48RawAmp true false (b1, fine, fin128SplitEquiv.symm (aLo, aHi), nuc) bRej =
    ((sqrtHalf : ℂ) ^ 33) * ((sqrtHalf : ℂ) ^ 5) * (sqrtHalf : ℂ) *
      muxHeadBhmtAmp nuc.val (pidSplitEquiv (bPid0, aLo)).val bRej := by
  have hmul : ∀ c m : ℂ,
      (sqrtHalf : ℂ) * (sqrtHalf : ℂ) * (c * (sqrtHalf : ℂ) ^ 48 * m) =
        ((sqrtHalf : ℂ) ^ 33) * ((sqrtHalf : ℂ) ^ 5) * (sqrtHalf : ℂ) *
          (c * (sqrtHalf : ℂ) ^ 11 * m) := fun c m ↦ by ring
  have hpid := goodAnc_c0Head_eq_pid_lt6 bPid0 aLo aHi
  dsimp only [bhmt48RawAmp, branchGood48, branchSSq, branchMuxMat, muxHeadBhmtAmp]
  cases bRej
  · simp only [Bool.not_true, Bool.not_false, Bool.false_and, Bool.true_and,
      Bool.false_eq_true, ↓reduceIte]
    rw [hpid]
