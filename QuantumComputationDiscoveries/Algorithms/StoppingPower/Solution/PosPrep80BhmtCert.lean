    refine ⟨hlo, hhi, fun h36 ↦ hne36 (Fin.ext ?_)⟩
    rw [hw_eq, rSub128_val, h36]
  have hne_ge86 : ∀ u : Wire 152, 86 ≤ u.val → u ≠ w := fun u hu h ↦ by
    have := congrArg Fin.val h; omega
  have hUpd128 : Function.update (fun i ↦ Function.update α w b (rSub128 i)) wEnC0Head_128 0 =
      Function.update (Function.update (fun i ↦ α (rSub128 i)) wEnC0Head_128 0) w128 b := by
    funext i
    by_cases hi121 : i = wEnC0Head_128
    · subst hi121
      have hne_w : wEnC0Head_128 ≠ w128 := fun h ↦ by
        have := congrArg Fin.val h; change 121 = w.val at this; omega
      rw [Function.update_self, Function.update_of_ne hne_w, Function.update_self]
    · by_cases hiw : i = w128
      · subst hiw
        rw [Function.update_of_ne hi121, Function.update_self, ← hw_eq, Function.update_self]
      · have hne152 : rSub128 i ≠ w := fun h ↦ hiw (rSub128.wires.injective (h.trans hw_eq))
        rw [Function.update_of_ne hi121, Function.update_of_ne hne152,
          Function.update_of_ne hiw, Function.update_of_ne hi121]
  refine ⟨?_, ?_, ?_, ?_, fun j ↦ ?_, ?_⟩
  · rw [hUpd128]
    exact flagsInv_indep_payload_not36 hw128 _ b hFl
  · rw [Function.update_of_ne (hne_ge86 _ (by decide)),
      Function.update_of_ne (hne_ge86 _ (by decide)),
      Function.update_of_ne (hne_ge86 _ (by decide)), hc0t]
  · rw [Function.update_of_ne (hne_ge86 _ (by decide)),
      Function.update_of_ne (hne_ge86 _ (by decide)),
      Function.update_of_ne (hne_ge86 _ (by decide)), hs4h]
  · rw [Function.update_of_ne (hne_ge86 _ (by decide)),
      Function.update_of_ne (hne_ge86 _ (by decide)),
      Function.update_of_ne (hne_ge86 _ (by decide)), hc0h]
  · rw [Function.update_of_ne (hne_ge86 _ (by dsimp [scr21_152, mkBlock152]; omega)), hscr21 j]
  · rw [Function.update_of_ne (hne_ge86 _ (by decide)), htele]


theorem ket_cnotIf_ne_152 {N : ℕ} (c t : Wire N) (h : c ≠ t) (β : BitAssignment N) :
    (cnotIf c t).eval.1.mulVec (ket β) = ket (Function.update β t (β t + β c)) := by
  simp only [cnotIf, h, ↓reduceDIte]
  exact ket_CNOT c t h β


def cMuxDerivedFlags_152 : Circuit 152 :=
  cnotIf wEnTail_152 wEnC0Tail_152 ;;ᶜ
  cnotIf wEnS0Tail_152 wEnC0Tail_152 ;;ᶜ
  cnotIf wEnS0_152 wEnS4Head_152 ;;ᶜ
  cnotIf wEnS0Tail_152 wEnS4Head_152 ;;ᶜ
  cnotIf wEnHead_152 wEnC0Head_152 ;;ᶜ
  cnotIf wEnS4Head_152 wEnC0Head_152


@[simp]
theorem count_toff_cMuxDerivedFlags_152 :
    cMuxDerivedFlags_152.count PrimitiveGate.TOFF = 0 := by
  simp [cMuxDerivedFlags_152]


@[simp]
theorem count_t_cMuxDerivedFlags_152 :
    cMuxDerivedFlags_152.count PrimitiveGate.T = 0 := by
  simp [cMuxDerivedFlags_152]


def muxDerivedFlagsMap (α : BitAssignment 152) : BitAssignment 152 :=
  let c0t := α wEnC0Tail_152 + α wEnTail_152 + α wEnS0Tail_152
  let s4h := α wEnS4Head_152 + α wEnS0_152 + α wEnS0Tail_152
  let c0h := α wEnC0Head_152 + α wEnHead_152 + s4h
  Function.update
    (Function.update
      (Function.update α wEnC0Tail_152 c0t) wEnS4Head_152 s4h) wEnC0Head_152 c0h


theorem ket_cMuxDerivedFlags_152 (α : BitAssignment 152) :
    cMuxDerivedFlags_152.eval.1.mulVec (ket α) = ket (muxDerivedFlagsMap α) := by
  rw [cMuxDerivedFlags_152]
  iterate 5 rw [eval_seq_mulVec]
  rw [ket_cnotIf_ne_152 _ _ (by decide),
    ket_cnotIf_ne_152 _ _ (by decide),
    ket_cnotIf_ne_152 _ _ (by decide),
    ket_cnotIf_ne_152 _ _ (by decide),
    ket_cnotIf_ne_152 _ _ (by decide),
    ket_cnotIf_ne_152 _ _ (by decide)]
  refine congrArg ket (funext fun w ↦ ?_)
  by_cases hw : w = wEnC0Tail_152 ∨ w = wEnS4Head_152 ∨ w = wEnC0Head_152
  · rcases hw with rfl | rfl | rfl <;>
      simp [muxDerivedFlagsMap, Fin.ext_iff, ← add_assoc]
  · push Not at hw
    rcases hw with ⟨h1, h2, h3⟩
    dsimp only [muxDerivedFlagsMap]
    repeat first
      | rw [Function.update_of_ne h3]
      | rw [Function.update_of_ne h2]
      | rw [Function.update_of_ne h1]


theorem muxDerivedFlagsMap_lift_fwd {α : BitAssignment 152}
    (hL : Lift128To152 FlagsInv128 α) :
    MuxFlagsInv152 (muxDerivedFlagsMap α) := by
  rcases hL with ⟨hFl, hhi⟩
  obtain ⟨hCore, _⟩ := (flagsInv_iff _).mp hFl
  have hc0h0 : α wEnC0Head_152 = 0 := by
    rw [← rSub128_wEnC0Head]; exact hCore.2.2.2.2.2.2.2.1
  have hc0t0 : α wEnC0Tail_152 = 0 := hhi wEnC0Tail_152 (by decide)
  have hs4h0 : α wEnS4Head_152 = 0 := hhi wEnS4Head_152 (by decide)
  have hSub : Function.update (fun i ↦ muxDerivedFlagsMap α (rSub128 i)) wEnC0Head_128 0 =
      fun i ↦ α (rSub128 i) := by
    funext i
    by_cases hi : i = wEnC0Head_128
    · subst hi
      rw [Function.update_self, rSub128_wEnC0Head, hc0h0]
    · have hne128 : rSub128 i ≠ wEnC0Tail_152 := fun h ↦ by
        have hv := congrArg Fin.val h; rw [rSub128_val] at hv; have hiLt := i.isLt
        change i.val = 128 at hv; omega
      have hne129 : rSub128 i ≠ wEnS4Head_152 := fun h ↦ by
        have hv := congrArg Fin.val h; rw [rSub128_val] at hv; have hiLt := i.isLt
        change i.val = 129 at hv; omega
      have hne121 : rSub128 i ≠ wEnC0Head_152 := by
        rw [← rSub128_wEnC0Head]; exact rSub128.wires.injective.ne hi
      rw [Function.update_of_ne hi]
      dsimp only [muxDerivedFlagsMap]
      rw [Function.update_of_ne hne121, Function.update_of_ne hne129, Function.update_of_ne hne128]
  refine ⟨by rw [hSub]; exact hFl, ?_, ?_, ?_, fun j ↦ ?_, ?_⟩
  · simp [muxDerivedFlagsMap, Fin.ext_iff, hc0t0]
  · simp [muxDerivedFlagsMap, Fin.ext_iff, hs4h0]
  · simp [muxDerivedFlagsMap, Fin.ext_iff, hc0h0, hs4h0]
  · have hne1 : scr21_152 j ≠ wEnC0Head_152 := fun h ↦ by
      have := congrArg Fin.val h; dsimp [scr21_152, mkBlock152, wEnC0Head_152] at this; omega
    have hne2 : scr21_152 j ≠ wEnS4Head_152 := fun h ↦ by
      have := congrArg Fin.val h; dsimp [scr21_152, mkBlock152, wEnS4Head_152] at this; omega
    have hne3 : scr21_152 j ≠ wEnC0Tail_152 := fun h ↦ by
      have := congrArg Fin.val h; dsimp [scr21_152, mkBlock152, wEnC0Tail_152] at this; omega
    dsimp only [muxDerivedFlagsMap]
    rw [Function.update_of_ne hne1, Function.update_of_ne hne2, Function.update_of_ne hne3]
    exact hhi _ (by dsimp [scr21_152, mkBlock152]; omega)
  · dsimp only [muxDerivedFlagsMap]
    rw [Function.update_of_ne (by decide : wTelePar_152 ≠ wEnC0Head_152),
      Function.update_of_ne (by decide : wTelePar_152 ≠ wEnS4Head_152),
      Function.update_of_ne (by decide : wTelePar_152 ≠ wEnC0Tail_152)]
    exact hhi _ (by decide)


theorem preservesSpanSub_cMuxDerivedFlags_fwd :
    PreservesSpanSub (Lift128To152 FlagsInv128) MuxFlagsInv152 cMuxDerivedFlags_152 := by
  intro α hα
  rw [ket_cMuxDerivedFlags_152]
  exact ket_mem_ketSpanSub (muxDerivedFlagsMap_lift_fwd hα)


theorem ket_cMuxDerivedFlags_inv_of_muxFlags {δ : BitAssignment 152}
    (hδ : MuxFlagsInv152 δ) :
    let α := Function.update
      (Function.update (Function.update δ wEnC0Tail_152 0) wEnS4Head_152 0) wEnC0Head_152 0
    cMuxDerivedFlags_152.inverse.eval.1.mulVec (ket δ) = ket α ∧
    Lift128To152 FlagsInv128 α := by
  intro α
  rcases hδ with ⟨hFl, hc0t, hs4h, hc0h, hscr21, htele⟩
  have hα_lift : Lift128To152 FlagsInv128 α := by
    refine ⟨?_, fun w hw ↦ ?_⟩
    · have heq : (fun i ↦ α (rSub128 i)) =
          Function.update (fun i ↦ δ (rSub128 i)) wEnC0Head_128 0 := by
        funext i
        by_cases hi : i = wEnC0Head_128
        · subst hi
          rw [Function.update_self, rSub128_wEnC0Head]
          dsimp only [α]; rw [Function.update_self]
        · have hne128 : rSub128 i ≠ wEnC0Tail_152 := fun h ↦ by
            have hv := congrArg Fin.val h; rw [rSub128_val] at hv; have hiLt := i.isLt
            change i.val = 128 at hv; omega
          have hne129 : rSub128 i ≠ wEnS4Head_152 := fun h ↦ by
            have hv := congrArg Fin.val h; rw [rSub128_val] at hv; have hiLt := i.isLt
            change i.val = 129 at hv; omega
          have hne121 : rSub128 i ≠ wEnC0Head_152 := by
            rw [← rSub128_wEnC0Head]; exact rSub128.wires.injective.ne hi
          rw [Function.update_of_ne hi]
          dsimp only [α]
          rw [Function.update_of_ne hne121, Function.update_of_ne hne129,
            Function.update_of_ne hne128]
      rw [heq]; exact hFl
    · by_cases h128 : w.val = 128
      · rw [show w = wEnC0Tail_152 from Fin.ext h128]
        simp [α, Fin.ext_iff]
      · by_cases h129 : w.val = 129
        · rw [show w = wEnS4Head_152 from Fin.ext h129]
          simp [α, Fin.ext_iff]
        · by_cases h151 : w.val = 151
          · rw [show w = wTelePar_152 from Fin.ext h151]
            simp [α, Fin.ext_iff, htele]
          · have hw21 : w = scr21_152 ⟨w.val - 130, by omega⟩ := by
              ext; dsimp [scr21_152, mkBlock152]; omega
            have hne1 : w ≠ wEnC0Head_152 := fun h ↦ by
              have := congrArg Fin.val h; dsimp [wEnC0Head_152] at this; omega
            have hne2 : w ≠ wEnS4Head_152 := fun h ↦ h129 (congrArg Fin.val h)
            have hne3 : w ≠ wEnC0Tail_152 := fun h ↦ h128 (congrArg Fin.val h)
            dsimp only [α]
            rw [Function.update_of_ne hne1, Function.update_of_ne hne2, Function.update_of_ne hne3,
              hw21]
            exact hscr21 _
  have hMap : muxDerivedFlagsMap α = δ := by
    funext w
    by_cases hw : w = wEnC0Tail_152 ∨ w = wEnS4Head_152 ∨ w = wEnC0Head_152
    · rcases hw with rfl | rfl | rfl
      · simp [muxDerivedFlagsMap, α, Fin.ext_iff, hc0t]
      · simp [muxDerivedFlagsMap, α, Fin.ext_iff, hs4h]
      · simp [muxDerivedFlagsMap, α, Fin.ext_iff, hc0h, hs4h]
    · push Not at hw
      rcases hw with ⟨h1, h2, h3⟩
      dsimp only [muxDerivedFlagsMap, α]
      rw [Function.update_of_ne h3, Function.update_of_ne h2, Function.update_of_ne h1,
        Function.update_of_ne h3, Function.update_of_ne h2, Function.update_of_ne h1]
  have hFwd : cMuxDerivedFlags_152.eval.1.mulVec (ket α) = ket δ := by
    rw [ket_cMuxDerivedFlags_152, hMap]
  exact ⟨inv_mulVec_ket_of_fwd_sub _ α δ hFwd, hα_lift⟩


theorem preservesSpanSub_cMuxDerivedFlags_bwd :
    PreservesSpanSub MuxFlagsInv152 (Lift128To152 FlagsInv128) cMuxDerivedFlags_152.inverse := by
  intro δ hδ
  obtain ⟨hInv, hLift⟩ := ket_cMuxDerivedFlags_inv_of_muxFlags hδ
  rw [hInv]
  exact ket_mem_ketSpanSub hLift

/-! ## Section 2: `SubLift152`, `DynPair152`, Polymorphic Builders, & `128 -> 152` Lifting -/


abbrev SubLift152 {n : ℕ} (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (S : BitAssignment 152 → Prop) (β : BitAssignment n) : Prop :=
  S (fun i ↦ β (rFull152 i)) ∧ ∀ j : Fin 9, β (rExtra9 j) = 0


private theorem embedUnitary_mul_subDiagProj_SubLift152_eq {n : ℕ}
    (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (S : BitAssignment 152 → Prop) (U₁ U₂ : Unitary (2 ^ 152))
    (hEq : U₁.1 * subDiagProj S = U₂.1 * subDiagProj S) :
    (rFull152.embedUnitary U₁).1 * subDiagProj (SubLift152 rFull152 rExtra9 S) =
      (rFull152.embedUnitary U₂).1 * subDiagProj (SubLift152 rFull152 rExtra9 S) := by
  apply matrix_ext_ket; intro β
  simp only [mul_mulVec_sub, subDiagProj_mulVec_ket]
  by_cases hL : SubLift152 rFull152 rExtra9 S β
  · rw [ite_pos_sub hL, QRegister.embedUnitary_val, QRegister.embedUnitary_val,
      embedMatrix_mulVec_ket_sub, embedMatrix_mulVec_ket_sub]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    have hcol : U₁.1 l (localIdxSub rFull152 β) = U₂.1 l (localIdxSub rFull152 β) := by
      rw [← ket_localIdxSub_eq rFull152 β l U₁.1, ← ket_localIdxSub_eq rFull152 β l U₂.1]
      have hv := congrArg (fun M ↦ M.mulVec (ket (fun i ↦ β (rFull152 i))) l) hEq
      simp only [mul_mulVec_sub, subDiagProj_mulVec_ket, hL.1, ↓reduceIte] at hv
      exact hv
    rw [hcol]
  · rw [ite_neg_sub hL, Matrix.mulVec_zero, Matrix.mulVec_zero]


private theorem subDiagProj_SubLift152_mul_embedUnitary {n : ℕ}
    (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    (S₁ S₂ : BitAssignment 152 → Prop) (U : Unitary (2 ^ 152))
    (hPres : subDiagProj S₂ * (U.1 * subDiagProj S₁) = U.1 * subDiagProj S₁) :
    subDiagProj (SubLift152 rFull152 rExtra9 S₂) *
        ((rFull152.embedUnitary U).1 * subDiagProj (SubLift152 rFull152 rExtra9 S₁)) =
      (rFull152.embedUnitary U).1 * subDiagProj (SubLift152 rFull152 rExtra9 S₁) := by
  apply matrix_ext_ket; intro β
  simp only [mul_mulVec_sub, subDiagProj_mulVec_ket]
  by_cases hL : SubLift152 rFull152 rExtra9 S₁ β
  · rw [ite_pos_sub hL, QRegister.embedUnitary_val, embedMatrix_mulVec_ket_sub,
      Matrix.mulVec_sum]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    rw [Matrix.mulVec_smul]
    by_cases hnz : U.1 l (localIdxSub rFull152 β) = 0
    · simp only [hnz, zero_smul]
    · have hS₂ : S₂ (basisBits 152 l) := by
        have hv := congrArg (fun M ↦ M.mulVec (ket (fun i ↦ β (rFull152 i))) l) hPres
        simp only [mul_mulVec_sub, subDiagProj_mulVec_ket, hL.1, ↓reduceIte] at hv
        exact mem_of_subDiagProj_mulVec_eq hv (by rwa [ket_localIdxSub_eq])
      have hLift₂ : SubLift152 rFull152 rExtra9 S₂
          (writeReg β rFull152 (basisBits 152 l)) := by
        refine ⟨?_, fun j ↦ ?_⟩
        · have heq : (fun i ↦ writeReg β rFull152 (basisBits 152 l) (rFull152 i)) =
              basisBits 152 l := by
            funext i; exact ZeroAncillaUSPS3.writeReg_apply_reg _ _ _ i
          rwa [heq]
        · have hnot : ¬∃ i : Fin 152, rFull152 i = rExtra9 j := by
            rintro ⟨i, hi⟩; exact hDisjExtra.ne i j hi
          rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hnot, hL.2 j]
      rw [writeReg_eq, subDiagProj_mulVec_ket, ite_pos_sub hLift₂]
  · rw [ite_neg_sub hL, Matrix.mulVec_zero, Matrix.mulVec_zero]


structure DynPair152 {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (S : BitAssignment 152 → Prop) (t : ℕ)
    (dFwd dInv : DynamicCircuit Var n) (U_loc : Unitary (2 ^ 152)) : Prop where
  toffFwd : dFwd.count PrimitiveGate.TOFF = 0
  toffInv : dInv.count PrimitiveGate.TOFF = 0
  tFwd : dFwd.count PrimitiveGate.T ≤ t
  tInv : dInv.count PrimitiveGate.T ≤ t
  storeFwd : PreservesStoreConst dFwd
  storeInv : PreservesStoreConst dInv
  presLoc : subDiagProj S * (U_loc.1 * subDiagProj S) = U_loc.1 * subDiagProj S
  realFwd : RealizesCleanUnitary v (subDiagProj (SubLift152 rFull152 rExtra9 S)) dFwd
    (rFull152.embedUnitary U_loc)
  realInv : RealizesCleanUnitary v (subDiagProj (SubLift152 rFull152 rExtra9 S)) dInv
    (rFull152.embedUnitary U_loc⁻¹)


def mkWithCliffDyn152 {Var : Type} {n : ℕ} (rFull152 : QRegister 152 n) (C : Circuit 152)
    (body : DynamicCircuit Var n) : DynamicCircuit Var n :=
  .seq (.circuit (C.onRegister rFull152))
    (.seq body (.circuit (C.inverse.onRegister rFull152)))


def mkWithTempAndDyn152 {Var : Type} {n : ℕ} (v : Var) (rFull152 : QRegister 152 n)
    (c₁ c₂ anc : Wire 152) (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    (body : DynamicCircuit Var n) : DynamicCircuit Var n :=
  .seq (DynamicCircuit.andCompute (rFull152 c₁) (rFull152 c₂) (rFull152 anc)
          (rFull152.wires.injective.ne h₁a) (rFull152.wires.injective.ne h₂a))
    (.seq body (DynamicCircuit.andUncompute v (rFull152 c₁) (rFull152 c₂) (rFull152 anc)
          (rFull152.wires.injective.ne h₁₂)))


def dCSwapClean152 {Var : Type} {n : ℕ} (v : Var) (rFull152 : QRegister 152 n)
    (ctrl a b anc : Wire 152) (hca : ctrl ≠ a) (hcan : ctrl ≠ anc) (haan : a ≠ anc) :
    DynamicCircuit Var n :=
  mkWithCliffDyn152 rFull152 (cnotIf b a)
    (mkWithTempAndDyn152 v rFull152 ctrl a anc hca hcan haan
      (.circuit ((cnotIf anc b).onRegister rFull152)))


@[simp]
theorem count_toff_mkWithCliffDyn152 {Var : Type} {n : ℕ}
    (rFull152 : QRegister 152 n) (C : Circuit 152) (body : DynamicCircuit Var n)
    (hC : C.count PrimitiveGate.TOFF = 0) :
    (mkWithCliffDyn152 rFull152 C body).count PrimitiveGate.TOFF =
      body.count PrimitiveGate.TOFF := by
  simp [mkWithCliffDyn152, DynamicCircuit.count, Circuit.count_onRegister, hC]


theorem count_t_mkWithCliffDyn152 {Var : Type} {n : ℕ}
    (rFull152 : QRegister 152 n) (C : Circuit 152) (body : DynamicCircuit Var n)
    (hC : C.count PrimitiveGate.T = 0) :
    (mkWithCliffDyn152 rFull152 C body).count PrimitiveGate.T =
      body.count PrimitiveGate.T := by
  simp [mkWithCliffDyn152, DynamicCircuit.count, Circuit.count_onRegister, hC]


@[simp]
theorem count_toff_mkWithTempAndDyn152 {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (c₁ c₂ anc : Wire 152)
    (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    (body : DynamicCircuit Var n) :
    (mkWithTempAndDyn152 v rFull152 c₁ c₂ anc h₁₂ h₁a h₂a body).count PrimitiveGate.TOFF =
      body.count PrimitiveGate.TOFF := by
  have ha : (DynamicCircuit.andCompute (Var := Var)
      (rFull152 c₁) (rFull152 c₂) (rFull152 anc)
      (rFull152.wires.injective.ne h₁a) (rFull152.wires.injective.ne h₂a)).count
      PrimitiveGate.TOFF = 0 := rfl
  have hu : (DynamicCircuit.andUncompute v
      (rFull152 c₁) (rFull152 c₂) (rFull152 anc)
      (rFull152.wires.injective.ne h₁₂)).count PrimitiveGate.TOFF = 0 := rfl
  simp [mkWithTempAndDyn152, DynamicCircuit.count, ha, hu]


theorem count_t_mkWithTempAndDyn152 {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (c₁ c₂ anc : Wire 152)
    (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    (body : DynamicCircuit Var n) :
    (mkWithTempAndDyn152 v rFull152 c₁ c₂ anc h₁₂ h₁a h₂a body).count PrimitiveGate.T =
      body.count PrimitiveGate.T + 4 := by
  have ha : (DynamicCircuit.andCompute (Var := Var)
      (rFull152 c₁) (rFull152 c₂) (rFull152 anc)
      (rFull152.wires.injective.ne h₁a) (rFull152.wires.injective.ne h₂a)).count
      PrimitiveGate.T = 4 := rfl
  have hu : (DynamicCircuit.andUncompute v
      (rFull152 c₁) (rFull152 c₂) (rFull152 anc)
      (rFull152.wires.injective.ne h₁₂)).count PrimitiveGate.T = 0 := rfl
  simp only [mkWithTempAndDyn152, DynamicCircuit.count, ha, hu]
  omega


@[simp]
theorem count_toff_dCSwapClean152 {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (ctrl a b anc : Wire 152)
    (hca : ctrl ≠ a) (hcan : ctrl ≠ anc) (haan : a ≠ anc) :
    (dCSwapClean152 v rFull152 ctrl a b anc hca hcan haan).count PrimitiveGate.TOFF = 0 := by
  simp [dCSwapClean152, DynamicCircuit.count, Circuit.count_onRegister]


theorem count_t_dCSwapClean152 {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (ctrl a b anc : Wire 152)
    (hca : ctrl ≠ a) (hcan : ctrl ≠ anc) (haan : a ≠ anc) :
    (dCSwapClean152 v rFull152 ctrl a b anc hca hcan haan).count PrimitiveGate.T = 4 := by
  simp [dCSwapClean152, count_t_mkWithCliffDyn152 _ _ _ (count_t_cnotIf b a),
    count_t_mkWithTempAndDyn152, DynamicCircuit.count, Circuit.count_onRegister]


private theorem DynPair152.mono_t {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^
    n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    {S : BitAssignment 152 → Prop} {t₁ t₂ : ℕ}
    {dFwd dInv : DynamicCircuit Var n} {U : Unitary (2 ^ 152)}
    (ht : t₁ ≤ t₂)
    (hp : DynPair152 v rFull152 rExtra9 S t₁ dFwd dInv U) :
    DynPair152 v rFull152 rExtra9 S t₂ dFwd dInv U :=
  { hp with tFwd := hp.tFwd.trans ht, tInv := hp.tInv.trans ht }


private theorem DynPair152.congr_fwd {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2
    ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    {S : BitAssignment 152 → Prop} {t : ℕ}
    {dFwd dInv : DynamicCircuit Var n} {U₁ U₂ : Unitary (2 ^ 152)}
    (hp : DynPair152 v rFull152 rExtra9 S t dFwd dInv U₁)
    (hEq : ∀ α : BitAssignment 152, S α → U₁.1.mulVec (ket α) = U₂.1.mulVec (ket α)) :
    DynPair152 v rFull152 rExtra9 S t dFwd dInv U₂ := by
  have hMatEq : U₁.1 * subDiagProj S = U₂.1 * subDiagProj S := by
    apply matrix_ext_ket; intro α
    simp only [mul_mulVec_sub, subDiagProj_mulVec_ket]
    by_cases hs : S α
    · simp only [hs, ↓reduceIte, hEq α hs]
    · simp only [hs, ↓reduceIte, Matrix.mulVec_zero]
  have hPres₂ : subDiagProj S * (U₂.1 * subDiagProj S) = U₂.1 * subDiagProj S := by
    rw [← hMatEq, hp.presLoc]
  obtain ⟨hMatInvEq, _⟩ := inv_congr_of_subDiagProj_eq S U₁ U₂ hMatEq hPres₂
  have hPL_herm : (subDiagProj (SubLift152 rFull152 rExtra9 S))ᴴ =
      subDiagProj (SubLift152 rFull152 rExtra9 S) := subDiagProj_conjTranspose _
  exact {
    toffFwd := hp.toffFwd
    toffInv := hp.toffInv
    tFwd := hp.tFwd
    tInv := hp.tInv
    storeFwd := hp.storeFwd
    storeInv := hp.storeInv
    presLoc := hPres₂
    realFwd := RealizesCleanUnitary.congr_unitary hPL_herm hp.realFwd
      (embedUnitary_mul_subDiagProj_SubLift152_eq rFull152 rExtra9 S U₁ U₂ hMatEq)
    realInv := RealizesCleanUnitary.congr_unitary hPL_herm hp.realInv
      (embedUnitary_mul_subDiagProj_SubLift152_eq rFull152 rExtra9 S U₁⁻¹ U₂⁻¹ hMatInvEq)
  }


private theorem DynPair152.static {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^
    n)]
    (v : Var) (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (S : BitAssignment 152 → Prop) (c : Circuit 152)
    (hToff : c.count PrimitiveGate.TOFF = 0)
    (hSpan : PreservesSpanSub S S c) :
    DynPair152 v rFull152 rExtra9 S (c.count PrimitiveGate.T)
      (.circuit (c.onRegister rFull152))
      (.circuit (c.inverse.onRegister rFull152))
      c.eval := by
  have hEvFwd : (c.onRegister rFull152).eval = rFull152.embedUnitary c.eval := by
    rw [Circuit.eval_onRegister]
  have hEvInv : (c.inverse.onRegister rFull152).eval = rFull152.embedUnitary (c.eval)⁻¹ := by
    rw [Circuit.eval_onRegister, Circuit.eval_inverse]
  exact {
    toffFwd := by simp [DynamicCircuit.count, Circuit.count_onRegister, hToff]
    toffInv := by
      simp [DynamicCircuit.count, Circuit.count_onRegister, hToff]
    tFwd := by simp [DynamicCircuit.count, Circuit.count_onRegister]
    tInv := by simp [DynamicCircuit.count, Circuit.count_onRegister]
    storeFwd := PreservesStoreConst.circuit _
    storeInv := PreservesStoreConst.circuit _
    presLoc := subDiagProj_mul_of_preservesSpanSub hSpan
    realFwd := hEvFwd ▸ RealizesCleanUnitary.circuit v _ (c.onRegister rFull152)
    realInv := hEvInv ▸ RealizesCleanUnitary.circuit v _ (c.inverse.onRegister rFull152)
  }


private theorem DynPair152.staticSelfInv {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)]
    (v : Var) (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (S : BitAssignment 152 → Prop) (c : Circuit 152)
    (hToff : c.count PrimitiveGate.TOFF = 0)
    (hSpan : PreservesSpanSub S S c)
    (hSq : c.eval * c.eval = 1) :
    DynPair152 v rFull152 rExtra9 S (c.count PrimitiveGate.T)
      (.circuit (c.onRegister rFull152))
      (.circuit (c.onRegister rFull152))
      c.eval := by
  have hInvEq : (c.eval)⁻¹ = c.eval := inv_eq_of_mul_eq_one_right hSq
  have hEvFwd : (c.onRegister rFull152).eval = rFull152.embedUnitary c.eval := by
    rw [Circuit.eval_onRegister]
  have hEvInv : (c.onRegister rFull152).eval = rFull152.embedUnitary (c.eval)⁻¹ := by
    rw [hEvFwd, hInvEq]
  exact {
    toffFwd := by simp [DynamicCircuit.count, Circuit.count_onRegister, hToff]
    toffInv := by simp [DynamicCircuit.count, Circuit.count_onRegister, hToff]
    tFwd := by simp [DynamicCircuit.count, Circuit.count_onRegister]
    tInv := by simp [DynamicCircuit.count, Circuit.count_onRegister]
    storeFwd := PreservesStoreConst.circuit _
    storeInv := PreservesStoreConst.circuit _
    presLoc := subDiagProj_mul_of_preservesSpanSub hSpan
    realFwd := hEvFwd ▸ RealizesCleanUnitary.circuit v _ (c.onRegister rFull152)
    realInv := hEvInv ▸ RealizesCleanUnitary.circuit v _ (c.onRegister rFull152)
  }


private theorem DynPair152.seq {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    {S : BitAssignment 152 → Prop} {t₁ t₂ : ℕ}
    {dFwd₁ dInv₁ dFwd₂ dInv₂ : DynamicCircuit Var n}
    {U₁ U₂ : Unitary (2 ^ 152)}
    (h₁ : DynPair152 v rFull152 rExtra9 S t₁ dFwd₁ dInv₁ U₁)
    (h₂ : DynPair152 v rFull152 rExtra9 S t₂ dFwd₂ dInv₂ U₂) :
    DynPair152 v rFull152 rExtra9 S (t₁ + t₂)
      (.seq dFwd₁ dFwd₂) (.seq dInv₂ dInv₁) (U₂ * U₁) := by
  have hPL_herm : (subDiagProj (SubLift152 rFull152 rExtra9 S))ᴴ =
      subDiagProj (SubLift152 rFull152 rExtra9 S) := subDiagProj_conjTranspose _
  have hPres₁_L :=
    subDiagProj_SubLift152_mul_embedUnitary rFull152 rExtra9 hDisjExtra S S U₁ h₁.presLoc
  have hInv₂_loc := subDiagProj_mul_inv_of_self S U₂ h₂.presLoc
  have hPresInv₂_L :=
    subDiagProj_SubLift152_mul_embedUnitary rFull152 rExtra9 hDisjExtra S S U₂⁻¹ hInv₂_loc
  have hEmbFwd : rFull152.embedUnitary U₂ * rFull152.embedUnitary U₁ =
      rFull152.embedUnitary (U₂ * U₁) := (rFull152.embedUnitary_mul U₂ U₁).symm
  have hEmbInv : rFull152.embedUnitary U₁⁻¹ * rFull152.embedUnitary U₂⁻¹ =
      rFull152.embedUnitary (U₂ * U₁)⁻¹ := by
    rw [unitary_mul_inv_rev_sub, rFull152.embedUnitary_mul]
  exact {
    toffFwd := by simp [DynamicCircuit.count, h₁.toffFwd, h₂.toffFwd]
    toffInv := by simp [DynamicCircuit.count, h₁.toffInv, h₂.toffInv]
    tFwd := by simp only [DynamicCircuit.count]; exact Nat.add_le_add h₁.tFwd h₂.tFwd
    tInv := by
      simp only [DynamicCircuit.count]; exact (Nat.add_comm _ _) ▸ Nat.add_le_add h₁.tInv h₂.tInv
    storeFwd := PreservesStoreConst.seq h₁.storeFwd h₂.storeFwd
    storeInv := PreservesStoreConst.seq h₂.storeInv h₁.storeInv
    presLoc := by
      calc subDiagProj S * ((U₂ * U₁).1 * subDiagProj S)
          = subDiagProj S * (U₂.1 * (U₁.1 * subDiagProj S)) := by
              simp only [Submonoid.coe_mul, Matrix.mul_assoc]
        _ = subDiagProj S * (U₂.1 * (subDiagProj S * (U₁.1 * subDiagProj S))) := by rw [h₁.presLoc]
        _ = (subDiagProj S * (U₂.1 * subDiagProj S)) * (U₁.1 * subDiagProj S) := by
              simp only [Matrix.mul_assoc]
        _ = (U₂.1 * subDiagProj S) * (U₁.1 * subDiagProj S) := by rw [h₂.presLoc]
        _ = U₂.1 * (subDiagProj S * (U₁.1 * subDiagProj S)) := by simp only [Matrix.mul_assoc]
        _ = (U₂ * U₁).1 * subDiagProj S := by
              rw [h₁.presLoc]; simp only [Submonoid.coe_mul, Matrix.mul_assoc]
    realFwd := hEmbFwd ▸ RealizesCleanUnitary.seq hPL_herm h₁.realFwd h₂.realFwd hPres₁_L
    realInv := hEmbInv ▸ RealizesCleanUnitary.seq hPL_herm h₂.realInv h₁.realInv hPresInv₂_L
  }


private theorem DynPair152.withCliff {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2
    ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    {S_pre S_mid : BitAssignment 152 → Prop} {t : ℕ}
    (C : Circuit 152)
    (hCToff : C.count PrimitiveGate.TOFF = 0)
    (hCT : C.count PrimitiveGate.T = 0)
    (hCFwd : PreservesSpanSub S_pre S_mid C)
    (hCBwd : PreservesSpanSub S_mid S_pre C.inverse)
    {bFwd bInv : DynamicCircuit Var n} {U_body : Unitary (2 ^ 152)}
    (hb : DynPair152 v rFull152 rExtra9 S_mid t bFwd bInv U_body) :
    DynPair152 v rFull152 rExtra9 S_pre t
      (mkWithCliffDyn152 rFull152 C bFwd)
      (mkWithCliffDyn152 rFull152 C bInv)
      (C.inverse.eval * U_body * C.eval) := by
  let P_preL := subDiagProj (SubLift152 rFull152 rExtra9 S_pre)
  let P_midL := subDiagProj (SubLift152 rFull152 rExtra9 S_mid)
  have hPpre_herm : P_preLᴴ = P_preL := subDiagProj_conjTranspose _
  have hPmid_herm : P_midLᴴ = P_midL := subDiagProj_conjTranspose _
  have hCFwd_loc : subDiagProj S_mid * (C.eval.1 * subDiagProj S_pre) = C.eval.1 *
    subDiagProj S_pre :=
    subDiagProj_mul_of_preservesSpanSub hCFwd
  have hCBwd_loc :
      subDiagProj S_pre * (C.inverse.eval.1 * subDiagProj S_mid) = C.inverse.eval.1 *
        subDiagProj S_mid :=
    subDiagProj_mul_of_preservesSpanSub hCBwd
  have hCFwd_L :=
    subDiagProj_SubLift152_mul_embedUnitary rFull152 rExtra9 hDisjExtra S_pre S_mid C.eval hCFwd_loc
  have hEvC : (C.onRegister rFull152).eval = rFull152.embedUnitary C.eval := by
    rw [Circuit.eval_onRegister]
  have hEvCI : (C.inverse.onRegister rFull152).eval = rFull152.embedUnitary C.inverse.eval := by
    rw [Circuit.eval_onRegister]
  have hCFwd_onReg : P_midL * ((C.onRegister rFull152).eval.1 * P_preL) =
      (C.onRegister rFull152).eval.1 * P_preL := by
    rw [hEvC]; exact hCFwd_L
  have hStepFwd := realizesCleanUnitary_sandwich_circuit_sub hPpre_herm hPmid_herm
    (C.onRegister rFull152) (C.inverse.onRegister rFull152) hCFwd_onReg hb.realFwd
  have hStepInv := realizesCleanUnitary_sandwich_circuit_sub hPpre_herm hPmid_herm
    (C.onRegister rFull152) (C.inverse.onRegister rFull152) hCFwd_onReg hb.realInv
  have hEmbFwd :
      ((C.inverse.onRegister rFull152).eval * rFull152.embedUnitary U_body) *
          (C.onRegister rFull152).eval =
        rFull152.embedUnitary (C.inverse.eval * U_body * C.eval) := by
    rw [hEvC, hEvCI, ← rFull152.embedUnitary_mul, ← rFull152.embedUnitary_mul]
  have hU_inv_eq :
      (C.inverse.eval * U_body * C.eval)⁻¹ = C.inverse.eval * U_body⁻¹ * C.eval := by
    rw [unitary_mul_inv_rev_sub, unitary_mul_inv_rev_sub, Circuit.eval_inverse, inv_inv,
      ← unitary_mul_assoc_sub]
  have hEmbInv :
      ((C.inverse.onRegister rFull152).eval * rFull152.embedUnitary U_body⁻¹) *
          (C.onRegister rFull152).eval =
        rFull152.embedUnitary (C.inverse.eval * U_body * C.eval)⁻¹ := by
    rw [hEvC, hEvCI, hU_inv_eq, ← rFull152.embedUnitary_mul, ← rFull152.embedUnitary_mul]
  exact {
    toffFwd := by rw [count_toff_mkWithCliffDyn152 _ _ _ hCToff]; exact hb.toffFwd
    toffInv := by rw [count_toff_mkWithCliffDyn152 _ _ _ hCToff]; exact hb.toffInv
    tFwd := by rw [count_t_mkWithCliffDyn152 _ _ _ hCT]; exact hb.tFwd
    tInv := by rw [count_t_mkWithCliffDyn152 _ _ _ hCT]; exact hb.tInv
    storeFwd := PreservesStoreConst.seq (PreservesStoreConst.circuit _)
      (PreservesStoreConst.seq hb.storeFwd (PreservesStoreConst.circuit _))
    storeInv := PreservesStoreConst.seq (PreservesStoreConst.circuit _)
      (PreservesStoreConst.seq hb.storeInv (PreservesStoreConst.circuit _))
    presLoc := by
      calc subDiagProj S_pre * ((C.inverse.eval * U_body * C.eval).1 * subDiagProj S_pre)
          = subDiagProj S_pre * (C.inverse.eval.1 * (U_body.1 * (C.eval.1 * subDiagProj S_pre))) :=
            by
              simp only [Submonoid.coe_mul, Matrix.mul_assoc]
        _ = subDiagProj S_pre * (C.inverse.eval.1 * (U_body.1 *
              (subDiagProj S_mid * (C.eval.1 * subDiagProj S_pre)))) := by rw [hCFwd_loc]
        _ = subDiagProj S_pre * (C.inverse.eval.1 *
              ((U_body.1 * subDiagProj S_mid) * (C.eval.1 * subDiagProj S_pre))) := by
              simp only [Matrix.mul_assoc]
        _ = subDiagProj S_pre * (C.inverse.eval.1 *
              ((subDiagProj S_mid * (U_body.1 * subDiagProj S_mid)) * (C.eval.1 *
                subDiagProj S_pre))) := by
              rw [hb.presLoc]
        _ = (subDiagProj S_pre * (C.inverse.eval.1 * subDiagProj S_mid)) *
              ((U_body.1 * subDiagProj S_mid) * (C.eval.1 * subDiagProj S_pre)) := by
              simp only [Matrix.mul_assoc]
        _ = (C.inverse.eval.1 * subDiagProj S_mid) *
              ((U_body.1 * subDiagProj S_mid) * (C.eval.1 * subDiagProj S_pre)) := by rw [hCBwd_loc]
        _ = C.inverse.eval.1 * ((subDiagProj S_mid * (U_body.1 * subDiagProj S_mid)) *
              (C.eval.1 * subDiagProj S_pre)) := by simp only [Matrix.mul_assoc]
        _ = C.inverse.eval.1 * ((U_body.1 * subDiagProj S_mid) * (C.eval.1 * subDiagProj S_pre)) :=
          by
              rw [hb.presLoc]
        _ = C.inverse.eval.1 * (U_body.1 * (subDiagProj S_mid * (C.eval.1 * subDiagProj S_pre))) :=
          by
              simp only [Matrix.mul_assoc]
        _ = (C.inverse.eval * U_body * C.eval).1 * subDiagProj S_pre := by
              rw [hCFwd_loc]; simp only [Submonoid.coe_mul, Matrix.mul_assoc]
    realFwd := hEmbFwd ▸ hStepFwd
    realInv := hEmbInv ▸ hStepInv
  }


private theorem DynPair152.withTempAnd {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero
    (2 ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    (c₁ c₂ anc : Wire 152) (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    {S_pre S_mid : BitAssignment 152 → Prop} {t : ℕ}
    (hPreZero : ∀ α, S_pre α → α anc = 0)
    (hMidEq : ∀ δ, S_mid δ → δ anc = δ c₁ * δ c₂)
    (hStepFwd : ∀ α, S_pre α → S_mid (Function.update α anc (α c₁ * α c₂)))
    (hStepBwd : ∀ δ, S_mid δ → S_pre (Function.update δ anc 0))
    {bFwd bInv : DynamicCircuit Var n} {U_body : Unitary (2 ^ 152)}
    (hb : DynPair152 v rFull152 rExtra9 S_mid t bFwd bInv U_body) :
    DynPair152 v rFull152 rExtra9 S_pre (t + 4)
      (mkWithTempAndDyn152 v rFull152 c₁ c₂ anc h₁₂ h₁a h₂a bFwd)
      (mkWithTempAndDyn152 v rFull152 c₁ c₂ anc h₁₂ h₁a h₂a bInv)
      ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval * U_body *
        (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval) := by
  have h₁₂' : rFull152 c₁ ≠ rFull152 c₂ := rFull152.wires.injective.ne h₁₂
  have h₁a' : rFull152 c₁ ≠ rFull152 anc := rFull152.wires.injective.ne h₁a
  have h₂a' : rFull152 c₂ ≠ rFull152 anc := rFull152.wires.injective.ne h₂a
  let L_pre := SubLift152 rFull152 rExtra9 S_pre
  let L_mid := SubLift152 rFull152 rExtra9 S_mid
  have hAncNotExtra : ∀ j : Fin 9, rExtra9 j ≠ rFull152 anc :=
    fun j h ↦ hDisjExtra.ne anc j h.symm
  have hUpdPull : ∀ (β : BitAssignment n) (b : ZMod 2),
      (fun i ↦ Function.update β (rFull152 anc) b (rFull152 i)) =
        Function.update (fun i ↦ β (rFull152 i)) anc b := by
    intro β b; funext i
    by_cases hia : i = anc
    · subst hia; simp
    · simp [Function.update_of_ne hia, Function.update_of_ne (rFull152.wires.injective.ne hia)]
  have hL_preZero : ∀ β, L_pre β → β (rFull152 anc) = 0 := fun β h ↦ hPreZero _ h.1
  have hL_midEq : ∀ δ, L_mid δ → δ (rFull152 anc) = δ (rFull152 c₁) * δ (rFull152 c₂) :=
    fun δ h ↦ hMidEq _ h.1
  have hL_fwd : ∀ β, L_pre β →
      L_mid (Function.update β (rFull152 anc) (β (rFull152 c₁) * β (rFull152 c₂))) := by
    intro β ⟨h1, h2⟩
    refine ⟨?_, fun j ↦ by rw [Function.update_of_ne (hAncNotExtra j), h2 j]⟩
    rw [hUpdPull]; exact hStepFwd _ h1
  have hL_bwd : ∀ δ, L_mid δ → L_pre (Function.update δ (rFull152 anc) 0) := by
    intro δ ⟨h1, h2⟩
    refine ⟨?_, fun j ↦ by rw [Function.update_of_ne (hAncNotExtra j), h2 j]⟩
    rw [hUpdPull]; exact hStepBwd _ h1
  have hBodyFwd_L :=
    subDiagProj_SubLift152_mul_embedUnitary rFull152 rExtra9 hDisjExtra S_mid S_mid U_body
      hb.presLoc
  have hInvBody_loc := subDiagProj_mul_inv_of_self S_mid U_body hb.presLoc
  have hBodyInv_L :=
    subDiagProj_SubLift152_mul_embedUnitary rFull152 rExtra9 hDisjExtra S_mid S_mid U_body⁻¹
      hInvBody_loc
  obtain ⟨hRealFwd_T, _⟩ := realizesCleanUnitary_withTempAnd_subDiag
    v (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a'
    L_pre L_mid hL_preZero hL_midEq hL_fwd hL_bwd bFwd (rFull152.embedUnitary U_body)
    hb.realFwd hBodyFwd_L
  obtain ⟨hRealInv_T, _⟩ := realizesCleanUnitary_withTempAnd_subDiag
    v (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a'
    L_pre L_mid hL_preZero hL_midEq hL_fwd hL_bwd bInv (rFull152.embedUnitary U_body⁻¹)
    hb.realInv hBodyInv_L
  let T_loc := (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval
  have hToffOnReg :
      (Circuit.TOFF (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a').eval =
        rFull152.embedUnitary T_loc := by
    have hon : (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).onRegister rFull152 =
        Circuit.TOFF (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a' := by
      dsimp only [Circuit.TOFF, Circuit.onRegister]
      congr 1; apply qreg_ext_sub; intro i; fin_cases i <;> rfl
    rw [← hon, Circuit.eval_onRegister]
  have hEmbFwd :
      ((Circuit.TOFF (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a').eval *
          rFull152.embedUnitary U_body) *
        (Circuit.TOFF (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a').eval =
      rFull152.embedUnitary (T_loc * U_body * T_loc) := by
    rw [hToffOnReg, ← rFull152.embedUnitary_mul, ← rFull152.embedUnitary_mul]
  have hTloc_inv : T_loc⁻¹ = T_loc :=
    inv_eq_of_mul_eq_one_right (toffoli_eval_sq c₁ c₂ anc h₁₂ h₁a h₂a)
  have hU_inv_eq : (T_loc * U_body * T_loc)⁻¹ = T_loc * U_body⁻¹ * T_loc := by
    rw [unitary_mul_inv_rev_sub, unitary_mul_inv_rev_sub, hTloc_inv, ← unitary_mul_assoc_sub]
  have hEmbInv :
      ((Circuit.TOFF (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a').eval *
          rFull152.embedUnitary U_body⁻¹) *
        (Circuit.TOFF (rFull152 c₁) (rFull152 c₂) (rFull152 anc) h₁₂' h₁a' h₂a').eval =
      rFull152.embedUnitary (T_loc * U_body * T_loc)⁻¹ := by
    rw [hU_inv_eq, hToffOnReg, ← rFull152.embedUnitary_mul, ← rFull152.embedUnitary_mul]
  have hPresLoc_T :
      subDiagProj S_pre * ((T_loc * U_body * T_loc).1 * subDiagProj S_pre) =
        (T_loc * U_body * T_loc).1 * subDiagProj S_pre := by
    have hFT : subDiagProj S_mid * (T_loc.1 * subDiagProj S_pre) = T_loc.1 * subDiagProj S_pre := by
      apply matrix_ext_ket; intro α
      simp only [T_loc, mul_mulVec_sub, subDiagProj_mulVec_ket]
      by_cases hs : S_pre α
      · simp only [hs, ↓reduceIte, ket_TOFF, hPreZero α hs, zero_add,
          subDiagProj_mulVec_ket, hStepFwd α hs]
      · simp only [hs, ↓reduceIte, Matrix.mulVec_zero]
    have hBT : subDiagProj S_pre * (T_loc.1 * subDiagProj S_mid) = T_loc.1 * subDiagProj S_mid := by
      apply matrix_ext_ket; intro δ
      simp only [T_loc, mul_mulVec_sub, subDiagProj_mulVec_ket]
      by_cases hs : S_mid δ
      · have hz : δ anc + δ c₁ * δ c₂ = 0 := by
          rw [hMidEq δ hs, CharTwo.add_self_eq_zero]
        simp only [hs, ↓reduceIte, ket_TOFF, hz, subDiagProj_mulVec_ket, hStepBwd δ hs]
      · simp only [hs, ↓reduceIte, Matrix.mulVec_zero]
    calc subDiagProj S_pre * ((T_loc * U_body * T_loc).1 * subDiagProj S_pre)
        = subDiagProj S_pre * (T_loc.1 * (U_body.1 * (T_loc.1 * subDiagProj S_pre))) := by
            simp [Submonoid.coe_mul, Matrix.mul_assoc]
      _ = subDiagProj S_pre * (T_loc.1 * (U_body.1 * (subDiagProj S_mid * (T_loc.1 *
        subDiagProj S_pre)))) := by
            rw [hFT]
      _ = subDiagProj S_pre * (T_loc.1 * ((U_body.1 * subDiagProj S_mid) * (T_loc.1 *
        subDiagProj S_pre))) := by
            simp [Matrix.mul_assoc]
      _ = subDiagProj S_pre * (T_loc.1 *
            ((subDiagProj S_mid * (U_body.1 * subDiagProj S_mid)) * (T_loc.1 *
              subDiagProj S_pre))) := by
            rw [hb.presLoc]
      _ = (subDiagProj S_pre * (T_loc.1 * subDiagProj S_mid)) *
            ((U_body.1 * subDiagProj S_mid) * (T_loc.1 * subDiagProj S_pre)) := by
            simp [Matrix.mul_assoc]
      _ = (T_loc.1 * subDiagProj S_mid) *
            ((U_body.1 * subDiagProj S_mid) * (T_loc.1 * subDiagProj S_pre)) := by rw [hBT]
      _ = T_loc.1 * ((subDiagProj S_mid * (U_body.1 * subDiagProj S_mid)) * (T_loc.1 *
        subDiagProj S_pre)) := by
            simp [Matrix.mul_assoc]
      _ = T_loc.1 * ((U_body.1 * subDiagProj S_mid) * (T_loc.1 * subDiagProj S_pre)) := by
            rw [hb.presLoc]
      _ = T_loc.1 * (U_body.1 * (subDiagProj S_mid * (T_loc.1 * subDiagProj S_pre))) := by
            simp [Matrix.mul_assoc]
      _ = (T_loc * U_body * T_loc).1 * subDiagProj S_pre := by
            rw [hFT]; simp [Submonoid.coe_mul, Matrix.mul_assoc]
  exact {
    toffFwd := by rw [count_toff_mkWithTempAndDyn152]; exact hb.toffFwd
    toffInv := by rw [count_toff_mkWithTempAndDyn152]; exact hb.toffInv
    tFwd := by rw [count_t_mkWithTempAndDyn152]; exact Nat.add_le_add_right hb.tFwd 4
    tInv := by rw [count_t_mkWithTempAndDyn152]; exact Nat.add_le_add_right hb.tInv 4
    storeFwd := PreservesStoreConst.seq (PreservesStoreConst.circuit _)
      (PreservesStoreConst.seq hb.storeFwd (PreservesStoreConst.andUncompute v _ _ _ h₁₂'))
    storeInv := PreservesStoreConst.seq (PreservesStoreConst.circuit _)
      (PreservesStoreConst.seq hb.storeInv (PreservesStoreConst.andUncompute v _ _ _ h₁₂'))
    presLoc := hPresLoc_T
    realFwd := hEmbFwd ▸ hRealFwd_T
    realInv := hEmbInv ▸ hRealInv_T
  }


def cswapMap152 (ctrl a b : Wire 152) (α : BitAssignment 152) : BitAssignment 152 :=
  Function.update (Function.update α a (if α ctrl = 1 then α b else α a))
    b (if α ctrl = 1 then α a else α b)


def cCSwapRef152 (ctrl a b : Wire 152) (hca : ctrl ≠ a) (hcb : ctrl ≠ b) (hab : a ≠ b) :
    Circuit 152 :=
  cnotIf b a ;;ᶜ Circuit.TOFF ctrl a b hca hcb hab ;;ᶜ cnotIf b a


theorem ket_cCSwapRef152 (ctrl a b : Wire 152) (hca : ctrl ≠ a) (hcb : ctrl ≠ b) (hab : a ≠ b)
    (α : BitAssignment 152) :
    (cCSwapRef152 ctrl a b hca hcb hab).eval.1.mulVec (ket α) = ket (cswapMap152 ctrl a b α) := by
  rw [cCSwapRef152, eval_seq_mulVec, eval_seq_mulVec,
    ket_cnotIf_ne_152 b a hab.symm, ket_TOFF, ket_cnotIf_ne_152 b a hab.symm]
  have halg1 : ∀ c x y : ZMod 2,
      (x + y) + (y + c * (x + y)) = if c = 1 then y else x := by decide
  have halg2 : ∀ c x y : ZMod 2,
      y + c * (x + y) = if c = 1 then x else y := by decide
  refine congrArg ket (funext fun w ↦ ?_)
  by_cases hwb : w = b
  · subst hwb
    simp [cswapMap152, Function.update_of_ne hab, Function.update_of_ne hab.symm,
      Function.update_of_ne hca, halg2]
  · by_cases hwa : w = a
    · subst hwa
      simp [cswapMap152, Function.update_of_ne hab, Function.update_of_ne hab.symm,
        Function.update_of_ne hca, halg1]
    · simp [cswapMap152, Function.update_of_ne hwb, Function.update_of_ne hwa]


theorem ket_cnotIf_inv_ne_152 {N : ℕ} (c t : Wire N) (hct : c ≠ t) (β : BitAssignment N) :
    (cnotIf c t).inverse.eval.1.mulVec (ket β) = ket (Function.update β t (β t + β c)) := by
  let β' := Function.update β t (β t + β c)
  have hFwd : (cnotIf c t).eval.1.mulVec (ket β') = ket β := by
    rw [ket_cnotIf_ne_152 c t hct β']
    refine congrArg ket (funext fun w ↦ ?_)
    by_cases hwt : w = t
    · subst hwt
      have hcancel : ∀ x y : ZMod 2, x + y + y = x := by decide
      simp [β', Function.update_of_ne hct, hcancel]
    · simp [β', Function.update_of_ne hwt]
  exact inv_mulVec_ket_of_fwd_sub (cnotIf c t) β' β hFwd


theorem cnotIf_eval_sq_152 {N : ℕ} (c t : Wire N) (hct : c ≠ t) :
    (cnotIf c t).eval * (cnotIf c t).eval = 1 := by
  apply Subtype.ext
  apply matrix_ext_ket; intro β
  simp only [Submonoid.coe_mul, OneMemClass.coe_one, mul_mulVec_sub, Matrix.one_mulVec,
    ket_cnotIf_ne_152 c t hct]
  have hcancel : ∀ x y : ZMod 2, x + y + y = x := by decide
  refine congrArg ket (funext fun w ↦ ?_)
  by_cases hwt : w = t
  · subst hwt; simp [Function.update_of_ne hct, hcancel]
  · simp [Function.update_of_ne hwt]


private theorem DynPair152.cswapClean {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero
    (2 ^ n)]
    (v : Var) (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    {S : BitAssignment 152 → Prop}
    (ctrl a b anc : Wire 152)
    (hca : ctrl ≠ a) (hcb : ctrl ≠ b) (hab : a ≠ b)
    (hcan : ctrl ≠ anc) (haan : a ≠ anc) (hban : b ≠ anc)
    (hAnc0 : ∀ α, S α → α anc = 0)
    (hIndA : WireIndepSub S a) (hIndB : WireIndepSub S b) :
    DynPair152 v rFull152 rExtra9 S 4
      (dCSwapClean152 v rFull152 ctrl a b anc hca hcan haan)
      (dCSwapClean152 v rFull152 ctrl a b anc hca hcan haan)
      (cCSwapRef152 ctrl a b hca hcb hab).eval := by
  let S_mid : BitAssignment 152 → Prop := fun δ ↦
    ∃ α, S α ∧ δ = Function.update α anc (α ctrl * α a)
  have hLeafSpan : PreservesSpanSub S_mid S_mid (cnotIf anc b) := by
    intro δ ⟨α, hα, hδ⟩
    subst hδ
    rw [ket_cnotIf_ne_152 anc b hban.symm]
    refine ket_mem_ketSpanSub ⟨Function.update α b (α b + α ctrl * α a), hIndB α _ hα, ?_⟩
    funext w
    by_cases hwb : w = b
    · subst hwb
      simp [Function.update_of_ne hban]
    · by_cases hwa : w = anc
      · subst hwa
        simp [Function.update_of_ne hban, Function.update_of_ne hban.symm,
          Function.update_of_ne hcb, Function.update_of_ne hab]
      · simp [Function.update_of_ne hwb, Function.update_of_ne hwa]
  have hLeaf := DynPair152.staticSelfInv v rFull152 rExtra9 S_mid (cnotIf anc b)
    (count_toff_cnotIf anc b) hLeafSpan (cnotIf_eval_sq_152 anc b hban.symm)
  have hLeaf0 : DynPair152 v rFull152 rExtra9 S_mid 0
      (.circuit ((cnotIf anc b).onRegister rFull152))
      (.circuit ((cnotIf anc b).onRegister rFull152))
      (cnotIf anc b).eval := by
    rw [count_t_cnotIf] at hLeaf; exact hLeaf
  have hTemp := DynPair152.withTempAnd hDisjExtra ctrl a anc hca hcan haan
    hAnc0
    (fun δ ⟨α, _, hδ⟩ ↦ by
      subst hδ
      simp [Function.update_of_ne hcan, Function.update_of_ne haan])
    (fun α hα ↦ ⟨α, hα, rfl⟩)
    (fun δ ⟨α, hα, hδ⟩ ↦ by
      subst hδ
      have hrestore : Function.update (Function.update α anc (α ctrl * α a)) anc 0 = α := by
        funext w
        by_cases hw : w = anc
        · subst hw; simp [hAnc0 α hα]
        · simp [Function.update_of_ne hw]
      rw [hrestore]; exact hα)
    hLeaf0
  have hCliffFwd : PreservesSpanSub S S (cnotIf b a) := preservesSpanSub_cnotIf b a hIndA
  have hCliffBwd : PreservesSpanSub S S (cnotIf b a).inverse := by
    intro α hα
    rw [ket_cnotIf_inv_ne_152 b a hab.symm]
    exact ket_mem_ketSpanSub (hIndA α _ hα)
  have hWrap := DynPair152.withCliff hDisjExtra (cnotIf b a)
    (count_toff_cnotIf b a) (count_t_cnotIf b a) hCliffFwd hCliffBwd hTemp
  refine hWrap.congr_fwd fun α hα ↦ ?_
  simp only [Submonoid.coe_mul, mul_mulVec_sub]
  rw [ket_cnotIf_ne_152 b a hab.symm, ket_TOFF,
    ket_cnotIf_ne_152 anc b hban.symm, ket_TOFF,
    ket_cnotIf_inv_ne_152 b a hab.symm, ket_cCSwapRef152]
  have hz0 : Function.update α a (α a + α b) anc = 0 := by
    rw [Function.update_of_ne haan.symm]; exact hAnc0 α hα
  have halg_anc : ∀ x : ZMod 2, 0 + x + x = 0 := by decide
  have halg1 : ∀ c x y : ZMod 2,
      (x + y) + (y + c * (x + y)) = if c = 1 then y else x := by decide
  have halg2 : ∀ c x y : ZMod 2,
      y + c * (x + y) = if c = 1 then x else y := by decide
  refine congrArg ket (funext fun w ↦ ?_)
  by_cases hwa : w = a
  · subst hwa
    simp only [cswapMap152, hz0, zero_add, Function.update_self, Function.update_of_ne hca,
      Function.update_of_ne hcb, Function.update_of_ne hab, Function.update_of_ne hab.symm,
      Function.update_of_ne hcan, Function.update_of_ne haan, Function.update_of_ne hban,
      Function.update_of_ne hban.symm, halg1]
  · by_cases hwb : w = b
    · subst hwb
      simp only [cswapMap152, hz0, zero_add, Function.update_self, Function.update_of_ne hca,
        Function.update_of_ne hcb, Function.update_of_ne hab, Function.update_of_ne hab.symm,
        Function.update_of_ne hcan, Function.update_of_ne haan, Function.update_of_ne hban,
        Function.update_of_ne hban.symm, halg2]
    · by_cases hwanc : w = anc
      · subst hwanc
        simp only [cswapMap152, hz0, hAnc0 α hα, zero_add, Function.update_self,
          Function.update_of_ne hca, Function.update_of_ne hcb, Function.update_of_ne hab,
          Function.update_of_ne hab.symm, Function.update_of_ne hcan, Function.update_of_ne haan,
          Function.update_of_ne haan.symm, Function.update_of_ne hban,
          Function.update_of_ne hban.symm]
        exact CharTwo.add_self_eq_zero _
      · simp only [cswapMap152,
          Function.update_of_ne hwa, Function.update_of_ne hwb,
          Function.update_of_ne hwanc]


private theorem DynPair152.liftSub128 {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero
    (2 ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    {S128 : BitAssignment 128 → Prop} {t : ℕ}
    {dFwd dInv : DynamicCircuit Var n} {U128 : Unitary (2 ^ 128)}
    (hp : SubDynPair128 v (rFull152.compose rSub128) rExtra9 S128 t dFwd dInv U128) :
    DynPair152 v rFull152 rExtra9 (Lift128To152 S128) t dFwd dInv
      (rSub128.embedUnitary U128) := by
  let P_big := subDiagProj (SubLift128 (rFull152.compose rSub128) rExtra9 S128)
  let P_sm := subDiagProj (SubLift152 rFull152 rExtra9 (Lift128To152 S128))
  have hPb : P_bigᴴ = P_big := subDiagProj_conjTranspose _
  have hPs : P_smᴴ = P_sm := subDiagProj_conjTranspose _
  have hSub : P_big * P_sm = P_sm := by
    apply matrix_ext_ket; intro β
    dsimp only [P_big, P_sm]
    rw [mul_mulVec_sub, subDiagProj_mulVec_ket]
    by_cases hL : SubLift152 rFull152 rExtra9 (Lift128To152 S128) β
    · have hL128 : SubLift128 (rFull152.compose rSub128) rExtra9 S128 β := ⟨hL.1.1, hL.2⟩
      rw [ite_pos_sub hL, subDiagProj_mulVec_ket, ite_pos_sub hL128]
    · rw [ite_neg_sub hL, Matrix.mulVec_zero]
  have hEmbFwd : (rFull152.compose rSub128).embedUnitary U128 =
      rFull152.embedUnitary (rSub128.embedUnitary U128) :=
    QRegister.embedUnitary_compose rFull152 rSub128 U128
  have hEmbInv : (rFull152.compose rSub128).embedUnitary U128⁻¹ =
      rFull152.embedUnitary (rSub128.embedUnitary U128)⁻¹ := by
    rw [embedUnitary_inv_eq rSub128 U128]
    exact QRegister.embedUnitary_compose rFull152 rSub128 U128⁻¹
  have hPresLoc :
      subDiagProj (Lift128To152 S128) *
          ((rSub128.embedUnitary U128).1 * subDiagProj (Lift128To152 S128)) =
        (rSub128.embedUnitary U128).1 * subDiagProj (Lift128To152 S128) := by
    apply matrix_ext_ket; intro α
    simp only [mul_mulVec_sub, subDiagProj_mulVec_ket]
    by_cases hL : Lift128To152 S128 α
    · rw [ite_pos_sub hL, QRegister.embedUnitary_val, embedMatrix_mulVec_ket_sub,
        Matrix.mulVec_sum]
      refine Finset.sum_congr rfl fun l _ ↦ ?_
      rw [Matrix.mulVec_smul]
      by_cases hnz : U128.1 l (localIdxSub rSub128 α) = 0
      · simp only [hnz, zero_smul]
      · have hS₂ : S128 (basisBits 128 l) := by
          have hv := congrArg (fun M ↦ M.mulVec (ket (fun i ↦ α (rSub128 i))) l) hp.presLoc
          simp only [mul_mulVec_sub, subDiagProj_mulVec_ket, hL.1, ↓reduceIte] at hv
          exact mem_of_subDiagProj_mulVec_eq hv (by rwa [ket_localIdxSub_eq])
        have hLift₂ : Lift128To152 S128 (writeReg α rSub128 (basisBits 128 l)) := by
          refine ⟨?_, fun w hw ↦ ?_⟩
          · have heq : (fun i ↦ writeReg α rSub128 (basisBits 128 l) (rSub128 i)) =
                basisBits 128 l := by
              funext i; exact ZeroAncillaUSPS3.writeReg_apply_reg _ _ _ i
            rwa [heq]
          · have hnot : ¬∃ i : Fin 128, rSub128 i = w := by
              rintro ⟨i, rfl⟩
              have hv := rSub128_val i
              omega
            rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hnot, hL.2 w hw]
        rw [writeReg_eq, subDiagProj_mulVec_ket, ite_pos_sub hLift₂]
    · rw [ite_neg_sub hL, Matrix.mulVec_zero, Matrix.mulVec_zero]
  exact {
    toffFwd := hp.toffFwd
    toffInv := hp.toffInv
    tFwd := hp.tFwd
    tInv := hp.tInv
    storeFwd := hp.storeFwd
    storeInv := hp.storeInv
    presLoc := hPresLoc
    realFwd := hEmbFwd ▸ RealizesCleanUnitary.mono_proj hPb hPs hSub hp.realFwd
    realInv := hEmbInv ▸ RealizesCleanUnitary.mono_proj hPb hPs hSub hp.realInv
  }


private theorem DynPair152.liftDyn128 {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero
    (2 ^ n)]
    {v : Var} {rFull152 : QRegister 152 n} {rExtra9 : QRegister 9 n}
    {S128 : BitAssignment 128 → Prop} {t : ℕ}
    {dFwd dInv : DynamicCircuit Var n} {U128 : Unitary (2 ^ 128)}
    (hp : DynPair128 v (rFull152.compose rSub128) rExtra9 S128 t dFwd dInv U128) :
    DynPair152 v rFull152 rExtra9 (Lift128To152 S128) t dFwd dInv
      (rSub128.embedUnitary U128) :=
  DynPair152.liftSub128 {
    toffFwd := hp.toffFwd
    toffInv := hp.toffInv
    tFwd := hp.tFwd
    tInv := hp.tInv
    storeFwd := hp.storeFwd
    storeInv := hp.storeInv
    presLoc := hp.presLoc
    realFwd := hp.realFwd
    realInv := hp.realInv
  }

/-! ## Section 3: `diagBitPhase`, `czGate152`, & Fresh-Target `CleanStep152` Compiler -/


noncomputable def diagBitPhase (f : BitAssignment 152 → ZMod 2) : Unitary (2 ^ 152) :=
  ⟨Matrix.diagonal (fun x ↦ bitSign (f (basisBits 152 x))), by
    have hHerm : (Matrix.diagonal (fun x : Fin (2 ^ 152) ↦ bitSign (f (basisBits 152 x))))ᴴ =
        Matrix.diagonal (fun x : Fin (2 ^ 152) ↦ bitSign (f (basisBits 152 x))) := by
      rw [Matrix.diagonal_conjTranspose]
      congr 1; funext x
      rcases bit_cases (f (basisBits 152 x)) with h | h <;> simp [bitSign, h]
    have hSq : Matrix.diagonal (fun x : Fin (2 ^ 152) ↦ bitSign (f (basisBits 152 x))) *
        Matrix.diagonal (fun x : Fin (2 ^ 152) ↦ bitSign (f (basisBits 152 x))) = 1 := by
      rw [Matrix.diagonal_mul_diagonal]
      have h1 : (fun x : Fin (2 ^ 152) ↦
          bitSign (f (basisBits 152 x)) * bitSign (f (basisBits 152 x))) = fun _ ↦ (1 : ℂ) := by
        funext x; exact bitSign_mul_self _
      rw [h1, Matrix.diagonal_one]
    rw [Matrix.mem_unitaryGroup_iff]
    rw [Matrix.star_eq_conjTranspose, hHerm]
    exact hSq⟩


theorem diagBitPhase_mulVec_ket (f : BitAssignment 152 → ZMod 2) (α : BitAssignment 152) :
    (diagBitPhase f).1.mulVec (ket α) = bitSign (f α) • ket α := by
  change (Matrix.diagonal (fun x ↦ bitSign (f (basisBits 152 x)))).mulVec (ket α) = _
  rw [diagonal_mulVec_ket_sub]
  have hb : basisBits 152 ((basisBitsEquiv 152).symm α) = α :=
    (basisBitsEquiv 152).apply_symm_apply α
  rw [hb]


theorem diagBitPhase_sq (f : BitAssignment 152 → ZMod 2) :
    diagBitPhase f * diagBitPhase f = 1 := by
  apply Subtype.ext
  apply matrix_ext_ket; intro α
  simp only [Submonoid.coe_mul, OneMemClass.coe_one, mul_mulVec_sub, Matrix.one_mulVec,
    diagBitPhase_mulVec_ket, Matrix.mulVec_smul, smul_smul, bitSign_mul_self, one_smul]


def czGate152 (c t : Wire 152) : Circuit 152 :=
  Circuit.H t ;;ᶜ cnotIf c t ;;ᶜ Circuit.H t


@[simp]
theorem count_toff_czGate152 (c t : Wire 152) :
    (czGate152 c t).count PrimitiveGate.TOFF = 0 := by
  have hH : (Circuit.H t).count PrimitiveGate.TOFF = 0 := rfl
  simp [czGate152, hH]


@[simp]
theorem count_t_czGate152 (c t : Wire 152) :
    (czGate152 c t).count PrimitiveGate.T = 0 := by
  have hH : (Circuit.H t).count PrimitiveGate.T = 0 := rfl
  simp [czGate152, hH]


theorem circuit_H_mul_self_local {N : ℕ} (q : Wire N) :
    (Circuit.H q).eval * (Circuit.H q).eval = 1 := by
  have h2 : PrimitiveGate.eval .h * PrimitiveGate.eval .h = (1 : Unitary 2) := by
    apply Subtype.ext; ext i j
    change (((PrimitiveGate.eval .h).1 * (PrimitiveGate.eval .h).1) i j) =
      (1 : Matrix (Fin 2) (Fin 2) ℂ) i j
    rw [Matrix.one_apply]
    fin_cases i <;> fin_cases j <;>
      simp [PrimitiveGate.eval, Qubit.H, Matrix.mul_apply, Fin.sum_univ_two] <;> norm_num
  rw [Circuit.eval_single, ← QRegister.embedUnitary_mul, h2, QRegister.embedUnitary_one]


theorem ket_H_involutive_152 (q : Wire 152) (α : BitAssignment 152) :
    (Circuit.H q).eval.1.mulVec ((Circuit.H q).eval.1.mulVec (ket α)) = ket α := by
  have hmul := congrArg (fun u : Unitary (2 ^ 152) ↦
    u.1.mulVec (ket α)) (circuit_H_mul_self_local q)
  simpa only [Submonoid.coe_mul, mul_mulVec_sub, Submonoid.coe_one, Matrix.one_mulVec] using hmul


theorem ket_czGate152 (c t : Wire 152) (hct : c ≠ t) (α : BitAssignment 152) :
    (czGate152 c t).eval.1.mulVec (ket α) = bitSign (α c * α t) • ket α := by
  rw [czGate152, eval_seq_mulVec, eval_seq_mulVec]
  set u0 := Function.update α t 0
  set u1 := Function.update α t 1
  have hu0c : u0 c = α c := Function.update_of_ne hct 0 α
  have hu1c : u1 c = α c := Function.update_of_ne hct 1 α
  have hH_expand : (Circuit.H t).eval.1.mulVec (ket α) =
      sqrtHalf • ket u0 + (sqrtHalf * bitSign (α t)) • ket u1 := by
    rw [ket_H t α, smul_add, smul_smul]
  rcases bit_cases (α c) with hc0 | hc1
  · have hMid : (cnotIf c t).eval.1.mulVec ((Circuit.H t).eval.1.mulVec (ket α)) =
        (Circuit.H t).eval.1.mulVec (ket α) := by
      rw [hH_expand, Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        ket_cnotIf_ne_152 c t hct u0, ket_cnotIf_ne_152 c t hct u1, hu0c, hu1c, hc0]
      have hz0 : Function.update u0 t (u0 t + 0) = u0 := by
        funext w; by_cases hw : w = t
        · subst hw; simp [u0]
        · simp [Function.update_of_ne hw]
      have hz1 : Function.update u1 t (u1 t + 0) = u1 := by
        funext w; by_cases hw : w = t
        · subst hw; simp [u1]
        · simp [Function.update_of_ne hw]
      rw [hz0, hz1]
    rw [hMid, ket_H_involutive_152 t α, hc0, zero_mul]
    simp [bitSign]
  · have hswap0 : Function.update u0 t (u0 t + 1) = u1 := by
      funext w; by_cases hw : w = t
      · subst hw; simp [u0, u1]
      · simp [u0, u1, Function.update_of_ne hw]
    have hswap1 : Function.update u1 t (u1 t + 1) = u0 := by
      funext w; by_cases hw : w = t
      · subst hw; simp [u0, u1]
      · simp [u0, u1, Function.update_of_ne hw]
    rcases bit_cases (α t) with ht0 | ht1
    · have hMid : (cnotIf c t).eval.1.mulVec ((Circuit.H t).eval.1.mulVec (ket α)) =
          (Circuit.H t).eval.1.mulVec (ket α) := by
        rw [hH_expand, ht0]
        simp only [bitSign, ↓reduceIte, mul_one, Matrix.mulVec_add, Matrix.mulVec_smul,
          ket_cnotIf_ne_152 c t hct, hu0c, hu1c, hc1, hswap0, hswap1]
        exact add_comm _ _
      rw [hMid, ket_H_involutive_152 t α, hc1, ht0, mul_zero]
      simp [bitSign]
    · have hMid : (cnotIf c t).eval.1.mulVec ((Circuit.H t).eval.1.mulVec (ket α)) =
          (-1 : ℂ) • ((Circuit.H t).eval.1.mulVec (ket α)) := by
        rw [hH_expand, ht1]
        have h1ne0 : (1 : ZMod 2) ≠ 0 := by decide
        simp only [bitSign, h1ne0, ↓reduceIte, Matrix.mulVec_add, Matrix.mulVec_smul,
          ket_cnotIf_ne_152 c t hct, hu0c, hu1c, hc1, hswap0, hswap1]
        ext i; simp [Pi.add_apply, Pi.smul_apply]
      rw [hMid, Matrix.mulVec_smul, ket_H_involutive_152 t α, hc1, ht1, mul_one]
      have h1ne0 : (1 : ZMod 2) ≠ 0 := by decide
      simp [bitSign, h1ne0]


theorem czGate152_eval_eq (c t : Wire 152) (hct : c ≠ t) :
    (czGate152 c t).eval = diagBitPhase (fun α ↦ α c * α t) := by
  apply Subtype.ext
  apply matrix_ext_ket; intro α
  rw [ket_czGate152 c t hct α, diagBitPhase_mulVec_ket]


inductive CleanStep152 where
  | x (q : Wire 152)
  | cnot (c t : Wire 152)
  | tempAnd (c1 c2 anc : Wire 152)
  deriving DecidableEq


def wfStep152 : CleanStep152 → Bool
  | .x _ => true
  | .cnot c t => decide (c ≠ t)
  | .tempAnd c1 c2 anc => decide (c1 ≠ c2) && decide (c1 ≠ anc) && decide (c2 ≠ anc)


def evalStep152 : CleanStep152 → BitAssignment 152 → BitAssignment 152
  | .x q, α => Function.update α q (α q + 1)
  | .cnot c t, α => Function.update α t (α t + α c)
  | .tempAnd c1 c2 anc, α => Function.update α anc (α anc + α c1 * α c2)


def evalProg152 : List CleanStep152 → BitAssignment 152 → BitAssignment 152
  | [], α => α
  | s :: rest, α => evalProg152 rest (evalStep152 s α)


theorem evalProg152_append (p1 p2 : List CleanStep152) (α : BitAssignment 152) :
    evalProg152 (p1 ++ p2) α = evalProg152 p2 (evalProg152 p1 α) := by
  induction p1 generalizing α with
  | nil => rfl
  | cons s rest ih => exact ih (evalStep152 s α)


def countTempAnd152 : List CleanStep152 → ℕ
  | [] => 0
  | .tempAnd _ _ _ :: rest => countTempAnd152 rest + 1
  | _ :: rest => countTempAnd152 rest


def compileStep152 {Var : Type} {n : ℕ} (v : Var) (rFull152 : QRegister 152 n)
    (s : CleanStep152) (body : DynamicCircuit Var n) : DynamicCircuit Var n :=
  match s with
  | .x q => mkWithCliffDyn152 rFull152 (Circuit.X q) body
  | .cnot c t => mkWithCliffDyn152 rFull152 (cnotIf c t) body
  | .tempAnd c1 c2 anc =>
      if h12 : c1 ≠ c2 then
        if h1a : c1 ≠ anc then
          if h2a : c2 ≠ anc then
            mkWithTempAndDyn152 v rFull152 c1 c2 anc h12 h1a h2a body
          else body
        else body
      else body


def compileCleanProg152 {Var : Type} {n : ℕ} (v : Var) (rFull152 : QRegister 152 n) :
    List CleanStep152 → DynamicCircuit Var n → DynamicCircuit Var n
  | [], body => body
  | s :: rest, body => compileStep152 v rFull152 s (compileCleanProg152 v rFull152 rest body)


@[simp]
theorem count_toff_compileStep152 {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (s : CleanStep152) (body : DynamicCircuit Var n) :
    (compileStep152 v rFull152 s body).count PrimitiveGate.TOFF =
      body.count PrimitiveGate.TOFF := by
  cases s with
  | x q =>
      have hX : (Circuit.X q).count PrimitiveGate.TOFF = 0 := rfl
      exact count_toff_mkWithCliffDyn152 rFull152 (Circuit.X q) body hX
  | cnot c t =>
      exact count_toff_mkWithCliffDyn152 rFull152 (cnotIf c t) body (count_toff_cnotIf c t)
  | tempAnd c1 c2 anc =>
      dsimp only [compileStep152]
      split_ifs <;> simp


@[simp]
theorem count_toff_compileCleanProg152 {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (prog : List CleanStep152) (body : DynamicCircuit Var n) :
    (compileCleanProg152 v rFull152 prog body).count PrimitiveGate.TOFF =
      body.count PrimitiveGate.TOFF := by
  induction prog with
  | nil => rfl
  | cons s rest ih => simp [compileCleanProg152, ih]


theorem count_t_compileStep152_le {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (s : CleanStep152) (body : DynamicCircuit Var n) :
    (compileStep152 v rFull152 s body).count PrimitiveGate.T ≤
      body.count PrimitiveGate.T + (match s with | .tempAnd _ _ _ => 4 | _ => 0) := by
  cases s with
  | x q =>
      have hX : (Circuit.X q).count PrimitiveGate.T = 0 := rfl
      rw [compileStep152, count_t_mkWithCliffDyn152 rFull152 (Circuit.X q) body hX]
      omega
  | cnot c t =>
      rw [compileStep152, count_t_mkWithCliffDyn152 rFull152 (cnotIf c t) body (count_t_cnotIf c t)]
      omega
  | tempAnd c1 c2 anc =>
      dsimp only [compileStep152]
      split_ifs with h12 h1a h2a
      · rw [count_t_mkWithTempAndDyn152]
      · omega
      · omega
      · omega


theorem count_t_compileCleanProg152_le {Var : Type} {n : ℕ} (v : Var)
    (rFull152 : QRegister 152 n) (prog : List CleanStep152) (body : DynamicCircuit Var n) :
    (compileCleanProg152 v rFull152 prog body).count PrimitiveGate.T ≤
      body.count PrimitiveGate.T + 4 * countTempAnd152 prog := by
  induction prog with
  | nil => simp [compileCleanProg152, countTempAnd152]
  | cons s rest ih =>
      have hs := count_t_compileStep152_le v rFull152 s (compileCleanProg152 v rFull152 rest body)
      cases s <;> simp only [compileCleanProg152, countTempAnd152] at hs ⊢ <;> omega


def checkFreshProg152 (dirty : Wire 152 → Bool) : List CleanStep152 → Bool
  | [] => true
  | .x q :: rest => checkFreshProg152 (Function.update dirty q true) rest
  | .cnot c t :: rest =>
      decide (c ≠ t) && checkFreshProg152 (Function.update dirty t true) rest
  | .tempAnd c1 c2 anc :: rest =>
      decide (c1 ≠ c2) && decide (c1 ≠ anc) && decide (c2 ≠ anc) && (!dirty anc) &&
        checkFreshProg152 (Function.update dirty anc true) rest


theorem evalStep152_involutive (s : CleanStep152) (hwf : wfStep152 s = true)
    (α : BitAssignment 152) :
    evalStep152 s (evalStep152 s α) = α := by
  have hcancel : ∀ x y : ZMod 2, x + y + y = x := by decide
  cases s with
  | x q =>
      funext w; by_cases hw : w = q
      · subst hw; simp [evalStep152, hcancel]
      · simp [evalStep152, Function.update_of_ne hw]
  | cnot c t =>
      simp only [wfStep152, decide_eq_true_eq] at hwf
      funext w; by_cases hw : w = t
      · subst hw; simp [evalStep152, Function.update_of_ne hwf, hcancel]
      · simp [evalStep152, Function.update_of_ne hw]
  | tempAnd c1 c2 anc =>
      simp only [wfStep152, Bool.and_eq_true, decide_eq_true_eq] at hwf
      rcases hwf with ⟨⟨_, h1a⟩, h2a⟩
      funext w; by_cases hw : w = anc
      · subst hw; simp [evalStep152, Function.update_of_ne h1a, Function.update_of_ne h2a, hcancel]
      · simp [evalStep152, Function.update_of_ne hw]


theorem ket_X_inv_152 (q : Wire 152) (δ : BitAssignment 152) :
    (Circuit.X q).inverse.eval.1.mulVec (ket δ) = ket (Function.update δ q (δ q + 1)) := by
  let α := Function.update δ q (δ q + 1)
  have hFwd : (Circuit.X q).eval.1.mulVec (ket α) = ket δ := by
    rw [ket_X q α]
    have hcancel : ∀ x : ZMod 2, x + 1 + 1 = x := by decide
    refine congrArg ket (funext fun w ↦ ?_)
    by_cases hw : w = q
    · subst hw; simp [α, hcancel]
    · simp [α, Function.update_of_ne hw]
  exact inv_mulVec_ket_of_fwd_sub (Circuit.X q) α δ hFwd


private theorem compileCleanProg152_diagPhase_pair
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    (prog : List CleanStep152)
    (dirty : Wire 152 → Bool)
    (hFresh : checkFreshProg152 dirty prog = true)
    (S : BitAssignment 152 → Prop)
    (hClean : ∀ w : Wire 152, dirty w = false → ∀ α, S α → α w = 0)
    (f : BitAssignment 152 → ZMod 2)
    {body : DynamicCircuit Var n} {tB : ℕ}
    (hBody : ∀ S' : BitAssignment 152 → Prop,
      DynPair152 v rFull152 rExtra9 S' tB body body (diagBitPhase f)) :
    DynPair152 v rFull152 rExtra9 S (tB + 4 * countTempAnd152 prog)
      (compileCleanProg152 v rFull152 prog body)
      (compileCleanProg152 v rFull152 prog body)
      (diagBitPhase (fun α ↦ f (evalProg152 prog α))) := by
  induction prog generalizing dirty S with
  | nil =>
      simpa [compileCleanProg152, countTempAnd152, evalProg152] using hBody S
  | cons s rest ih =>
      let S_mid : BitAssignment 152 → Prop := fun δ ↦ ∃ α, S α ∧ δ = evalStep152 s α
      cases s with
      | x q =>
          simp only [checkFreshProg152] at hFresh
          have hClean' : ∀ w, Function.update dirty q true w = false → ∀ δ, S_mid δ → δ w = 0 := by
            intro w hw δ ⟨α, hα, hδ⟩; subst hδ
            have hwq : w ≠ q := fun h ↦ by subst h; simp at hw
            rw [Function.update_of_ne hwq] at hw
            dsimp only [evalStep152]
            rw [Function.update_of_ne hwq]
            exact hClean w hw α hα
          have hRest := ih (Function.update dirty q true) hFresh S_mid hClean'
          have hXToff : (Circuit.X q).count PrimitiveGate.TOFF = 0 := rfl
          have hXT : (Circuit.X q).count PrimitiveGate.T = 0 := rfl
          have hFwdSpan : PreservesSpanSub S S_mid (Circuit.X q) := by
            intro α hα; rw [ket_X q α]; exact ket_mem_ketSpanSub ⟨α, hα, rfl⟩
          have hBwdSpan : PreservesSpanSub S_mid S (Circuit.X q).inverse := by
            intro δ ⟨α, hα, hδ⟩; subst hδ
            rw [ket_X_inv_152 q]
            have hinv := evalStep152_involutive (.x q) rfl α
            dsimp only [evalStep152] at hinv ⊢
            rw [hinv]; exact ket_mem_ketSpanSub hα
          have hStep :=
            DynPair152.withCliff hDisjExtra (Circuit.X q) hXToff hXT hFwdSpan hBwdSpan hRest
          refine (hStep.congr_fwd fun α hα ↦ ?_)
          simp only [Submonoid.coe_mul, mul_mulVec_sub, ket_X q α, diagBitPhase_mulVec_ket,
            Matrix.mulVec_smul, ket_X_inv_152]
          have hinv := evalStep152_involutive (.x q) rfl α
          dsimp only [evalStep152] at hinv
          rw [hinv]; rfl
      | cnot c t =>
          simp only [checkFreshProg152, Bool.and_eq_true, decide_eq_true_eq] at hFresh
          rcases hFresh with ⟨hct, hFreshRest⟩
          have hClean' : ∀ w, Function.update dirty t true w = false → ∀ δ, S_mid δ → δ w = 0 := by
            intro w hw δ ⟨α, hα, hδ⟩; subst hδ
            have hwt : w ≠ t := fun h ↦ by subst h; simp at hw
            rw [Function.update_of_ne hwt] at hw
            dsimp only [evalStep152]
            rw [Function.update_of_ne hwt]
            exact hClean w hw α hα
          have hRest := ih (Function.update dirty t true) hFreshRest S_mid hClean'
          have hFwdSpan : PreservesSpanSub S S_mid (cnotIf c t) := by
            intro α hα; rw [ket_cnotIf_ne_152 c t hct α]; exact ket_mem_ketSpanSub ⟨α, hα, rfl⟩
          have hBwdSpan : PreservesSpanSub S_mid S (cnotIf c t).inverse := by
            intro δ ⟨α, hα, hδ⟩; subst hδ
            rw [ket_cnotIf_inv_ne_152 c t hct]
            have hinv := evalStep152_involutive (.cnot c t) (by simp [wfStep152, hct]) α
            dsimp only [evalStep152] at hinv ⊢
            rw [hinv]; exact ket_mem_ketSpanSub hα
          have hStep := DynPair152.withCliff hDisjExtra (cnotIf c t)
            (count_toff_cnotIf c t) (count_t_cnotIf c t) hFwdSpan hBwdSpan hRest
          refine (hStep.congr_fwd fun α hα ↦ ?_)
          simp only [Submonoid.coe_mul, mul_mulVec_sub, ket_cnotIf_ne_152 c t hct α,
            diagBitPhase_mulVec_ket, Matrix.mulVec_smul, ket_cnotIf_inv_ne_152 c t hct]
          have hinv := evalStep152_involutive (.cnot c t) (by simp [wfStep152, hct]) α
          dsimp only [evalStep152] at hinv
          rw [hinv]; rfl
      | tempAnd c1 c2 anc =>
          simp only [checkFreshProg152, Bool.and_eq_true, Bool.not_eq_true',
            decide_eq_true_eq] at hFresh
          rcases hFresh with ⟨⟨⟨⟨h12, h1a⟩, h2a⟩, hdAnc⟩, hFreshRest⟩
          have hPre0 : ∀ α, S α → α anc = 0 := hClean anc hdAnc
          have hClean' : ∀ w, Function.update dirty anc true w = false → ∀ δ, S_mid δ → δ w = 0 :=
            by
            intro w hw δ ⟨α, hα, hδ⟩; subst hδ
            have hwa : w ≠ anc := fun h ↦ by subst h; simp at hw
            rw [Function.update_of_ne hwa] at hw
            dsimp only [evalStep152]
            rw [Function.update_of_ne hwa]
            exact hClean w hw α hα
          have hRest := ih (Function.update dirty anc true) hFreshRest S_mid hClean'
          have hCompEq : compileStep152 v rFull152 (.tempAnd c1 c2 anc)
              (compileCleanProg152 v rFull152 rest body) =
              mkWithTempAndDyn152 v rFull152 c1 c2 anc h12 h1a h2a
                (compileCleanProg152 v rFull152 rest body) := by
            simp [compileStep152, h12, h1a, h2a]
          have hStep := DynPair152.withTempAnd hDisjExtra c1 c2 anc h12 h1a h2a
            hPre0
            (fun δ ⟨α, hα, hδ⟩ ↦ by
              subst hδ
              dsimp only [evalStep152]
              rw [Function.update_self, hPre0 α hα, zero_add,
                Function.update_of_ne h1a, Function.update_of_ne h2a])
            (fun α hα ↦ ⟨α, hα, by simp [evalStep152, hPre0 α hα]⟩)
            (fun δ ⟨α, hα, hδ⟩ ↦ by
              subst hδ
              have hr : Function.update (evalStep152 (.tempAnd c1 c2 anc) α) anc 0 = α := by
                funext w; by_cases hw : w = anc
                · subst hw; simp [evalStep152, hPre0 α hα]
                · dsimp only [evalStep152]; rw [Function.update_of_ne hw, Function.update_of_ne hw]
              rw [hr]; exact hα)
            hRest
          have hBudget : tB + 4 * countTempAnd152 rest + 4 =
              tB + 4 * countTempAnd152 (.tempAnd c1 c2 anc :: rest) := by
            simp [countTempAnd152]; omega
          simp only [compileCleanProg152, hCompEq]
          rw [← hBudget]
          refine hStep.congr_fwd fun α hα ↦ ?_
          simp only [Submonoid.coe_mul, mul_mulVec_sub, ket_TOFF, hPre0 α hα, zero_add]
          have hev : Function.update α anc (α c1 * α c2) = evalStep152 (.tempAnd c1 c2 anc) α := by
            simp [evalStep152, hPre0 α hα]
          rw [hev, diagBitPhase_mulVec_ket, Matrix.mulVec_smul, ket_TOFF]
          have hinv := evalStep152_involutive (.tempAnd c1 c2 anc)
            (by simp [wfStep152, h12, h1a, h2a]) α
          dsimp only [evalStep152] at hinv
          rw [show (evalStep152 (.tempAnd c1 c2 anc) α) =
              Function.update α anc (α anc + α c1 * α c2) from rfl, hinv, diagBitPhase_mulVec_ket]
          rfl


private theorem compileCleanProg152_cz_pair
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull152.DisjointWires rExtra9)
    (prog : List CleanStep152)
    (dirty : Wire 152 → Bool)
    (hFresh : checkFreshProg152 dirty prog = true)
    (S : BitAssignment 152 → Prop)
    (hClean : ∀ w : Wire 152, dirty w = false → ∀ α, S α → α w = 0)
    (c t : Wire 152) (hct : c ≠ t) :
    let d := compileCleanProg152 v rFull152 prog (.circuit ((czGate152 c t).onRegister rFull152))
    DynPair152 v rFull152 rExtra9 S (4 * countTempAnd152 prog) d d
      (diagBitPhase (fun α ↦ evalProg152 prog α c * evalProg152 prog α t)) := by
  intro d
  have hLeaf : ∀ S' : BitAssignment 152 → Prop,
      DynPair152 v rFull152 rExtra9 S' 0
        (.circuit ((czGate152 c t).onRegister rFull152))
        (.circuit ((czGate152 c t).onRegister rFull152))
        (diagBitPhase (fun δ ↦ δ c * δ t)) := by
    intro S'
    have hSpan : PreservesSpanSub S' S' (czGate152 c t) := by
      intro δ hδ
      rw [ket_czGate152 c t hct δ]
      exact (KetSpanSub S').smul_mem _ (ket_mem_ketSpanSub hδ)
    have hSq : (czGate152 c t).eval * (czGate152 c t).eval = 1 := by
      rw [czGate152_eval_eq c t hct]
      exact diagBitPhase_sq _
    have h0 := DynPair152.staticSelfInv v rFull152 rExtra9 S' (czGate152 c t)
      (count_toff_czGate152 c t) hSpan hSq
    rw [count_t_czGate152, czGate152_eval_eq c t hct] at h0
    exact h0
  have hMain := compileCleanProg152_diagPhase_pair v rFull152 rExtra9 hDisjExtra
    prog dirty hFresh S hClean (fun δ ↦ δ c * δ t) hLeaf
  rwa [Nat.zero_add] at hMain


