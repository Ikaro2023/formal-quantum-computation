theorem sum_op_pushforward_aux {α M : Type*} [DecidableEq α] [AddCommMonoid M] [Module ℂ M]
    (U : Finset α) (hU : ∀ x, x ∈ U)
    (piMap : α → α) (μ : α → ℝ) (B : α → M)
    (hB : ∀ p, B p = B (piMap p)) :
    (∑ p ∈ U, (μ p : ℂ) • B p) =
      ∑ q ∈ U, (((∑ p ∈ U.filter (fun p ↦ piMap p = q), μ p : ℝ) : ℂ) • B q) := by
  have h1 : (∑ p ∈ U, (μ p : ℂ) • B p) = ∑ p ∈ U, (μ p : ℂ) • B (piMap p) :=
    Finset.sum_congr rfl fun p _ ↦ by rw [hB p]
  rw [h1, ← Finset.sum_fiberwise_of_maps_to (g := piMap) (fun _ _ ↦ hU _)]
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  have hq : (∑ i ∈ U.filter (fun p ↦ piMap p = q), (μ i : ℂ) • B (piMap i)) =
      ∑ i ∈ U.filter (fun p ↦ piMap p = q), (μ i : ℂ) • B q :=
    Finset.sum_congr rfl fun i hi ↦ by rw [(Finset.mem_filter.mp hi).2]
  rw [hq, ← Finset.sum_smul, Complex.ofReal_sum]

theorem sum_abs_pushforward_aux {α : Type*} [DecidableEq α]
    (U : Finset α) (hU : ∀ x, x ∈ U)
    (proj : α → α) (clean : α → Prop) [DecidablePred clean]
    (w f μ_id : α → ℝ)
    (hidem : ∀ p, proj (proj p) = proj p)
    (hclean_proj : ∀ p, clean (proj p) ↔ clean p)
    (hw_nonneg : ∀ p, 0 ≤ w p)
    (hf_nonneg : ∀ r, 0 ≤ f r)
    (hw_sum : ∀ r, proj r = r → (∑ p ∈ U.filter (fun p ↦ proj p = r), w p) = 1)
    (hf_off : ∀ p, proj p ≠ p → f p = 0)
    (hid_off : ∀ p, proj p ≠ p → μ_id p = 0)
    (hid_nclean : ∀ p, ¬clean p → μ_id p = 0) :
    (∑ q ∈ U,
        (|(∑ p ∈ U.filter (fun p ↦ (if clean p then proj p else p) = q),
            w p * f (proj p)) - μ_id q|)) =
      ∑ p ∈ U, (|f p - μ_id p|) := by
  let piMap : α → α := fun p ↦ if clean p then proj p else p
  let muMid : α → ℝ :=
    fun q ↦ ∑ p ∈ U.filter (fun p ↦ piMap p = q), w p * f (proj p)
  change (∑ q ∈ U, (|muMid q - μ_id q|)) = ∑ p ∈ U, (|f p - μ_id p|)
  conv_lhs =>
    rw [← Finset.sum_fiberwise_of_maps_to (s := U) (t := U) (g := proj) (fun _ _ ↦ hU _)]
  conv_rhs =>
    rw [← Finset.sum_fiberwise_of_maps_to (s := U) (t := U) (g := proj) (fun _ _ ↦ hU _)]
  refine Finset.sum_congr rfl fun r _ ↦ ?_
  by_cases hr : proj r = r
  · have hrhs : (∑ q ∈ U.filter (fun q ↦ proj q = r), (|f q - μ_id q|)) = |f r - μ_id r| := by
      refine Finset.sum_eq_single r (fun q hq hne ↦ ?_) (fun hnr ↦ ?_)
      · rw [Finset.mem_filter] at hq
        have hpq : proj q ≠ q := fun hc ↦ hne (hc.symm.trans hq.2)
        rw [hf_off q hpq, hid_off q hpq, sub_self, abs_zero]
      · exact False.elim (hnr (Finset.mem_filter.mpr ⟨hU r, hr⟩))
    rw [hrhs]
    by_cases hcr : clean r
    · trans |muMid r - μ_id r|
      · refine Finset.sum_eq_single r (fun q hq hne ↦ ?_) (fun hnr ↦ ?_)
        · rw [Finset.mem_filter] at hq
          have hcq : clean q := (hclean_proj q).mp (hq.2.symm ▸ hcr)
          have hpq : proj q ≠ q := fun hc ↦ hne (hc.symm.trans hq.2)
          have hmid0 : muMid q = 0 := by
            refine Finset.sum_eq_zero fun p hp ↦ ?_
            rw [Finset.mem_filter] at hp
            by_cases hcp : clean p
            · have hp_eq : proj p = q := by simpa [piMap, hcp] using hp.2
              exact False.elim (hpq (by rw [← hp_eq, hidem p]))
            · have hp_eq : p = q := by simpa [piMap, hcp] using hp.2
              exact False.elim (hcp (hp_eq ▸ hcq))
          rw [hmid0, hid_off q hpq, sub_self, abs_zero]
        · exact False.elim (hnr (Finset.mem_filter.mpr ⟨hU r, hr⟩))
      · have hfilt : U.filter (fun p ↦ piMap p = r) = U.filter (fun p ↦ proj p = r) := by
          ext p
          simp only [Finset.mem_filter]
          constructor
          · rintro ⟨hpu, hp⟩
            refine ⟨hpu, ?_⟩
            by_cases hcp : clean p
            · simpa [piMap, hcp] using hp
            · have hp_eq : p = r := by simpa [piMap, hcp] using hp
              exact False.elim (hcp (hp_eq.symm ▸ hcr))
          · rintro ⟨hpu, hp⟩
            have hcp : clean p := (hclean_proj p).mp (hp.symm ▸ hcr)
            exact ⟨hpu, by simpa [piMap, hcp] using hp⟩
        have hmid_r : muMid r = f r := by
          dsimp only [muMid]
          rw [hfilt]
          have hcongr : (∑ p ∈ U.filter (fun p ↦ proj p = r), w p * f (proj p)) =
              ∑ p ∈ U.filter (fun p ↦ proj p = r), w p * f r :=
            Finset.sum_congr rfl fun p hp ↦ by rw [(Finset.mem_filter.mp hp).2]
          rw [hcongr, ← Finset.sum_mul, hw_sum r hr, one_mul]
        rw [hmid_r]
    · have hterm : ∀ q ∈ U.filter (fun q ↦ proj q = r), (|muMid q - μ_id q|) = w q * f r :=
        fun q hq ↦ by
          rw [Finset.mem_filter] at hq
          have hncq : ¬clean q := fun hcq ↦ hcr (hq.2 ▸ (hclean_proj q).mpr hcq)
          have hfilt : U.filter (fun p ↦ piMap p = q) = {q} := by
            ext p
            simp only [Finset.mem_filter, Finset.mem_singleton]
            constructor
            · rintro ⟨_, hp⟩
              by_cases hcp : clean p
              · have hp_eq : proj p = q := by simpa [piMap, hcp] using hp
                exact False.elim (hncq (hp_eq ▸ (hclean_proj p).mpr hcp))
              · simpa [piMap, hcp] using hp
            · rintro rfl
              exact ⟨hU _, by simp [piMap, hncq]⟩
          have hmid_q : muMid q = w q * f r := by
            dsimp only [muMid]
            rw [hfilt, Finset.sum_singleton, hq.2]
          rw [hmid_q, hid_nclean q hncq, sub_zero,
            abs_of_nonneg (mul_nonneg (hw_nonneg q) (hf_nonneg r))]
      rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul, hw_sum r hr, one_mul,
        hid_nclean r hcr, sub_zero, abs_of_nonneg (hf_nonneg r)]
  · have hemp : U.filter (fun q ↦ proj q = r) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro q _ hqr
      exact hr (by rw [← hqr, hidem q])
    rw [hemp, Finset.sum_empty, Finset.sum_empty]

theorem sum_abs_pushforward_eq_Bhmt
    (proj : BitAssignment 80 → BitAssignment 80)
    (clean : BitAssignment 80 → Prop) [DecidablePred clean]
    (w f μ_id : BitAssignment 80 → ℝ)
    (hidem : ∀ p, proj (proj p) = proj p)
    (hclean_proj : ∀ p, clean (proj p) ↔ clean p)
    (hw_nonneg : ∀ p, 0 ≤ w p)
    (hf_nonneg : ∀ r, 0 ≤ f r)
    (hw_sum : ∀ r, proj r = r → (∑ p ∈ Finset.univ.filter (fun p ↦ proj p = r), w p) = 1)
    (hf_off : ∀ p, proj p ≠ p → f p = 0)
    (hid_off : ∀ p, proj p ≠ p → μ_id p = 0)
    (hid_nclean : ∀ p, ¬clean p → μ_id p = 0) :
    (∑ q : BitAssignment 80,
        (|(∑ p ∈ Finset.univ.filter (fun p ↦ (if clean p then proj p else p) = q),
            w p * f (proj p)) - μ_id q|)) =
      ∑ p : BitAssignment 80, (|f p - μ_id p|) :=
  sum_abs_pushforward_aux Finset.univ Finset.mem_univ proj clean w f μ_id
    hidem hclean_proj hw_nonneg hf_nonneg hw_sum hf_off hid_off hid_nclean

noncomputable def clrMaskBhmt (mask : Fin 80 → Bool) (p : BitAssignment 80) : BitAssignment 80 :=
  fun i ↦ if mask i = true then 0 else p i

noncomputable def fillBitsBhmt (mask : Fin 80 → Bool) (r : BitAssignment 80)
    (g : {i : Fin 80 // mask i = true} → ZMod 2) : BitAssignment 80 :=
  fun i ↦ if h : mask i = true then g ⟨i, h⟩ else r i

theorem card_filter_clrMask_aux
    (U : Finset (BitAssignment 80)) (hU : ∀ x, x ∈ U)
    (V : (mask : Fin 80 → Bool) → Finset ({i : Fin 80 // mask i = true} → ZMod 2))
    (hV : ∀ mask g, g ∈ V mask)
    (mask : Fin 80 → Bool) (r : BitAssignment 80)
    (hr : ∀ i : Fin 80, mask i = true → r i = 0) :
    (U.filter (fun p : BitAssignment 80 ↦ clrMaskBhmt mask p = r)).card =
      (V mask).card := by
  symm
  refine Finset.card_bij (fun g _ ↦ fillBitsBhmt mask r g)
    (fun g _ ↦ ?_) (fun g₁ _ g₂ _ heq ↦ ?_) (fun p hp ↦ ?_)
  · rw [Finset.mem_filter]
    refine ⟨hU _, funext fun i ↦ ?_⟩
    unfold clrMaskBhmt fillBitsBhmt
    by_cases hi : mask i = true
    · simp [hi, hr i hi]
    · simp [hi]
  · funext ⟨i, hi⟩
    have h1 := congrFun heq i
    simpa [fillBitsBhmt, hi] using h1
  · rw [Finset.mem_filter] at hp
    refine ⟨fun x ↦ p x.1, hV mask _, funext fun i ↦ ?_⟩
    unfold fillBitsBhmt
    by_cases hi : mask i = true
    · simp [hi]
    · have hp_i := congrFun hp.2 i
      unfold clrMaskBhmt at hp_i
      simp only [hi, Bool.false_eq_true, ↓reduceDIte, ↓reduceIte] at hp_i ⊢
      exact hp_i.symm

private theorem card_filter_clrMask_Bhmt (mask : Fin 80 → Bool) (r : BitAssignment 80)
    (hr : ∀ i : Fin 80, mask i = true → r i = 0) :
    (Finset.univ.filter (fun p : BitAssignment 80 ↦ clrMaskBhmt mask p = r)).card =
      2 ^ (Finset.univ.filter (fun i : Fin 80 ↦ mask i = true)).card := by
  have hbij : (Finset.univ.filter (fun p : BitAssignment 80 ↦ clrMaskBhmt mask p = r)).card =
      (Finset.univ : Finset ({i : Fin 80 // mask i = true} → ZMod 2)).card :=
    card_filter_clrMask_aux Finset.univ Finset.mem_univ (fun _ ↦ Finset.univ)
      (fun _ _ ↦ Finset.mem_univ _) mask r hr
  rw [hbij, Finset.card_univ, Fintype.card_fun, ZMod.card, Fintype.card_subtype]



theorem projBhmt_at30 (s0 : Bool) (p : BitAssignment 80) :
    projBhmt s0 p 30 = p 30 := by
  unfold projBhmt
  cases s0 <;> simp only [Bool.false_eq_true, ↓reduceIte] <;>
    split_ifs <;> simp [p80ClearRange, clrPid12_80, p80ClearB0Local]


theorem projBhmt_at62 (s0 : Bool) (p : BitAssignment 80) :
    projBhmt s0 p 62 = p 62 := by
  unfold projBhmt
  cases s0 <;> simp only [Bool.false_eq_true, ↓reduceIte] <;>
    split_ifs <;> simp [p80ClearRange, clrPid12_80, p80ClearB0Local]


theorem projBhmt_false_nuc_sub (p : BitAssignment 80) :
    (fun j : Fin 8 ↦ projBhmt false p (pos80SubIdx 6 8 (by decide) j)) =
      fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j) := by
  funext j
  unfold projBhmt
  simp only [Bool.false_eq_true, ↓reduceIte]
  split_ifs
  · unfold p80ClearRange; exact ite_eq_right (by dsimp [pos80SubIdx]; omega)
  · unfold p80ClearB0Local p80ClearRange
    rw [ite_eq_right (by dsimp [pos80SubIdx]; omega), ite_eq_right (by dsimp [pos80SubIdx]; omega)]
  · dsimp only [clrPid12_80]
    rw [Function.update_of_ne (by
      intro h; have := congrArg Fin.val h; dsimp [pos80SubIdx] at this; omega),
      Function.update_of_ne (by
        intro h; have := congrArg Fin.val h; dsimp [pos80SubIdx] at this; omega)]
  · unfold p80ClearB0Local
    rw [ite_eq_right (by dsimp [pos80SubIdx]; omega)]
    dsimp only [clrPid12_80]
    rw [Function.update_of_ne (by
      intro h; have := congrArg Fin.val h; dsimp [pos80SubIdx] at this; omega),
      Function.update_of_ne (by
        intro h; have := congrArg Fin.val h; dsimp [pos80SubIdx] at this; omega)]


def maskS4HeadBhmt : Fin 80 → Bool := fun i ↦ decide (6 ≤ i.val ∧ i.val < 8)

def maskTail2Bhmt : Fin 80 → Bool := fun i ↦ decide (i.val = 70 ∨ i.val = 71)

def maskS2HeadHiBhmt : Fin 80 → Bool := fun i ↦ decide (14 ≤ i.val ∧ i.val < 21)

def maskS2HeadLoBhmt : Fin 80 → Bool := fun i ↦
  decide ((3 ≤ i.val ∧ i.val < 6) ∨ (14 ≤ i.val ∧ i.val < 21))

def maskS2TailLoBhmt : Fin 80 → Bool := fun i ↦
  decide ((3 ≤ i.val ∧ i.val < 6) ∨ i.val = 70 ∨ i.val = 71)


theorem clrMask_eqs_Bhmt (p : BitAssignment 80) :
    p80ClearRange 6 2 p = clrMaskBhmt maskS4HeadBhmt p ∧
    clrPid12_80 p = clrMaskBhmt maskTail2Bhmt p ∧
    p80ClearRange 14 7 p = clrMaskBhmt maskS2HeadHiBhmt p ∧
    p80ClearB0Local (p80ClearRange 14 7 p) = clrMaskBhmt maskS2HeadLoBhmt p ∧
    p80ClearB0Local (clrPid12_80 p) = clrMaskBhmt maskS2TailLoBhmt p := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · funext i; unfold p80ClearRange clrMaskBhmt maskS4HeadBhmt; simp
  · funext i
    unfold clrPid12_80 clrMaskBhmt maskTail2Bhmt
    by_cases h71 : i = 71
    · subst h71; simp
    · by_cases h70 : i = 70
      · subst h70; simp
      · have hne70 : i.val ≠ 70 := fun h ↦ h70 (Fin.ext h)
        have hne71 : i.val ≠ 71 := fun h ↦ h71 (Fin.ext h)
        simp [h70, h71, hne70, hne71]
  · funext i; unfold p80ClearRange clrMaskBhmt maskS2HeadHiBhmt; simp
  · funext i
    unfold p80ClearB0Local p80ClearRange clrMaskBhmt maskS2HeadLoBhmt
    by_cases h1 : 3 ≤ i.val ∧ i.val < 6 <;>
      by_cases h2 : 14 ≤ i.val ∧ i.val < 21 <;> simp [h1, h2]
  · funext i
    unfold p80ClearB0Local clrPid12_80 clrMaskBhmt maskS2TailLoBhmt
    by_cases h71 : i = 71
    · subst h71; simp
    · by_cases h70 : i = 70
      · subst h70; simp
      · have hne70 : i.val ≠ 70 := fun h ↦ h70 (Fin.ext h)
        have hne71 : i.val ≠ 71 := fun h ↦ h71 (Fin.ext h)
        by_cases h1 : 3 ≤ i.val ∧ i.val < 6 <;> simp [h1, h70, h71, hne70, hne71]


theorem clrMask_idem_Bhmt (mask : Fin 80 → Bool) (p : BitAssignment 80) :
    clrMaskBhmt mask (clrMaskBhmt mask p) = clrMaskBhmt mask p := by
  funext i; unfold clrMaskBhmt; split_ifs <;> rfl


theorem projBhmt_idem (s0 : Bool) (p : BitAssignment 80) :
    projBhmt s0 (projBhmt s0 p) = projBhmt s0 p := by
  have h30 := projBhmt_at30 s0 p
  cases s0
  · have hnuc := projBhmt_false_nuc_sub p
    conv_lhs => rw [projBhmt]
    simp only [Bool.false_eq_true, ↓reduceIte, h30, hnuc]
    unfold projBhmt
    simp only [Bool.false_eq_true, ↓reduceIte]
    by_cases hp30 : (p 30 == 1) = true <;>
      by_cases h216 : ((Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
        p (pos80SubIdx 6 8 (by decide) j)) &&& 216) == 216) = true <;>
      simp only [hp30, h216, Bool.false_eq_true, ↓reduceIte]
    · rw [(clrMask_eqs_Bhmt p).2.2.1, (clrMask_eqs_Bhmt _).2.2.1, clrMask_idem_Bhmt]
    · rw [(clrMask_eqs_Bhmt p).2.2.2.1, (clrMask_eqs_Bhmt _).2.2.2.1, clrMask_idem_Bhmt]
    · rw [(clrMask_eqs_Bhmt p).2.1, (clrMask_eqs_Bhmt _).2.1, clrMask_idem_Bhmt]
    · rw [(clrMask_eqs_Bhmt p).2.2.2.2, (clrMask_eqs_Bhmt _).2.2.2.2, clrMask_idem_Bhmt]
  · conv_lhs => rw [projBhmt]
    simp only [↓reduceIte, h30]
    unfold projBhmt
    simp only [↓reduceIte]
    by_cases hp30 : (p 30 == 1) = true <;> simp only [hp30, Bool.false_eq_true, ↓reduceIte]
    · rw [(clrMask_eqs_Bhmt p).1, (clrMask_eqs_Bhmt _).1, clrMask_idem_Bhmt]
    · rw [(clrMask_eqs_Bhmt p).2.1, (clrMask_eqs_Bhmt _).2.1, clrMask_idem_Bhmt]


theorem fiberWeightBhmt_nonneg (s0 : Bool) (p : BitAssignment 80) :
    0 ≤ fiberWeightBhmt s0 p := by
  unfold fiberWeightBhmt; dsimp only; split_ifs <;> norm_num


theorem muActualFactor80_true_nonneg (s0 : Bool) (r : BitAssignment 80) :
    0 ≤ muActualFactor80 true s0 r := by
  unfold muActualFactor80
  dsimp only
  simp only [← norm_sq_muxHeadBhmtAmp, ← norm_sq_muxTailBhmtAmp]
  split_ifs <;> positivity

private theorem sum_const_clrMask_eq_one_Bhmt (mask : Fin 80 → Bool) (w : ℝ) (r : BitAssignment 80)
    (hr : clrMaskBhmt mask r = r)
    (hw : ((2 ^ (Finset.univ.filter (fun i : Fin 80 ↦ mask i = true)).card : ℕ) : ℝ) * w = 1) :
    (∑ _p ∈ Finset.univ.filter (fun p : BitAssignment 80 ↦ clrMaskBhmt mask p = r), w) = 1 := by
  have hzero : ∀ i : Fin 80, mask i = true → r i = 0 := fun i hi ↦ by
    rw [← hr]; unfold clrMaskBhmt; simp [hi]
  rw [Finset.sum_const, nsmul_eq_mul, card_filter_clrMask_Bhmt mask r hzero, hw]


private theorem sum_fiberWeightBhmt_aux
    (U : Finset (BitAssignment 80)) (hU : ∀ p, p ∈ U)
    (s0 : Bool) (r : BitAssignment 80) (hr : projBhmt s0 r = r)
    (hsum : ∀ (mask : Fin 80 → Bool) (w : ℝ) (r : BitAssignment 80),
      clrMaskBhmt mask r = r →
      ((2 ^ (Finset.univ.filter (fun i : Fin 80 ↦ mask i = true)).card : ℕ) : ℝ) * w = 1 →
      (∑ _p ∈ U.filter (fun p : BitAssignment 80 ↦ clrMaskBhmt mask p = r), w) = 1) :
    (∑ p ∈ U.filter (fun p ↦ projBhmt s0 p = r), fiberWeightBhmt s0 p) = 1 := by
  have hSame30 : ∀ p, projBhmt s0 p = r → p 30 = r 30 := fun p hp ↦ by
    rw [← projBhmt_at30 s0 p, hp]
  cases s0
  · have hSameNuc : ∀ p, projBhmt false p = r →
        Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j)) =
          Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ r (pos80SubIdx 6 8 (by decide) j)) :=
      fun p hp ↦ by rw [← projBhmt_false_nuc_sub p, hp]
    have hcongr : (∑ p ∈ U.filter (fun p ↦ projBhmt false p = r), fiberWeightBhmt false p) =
        ∑ _p ∈ U.filter (fun p ↦ projBhmt false p = r), fiberWeightBhmt false r :=
      Finset.sum_congr rfl fun p hp ↦ by
        have hp' := (Finset.mem_filter.mp hp).2
        unfold fiberWeightBhmt
        simp only [Bool.false_eq_true, ↓reduceIte, hSame30 p hp', hSameNuc p hp']
    rw [hcongr]
    by_cases hr30 : (r 30 == 1) = true <;>
      by_cases h216 : ((Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
        r (pos80SubIdx 6 8 (by decide) j)) &&& 216) == 216) = true
    · have hf : U.filter (fun p ↦ projBhmt false p = r) =
          U.filter (fun p ↦ clrMaskBhmt maskS2HeadHiBhmt p = r) := by
        ext p; simp only [Finset.mem_filter, hU p, true_and]
        constructor
        · intro hp
          have hp30 : (p 30 == 1) = true := hSame30 p hp ▸ hr30
          have hp216 : ((Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
            p (pos80SubIdx 6 8 (by decide) j)) &&& 216) == 216) = true :=
            hSameNuc p hp ▸ h216
          unfold projBhmt at hp
          simp only [Bool.false_eq_true, ↓reduceIte, hp30, hp216, (clrMask_eqs_Bhmt p).2.2.1] at hp
          exact hp
        · intro hp
          have hp30 : (p 30 == 1) = true := by
            have :=
              congrFun hp 30; unfold clrMaskBhmt maskS2HeadHiBhmt at this; rw [ite_eq_right (by
                decide)]
              at this; rwa [this]
          have hnuc : (fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j)) =
              fun j : Fin 8 ↦ r (pos80SubIdx 6 8 (by decide) j) := by
            funext j; have := congrFun hp (pos80SubIdx 6 8 (by decide) j)
            unfold clrMaskBhmt maskS2HeadHiBhmt at this
            rwa [ite_eq_right (by
              rw [decide_eq_true_eq]; dsimp only [pos80SubIdx]; have := j.isLt; omega)] at this
          unfold projBhmt
          simp only [Bool.false_eq_true, ↓reduceIte, hp30, hnuc, h216, (clrMask_eqs_Bhmt p).2.2.1,
            hp]
      have hmr : clrMaskBhmt maskS2HeadHiBhmt r = r := by
        unfold projBhmt at hr; simp only [Bool.false_eq_true, ↓reduceIte, hr30, h216,
          (clrMask_eqs_Bhmt r).2.2.1] at hr; exact hr
      have hw : fiberWeightBhmt false r = (1 / 128 : ℝ) := by
        unfold fiberWeightBhmt; simp [hr30, h216]
      have hcard : (Finset.univ.filter (fun i : Fin 80 ↦ maskS2HeadHiBhmt i = true)).card = 7 := by
        rw [Finset.card_filter, ← Fintype.sum_equiv fin80Split16.symm _ (fun i ↦
          if maskS2HeadHiBhmt i = true then 1 else 0) (fun _ ↦ rfl), Fintype.sum_prod_type]; decide
      rw [hf, hw]
      exact hsum maskS2HeadHiBhmt (1 / 128 : ℝ) r hmr (by rw [hcard]; norm_num)
    · have hf : U.filter (fun p ↦ projBhmt false p = r) =
          U.filter (fun p ↦ clrMaskBhmt maskS2HeadLoBhmt p = r) := by
        ext p; simp only [Finset.mem_filter, hU p, true_and]
        constructor
        · intro hp
          have hp30 : (p 30 == 1) = true := hSame30 p hp ▸ hr30
          have hp216 : ¬(((Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
            p (pos80SubIdx 6 8 (by decide) j)) &&& 216) == 216) = true) :=
            hSameNuc p hp ▸ h216
          unfold projBhmt at hp
          simp only [Bool.false_eq_true, ↓reduceIte, hp30, hp216,
            (clrMask_eqs_Bhmt p).2.2.2.1] at hp
          exact hp
        · intro hp
          have hp30 : (p 30 == 1) = true := by
            have :=
              congrFun hp 30; unfold clrMaskBhmt maskS2HeadLoBhmt at this; rw [ite_eq_right (by
                decide)]
              at this; rwa [this]
          have hnuc : (fun j : Fin 8 ↦ p (pos80SubIdx 6 8 (by decide) j)) =
              fun j : Fin 8 ↦ r (pos80SubIdx 6 8 (by decide) j) := by
            funext j; have := congrFun hp (pos80SubIdx 6 8 (by decide) j)
            unfold clrMaskBhmt maskS2HeadLoBhmt at this
            rwa [ite_eq_right (by
              rw [decide_eq_true_eq]; dsimp only [pos80SubIdx]; have := j.isLt; omega)] at this
          unfold projBhmt
          simp only [Bool.false_eq_true, ↓reduceIte, hp30, hnuc, h216, (clrMask_eqs_Bhmt p).2.2.2.1,
            hp]
      have hmr : clrMaskBhmt maskS2HeadLoBhmt r = r := by
        unfold projBhmt at hr; simp only [Bool.false_eq_true, ↓reduceIte, hr30, h216,
          (clrMask_eqs_Bhmt r).2.2.2.1] at hr; exact hr
      have hw : fiberWeightBhmt false r = (1 / 1024 : ℝ) := by
        unfold fiberWeightBhmt; simp [hr30, h216]
      have hcard : (Finset.univ.filter (fun i : Fin 80 ↦ maskS2HeadLoBhmt i = true)).card = 10 := by
        rw [Finset.card_filter, ← Fintype.sum_equiv fin80Split16.symm _ (fun i ↦
          if maskS2HeadLoBhmt i = true then 1 else 0) (fun _ ↦ rfl), Fintype.sum_prod_type]; decide
      rw [hf, hw]
      exact hsum maskS2HeadLoBhmt (1 / 1024 : ℝ) r hmr (by rw [hcard]; norm_num)
    · have hf : U.filter (fun p ↦ projBhmt false p = r) =
          U.filter (fun p ↦ clrMaskBhmt maskTail2Bhmt p = r) := by
        ext p; simp only [Finset.mem_filter, hU p, true_and]
        constructor
        · intro hp
          have hp30 : ¬((p 30 == 1) = true) := hSame30 p hp ▸ hr30
          have hp216 : ((Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦
            p (pos80SubIdx 6 8 (by decide) j)) &&& 216) == 216) = true :=
            hSameNuc p hp ▸ h216
          unfold projBhmt at hp
          simp only [Bool.false_eq_true, ↓reduceIte, hp30, hp216, (clrMask_eqs_Bhmt p).2.1] at hp
          exact hp
        · intro hp
          have hp30 : ¬((p 30 == 1) = true) := by
            have := congrFun hp 30
            unfold clrMaskBhmt maskTail2Bhmt at this
            rw [ite_eq_right (by decide)] at this; rwa [this]
