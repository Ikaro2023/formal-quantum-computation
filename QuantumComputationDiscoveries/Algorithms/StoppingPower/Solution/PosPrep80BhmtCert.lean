def fin32Split16 : Fin (2 ^ 5) ≃ Fin 2 × Fin 16 where
  toFun x := (⟨x.val / 16, by omega⟩, ⟨x.val % 16, by omega⟩)
  invFun p := ⟨p.1.val * 16 + p.2.val, by omega⟩
  left_inv x := Fin.ext (by dsimp; omega)
  right_inv p := Prod.ext (Fin.ext (by dsimp; omega)) (Fin.ext (by dsimp; omega))

