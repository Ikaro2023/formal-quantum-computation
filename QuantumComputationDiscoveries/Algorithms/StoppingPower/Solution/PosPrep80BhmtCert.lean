    · rw [hUnchanged _ (by right; right; decide),
        hUnchanged _ (by right; right; decide),
        hUnchanged _ (by right; right; decide),
        hUnchanged _ (by right; left; rfl), e7]
    · rw [hUnchanged _ (by right; right; decide), e8]
