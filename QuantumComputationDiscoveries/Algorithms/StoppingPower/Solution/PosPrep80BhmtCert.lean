noncomputable def eJoint49 :
    ZMod 2 × Data48Tuple ≃ BitAssignment 16 × BitAssignment 33 where
  toFun
    | (bAnc0, (b1, fine, ancHi, nuc)) =>
      (fun i ↦
        if h8 : i.val < 8 then basisBits 8 nuc ⟨i.val, h8⟩
        else if i.val = 8 then bAnc0
        else basisBits 7 ancHi ⟨i.val - 9, by omega⟩,
       fun i ↦
        if h3 : i.val < 3 then basisBits 3 b1 ⟨i.val, h3⟩
        else basisBits 30 fine ⟨i.val - 3, by omega⟩)
  invFun
    | (qJ16, qJ) =>
      (qJ16 ⟨8, by decide⟩,
       ((basisBitsEquiv 3).symm (fun j ↦ qJ ⟨j.val, by omega⟩),
        (basisBitsEquiv 30).symm (fun j ↦ qJ ⟨j.val + 3, by omega⟩),
        (basisBitsEquiv 7).symm (fun j ↦ qJ16 ⟨j.val + 9, by omega⟩),
        (basisBitsEquiv 8).symm (fun j ↦ qJ16 ⟨j.val, by omega⟩)))
  left_inv := by
    rintro ⟨bAnc0, ⟨b1, fine, ancHi, nuc⟩⟩
    dsimp only
    have hb1 : (fun j : Fin 3 ↦
        if h3 : j.val < 3 then basisBits 3 b1 ⟨j.val, h3⟩
        else basisBits 30 fine ⟨j.val - 3, by omega⟩) = basisBits 3 b1 := by
      funext j; rw [dite_eq_left j.isLt]
    have hfine : (fun j : Fin 30 ↦
        if h3 : j.val + 3 < 3 then basisBits 3 b1 ⟨j.val + 3, h3⟩
        else basisBits 30 fine ⟨(j.val + 3) - 3, by omega⟩) = basisBits 30 fine := by
      funext j; rw [dite_eq_right (by omega)]; congr 1
    have hanc : (fun j : Fin 7 ↦
        if h8 : j.val + 9 < 8 then basisBits 8 nuc ⟨j.val + 9, h8⟩
        else if j.val + 9 = 8 then bAnc0
        else basisBits 7 ancHi ⟨(j.val + 9) - 9, by omega⟩) = basisBits 7 ancHi := by
      funext j; rw [dite_eq_right (by omega), ite_eq_right (by omega)]; congr 1
    have hnuc : (fun j : Fin 8 ↦
        if h8 : j.val < 8 then basisBits 8 nuc ⟨j.val, h8⟩
        else if j.val = 8 then bAnc0
        else basisBits 7 ancHi ⟨j.val - 9, by omega⟩) = basisBits 8 nuc := by
      funext j; rw [dite_eq_left j.isLt]
    rw [hb1, hfine, hanc, hnuc]
    have e3 : (basisBitsEquiv 3).symm (basisBits 3 b1) = b1 :=
      (basisBitsEquiv 3).symm_apply_apply b1
    have e30 : (basisBitsEquiv 30).symm (basisBits 30 fine) = fine :=
      (basisBitsEquiv 30).symm_apply_apply fine
    have e7 : (basisBitsEquiv 7).symm (basisBits 7 ancHi) = ancHi :=
      (basisBitsEquiv 7).symm_apply_apply ancHi
    have e8 : (basisBitsEquiv 8).symm (basisBits 8 nuc) = nuc :=
      (basisBitsEquiv 8).symm_apply_apply nuc
    rw [e3, e30, e7, e8]
    simp
  right_inv := by
    rintro ⟨qJ16, qJ⟩
    dsimp only
    have e3 : ∀ q : BitAssignment 3, basisBits 3 ((basisBitsEquiv 3).symm q) = q :=
      (basisBitsEquiv 3).apply_symm_apply
    have e30 : ∀ q : BitAssignment 30, basisBits 30 ((basisBitsEquiv 30).symm q) = q :=
      (basisBitsEquiv 30).apply_symm_apply
    have e7 : ∀ q : BitAssignment 7, basisBits 7 ((basisBitsEquiv 7).symm q) = q :=
      (basisBitsEquiv 7).apply_symm_apply
    have e8 : ∀ q : BitAssignment 8, basisBits 8 ((basisBitsEquiv 8).symm q) = q :=
      (basisBitsEquiv 8).apply_symm_apply
    rw [e3, e30, e7, e8]
    refine Prod.ext (funext fun i ↦ ?_) (funext fun i ↦ ?_)
    · dsimp only
      by_cases h8 : i.val < 8
      · rw [dite_eq_left h8]
      · rw [dite_eq_right h8]
        by_cases h8eq : i.val = 8
        · rw [ite_eq_left h8eq]; congr 1; ext; exact h8eq.symm
        · rw [ite_eq_right h8eq]; congr 1; ext; dsimp; omega
    · dsimp only
      by_cases h3 : i.val < 3
      · rw [dite_eq_left h3]
      · rw [dite_eq_right h3]; congr 1; ext; dsimp; omega


