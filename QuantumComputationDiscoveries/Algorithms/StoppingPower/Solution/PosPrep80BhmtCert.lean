theorem mkRFull152_disjoint_rExtra9 {n : ℕ}
    (rAct86 : QRegister 86 n) (rWork : QRegister 128 n)
    (hDisj86 : rAct86.DisjointWires rWork) :
    (rAct86.concat (rWork.slice 0 66 (by decide)) (hDisj86.compose_right _)).DisjointWires
      (rWork.slice 66 9 (by decide)) := by
  rw [QRegister.disjoint_iff]
  intro idx j
  by_cases hi86 : idx.val < 86
  · let i : Fin 86 := ⟨idx.val, hi86⟩
    have hidx : idx = Fin.castAdd 66 i := by ext; rfl
    rw [hidx]
    intro h
    rw [QRegister.concat_apply_left, QRegister.slice_apply] at h
    exact hDisj86.ne i _ h
  · let k : Fin 66 := ⟨idx.val - 86, by omega⟩
    have hidx : idx = Fin.natAdd 86 k := by
      ext; change idx.val = 86 + (idx.val - 86); omega
    rw [hidx]
    intro h
    rw [QRegister.concat_apply_right, QRegister.slice_apply, QRegister.slice_apply] at h
    have hv := congrArg Fin.val (rWork.wires.injective h)
    dsimp at hv; omega


theorem rFull152_compose_rCleanAct0 {n : ℕ}
    (rAct86 : QRegister 86 n) (rWork : QRegister 128 n)
