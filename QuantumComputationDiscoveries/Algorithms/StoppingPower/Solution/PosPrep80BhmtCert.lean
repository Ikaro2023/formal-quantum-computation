private theorem RealizesCleanUnitary.andUncompute_diag
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (c₁ c₂ anc : Wire n)
    (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    (S_mid : BitAssignment n → Prop)
    (hMidEq : ∀ δ, S_mid δ → δ anc = δ c₁ * δ c₂) :
    RealizesCleanUnitary v (diagProj S_mid)
      (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂)
      (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval := by
  let T_anc := (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval
  let P₀ := (QRegister.singleton anc).basisOutcomeProjector 0
  let P_mid := diagProj S_mid
  have hP₀_herm : P₀ᴴ = P₀ := QRegister.basisOutcomeProjector_conjTranspose _ 0
  have hPmid_herm : P_midᴴ = P_mid := diagProj_conjTranspose S_mid
  have hT_sq : T_anc * T_anc = 1 := toffoli_eval_sq c₁ c₂ anc h₁₂ h₁a h₂a
  have hT_inv : T_anc⁻¹ = T_anc := inv_eq_of_mul_eq_one_right hT_sq
  have hT_herm : T_anc.1ᴴ = T_anc.1 := by
    have h1 : (T_anc⁻¹).1 = T_anc.1ᴴ := by
      simp [Matrix.star_eq_conjTranspose]
    rw [← h1, hT_inv]
  have hT_herm_sq : T_anc.1ᴴ * T_anc.1ᴴ = 1 := by
    rw [hT_herm, ← Submonoid.coe_mul, hT_sq, Submonoid.coe_one]
  have hP₀_TM : P₀ * (T_anc.1 * P_mid) = T_anc.1 * P_mid := by
    apply matrix_ext_ket; intro δ
    simp only [P₀, P_mid, T_anc, mul_mulVec_prog, diagProj_mulVec_ket]
    by_cases hs : S_mid δ
    · have hz : δ anc + δ c₁ * δ c₂ = 0 := by
        rw [hMidEq δ hs, CharTwo.add_self_eq_zero]
      simp only [hs, ↓reduceIte, ket_TOFF, hz, ket_projector_zero, Function.update_self]
    · simp only [hs, ↓reduceIte, Matrix.mulVec_zero]
  have hMT_P₀ : (P_mid * T_anc.1ᴴ) * P₀ = P_mid * T_anc.1ᴴ := by
    have h := congrArg conjTranspose hP₀_TM
    simpa [conjTranspose_mul, hP₀_herm, hPmid_herm, hT_herm, ← Matrix.mul_assoc] using h
  refine ⟨fun Ψ _ σ val ↦ wp_andUncompute_update_self v c₁ c₂ anc h₁₂ Ψ σ val, fun Θ hΘ σ ↦ ?_⟩
  let Ψ := wp (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile Θ
  have hstep : ((wpQAssignCompat T_anc Ψ σ).1).conj P₀ = (Θ σ).1.conj P₀ :=
    congrArg Subtype.val (congrFun
      (_root_.DynamicCircuit.restrictToZeroAncilla_qAssign_toffoli_wp_andUncompute_of_update_eq
        v c₁ c₂ anc h₁₂ h₁a h₂a Θ hΘ) σ)
  change ((Ψ σ).1).conj P_mid = ((wpQAssignCompat T_anc Θ σ).1).conj P_mid
  calc ((Ψ σ).1).conj P_mid
      = ((Ψ σ).1).conj (P_mid * (T_anc.1ᴴ * T_anc.1ᴴ)) := by
          rw [hT_herm_sq, Matrix.mul_one]
    _ = ((Ψ σ).1).conj (((P_mid * T_anc.1ᴴ) * P₀) * T_anc.1ᴴ) := by
          rw [hMT_P₀, Matrix.mul_assoc]
    _ = (((wpQAssignCompat T_anc Ψ σ).1).conj P₀).conj (P_mid * T_anc.1ᴴ) := by
          simp [wpQAssignCompat, qAssignObsMap, Observable.conj_coe, Unitary.coe_star,
            Matrix.star_eq_conjTranspose, conj_conj, Matrix.mul_assoc]
    _ = ((Θ σ).1.conj P₀).conj (P_mid * T_anc.1ᴴ) := by rw [hstep]
    _ = (Θ σ).1.conj ((P_mid * T_anc.1ᴴ) * P₀) := by rw [conj_conj]
    _ = ((wpQAssignCompat T_anc Θ σ).1).conj P_mid := by
          rw [hMT_P₀]
          simp [wpQAssignCompat, qAssignObsMap, Observable.conj_coe, Unitary.coe_star,
            Matrix.star_eq_conjTranspose, conj_conj]

/-! ### 2. `0-T` Uncompute (`CleanComputeProg.closeDyn`) for Any `CleanComputeProg` -/


/-- Zero-T uncompute circuit for a `CleanComputeProg` on a 128-wire register. -/
def closeDyn
    {Var : Type} {n : ℕ} (p : CleanComputeProg) (v : Var) (rFull128 : QRegister 128 n) :
    DynamicCircuit Var n :=
  match p with
  | .id => .circuit .identity
  | .x q => .circuit ((Circuit.X q).inverse.onRegister rFull128)
  | .cnot c t => .circuit ((cnotIf c t).inverse.onRegister rFull128)
  | .tempAnd c₁ c₂ anc =>
      if h : c₁ ≠ c₂ ∧ c₁ ≠ anc ∧ c₂ ≠ anc then
        DynamicCircuit.andUncompute v (rFull128 c₁) (rFull128 c₂) (rFull128 anc)
          (rFull128.wires.injective.ne h.1)
      else
        .circuit .identity
  | .seq p₁ p₂ => .seq (closeDyn p₂ v rFull128) (closeDyn p₁ v rFull128)


theorem count_toff_closeDyn {Var : Type} {n : ℕ} (p : CleanComputeProg)
    (v : Var) (rFull128 : QRegister 128 n) :
    (closeDyn p v rFull128).count PrimitiveGate.TOFF = 0 := by
  induction p with
  | id => rfl
  | x q =>
      dsimp only [closeDyn, DynamicCircuit.count]
      rw [Circuit.count_onRegister, circuit_inverse_count_TOFF]
      rfl
  | cnot c t =>
      simp [closeDyn, Circuit.count_onRegister, count_toff_cnotIf]
  | tempAnd c₁ c₂ anc =>
      dsimp only [closeDyn]
      split_ifs <;> simp [DynamicCircuit.count, DynamicCircuit.count_andUncompute_toff]
  | seq p₁ p₂ ih₁ ih₂ =>
      simp [closeDyn, ih₁, ih₂]


theorem count_t_closeDyn {Var : Type} {n : ℕ} (p : CleanComputeProg)
    (v : Var) (rFull128 : QRegister 128 n) :
    (closeDyn p v rFull128).count PrimitiveGate.T = 0 := by
  induction p with
  | id => rfl
  | x q =>
      dsimp only [closeDyn, DynamicCircuit.count]
      rw [Circuit.count_onRegister, circuit_inverse_count_T]
      rfl
  | cnot c t =>
      simp [closeDyn, Circuit.count_onRegister, count_t_cnotIf]
  | tempAnd c₁ c₂ anc =>
      dsimp only [closeDyn]
      split_ifs <;> simp [DynamicCircuit.count, DynamicCircuit.count_andUncompute_t]
  | seq p₁ p₂ ih₁ ih₂ =>
      simp [closeDyn, ih₁, ih₂]


theorem store_closeDyn {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    (p : CleanComputeProg) (v : Var) (rFull128 : QRegister 128 n) :
    PreservesStoreConst (closeDyn p v rFull128) := by
  induction p with
  | id => exact PreservesStoreConst.circuit _
  | x _ => exact PreservesStoreConst.circuit _
  | cnot _ _ => exact PreservesStoreConst.circuit _
  | tempAnd c₁ c₂ anc =>
      dsimp only [closeDyn]
      split_ifs with h
      · exact PreservesStoreConst.andUncompute v _ _ _ (rFull128.wires.injective.ne h.1)
      · exact PreservesStoreConst.circuit _
  | seq p₁ p₂ ih₁ ih₂ => exact PreservesStoreConst.seq ih₂ ih₁


private theorem closeDyn_spec {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    {v : Var} {rFull128 : QRegister 128 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (p : CleanComputeProg) (clean : List (Wire 128)) (S : BitAssignment 128 → Prop)
    (hResp : RespectsClean clean S) (hOk : (p.checkProg clean).1 = true) :
    diagProj (p.PostInv S) * (p.toCircuit.eval.1 * diagProj S) =
      p.toCircuit.eval.1 * diagProj S ∧
    diagProj S * (p.toCircuit.inverse.eval.1 * diagProj (p.PostInv S)) =
      p.toCircuit.inverse.eval.1 * diagProj (p.PostInv S) ∧
    RealizesCleanUnitary v (diagProj (Lift128 rFull128 rExtra9 (p.PostInv S)))
      (closeDyn p v rFull128)
      (rFull128.embedUnitary p.toCircuit.inverse.eval) := by
  induction p generalizing clean S with
  | id =>
      dsimp only [CleanComputeProg.PostInv, CleanComputeProg.toCircuit, closeDyn]
      have h1 : (Circuit.identity : Circuit 128).eval.1 = 1 := rfl
      have h1i : (Circuit.identity : Circuit 128).inverse.eval.1 = 1 := rfl
      have hEv : ((Circuit.identity : Circuit n)).eval =
          rFull128.embedUnitary (Circuit.identity : Circuit 128).inverse.eval := by
        have hi : (Circuit.identity : Circuit 128).inverse = Circuit.identity := rfl
        have hon : (Circuit.identity : Circuit 128).onRegister rFull128 = Circuit.identity := rfl
        rw [hi, ← Circuit.eval_onRegister, hon]
      exact ⟨by rw [h1, Matrix.one_mul, diagProj_mul_self],
             by rw [h1i, Matrix.one_mul, diagProj_mul_self],
             hEv ▸ RealizesCleanUnitary.circuit v _ _⟩
  | x q =>
      dsimp only [CleanComputeProg.PostInv, CleanComputeProg.toCircuit, closeDyn]
      have hFwd : diagProj (fun δ ↦ S (Function.update δ q (δ q + 1))) *
          ((Circuit.X q).eval.1 * diagProj S) = (Circuit.X q).eval.1 * diagProj S :=
        diagProj_mul_of_preservesSpan fun α hα ↦ by
          rw [ket_X]
          refine ket_mem_ketSpan ?_
          have hrestore : Function.update (Function.update α q (α q + 1)) q
              (Function.update α q (α q + 1) q + 1) = α := by
            rw [Function.update_self, upd_idem128, add_assoc, CharTwo.add_self_eq_zero, add_zero]
            exact upd_self128 α q rfl
          rwa [hrestore]
      have hBwd : diagProj S * ((Circuit.X q).inverse.eval.1 *
          diagProj (fun δ ↦ S (Function.update δ q (δ q + 1)))) =
          (Circuit.X q).inverse.eval.1 * diagProj (fun δ ↦ S (Function.update δ q (δ q + 1))) :=
        diagProj_mul_of_preservesSpan fun δ hδ ↦ by
          have heq : (Circuit.X q).inverse.eval.1.mulVec (ket δ) =
              (Circuit.X q).eval.1.mulVec (ket δ) :=
            congrArg (fun U : Unitary (2 ^ 128) ↦ U.1.mulVec (ket δ)) (X_inv_eval q)
          rw [heq, ket_X]; exact ket_mem_ketSpan hδ
      have hEv : ((Circuit.X q).inverse.onRegister rFull128).eval =
          rFull128.embedUnitary (Circuit.X q).inverse.eval := Circuit.eval_onRegister _ _
      exact ⟨hFwd, hBwd, hEv ▸ RealizesCleanUnitary.circuit v _ _⟩
  | cnot c tgt =>
      dsimp only [CleanComputeProg.checkProg] at hOk
      obtain ⟨hct, _, _⟩ := of_decide_eq_true hOk
      dsimp only [CleanComputeProg.PostInv, CleanComputeProg.toCircuit, closeDyn]
      have hFwd : diagProj (fun δ ↦ S (Function.update δ tgt (δ tgt + δ c))) *
          ((cnotIf c tgt).eval.1 * diagProj S) = (cnotIf c tgt).eval.1 * diagProj S :=
        diagProj_mul_of_preservesSpan fun α hα ↦ by
          rw [ket_cnotIf_ne c tgt hct]
          refine ket_mem_ketSpan ?_
          have hrestore : Function.update (Function.update α tgt (α tgt + α c)) tgt
              (Function.update α tgt (α tgt + α c) tgt +
                Function.update α tgt (α tgt + α c) c) = α := by
            rw [Function.update_self, Function.update_of_ne hct, upd_idem128,
              add_assoc, CharTwo.add_self_eq_zero, add_zero]
            exact upd_self128 α tgt rfl
          rwa [hrestore]
      have hBwd : diagProj S * ((cnotIf c tgt).inverse.eval.1 *
          diagProj (fun δ ↦ S (Function.update δ tgt (δ tgt + δ c)))) =
          (cnotIf c tgt).inverse.eval.1 *
            diagProj (fun δ ↦ S (Function.update δ tgt (δ tgt + δ c))) :=
        diagProj_mul_of_preservesSpan fun δ hδ ↦ by
          rw [ket_cnotIf_inv_ne c tgt hct]; exact ket_mem_ketSpan hδ
      have hEv : ((cnotIf c tgt).inverse.onRegister rFull128).eval =
          rFull128.embedUnitary (cnotIf c tgt).inverse.eval := Circuit.eval_onRegister _ _
      exact ⟨hFwd, hBwd, hEv ▸ RealizesCleanUnitary.circuit v _ _⟩
  | tempAnd c₁ c₂ anc =>
      dsimp only [CleanComputeProg.checkProg] at hOk
      rw [Bool.and_eq_true] at hOk
      have hAncMem : anc ∈ clean := isCleanList_eq_true_iff.mp hOk.1
      obtain ⟨h₁₂, h₁a, h₂a, _, _, _⟩ := of_decide_eq_true hOk.2
      have hcond : c₁ ≠ c₂ ∧ c₁ ≠ anc ∧ c₂ ≠ anc := ⟨h₁₂, h₁a, h₂a⟩
      let S_mid : BitAssignment 128 → Prop := fun δ ↦
        S (Function.update δ anc 0) ∧ δ anc = δ c₁ * δ c₂
      dsimp only [CleanComputeProg.PostInv, CleanComputeProg.toCircuit, closeDyn]
      rw [dite_eq_left hcond]
      have hFwd : diagProj S_mid * ((andComputeIf c₁ c₂ anc).eval.1 * diagProj S) =
          (andComputeIf c₁ c₂ anc).eval.1 * diagProj S := by
        apply matrix_ext_ket; intro α
        simp only [mul_mulVec_prog, diagProj_mulVec_ket]
        by_cases hs : S α
        · have h0 := hResp.1 α hs anc hAncMem
          have hm : S_mid (Function.update α anc (α c₁ * α c₂)) := by
            refine ⟨?_, by simp [Function.update_self, Function.update_of_ne h₁a,
              Function.update_of_ne h₂a]⟩
            rw [upd_idem128, upd_self128 α anc h0]; exact hs
          simp only [hs, ↓reduceIte, ket_andComputeIf_of_zero_cert c₁ c₂ anc h₁a h₂a α h0,
            diagProj_mulVec_ket, hm]
        · simp only [hs, ↓reduceIte, Matrix.mulVec_zero]
      have hBwd : diagProj S * ((andComputeIf c₁ c₂ anc).inverse.eval.1 * diagProj S_mid) =
          (andComputeIf c₁ c₂ anc).inverse.eval.1 * diagProj S_mid := by
        apply matrix_ext_ket; intro δ
        simp only [mul_mulVec_prog, diagProj_mulVec_ket]
        by_cases hs : S_mid δ
        · simp only [hs, ↓reduceIte, ket_andComputeIf_inv_of_eq c₁ c₂ anc h₁a h₂a δ hs.2,
            diagProj_mulVec_ket, hs.1]
        · simp only [hs, ↓reduceIte, Matrix.mulVec_zero]
      have h₁₂' : rFull128 c₁ ≠ rFull128 c₂ := rFull128.wires.injective.ne h₁₂
      have h₁a' : rFull128 c₁ ≠ rFull128 anc := rFull128.wires.injective.ne h₁a
      have h₂a' : rFull128 c₂ ≠ rFull128 anc := rFull128.wires.injective.ne h₂a
      have hRealT := RealizesCleanUnitary.andUncompute_diag v
        (rFull128 c₁) (rFull128 c₂) (rFull128 anc) h₁₂' h₁a' h₂a'
        (Lift128 rFull128 rExtra9 S_mid) (fun _ h ↦ h.1.2)
      let T_loc := (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval
      have hToffOnReg :
          (Circuit.TOFF (rFull128 c₁) (rFull128 c₂) (rFull128 anc) h₁₂' h₁a' h₂a').eval =
            rFull128.embedUnitary T_loc := by
        have hon : (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).onRegister rFull128 =
            Circuit.TOFF (rFull128 c₁) (rFull128 c₂) (rFull128 anc) h₁₂' h₁a' h₂a' := by
          dsimp only [Circuit.TOFF, Circuit.onRegister]
          congr 1
          apply PosPostPrep80CertS3Alt.qreg_ext
          intro i; fin_cases i <;> rfl
        rw [← hon, Circuit.eval_onRegister]
      have hMatLoc : T_loc.1 * diagProj S_mid =
          (andComputeIf c₁ c₂ anc).inverse.eval.1 * diagProj S_mid := by
        apply matrix_ext_ket; intro δ
        simp only [T_loc, mul_mulVec_prog, diagProj_mulVec_ket]
        by_cases hs : S_mid δ
        · have hz : δ anc + δ c₁ * δ c₂ = 0 := by rw [hs.2, CharTwo.add_self_eq_zero]
          simp only [hs, ↓reduceIte, ket_TOFF, hz,
            ket_andComputeIf_inv_of_eq c₁ c₂ anc h₁a h₂a δ hs.2]
        · simp only [hs, ↓reduceIte, Matrix.mulVec_zero]
      have hReal := RealizesCleanUnitary.congr_unitary (diagProj_conjTranspose _)
        (hToffOnReg ▸ hRealT)
        (embedUnitary_mul_diagProj_Lift128_eq rFull128 rExtra9 S_mid T_loc
          (andComputeIf c₁ c₂ anc).inverse.eval hMatLoc)
      exact ⟨hFwd, hBwd, hReal⟩
  | seq p₁ p₂ ih₁ ih₂ =>
      dsimp only [CleanComputeProg.checkProg] at hOk
      rw [Bool.and_eq_true] at hOk
      have hResp₁ := bhmt_post_respectsClean p₁ clean S hResp hOk.1
      obtain ⟨hF₁, hB₁, hR₁⟩ := ih₁ clean S hResp hOk.1
      obtain ⟨hF₂, hB₂, hR₂⟩ := ih₂ (p₁.checkProg clean).2 (p₁.PostInv S) hResp₁ hOk.2
      dsimp only [CleanComputeProg.PostInv, CleanComputeProg.toCircuit, closeDyn]
      have hFwdSeq : diagProj (p₂.PostInv (p₁.PostInv S)) *
          ((p₁.toCircuit ;;ᶜ p₂.toCircuit).eval.1 * diagProj S) =
          (p₁.toCircuit ;;ᶜ p₂.toCircuit).eval.1 * diagProj S := by
        calc diagProj (p₂.PostInv (p₁.PostInv S)) *
              ((p₁.toCircuit ;;ᶜ p₂.toCircuit).eval.1 * diagProj S)
            = diagProj (p₂.PostInv (p₁.PostInv S)) *
                (p₂.toCircuit.eval.1 * (p₁.toCircuit.eval.1 * diagProj S)) := by
                simp [Circuit.eval_seq, Submonoid.coe_mul, Matrix.mul_assoc]
          _ = diagProj (p₂.PostInv (p₁.PostInv S)) *
                (p₂.toCircuit.eval.1 * (diagProj (p₁.PostInv S) *
                  (p₁.toCircuit.eval.1 * diagProj S))) := by rw [hF₁]
          _ = (diagProj (p₂.PostInv (p₁.PostInv S)) *
                (p₂.toCircuit.eval.1 * diagProj (p₁.PostInv S))) *
                (p₁.toCircuit.eval.1 * diagProj S) := by simp [Matrix.mul_assoc]
          _ = (p₂.toCircuit.eval.1 * diagProj (p₁.PostInv S)) *
                (p₁.toCircuit.eval.1 * diagProj S) := by rw [hF₂]
          _ = (p₁.toCircuit ;;ᶜ p₂.toCircuit).eval.1 * diagProj S := by
                rw [Matrix.mul_assoc, hF₁]; simp [Circuit.eval_seq, Submonoid.coe_mul,
                  Matrix.mul_assoc]
      have hInvEq : (p₁.toCircuit ;;ᶜ p₂.toCircuit).inverse.eval =
          p₁.toCircuit.inverse.eval * p₂.toCircuit.inverse.eval := by
        simp [Circuit.eval_seq, Circuit.eval_inverse]
      have hBwdSeq : diagProj S *
          ((p₁.toCircuit ;;ᶜ p₂.toCircuit).inverse.eval.1 *
            diagProj (p₂.PostInv (p₁.PostInv S))) =
          (p₁.toCircuit ;;ᶜ p₂.toCircuit).inverse.eval.1 *
            diagProj (p₂.PostInv (p₁.PostInv S)) := by
        rw [hInvEq]
        calc diagProj S *
              ((p₁.toCircuit.inverse.eval * p₂.toCircuit.inverse.eval).1 *
                diagProj (p₂.PostInv (p₁.PostInv S)))
            = diagProj S * (p₁.toCircuit.inverse.eval.1 *
                (p₂.toCircuit.inverse.eval.1 * diagProj (p₂.PostInv (p₁.PostInv S)))) := by
                simp [Submonoid.coe_mul, Matrix.mul_assoc]
          _ = diagProj S * (p₁.toCircuit.inverse.eval.1 *
                (diagProj (p₁.PostInv S) *
                  (p₂.toCircuit.inverse.eval.1 * diagProj (p₂.PostInv (p₁.PostInv S))))) := by
                rw [hB₂]
          _ = (diagProj S * (p₁.toCircuit.inverse.eval.1 * diagProj (p₁.PostInv S))) *
                (p₂.toCircuit.inverse.eval.1 * diagProj (p₂.PostInv (p₁.PostInv S))) := by
                simp [Matrix.mul_assoc]
          _ = (p₁.toCircuit.inverse.eval.1 * diagProj (p₁.PostInv S)) *
                (p₂.toCircuit.inverse.eval.1 * diagProj (p₂.PostInv (p₁.PostInv S))) := by
                rw [hB₁]
          _ = (p₁.toCircuit.inverse.eval * p₂.toCircuit.inverse.eval).1 *
                diagProj (p₂.PostInv (p₁.PostInv S)) := by
                rw [Matrix.mul_assoc, hB₂]; simp [Submonoid.coe_mul, Matrix.mul_assoc]
      have hCleanL := diagProj_Lift128_mul_embedUnitary rFull128 rExtra9 hDisjExtra
        (p₂.PostInv (p₁.PostInv S)) (p₁.PostInv S) p₂.toCircuit.inverse.eval hB₂
      have hSeqR := RealizesCleanUnitary_seq_asym
        (diagProj_conjTranspose _) (diagProj_conjTranspose _) hR₂ hR₁ hCleanL
      have hEmbEq : rFull128.embedUnitary p₁.toCircuit.inverse.eval *
          rFull128.embedUnitary p₂.toCircuit.inverse.eval =
          rFull128.embedUnitary (p₁.toCircuit ;;ᶜ p₂.toCircuit).inverse.eval := by
        rw [← rFull128.embedUnitary_mul, hInvEq]
      exact ⟨hFwdSeq, hBwdSeq, hEmbEq ▸ hSeqR⟩

/-! ### 3. Polymorphic `2-T` W-State Primitives & `dWForkOpen` (`2 * R + 2` T) -/


theorem sqrtHalf_mul_sqrt2_wf : (sqrtHalf : ℂ) * (√2 : ℂ) = 1 := by
  dsimp [sqrtHalf]
  rw [← Complex.ofReal_mul, ← Real.sqrt_mul (by norm_num)]
  norm_num


theorem wordMatrix2_ths_entries_wf :
    wordMatrix2 [.T, .H, .S] 0 0 = sqrtHalf ∧
      wordMatrix2 [.T, .H, .S] 0 1 = sqrtHalf * omega8 ∧
      wordMatrix2 [.T, .H, .S] 1 0 = sqrtHalf * omega8 ^ 2 ∧
      wordMatrix2 [.T, .H, .S] 1 1 = -sqrtHalf * omega8 ^ 3 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    (dsimp [wordMatrix2, evalList, matId, Mat2Zw.toMatrix,
       zwAdd, zwSub, zwMulI, zwMulW, Zw.toComplex, Pi.smul_apply, smul_eq_mul]
     norm_num)


theorem alpha0_ths_wf : alpha0 [.T, .H, .S] = sqrtHalf := by
  obtain ⟨h00, h01, _, _⟩ := wordMatrix2_ths_entries_wf
  dsimp only [alpha0]
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
    Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
    h00, h01, star_mul', star_sqrtHalf, star_omega8, mul_zero, mul_one, zero_add, add_zero]
  linear_combination
    sqrtHalf * sqrtHalf * omega8_sub_cube_eq_sqrt2 + sqrtHalf * sqrtHalf_mul_sqrt2_wf


theorem alpha1_ths_wf : alpha1 [.T, .H, .S] = sqrtHalf := by
  obtain ⟨h00, h01, h10, h11⟩ := wordMatrix2_ths_entries_wf
  dsimp only [alpha1]
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
    Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
    h00, h01, h10, h11, star_mul', star_sqrtHalf, star_omega8, mul_zero, mul_one, zero_add,
      add_zero]
  linear_combination
    -sqrtHalf * sqrtHalf * omega8 * omega8_pow_four +
      sqrtHalf * sqrtHalf * omega8_sub_cube_eq_sqrt2 + sqrtHalf * sqrtHalf_mul_sqrt2_wf


noncomputable def wSplitPairWF {n : ℕ} (a b : Wire n) (hab : a ≠ b) : Circuit n :=
  ctrlProbGate [.T, .H, .S] a b hab ;;ᶜ Circuit.CNOT b a hab.symm


theorem wSplitPairWF_count_toff {n : ℕ} (a b : Wire n) (hab : a ≠ b) :
    (wSplitPairWF a b hab).count PrimitiveGate.TOFF = 0 := by
  simp [wSplitPairWF, count_toff_ctrlProbGate]


theorem wSplitPairWF_count_t {n : ℕ} (a b : Wire n) (hab : a ≠ b) :
    (wSplitPairWF a b hab).count PrimitiveGate.T = 2 := by
  simp only [wSplitPairWF, Circuit.count_seq, count_t_ctrlProbGate]; rfl


theorem ket_wSplitPairWF_zero_zero {n : ℕ} (a b : Wire n) (hab : a ≠ b)
    (β : BitAssignment n) (ha : β a = 0) (hb : β b = 0) :
    (wSplitPairWF a b hab).eval.1.mulVec (ket β) = ket β := by
  rw [wSplitPairWF, eval_seq_mulVec, ctrlProbGate_mulVec_ket_zero _ a b hab β ha,
    ket_CNOT, hb, add_zero, Function.update_eq_self]


theorem ket_wSplitPairWF_one_zero {n : ℕ} (a b : Wire n) (hab : a ≠ b)
    (β : BitAssignment n) (ha : β a = 1) (hb : β b = 0) :
    (wSplitPairWF a b hab).eval.1.mulVec (ket β) =
      sqrtHalf • ket β +
        sqrtHalf • ket (Function.update (Function.update β a 0) b 1) := by
  rw [wSplitPairWF, eval_seq_mulVec,
    ctrlProbGate_mulVec_ket_one_zero _ a b hab β ha hb, alpha0_ths_wf, alpha1_ths_wf,
    Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul]
  have hc0 : (Circuit.CNOT b a hab.symm).eval.1.mulVec (ket β) = ket β := by
    rw [ket_CNOT, hb, add_zero, Function.update_eq_self]
  have hc1 : (Circuit.CNOT b a hab.symm).eval.1.mulVec (ket (Function.update β b 1)) =
      ket (Function.update (Function.update β a 0) b 1) := by
    rw [ket_CNOT, Function.update_of_ne hab, Function.update_self, ha,
      CharTwo.add_self_eq_zero, Function.update_comm hab.symm 1 0 β]
  rw [hc0, hc1]


def swap3CircWF {n : ℕ} (a b : Wire n) (hab : a ≠ b) : Circuit n :=
  Circuit.CNOT a b hab ;;ᶜ Circuit.CNOT b a hab.symm ;;ᶜ Circuit.CNOT a b hab


theorem ket_swap3CircWF {n : ℕ} (a b : Wire n) (hab : a ≠ b) (β : BitAssignment n) :
    (swap3CircWF a b hab).eval.1.mulVec (ket β) =
      ket (Function.update (Function.update β a (β b)) b (β a)) := by
  rw [swap3CircWF, eval_seq_mulVec, eval_seq_mulVec, ket_CNOT, ket_CNOT, ket_CNOT]
  congr 1; funext u
  by_cases hua : u = a
  · subst hua
    simp only [Function.update_of_ne hab, Function.update_of_ne hab.symm, Function.update_self]
    rcases bit_cases (β u) with h1 | h1 <;> rcases bit_cases (β b) with h2 | h2 <;> simp_all
  · by_cases hub : u = b
    · subst hub
      simp only [Function.update_self, Function.update_of_ne hab, Function.update_of_ne hab.symm]
      rcases bit_cases (β a) with h1 | h1 <;> rcases bit_cases (β u) with h2 | h2 <;> simp_all
    · simp [Function.update_of_ne hua, Function.update_of_ne hub]


def wSeqFinWF {n : ℕ} : (R : ℕ) → (Fin R → Circuit n) → Circuit n
  | 0, _ => .identity
  | R + 1, cs => cs 0 ;;ᶜ wSeqFinWF R (fun i ↦ cs i.succ)


theorem wSeqFinWF_count_eq_zero {n a : ℕ} (g : PrimitiveGate a) :
    ∀ (R : ℕ) (cs : Fin R → Circuit n),
      (∀ i, (cs i).count g = 0) → (wSeqFinWF R cs).count g = 0
  | 0, _, _ => rfl
  | R + 1, cs, hc => by
      simp [wSeqFinWF, hc 0, wSeqFinWF_count_eq_zero g R (fun i ↦ cs i.succ) (fun i ↦ hc i.succ)]


theorem wSeqFinWF_count_const {n a : ℕ} (g : PrimitiveGate a) (c : ℕ) :
    ∀ (R : ℕ) (cs : Fin R → Circuit n),
      (∀ i, (cs i).count g = c) → (wSeqFinWF R cs).count g = c * R
  | 0, _, _ => by simp [wSeqFinWF]
  | R + 1, cs, hc => by
      simp only [wSeqFinWF, Circuit.count_seq, hc 0,
        wSeqFinWF_count_const g c R (fun i ↦ cs i.succ) (fun i ↦ hc i.succ)]
      ring


theorem ket_wSplitSeqWF_all_zero {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n) (hab : ∀ i, a i ≠ b i) (β : BitAssignment n),
      (∀ i, β (a i) = 0) → (∀ i, β (b i) = 0) →
      (wSeqFinWF R (fun i ↦ wSplitPairWF (a i) (b i) (hab i))).eval.1.mulVec (ket β) = ket β
  | 0, _, _, _, β, _, _ => by simp [wSeqFinWF]
  | R + 1, a, b, hab, β, ha, hb => by
      rw [wSeqFinWF, eval_seq_mulVec,
        ket_wSplitPairWF_zero_zero (a 0) (b 0) (hab 0) β (ha 0) (hb 0)]
      exact ket_wSplitSeqWF_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
        (fun i ↦ hab i.succ) β (fun i ↦ ha i.succ) (fun i ↦ hb i.succ)


theorem ket_wSplitSeqWF_oneHot {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n)
      (_ha_inj : Function.Injective a) (_hb_inj : Function.Injective b)
      (hab_ne : ∀ i j, a i ≠ b j)
      (β : BitAssignment n) (iStar : Fin R),
      (∀ i, β (b i) = 0) →
      β (a iStar) = 1 →
      (∀ i, i ≠ iStar → β (a i) = 0) →
      (wSeqFinWF R (fun i ↦ wSplitPairWF (a i) (b i) (hab_ne i i))).eval.1.mulVec (ket β) =
        sqrtHalf • ket β +
          sqrtHalf • ket (Function.update (Function.update β (a iStar) 0) (b iStar) 1)
  | 0, _, _, _, _, _, _, iStar, _, _, _ => Fin.elim0 iStar
  | R + 1, a, b, ha_inj, hb_inj, hab_ne, β, iStar, hb0, ha1, ha0 => by
      rw [wSeqFinWF, eval_seq_mulVec]
      cases iStar using Fin.cases with
      | zero =>
          rw [ket_wSplitPairWF_one_zero (a 0) (b 0) (hab_ne 0 0) β ha1 (hb0 0),
            Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul]
          have hz_stay := ket_wSplitSeqWF_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (fun i ↦ hab_ne i.succ i.succ) β
            (fun i ↦ ha0 i.succ (Fin.succ_ne_zero i)) (fun i ↦ hb0 i.succ)
          let βm := Function.update (Function.update β (a 0) 0) (b 0) 1
          have hz_move := ket_wSplitSeqWF_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (fun i ↦ hab_ne i.succ i.succ) βm
            (fun i ↦ by
              dsimp only [βm]
              rw [Function.update_of_ne (hab_ne i.succ 0),
                Function.update_of_ne (ha_inj.ne (Fin.succ_ne_zero i))]
              exact ha0 i.succ (Fin.succ_ne_zero i))
            (fun i ↦ by
              dsimp only [βm]
              rw [Function.update_of_ne (hb_inj.ne (Fin.succ_ne_zero i)),
                Function.update_of_ne (hab_ne 0 i.succ).symm]
              exact hb0 i.succ)
          rw [hz_stay, hz_move]
      | succ k =>
          rw [ket_wSplitPairWF_zero_zero (a 0) (b 0) (hab_ne 0 0) β
            (ha0 0 (Fin.succ_ne_zero k).symm) (hb0 0)]
          exact ket_wSplitSeqWF_oneHot R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (ha_inj.comp (Fin.succ_injective R)) (hb_inj.comp (Fin.succ_injective R))
            (fun i j ↦ hab_ne i.succ j.succ) β k
            (fun i ↦ hb0 i.succ) ha1
            (fun i hik ↦ ha0 i.succ (fun he ↦ hik (Fin.succ_inj.mp he)))


theorem ket_cnotToTargetSeqWF {n : ℕ} :
    ∀ (R : ℕ) (src : Fin R → Wire n) (tgt : Wire n) (hne : ∀ i, src i ≠ tgt)
      (β : BitAssignment n),
      (wSeqFinWF R (fun i ↦ Circuit.CNOT (src i) tgt (hne i))).eval.1.mulVec (ket β) =
        ket (Function.update β tgt (β tgt + ∑ i : Fin R, β (src i)))
  | 0, _, tgt, _, β => by simp [wSeqFinWF, Function.update_eq_self]
  | R + 1, src, tgt, hne, β => by
      rw [wSeqFinWF, eval_seq_mulVec, ket_CNOT]
      let β₁ := Function.update β tgt (β tgt + β (src 0))
      rw [ket_cnotToTargetSeqWF R (fun i ↦ src i.succ) tgt (fun i ↦ hne i.succ) β₁]
      congr 1
      have hsum : (∑ i : Fin R, β₁ (src i.succ)) = ∑ i : Fin R, β (src i.succ) :=
        Finset.sum_congr rfl fun i _ ↦ Function.update_of_ne (hne i.succ) _ _
      dsimp only [β₁]
      rw [Function.update_self, hsum, Function.update_idem, add_assoc, Fin.sum_univ_succ]


theorem ket_cnotPairToTargetSeqWF {n : ℕ} :
    ∀ (R : ℕ) (s0 s1 : Fin R → Wire n) (tgt : Wire n)
      (h0 : ∀ i, s0 i ≠ tgt) (h1 : ∀ i, s1 i ≠ tgt)
      (β : BitAssignment n),
      (wSeqFinWF R (fun i ↦
        Circuit.CNOT (s0 i) tgt (h0 i) ;;ᶜ Circuit.CNOT (s1 i) tgt (h1 i))).eval.1.mulVec (ket β) =
        ket (Function.update β tgt (β tgt + ∑ i : Fin R, (β (s0 i) + β (s1 i))))
  | 0, _, _, tgt, _, _, β => by simp [wSeqFinWF, Function.update_eq_self]
  | R + 1, s0, s1, tgt, h0, h1, β => by
      rw [wSeqFinWF, eval_seq_mulVec, eval_seq_mulVec, ket_CNOT, ket_CNOT]
      have hβ₁ : Function.update
          (Function.update β tgt (β tgt + β (s0 0))) tgt
          (Function.update β tgt (β tgt + β (s0 0)) tgt +
            Function.update β tgt (β tgt + β (s0 0)) (s1 0)) =
          Function.update β tgt (β tgt + (β (s0 0) + β (s1 0))) := by
        rw [Function.update_self, Function.update_of_ne (h1 0), Function.update_idem, add_assoc]
      rw [hβ₁, ket_cnotPairToTargetSeqWF R (fun i ↦ s0 i.succ) (fun i ↦ s1 i.succ) tgt
        (fun i ↦ h0 i.succ) (fun i ↦ h1 i.succ)]
      congr 1
      have hsum : (∑ i : Fin R,
          (Function.update β tgt (β tgt + (β (s0 0) + β (s1 0))) (s0 i.succ) +
           Function.update β tgt (β tgt + (β (s0 0) + β (s1 0))) (s1 i.succ))) =
          ∑ i : Fin R, (β (s0 i.succ) + β (s1 i.succ)) :=
        Finset.sum_congr rfl fun i _ ↦ by
          rw [Function.update_of_ne (h0 i.succ), Function.update_of_ne (h1 i.succ)]
      rw [Function.update_self, hsum, Function.update_idem, add_assoc, Fin.sum_univ_succ]


theorem ket_swap3SeqWF_all_zero {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n) (hab : ∀ i, a i ≠ b i) (β : BitAssignment n),
      (∀ i, β (a i) = 0) → (∀ i, β (b i) = 0) →
      (wSeqFinWF R (fun i ↦ swap3CircWF (a i) (b i) (hab i))).eval.1.mulVec (ket β) = ket β
  | 0, _, _, _, β, _, _ => by simp [wSeqFinWF]
  | R + 1, a, b, hab, β, ha, hb => by
      rw [wSeqFinWF, eval_seq_mulVec, ket_swap3CircWF, ha 0, hb 0]
      have hself : Function.update (Function.update β (a 0) 0) (b 0) 0 = β := by
        funext u
        by_cases h1 : u = b 0
        · subst h1; simp [hb 0]
        · by_cases h2 : u = a 0
          · subst h2; simp [Function.update_of_ne h1, ha 0]
          · simp [Function.update_of_ne h1, Function.update_of_ne h2]
      rw [hself]
      exact ket_swap3SeqWF_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
        (fun i ↦ hab i.succ) β (fun i ↦ ha i.succ) (fun i ↦ hb i.succ)


theorem ket_swap3SeqWF_single {n : ℕ} :
    ∀ (R : ℕ) (a b : Fin R → Wire n)
      (_ha_inj : Function.Injective a) (_hb_inj : Function.Injective b)
      (hab_ne : ∀ i j, a i ≠ b j)
      (β : BitAssignment n) (iStar : Fin R),
      (∀ i, i ≠ iStar → β (a i) = 0) →
      (∀ i, i ≠ iStar → β (b i) = 0) →
      (wSeqFinWF R (fun i ↦ swap3CircWF (a i) (b i) (hab_ne i i))).eval.1.mulVec (ket β) =
        ket (Function.update (Function.update β (a iStar) (β (b iStar))) (b iStar) (β (a iStar)))
  | 0, _, _, _, _, _, _, iStar, _, _ => Fin.elim0 iStar
  | R + 1, a, b, ha_inj, hb_inj, hab_ne, β, iStar, ha0, hb0 => by
      rw [wSeqFinWF, eval_seq_mulVec]
      cases iStar using Fin.cases with
      | zero =>
          rw [ket_swap3CircWF]
          let βs := Function.update (Function.update β (a 0) (β (b 0))) (b 0) (β (a 0))
          exact ket_swap3SeqWF_all_zero R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (fun i ↦ hab_ne i.succ i.succ) βs
            (fun i ↦ by
              dsimp only [βs]
              rw [Function.update_of_ne (hab_ne i.succ 0),
                Function.update_of_ne (ha_inj.ne (Fin.succ_ne_zero i))]
              exact ha0 i.succ (Fin.succ_ne_zero i))
            (fun i ↦ by
              dsimp only [βs]
              rw [Function.update_of_ne (hb_inj.ne (Fin.succ_ne_zero i)),
                Function.update_of_ne (hab_ne 0 i.succ).symm]
              exact hb0 i.succ (Fin.succ_ne_zero i))
      | succ k =>
          rw [ket_swap3CircWF, ha0 0 (Fin.succ_ne_zero k).symm, hb0 0 (Fin.succ_ne_zero k).symm]
          have hself : Function.update (Function.update β (a 0) 0) (b 0) 0 = β := by
            funext u
            by_cases h1 : u = b 0
            · subst h1; simp [hb0 0 (Fin.succ_ne_zero k).symm]
            · by_cases h2 : u = a 0
              · subst h2; simp [Function.update_of_ne h1, ha0 0 (Fin.succ_ne_zero k).symm]
              · simp [Function.update_of_ne h1, Function.update_of_ne h2]
          rw [hself]
          exact ket_swap3SeqWF_single R (fun i ↦ a i.succ) (fun i ↦ b i.succ)
            (ha_inj.comp (Fin.succ_injective R)) (hb_inj.comp (Fin.succ_injective R))
            (fun i j ↦ hab_ne i.succ j.succ) β k
            (fun i hik ↦ ha0 i.succ (fun he ↦ hik (Fin.succ_inj.mp he)))
            (fun i hik ↦ hb0 i.succ (fun he ↦ hik (Fin.succ_inj.mp he)))


theorem ket_projOutcomeAll_one_wf {n : ℕ} (q : Wire n) (g : Fin 1 → Bool) (β : BitAssignment n) :
    (projOutcomeAll 1 (fun _ ↦ q) g).mulVec (ket β) =
      if β q = (if g 0 then 1 else 0) then ket β else 0 := by
  rw [projOutcomeAll.eq_def, mul_mulVec_prog, projOutcomeAll.eq_def, Matrix.one_mulVec]
  cases hb : g 0
  · simp [ket_projector_zero]
  · simp [ket_projector_one]


private theorem measure1Fixup_realizes_wf
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (q : Wire n) (cPre cFixTrue : Circuit n)
    (P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) (hP_herm : Pᴴ = P)
    (U_ref : Unitary (2 ^ n))
    (hMg : ∀ g : Fin 1 → Bool,
      ((if g 0 then cFixTrue else Circuit.identity).eval.1) *
          projOutcomeAll 1 (fun _ ↦ q) g * cPre.eval.1 * P =
        (sqrtHalf : ℂ) • (U_ref.1 * P)) :
    RealizesCleanUnitary v P
      (.seq (.circuit cPre)
        (measureAndBranchSeq v 1 (fun _ ↦ QRegister.singleton q)
          (fun g ↦ if g 0 then .circuit cFixTrue else .circuit .identity)))
      U_ref := by
  let cFix : (Fin 1 → Bool) → Circuit n := fun g ↦ if g 0 then cFixTrue else .identity
  let fixup : (Fin 1 → Bool) → DynamicCircuit Var n := fun g ↦ .circuit (cFix g)
  let cAll : DynamicCircuit Var n :=
    .seq (.circuit cPre)
      (measureAndBranchSeq v 1 (fun _ ↦ QRegister.singleton q) fixup)
  have hdEq :
      (.seq (.circuit cPre)
        (measureAndBranchSeq v 1 (fun _ ↦ QRegister.singleton q)
          (fun g ↦ if g 0 then DynamicCircuit.circuit (Var := Var) cFixTrue
                   else .circuit .identity))) = cAll := by
    dsimp only [cAll, fixup, cFix]
    congr 2; funext g; split_ifs <;> rfl
  rw [hdEq]
  have hBranchInv : ∀ g (Ψ : CQAssertionCompat Var (2 ^ n)),
      (∀ σ val, Ψ (Function.update σ v val) = Ψ σ) →
      ∀ σ val, wp (fixup g).compile Ψ (Function.update σ v val) = wp (fixup g).compile Ψ σ :=
    fun g Ψ hΨ σ val ↦ (RealizesCleanUnitary.circuit v P (cFix g)).1 Ψ hΨ σ val
  refine ⟨fun Ψ hΨ σ val ↦ ?_, fun Θ hΘ σ ↦ ?_⟩
  · simp only [cAll, DynamicCircuit.compile_seq, wp_qSeq]
    exact (RealizesCleanUnitary.circuit v P cPre).1 _
      (wp_measureAndBranchSeq_update_self v 1 _ fixup hBranchInv Ψ hΨ) σ val
  · have hUnf :
        ((wp cAll.compile Θ σ).1).conj P =
          ∑ g : Fin 1 → Bool,
            ((Θ σ).1).conj
              (((cFix g).eval.1 * projOutcomeAll 1 (fun _ ↦ q) g * cPre.eval.1 * P)ᴴ) := by
      simp only [cAll, DynamicCircuit.compile_seq, DynamicCircuit.compile_circuit, wp_qSeq,
        wp_circuit_compile_compat, wpQAssignCompat, qAssignObsMap, Observable.conj_coe,
        Unitary.coe_star, Matrix.star_eq_conjTranspose, conj_conj]
      rw [← conj_conj,
        wp_measureAndBranchSeq_exact_wfork v Θ hΘ 1 (fun _ ↦ q) fixup hBranchInv σ,
        map_sum, map_sum]
      refine Finset.sum_congr rfl fun g _ ↦ ?_
      simp only [fixup, DynamicCircuit.compile_circuit, wp_circuit_compile_compat, wpQAssignCompat,
        qAssignObsMap, Observable.conj_coe, Unitary.coe_star, Matrix.star_eq_conjTranspose,
        conj_conj, conjTranspose_mul, hP_herm, Matrix.mul_assoc]
    rw [hUnf]
    have hMg' : ∀ g : Fin 1 → Bool,
        (cFix g).eval.1 * projOutcomeAll 1 (fun _ ↦ q) g * cPre.eval.1 * P =
          (sqrtHalf : ℂ) • (U_ref.1 * P) := hMg
    simp_rw [hMg']
    simp only [wpQAssignCompat, qAssignObsMap, Observable.conj_coe, Unitary.coe_star,
      Matrix.star_eq_conjTranspose, conj_conj]
    have hsum_mat : ∀ (s : Finset (Fin 1 → Bool)) (H : HermitianMat (Fin (2 ^ n)) ℂ),
        (∑ _ ∈ s, H).mat = (s.card : ℂ) • H.mat := fun s H ↦ by
      refine Finset.induction_on s (by simp) fun a s ha ih ↦ ?_
      have h1 : (∑ _ ∈ insert a s, H).mat = H.mat + (∑ _ ∈ s, H).mat := by
        rw [Finset.sum_insert ha]; rfl
      have h2 : (insert a s).card = s.card + 1 := by simp [ha]
      rw [h1, ih, h2, Nat.cast_add, Nat.cast_one, add_smul, one_smul, add_comm]
    have hcard : ((Finset.univ : Finset (Fin 1 → Bool)).card : ℂ) = 2 := by simp
    have h2sh : (2 : ℂ) * (sqrtHalf * sqrtHalf) = 1 := by
      rw [sqrtHalf_mul_sqrtHalf]; norm_num
    ext1
    rw [hsum_mat, hcard, HermitianMat.conj_apply_mat, HermitianMat.conj_apply_mat]
    simp only [conjTranspose_conjTranspose, conjTranspose_mul, conjTranspose_smul,
      star_sqrtHalf, hP_herm, Matrix.smul_mul, Matrix.mul_smul, smul_smul, Matrix.mul_assoc]
    rw [h2sh, one_smul]

/-! ### 4. Ghost Permutation Unitary & `dWExpandDetWF` on Arbitrary Width `n` -/


noncomputable def ghostInvolUWF {n : ℕ} (perm : BitAssignment n → BitAssignment n)
    (hperm : Function.Involutive perm) : Unitary (2 ^ n) :=
  permutationUnitary
    ((basisBitsEquiv n).trans
      ((Equiv.mk perm perm hperm hperm).trans (basisBitsEquiv n).symm))


theorem ket_ghostInvolUWF {n : ℕ} (perm : BitAssignment n → BitAssignment n)
    (hperm : Function.Involutive perm) (β : BitAssignment n) :
    (ghostInvolUWF perm hperm).1.mulVec (ket β) = ket (perm β) := by
  funext i
  rw [ket, ket, basisState]
  simp only [ghostInvolUWF, Matrix.mulVec, dotProduct, Pi.single_apply, mul_boole,
    Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  simp only [permutationUnitary, Equiv.Perm.permMatrix, PEquiv.toMatrix_apply,
    Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq, Equiv.Perm.inv_def,
    Equiv.symm_trans_apply, Equiv.symm_symm]
  change (if (basisBitsEquiv n).symm (perm (basisBits n i)) = (basisBitsEquiv n).symm β then
    (1 : ℂ) else 0) =
    if i = (basisBitsEquiv n).symm (perm β) then 1 else 0
  by_cases hi : i = (basisBitsEquiv n).symm (perm β)
  · subst hi
    simp [(basisBitsEquiv n).apply_symm_apply (perm β), hperm β]
  · have hne : (basisBitsEquiv n).symm (perm (basisBits n i)) ≠ (basisBitsEquiv n).symm β := by
      intro heq
      have h1 := congrArg (basisBitsEquiv n) heq
      simp only [Equiv.apply_symm_apply] at h1
      have h2 := congrArg perm h1
      rw [hperm] at h2
      apply hi
      rw [← h2]
      exact ((basisBitsEquiv n).symm_apply_apply i).symm
    simp [hi, hne]


structure WPairDisjWF {M : ℕ} (R : ℕ) (ctrl : Wire M) (w0 w1 : Fin R → Wire M) : Prop where
  w0_inj : Function.Injective w0
  w1_inj : Function.Injective w1
  w01_ne : ∀ i j, w0 i ≠ w1 j
  ctrl_w0 : ∀ i, ctrl ≠ w0 i
  ctrl_w1 : ∀ i, ctrl ≠ w1 i


structure WSplitValidWF {M : ℕ} (R : ℕ) (ctrl : Wire M) (w0 w1 : Fin R →
    Wire M) (qEnc : Wire M) : Prop
    extends WPairDisjWF R ctrl w0 w1 where
  q_ctrl : qEnc ≠ ctrl
  q_w0 : ∀ i, qEnc ≠ w0 i
  q_w1 : ∀ i, qEnc ≠ w1 i


noncomputable def cswapRangeWF {M : ℕ} (R : ℕ) (ctrl : Wire M) (w0 w1 : Fin R → Wire M)
    (γ : BitAssignment M) : BitAssignment M :=
  fun w ↦
    if γ ctrl = 1 then
      if h0 : ∃ i : Fin R, w = w0 i then γ (w1 h0.choose)
      else if h1 : ∃ i : Fin R, w = w1 i then γ (w0 h1.choose)
      else γ w
    else γ w


theorem cswapRangeWF_w0 {M R : ℕ} {ctrl : Wire M} {w0 w1 : Fin R → Wire M}
    (hd : WPairDisjWF R ctrl w0 w1) (γ : BitAssignment M) (i : Fin R) :
    cswapRangeWF R ctrl w0 w1 γ (w0 i) = if γ ctrl = 1 then γ (w1 i) else γ (w0 i) := by
  dsimp only [cswapRangeWF]
  by_cases hc : γ ctrl = 1
  · rw [ite_eq_left hc, ite_eq_left hc]
    have h0 : ∃ k : Fin R, w0 i = w0 k := ⟨i, rfl⟩
    rw [dite_eq_left h0]
    exact congrArg (fun k ↦ γ (w1 k)) (hd.w0_inj h0.choose_spec).symm
  · rw [ite_eq_right hc, ite_eq_right hc]


theorem cswapRangeWF_w1 {M R : ℕ} {ctrl : Wire M} {w0 w1 : Fin R → Wire M}
    (hd : WPairDisjWF R ctrl w0 w1) (γ : BitAssignment M) (i : Fin R) :
    cswapRangeWF R ctrl w0 w1 γ (w1 i) = if γ ctrl = 1 then γ (w0 i) else γ (w1 i) := by
  dsimp only [cswapRangeWF]
  by_cases hc : γ ctrl = 1
  · rw [ite_eq_left hc, ite_eq_left hc]
    have hn0 : ¬ ∃ k : Fin R, w1 i = w0 k := fun ⟨k, hk⟩ ↦ hd.w01_ne k i hk.symm
    have h1 : ∃ k : Fin R, w1 i = w1 k := ⟨i, rfl⟩
    rw [dite_eq_right hn0, dite_eq_left h1]
    exact congrArg (fun k ↦ γ (w0 k)) (hd.w1_inj h1.choose_spec).symm
  · rw [ite_eq_right hc, ite_eq_right hc]


theorem cswapRangeWF_other {M R : ℕ} {ctrl : Wire M} {w0 w1 : Fin R → Wire M}
    (γ : BitAssignment M) {w : Wire M}
    (hw0 : ∀ i, w ≠ w0 i) (hw1 : ∀ i, w ≠ w1 i) :
    cswapRangeWF R ctrl w0 w1 γ w = γ w := by
  dsimp only [cswapRangeWF]
  by_cases hc : γ ctrl = 1
  · rw [ite_eq_left hc, dite_eq_right (fun ⟨i, hi⟩ ↦ hw0 i hi), dite_eq_right (fun ⟨i, hi⟩ ↦
    hw1 i hi)]
  · rw [ite_eq_right hc]


theorem cswapRangeWF_involutive {M R : ℕ} {ctrl : Wire M} {w0 w1 : Fin R → Wire M}
    (hd : WPairDisjWF R ctrl w0 w1) :
    Function.Involutive (cswapRangeWF R ctrl w0 w1) := by
  intro γ
  let γ' := cswapRangeWF R ctrl w0 w1 γ
  have hctrl : γ' ctrl = γ ctrl := cswapRangeWF_other γ hd.ctrl_w0 hd.ctrl_w1
  funext w
  by_cases h0 : ∃ i : Fin R, w = w0 i
  · obtain ⟨i, rfl⟩ := h0
    change cswapRangeWF R ctrl w0 w1 γ' (w0 i) = γ (w0 i)
    rw [cswapRangeWF_w0 hd γ' i, hctrl]
    dsimp only [γ']
    rw [cswapRangeWF_w0 hd γ i, cswapRangeWF_w1 hd γ i]
    split_ifs <;> rfl
  · by_cases h1 : ∃ i : Fin R, w = w1 i
    · obtain ⟨i, rfl⟩ := h1
      change cswapRangeWF R ctrl w0 w1 γ' (w1 i) = γ (w1 i)
      rw [cswapRangeWF_w1 hd γ' i, hctrl]
      dsimp only [γ']
      rw [cswapRangeWF_w0 hd γ i, cswapRangeWF_w1 hd γ i]
      split_ifs <;> rfl
    · have hw0 : ∀ i, w ≠ w0 i := fun i he ↦ h0 ⟨i, he⟩
      have hw1 : ∀ i, w ≠ w1 i := fun i he ↦ h1 ⟨i, he⟩
      exact (cswapRangeWF_other γ' hw0 hw1).trans (cswapRangeWF_other γ hw0 hw1)


def InvWSplitDetN {n : ℕ} (R : ℕ) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (β : BitAssignment n) : Prop :=
  β qEnc = 0 ∧ (∀ i : Fin R, β (w1 i) = 0) ∧
    ∃ iStar : Fin R, β (w0 iStar) = 1 ∧ ∀ i : Fin R, i ≠ iStar → β (w0 i) = 0


noncomputable def dWExpandDetN {Var : Type} {n : ℕ} (v : Var)
    (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValidWF R ctrl w0 w1 qEnc) : DynamicCircuit Var n :=
  let cPre : Circuit n :=
    wSeqFinWF R (fun i ↦ wSplitPairWF (w0 i) (w1 i) (hv.w01_ne i i)) ;;ᶜ
      wSeqFinWF R (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) ;;ᶜ
      Circuit.CNOT ctrl qEnc hv.q_ctrl.symm
  let cFixTrue : Circuit n :=
    Circuit.X qEnc ;;ᶜ wSeqFinWF R (fun i ↦ swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i))
  .seq (.circuit cPre)
    (measureAndBranchSeq v 1 (fun _ ↦ QRegister.singleton qEnc)
      (fun g ↦ if g 0 then .circuit cFixTrue else .circuit .identity))


theorem dWExpandDetN_count_toff {Var : Type} {n : ℕ} (v : Var)
    (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValidWF R ctrl w0 w1 qEnc) :
    (dWExpandDetN v R ctrl w0 w1 qEnc hv).count PrimitiveGate.TOFF = 0 := by
  dsimp only [dWExpandDetN, DynamicCircuit.count]
  have h1 := wSeqFinWF_count_eq_zero PrimitiveGate.TOFF R _
    (fun i ↦ wSplitPairWF_count_toff (w0 i) (w1 i) (hv.w01_ne i i))
  have h2 := wSeqFinWF_count_eq_zero PrimitiveGate.TOFF R
    (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) (fun _ ↦ rfl)
  have h3 := wSeqFinWF_count_eq_zero PrimitiveGate.TOFF R
    (fun i ↦ swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i)) (fun _ ↦ by simp [swap3CircWF])
  let fixup : (Fin 1 → Bool) → DynamicCircuit Var n := fun g ↦
    if g 0 then .circuit (Circuit.X qEnc ;;ᶜ wSeqFinWF R (fun i ↦
      swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i)))
    else .circuit .identity
  have hm := measureAndBranchSeq_count_eq_zero v PrimitiveGate.TOFF 1
    (fun _ ↦ QRegister.singleton qEnc) fixup (fun g ↦ by
      dsimp only [fixup]; split_ifs <;> simp [DynamicCircuit.count, Circuit.count_seq, h3])
  simp [fixup, Circuit.count_seq, h1, h2, hm]


theorem dWExpandDetN_count_t {Var : Type} {n : ℕ} (v : Var)
    (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValidWF R ctrl w0 w1 qEnc) :
    (dWExpandDetN v R ctrl w0 w1 qEnc hv).count PrimitiveGate.T = 2 * R := by
  dsimp only [dWExpandDetN, DynamicCircuit.count]
  have h1 := wSeqFinWF_count_const PrimitiveGate.T 2 R _
    (fun i ↦ wSplitPairWF_count_t (w0 i) (w1 i) (hv.w01_ne i i))
  have h2 := wSeqFinWF_count_eq_zero PrimitiveGate.T R
    (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) (fun _ ↦ rfl)
  have h3 := wSeqFinWF_count_eq_zero PrimitiveGate.T R
    (fun i ↦ swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i)) (fun _ ↦ by simp [swap3CircWF])
  let fixup : (Fin 1 → Bool) → DynamicCircuit Var n := fun g ↦
    if g 0 then .circuit (Circuit.X qEnc ;;ᶜ wSeqFinWF R (fun i ↦
      swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i)))
    else .circuit .identity
  have hm := measureAndBranchSeq_count_eq_zero v PrimitiveGate.T 1
    (fun _ ↦ QRegister.singleton qEnc) fixup (fun g ↦ by
      dsimp only [fixup]; split_ifs <;> simp [DynamicCircuit.count, Circuit.count_seq, h3])
  simp [fixup, Circuit.count_seq, h1, h2, hm]


theorem dWExpandDetN_store {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} (v : Var)
    (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValidWF R ctrl w0 w1 qEnc) :
    PreservesStoreConst (dWExpandDetN v R ctrl w0 w1 qEnc hv) :=
  PreservesStoreConst.seq (PreservesStoreConst.circuit _)
    (PreservesStoreConst.measureAndBranchSeq v 1 _ _ fun _ ↦ by
      split_ifs <;> exact PreservesStoreConst.circuit _)


private theorem dWExpandDetN_realizes {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero
    (2 ^ n)]
    (v : Var) (R : ℕ) (ctrl : Wire n) (w0 w1 : Fin R → Wire n) (qEnc : Wire n)
    (hv : WSplitValidWF R ctrl w0 w1 qEnc)
    (S : BitAssignment n → Prop)
    (hImp : ∀ β, S β → InvWSplitDetN R w0 w1 qEnc β) :
    RealizesCleanUnitary v (diagProj S)
      (dWExpandDetN v R ctrl w0 w1 qEnc hv)
      (ghostInvolUWF (cswapRangeWF R ctrl w0 w1) (cswapRangeWF_involutive hv.toWPairDisjWF)) := by
  let cPre : Circuit n :=
    wSeqFinWF R (fun i ↦ wSplitPairWF (w0 i) (w1 i) (hv.w01_ne i i)) ;;ᶜ
      wSeqFinWF R (fun i ↦ Circuit.CNOT (w1 i) qEnc (hv.q_w1 i).symm) ;;ᶜ
      Circuit.CNOT ctrl qEnc hv.q_ctrl.symm
  let cFixTrue : Circuit n :=
    Circuit.X qEnc ;;ᶜ wSeqFinWF R (fun i ↦ swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i))
  let cFix : (Fin 1 → Bool) → Circuit n := fun g ↦ if g 0 then cFixTrue else .identity
  let U_ref := ghostInvolUWF (cswapRangeWF R ctrl w0 w1) (cswapRangeWF_involutive hv.toWPairDisjWF)
  let P := diagProj S
  refine measure1Fixup_realizes_wf v qEnc cPre cFixTrue P (diagProj_conjTranspose S) U_ref (fun g ↦
    ?_)
  change (cFix g).eval.1 * projOutcomeAll 1 (fun _ ↦ qEnc) g * cPre.eval.1 * P =
    (sqrtHalf : ℂ) • (U_ref.1 * P)
  apply matrix_ext_ket; intro β
  rw [Matrix.smul_mulVec]
  by_cases hS : S β
  · have hPβ : P.mulVec (ket β) = ket β := by rw [diagProj_mulVec_ket, ite_eq_left hS]
    rw [mul_mulVec_prog, mul_mulVec_prog, mul_mulVec_prog, hPβ, mul_mulVec_prog, hPβ]
    obtain ⟨hq0, hw1_0, iStar, hw0_1, hw0_0⟩ := hImp β hS
    let βm := Function.update (Function.update β (w0 iStar) 0) (w1 iStar) 1
    have hq_βm : βm qEnc = 0 := by
      dsimp only [βm]
      rw [Function.update_of_ne (hv.q_w1 iStar), Function.update_of_ne (hv.q_w0 iStar), hq0]
    have hc_βm : βm ctrl = β ctrl := by
      dsimp only [βm]
      rw [Function.update_of_ne (hv.ctrl_w1 iStar), Function.update_of_ne (hv.ctrl_w0 iStar)]
    have hcPre : cPre.eval.1.mulVec (ket β) =
        sqrtHalf • ket (Function.update β qEnc (β ctrl)) +
          sqrtHalf • ket (Function.update βm qEnc (1 + β ctrl)) := by
      dsimp only [cPre]
      rw [eval_seq_mulVec, eval_seq_mulVec,
        ket_wSplitSeqWF_oneHot R w0 w1 hv.w0_inj hv.w1_inj hv.w01_ne β iStar hw1_0 hw0_1 hw0_0,
        Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        ket_cnotToTargetSeqWF R w1 qEnc _ β,
        ket_cnotToTargetSeqWF R w1 qEnc _ βm,
        Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        ket_CNOT, ket_CNOT]
      have hsum_stay : (∑ i : Fin R, β (w1 i)) = 0 := Finset.sum_eq_zero fun i _ ↦ hw1_0 i
      have hsum_move : (∑ i : Fin R, βm (w1 i)) = 1 := by
        rw [Finset.sum_eq_single iStar]
        · dsimp only [βm]; exact Function.update_self _ _ _
        · intro i _ hne
          dsimp only [βm]
          rw [Function.update_of_ne (hv.w1_inj.ne hne),
            Function.update_of_ne (hv.w01_ne iStar i).symm, hw1_0 i]
        · intro habs; exact absurd (Finset.mem_univ iStar) habs
      rw [hq0, hsum_stay, add_zero, hq_βm, hsum_move, zero_add,
        Function.update_self, Function.update_of_ne hv.q_ctrl.symm,
        Function.update_idem, zero_add,
        Function.update_self, Function.update_of_ne hv.q_ctrl.symm,
        hc_βm, Function.update_idem]
    have hUref_ket : U_ref.1.mulVec (ket β) = if β ctrl = 0 then ket β else ket βm := by
      dsimp only [U_ref]
      rw [ket_ghostInvolUWF]
      rcases bit_cases (β ctrl) with hc0 | hc1
      · simp only [hc0, ↓reduceIte]
        congr 1; funext u
        dsimp only [cswapRangeWF]; simp only [hc0, zero_ne_one, ↓reduceIte]
      · simp only [hc1, one_ne_zero, ↓reduceIte]
        congr 1; funext u
        by_cases hw_a : ∃ i : Fin R, u = w0 i
        · obtain ⟨i, rfl⟩ := hw_a
          rw [cswapRangeWF_w0 hv.toWPairDisjWF _ i, hc1, ite_eq_left rfl, hw1_0 i]
          dsimp only [βm]
          rw [Function.update_of_ne (hv.w01_ne i iStar)]
          by_cases hi : i = iStar
          · subst hi; rw [Function.update_self]
          · rw [Function.update_of_ne (hv.w0_inj.ne hi), hw0_0 i hi]
        · by_cases hw_b : ∃ i : Fin R, u = w1 i
          · obtain ⟨i, rfl⟩ := hw_b
            rw [cswapRangeWF_w1 hv.toWPairDisjWF _ i, hc1, ite_eq_left rfl]
            dsimp only [βm]
            by_cases hi : i = iStar
            · subst hi; rw [Function.update_self]; exact hw0_1
            · rw [Function.update_of_ne (hv.w1_inj.ne hi),
                Function.update_of_ne (hv.w01_ne iStar i).symm, hw0_0 i hi, hw1_0 i]
          · rw [cswapRangeWF_other _ (fun i he ↦ hw_a ⟨i, he⟩) (fun i he ↦ hw_b ⟨i, he⟩)]
            dsimp only [βm]
            rw [Function.update_of_ne (fun he ↦ hw_b ⟨iStar, he⟩),
              Function.update_of_ne (fun he ↦ hw_a ⟨iStar, he⟩)]
    have hSwap_β : (wSeqFinWF R (fun i ↦ swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i))).eval.1.mulVec
        (ket β) = ket βm := by
      rw [ket_swap3SeqWF_single R w0 w1 hv.w0_inj hv.w1_inj hv.w01_ne β iStar hw0_0 (fun i _ ↦
        hw1_0 i)]
      dsimp only [βm]; rw [hw1_0 iStar, hw0_1]
    have hSwap_βm : (wSeqFinWF R (fun i ↦ swap3CircWF (w0 i) (w1 i) (hv.w01_ne i i))).eval.1.mulVec
        (ket βm) = ket β := by
      rw [ket_swap3SeqWF_single R w0 w1 hv.w0_inj hv.w1_inj hv.w01_ne βm iStar
        (fun i hi ↦ by
          dsimp only [βm]
          rw [Function.update_of_ne (hv.w01_ne i iStar), Function.update_of_ne (hv.w0_inj.ne hi)]
          exact hw0_0 i hi)
        (fun i hi ↦ by
          dsimp only [βm]
          rw [Function.update_of_ne (hv.w1_inj.ne hi),
            Function.update_of_ne (hv.w01_ne iStar i).symm]
          exact hw1_0 i)]
      congr 1; funext u
      dsimp only [βm]
      by_cases hua : u = w0 iStar
      · subst hua
        rw [Function.update_of_ne (hv.w01_ne iStar iStar),
          Function.update_self, Function.update_self, hw0_1]
      · by_cases hub : u = w1 iStar
        · subst hub
          rw [Function.update_self, Function.update_of_ne (hv.w01_ne iStar iStar),
            Function.update_self, hw1_0 iStar]
        · simp [Function.update_of_ne hua, Function.update_of_ne hub]
    rw [hcPre, hUref_ket, Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
      ket_projOutcomeAll_one_wf, ket_projOutcomeAll_one_wf]
    have h11 : (1 : ZMod 2) + 1 = 0 := rfl
    have h1ne0 : (1 : ZMod 2) ≠ 0 := one_ne_zero
    have h0ne1 : (0 : ZMod 2) ≠ 1 := zero_ne_one
    cases hg : g 0 <;> rcases bit_cases (β ctrl) with hc0 | hc1
    · simp only [hg, hc0, add_zero, Function.update_self, h1ne0, ↓reduceIte,
        smul_zero, add_zero, cFix, Bool.false_eq_true, Circuit.eval_identity,
        Submonoid.coe_one, Matrix.one_mulVec]
      rw [← hq0, Function.update_eq_self]
    · simp only [hg, hc1, h11, Function.update_self, h1ne0, ↓reduceIte,
        smul_zero, zero_add, cFix, Bool.false_eq_true, Circuit.eval_identity,
        Submonoid.coe_one, Matrix.one_mulVec]
      rw [← hq_βm, Function.update_eq_self]
    · simp only [hg, hc0, add_zero, Function.update_self, h0ne1, ↓reduceIte, smul_zero, zero_add,
      cFix, cFixTrue, Matrix.mulVec_smul, eval_seq_mulVec, ket_X, Function.update_idem, h11]
      rw [← hq_βm, Function.update_eq_self, hSwap_βm]
    · simp only [hg, hc1, h11, Function.update_self, h0ne1, h1ne0, ↓reduceIte,
        smul_zero, add_zero, cFix, cFixTrue, Matrix.mulVec_smul, eval_seq_mulVec, ket_X,
        Function.update_idem]
      rw [← hq0, Function.update_eq_self, hSwap_β]
  · have hPβ : P.mulVec (ket β) = 0 := by rw [diagProj_mulVec_ket, ite_eq_right hS]
    simp only [mul_mulVec_prog, hPβ, Matrix.mulVec_zero, smul_zero]

/-! ### 5. `dWForkOpen` (`2 * R + 2` T) + `pForkGroupPos` + `DynPair128.wForkGroup` -/


def pForkGroupPos : (m : ℕ) → Wire 128 → (Fin (m + 1) → Wire 128) → (Fin (m + 1) → Wire 128) →
    CleanComputeProg
  | 0, ctrl, w0, w1 => pForkStep (w0 0) ctrl (w1 0)
  | m + 1, ctrl, w0, w1 =>
      .seq (pForkStep (w0 0) ctrl (w1 0))
        (pForkGroupPos m ctrl (fun i ↦ w0 i.succ) (fun i ↦ w1 i.succ))


theorem ket_pForkStep_of_zero (u ctrl uRight : Wire 128)
    (hu_c : u ≠ ctrl) (hu_r : u ≠ uRight) (hc_r : ctrl ≠ uRight)
    (α : BitAssignment 128) (hr0 : α uRight = 0) :
    (pForkStep u ctrl uRight).toCircuit.eval.1.mulVec (ket α) =
      ket (Function.update
        (Function.update α u (if α ctrl = 1 then 0 else α u))
        uRight (if α ctrl = 1 then α u else 0)) := by
  dsimp only [pForkStep, CleanComputeProg.toCircuit]
  rw [eval_seq_mulVec, ket_andComputeIf_of_zero_cert u ctrl uRight hu_r hc_r α hr0,
    ket_cnotIf_ne uRight u hu_r.symm]
  congr 1; funext w
  by_cases hwr : w = uRight
  · subst hwr
    rw [Function.update_of_ne hu_r.symm, Function.update_self, Function.update_self]
    rcases bit_cases (α ctrl) with hc | hc <;>
      rcases bit_cases (α u) with hu | hu <;>
      (rw [hc, hu]; decide)
  · by_cases hwu : w = u
    · subst hwu
      rw [Function.update_self, Function.update_of_ne hu_r, Function.update_self,
        Function.update_of_ne hwr, Function.update_self]
      rcases bit_cases (α ctrl) with hc | hc <;>
        rcases bit_cases (α w) with hw | hw <;>
        (rw [hc, hw]; decide)
    · simp [Function.update_of_ne hwr, Function.update_of_ne hwu]


theorem ket_pForkGroupPos_eq_cswap :
    ∀ (m : ℕ) (ctrl : Wire 128) (w0 w1 : Fin (m + 1) → Wire 128)
      (_hd : WPairDisjWF (m + 1) ctrl w0 w1)
      (α : BitAssignment 128),
      (∀ i, α (w1 i) = 0) →
      (pForkGroupPos m ctrl w0 w1).toCircuit.eval.1.mulVec (ket α) =
        ket (cswapRangeWF (m + 1) ctrl w0 w1 α)
  | 0, ctrl, w0, w1, hd, α, hw1_0 => by
      rw [pForkGroupPos, ket_pForkStep_of_zero (w0 0) ctrl (w1 0)
        (hd.ctrl_w0 0).symm (hd.w01_ne 0 0) (hd.ctrl_w1 0) α (hw1_0 0)]
      congr 1; funext w
      by_cases hw_1 : w = w1 0
      · subst hw_1
        rw [Function.update_self, cswapRangeWF_w1 hd α 0, hw1_0 0]
      · by_cases hw_0 : w = w0 0
        · subst hw_0
          rw [Function.update_of_ne (hd.w01_ne 0 0), Function.update_self,
            cswapRangeWF_w0 hd α 0, hw1_0 0]
        · rw [Function.update_of_ne hw_1, Function.update_of_ne hw_0,
            cswapRangeWF_other α (fun i ↦ by fin_cases i; exact hw_0)
              (fun i ↦ by fin_cases i; exact hw_1)]
  | m + 1, ctrl, w0, w1, hd, α, hw1_0 => by
      have hd_tail : WPairDisjWF (m + 1) ctrl (fun i ↦ w0 i.succ) (fun i ↦ w1 i.succ) := {
        w0_inj := hd.w0_inj.comp (Fin.succ_injective _)
        w1_inj := hd.w1_inj.comp (Fin.succ_injective _)
        w01_ne := fun i j ↦ hd.w01_ne i.succ j.succ
        ctrl_w0 := fun i ↦ hd.ctrl_w0 i.succ
        ctrl_w1 := fun i ↦ hd.ctrl_w1 i.succ
      }
      rw [pForkGroupPos]
      dsimp only [CleanComputeProg.toCircuit]
      rw [eval_seq_mulVec,
        ket_pForkStep_of_zero (w0 0) ctrl (w1 0)
          (hd.ctrl_w0 0).symm (hd.w01_ne 0 0) (hd.ctrl_w1 0) α (hw1_0 0)]
      let α₁ := Function.update
        (Function.update α (w0 0) (if α ctrl = 1 then 0 else α (w0 0)))
        (w1 0) (if α ctrl = 1 then α (w0 0) else 0)
      have hw1_α₁ : ∀ i : Fin (m + 1), α₁ (w1 i.succ) = 0 := fun i ↦ by
        dsimp only [α₁]
        rw [Function.update_of_ne (hd.w1_inj.ne (Fin.succ_ne_zero i)),
          Function.update_of_ne (hd.w01_ne 0 i.succ).symm, hw1_0 i.succ]
      rw [ket_pForkGroupPos_eq_cswap m ctrl (fun i ↦ w0 i.succ) (fun i ↦
        w1 i.succ) hd_tail α₁ hw1_α₁]
      have hc_α₁ : α₁ ctrl = α ctrl := by
        dsimp only [α₁]
        rw [Function.update_of_ne (hd.ctrl_w1 0), Function.update_of_ne (hd.ctrl_w0 0)]
      congr 1; funext w
      by_cases hw_a : ∃ i : Fin (m + 2), w = w0 i
      · obtain ⟨i, rfl⟩ := hw_a
        rw [cswapRangeWF_w0 hd α i, hw1_0 i]
        cases i using Fin.cases with
        | zero =>
            rw [cswapRangeWF_other α₁
              (fun j ↦ hd.w0_inj.ne (Fin.succ_ne_zero j).symm)
              (fun j ↦ hd.w01_ne 0 j.succ)]
            dsimp only [α₁]
            rw [Function.update_of_ne (hd.w01_ne 0 0), Function.update_self]
        | succ j =>
            rw [cswapRangeWF_w0 hd_tail α₁ j, hc_α₁, hw1_α₁ j]
            dsimp only [α₁]
            rw [Function.update_of_ne (hd.w01_ne j.succ 0),
              Function.update_of_ne (hd.w0_inj.ne (Fin.succ_ne_zero j))]
      · by_cases hw_b : ∃ i : Fin (m + 2), w = w1 i
        · obtain ⟨i, rfl⟩ := hw_b
          rw [cswapRangeWF_w1 hd α i, hw1_0 i]
          cases i using Fin.cases with
          | zero =>
              rw [cswapRangeWF_other α₁
                (fun j ↦ (hd.w01_ne j.succ 0).symm)
                (fun j ↦ hd.w1_inj.ne (Fin.succ_ne_zero j).symm)]
              dsimp only [α₁]; rw [Function.update_self]
          | succ j =>
              rw [cswapRangeWF_w1 hd_tail α₁ j, hc_α₁, hw1_α₁ j]
              dsimp only [α₁]
              rw [Function.update_of_ne (hd.w01_ne j.succ 0),
                Function.update_of_ne (hd.w0_inj.ne (Fin.succ_ne_zero j))]
        · rw [cswapRangeWF_other α (fun i he ↦ hw_a ⟨i, he⟩) (fun i he ↦ hw_b ⟨i, he⟩),
            cswapRangeWF_other α₁ (fun j he ↦ hw_a ⟨j.succ, he⟩) (fun j he ↦ hw_b ⟨j.succ, he⟩)]
          dsimp only [α₁]
          rw [Function.update_of_ne (fun he ↦ hw_b ⟨0, he⟩),
            Function.update_of_ne (fun he ↦ hw_a ⟨0, he⟩)]


theorem wSplitValid_lift {n R : ℕ}
    {rFull128 : QRegister 128 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    {ctrl : Wire 128} {w0 w1 : Fin R → Wire 128}
    (hd : WPairDisjWF R ctrl w0 w1) :
    WSplitValidWF (R + 1) (rFull128 ctrl)
      (Fin.cons (rExtra9 ⟨0, by decide⟩) (fun i ↦ rFull128 (w0 i)))
      (Fin.cons (rExtra9 ⟨1, by decide⟩) (fun i ↦ rFull128 (w1 i)))
      (rExtra9 ⟨2, by decide⟩) where
  w0_inj := by
    intro i j h
    cases i using Fin.cases <;> cases j using Fin.cases
    · rfl
    · exact absurd h.symm (hDisjExtra.ne _ _)
    · exact absurd h (hDisjExtra.ne _ _)
    · exact congrArg Fin.succ (hd.w0_inj (rFull128.wires.injective h))
  w1_inj := by
    intro i j h
    cases i using Fin.cases <;> cases j using Fin.cases
    · rfl
    · exact absurd h.symm (hDisjExtra.ne _ _)
    · exact absurd h (hDisjExtra.ne _ _)
    · exact congrArg Fin.succ (hd.w1_inj (rFull128.wires.injective h))
  w01_ne := by
    intro i j
    cases i using Fin.cases <;> cases j using Fin.cases
    · exact rExtra9.wires.injective.ne (by decide)
    · exact (hDisjExtra.ne _ _).symm
    · exact hDisjExtra.ne _ _
    · exact rFull128.wires.injective.ne (hd.w01_ne _ _)
  ctrl_w0 := Fin.cases (hDisjExtra.ne ctrl _) (fun i ↦ rFull128.wires.injective.ne (hd.ctrl_w0 i))
  ctrl_w1 := Fin.cases (hDisjExtra.ne ctrl _) (fun i ↦ rFull128.wires.injective.ne (hd.ctrl_w1 i))
  q_ctrl := (hDisjExtra.ne ctrl _).symm
  q_w0 := Fin.cases (rExtra9.wires.injective.ne (by decide)) (fun i ↦ (hDisjExtra.ne (w0 i) _).symm)
  q_w1 := Fin.cases (rExtra9.wires.injective.ne (by decide)) (fun i ↦ (hDisjExtra.ne (w1 i) _).symm)


noncomputable def dWForkOpen {Var : Type} {n : ℕ} (v : Var)
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (R : ℕ) (ctrl : Wire 128) (w0 w1 : Fin R → Wire 128)
    (hd : WPairDisjWF R ctrl w0 w1) : DynamicCircuit Var n :=
  let rDum := rExtra9 ⟨0, by decide⟩
  let wDum := rExtra9 ⟨1, by decide⟩
  let qEnc := rExtra9 ⟨2, by decide⟩
  let cInit : Circuit n :=
    Circuit.X rDum ;;ᶜ
      wSeqFinWF R (fun i ↦ Circuit.CNOT (rFull128 (w0 i)) rDum (hDisjExtra.ne (w0 i) _))
  let cUninit : Circuit n :=
    Circuit.CNOT wDum rDum (rExtra9.wires.injective.ne (by decide))
  let cRestore : Circuit n :=
    wSeqFinWF R (fun i ↦
      Circuit.CNOT (rFull128 (w0 i)) rDum (hDisjExtra.ne (w0 i) _) ;;ᶜ
      Circuit.CNOT (rFull128 (w1 i)) rDum (hDisjExtra.ne (w1 i) _)) ;;ᶜ
    Circuit.X rDum
  .seq
    (.seq
      (.seq
        (.seq (.circuit cInit)
          (dWExpandDetN v (R + 1) (rFull128 ctrl)
            (Fin.cons rDum (fun i ↦ rFull128 (w0 i)))
            (Fin.cons wDum (fun i ↦ rFull128 (w1 i)))
            qEnc (wSplitValid_lift hDisjExtra hd)))
        (.circuit cUninit))
      (DynamicCircuit.andUncompute v rDum (rFull128 ctrl) wDum
        (hDisjExtra.ne ctrl _).symm))
    (.circuit cRestore)


theorem dWForkOpen_count_toff {Var : Type} {n : ℕ} (v : Var)
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (R : ℕ) (ctrl : Wire 128) (w0 w1 : Fin R → Wire 128)
    (hd : WPairDisjWF R ctrl w0 w1) :
    (dWForkOpen v rFull128 rExtra9 hDisjExtra R ctrl w0 w1 hd).count PrimitiveGate.TOFF = 0 := by
  dsimp only [dWForkOpen, DynamicCircuit.count]
  have h1 := wSeqFinWF_count_eq_zero PrimitiveGate.TOFF R
    (fun i ↦ Circuit.CNOT (rFull128 (w0 i)) (rExtra9 ⟨0, by decide⟩) (hDisjExtra.ne (w0 i) _))
    (fun _ ↦ rfl)
  have h2 := wSeqFinWF_count_eq_zero PrimitiveGate.TOFF R
    (fun i ↦
      Circuit.CNOT (rFull128 (w0 i)) (rExtra9 ⟨0, by decide⟩) (hDisjExtra.ne (w0 i) _) ;;ᶜ
      Circuit.CNOT (rFull128 (w1 i)) (rExtra9 ⟨0, by decide⟩) (hDisjExtra.ne (w1 i) _))
    (fun _ ↦ rfl)
  have hX : (Circuit.X (rExtra9 ⟨0, by decide⟩)).count PrimitiveGate.TOFF = 0 := rfl
  have hU : (Circuit.CNOT (rExtra9 ⟨1, by decide⟩) (rExtra9 ⟨0, by decide⟩)
      (rExtra9.wires.injective.ne (by decide))).count PrimitiveGate.TOFF = 0 := rfl
  simp only [Circuit.count_seq, h1, h2, hX, hU, dWExpandDetN_count_toff,
    DynamicCircuit.count_andUncompute_toff, Nat.add_zero]


theorem dWForkOpen_count_t {Var : Type} {n : ℕ} (v : Var)
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (R : ℕ) (ctrl : Wire 128) (w0 w1 : Fin R → Wire 128)
    (hd : WPairDisjWF R ctrl w0 w1) :
    (dWForkOpen v rFull128 rExtra9 hDisjExtra R ctrl w0 w1 hd).count PrimitiveGate.T = 2 * R + 2 :=
      by
  dsimp only [dWForkOpen, DynamicCircuit.count]
  have h1 := wSeqFinWF_count_eq_zero PrimitiveGate.T R
    (fun i ↦ Circuit.CNOT (rFull128 (w0 i)) (rExtra9 ⟨0, by decide⟩) (hDisjExtra.ne (w0 i) _))
    (fun _ ↦ rfl)
  have h2 := wSeqFinWF_count_eq_zero PrimitiveGate.T R
    (fun i ↦
      Circuit.CNOT (rFull128 (w0 i)) (rExtra9 ⟨0, by decide⟩) (hDisjExtra.ne (w0 i) _) ;;ᶜ
      Circuit.CNOT (rFull128 (w1 i)) (rExtra9 ⟨0, by decide⟩) (hDisjExtra.ne (w1 i) _))
    (fun _ ↦ rfl)
  have hX : (Circuit.X (rExtra9 ⟨0, by decide⟩)).count PrimitiveGate.T = 0 := rfl
  have hU : (Circuit.CNOT (rExtra9 ⟨1, by decide⟩) (rExtra9 ⟨0, by decide⟩)
      (rExtra9.wires.injective.ne (by decide))).count PrimitiveGate.T = 0 := rfl
  simp only [Circuit.count_seq, h1, h2, hX, hU, dWExpandDetN_count_t,
    DynamicCircuit.count_andUncompute_t]
  omega


theorem dWForkOpen_store {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} (v : Var)
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (R : ℕ) (ctrl : Wire 128) (w0 w1 : Fin R → Wire 128)
    (hd : WPairDisjWF R ctrl w0 w1) :
    PreservesStoreConst (dWForkOpen v rFull128 rExtra9 hDisjExtra R ctrl w0 w1 hd) :=
  PreservesStoreConst.seq
    (PreservesStoreConst.seq
      (PreservesStoreConst.seq
        (PreservesStoreConst.seq (PreservesStoreConst.circuit _)
          (dWExpandDetN_store v _ _ _ _ _ _))
        (PreservesStoreConst.circuit _))
      (PreservesStoreConst.andUncompute v _ _ _ _))
    (PreservesStoreConst.circuit _)


private theorem dWForkOpen_realizes {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2
    ^ n)]
    {v : Var} {rFull128 : QRegister 128 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (m : ℕ) (ctrl : Wire 128) (w0 w1 : Fin (m + 1) → Wire 128)
    (hd : WPairDisjWF (m + 1) ctrl w0 w1)
    (S : BitAssignment 128 → Prop)
    (hW1Zero : ∀ α, S α → ∀ i, α (w1 i) = 0)
    (hAtMostOne : ∀ α, S α → ∀ i j, i ≠ j → ¬ (α (w0 i) = 1 ∧ α (w0 j) = 1)) :
    RealizesCleanUnitary v (diagProj (Lift128 rFull128 rExtra9 S))
      (dWForkOpen v rFull128 rExtra9 hDisjExtra (m + 1) ctrl w0 w1 hd)
      (rFull128.embedUnitary (pForkGroupPos m ctrl w0 w1).toCircuit.eval) := by
  let R := m + 1
  let rDum := rExtra9 ⟨0, by decide⟩
  let wDum := rExtra9 ⟨1, by decide⟩
  let qEnc := rExtra9 ⟨2, by decide⟩
  let w0N : Fin R → Wire n := fun i ↦ rFull128 (w0 i)
  let w1N : Fin R → Wire n := fun i ↦ rFull128 (w1 i)
  let w0Cons : Fin (R + 1) → Wire n := @Fin.cons R (fun _ ↦ Wire n) rDum w0N
  let w1Cons : Fin (R + 1) → Wire n := @Fin.cons R (fun _ ↦ Wire n) wDum w1N
  let hv := wSplitValid_lift hDisjExtra hd
  let cInit : Circuit n :=
    Circuit.X rDum ;;ᶜ wSeqFinWF R (fun i ↦ Circuit.CNOT (w0N i) rDum (hDisjExtra.ne (w0 i) _))
  let cUninit : Circuit n :=
    Circuit.CNOT wDum rDum (rExtra9.wires.injective.ne (by decide))
  let cRestore : Circuit n :=
    wSeqFinWF R (fun i ↦
      Circuit.CNOT (w0N i) rDum (hDisjExtra.ne (w0 i) _) ;;ᶜ
      Circuit.CNOT (w1N i) rDum (hDisjExtra.ne (w1 i) _)) ;;ᶜ
    Circuit.X rDum
  let L₀ := Lift128 rFull128 rExtra9 S
  let L₁ : BitAssignment n → Prop := fun β₁ ↦ InvWSplitDetN (R + 1) w0Cons w1Cons qEnc β₁
  let L₂ : BitAssignment n → Prop := fun β₂ ↦ β₂ wDum = (β₂ rDum + β₂ wDum) * β₂ (rFull128 ctrl)
  let L₃ : BitAssignment n → Prop := fun β₃ ↦ β₃ wDum = β₃ rDum * β₃ (rFull128 ctrl)
  have hrd_wd : rDum ≠ wDum := rExtra9.wires.injective.ne (by decide)
  have hrd_c : rDum ≠ rFull128 ctrl := (hDisjExtra.ne ctrl _).symm
  have hc_wd : rFull128 ctrl ≠ wDum := hDisjExtra.ne ctrl _
  have hcInit_ket : ∀ β : BitAssignment n, β rDum = 0 →
      cInit.eval.1.mulVec (ket β) =
        ket (Function.update β rDum (1 + ∑ i : Fin R, β (w0N i))) := fun β hr0 ↦ by
    dsimp only [cInit]
    rw [eval_seq_mulVec, ket_X, hr0, zero_add,
      ket_cnotToTargetSeqWF R w0N rDum _ (Function.update β rDum 1)]
    congr 1
    have hsum : (∑ i : Fin R, Function.update β rDum 1 (w0N i)) = ∑ i : Fin R, β (w0N i) :=
      Finset.sum_congr rfl fun i _ ↦ Function.update_of_ne (hDisjExtra.ne (w0 i) _) _ _
    rw [Function.update_self, hsum, Function.update_idem]
  have hStep01 : diagProj L₁ * (cInit.eval.1 * diagProj L₀) = cInit.eval.1 * diagProj L₀ := by
    apply matrix_ext_ket; intro β
    simp only [mul_mulVec_prog, diagProj_mulVec_ket]
    by_cases hL : L₀ β
    · rw [ite_eq_left hL, hcInit_ket β (hL.2 ⟨0, by decide⟩), diagProj_mulVec_ket, ite_eq_left]
      refine ⟨by rw [Function.update_of_ne (rExtra9.wires.injective.ne (by decide))]; exact hL.2 ⟨2,
        by decide⟩,
              Fin.cases
                (by simp only [w1Cons, Fin.cons_zero]
                    rw [Function.update_of_ne hrd_wd.symm]
                    exact hL.2 ⟨1, by decide⟩)
                (fun i ↦ by
                    simp only [w1Cons, Fin.cons_succ]
                    dsimp only [w1N, rDum]
                    rw [Function.update_of_ne (hDisjExtra.ne (w1 i) _)]
                    exact hW1Zero _ hL.1 i),
              ?_⟩
      by_cases hex : ∃ i₀ : Fin R, β (w0N i₀) = 1
      · obtain ⟨i₀, hi₀⟩ := hex
        have hoth : ∀ i : Fin R, i ≠ i₀ → β (w0N i) = 0 := fun i hne ↦ by
          rcases bit_cases (β (w0N i)) with h0 | h1
          · exact h0
          · exact absurd ⟨h1, hi₀⟩ (hAtMostOne _ hL.1 i i₀ hne)
        have hsum1 : (∑ i : Fin R, β (w0N i)) = 1 := by
          rw [Finset.sum_eq_single i₀]
          · exact hi₀
          · intro i _ hne; exact hoth i hne
          · intro habs; exact absurd (Finset.mem_univ i₀) habs
        refine ⟨i₀.succ, ?_, Fin.cases ?_ (fun i hne ↦ ?_)⟩
        · simp only [w0Cons, Fin.cons_succ]
          dsimp only [w0N, rDum]
          rw [Function.update_of_ne (hDisjExtra.ne (w0 i₀) _)]; exact hi₀
        · intro _
          simp only [w0Cons, Fin.cons_zero, Function.update_self, hsum1, CharTwo.add_self_eq_zero]
        · simp only [w0Cons, Fin.cons_succ]
          dsimp only [w0N, rDum]
          rw [Function.update_of_ne (hDisjExtra.ne (w0 i) _)]
          exact hoth i (fun he ↦ hne (congrArg Fin.succ he))
      · have hall0 : ∀ i : Fin R, β (w0N i) = 0 := fun i ↦ by
          rcases bit_cases (β (w0N i)) with h0 | h1
          · exact h0
          · exact absurd ⟨i, h1⟩ hex
        have hsum0 : (∑ i : Fin R, β (w0N i)) = 0 := Finset.sum_eq_zero fun i _ ↦ hall0 i
        refine ⟨0, ?_, Fin.cases (fun h ↦ absurd rfl h) (fun i _ ↦ ?_)⟩
        · simp only [w0Cons, Fin.cons_zero, Function.update_self, hsum0, add_zero]
        · simp only [w0Cons, Fin.cons_succ]
          dsimp only [w0N, rDum]
          rw [Function.update_of_ne (hDisjExtra.ne (w0 i) _)]
          exact hall0 i
    · simp only [hL, ↓reduceIte, Matrix.mulVec_zero]
  let U_exp := ghostInvolUWF (cswapRangeWF (R + 1) (rFull128 ctrl) w0Cons w1Cons)
    (cswapRangeWF_involutive hv.toWPairDisjWF)
  have hStep12 : diagProj L₂ * (U_exp.1 * diagProj L₁) = U_exp.1 * diagProj L₁ := by
    apply matrix_ext_ket; intro β₁
    simp only [mul_mulVec_prog, diagProj_mulVec_ket]
    by_cases h1 : L₁ β₁
    · rw [ite_eq_left h1, ket_ghostInvolUWF, diagProj_mulVec_ket, ite_eq_left]
      dsimp only [L₂]
      have hwd0 : β₁ wDum = 0 := h1.2.1 0
      have hrd_out := cswapRangeWF_w0 hv.toWPairDisjWF β₁ 0
      have hwd_out := cswapRangeWF_w1 hv.toWPairDisjWF β₁ 0
      have hc_out := cswapRangeWF_other (ctrl := rFull128 ctrl) β₁ hv.ctrl_w0 hv.ctrl_w1
      simp only [Fin.cons_zero] at hrd_out hwd_out
      rw [hrd_out, hwd_out, hc_out, hwd0]
      rcases bit_cases (β₁ (rFull128 ctrl)) with hc0 | hc1 <;>
        rcases bit_cases (β₁ rDum) with hr0 | hr1 <;> simp_all
    · simp only [h1, ↓reduceIte, Matrix.mulVec_zero]
  have hStep23 : diagProj L₃ * (cUninit.eval.1 * diagProj L₂) = cUninit.eval.1 * diagProj L₂ := by
    apply matrix_ext_ket; intro β₂
    simp only [cUninit, mul_mulVec_prog, diagProj_mulVec_ket]
    by_cases h2 : L₂ β₂
    · rw [ite_eq_left h2, ket_CNOT, diagProj_mulVec_ket, ite_eq_left]
      dsimp only [L₃]
      rw [Function.update_of_ne hrd_wd.symm, Function.update_self, Function.update_of_ne hrd_c.symm]
      exact h2
    · simp only [h2, ↓reduceIte, Matrix.mulVec_zero]
  have hR_init := RealizesCleanUnitary.circuit v (diagProj L₀) cInit
  have hR_exp := dWExpandDetN_realizes v (R + 1) (rFull128 ctrl) w0Cons w1Cons qEnc hv L₁ (fun _ h ↦
    h)
  have hR_unin := RealizesCleanUnitary.circuit v (diagProj L₂) cUninit
  have hR_and := RealizesCleanUnitary.andUncompute_diag v rDum (rFull128 ctrl) wDum
    hrd_c hrd_wd hc_wd L₃ (fun _ h ↦ h)
  have hR_rest := RealizesCleanUnitary.circuit v (diagProj (⊤ : BitAssignment n → Prop)) cRestore
  have hTop_abs : ∀ U_prev : Unitary (2 ^ n), ∀ P_prev : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
      diagProj (⊤ : BitAssignment n → Prop) * (U_prev.1 * P_prev) = U_prev.1 * P_prev := by
    intro U_prev P_prev
    have h1 : diagProj (⊤ : BitAssignment n → Prop) = 1 := by
      apply matrix_ext_ket; intro β; simp [diagProj_mulVec_ket]
    rw [h1, Matrix.one_mul]
  have hR01 := RealizesCleanUnitary_seq_asym (diagProj_conjTranspose L₀) (diagProj_conjTranspose L₁)
    hR_init hR_exp hStep01
  have hStep02 : diagProj L₂ * ((U_exp * cInit.eval).1 * diagProj L₀) =
      (U_exp * cInit.eval).1 * diagProj L₀ := by
    calc diagProj L₂ * ((U_exp * cInit.eval).1 * diagProj L₀)
        = diagProj L₂ * (U_exp.1 * (cInit.eval.1 * diagProj L₀)) := by
            simp [Submonoid.coe_mul, Matrix.mul_assoc]
      _ = diagProj L₂ * (U_exp.1 * (diagProj L₁ * (cInit.eval.1 * diagProj L₀))) := by rw [hStep01]
      _ = (diagProj L₂ * (U_exp.1 * diagProj L₁)) * (cInit.eval.1 * diagProj L₀) := by
            simp [Matrix.mul_assoc]
      _ = (U_exp.1 * diagProj L₁) * (cInit.eval.1 * diagProj L₀) := by rw [hStep12]
      _ = (U_exp * cInit.eval).1 * diagProj L₀ := by
            rw [Matrix.mul_assoc, hStep01]; simp [Submonoid.coe_mul, Matrix.mul_assoc]
  have hR02 := RealizesCleanUnitary_seq_asym (diagProj_conjTranspose L₀) (diagProj_conjTranspose L₂)
    hR01 hR_unin hStep02
  have hStep03 : diagProj L₃ * ((cUninit.eval * (U_exp * cInit.eval)).1 * diagProj L₀) =
      (cUninit.eval * (U_exp * cInit.eval)).1 * diagProj L₀ := by
    calc diagProj L₃ * ((cUninit.eval * (U_exp * cInit.eval)).1 * diagProj L₀)
        = diagProj L₃ * (cUninit.eval.1 * ((U_exp * cInit.eval).1 * diagProj L₀)) := by
            simp [Submonoid.coe_mul, Matrix.mul_assoc]
      _ = diagProj L₃ * (cUninit.eval.1 * (diagProj L₂ * ((U_exp * cInit.eval).1 * diagProj L₀))) :=
        by
            rw [hStep02]
      _ = (diagProj L₃ * (cUninit.eval.1 * diagProj L₂)) * ((U_exp * cInit.eval).1 * diagProj L₀) :=
        by
            simp [Matrix.mul_assoc]
      _ = (cUninit.eval.1 * diagProj L₂) * ((U_exp * cInit.eval).1 * diagProj L₀) := by rw [hStep23]
      _ = (cUninit.eval * (U_exp * cInit.eval)).1 * diagProj L₀ := by
            rw [Matrix.mul_assoc, hStep02]; simp [Submonoid.coe_mul, Matrix.mul_assoc]
  have hR03 := RealizesCleanUnitary_seq_asym (diagProj_conjTranspose L₀) (diagProj_conjTranspose L₃)
    hR02 hR_and hStep03
  have hR04 := RealizesCleanUnitary_seq_asym (diagProj_conjTranspose L₀)
    (diagProj_conjTranspose (⊤ : BitAssignment n → Prop)) hR03 hR_rest (hTop_abs _ _)
  refine RealizesCleanUnitary.congr_unitary (diagProj_conjTranspose L₀) hR04 ?_
  apply matrix_ext_ket; intro β
  simp only [mul_mulVec_prog, diagProj_mulVec_ket]
  by_cases hL : Lift128 rFull128 rExtra9 S β
  · rw [ite_eq_left hL]
    simp only [Submonoid.coe_mul, mul_mulVec_prog]
    rw [hcInit_ket β (hL.2 ⟨0, by decide⟩)]
    let rVal : ZMod 2 := 1 + ∑ i : Fin R, β (w0N i)
    let β₁ := Function.update β rDum rVal
    change cRestore.eval.1.mulVec
      ((Circuit.TOFF rDum (rFull128 ctrl) wDum hrd_c hrd_wd hc_wd).eval.1.mulVec
        (cUninit.eval.1.mulVec (U_exp.1.mulVec (ket β₁)))) = _
    rw [ket_ghostInvolUWF]
    let β₂ := cswapRangeWF (R + 1) (rFull128 ctrl) w0Cons w1Cons β₁
    have hwd_β₁ : β₁ wDum = 0 := by
      dsimp only [β₁]; rw [Function.update_of_ne hrd_wd.symm]; exact hL.2 ⟨1, by decide⟩
    have hrd_β₁ : β₁ rDum = rVal := Function.update_self _ _ _
    have hc_β₁ : β₁ (rFull128 ctrl) = β (rFull128 ctrl) := by
      dsimp only [β₁]; rw [Function.update_of_ne hrd_c.symm]
    have hrd_β₂ : β₂ rDum = if β (rFull128 ctrl) = 1 then 0 else rVal := by
      have h := cswapRangeWF_w0 hv.toWPairDisjWF β₁ 0
      simp only [Fin.cons_zero] at h
      rw [hc_β₁, hwd_β₁, hrd_β₁] at h
      exact h
    have hwd_β₂ : β₂ wDum = if β (rFull128 ctrl) = 1 then rVal else 0 := by
      have h := cswapRangeWF_w1 hv.toWPairDisjWF β₁ 0
      simp only [Fin.cons_zero] at h
      rw [hc_β₁, hwd_β₁, hrd_β₁] at h
      exact h
    have hc_β₂ : β₂ (rFull128 ctrl) = β (rFull128 ctrl) := by
      dsimp only [β₂]
      rw [cswapRangeWF_other (ctrl := rFull128 ctrl) β₁ hv.ctrl_w0 hv.ctrl_w1, hc_β₁]
    dsimp only [cUninit]
    rw [ket_CNOT, ket_TOFF]
    have hrd_sum : β₂ rDum + β₂ wDum = rVal := by
      rw [hrd_β₂, hwd_β₂]
      split_ifs <;> simp
    have hwd_cancel :
        Function.update β₂ rDum rVal wDum +
          Function.update β₂ rDum rVal rDum * Function.update β₂ rDum rVal (rFull128 ctrl) = 0 := by
      rw [Function.update_of_ne hrd_wd.symm, Function.update_self,
        Function.update_of_ne hrd_c.symm, hwd_β₂, hc_β₂]
      rcases bit_cases (β (rFull128 ctrl)) with hc0 | hc1 <;>
        rcases bit_cases rVal with hr0 | hr1 <;> simp_all
    rw [hrd_sum, hwd_cancel]
    let β₄ := Function.update (Function.update β₂ rDum rVal) wDum 0
    dsimp only [cRestore]
    rw [eval_seq_mulVec, ket_cnotPairToTargetSeqWF R w0N w1N rDum _ _ β₄, ket_X]
    have hw0_β₄ : ∀ i : Fin R, β₄ (w0N i) = if β (rFull128 ctrl) = 1 then 0 else β (w0N i) :=
      fun i ↦ by
      dsimp only [β₄]
      rw [Function.update_of_ne (hDisjExtra.ne (w0 i) _),
        Function.update_of_ne (hDisjExtra.ne (w0 i) _)]
      have h := cswapRangeWF_w0 hv.toWPairDisjWF β₁ i.succ
      simp only [Fin.cons_succ] at h
      have hw1_0 : β₁ (w1N i) = 0 := by
        dsimp only [β₁]; rw [Function.update_of_ne (hDisjExtra.ne (w1 i) _)]
        exact hW1Zero _ hL.1 i
      have hw0_eq : β₁ (w0N i) = β (w0N i) := by
        dsimp only [β₁]; rw [Function.update_of_ne (hDisjExtra.ne (w0 i) _)]
      rw [hc_β₁, hw1_0, hw0_eq] at h
      exact h
    have hw1_β₄ : ∀ i : Fin R, β₄ (w1N i) = if β (rFull128 ctrl) = 1 then β (w0N i) else 0 :=
      fun i ↦ by
      dsimp only [β₄]
      rw [Function.update_of_ne (hDisjExtra.ne (w1 i) _),
        Function.update_of_ne (hDisjExtra.ne (w1 i) _)]
      have h := cswapRangeWF_w1 hv.toWPairDisjWF β₁ i.succ
      simp only [Fin.cons_succ] at h
      have hw1_0 : β₁ (w1N i) = 0 := by
        dsimp only [β₁]; rw [Function.update_of_ne (hDisjExtra.ne (w1 i) _)]
        exact hW1Zero _ hL.1 i
      have hw0_eq : β₁ (w0N i) = β (w0N i) := by
        dsimp only [β₁]; rw [Function.update_of_ne (hDisjExtra.ne (w0 i) _)]
      rw [hc_β₁, hw1_0, hw0_eq] at h
      exact h
    have hpair_sum : (∑ i : Fin R, (β₄ (w0N i) + β₄ (w1N i))) = ∑ i : Fin R, β (w0N i) := by
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [hw0_β₄ i, hw1_β₄ i]
      split_ifs <;> simp
    have hrd_β₄ : β₄ rDum = rVal := by
      dsimp only [β₄]; rw [Function.update_of_ne hrd_wd, Function.update_self]
    have hrd_zero : rVal + ∑ i : Fin R, β (w0N i) + 1 = 0 := by
      dsimp only [rVal]
      rw [add_assoc (1 : ZMod 2), CharTwo.add_self_eq_zero, add_zero, CharTwo.add_self_eq_zero]
    rw [hrd_β₄, hpair_sum, Function.update_self, Function.update_idem, hrd_zero]
    have hEmb := embedUnitary_mulVec_ket_of_ket rFull128 (pForkGroupPos m ctrl w0 w1).toCircuit.eval
      β (cswapRangeWF R ctrl w0 w1 (fun u ↦ β (rFull128 u)))
      (ket_pForkGroupPos_eq_cswap m ctrl w0 w1 hd (fun u ↦ β (rFull128 u)) (hW1Zero _ hL.1))
    rw [hEmb]
    congr 1; funext u
    by_cases hur : u = rDum
    · subst hur
      rw [Function.update_self,
        writeRegProg_apply_of_not_mem _ _ _ _ (fun ⟨z, hz⟩ ↦ hDisjExtra.ne z _ hz),
        hL.2 ⟨0, by decide⟩]
    · rw [Function.update_of_ne hur]
      by_cases huw : u = wDum
      · subst huw
        dsimp only [β₄]
        rw [Function.update_self,
          writeRegProg_apply_of_not_mem _ _ _ _ (fun ⟨z, hz⟩ ↦ hDisjExtra.ne z _ hz),
          hL.2 ⟨1, by decide⟩]
      · by_cases hm128 : u ∈ Set.range rFull128.wires
        · obtain ⟨z, rfl⟩ := hm128
          rw [writeRegProg_apply_reg]
          by_cases hz0 : ∃ i : Fin R, z = w0 i
          · obtain ⟨i, rfl⟩ := hz0
            rw [hw0_β₄ i, cswapRangeWF_w0 hd (fun x ↦ β (rFull128 x)) i,
              hW1Zero _ hL.1 i]
          · by_cases hz1 : ∃ i : Fin R, z = w1 i
            · obtain ⟨i, rfl⟩ := hz1
              rw [hw1_β₄ i, cswapRangeWF_w1 hd (fun x ↦ β (rFull128 x)) i,
                hW1Zero _ hL.1 i]
            · rw [cswapRangeWF_other (fun x ↦ β (rFull128 x))
                (fun i he ↦ hz0 ⟨i, he⟩) (fun i he ↦ hz1 ⟨i, he⟩)]
              dsimp only [β₄, β₂, β₁]
              rw [Function.update_of_ne huw, Function.update_of_ne hur,
                cswapRangeWF_other _
                  (@Fin.cases R (fun k ↦ rFull128 z ≠ w0Cons k) hur
                    (fun i he ↦ hz0 ⟨i, rFull128.wires.injective he⟩))
                  (@Fin.cases R (fun k ↦ rFull128 z ≠ w1Cons k) huw
                    (fun i he ↦ hz1 ⟨i, rFull128.wires.injective he⟩)),
                Function.update_of_ne hur]
        · rw [writeRegProg_apply_of_not_mem _ _ _ _ hm128]
          dsimp only [β₄, β₂, β₁]
          rw [Function.update_of_ne huw, Function.update_of_ne hur,
            cswapRangeWF_other _
              (@Fin.cases R (fun k ↦ u ≠ w0Cons k) hur (fun i he ↦ hm128 ⟨w0 i, he.symm⟩))
              (@Fin.cases R (fun k ↦ u ≠ w1Cons k) huw (fun i he ↦ hm128 ⟨w1 i, he.symm⟩)),
            Function.update_of_ne hur]
  · simp only [hL, ↓reduceIte, Matrix.mulVec_zero]


noncomputable def wForkWrap {Var : Type} {n : ℕ} (v : Var)
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (m : ℕ) (ctrl : Wire 128) (w0 w1 : Fin (m + 1) → Wire 128)
    (hd : WPairDisjWF (m + 1) ctrl w0 w1)
    (body : DynamicCircuit Var n) : DynamicCircuit Var n :=
  .seq (dWForkOpen v rFull128 rExtra9 hDisjExtra (m + 1) ctrl w0 w1 hd)
    (.seq body (closeDyn (pForkGroupPos m ctrl w0 w1) v rFull128))


theorem count_toff_wForkWrap {Var : Type} {n : ℕ} (v : Var)
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (m : ℕ) (ctrl : Wire 128) (w0 w1 : Fin (m + 1) → Wire 128)
    (hd : WPairDisjWF (m + 1) ctrl w0 w1)
    (body : DynamicCircuit Var n) :
    (wForkWrap v rFull128 rExtra9 hDisjExtra m ctrl w0 w1 hd body).count PrimitiveGate.TOFF =
      body.count PrimitiveGate.TOFF := by
  simp [wForkWrap, DynamicCircuit.count, dWForkOpen_count_toff, count_toff_closeDyn]


theorem count_t_wForkWrap {Var : Type} {n : ℕ} (v : Var)
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (m : ℕ) (ctrl : Wire 128) (w0 w1 : Fin (m + 1) → Wire 128)
    (hd : WPairDisjWF (m + 1) ctrl w0 w1)
    (body : DynamicCircuit Var n) :
    (wForkWrap v rFull128 rExtra9 hDisjExtra m ctrl w0 w1 hd body).count PrimitiveGate.T =
      (2 * (m + 1) + 2) + body.count PrimitiveGate.T := by
  simp [wForkWrap, DynamicCircuit.count, dWForkOpen_count_t, count_t_closeDyn]


private theorem DynPair128.wForkGroup {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    {v : Var} {rFull128 : QRegister 128 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (m : ℕ) (ctrl : Wire 128) (w0 w1 : Fin (m + 1) → Wire 128)
    (hd : WPairDisjWF (m + 1) ctrl w0 w1)
    (clean : List (Wire 128)) (S : BitAssignment 128 → Prop)
    (hResp : RespectsClean clean S)
    (hOk : ((pForkGroupPos m ctrl w0 w1).checkProg clean).1 = true)
    (hW1Clean : ∀ i, w1 i ∈ clean)
    (hAtMostOne : ∀ α, S α → ∀ i j, i ≠ j → ¬ (α (w0 i) = 1 ∧ α (w0 j) = 1))
    {t : ℕ} {bFwd bInv : DynamicCircuit Var n} {U_body : Unitary (2 ^ 128)}
    (hb : DynPair128 v rFull128 rExtra9 ((pForkGroupPos m ctrl w0 w1).PostInv S) t bFwd bInv U_body)
      :
    DynPair128 v rFull128 rExtra9 S (t + (2 * (m + 1) + 2))
      (wForkWrap v rFull128 rExtra9 hDisjExtra m ctrl w0 w1 hd bFwd)
      (wForkWrap v rFull128 rExtra9 hDisjExtra m ctrl w0 w1 hd bInv)
      ((pForkGroupPos m ctrl w0 w1).toCircuit.inverse.eval * U_body *
        (pForkGroupPos m ctrl w0 w1).toCircuit.eval) := by
  let p := pForkGroupPos m ctrl w0 w1
  obtain ⟨hFwd_loc, hBwd_loc, hClose⟩ := closeDyn_spec (v := v) hDisjExtra p clean S hResp hOk
  have hOpen := dWForkOpen_realizes (v := v) hDisjExtra m ctrl w0 w1 hd S
    (fun α hα i ↦ hResp.1 α hα (w1 i) (hW1Clean i)) hAtMostOne
  have hCleanOpen := diagProj_Lift128_mul_embedUnitary rFull128 rExtra9 hDisjExtra
    S (p.PostInv S) p.toCircuit.eval hFwd_loc
  have hCleanBodyFwd := diagProj_Lift128_mul_embedUnitary rFull128 rExtra9 hDisjExtra
    (p.PostInv S) (p.PostInv S) U_body hb.presLoc
  have hInvBody_loc := diagProj_mul_inv_of_self (p.PostInv S) U_body hb.presLoc
  have hCleanBodyInv := diagProj_Lift128_mul_embedUnitary rFull128 rExtra9 hDisjExtra
    (p.PostInv S) (p.PostInv S) U_body⁻¹ hInvBody_loc
  have hBC_fwd := RealizesCleanUnitary_seq_asym
    (diagProj_conjTranspose _) (diagProj_conjTranspose _) hb.realFwd hClose hCleanBodyFwd
  have hBC_inv := RealizesCleanUnitary_seq_asym
    (diagProj_conjTranspose _) (diagProj_conjTranspose _) hb.realInv hClose hCleanBodyInv
  have hAll_fwd := RealizesCleanUnitary_seq_asym
    (diagProj_conjTranspose _) (diagProj_conjTranspose _) hOpen hBC_fwd hCleanOpen
  have hAll_inv := RealizesCleanUnitary_seq_asym
    (diagProj_conjTranspose _) (diagProj_conjTranspose _) hOpen hBC_inv hCleanOpen
  have hEmbFwd :
      (rFull128.embedUnitary p.toCircuit.inverse.eval * rFull128.embedUnitary U_body) *
        rFull128.embedUnitary p.toCircuit.eval =
      rFull128.embedUnitary (p.toCircuit.inverse.eval * U_body * p.toCircuit.eval) := by
    rw [← rFull128.embedUnitary_mul, ← rFull128.embedUnitary_mul]
  have hU_inv_eq :
      (p.toCircuit.inverse.eval * U_body * p.toCircuit.eval)⁻¹ =
        p.toCircuit.inverse.eval * U_body⁻¹ * p.toCircuit.eval := by
    rw [unitary_mul_inv_rev, unitary_mul_inv_rev, Circuit.eval_inverse, inv_inv,
      ← unitary_mul_assoc]
  have hEmbInv :
      (rFull128.embedUnitary p.toCircuit.inverse.eval * rFull128.embedUnitary U_body⁻¹) *
        rFull128.embedUnitary p.toCircuit.eval =
      rFull128.embedUnitary (p.toCircuit.inverse.eval * U_body * p.toCircuit.eval)⁻¹ := by
    rw [hU_inv_eq, ← rFull128.embedUnitary_mul, ← rFull128.embedUnitary_mul]
  exact {
    toffFwd := by rw [count_toff_wForkWrap, hb.toffFwd]
    toffInv := by rw [count_toff_wForkWrap, hb.toffInv]
    tFwd := by rw [count_t_wForkWrap]; have := hb.tFwd; omega
    tInv := by rw [count_t_wForkWrap]; have := hb.tInv; omega
    storeFwd := PreservesStoreConst.seq (dWForkOpen_store v _ _ _ _ _ _ _ _)
      (PreservesStoreConst.seq hb.storeFwd (store_closeDyn p v rFull128))
    storeInv := PreservesStoreConst.seq (dWForkOpen_store v _ _ _ _ _ _ _ _)
      (PreservesStoreConst.seq hb.storeInv (store_closeDyn p v rFull128))
    presLoc := by
      calc diagProj S * ((p.toCircuit.inverse.eval * U_body * p.toCircuit.eval).1 * diagProj S)
          = diagProj S * (p.toCircuit.inverse.eval.1 *
              (U_body.1 * (p.toCircuit.eval.1 * diagProj S))) := by
              simp [Submonoid.coe_mul, Matrix.mul_assoc]
        _ = diagProj S * (p.toCircuit.inverse.eval.1 *
              (U_body.1 * (diagProj (p.PostInv S) * (p.toCircuit.eval.1 * diagProj S)))) := by
              rw [hFwd_loc]
        _ = diagProj S * (p.toCircuit.inverse.eval.1 *
              ((U_body.1 * diagProj (p.PostInv S)) * (p.toCircuit.eval.1 * diagProj S))) := by
              simp [Matrix.mul_assoc]
        _ = diagProj S * (p.toCircuit.inverse.eval.1 *
              ((diagProj (p.PostInv S) * (U_body.1 * diagProj (p.PostInv S))) *
                (p.toCircuit.eval.1 * diagProj S))) := by rw [hb.presLoc]
        _ = (diagProj S * (p.toCircuit.inverse.eval.1 * diagProj (p.PostInv S))) *
              ((U_body.1 * diagProj (p.PostInv S)) * (p.toCircuit.eval.1 * diagProj S)) := by
              simp [Matrix.mul_assoc]
        _ = (p.toCircuit.inverse.eval.1 * diagProj (p.PostInv S)) *
              ((U_body.1 * diagProj (p.PostInv S)) * (p.toCircuit.eval.1 * diagProj S)) := by
              rw [hBwd_loc]
        _ = p.toCircuit.inverse.eval.1 *
              ((diagProj (p.PostInv S) * (U_body.1 * diagProj (p.PostInv S))) *
                (p.toCircuit.eval.1 * diagProj S)) := by simp [Matrix.mul_assoc]
        _ = p.toCircuit.inverse.eval.1 *
              ((U_body.1 * diagProj (p.PostInv S)) * (p.toCircuit.eval.1 * diagProj S)) := by
              rw [hb.presLoc]
        _ = (p.toCircuit.inverse.eval * U_body * p.toCircuit.eval).1 * diagProj S := by
              rw [Matrix.mul_assoc, hFwd_loc]; simp [Submonoid.coe_mul, Matrix.mul_assoc]
    realFwd := hEmbFwd ▸ hAll_fwd
    realInv := hEmbInv ▸ hAll_inv
  }

