def badAncPoly (a1 a2 a3 a4 a5 a6 a7 c0h : ZMod 2) : ZMod 2 :=
  let s0 := a1 * a2
  let s1 := s0 + a1 + a2
  let s2 := a3 * a4
  let s3 := s2 * s1
  let s4 := a5 * s3 + a5 + s3
  let s5 := a6 * a7
  let s6 := s5 * s4
  c0h * (s0 + s6) + s6


theorem badAncPoly_bits :
    ∀ a1 a2 a3 a4 a5 a6 a7 c0h : ZMod 2,
      badAncPoly a1 a2 a3 a4 a5 a6 a7 c0h =
      if c0h = 1 then
        if a1 = 1 ∧ a2 = 1 then 1 else 0
      else
        if a1.val + 2 * a2.val + 4 * a3.val + 8 * a4.val + 16 * a5.val +
            32 * a6.val + 64 * a7.val < 109 then 0 else 1 := by
  decide


