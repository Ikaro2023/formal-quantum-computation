private theorem cHsDepth5_of_onehot (idx : Fin 20) (s : TeleSpec)
    (words : (k : Fin 1) → Fin (2 ^ k.val) → TeleSpec)
    (hbwd : s.bwdOdds.length = 18) (hfwd : s.fwdOdds.length = 18)
    (hbrIdx : hsBranchesIdx_5.filter (fun p => p.1 == idx) = [(idx, s)])
    (hflIdx : hsFlipsIdx_5.filter (fun i => i == idx) = [])
    (hw : s = words 0 0) (β : BitAssignment 128)
    (hOH : OneHotScr21 idx.val β) (hr : ∀ i : Fin 1, β (rKSub1 i) = 0) :
    cHsDepth5.eval.1.mulVec (ket β) =
      ∑ j : Fin (2 ^ 1), teleSbmAmp 1 words j • ket (writeReg β rKSub1 (basisBits 1 j)) := by
  rw [cHsDepth5, cHsSplit_5]
  have hbr : hsBranches_5.filter (fun q => β q.1 == 1) = [(scr20_128 idx, s)] :=
    (filter_scr20_branches idx hsBranchesIdx_5 β hOH).trans
      (congrArg (List.map fun p => (scr20_128 p.1, p.2)) hbrIdx)
  have hfl : hsFlips_5.filter (fun q => β q == 1) = [] :=
    (filter_scr20_flips idx hsFlipsIdx_5 β hOH).trans (congrArg (List.map scr20_128) hflIdx)
  rw [cTeleMux_mulVec_ket_onehot 18 hsBranches_5 hsFlips_5 wPmPar_128 (rK_128 ⟨0, by decide⟩)
    (scr20_128 idx) s hsSplitDisj_5 hbwd hfwd β (oneHotScr21_wPmPar_zero idx β hOH) (hr 0)
    hbr hfl, hw, sum_teleSbmAmp_one words β hr]

private def forkChain (t : Wire 128) (ps : List (Fin 20 × Fin 20)) (base : Circuit 128) :
    Circuit 128 :=
  ps.foldr (fun p acc => withUnaryFork (scr20_128 p.1) t (scr20_128 p.2) acc) base

private def forksInactOk (cur : Fin 20) (ps : List (Fin 20 × Fin 20)) : Bool :=
  ps.all fun p => (p.1 != p.2) && (p.1 != cur) && (p.2 != cur)

private theorem forkChain_append (t : Wire 128) (ps1 ps2 : List (Fin 20 × Fin 20))
    (base : Circuit 128) :
    forkChain t (ps1 ++ ps2) base = forkChain t ps1 (forkChain t ps2 base) := by
  induction ps1 with
  | nil => rfl
  | cons p ps1 ih => exact congrArg (withUnaryFork (scr20_128 p.1) t (scr20_128 p.2)) ih

private theorem forkChain_inact {m : ℕ} (rLow : QRegister m 128)
    (hrVal : ∀ i : Fin m, (rLow i).val = 69 + i.val) (cur : Fin 20) (t : Wire 128)
    (ps : List (Fin 20 × Fin 20)) (base : Circuit 128) (amp : Fin (2 ^ m) → ℂ)
    (γ : BitAssignment 128) (hok : forksInactOk cur ps = true)
    (ht : 69 + m ≤ t.val ∧ t.val < 86) (hOH : OneHotScr21 cur.val γ)
    (hbase : base.eval.1.mulVec (ket γ) =
      ∑ x : Fin (2 ^ m), amp x • ket (writeReg γ rLow (basisBits m x))) :
    (forkChain t ps base).eval.1.mulVec (ket γ) =
      ∑ x : Fin (2 ^ m), amp x • ket (writeReg γ rLow (basisBits m x)) := by
  induction ps with
  | nil => exact hbase
  | cons p ps ih =>
    change (((p.1 != p.2) && (p.1 != cur) && (p.2 != cur)) && forksInactOk cur ps) = true at hok
    rw [Bool.and_eq_true] at hok
    rcases hok with ⟨hhead, htail⟩
    simp only [Bool.and_eq_true, bne_iff_ne] at hhead
    exact withUnaryFork_ket_inactive_sum rLow hrVal cur p.1 p.2 t (forkChain t ps base) amp γ
      hhead.1.1 hhead.1.2 hhead.2 ht hOH (ih htail)

