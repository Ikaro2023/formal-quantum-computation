    have hM : (m1_67 ^^^ Δ0) &&& maskC1_67_cert = (neg1.val * 2 ^ 11) ^^^ (c1.val * 2 ^ 40) := by
      rw [nat_and_xor_of_disjoint76 hΔ0_C1, hm1_C1_67]
    rw [runMask67_decomp_inMask_cert hAx1In67 (m1_67 ^^^ Δ0), hM, h67_1, nat_xor_decomp_cancel76]
  have hStageC2 : runMask67 stageCAxis2_67 ((m1_67 ^^^ Δ0) ^^^ Δ1) =
