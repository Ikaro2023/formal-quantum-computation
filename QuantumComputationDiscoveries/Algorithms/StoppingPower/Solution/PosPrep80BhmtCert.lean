theorem uPosPostEff86_Bhmt_ancIdx86_update_31 (s0 : Bool) (p : BitAssignment 80) :
    uPosPostEff86_Bhmt.1
        (ancIdx86 s0 (Function.update p PosS3Bounds.idxTh80 (p PosS3Bounds.idxTh80 + 1)))
