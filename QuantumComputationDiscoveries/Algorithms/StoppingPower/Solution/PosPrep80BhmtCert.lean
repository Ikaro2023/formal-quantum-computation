theorem evalProg152_pJa8_bool (δ0 : BitAssignment 152)
    (a1 a2 a3 a4 a5 a6 a7 c29 ep ih c0 : Bool)
    (hInitJa : ∀ i : Reg22, δ0 (embJa i) =
      b2z (getB22 (St22.mk a1 a2 a3 a4 a5 a6 a7 c29
        (c0hBool ep ih c0) (s4hBool ep ih c0) (etBool ep ih)
        false false false false false false false false false false false) i)) :
    evalProg152 pJa8Steps152 δ0 (scr21_152 16) = 0 ∧
