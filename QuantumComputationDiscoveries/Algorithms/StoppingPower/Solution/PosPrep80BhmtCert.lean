noncomputable def liftVecPoly {m N : ℕ} (r : QRegister m N) (α₀ : BitAssignment N)
    (v : Fin (2 ^ m) → ℂ) : Fin (2 ^ N) → ℂ :=
  ∑ l : Fin (2 ^ m), v l • ket (ZeroAncillaUSPS3.writeReg α₀ r (basisBits m l))


theorem liftVecPoly_zero {m N : ℕ} (r : QRegister m N) (α₀ : BitAssignment N) :
    liftVecPoly r α₀ 0 = 0 := by
  simp only [liftVecPoly, Pi.zero_apply, zero_smul, Finset.sum_const_zero]


private theorem liftVecPoly_add {m N : ℕ} (r : QRegister m N) (α₀ : BitAssignment N)
    (u v : Fin (2 ^ m) → ℂ) :
    liftVecPoly r α₀ (u + v) = liftVecPoly r α₀ u + liftVecPoly r α₀ v := by
  simp only [liftVecPoly, Pi.add_apply, add_smul, Finset.sum_add_distrib]


private theorem liftVecPoly_smul {m N : ℕ} (r : QRegister m N) (α₀ : BitAssignment N)
    (c : ℂ) (v : Fin (2 ^ m) → ℂ) :
    liftVecPoly r α₀ (c • v) = c • liftVecPoly r α₀ v := by
  simp only [liftVecPoly, Pi.smul_apply, smul_eq_mul, ← smul_smul, ← Finset.smul_sum]


open Classical in
private theorem liftVecPoly_sum {m N : ℕ} {ι : Type*} (r : QRegister m N) (α₀ : BitAssignment N)
    (s : Finset ι) (f : ι → Fin (2 ^ m) → ℂ) :
    liftVecPoly r α₀ (∑ i ∈ s, f i) = ∑ i ∈ s, liftVecPoly r α₀ (f i) := by
  induction s using Finset.induction_on with
  | empty => simp [liftVecPoly_zero]
  | insert a s ha ih =>
      rw [Finset.sum_insert ha, liftVecPoly_add, ih, Finset.sum_insert ha]


theorem liftVecPoly_ket {m N : ℕ} (r : QRegister m N) (α₀ : BitAssignment N)
    (δ : BitAssignment m) :
    liftVecPoly r α₀ (ket δ) = ket (ZeroAncillaUSPS3.writeReg α₀ r δ) := by
  dsimp only [liftVecPoly]
  rw [ket_eq_single_local δ, Finset.sum_eq_single ((basisBitsEquiv m).symm δ)]
  · have hb : basisBits m ((basisBitsEquiv m).symm δ) = δ := (basisBitsEquiv m).apply_symm_apply δ
    rw [Pi.single_eq_same, one_smul, hb]
  · intro l _ hl
    rw [Pi.single_eq_of_ne hl, zero_smul]
  · intro hmem
    exact absurd (Finset.mem_univ _) hmem


private theorem embedUnitary_mulVec_liftVecPoly {m N : ℕ} (r : QRegister m N) (α₀ : BitAssignment N)
    (V : Unitary (2 ^ m)) (v : Fin (2 ^ m) → ℂ) :
    (r.embedUnitary V).1.mulVec (liftVecPoly r α₀ v) = liftVecPoly r α₀ (V.1.mulVec v) := by
  have hket : ∀ δ : BitAssignment m,
      (r.embedUnitary V).1.mulVec (ket (ZeroAncillaUSPS3.writeReg α₀ r δ)) =
        liftVecPoly r α₀ (V.1.mulVec (ket δ)) := fun δ ↦ by
    have hsub : (fun i : Fin m ↦ ZeroAncillaUSPS3.writeReg α₀ r δ (r i)) = δ :=
      funext fun i ↦ ZeroAncillaUSPS3.writeReg_apply_reg α₀ r δ i
    rw [QRegister.embedUnitary_val, embedMatrix_mulVec_ket_sub]
    dsimp only [liftVecPoly]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    rw [← ket_localIdxSub_eq r (ZeroAncillaUSPS3.writeReg α₀ r δ) l V.1, hsub]
    refine congrArg (V.1.mulVec (ket δ) l • ket ·) ?_
    rw [writeReg_eq]
    funext w
    by_cases hw : ∃ i : Fin m, r i = w
    · obtain ⟨i, rfl⟩ := hw
      rw [ZeroAncillaUSPS3.writeReg_apply_reg, ZeroAncillaUSPS3.writeReg_apply_reg]
    · rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hw,
        ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hw,
        ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hw]
  conv_lhs => rw [mulVec_eq_sum_ket v]
  conv_rhs => rw [mulVec_eq_sum_ket v]
  rw [liftVecPoly_sum, Matrix.mulVec_sum, Matrix.mulVec_sum, liftVecPoly_sum]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [liftVecPoly_smul, liftVecPoly_ket, Matrix.mulVec_smul, Matrix.mulVec_smul,
    liftVecPoly_smul, hket]


theorem liftBits128_zero : liftBits128 0 = 0 := by
  funext w
  dsimp only [liftBits128]
  split_ifs <;> rfl


noncomputable def liftVec128 (v : Fin (2 ^ 128) → ℂ) : Fin (2 ^ 152) → ℂ :=
  liftVecPoly rSub128 0 v


private theorem liftVec128_add (u v : Fin (2 ^ 128) → ℂ) :
    liftVec128 (u + v) = liftVec128 u + liftVec128 v :=
  liftVecPoly_add rSub128 0 u v


private theorem liftVec128_smul (c : ℂ) (v : Fin (2 ^ 128) → ℂ) :
    liftVec128 (c • v) = c • liftVec128 v :=
  liftVecPoly_smul rSub128 0 c v


private theorem liftVec128_sum {ι : Type*} (s : Finset ι) (f : ι → Fin (2 ^ 128) → ℂ) :
    liftVec128 (∑ i ∈ s, f i) = ∑ i ∈ s, liftVec128 (f i) :=
  liftVecPoly_sum rSub128 0 s f


theorem liftVec128_ket (β : BitAssignment 128) :
    liftVec128 (ket β) = ket (liftBits128 β) := by
  rw [liftVec128, liftVecPoly_ket, ← liftBits128_zero, writeReg_liftBits128_rSub128]


private theorem embedSub128_mulVec_lift_vec (V : Unitary (2 ^ 128)) (v : Fin (2 ^ 128) → ℂ) :
    (rSub128.embedUnitary V).1.mulVec (liftVec128 v) = liftVec128 (V.1.mulVec v) :=
  embedUnitary_mulVec_liftVecPoly rSub128 0 V v


theorem liftBits128_update {β : BitAssignment 128} (w : Wire 128) (b : ZMod 2) :
    liftBits128 (Function.update β w b) = Function.update (liftBits128 β) (rSub128 w) b := by
  funext u
  by_cases hu : u = rSub128 w
  · subst hu
    rw [Function.update_self]
    dsimp only [liftBits128]
    have hlt : (rSub128 w).val < 128 := by rw [rSub128_val]; exact w.isLt
    rw [dite_eq_left hlt]
    have hwEq : (⟨(rSub128 w).val, hlt⟩ : Wire 128) = w := by ext; exact rSub128_val w
    rw [hwEq, Function.update_self]
  · rw [Function.update_of_ne hu]
    dsimp only [liftBits128]
    by_cases hlt : u.val < 128
    · rw [dite_eq_left hlt, dite_eq_left hlt]
      have hne128 : (⟨u.val, hlt⟩ : Wire 128) ≠ w := fun heq ↦ hu <| by
        ext; rw [rSub128_val, ← heq]
      rw [Function.update_of_ne hne128]
    · rw [dite_eq_right hlt, dite_eq_right hlt]


theorem liftBits128_writeReg_compose {m : ℕ} (β : BitAssignment 128)
    (r : QRegister m 128) (q : BitAssignment m) :
    liftBits128 (ZeroAncillaUSPS3.writeReg β r q) =
      ZeroAncillaUSPS3.writeReg (liftBits128 β) (rSub128.compose r) q := by
  funext u
  by_cases hmem : ∃ i : Fin m, (rSub128.compose r) i = u
  · obtain ⟨i, rfl⟩ := hmem
    rw [ZeroAncillaUSPS3.writeReg_apply_reg]
    have hcomp : (rSub128.compose r) i = rSub128 (r i) := rfl
    rw [hcomp]
    dsimp only [liftBits128]
    have hlt : (rSub128 (r i)).val < 128 := by rw [rSub128_val]; exact (r i).isLt
    rw [dite_eq_left hlt]
    have hrEq : (⟨(rSub128 (r i)).val, hlt⟩ : Wire 128) = r i := by ext; exact rSub128_val (r i)
    rw [hrEq, ZeroAncillaUSPS3.writeReg_apply_reg]
  · rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hmem]
    dsimp only [liftBits128]
    by_cases hlt : u.val < 128
    · rw [dite_eq_left hlt, dite_eq_left hlt]
      have hnot128 : ¬∃ i : Fin m, r i = ⟨u.val, hlt⟩ := by
        rintro ⟨i, hi⟩
        exact hmem ⟨i, by ext; change (rSub128 (r i)).val = u.val; rw [rSub128_val, hi]⟩
      rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hnot128]
    · rw [dite_eq_right hlt, dite_eq_right hlt]


private theorem unHadamardList_append {N : ℕ} (c : Wire N) (qs₁ qs₂ : List (Wire N))
    (v : Fin (2 ^ N) → ℂ) :
    (unHadamardList c (qs₁ ++ qs₂)).eval.1.mulVec v =
      (unHadamardList c qs₁).eval.1.mulVec ((unHadamardList c qs₂).eval.1.mulVec v) := by
  induction qs₁ generalizing v with
  | nil =>
      simp [unHadamardList]
  | cons q qs ih =>
      rw [List.cons_append, unHadamardList, unHadamardList,
        eval_seq_mulVec, eval_seq_mulVec, ih]


theorem chIf_mulVec_uniform_pair_poly {N : ℕ} (ctrl t : Wire N) (hct : ctrl ≠ t)
    (δ : BitAssignment N) (hc : δ ctrl = 1) (ht : δ t = 0) :
    (chIf ctrl t).eval.1.mulVec
        (∑ b : ZMod 2, (1 / √(2 : ℝ) : ℂ) • ket (Function.update δ t b)) =
      ket δ := by
  have hZ2 : (Finset.univ : Finset (ZMod 2)) = {0, 1} := by decide
  have hne01 : (0 : ZMod 2) ≠ 1 := by decide
  have hc0 : Function.update δ t 0 ctrl = 1 := by rw [Function.update_of_ne hct, hc]
  have hc1 : Function.update δ t 1 ctrl = 1 := by rw [Function.update_of_ne hct, hc]
  have hmul : (1 / √(2 : ℝ) : ℂ) * sqrtHalf = 1 / 2 := by
    rw [← sqrtHalf_eq_one_div_sqrt2, sqrtHalf_mul_sqrtHalf]
  have hs0 : bitSign 0 = 1 := rfl
  have hs1 : bitSign 1 = -1 := by simp [bitSign, (by decide : (1 : ZMod 2) ≠ 0)]
  have hup0 : Function.update δ t 0 = δ := by rw [← ht]; exact Function.update_eq_self t δ
  rw [hZ2, Finset.sum_pair hne01, Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
    ← chIf_eq,
    chIf_mulVec_ket_one ctrl t hct _ hc0,
    chIf_mulVec_ket_one ctrl t hct _ hc1,
    ket_H, ket_H]
  simp only [Function.update_self, Function.update_idem, hs0, hs1,
    mul_one, mul_neg, smul_add, smul_smul, hmul, hup0]
  let v0 := ket δ
  let v1 := ket (Function.update δ t 1)
  change ((1 / 2 : ℂ) • v0 + (1 / 2 : ℂ) • v1) +
      ((1 / 2 : ℂ) • v0 + (-(1 / 2 : ℂ)) • v1) = v0
  rw [add_add_add_comm, ← add_smul, ← add_smul]
  norm_num


theorem unHadamardList_ofFn_mulVec_uniform_ket :
    ∀ {m N : ℕ} (ctrl : Wire N) (r : QRegister m N) (β : BitAssignment N),
      (∀ i : Fin m, ctrl ≠ r i) →
      β ctrl = 1 →
      (∀ i : Fin m, β (r i) = 0) →
      (unHadamardList ctrl (List.ofFn r.wires)).eval.1.mulVec
        (∑ q : BitAssignment m,
          ((1 / √(2 : ℝ) : ℂ) ^ m) • ket (ZeroAncillaUSPS3.writeReg β r q)) =
        ket β
  | 0, _, ctrl, r, β, _, _, _ => by
      have hnil : List.ofFn r.wires = [] := by simp
      have huniq : (Finset.univ : Finset (BitAssignment 0)) = {default} := by
        ext q
        exact ⟨fun _ ↦ Finset.mem_singleton.mpr (funext fun i ↦ Fin.elim0 i),
          fun _ ↦ Finset.mem_univ q⟩
      have hw : ZeroAncillaUSPS3.writeReg β r default = β :=
        funext fun _ ↦ ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _
          (by rintro ⟨i, _⟩; exact Fin.elim0 i)
      rw [hnil, unHadamardList, Circuit.eval_identity, OneMemClass.coe_one, Matrix.one_mulVec,
        huniq, Finset.sum_singleton, pow_zero, one_smul, hw]
  | k + 1, N, ctrl, r, β, hcr, hc, hz => by
      let rTail : QRegister k N := r.compose (QRegister.block 1 k (by omega))
      have hTail : ∀ j : Fin k, rTail j = r j.succ := fun j ↦ by
        dsimp [rTail, QRegister.compose, QRegister.compose_apply,
          PosPostPrep80CertS3Alt.qreg_compose_wires,
          PosPostPrep80CertS3Alt.qreg_whole_wires,
          PosPostPrep80CertS3Alt.emb_trans_apply,
          PosPostPrep80CertS3Alt.emb_refl_apply,
          PosPostPrep80CertS3Alt.emb_mk_apply,
          PosPostPrep80CertS3Alt.qreg_block_apply,
          PosPostPrep80CertS3Alt.qreg_block_wires_apply]
        congr 1; ext; dsimp; omega
      have hList : List.ofFn r.wires = r 0 :: List.ofFn rTail.wires := by
        rw [List.ofFn_succ]
        exact congrArg (List.cons (r 0)) (congrArg List.ofFn (funext fun j ↦ (hTail j).symm))
      let e : ZMod 2 × BitAssignment k ≃ BitAssignment (k + 1) :=
        { toFun := fun p ↦ Fin.cons p.1 p.2
          invFun := fun q ↦ (q 0, fun j ↦ q j.succ)
          left_inv := fun p ↦ Prod.ext (by simp) (funext fun j ↦ by simp)
          right_inv := fun q ↦ funext fun i ↦ Fin.cases rfl (fun _ ↦ rfl) i }
      have hpow : ((1 / √(2 : ℝ) : ℂ) ^ (k + 1)) =
          (1 / √(2 : ℝ) : ℂ) * ((1 / √(2 : ℝ) : ℂ) ^ k) := pow_succ' _ k
      have hSumSplit : (∑ q : BitAssignment (k + 1),
            ((1 / √(2 : ℝ) : ℂ) ^ (k + 1)) • ket (ZeroAncillaUSPS3.writeReg β r q)) =
          (1 / √(2 : ℝ) : ℂ) • (∑ qT : BitAssignment k,
            ((1 / √(2 : ℝ) : ℂ) ^ k) •
              ket (ZeroAncillaUSPS3.writeReg (Function.update β (r 0) 0) rTail qT)) +
          (1 / √(2 : ℝ) : ℂ) • (∑ qT : BitAssignment k,
            ((1 / √(2 : ℝ) : ℂ) ^ k) •
              ket (ZeroAncillaUSPS3.writeReg (Function.update β (r 0) 1) rTail qT)) := by
        rw [← Equiv.sum_comp e, Fintype.sum_prod_type]
        have hZ2 : (Finset.univ : Finset (ZMod 2)) = {0, 1} := by decide
        have hne01 : (0 : ZMod 2) ≠ 1 := by decide
        rw [hZ2, Finset.sum_pair hne01, Finset.smul_sum, Finset.smul_sum]
        congr 1 <;>
          (refine Finset.sum_congr rfl fun qT _ ↦ ?_
           simp only [Equiv.coe_fn_mk, e]
           rw [hpow, ← smul_smul, unH_tailReg_mem_range r β _ qT])
      have hcrT : ∀ j : Fin k, ctrl ≠ rTail j := fun j ↦ by rw [hTail j]; exact hcr j.succ
      have hcUpd : ∀ b₀ : ZMod 2, Function.update β (r 0) b₀ ctrl = 1 := fun b₀ ↦ by
        rw [Function.update_of_ne (hcr 0), hc]
      have hzUpd : ∀ (b₀ : ZMod 2) (j : Fin k), Function.update β (r 0) b₀ (rTail j) = 0 :=
        fun b₀ j ↦ by
          have hne : rTail j ≠ r 0 := by
            rw [hTail j]; exact fun h ↦ Fin.succ_ne_zero j (r.wires.injective h)
          rw [Function.update_of_ne hne, hTail j, hz j.succ]
      rw [hList, unHadamardList, eval_seq_mulVec, hSumSplit,
        Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        unHadamardList_ofFn_mulVec_uniform_ket ctrl rTail _ hcrT (hcUpd 0) (hzUpd 0),
        unHadamardList_ofFn_mulVec_uniform_ket ctrl rTail _ hcrT (hcUpd 1) (hzUpd 1)]
      have hPair :
          (1 / √(2 : ℝ) : ℂ) • ket (Function.update β (r 0) 0) +
          (1 / √(2 : ℝ) : ℂ) • ket (Function.update β (r 0) 1) =
          ∑ b : ZMod 2, (1 / √(2 : ℝ) : ℂ) • ket (Function.update β (r 0) b) := by
        have hZ2 : (Finset.univ : Finset (ZMod 2)) = {0, 1} := by decide
        rw [hZ2, Finset.sum_pair (by decide : (0 : ZMod 2) ≠ 1)]
      rw [hPair, chIf_mulVec_uniform_pair_poly ctrl (r 0) (hcr 0) β hc (hz 0)]


private theorem unHadamardList_ofFn_mulVec_fin_ket {m N : ℕ} (ctrl : Wire N) (r : QRegister m N)
    (β : BitAssignment N) (hcr : ∀ i : Fin m, ctrl ≠ r i)
    (hc : β ctrl = 1) (hz : ∀ i : Fin m, β (r i) = 0) :
    (unHadamardList ctrl (List.ofFn r.wires)).eval.1.mulVec
      (∑ x : Fin (2 ^ m),
        ((sqrtHalf : ℂ) ^ m) • ket (ZeroAncillaUSPS3.writeReg β r (basisBits m x))) =
      ket β := by
  have heq : (∑ x : Fin (2 ^ m),
        ((sqrtHalf : ℂ) ^ m) • ket (ZeroAncillaUSPS3.writeReg β r (basisBits m x))) =
      ∑ q : BitAssignment m,
        ((1 / √(2 : ℝ) : ℂ) ^ m) • ket (ZeroAncillaUSPS3.writeReg β r q) := by
    rw [sqrtHalf_eq_one_div_sqrt2]
    exact (basisBitsEquiv m).sum_comp
      (fun q ↦ ((1 / √(2 : ℝ) : ℂ) ^ m) • ket (ZeroAncillaUSPS3.writeReg β r q))
  rw [heq]
  exact unHadamardList_ofFn_mulVec_uniform_ket ctrl r β hcr hc hz

/-! ## Section C.3: `cPreMuxOpen128`, `152`-Wire Flag Commutations, & `uMuxWrapped152` Ket Evolution
-/


theorem cPreMuxOpen128_mulVec_sum (s0 : Bool) :
    let w0 : ℂ := (1 / √(2 : ℝ) : ℂ)
    let splitWord := if s0 then isHeadS0TrueSpec else isHeadS0FalseSpec
    cPreMuxOpen128.eval.1.mulVec
      (∑ q : BitAssignment 80, (w0 ^ 80) • ket (padZeroBits posPostHwa (ancBits86 s0 q))) =
    ∑ u2 : Fin (2 ^ 2),
      (((teleAlpha0 splitWord * w0 ^ 2) •
        (∑ qB0 : BitAssignment 3, ∑ qJ16 : BitAssignment 16, ∑ bPid0 : ZMod 2,
          ∑ qSm : BitAssignment 3, ∑ qJ : BitAssignment 33, ∑ qR21 : BitAssignment 21,
            (w0 ^ 3 * w0 ^ 16 * w0 * w0 ^ 3 * w0 ^ 33 * w0 ^ 21) •
              ket (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg
                (ZeroAncillaUSPS3.writeReg
                  (Function.update
                    (ZeroAncillaUSPS3.writeReg
                      (ZeroAncillaUSPS3.writeReg (βHead128 s0 u2) rB0_128 qB0)
                      rJoint16_128 qJ16)
                    (rPid_128 ⟨0, by decide⟩) bPid0)
                  rSm_128 qSm) rJoint33_128 qJ) rRest21_128 qR21))) +
       ((teleAlpha1 splitWord * w0 ^ 2) •
        (∑ qB0 : BitAssignment 3, ∑ qJ16 : BitAssignment 16, ∑ bPid0 : ZMod 2,
          ∑ qSm : BitAssignment 3, ∑ qJ : BitAssignment 33, ∑ qR21 : BitAssignment 21,
            (w0 ^ 3 * w0 ^ 16 * w0 * w0 ^ 3 * w0 ^ 33 * w0 ^ 21) •
              ket (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg
                (ZeroAncillaUSPS3.writeReg
                  (Function.update
                    (ZeroAncillaUSPS3.writeReg
                      (ZeroAncillaUSPS3.writeReg (βTail128 s0 u2) rB0_128 qB0)
                      rJoint16_128 qJ16)
                    (rPid_128 ⟨0, by decide⟩) bPid0)
                  rSm_128 qSm) rJoint33_128 qJ) rRest21_128 qR21)))) := by
  intro w0 splitWord
  rw [cPreMuxOpen128]
  iterate 3 rw [eval_seq_mulVec]
  have hOpenSum : cOpen_128.eval.1.mulVec
      (∑ q : BitAssignment 80,
        (w0 ^ 80) • ket (padZeroBits posPostHwa (ancBits86 s0 q))) =
      ∑ q : BitAssignment 80,
        (w0 ^ 80) • ket (ZeroAncillaUSPS3.writeReg (βInit128 s0) rP80_128 q) := by
    rw [Matrix.mulVec_sum]
    refine Finset.sum_congr rfl fun q _ ↦ ?_
    rw [Matrix.mulVec_smul,
      ket_cOpen_128 _ (padZero_ancBits_hi s0 q _ (by decide))
        (padZero_ancBits_hi s0 q _ (by decide)) (padZero_ancBits_hi s0 q _ (by decide)),
      openMap_ancBits_eq_writeReg s0 q]
  rw [hOpenSum]
  have hw80 : (w0 ^ 80 : ℂ) =
      w0 ^ 2 * (w0 ^ 3 * w0 ^ 16 * w0 * w0 ^ 3 * w0 ^ 33) * w0 ^ 21 * w0 := by ring
  let δBase (u2 : Fin (2 ^ 2)) (qB0 : BitAssignment 3) (qJ16 : BitAssignment 16)
      (bPid0 : ZMod 2) (qSm : BitAssignment 3) (qJ : BitAssignment 33)
      (qR21 : BitAssignment 21) : BitAssignment 128 :=
    ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg
      (Function.update
        (ZeroAncillaUSPS3.writeReg
          (ZeroAncillaUSPS3.writeReg (βU2_128 s0 u2) rB0_128 qB0) rJoint16_128 qJ16)
        (rPid_128 ⟨0, by decide⟩) bPid0)
      rSm_128 qSm) rJoint33_128 qJ) rRest21_128 qR21
  have hOutδ : ∀ u2 qB0 qJ16 bPid0 qSm qJ qR21 (w : Wire 128),
      (w.val < 6 ∨ 86 ≤ w.val ∨ w.val = 36) →
      δBase u2 qB0 qJ16 bPid0 qSm qJ qR21 w = βU2_128 s0 u2 w :=
    fun u2 qB0 qJ16 bPid0 qSm qJ qR21 w hw ↦ by
      dsimp only [δBase]
      rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (fun ⟨i, hi⟩ ↦ by
            have hr := rRest21_payload_not36 i; rw [hi] at hr; omega),
        ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (fun ⟨i, hi⟩ ↦ by
            have hr := rJoint33_payload_not36 i; rw [hi] at hr; omega),
        ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (fun ⟨i, hi⟩ ↦ by
            have hv := congrArg Fin.val hi
            dsimp [rSm_128, PosPostPrep80CertS3Alt.qreg_block_apply] at hv; omega),
        Function.update_of_ne (fun h ↦ by
            have hv := congrArg Fin.val h
            dsimp [rPid_128, PosPostPrep80CertS3Alt.qreg_block_apply] at hv; omega),
        ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (fun ⟨i, hi⟩ ↦ by
            have hr := rJoint16_payload_not36 i; rw [hi] at hr; omega),
        ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (fun ⟨i, hi⟩ ↦ by
            have hv := congrArg Fin.val hi
            dsimp [rB0_128, PosPostPrep80CertS3Alt.qreg_block_apply] at hv; omega)]
  have hStepCh : (chIf wEnPos_128 wIsHead_128).eval.1.mulVec
      (∑ q : BitAssignment 80,
        (w0 ^ 80) • ket (ZeroAncillaUSPS3.writeReg (βInit128 s0) rP80_128 q)) =
      ∑ u2 : Fin (2 ^ 2), ∑ qB0 : BitAssignment 3, ∑ qJ16 : BitAssignment 16,
        ∑ bPid0 : ZMod 2, ∑ qSm : BitAssignment 3, ∑ qJ : BitAssignment 33,
          ∑ qR21 : BitAssignment 21,
            (w0 ^ 2 * (w0 ^ 3 * w0 ^ 16 * w0 * w0 ^ 3 * w0 ^ 33) * w0 ^ 21) •
              ket (δBase u2 qB0 qJ16 bPid0 qSm qJ qR21) := by
    rw [← Equiv.sum_comp payload80BitsEquiv]
    simp only [Fintype.sum_prod_type]
    rw [← Equiv.sum_comp (basisBitsEquiv 2)]
    simp only [Matrix.mulVec_sum]
    refine Finset.sum_congr rfl fun u2 _ ↦ ?_
    refine Finset.sum_congr rfl fun qB0 _ ↦ ?_
    refine Finset.sum_congr rfl fun qJ16 _ ↦ ?_
    refine Finset.sum_congr rfl fun bPid0 _ ↦ ?_
    refine Finset.sum_congr rfl fun qSm _ ↦ ?_
    refine Finset.sum_congr rfl fun qJ _ ↦ ?_
    refine Finset.sum_congr rfl fun qR21 _ ↦ ?_
    have hInner : (∑ bIH : ZMod 2,
          (chIf wEnPos_128 wIsHead_128).eval.1.mulVec
            ((w0 ^ 80) • ket (ZeroAncillaUSPS3.writeReg (βInit128 s0) rP80_128
              (payload80BitsEquiv (basisBitsEquiv 2 u2, qB0, qJ16, bPid0, qSm, qJ, qR21, bIH))))) =
        (w0 ^ 2 * (w0 ^ 3 * w0 ^ 16 * w0 * w0 ^ 3 * w0 ^ 33) * w0 ^ 21) •
          ((chIf wEnPos_128 wIsHead_128).eval.1.mulVec
            (∑ bIH : ZMod 2, w0 •
              ket (Function.update (δBase u2 qB0 qJ16 bPid0 qSm qJ qR21) wIsHead_128 bIH))) := by
      rw [Matrix.mulVec_sum, Finset.smul_sum]
      refine Finset.sum_congr rfl fun bIH _ ↦ ?_
      have heqU2 : basisBitsEquiv 2 u2 = basisBits 2 u2 := rfl
      rw [heqU2, writeReg_p80_eq_nested, hw80, ← smul_smul, Matrix.mulVec_smul]
      rfl
    rw [hInner,
      chIf_mulVec_uniform_pair wEnPos_128 wIsHead_128 (by decide)
        (δBase u2 qB0 qJ16 bPid0 qSm qJ qR21)
        (by rw [hOutδ _ _ _ _ _ _ _ _ (by right; left; decide)]; exact (βU2_inputs s0 u2).1)
        (by rw [hOutδ _ _ _ _ _ _ _ _ (by right; right; rfl)]; exact (βU2_inputs s0 u2).2.2.2)]
  rw [hStepCh]
  have hStepBranch : ∀ u2 qB0 qJ16 bPid0 qSm qJ qR21,
      cFlags2_128.eval.1.mulVec
        (cIsHeadPm_128.eval.1.mulVec (ket (δBase u2 qB0 qJ16 bPid0 qSm qJ qR21))) =
      teleAlpha0 splitWord •
        ket (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg
          (Function.update
            (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (βHead128 s0 u2) rB0_128 qB0)
              rJoint16_128 qJ16)
            (rPid_128 ⟨0, by decide⟩) bPid0)
          rSm_128 qSm) rJoint33_128 qJ) rRest21_128 qR21) +
      teleAlpha1 splitWord •
        ket (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg
          (Function.update
            (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (βTail128 s0 u2) rB0_128 qB0)
              rJoint16_128 qJ16)
            (rPid_128 ⟨0, by decide⟩) bPid0)
          rSm_128 qSm) rJoint33_128 qJ) rRest21_128 qR21) :=
    fun u2 qB0 qJ16 bPid0 qSm qJ qR21 ↦ by
      obtain ⟨_, hES, hEC, hIH0⟩ := βU2_inputs s0 u2
      let δ := δBase u2 qB0 qJ16 bPid0 qSm qJ qR21
      have hHi0 : ∀ w : Wire 128, 119 ≤ w.val ∧ w.val ≤ 123 → δ w = 0 := fun w hw ↦
        (hOutδ u2 qB0 qJ16 bPid0 qSm qJ qR21 w (by right; left; omega)).trans
          ((writeReg_twoUnif_out _ _ w (by omega) (by omega)).trans (βInit128_hi_zero s0 w hw.1))
      have hScr0 : δ (scr30_128 ⟨0, by decide⟩) = 0 :=
        (hOutδ u2 qB0 qJ16 bPid0 qSm qJ qR21 _ (by right; left; decide)).trans
          ((writeReg_twoUnif_out _ _ _ (by decide) (by decide)).trans
            (βInit128_eq_zero_of_mid s0 _ (by decide)))
      have hB0_not36 : ∀ i : Fin 3,
        6 ≤ (rB0_128 i).val ∧ (rB0_128 i).val < 86 ∧ (rB0_128 i).val ≠ 36 :=
        fun i ↦ by dsimp [rB0_128, PosPostPrep80CertS3Alt.qreg_block_apply]; omega
      have hSm_not36 : ∀ i : Fin 3,
        6 ≤ (rSm_128 i).val ∧ (rSm_128 i).val < 86 ∧ (rSm_128 i).val ≠ 36 :=
        fun i ↦ by dsimp [rSm_128, PosPostPrep80CertS3Alt.qreg_block_apply]; omega
      have hCommT : flags2Map128 δ =
          ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg
            (Function.update
              (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (βTail128 s0 u2) rB0_128 qB0)
                rJoint16_128 qJ16)
              (rPid_128 ⟨0, by decide⟩) bPid0)
            rSm_128 qSm) rJoint33_128 qJ) rRest21_128 qR21 := by
        dsimp only [δ, δBase, βTail128]
        rw [flags2Map128_writeReg_payload rRest21_128 rRest21_payload_not36,
          flags2Map128_writeReg_payload rJoint33_128 rJoint33_payload_not36,
          flags2Map128_writeReg_payload rSm_128 hSm_not36,
          flags2Map128_update_pid0,
          flags2Map128_writeReg_payload rJoint16_128 rJoint16_payload_not36,
          flags2Map128_writeReg_payload rB0_128 hB0_not36]
      have hCommH : flags2Map128 (Function.update δ wIsHead_128 1) =
          ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg
            (Function.update
              (ZeroAncillaUSPS3.writeReg (ZeroAncillaUSPS3.writeReg (βHead128 s0 u2) rB0_128 qB0)
                rJoint16_128 qJ16)
              (rPid_128 ⟨0, by decide⟩) bPid0)
            rSm_128 qSm) rJoint33_128 qJ) rRest21_128 qR21 := by
        dsimp only [δ, δBase, βHead128]
        rw [update_writeReg_ne rRest21_128 wIsHead_128
              (fun i h ↦ (rRest21_payload_not36 i).2.2 (congrArg Fin.val h)),
          update_writeReg_ne rJoint33_128 wIsHead_128
              (fun i h ↦ (rJoint33_payload_not36 i).2.2 (congrArg Fin.val h)),
          update_writeReg_ne rSm_128 wIsHead_128
              (fun i h ↦ (hSm_not36 i).2.2 (congrArg Fin.val h)),
          Function.update_comm (by decide : rPid_128 ⟨0, Nat.zero_lt_succ 2⟩ ≠ wIsHead_128),
          update_writeReg_ne rJoint16_128 wIsHead_128
              (fun i h ↦ (rJoint16_payload_not36 i).2.2 (congrArg Fin.val h)),
          update_writeReg_ne rB0_128 wIsHead_128
              (fun i h ↦ (hB0_not36 i).2.2 (congrArg Fin.val h)),
          flags2Map128_writeReg_payload rRest21_128 rRest21_payload_not36,
          flags2Map128_writeReg_payload rJoint33_128 rJoint33_payload_not36,
          flags2Map128_writeReg_payload rSm_128 hSm_not36,
          flags2Map128_update_pid0,
          flags2Map128_writeReg_payload rJoint16_128 rJoint16_payload_not36,
          flags2Map128_writeReg_payload rB0_128 hB0_not36]
      rw [cIsHeadPm_mulVec_ket_active s0 δ
          ((hOutδ u2 qB0 qJ16 bPid0 qSm qJ qR21 _ (by right; left; decide)).trans hES)
          ((hOutδ u2 qB0 qJ16 bPid0 qSm qJ qR21 _ (by right; left; decide)).trans hEC)
          ((hOutδ u2 qB0 qJ16 bPid0 qSm qJ qR21 _ (by right; right; rfl)).trans hIH0)
          hScr0,
        Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
        ket_cFlags2_128 (Function.update δ wIsHead_128 1)
          (by rw [Function.update_of_ne (by decide)]; exact hHi0 _ (by decide))
          (by rw [Function.update_of_ne (by decide)]; exact hHi0 _ (by decide))
          (by rw [Function.update_of_ne (by decide)]; exact hHi0 _ (by decide))
          (by rw [Function.update_of_ne (by decide)]; exact hHi0 _ (by decide))
          (by rw [Function.update_of_ne (by decide)]; exact hHi0 _ (by decide)),
        ket_cFlags2_128 δ
          (hHi0 _ (by decide)) (hHi0 _ (by decide)) (hHi0 _ (by decide))
          (hHi0 _ (by decide)) (hHi0 _ (by decide)),
        hCommH, hCommT]
  simp only [Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun u2 _ ↦ ?_
  rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun qB0 _ ↦ ?_
  rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun qJ16 _ ↦ ?_
  rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun bPid0 _ ↦ ?_
  rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun qSm _ ↦ ?_
  rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun qJ _ ↦ ?_
  rw [Finset.smul_sum, Finset.smul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun qR21 _ ↦ ?_
  rw [Matrix.mulVec_smul, Matrix.mulVec_smul, hStepBranch, smul_add,
    smul_smul, smul_smul, smul_smul, smul_smul]
  exact congrArg₂ (· + ·) (congrArg (· • ket _) (by ring)) (congrArg (· • ket _) (by ring))


def muxClearDerivedFlags (δ : BitAssignment 152) : BitAssignment 152 :=
  Function.update
    (Function.update (Function.update δ wEnC0Tail_152 0) wEnS4Head_152 0) wEnC0Head_152 0


theorem muxDerivedFlagsMap_update_lt86 (α : BitAssignment 152) (w : Wire 152) (hw : w.val < 86)
    (b : ZMod 2) :
    muxDerivedFlagsMap (Function.update α w b) = Function.update (muxDerivedFlagsMap α) w b := by
  have hne : ∀ u : Wire 152, 117 ≤ u.val → u ≠ w := fun u hu h ↦ by
    have := congrArg Fin.val h; omega
  funext u
  dsimp only [muxDerivedFlagsMap]
  rw [Function.update_of_ne (hne wEnC0Tail_152 (by decide)),
    Function.update_of_ne (hne wEnTail_152 (by decide)),
    Function.update_of_ne (hne wEnS0Tail_152 (by decide)),
    Function.update_of_ne (hne wEnS4Head_152 (by decide)),
    Function.update_of_ne (hne wEnS0_152 (by decide)),
    Function.update_of_ne (hne wEnC0Head_152 (by decide)),
    Function.update_of_ne (hne wEnHead_152 (by decide))]
  by_cases huw : u = w
  · subst huw
    rw [Function.update_self,
      Function.update_of_ne (hne wEnC0Head_152 (by decide)).symm,
      Function.update_of_ne (hne wEnS4Head_152 (by decide)).symm,
      Function.update_of_ne (hne wEnC0Tail_152 (by decide)).symm,
      Function.update_self]
  · rw [Function.update_of_ne huw]
    by_cases h1 : u = wEnC0Head_152
    · subst h1; simp
    · rw [Function.update_of_ne h1, Function.update_of_ne h1]
      by_cases h2 : u = wEnS4Head_152
      · subst h2; simp
      · rw [Function.update_of_ne h2, Function.update_of_ne h2]
        by_cases h3 : u = wEnC0Tail_152
        · subst h3; simp
        · rw [Function.update_of_ne h3, Function.update_of_ne h3, Function.update_of_ne huw]


theorem muxDerivedFlagsMap_writeReg_lt86 {m : ℕ} (α : BitAssignment 152)
    (r : QRegister m 152) (hr : ∀ i : Fin m, (r i).val < 86) (q : BitAssignment m) :
    muxDerivedFlagsMap (ZeroAncillaUSPS3.writeReg α r q) =
      ZeroAncillaUSPS3.writeReg (muxDerivedFlagsMap α) r q := by
  have hnot : ∀ u : Wire 152, 117 ≤ u.val → ¬∃ i : Fin m, r i = u := fun u hu ⟨i, hi⟩ ↦ by
    have := hr i; rw [hi] at this; omega
  funext u
  dsimp only [muxDerivedFlagsMap]
  rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (hnot wEnC0Tail_152 (by decide)),
    ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (hnot wEnTail_152 (by decide)),
    ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (hnot wEnS0Tail_152 (by decide)),
    ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (hnot wEnS4Head_152 (by decide)),
    ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (hnot wEnS0_152 (by decide)),
    ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (hnot wEnC0Head_152 (by decide)),
    ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ (hnot wEnHead_152 (by decide))]
  by_cases hmem : ∃ i : Fin m, r i = u
  · obtain ⟨i, rfl⟩ := hmem
    have hlt := hr i
    have hne1 : r i ≠ wEnC0Head_152 := fun h ↦ by
      have := congrArg Fin.val h; dsimp [wEnC0Head_152] at this; omega
    have hne2 : r i ≠ wEnS4Head_152 := fun h ↦ by
      have := congrArg Fin.val h; dsimp [wEnS4Head_152] at this; omega
    have hne3 : r i ≠ wEnC0Tail_152 := fun h ↦ by
      have := congrArg Fin.val h; dsimp [wEnC0Tail_152] at this; omega
    rw [ZeroAncillaUSPS3.writeReg_apply_reg,
      Function.update_of_ne hne1, Function.update_of_ne hne2, Function.update_of_ne hne3,
      ZeroAncillaUSPS3.writeReg_apply_reg]
  · rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hmem]
    by_cases h1 : u = wEnC0Head_152
    · subst h1; simp
    · rw [Function.update_of_ne h1, Function.update_of_ne h1]
      by_cases h2 : u = wEnS4Head_152
      · subst h2; simp
      · rw [Function.update_of_ne h2, Function.update_of_ne h2]
        by_cases h3 : u = wEnC0Tail_152
        · subst h3; simp
        · rw [Function.update_of_ne h3, Function.update_of_ne h3,
            ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hmem]


theorem muxClearDerivedFlags_update_lt86 (δ : BitAssignment 152) (w : Wire 152) (hw : w.val < 86)
    (b : ZMod 2) :
    muxClearDerivedFlags (Function.update δ w b) = Function.update (muxClearDerivedFlags δ) w b :=
      by
  dsimp only [muxClearDerivedFlags]
  have h1 : w ≠ wEnC0Tail_152 := fun h ↦ by
    have := congrArg Fin.val h; dsimp [wEnC0Tail_152] at this; omega
  have h2 : w ≠ wEnS4Head_152 := fun h ↦ by
    have := congrArg Fin.val h; dsimp [wEnS4Head_152] at this; omega
  have h3 : w ≠ wEnC0Head_152 := fun h ↦ by
    have := congrArg Fin.val h; dsimp [wEnC0Head_152] at this; omega
  rw [Function.update_comm h1, Function.update_comm h2, Function.update_comm h3]


theorem muxClearDerivedFlags_writeReg_lt86 {m : ℕ} (δ : BitAssignment 152)
    (r : QRegister m 152) (hr : ∀ i : Fin m, (r i).val < 86) (q : BitAssignment m) :
    muxClearDerivedFlags (ZeroAncillaUSPS3.writeReg δ r q) =
      ZeroAncillaUSPS3.writeReg (muxClearDerivedFlags δ) r q := by
  dsimp only [muxClearDerivedFlags]
  have h1 : ∀ i : Fin m, r i ≠ wEnC0Tail_152 := fun i h ↦ by
    have := hr i; rw [h] at this; dsimp [wEnC0Tail_152] at this; omega
  have h2 : ∀ i : Fin m, r i ≠ wEnS4Head_152 := fun i h ↦ by
    have := hr i; rw [h] at this; dsimp [wEnS4Head_152] at this; omega
  have h3 : ∀ i : Fin m, r i ≠ wEnC0Head_152 := fun i h ↦ by
    have := hr i; rw [h] at this; dsimp [wEnC0Head_152] at this; omega
  rw [ update_writeReg_ne r wEnC0Tail_152 h1,
       update_writeReg_ne r wEnS4Head_152 h2,
       update_writeReg_ne r wEnC0Head_152 h3 ]


theorem muxClear_muxDerived_lift (β : BitAssignment 128) (hc0h : β wEnC0Head_128 = 0) :
    muxClearDerivedFlags (muxDerivedFlagsMap (liftBits128 β)) = liftBits128 β := by
  funext u
  dsimp only [muxClearDerivedFlags, muxDerivedFlagsMap]
  by_cases h1 : u = wEnC0Head_152
  · subst h1
    rw [Function.update_self, ← rSub128_wEnC0Head]
    have hsub := congrFun (liftBits128_rSub128 β) wEnC0Head_128
    rw [hsub, hc0h]
  · rw [Function.update_of_ne h1]
    by_cases h2 : u = wEnS4Head_152
    · subst h2
      rw [Function.update_self]
      dsimp only [liftBits128]
