  left_inv := by rintro ⟨b, pLo, a4⟩; fin_cases b <;> fin_cases pLo <;> revert a4 <;> decide
  right_inv := by
    intro x; obtain ⟨⟨a, c⟩, rfl⟩ := fin128Split16.symm.surjective x
    fin_cases a <;> revert c <;> decide


