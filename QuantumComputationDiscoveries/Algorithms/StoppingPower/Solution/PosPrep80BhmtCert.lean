def etBool (ep ih : Bool) : Bool := bne ep (ep && ih)

def s0tBool (ep ih c0 : Bool) : Bool := (ep && c0) && etBool ep ih

def s4hBool (ep ih c0 : Bool) : Bool := bne (ep && c0) (s0tBool ep ih c0)

def c0hBool (ep ih c0 : Bool) : Bool := bne (ep && ih) (s4hBool ep ih c0)


theorem not_s4h_and_s0t (ep ih c0 : Bool) : !(s4hBool ep ih c0 && s0tBool ep ih c0) = true := by
  cases ep <;> cases ih <;> cases c0 <;> rfl


def badAncBool (a1 a2 a3 a4 a5 a6 a7 c0h : Bool) : Bool :=
  let s0 := a1 && a2
  let s1 := bne (bne s0 a1) a2
  let s2 := a3 && a4
  let s3 := s2 && s1
  let s4 := bne (bne (a5 && s3) a5) s3
  let s5 := a6 && a7
  let s6 := s5 && s4
  bne (c0h && bne s0 s6) s6


def badNucBool (n0 n1 n2 n3 n4 n5 n6 n7 s4h s0t : Bool) : Bool :=
  let n01 := n0 && n1
  let q1 := bne (s0t && bne n01 n0) n1
  let q2 := bne (bne (n2 && q1) n2) q1
  let q3 := n3 && n4
  let q4 := q3 && q2
  let q5 := bne (bne (n5 && q4) n5) q4
  let q6 := n6 && n7
  let q7 := q6 && q5
  bne (s4h && bne n01 q7) q7


theorem b2z_badAncBool (a1 a2 a3 a4 a5 a6 a7 c0h : Bool) :
    b2z (badAncBool a1 a2 a3 a4 a5 a6 a7 c0h) =
      badAncPoly (b2z a1) (b2z a2) (b2z a3) (b2z a4) (b2z a5) (b2z a6) (b2z a7) (b2z c0h) := by
  unfold badAncBool badAncPoly
  simp only [b2z_bne, b2z_and]


theorem b2z_badNucBool (n0 n1 n2 n3 n4 n5 n6 n7 s4h s0t : Bool) :
    b2z (badNucBool n0 n1 n2 n3 n4 n5 n6 n7 s4h s0t) =
      badNucPoly (b2z n0) (b2z n1) (b2z n2) (b2z n3) (b2z n4) (b2z n5) (b2z n6) (b2z n7)
        (b2z s4h) (b2z s0t) := by
  unfold badNucBool badNucPoly
  simp only [b2z_bne, b2z_and]


