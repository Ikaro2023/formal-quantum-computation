theorem ite_tail_mux_Bhmt_eq {α : Type*} (S A W : Bool) (X z : α) :
    (if (S && W) = true then (if A = true then X else z) else z) =
      (if (S && A && W) = true then X else z) := by
  cases S <;> cases A <;> cases W <;> rfl


theorem ite_head_mux_Bhmt_eq {α : Type*} (R : Bool) (part : ℕ) (Z : Bool)
    (W : ℕ → Bool) (Y z : α) :
    (if (R && decide (part < 2) && W part) = true then
      (if (!(part == 1) && Z) = true then Y else z)
     else z) =
      (if (R && ((part == 0) && Z) && W 0) = true then Y else z) := by
  cases part with
  | zero => cases R <;> cases Z <;> cases W 0 <;> rfl
  | succ n =>
      cases n with
      | zero => cases R <;> cases Z <;> cases W 1 <;> rfl
      | succ m =>
          have hlt : decide (m + 2 < 2) = false := decide_eq_false (by omega)
          have h0 : (m + 2 == 0) = false := rfl
          rw [hlt, h0]
          cases R <;> cases Z <;> cases W (m + 2) <;> rfl


