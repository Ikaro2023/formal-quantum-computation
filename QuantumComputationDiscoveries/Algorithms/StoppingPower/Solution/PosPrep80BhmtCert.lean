noncomputable def eRest21 : BitAssignment 19 × Fin (2 ^ 2) ≃ BitAssignment 21 where
  toFun
    | (q19, pLo) => fun i ↦
        if h1 : i.val < 15 then q19 ⟨i.val, by omega⟩
        else if h2 : i.val < 17 then basisBits 2 pLo ⟨i.val - 15, by omega⟩
        else q19 ⟨i.val - 2, by omega⟩
  invFun q21 :=
    (fun j ↦ if j.val < 15 then q21 ⟨j.val, by omega⟩ else q21 ⟨j.val + 2, by omega⟩,
     (basisBitsEquiv 2).symm (fun k : Fin 2 ↦ q21 ⟨15 + k.val, by omega⟩))
  left_inv
    | (q19, pLo) => by
        apply Prod.ext
        · funext j
          by_cases hj : j.val < 15
          · simp only [hj, ↓reduceIte, ↓reduceDIte]
          · have h1 : ¬(j.val + 2 < 15) := by omega
            have h2 : ¬(j.val + 2 < 17) := by omega
            simp only [hj, h1, h2, ↓reduceIte, ↓reduceDIte]
            exact congrArg q19 (Fin.ext (by dsimp; omega))
        · have hfun :
              (fun k : Fin 2 ↦
                if h1 : 15 + k.val < 15 then q19 ⟨15 + k.val, by omega⟩
                else if h2 : 15 + k.val < 17 then basisBits 2 pLo ⟨15 + k.val - 15, by omega⟩
                else q19 ⟨15 + k.val - 2, by omega⟩) = basisBitsEquiv 2 pLo := by
            funext k; fin_cases k <;> rfl
          dsimp only
          rw [hfun, (basisBitsEquiv 2).symm_apply_apply]
  right_inv q21 := by
    funext i
    by_cases h1 : i.val < 15
    · simp only [h1, ↓reduceDIte, ↓reduceIte]
    · by_cases h2 : i.val < 17
      · simp only [h1, h2, ↓reduceDIte]
        change (basisBitsEquiv 2 ((basisBitsEquiv 2).symm
          (fun k : Fin 2 ↦ q21 ⟨15 + k.val, by omega⟩))) ⟨i.val - 15, by omega⟩ = q21 i
        rw [(basisBitsEquiv 2).apply_symm_apply]
        exact congrArg q21 (Fin.ext (by dsimp; omega))
      · have hn : ¬(i.val - 2 < 15) := by omega
        simp only [h1, h2, hn, ↓reduceDIte, ↓reduceIte]
        exact congrArg q21 (Fin.ext (by dsimp; omega))


