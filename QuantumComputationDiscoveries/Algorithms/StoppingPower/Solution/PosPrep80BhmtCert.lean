theorem stepMask76_and_inMask {g : RevGate76} {M : ℕ} (hm : g.inMask M = true) (m : ℕ) :
    (stepMask76 g m &&& M = stepMask76 g (m &&& M)) ∧
    (∀ i, M.testBit i = false → (stepMask76 g m).testBit i = m.testBit i) := by
  have hxor_and : ∀ (t : Fin 76), M.testBit t.val = true →
      ((m ^^^ (2 ^ t.val)) &&& M = (m &&& M) ^^^ (2 ^ t.val)) ∧
      (∀ i, M.testBit i = false → (m ^^^ (2 ^ t.val)).testBit i = m.testBit i) := by
    intro t ht; refine ⟨?_, ?_⟩
    · apply Nat.eq_of_testBit_eq; intro i
      rw [Nat.testBit_and, Nat.testBit_xor, Nat.testBit_xor, Nat.testBit_and, Nat.testBit_two_pow]
      by_cases hti : t.val = i
      · subst hti; rw [ht, decide_eq_true rfl]; cases m.testBit t.val <;> rfl
      · rw [decide_eq_false hti]; cases m.testBit i <;> cases M.testBit i <;> rfl
    · intro i hi
      have hti : t.val ≠ i := fun e ↦ by rw [← e, ht] at hi; exact Bool.noConfusion hi
      rw [Nat.testBit_xor, Nat.testBit_two_pow, decide_eq_false hti]
      cases m.testBit i <;> rfl
  cases g with
  | x t => exact hxor_and t hm
  | cnot c t =>
      simp only [RevGate76.inMask, Bool.and_eq_true] at hm
      have htb : (m &&& M).testBit c.val = m.testBit c.val := by
        rw [Nat.testBit_and, hm.1]; cases m.testBit c.val <;> rfl
      dsimp only [stepMask76]; rw [htb]
      cases m.testBit c.val
      · exact ⟨rfl, fun _ _ ↦ rfl⟩
      · exact hxor_and t hm.2
  | toff c1 c2 t =>
      simp only [RevGate76.inMask, Bool.and_eq_true] at hm
      have htb1 : (m &&& M).testBit c1.val = m.testBit c1.val := by
        rw [Nat.testBit_and, hm.1.1]; cases m.testBit c1.val <;> rfl
      have htb2 : (m &&& M).testBit c2.val = m.testBit c2.val := by
        rw [Nat.testBit_and, hm.1.2]; cases m.testBit c2.val <;> rfl
      dsimp only [stepMask76]; rw [htb1, htb2]
      cases (m.testBit c1.val && m.testBit c2.val)
      · exact ⟨rfl, fun _ _ ↦ rfl⟩
      · exact hxor_and t hm.2


theorem runMask76_inMask_aux {M : ℕ} :
    ∀ {l : List RevGate76}, l.all (RevGate76.inMask M) = true → ∀ (k : ℕ),
      (runMask76 l k &&& M = runMask76 l (k &&& M)) ∧
      (∀ i, M.testBit i = false → (runMask76 l k).testBit i = k.testBit i)
  | [], _, _ => ⟨rfl, fun _ _ ↦ rfl⟩
  | g :: l, hl, k => by
      simp only [List.all_cons, Bool.and_eq_true] at hl
      obtain ⟨h1, h2⟩ := stepMask76_and_inMask hl.1 k
      obtain ⟨ih1, ih2⟩ := runMask76_inMask_aux hl.2 (stepMask76 g k)
      exact ⟨by rw [runMask76, ih1, h1, runMask76], fun i hi ↦ by rw [runMask76, ih2 i hi, h2 i hi]⟩


theorem runMask76_decomp_inMask {gs : List RevGate76} {M : ℕ}
    (hm : gs.all (RevGate76.inMask M) = true) (m : ℕ) :
    runMask76 gs m = (m ^^^ (m &&& M)) ^^^ runMask76 gs (m &&& M) := by
  obtain ⟨h1, h2⟩ := runMask76_inMask_aux hm m
  obtain ⟨_, h3⟩ := runMask76_inMask_aux hm (m &&& M)
  apply Nat.eq_of_testBit_eq; intro i
  by_cases hi : M.testBit i = true
  · have hleft : (runMask76 gs m &&& M).testBit i = (runMask76 gs m).testBit i := by
      rw [Nat.testBit_and, hi]; cases (runMask76 gs m).testBit i <;> rfl
    rw [← hleft, h1, Nat.testBit_xor, Nat.testBit_xor, Nat.testBit_and, hi]
    cases m.testBit i <;> cases (runMask76 gs (m &&& M)).testBit i <;> rfl
  · have hf : M.testBit i = false := Bool.eq_false_iff.mpr hi
    have h0 : (m &&& M).testBit i = false := by rw [Nat.testBit_and, hf]; cases m.testBit i <;> rfl
    rw [h2 i hf, Nat.testBit_xor, Nat.testBit_xor, h3 i hf, h0]
    cases m.testBit i <;> rfl


