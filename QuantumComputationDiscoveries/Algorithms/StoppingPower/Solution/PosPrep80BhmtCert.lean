def stepTarget152 : CleanStep152 → Wire 152
  | .x q => q
  | .cnot _ t => t
  | .tempAnd _ _ anc => anc


theorem evalStep152_of_ne_target (s : CleanStep152) (α : BitAssignment 152) (w : Wire 152)
    (hw : w ≠ stepTarget152 s) :
    evalStep152 s α w = α w := by
  cases s <;> dsimp [evalStep152, stepTarget152] at hw ⊢ <;> exact Function.update_of_ne hw _ _


theorem evalProg152_of_not_mem_targets (prog : List CleanStep152) (α : BitAssignment 152)
    (w : Wire 152) (hw : ∀ t ∈ prog.map stepTarget152, w ≠ t) :
    evalProg152 prog α w = α w := by
  induction prog generalizing α with
  | nil => rfl
  | cons s rest ih =>
      simp only [List.map_cons, List.mem_cons, forall_eq_or_imp] at hw
      rw [evalProg152, ih _ hw.2, evalStep152_of_ne_target s α w hw.1]


def mThresh4 : Fin 4 → ℕ := ![771830103, 814177451, 796552300, 784365019]


def kAdd4 (k : Fin 4) : ℕ := 2 ^ 30 - mThresh4 k


theorem mThresh4_pos (k : Fin 4) : 0 < mThresh4 k := by fin_cases k <;> decide




def natBit (x i : ℕ) : ℕ := (x / 2 ^ i) % 2


theorem natBit_zero_or_one (x i : ℕ) : natBit x i = 0 ∨ natBit x i = 1 := by
  dsimp [natBit]; omega


def natCarry (a b : ℕ) : ℕ → ℕ
  | 0 => 0
  | i + 1 => (natBit a i + natBit b i + natCarry a b i) / 2






theorem natCarry_zero_or_one (a b n : ℕ) : natCarry a b n = 0 ∨ natCarry a b n = 1 := by
  induction n with
  | zero => exact Or.inl rfl
  | succ k _ =>
    dsimp [natCarry]
    have ha := natBit_zero_or_one a k
    have hb := natBit_zero_or_one b k
    omega


private theorem natCarry_kAdd4_eq_zero_iff {fine : ℕ} (hfine : fine < 2 ^ 30) (k : Fin 4) :
    natCarry fine (kAdd4 k) 30 = 0 ↔ fine < mThresh4 k :=
  PosPostPrep80MergedVepS3.natCarry_kAdd4_eq_zero_iff (fine :=
      fine) hfine k


theorem z2_maj_eq_nat_carry {a b c : ℕ}
    (ha : a = 0 ∨ a = 1) (hb : b = 0 ∨ b = 1) (hc : c = 0 ∨ c = 1) :
    (((a + b + c) / 2 : ℕ) : ZMod 2) =
      ((a : ZMod 2) + (c : ZMod 2)) * ((b : ZMod 2) + (c : ZMod 2)) + (c : ZMod 2) := by
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> rcases hc with rfl | rfl <;> decide


theorem bitsVal_lt_two_pow_local {m : ℕ} (γ : BitAssignment m) :
    Pos24HeadCoordXor80.bitsVal γ < 2 ^ m := by
  induction m with
  | zero => simp [Pos24HeadCoordXor80.bitsVal]
  | succ m ih =>
      unfold Pos24HeadCoordXor80.bitsVal at ih ⊢
      rw [Fin.sum_univ_castSucc, Fin.val_last, pow_succ]
      simp only [Fin.val_castSucc]
      have hlow := ih (fun i ↦ γ i.castSucc)
      have hlt2 : (γ (Fin.last m)).val < 2 := ZMod.val_lt _
      rcases (by omega : (γ (Fin.last m)).val = 0 ∨ (γ (Fin.last m)).val = 1) with h0 | h1
      · rw [h0, zero_mul, add_zero]; omega
      · rw [h1, one_mul]; omega


theorem z2BitOfNat_eq_natCast_natBit (x i : ℕ) :
    z2BitOfNat x i = ((natBit x i : ℕ) : ZMod 2) := by
  apply ZMod.val_injective
  rw [z2BitOfNat_val]
  rcases natBit_zero_or_one x i with h0 | h1
  · rw [show (x / 2 ^ i) % 2 = natBit x i from rfl, h0]; simp
  · rw [show (x / 2 ^ i) % 2 = natBit x i from rfl, h1]; simp


structure Anf4 where
  c0 : ZMod 2
  cd : ZMod 2
  cm : ZMod 2
  cmp : ZMod 2
  deriving DecidableEq


def anfZero : Anf4 := ⟨0, 0, 0, 0⟩

def anfOne : Anf4 := ⟨1, 0, 0, 0⟩


def anfXor (a b : Anf4) : Anf4 :=
  ⟨a.c0 + b.c0, a.cd + b.cd, a.cm + b.cm, a.cmp + b.cmp⟩


def evalAnf4 (a : Anf4) (par maj : ZMod 2) : ZMod 2 :=
  a.c0 + a.cd * par + a.cm * maj + a.cmp * (maj * par)


theorem evalAnf4_zero (par maj : ZMod 2) : evalAnf4 anfZero par maj = 0 := by
  simp [evalAnf4, anfZero]


theorem evalAnf4_one (par maj : ZMod 2) : evalAnf4 anfOne par maj = 1 := by
  simp [evalAnf4, anfOne]


theorem evalAnf4_anfXor (a b : Anf4) (par maj : ZMod 2) :
    evalAnf4 (anfXor a b) par maj = evalAnf4 a par maj + evalAnf4 b par maj := by
  dsimp [evalAnf4, anfXor]; ring


def pop3Idx (d0 d1 d2 : ZMod 2) : Fin 4 :=
  ⟨d0.val + d1.val + d2.val, by
    have h0 : d0.val < 2 := ZMod.val_lt d0
    have h1 : d1.val < 2 := ZMod.val_lt d1
    have h2 : d2.val < 2 := ZMod.val_lt d2
    omega⟩


def anfOfStage (i : ℕ) : Anf4 :=
  let b0 := z2BitOfNat (kAdd4 0) i
  let b1 := z2BitOfNat (kAdd4 1) i
  let b2 := z2BitOfNat (kAdd4 2) i
  let b3 := z2BitOfNat (kAdd4 3) i
  ⟨b0, b0 + b1, b0 + b2, b0 + b1 + b2 + b3⟩


theorem evalAnf4_anfOfStage (i : ℕ) (d0 d1 d2 : ZMod 2) :
    evalAnf4 (anfOfStage i) (d0 + d1 + d2) (d0 * d1 + (d0 + d1) * d2) =
      z2BitOfNat (kAdd4 (pop3Idx d0 d1 d2)) i := by
  set b0 := z2BitOfNat (kAdd4 0) i
  set b1 := z2BitOfNat (kAdd4 1) i
  set b2 := z2BitOfNat (kAdd4 2) i
  set b3 := z2BitOfNat (kAdd4 3) i
  change b0 + (b0 + b1) * (d0 + d1 + d2) +
      (b0 + b2) * (d0 * d1 + (d0 + d1) * d2) +
      (b0 + b1 + b2 + b3) * ((d0 * d1 + (d0 + d1) * d2) * (d0 + d1 + d2)) =
    z2BitOfNat (kAdd4 (pop3Idx d0 d1 d2)) i
  rcases bit_cases d0 with rfl | rfl <;>
  rcases bit_cases d1 with rfl | rfl <;>
  rcases bit_cases d2 with rfl | rfl
  · simp [pop3Idx]; ring
  · have hidx : pop3Idx 0 0 1 = 1 := rfl
    rw [hidx]; change b0 + (b0 + b1) * 1 + (b0 + b2) * 0 + (b0 + b1 + b2 + b3) * 0 = b1
    simp [← add_assoc]
  · have hidx : pop3Idx 0 1 0 = 1 := rfl
    rw [hidx]; change b0 + (b0 + b1) * 1 + (b0 + b2) * 0 + (b0 + b1 + b2 + b3) * 0 = b1
    simp [← add_assoc]
  · have hidx : pop3Idx 0 1 1 = 2 := rfl
    rw [hidx]; change b0 + (b0 + b1) * 0 + (b0 + b2) * 1 + (b0 + b1 + b2 + b3) * 0 = b2
    simp [← add_assoc]
  · have hidx : pop3Idx 1 0 0 = 1 := rfl
    rw [hidx]; change b0 + (b0 + b1) * 1 + (b0 + b2) * 0 + (b0 + b1 + b2 + b3) * 0 = b1
    simp [← add_assoc]
  · have hidx : pop3Idx 1 0 1 = 2 := rfl
    rw [hidx]; change b0 + (b0 + b1) * 0 + (b0 + b2) * 1 + (b0 + b1 + b2 + b3) * 0 = b2
    simp [← add_assoc]
  · have hidx : pop3Idx 1 1 0 = 2 := rfl
    rw [hidx]; change b0 + (b0 + b1) * 0 + (b0 + b2) * 1 + (b0 + b1 + b2 + b3) * 0 = b2
    simp [← add_assoc]
  · have hidx : pop3Idx 1 1 1 = 3 := rfl
    rw [hidx]; change b0 + (b0 + b1) * 1 + (b0 + b2) * 1 + (b0 + b1 + b2 + b3) * 1 = b3
    have hchar : (2 : ZMod 2) = 0 := rfl
    have halg : b0 + (b0 + b1) * 1 + (b0 + b2) * 1 + (b0 + b1 + b2 + b3) * 1 =
        (2 : ZMod 2) * (2 * b0 + b1 + b2) + b3 := by ring
    rw [halg, hchar, zero_mul, zero_add]


def fine30Val152 (α : BitAssignment 152) : ℕ :=
  Pos24HeadCoordXor80.bitsVal (fun j : Fin 30 ↦ α (rFine30_152 j))


def dpPop3_152 (α : BitAssignment 152) : Fin 4 :=
  pop3Idx (α (rB1_152 0)) (α (rB1_152 1)) (α (rB1_152 2))


def anc7Val152 (α : BitAssignment 152) : ℕ :=
  Pos24HeadCoordXor80.bitsVal (fun j : Fin 7 ↦ α (rAnc_152 ⟨j.val + 1, by omega⟩))


def anc8Val152 (α : BitAssignment 152) : ℕ :=
  Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ α (rAnc_152 j))


def nuc8Val152 (α : BitAssignment 152) : ℕ :=
  Pos24HeadCoordXor80.bitsVal (fun j : Fin 8 ↦ α (rNuc_152 j))


theorem anc7_lt_109_iff_anc8_lt_218 (α : BitAssignment 152) :
    anc7Val152 α < 109 ↔ anc8Val152 α < 218 := by
  have hsplit : anc8Val152 α = (α (rAnc_152 0)).val + 2 * anc7Val152 α := by
    unfold anc8Val152 anc7Val152 Pos24HeadCoordXor80.bitsVal
    rw [Fin.sum_univ_succ]
    have h0 : (α (rAnc_152 0)).val * 2 ^ (0 : Fin 8).val = (α (rAnc_152 0)).val := by
      simp
    have hs : ∀ j : Fin 7,
        (α (rAnc_152 j.succ)).val * 2 ^ j.succ.val =
          2 * ((α (rAnc_152 ⟨j.val + 1, by omega⟩)).val * 2 ^ j.val) := fun j ↦ by
      have hj : j.succ = (⟨j.val + 1, by omega⟩ : Fin 8) := rfl
      rw [Fin.val_succ, hj, pow_succ']; ring
    rw [h0]
    simp_rw [hs, ← Finset.mul_sum]
  have hb0 : (α (rAnc_152 0)).val < 2 := ZMod.val_lt _
  omega


def pPopBasisSteps152 : List CleanStep152 :=
  let d0 := rB1_152 0;
  let d1 := rB1_152 1;
  let d2 := rB1_152 2;
  [.cnot d0 wPopPar_152,
   .cnot d1 wPopPar_152,
   .cnot d2 wPopPar_152,
   .cnot d0 d1,
   .cnot d0 d2,
   .tempAnd d1 d2 wPopMaj_152,
   .cnot d0 d1,
   .cnot d0 d2,
   .cnot d0 wPopMaj_152,
   .tempAnd wPopMaj_152 wPopPar_152 wBrTop_152]


def popBasisMap152 (α : BitAssignment 152) : BitAssignment 152 :=
  let d0 := α (rB1_152 0)
  let d1 := α (rB1_152 1)
  let d2 := α (rB1_152 2)
  let par := d0 + d1 + d2
  let maj := d0 * d1 + (d0 + d1) * d2
  Function.update
    (Function.update
      (Function.update α wPopPar_152 par) wPopMaj_152 maj) wBrTop_152 (maj * par)


theorem popBasisMap152_outside (α : BitAssignment 152) (w : Wire 152)
    (hw : ¬(125 ≤ w.val ∧ w.val < 128)) :
    popBasisMap152 α w = α w := by
  have h1 : w ≠ wBrTop_152 := fun h ↦ by
    have := congrArg Fin.val h; change w.val = 127 at this; omega
  have h2 : w ≠ wPopMaj_152 := fun h ↦ by
    have := congrArg Fin.val h; change w.val = 125 at this; omega
  have h3 : w ≠ wPopPar_152 := fun h ↦ by
    have := congrArg Fin.val h; change w.val = 126 at this; omega
  dsimp only [popBasisMap152]
  rw [Function.update_of_ne h1, Function.update_of_ne h2, Function.update_of_ne h3]


theorem update_idem_wire (γ : BitAssignment 152) (a : Wire 152) (u v : ZMod 2) :
    Function.update (Function.update γ a u) a v = Function.update γ a v := by
  funext w; by_cases hw : w = a <;> simp [hw]


theorem evalStep152_tempAnd_zero (x y out : Wire 152) (γ : BitAssignment 152) (h0 : γ out = 0) :
    evalStep152 (.tempAnd x y out) γ = Function.update γ out (γ x * γ y) := by
  dsimp only [evalStep152]; rw [h0, zero_add]


theorem evalProg152_carryMaj6 (ciIn fi sig ciOut : Wire 152)
    (h1 : ciIn ≠ fi) (h2 : ciIn ≠ sig) (h3 : ciIn ≠ ciOut)
    (h4 : fi ≠ sig) (h5 : fi ≠ ciOut) (h6 : sig ≠ ciOut)
    (γs : BitAssignment 152) (hco0 : γs ciOut = 0) :
    evalProg152
      [.cnot ciIn fi, .cnot ciIn sig, .tempAnd fi sig ciOut,
       .cnot ciIn fi, .cnot ciIn sig, .cnot ciIn ciOut] γs =
    Function.update γs ciOut ((γs fi + γs ciIn) * (γs sig + γs ciIn) + γs ciIn) := by
  have hadd2 : ∀ x y : ZMod 2, x + y + y = x := by decide
  let s1 := evalStep152 (.cnot ciIn fi) γs
  let s2 := evalStep152 (.cnot ciIn sig) s1
  let s3 := evalStep152 (.tempAnd fi sig ciOut) s2
  let s4 := evalStep152 (.cnot ciIn fi) s3
  let s5 := evalStep152 (.cnot ciIn sig) s4
  let s6 := evalStep152 (.cnot ciIn ciOut) s5
  have hs2_fi : s2 fi = γs fi + γs ciIn := by
    dsimp only [s2, s1, evalStep152]
    rw [Function.update_of_ne h4, Function.update_self]
  have hs2_sig : s2 sig = γs sig + γs ciIn := by
    dsimp only [s2, s1, evalStep152]
    rw [Function.update_self, Function.update_of_ne h4.symm, Function.update_of_ne h1]
  have hs2_ci : s2 ciIn = γs ciIn := by
    dsimp only [s2, s1, evalStep152]
    rw [Function.update_of_ne h2, Function.update_of_ne h1]
  have hs2_co : s2 ciOut = 0 := by
    dsimp only [s2, s1, evalStep152]
    rw [Function.update_of_ne h6.symm, Function.update_of_ne h5.symm, hco0]
  have hs5_co : s5 ciOut = (γs fi + γs ciIn) * (γs sig + γs ciIn) := by
    dsimp only [s5, s4, s3, evalStep152]
    rw [Function.update_of_ne h6.symm, Function.update_of_ne h5.symm,
      Function.update_self, hs2_co, hs2_fi, hs2_sig, zero_add]
  have hs5_ci : s5 ciIn = γs ciIn := by
    dsimp only [s5, s4, s3, evalStep152]
    rw [Function.update_of_ne h2, Function.update_of_ne h1, Function.update_of_ne h3, hs2_ci]
  have hs5_fi : s5 fi = γs fi := by
    dsimp only [s5, s4, s3, evalStep152]
    rw [Function.update_of_ne h4, Function.update_self, Function.update_of_ne h5,
      Function.update_of_ne h3, hs2_fi, hs2_ci, hadd2]
  have hs5_sig : s5 sig = γs sig := by
    dsimp only [s5, s4, s3, evalStep152]
    rw [Function.update_self, Function.update_of_ne h4.symm, Function.update_of_ne h1,
      Function.update_of_ne h6, Function.update_of_ne h3, hs2_sig, hs2_ci, hadd2]
  change s6 = _
  funext w
  by_cases hw_co : w = ciOut
  · subst hw_co
    dsimp only [s6, evalStep152]
    rw [Function.update_self, Function.update_self, hs5_co, hs5_ci]
  · dsimp only [s6, evalStep152]
    rw [Function.update_of_ne hw_co, Function.update_of_ne hw_co]
    by_cases hw_fi : w = fi
    · subst hw_fi; exact hs5_fi
    · by_cases hw_sig : w = sig
      · subst hw_sig; exact hs5_sig
      · dsimp only [s5, s4, s3, s2, s1, evalStep152]
        rw [Function.update_of_ne hw_sig, Function.update_of_ne hw_fi,
          Function.update_of_ne hw_co, Function.update_of_ne hw_sig,
          Function.update_of_ne hw_fi]


theorem evalProg152_pPopBasisSteps152 (α : BitAssignment 152)
    (hmaj : α wPopMaj_152 = 0) (hpar : α wPopPar_152 = 0) (htop : α wBrTop_152 = 0) :
    evalProg152 pPopBasisSteps152 α = popBasisMap152 α := by
  have hmaj_alg : ∀ d0 d1 d2 : ZMod 2,
      (d1 + d0) * (d2 + d0) + d0 = d0 * d1 + (d0 + d1) * d2 := by decide
  have hsplit : pPopBasisSteps152 =
      [.cnot (rB1_152 0) wPopPar_152, .cnot (rB1_152 1) wPopPar_152,
        .cnot (rB1_152 2) wPopPar_152] ++
      [.cnot (rB1_152 0) (rB1_152 1), .cnot (rB1_152 0) (rB1_152 2),
       .tempAnd (rB1_152 1) (rB1_152 2) wPopMaj_152,
       .cnot (rB1_152 0) (rB1_152 1), .cnot (rB1_152 0) (rB1_152 2),
       .cnot (rB1_152 0) wPopMaj_152] ++
      [.tempAnd wPopMaj_152 wPopPar_152 wBrTop_152] := rfl
  rw [hsplit, evalProg152_append, evalProg152_append]
  let par := α (rB1_152 0) + α (rB1_152 1) + α (rB1_152 2)
  let s3 := Function.update α wPopPar_152 par
  have hs1 : evalStep152 (.cnot (rB1_152 0) wPopPar_152) α =
      Function.update α wPopPar_152 (α (rB1_152 0)) := by
    dsimp only [evalStep152]; rw [hpar, zero_add]
  have hs2 : evalStep152 (.cnot (rB1_152 1) wPopPar_152)
      (Function.update α wPopPar_152 (α (rB1_152 0))) =
      Function.update α wPopPar_152 (α (rB1_152 0) + α (rB1_152 1)) := by
    dsimp only [evalStep152]
    rw [update_idem_wire, Function.update_self,
      Function.update_of_ne (by decide : rB1_152 1 ≠ wPopPar_152)]
  have hs3 : evalProg152
      [.cnot (rB1_152 0) wPopPar_152, .cnot (rB1_152 1) wPopPar_152,
        .cnot (rB1_152 2) wPopPar_152] α = s3 := by
    dsimp only [evalProg152]
    rw [hs1, hs2]
    dsimp only [evalStep152, s3, par]
    rw [update_idem_wire, Function.update_self,
      Function.update_of_ne (by decide : rB1_152 2 ≠ wPopPar_152)]
  rw [hs3]
  have hs3_maj : s3 wPopMaj_152 = 0 := by
    dsimp only [s3]; rw [Function.update_of_ne (by decide : wPopMaj_152 ≠ wPopPar_152), hmaj]
  rw [evalProg152_carryMaj6 (rB1_152 0) (rB1_152 1) (rB1_152 2) wPopMaj_152
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s3 hs3_maj]
  have hs3_0 : s3 (rB1_152 0) = α (rB1_152 0) := by
    dsimp only [s3]; rw [Function.update_of_ne (by decide : rB1_152 0 ≠ wPopPar_152)]
  have hs3_1 : s3 (rB1_152 1) = α (rB1_152 1) := by
    dsimp only [s3]; rw [Function.update_of_ne (by decide : rB1_152 1 ≠ wPopPar_152)]
  have hs3_2 : s3 (rB1_152 2) = α (rB1_152 2) := by
    dsimp only [s3]; rw [Function.update_of_ne (by decide : rB1_152 2 ≠ wPopPar_152)]
  rw [hs3_0, hs3_1, hs3_2, hmaj_alg]
  let maj := α (rB1_152 0) * α (rB1_152 1) + (α (rB1_152 0) + α (rB1_152 1)) * α (rB1_152 2)
  let s9 := Function.update s3 wPopMaj_152 maj
  change evalProg152 [.tempAnd wPopMaj_152 wPopPar_152 wBrTop_152] s9 = popBasisMap152 α
  have hs9_top : s9 wBrTop_152 = 0 := by
    dsimp only [s9, s3]
    rw [Function.update_of_ne (by decide : wBrTop_152 ≠ wPopMaj_152),
      Function.update_of_ne (by decide : wBrTop_152 ≠ wPopPar_152), htop]
  dsimp only [evalProg152]
  rw [evalStep152_tempAnd_zero wPopMaj_152 wPopPar_152 wBrTop_152 s9 hs9_top]
  have hs9_maj : s9 wPopMaj_152 = maj := by dsimp only [s9]; rw [Function.update_self]
  have hs9_par : s9 wPopPar_152 = par := by
    dsimp only [s9, s3]
    rw [Function.update_of_ne (by decide : wPopPar_152 ≠ wPopMaj_152), Function.update_self]
  rw [hs9_maj, hs9_par]
  rfl


def emitSigXorSteps152 (δ : Anf4) : List CleanStep152 :=
  (if δ.c0 = 1 then [.x wPopT01_152] else []) ++
  (if δ.cd = 1 then [.cnot wPopPar_152 wPopT01_152] else []) ++
  (if δ.cm = 1 then [.cnot wPopMaj_152 wPopT01_152] else []) ++
  (if δ.cmp = 1 then [.cnot wBrTop_152 wPopT01_152] else [])


theorem evalProg152_emitSigXorSteps152 (δ : Anf4) (γ : BitAssignment 152)
    (htop : γ wBrTop_152 = γ wPopMaj_152 * γ wPopPar_152) :
    evalProg152 (emitSigXorSteps152 δ) γ =
      Function.update γ wPopT01_152
        (γ wPopT01_152 + evalAnf4 δ (γ wPopPar_152) (γ wPopMaj_152)) := by
  have s0 : ∀ ξ : BitAssignment 152,
      evalProg152 (if δ.c0 = 1 then [.x wPopT01_152] else []) ξ =
        Function.update ξ wPopT01_152 (ξ wPopT01_152 + δ.c0) := by
    intro ξ; rcases bit_cases δ.c0 with h | h <;> simp [h, evalProg152, evalStep152]
  have s1 : ∀ ξ : BitAssignment 152,
      evalProg152 (if δ.cd = 1 then [.cnot wPopPar_152 wPopT01_152] else []) ξ =
        Function.update ξ wPopT01_152 (ξ wPopT01_152 + δ.cd * ξ wPopPar_152) := by
    intro ξ; rcases bit_cases δ.cd with h | h <;> simp [h, evalProg152, evalStep152]
  have s2 : ∀ ξ : BitAssignment 152,
      evalProg152 (if δ.cm = 1 then [.cnot wPopMaj_152 wPopT01_152] else []) ξ =
        Function.update ξ wPopT01_152 (ξ wPopT01_152 + δ.cm * ξ wPopMaj_152) := by
    intro ξ; rcases bit_cases δ.cm with h | h <;> simp [h, evalProg152, evalStep152]
  have s3 : ∀ ξ : BitAssignment 152,
      evalProg152 (if δ.cmp = 1 then [.cnot wBrTop_152 wPopT01_152] else []) ξ =
        Function.update ξ wPopT01_152 (ξ wPopT01_152 + δ.cmp * ξ wBrTop_152) := by
    intro ξ; rcases bit_cases δ.cmp with h | h <;> simp [h, evalProg152, evalStep152]
  dsimp only [emitSigXorSteps152]
  rw [evalProg152_append, evalProg152_append, evalProg152_append]
  rw [s0]
  rw [s1, update_idem_wire, Function.update_self,
    Function.update_of_ne (by decide : wPopPar_152 ≠ wPopT01_152)]
  rw [s2, update_idem_wire, Function.update_self,
    Function.update_of_ne (by decide : wPopMaj_152 ≠ wPopT01_152)]
  rw [s3, update_idem_wire, Function.update_self,
    Function.update_of_ne (by decide : wBrTop_152 ≠ wPopT01_152)]
  congr 1
  rw [htop]
  dsimp only [evalAnf4]
  ring


def carryPrefixSteps152 : (k : ℕ) → k ≤ 30 → List CleanStep152 × Anf4
  | 0, _ => ([], anfZero)
  | i + 1, hi =>
      let prev := carryPrefixSteps152 i (Nat.le_of_succ_le hi)
      let fi := rFine30_152 ⟨i, hi⟩
      let ciOut := scr30_152 ⟨i, hi⟩
      let a := anfOfStage i
      if _h0 : i = 0 then
        (prev.1 ++ emitSigXorSteps152 (anfXor prev.2 a) ++ [.tempAnd fi wPopT01_152 ciOut], a)
      else
        let ciIn := scr30_152 ⟨i - 1, by omega⟩
        if a = anfZero then
          (prev.1 ++ [.tempAnd fi ciIn ciOut], prev.2)
        else if a = anfOne then
          (prev.1 ++ [.x fi, .tempAnd fi ciIn ciOut, .x fi, .cnot fi ciOut], prev.2)
        else
          (prev.1 ++ emitSigXorSteps152 (anfXor prev.2 a) ++
            [.cnot ciIn fi, .cnot ciIn wPopT01_152, .tempAnd fi wPopT01_152 ciOut,
             .cnot ciIn fi, .cnot ciIn wPopT01_152, .cnot ciIn ciOut], a)


def carryPrefixMap152 (k : ℕ) (cur : Anf4) (α : BitAssignment 152) : BitAssignment 152 :=
  let base := popBasisMap152 α
  let fVal := fine30Val152 α
  let kVal := kAdd4 (dpPop3_152 α)
  fun w ↦
    if w = wPopT01_152 then
      evalAnf4 cur (base wPopPar_152) (base wPopMaj_152)
    else if 86 ≤ w.val ∧ w.val < 86 + k then
      ((natCarry fVal kVal (w.val - 86 + 1) : ℕ) : ZMod 2)
    else
      base w


def pCarry32Steps152 : List CleanStep152 :=
  let p30 := carryPrefixSteps152 30 le_rfl
  pPopBasisSteps152 ++ p30.1 ++ emitSigXorSteps152 p30.2


def carry32Map152 (α : BitAssignment 152) : BitAssignment 152 :=
  carryPrefixMap152 30 anfZero α


theorem evalProg152_carryPrefixSteps152 (α : BitAssignment 152)
    (hscr : ∀ j : Fin 30, α (scr30_152 j) = 0)
    (ht01 : α wPopT01_152 = 0) :
    ∀ (k : ℕ) (hk : k ≤ 30),
      evalProg152 (carryPrefixSteps152 k hk).1 (popBasisMap152 α) =
        carryPrefixMap152 k (carryPrefixSteps152 k hk).2 α
  | 0, _ => by
      simp only [carryPrefixSteps152, evalProg152]
      funext w
      by_cases hw : w = wPopT01_152
      · subst hw
        rw [popBasisMap152_outside α wPopT01_152 (by decide), ht01]
        simp [carryPrefixMap152, evalAnf4_zero]
      · have hnr : ¬(86 ≤ w.val ∧ w.val < 86 + 0) := by omega
        dsimp only [carryPrefixMap152]
        rw [ite_eq_right hw, ite_eq_right hnr]
  | i + 1, hi => by
      have ih := evalProg152_carryPrefixSteps152 α hscr ht01 i (Nat.le_of_succ_le hi)
      set prev := carryPrefixSteps152 i (Nat.le_of_succ_le hi)
      set γ := carryPrefixMap152 i prev.2 α
      set base := popBasisMap152 α
      set par := base wPopPar_152
      set maj := base wPopMaj_152
      set fi := rFine30_152 ⟨i, hi⟩
      set ciOut := scr30_152 ⟨i, hi⟩
      have hpar_eq : par = α (rB1_152 0) + α (rB1_152 1) + α (rB1_152 2) := by
        dsimp only [par, base, popBasisMap152]
        rw [Function.update_of_ne (by decide : wPopPar_152 ≠ wBrTop_152),
          Function.update_of_ne (by decide : wPopPar_152 ≠ wPopMaj_152),
          Function.update_self]
      have hmaj_eq : maj = α (rB1_152 0) * α (rB1_152 1) +
