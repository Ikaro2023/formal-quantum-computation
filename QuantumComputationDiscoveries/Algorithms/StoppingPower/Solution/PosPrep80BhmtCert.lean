theorem ket_injective_poly {m : ℕ} {α β : BitAssignment m} (h : ket α = ket β) : α = β := by
  have hx := congrFun h ((basisBitsEquiv m).symm α)
  rw [ket_eq_single_local α, ket_eq_single_local β, Pi.single_eq_same] at hx
  by_contra hne
  have hne' : (basisBitsEquiv m).symm α ≠ (basisBitsEquiv m).symm β :=
    fun heq ↦ hne ((basisBitsEquiv m).symm.injective heq)
  rw [Pi.single_eq_of_ne hne'] at hx
  exact one_ne_zero hx


theorem unitary_mulVec_injective {N : ℕ} (U : Unitary N) {x y : Fin N → ℂ}
    (h : U.1.mulVec x = U.1.mulVec y) : x = y := by
  have hinv : (U⁻¹).1 * U.1 = 1 := by
    rw [← Submonoid.coe_mul, inv_mul_cancel, OneMemClass.coe_one]
  have hx := congrArg (U⁻¹).1.mulVec h
  rwa [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec, Matrix.one_mulVec] at hx


