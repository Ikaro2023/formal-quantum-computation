private theorem blkMod4_eq_of_eq_outside_scratch16_all_of_tM
    (tM : Fin Dyadic128CoulombMath.orbitCount47905 → Fin (2 ^ 30))
    (qft : FullSysCatSegmentBridge.FullSysQft654Bundle)
    (cfg : SpecsAux.SpecMirror.Configuration)
    (s0 : Bool) (p₁ p₂ : BitAssignment 80)
    (heq : ∀ j : Fin 80, ¬(63 ≤ j.val ∧ j.val < 79) → p₁ j = p₂ j) :
    PosS3Bounds.sysBlock80Mod4Of tM qft cfg s0 p₁ =
      PosS3Bounds.sysBlock80Mod4Of tM qft cfg s0 p₂ := by
  unfold PosS3Bounds.sysBlock80Mod4Of
  let N80 := FullSysCatSegmentBridge.fullSysCoreWires 80
  let δ : BitAssignment 16 := fun j ↦ p₁ ⟨63 + j.val, by omega⟩ + p₂ ⟨63 + j.val, by omega⟩
  let P_scr : Operator (2 ^ N80) := rScratch16Core.embedMatrix (xor16Mat δ)
  have hP_inv : P_scr * P_scr = 1 := by
    dsimp only [P_scr]
    rw [← rScratch16Core.embedMatrix_mul, xor16Mat_mul_self, QRegister.embedMatrix_one]
  have hP_sa : P_scrᴴ = P_scr := by
    dsimp only [P_scr]
    rw [← rScratch16Core.embedMatrix_conjTranspose, xor16Mat_sa]
  let permBits (γ : BitAssignment N80) : BitAssignment N80 := fun q ↦
    if h : 4017 ≤ q.val ∧ q.val < 4033 then γ q + δ ⟨q.val - 4017, by omega⟩ else γ q
  have hPermBits_inv : ∀ γ, permBits (permBits γ) = γ := fun γ ↦ by
    funext q; dsimp only [permBits]; split_ifs <;>
      simp only [add_assoc, CharTwo.add_self_eq_zero, add_zero]
  have hBB : ∀ idx : Fin (2 ^ N80), basisBits N80 idx = basisBitsEquiv N80 idx := fun _ ↦ rfl
  let permIdx (idx : Fin (2 ^ N80)) : Fin (2 ^ N80) :=
    (basisBitsEquiv N80).symm (permBits (basisBitsEquiv N80 idx))
  have hPermIdx_inv : ∀ idx, permIdx (permIdx idx) = idx := fun idx ↦ by
    dsimp only [permIdx]
    rw [(basisBitsEquiv N80).apply_symm_apply, hPermBits_inv, (basisBitsEquiv N80).symm_apply_apply]
  have hPermMul : ∀ a b, P_scr a b = if a = permIdx b then 1 else 0 := fun a b ↦ by
    dsimp only [P_scr]
    by_cases hag : rScratch16Core.AgreeOutside a b
    · rw [embedMatrix_entry_of_agreeOutside rScratch16Core _ hag]
      simp only [xor16Mat, Matrix.of_apply]
      have hiff : (basisBits 16 (rScratch16Core.extractIndex a) =
          basisBits 16 (rScratch16Core.extractIndex b) + δ) ↔ (a = permIdx b) := by
        constructor
        · intro hsub
          apply (basisBitsEquiv N80).injective; funext q
          dsimp only [permIdx, permBits]
          rw [(basisBitsEquiv N80).apply_symm_apply]
          by_cases hs : 4017 ≤ q.val ∧ q.val < 4033
          · rw [dite_eq_left (hs)]
            have hj := congrFun hsub ⟨q.val - 4017, by omega⟩
            rw [Pi.add_apply, QRegister.basisBits_extractIndex,
              QRegister.basisBits_extractIndex] at hj
            have hqeq : rScratch16Core ⟨q.val - 4017, by omega⟩ = q :=
              Fin.ext (by
                dsimp [rScratch16Core, PosSlots24Semantic80PhysicsAlt.qreg_block_apply,
                  PosSlots24Semantic80PhysicsAlt.qreg_block_wires_apply,
                  PosSlots24Semantic80PhysicsAlt.qreg_whole_wires,
                  PosSlots24Semantic80PhysicsAlt.emb_trans_apply,
                  PosSlots24Semantic80PhysicsAlt.emb_refl_apply,
                  PosSlots24Semantic80PhysicsAlt.emb_mk_apply]; omega)
            rw [hqeq] at hj
            rw [← hBB a, ← hBB b]
            exact hj
          · rw [dite_eq_right (hs), ← hBB a, ← hBB b]
            exact hag q (fun ⟨j, hj⟩ ↦
              hs (by
                subst hj
                dsimp [rScratch16Core,
                  PosSlots24Semantic80PhysicsAlt.qreg_block_apply,
                  PosSlots24Semantic80PhysicsAlt.qreg_block_wires_apply,
                  PosSlots24Semantic80PhysicsAlt.qreg_whole_wires,
                  PosSlots24Semantic80PhysicsAlt.emb_trans_apply,
                  PosSlots24Semantic80PhysicsAlt.emb_refl_apply,
                  PosSlots24Semantic80PhysicsAlt.emb_mk_apply]; omega))
        · intro heqIdx; subst heqIdx
          funext j
          rw [Pi.add_apply, QRegister.basisBits_extractIndex, QRegister.basisBits_extractIndex]
          dsimp only [permIdx, permBits]
          rw [hBB, (basisBitsEquiv N80).apply_symm_apply, ← hBB]
          have hs : 4017 ≤ (rScratch16Core j).val ∧ (rScratch16Core j).val < 4033 := by
            have := j.isLt
            dsimp [rScratch16Core, PosSlots24Semantic80PhysicsAlt.qreg_block_apply,
              PosSlots24Semantic80PhysicsAlt.qreg_block_wires_apply,
              PosSlots24Semantic80PhysicsAlt.qreg_whole_wires,
              PosSlots24Semantic80PhysicsAlt.emb_trans_apply,
              PosSlots24Semantic80PhysicsAlt.emb_refl_apply,
              PosSlots24Semantic80PhysicsAlt.emb_mk_apply]; omega
          rw [dite_eq_left (hs)]
          have hj_eq : (⟨(rScratch16Core j).val - 4017, by omega⟩ : Fin 16) = j :=
            Fin.ext (by
              dsimp [rScratch16Core, PosSlots24Semantic80PhysicsAlt.qreg_block_apply,
                PosSlots24Semantic80PhysicsAlt.qreg_block_wires_apply,
                PosSlots24Semantic80PhysicsAlt.qreg_whole_wires,
                PosSlots24Semantic80PhysicsAlt.emb_trans_apply,
                PosSlots24Semantic80PhysicsAlt.emb_refl_apply,
                PosSlots24Semantic80PhysicsAlt.emb_mk_apply]; omega)
          rw [hj_eq]
      split_ifs with h1 h2
      · rfl
      · exact False.elim (h2 (hiff.mp h1))
      · rename_i h2; exact False.elim (h1 (hiff.mpr h2))
      · rfl
    · rw [embedMatrix_entry_of_not_agreeOutside rScratch16Core _ hag]
      have hne : a ≠ permIdx b := fun heqIdx ↦ hag (fun q hnot ↦ by
        subst heqIdx
        dsimp only [permIdx, permBits]
        rw [hBB, (basisBitsEquiv N80).apply_symm_apply, ← hBB]
        have hs : ¬(4017 ≤ q.val ∧ q.val < 4033) := fun hs0 ↦
          hnot ⟨⟨q.val - 4017, by omega⟩, Fin.ext (by
            dsimp [rScratch16Core,
              PosSlots24Semantic80PhysicsAlt.qreg_block_apply,
              PosSlots24Semantic80PhysicsAlt.qreg_block_wires_apply,
              PosSlots24Semantic80PhysicsAlt.qreg_whole_wires,
              PosSlots24Semantic80PhysicsAlt.emb_trans_apply,
              PosSlots24Semantic80PhysicsAlt.emb_refl_apply,
              PosSlots24Semantic80PhysicsAlt.emb_mk_apply]; omega)⟩
        rw [dite_eq_right (hs)])
      split_ifs with hh
      · exact False.elim (hne hh)
      · rfl
  have hPermKet : ∀ γ : BitAssignment N80,
      P_scr.mulVec (MeasureBranchHadamardSem.ket γ) =
        MeasureBranchHadamardSem.ket (permBits γ) := fun γ ↦ by
    ext a
    let g := (basisBitsEquiv N80).symm γ
    let g' := (basisBitsEquiv N80).symm (permBits γ)
    have hket_g : MeasureBranchHadamardSem.ket γ = Pi.single g (1 : ℂ) := rfl
    have hket_g' : MeasureBranchHadamardSem.ket (permBits γ) = Pi.single g' (1 : ℂ) := rfl
    have hpg : permIdx g = g' := by
      dsimp only [permIdx, g, g']; rw [(basisBitsEquiv N80).apply_symm_apply]
    rw [hket_g, hket_g', Matrix.mulVec_single, MulOpposite.op_one, one_smul, Matrix.col_apply,
      hPermMul a g, hpg]
    by_cases ha : a = g'
    · subst ha; simp only [↓reduceIte, Pi.single_eq_same]
    · simp only [ha, ↓reduceIte, Pi.single_eq_of_ne ha]
  have hQftComm : (FullSysCatSegmentBridge.fullSysQftCoreUnitary pos24_6_le_80 qft).1 * P_scr =
      P_scr * (FullSysCatSegmentBridge.fullSysQftCoreUnitary pos24_6_le_80 qft).1 := by
    rw [FullSysCatSegmentBridge.fullSysQftCoreUnitary, QRegister.embedUnitary_val]
    exact QRegister.embedMatrix_comm_of_disjoint
      (FullSysCatSegmentBridge.coreElecCosetB1Block pos24_6_le_80)
      rScratch16Core coreElecCosetB1_disjoint_rScratch16Core qft.uQft654.1 (xor16Mat δ)
  have hTwComm : (castUnitaryPow2 pos24_core80_eq_twist80.symm
      (NuclearTwistRealizes.uTwistParam true pos24_22_le_80 cfg)).1 * P_scr =
      P_scr * (castUnitaryPow2 pos24_core80_eq_twist80.symm
        (NuclearTwistRealizes.uTwistParam true pos24_22_le_80 cfg)).1 := by
    have hCast : (castUnitaryPow2 pos24_core80_eq_twist80.symm
        (NuclearTwistRealizes.uTwistParam true pos24_22_le_80 cfg)).1 =
        (NuclearTwistRealizes.uTwistParam true pos24_22_le_80 cfg).1 := rfl
    rw [hCast]
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro γ
    let rId := QRegExt.ofFin N80
    have hEmb : (rId.embedUnitary (NuclearTwistRealizes.uTwistParam true pos24_22_le_80 cfg)).1 =
        (NuclearTwistRealizes.uTwistParam true pos24_22_le_80 cfg).1 :=
      congrArg Subtype.val (ofFin_embedUnitary_eq _)
    have hIdFn : ∀ β : BitAssignment N80,
        (fun z : Wire N80 ↦
          if hz : z ∈ rId.image then
            NuclearTwistRealizes.twistCorePermFn true pos24_22_le_80 (fun q ↦ β (rId q))
              (Classical.choose ((QRegister.mem_image rId z).mp hz))
          else β z) =
        NuclearTwistRealizes.twistCorePermFn true pos24_22_le_80 β := fun β ↦ by
      funext z
      have hz : z ∈ rId.image := (QRegister.mem_image rId z).mpr ⟨z, rfl⟩
      have hch : Classical.choose ((QRegister.mem_image rId z).mp hz) = z :=
        Classical.choose_spec ((QRegister.mem_image rId z).mp hz)
      simp only [hz, ↓reduceDIte, hch]
      rfl
    have hKetEq : ∀ β : BitAssignment N80,
        (NuclearTwistRealizes.uTwistParam true pos24_22_le_80 cfg).1.mulVec
          (MeasureBranchHadamardSem.ket β) =
        NuclearTwistRealizes.twistCorePhase true pos24_22_le_80 cfg β •
          MeasureBranchHadamardSem.ket
            (NuclearTwistRealizes.twistCorePermFn true pos24_22_le_80 β) := fun β ↦ by
      rw [← hEmb]
      have hv := NuclearTwistRealizes.uTwistParam_mulVec_basisKet true pos24_22_le_80 cfg rId β
      rw [hIdFn β] at hv
      exact hv
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hPermKet γ, hKetEq (permBits γ),
      hKetEq γ, Matrix.mulVec_smul, hPermKet]
    have hlt : ∀ q : Fin N80, q.val < 3976 → permBits γ q = γ q := fun q hq ↦ by
      dsimp only [permBits]; have hs : ¬(4017 ≤ q.val ∧ q.val < 4033) := by omega
      rw [dite_eq_right (hs)]
    obtain ⟨hPhEq, hPermLt⟩ := twistCore_eq_of_lt3976 cfg (permBits γ) γ hlt
    have hPermComm : NuclearTwistRealizes.twistCorePermFn true pos24_22_le_80 (permBits γ) =
        permBits (NuclearTwistRealizes.twistCorePermFn true pos24_22_le_80 γ) := by
      funext q
      by_cases hq : q.val < 3976
      · rw [hPermLt q hq]
        dsimp only [permBits]
        have hs : ¬(4017 ≤ q.val ∧ q.val < 4033) := by omega
        rw [dite_eq_right (hs)]
      · rw [NuclearTwistRealizes.twistCorePermFn_high_eq true pos24_22_le_80 _ q (by omega)]
        dsimp only [permBits]
        rw [NuclearTwistRealizes.twistCorePermFn_high_eq true pos24_22_le_80 _ q (by omega)]
    rw [hPhEq, hPermComm]
  have hPhComm : (castUnitaryPow2 pos24_coreWires80_eq.symm
      (PosS3Bounds.uPosPhaseRealMod4 true pos24TailSign tM)).1 * P_scr =
      P_scr * (castUnitaryPow2 pos24_coreWires80_eq.symm
        (PosS3Bounds.uPosPhaseRealMod4 true pos24TailSign tM)).1 := by
    have hCast : (castUnitaryPow2 pos24_coreWires80_eq.symm
        (PosS3Bounds.uPosPhaseRealMod4 true pos24TailSign tM)).1 =
        (PosS3Bounds.uPosPhaseRealMod4 true pos24TailSign tM).1 := rfl
    rw [hCast]
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro γ
    have hKetPh : ∀ β : BitAssignment N80,
        (PosS3Bounds.uPosPhaseRealMod4 true pos24TailSign tM).1.mulVec
          (MeasureBranchHadamardSem.ket β) =
        (if PosS3Bounds.posPhaseBitMod4 true pos24TailSign tM β then (-1 : ℂ) else 1) •
          MeasureBranchHadamardSem.ket β := fun β ↦
      BchCubeDecoder.ket_diagonalSignUnitaryN (PosS3Bounds.posPhaseBitMod4 true pos24TailSign tM) β
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hPermKet γ, hKetPh (permBits γ),
      hKetPh γ, Matrix.mulVec_smul, hPermKet]
    have hpb := PosMod4FermionicBounds.posPhaseBitMod4_eq_of_eq_active true pos24TailSign tM
      (permBits γ) γ (fun q hq ↦ by
        have hs : ¬(4017 ≤ q.val ∧ q.val < 4033) := fun hs0 ↦ hq (Or.inr (Or.inr hs0))
        dsimp only [permBits]; rw [dite_eq_right hs])
    rw [hpb]
  have hConjComm : P_scr * (PosS3Bounds.pos24ConjCore80Mod4Of tM qft cfg).1 * P_scr =
    (PosS3Bounds.pos24ConjCore80Mod4Of tM qft cfg).1 := by
    unfold PosS3Bounds.pos24ConjCore80Mod4Of PosMomSelectDynamic.unitaryConj
    let U_out : Operator (2 ^ N80) :=
      (mulUnitaryPow2
        (FullSysCatSegmentBridge.fullSysQftCoreUnitary pos24_6_le_80 qft)
        (uTwistParam true pos24_22_le_80 cfg)
        pos24_core80_eq_twist80).1
    let U_ph : Operator (2 ^ N80) :=
      (castUnitaryPow2 pos24_coreWires80_eq.symm
        (PosS3Bounds.uPosPhaseRealMod4 true pos24TailSign tM)).1
    have hOutComm : U_out * P_scr = P_scr * U_out := by
      dsimp only [U_out, mulUnitaryPow2, Submonoid.coe_mul]
      dsimp only [castUnitaryPow2] at hTwComm
      rw [Matrix.mul_assoc, hTwComm, ← Matrix.mul_assoc, hQftComm, Matrix.mul_assoc]
    have hOutAdjComm : U_outᴴ * P_scr = P_scr * U_outᴴ :=
      comm_conjTranspose_of_selfAdj hP_sa hOutComm
    change P_scr * (U_outᴴ * U_ph * U_out) * P_scr = U_outᴴ * U_ph * U_out
    calc P_scr * (U_outᴴ * U_ph * U_out) * P_scr
        = (P_scr * U_outᴴ) * U_ph * (U_out * P_scr) := by simp only [Matrix.mul_assoc]
      _ = (U_outᴴ * P_scr) * U_ph * (P_scr * U_out) := by rw [hOutAdjComm.symm, hOutComm]
      _ = U_outᴴ * (P_scr * U_ph) * (P_scr * U_out) := by simp only [Matrix.mul_assoc]
      _ = U_outᴴ * (U_ph * P_scr) * (P_scr * U_out) := by rw [hPhComm.symm]
      _ = U_outᴴ * U_ph * (P_scr * P_scr) * U_out := by simp only [Matrix.mul_assoc]
      _ = U_outᴴ * U_ph * U_out := by rw [hP_inv, mul_one]
  have hCorePerm : ∀ z, permIdx (coreIdxOf pos24_coreWires80_eq.symm s0 p₁ z) =
      coreIdxOf pos24_coreWires80_eq.symm s0 p₂ z := fun z ↦ by
    apply (basisBitsEquiv N80).injective; funext q
    have hSub80 : PosSlots24BranchConcrete.posPayloadWires = 80 := rfl
    have hq_lt : q.val < 4034 := by
