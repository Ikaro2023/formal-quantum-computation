            (listAcc48_152[k]'(by rw [length_listAcc48_152]; omega))
            (listRefl49_152[k]'(by rw [length_listRefl49_152]; omega))
            (listAcc48_152[k + 1]'(by rw [length_listAcc48_152]; omega))]
      else pZeroRefl48ChainPrefix k


theorem pZeroRefl48Chain_eq_prefix47 : pZeroRefl48Chain = pZeroRefl48ChainPrefix 47 := by decide


theorem listAcc48_nodup : listAcc48_152.Nodup := by decide


theorem listAcc48_disj_refl49 :
    ∀ (i : Fin 48) (j : Fin 49),
      listAcc48_152[i.val]'(by rw [length_listAcc48_152]; exact i.isLt) ≠
        listRefl49_152[j.val]'(by rw [length_listRefl49_152]; exact j.isLt) := by
