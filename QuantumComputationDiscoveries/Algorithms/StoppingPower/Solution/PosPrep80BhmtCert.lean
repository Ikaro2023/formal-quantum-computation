      (basisBitsEquiv 2).apply_symm_apply _
    have hb0 : basisBits 2 ((basisBitsEquiv 2).symm
        (fun k : Fin 2 ↦ p (pos80SubIdx 70 2 (by decide) k))) 0 = p 70 :=
      congrFun hSub 0
    have hb1 : basisBits 2 ((basisBitsEquiv 2).symm
