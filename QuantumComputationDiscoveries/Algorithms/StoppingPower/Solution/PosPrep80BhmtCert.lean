def cTeleMux {n : ℕ} (L : ℕ) (branches : List (Wire n × TeleSpec))
    (flips : List (Wire n)) (wPar t : Wire n) : Circuit n :=
  (cMuxWord L (branches.map (fun p => (p.1, p.2.bwdOdds))) wPar t).inverse ;;ᶜ
    cnotList ((branches.filter (fun p => p.2.mx)).map Prod.fst) t ;;ᶜ
    Circuit.H t ;;ᶜ
    cnotList ((branches.filter (fun p => p.2.mz)).map Prod.fst) t ;;ᶜ
    Circuit.H t ;;ᶜ
    cMuxWord L (branches.map (fun p => (p.1, p.2.fwdOdds))) wPar t ;;ᶜ
    cnotList ((branches.filter (fun p => p.2.fl)).map Prod.fst) t ;;ᶜ
    cnotList flips t


@[simp]
theorem count_toff_cTeleMux {n : ℕ} (L : ℕ) (branches : List (Wire n × TeleSpec))
    (flips : List (Wire n)) (wPar t : Wire n) :
    (cTeleMux L branches flips wPar t).count PrimitiveGate.TOFF = 0 := by
  simp [cTeleMux]


@[simp]
theorem count_t_cTeleMux {n : ℕ} (L : ℕ) (branches : List (Wire n × TeleSpec))
    (flips : List (Wire n)) (wPar t : Wire n) :
    (cTeleMux L branches flips wPar t).count PrimitiveGate.T = 2 * L := by
  simp [cTeleMux, two_mul]


noncomputable def teleMuxMat {n : ℕ} (L : ℕ)
    (branches : List (Wire n × TeleSpec)) (flips : List (Wire n))
    (β : BitAssignment n) : Matrix (Fin 2) (Fin 2) ℂ :=
  pauliXPow (listXor flips β) *
    pauliXPow (listXor ((branches.filter (fun p => p.2.fl)).map Prod.fst) β) *
    muxWordMat L (branches.map (fun p => (p.1, p.2.fwdOdds))) β *
    wordMatrix2 [.H] *
    pauliXPow (listXor ((branches.filter (fun p => p.2.mz)).map Prod.fst) β) *
    wordMatrix2 [.H] *
    pauliXPow (listXor ((branches.filter (fun p => p.2.mx)).map Prod.fst) β) *
    (muxWordMat L (branches.map (fun p => (p.1, p.2.bwdOdds))) β)ᴴ


theorem mem_filter_map_fst_sub {n : ℕ} {α : Type*} (xs : List (Wire n × α))
    (p : Wire n × α → Bool) {u : Wire n} (hu : u ∈ (xs.filter p).map Prod.fst) :
    u ∈ xs.map Prod.fst := by
  rcases List.mem_map.mp hu with ⟨x, hx, rfl⟩
  exact List.mem_map.mpr ⟨x, (List.mem_filter.mp hx).1, rfl⟩


theorem cTeleMux_mulVec_ket_embed {n : ℕ} (L : ℕ)
    (branches : List (Wire n × TeleSpec)) (flips : List (Wire n))
    (wPar t : Wire n) (hdisj : PmSplitDisj (branches.map Prod.fst) flips wPar t)
    (β : BitAssignment n) (hwPar : β wPar = 0) :
    (cTeleMux L branches flips wPar t).eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix (teleMuxMat L branches flips β)).mulVec (ket β) := by
  rcases hdisj with ⟨hwpt, hbr, hfl⟩
  let brBwd := branches.map (fun p => (p.1, p.2.bwdOdds))
  let brFwd := branches.map (fun p => (p.1, p.2.fwdOdds))
  let wMx := (branches.filter (fun p => p.2.mx)).map Prod.fst
  let wMz := (branches.filter (fun p => p.2.mz)).map Prod.fst
  let wFl := (branches.filter (fun p => p.2.fl)).map Prod.fst
  have hmapBwd : brBwd.map Prod.fst = branches.map Prod.fst := by simp [brBwd, List.map_map]
  have hmapFwd : brFwd.map Prod.fst = branches.map Prod.fst := by simp [brFwd, List.map_map]
  have hbrBwd : ∀ u ∈ brBwd.map Prod.fst, u ≠ wPar ∧ u ≠ t := by rwa [hmapBwd]
  have hbrFwd : ∀ u ∈ brFwd.map Prod.fst, u ≠ wPar ∧ u ≠ t := by rwa [hmapFwd]
  have hbrBwd_t : ∀ u ∈ brBwd.map Prod.fst, u ≠ t := fun u hu => (hbrBwd u hu).2
  have hbrFwd_t : ∀ u ∈ brFwd.map Prod.fst, u ≠ t := fun u hu => (hbrFwd u hu).2
  have hwMx_t : ∀ u ∈ wMx, u ≠ t := fun u hu => (hbr u (mem_filter_map_fst_sub branches _ hu)).2
  have hwMz_t : ∀ u ∈ wMz, u ≠ t := fun u hu => (hbr u (mem_filter_map_fst_sub branches _ hu)).2
  have hwFl_t : ∀ u ∈ wFl, u ≠ t := fun u hu => (hbr u (mem_filter_map_fst_sub branches _ hu)).2
  have hfl_t : ∀ u ∈ flips, u ≠ t := fun u hu => (hfl u hu).2
  have hinv : (cMuxWord L brBwd wPar t).inverse.eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix ((muxWordMat L brBwd β)ᴴ)).mulVec (ket β) := by
    refine inverse_mulVec_ket_of_embed_unitary (cMuxWord L brBwd wPar t) t
      (muxWordMat L brBwd β) β (muxWordMat_unitary L brBwd β) (fun x => ?_)
    have hwPar_x : Function.update β t x wPar = 0 := by rw [Function.update_of_ne hwpt, hwPar]
    rw [cMuxWord_mulVec_ket_embed L brBwd wPar t hwpt hbrBwd _ hwPar_x,
      muxWordMat_update_of_not_mem L brBwd t x β hbrBwd_t]
  have hcnot_step (ws : List (Wire n)) (hws_t : ∀ u ∈ ws, u ≠ t) (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (cnotList ws t).eval.1.mulVec (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix (pauliXPow (listXor ws β) * A)).mulVec (ket β) := by
    refine mulVec_singleton_embedMatrix_of_ket (cnotList ws t).eval.1 t A
      (pauliXPow (listXor ws β)) β β rfl (fun x => ?_)
    rw [cnotList_mulVec_ket_embed ws t hws_t, listXor_update_of_not_mem ws t x β hws_t]
  have hH_step (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (Circuit.H t).eval.1.mulVec (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix (wordMatrix2 [.H] * A)).mulVec (ket β) := by
    have hH : (Circuit.H t).eval.1 = (QRegister.singleton t).embedMatrix (wordMatrix2 [.H]) :=
      hstGate_eval_eq .H t
    rw [hH, Matrix.mulVec_mulVec, ← QRegister.embedMatrix_mul]
  have hfwd (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (cMuxWord L brFwd wPar t).eval.1.mulVec (((QRegister.singleton t).embedMatrix A).mulVec (ket
        β)) =
        ((QRegister.singleton t).embedMatrix (muxWordMat L brFwd β * A)).mulVec (ket β) := by
    refine mulVec_singleton_embedMatrix_of_ket (cMuxWord L brFwd wPar t).eval.1 t A
      (muxWordMat L brFwd β) β β rfl (fun x => ?_)
    have hwPar_x : Function.update β t x wPar = 0 := by rw [Function.update_of_ne hwpt, hwPar]
    rw [cMuxWord_mulVec_ket_embed L brFwd wPar t hwpt hbrFwd _ hwPar_x,
      muxWordMat_update_of_not_mem L brFwd t x β hbrFwd_t]
  unfold cTeleMux
  change ((cMuxWord L brBwd wPar t).inverse ;;ᶜ cnotList wMx t ;;ᶜ Circuit.H t ;;ᶜ
      cnotList wMz t ;;ᶜ Circuit.H t ;;ᶜ cMuxWord L brFwd wPar t ;;ᶜ
      cnotList wFl t ;;ᶜ cnotList flips t).eval.1.mulVec (ket β) = _
  simp only [MeasureBranchHadamardSem.eval_seq_mulVec]
  rw [hinv, hcnot_step wMx hwMx_t, hH_step, hcnot_step wMz hwMz_t, hH_step,
    hfwd, hcnot_step wFl hwFl_t, hcnot_step flips hfl_t]
  dsimp only [teleMuxMat, brBwd, brFwd, wMx, wMz, wFl]
  simp only [Matrix.mul_assoc]


theorem filter_one_map_proj {n : ℕ} {α β : Type*} (xs : List (Wire n × α)) (f : α → β)
    (γ : BitAssignment n) :
    (xs.filter (fun p => γ p.1 == 1)).map (fun p => (p.1, f p.2)) =
      (xs.map (fun p => (p.1, f p.2))).filter (fun p => γ p.1 == 1) := by
  induction xs with
  | nil => rfl
  | cons p xs ih => cases h : (γ p.1 == 1) <;> simp [List.filter, h, ih]


theorem listXor_filter_one_flag {n : ℕ} {α : Type*} (xs : List (Wire n × α))
    (flag : α → Bool) (β : BitAssignment n) :
    listXor (((xs.filter (fun p => β p.1 == 1)).filter (fun p => flag p.2)).map Prod.fst) β =
      listXor ((xs.filter (fun p => flag p.2)).map Prod.fst) β := by
  rw [List.filter_comm, filter_one_map_fst, listXor_filter_one]


theorem teleMuxMat_filter_one {n : ℕ} (L : ℕ)
    (branches : List (Wire n × TeleSpec)) (flips : List (Wire n))
    (β : BitAssignment n) :
    teleMuxMat L (branches.filter (fun p => β p.1 == 1)) (flips.filter (fun u => β u == 1)) β =
      teleMuxMat L branches flips β := by
  dsimp only [teleMuxMat]
  rw [listXor_filter_one flips β,
    listXor_filter_one_flag branches (fun s => s.fl) β,
    listXor_filter_one_flag branches (fun s => s.mz) β,
    listXor_filter_one_flag branches (fun s => s.mx) β,
    filter_one_map_proj branches (fun s => s.fwdOdds) β,
    filter_one_map_proj branches (fun s => s.bwdOdds) β,
    muxWordMat_filter_one L _ β,
    muxWordMat_filter_one L _ β]


theorem teleMuxMat_nil {n : ℕ} (L : ℕ) (β : BitAssignment n) :
    teleMuxMat L ([] : List (Wire n × TeleSpec)) ([] : List (Wire n)) β = 1 := by
  dsimp [teleMuxMat, listXor]
  have hH2 : wordMatrix2 [.H] * pauliXPow 0 * wordMatrix2 [.H] = 1 := by
    rw [wordMatrix2_H_pauliXPow_H 0]; rfl
  have hX0 : pauliXPow 0 = 1 := rfl
  rw [hX0]
  calc (1 : Matrix (Fin 2) (Fin 2) ℂ) * 1 * muxWordMat L [] β * wordMatrix2 [.H] * 1 *
        wordMatrix2 [.H] * 1 * (muxWordMat L [] β)ᴴ
      = muxWordMat L [] β * (wordMatrix2 [.H] * pauliXPow 0 * wordMatrix2 [.H]) *
          (muxWordMat L [] β)ᴴ := by
          rw [hX0]; simp only [Matrix.one_mul, Matrix.mul_one, Matrix.mul_assoc]
    _ = 1 := by rw [hH2, Matrix.mul_one, muxWordMat_unitary]


theorem cTeleMux_mulVec_ket_zero {n : ℕ} (L : ℕ)
    (branches : List (Wire n × TeleSpec)) (flips : List (Wire n))
    (wPar t : Wire n) (hdisj : PmSplitDisj (branches.map Prod.fst) flips wPar t)
    (β : BitAssignment n) (hwPar : β wPar = 0)
    (hbr : branches.filter (fun p => β p.1 == 1) = [])
    (hfl : flips.filter (fun u => β u == 1) = []) :
    (cTeleMux L branches flips wPar t).eval.1.mulVec (ket β) = ket β := by
  rw [cTeleMux_mulVec_ket_embed L branches flips wPar t hdisj β hwPar,
    ← teleMuxMat_filter_one L branches flips β, hbr, hfl,
    teleMuxMat_nil L β, QRegister.embedMatrix_one, Matrix.one_mulVec]


theorem cTeleMux_mulVec_ket_flip {n : ℕ} (L : ℕ)
    (branches : List (Wire n × TeleSpec)) (flips : List (Wire n))
    (wPar t u : Wire n) (hdisj : PmSplitDisj (branches.map Prod.fst) flips wPar t)
    (β : BitAssignment n) (hwPar : β wPar = 0) (ht : β t = 0)
    (hbr : branches.filter (fun p => β p.1 == 1) = [])
    (hfl : flips.filter (fun w => β w == 1) = [u]) :
    (cTeleMux L branches flips wPar t).eval.1.mulVec (ket β) = ket (Function.update β t 1) := by
  have hu_mem : u ∈ flips.filter (fun w => β w == 1) := by rw [hfl]; simp
  have hu : β u = 1 := (List.mem_filter.mp hu_mem).2 |> (beq_iff_eq ..).mp
  rw [cTeleMux_mulVec_ket_embed L branches flips wPar t hdisj β hwPar,
    ← teleMuxMat_filter_one L branches flips β, hbr, hfl]
  have hmat : teleMuxMat L ([] : List (Wire n × TeleSpec)) [u] β = pauliXPow 1 := by
    have hnil := teleMuxMat_nil L β
    dsimp [teleMuxMat, listXor, List.map, List.filter] at hnil ⊢
    have hX0 : pauliXPow 0 = 1 := rfl
    rw [hu, add_zero]
    calc pauliXPow 1 * pauliXPow 0 * muxWordMat L [] β * wordMatrix2 [.H] * pauliXPow 0 *
          wordMatrix2 [.H] * pauliXPow 0 * (muxWordMat L [] β)ᴴ
        = pauliXPow 1 * (pauliXPow 0 * pauliXPow 0 * muxWordMat L [] β * wordMatrix2 [.H] *
            pauliXPow 0 * wordMatrix2 [.H] * pauliXPow 0 * (muxWordMat L [] β)ᴴ) := by
            rw [hX0]; simp only [Matrix.one_mul, Matrix.mul_one, Matrix.mul_assoc]
      _ = pauliXPow 1 := by rw [hnil, Matrix.mul_one]
  rw [hmat, ← ket_update_add_eq_pauliXPow_embed, ht, zero_add]


theorem listXor_singleton_flag {n : ℕ} (u : Wire n) (s : TeleSpec) (flag : TeleSpec → Bool)
    (β : BitAssignment n) (hu : β u = 1) :
    listXor ((([(u, s)].filter (fun p => flag p.2)).map Prod.fst)) β =
      if flag s then 1 else 0 := by
  cases h : flag s <;> simp [List.filter, h, listXor, hu]


theorem teleMuxMat_singleton_one {n : ℕ} (L : ℕ) (u : Wire n) (s : TeleSpec)
    (hbwd : s.bwdOdds.length = L) (hfwd : s.fwdOdds.length = L)
    (β : BitAssignment n) (hu : β u = 1) :
    teleMuxMat L [(u, s)] ([] : List (Wire n)) β = teleMat2 s := by
  dsimp [teleMuxMat]
  rw [show listXor ([] : List (Wire n)) β = 0 from rfl,
    show pauliXPow 0 = 1 from rfl, Matrix.one_mul,
    listXor_singleton_flag u s (fun x => x.fl) β hu,
    listXor_singleton_flag u s (fun x => x.mz) β hu,
    listXor_singleton_flag u s (fun x => x.mx) β hu]
  dsimp only [List.map]
  have hF : muxWordMat L [(u, s.fwdOdds)] β =
      oddsPhase s.fwdOdds • wordMatrix2 (oddsToHst s.fwdOdds) := by
    rw [← hfwd]; exact muxWordMat_singleton_one u s.fwdOdds β hu
  have hB : muxWordMat L [(u, s.bwdOdds)] β =
      oddsPhase s.bwdOdds • wordMatrix2 (oddsToHst s.bwdOdds) := by
    rw [← hbwd]; exact muxWordMat_singleton_one u s.bwdOdds β hu
  rw [hF, hB, Matrix.conjTranspose_smul]
  have hZ : wordMatrix2 [.H] * pauliXPow (if s.mz then 1 else 0) * wordMatrix2 [.H] =
      pauliZPow (if s.mz then 1 else 0) := wordMatrix2_H_pauliXPow_H _
  simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul, teleMat2, telePhase, teleCoreMat]
  congr 1
  · ring
  · calc pauliXPow (if s.fl then 1 else 0) * wordMatrix2 (oddsToHst s.fwdOdds) *
          wordMatrix2 [.H] * pauliXPow (if s.mz then 1 else 0) * wordMatrix2 [.H] *
          pauliXPow (if s.mx then 1 else 0) * (wordMatrix2 (oddsToHst s.bwdOdds))ᴴ
        = pauliXPow (if s.fl then 1 else 0) * wordMatrix2 (oddsToHst s.fwdOdds) *
            (wordMatrix2 [.H] * pauliXPow (if s.mz then 1 else 0) * wordMatrix2 [.H]) *
            pauliXPow (if s.mx then 1 else 0) * (wordMatrix2 (oddsToHst s.bwdOdds))ᴴ := by
            simp only [Matrix.mul_assoc]
      _ = _ := by rw [hZ]


theorem cTeleMux_mulVec_ket_onehot {n : ℕ} (L : ℕ)
    (branches : List (Wire n × TeleSpec)) (flips : List (Wire n))
    (wPar t u : Wire n) (s : TeleSpec)
    (hdisj : PmSplitDisj (branches.map Prod.fst) flips wPar t)
    (hbwd : s.bwdOdds.length = L) (hfwd : s.fwdOdds.length = L)
    (β : BitAssignment n) (hwPar : β wPar = 0) (ht : β t = 0)
    (hbr : branches.filter (fun p => β p.1 == 1) = [(u, s)])
    (hfl : flips.filter (fun w => β w == 1) = []) :
    (cTeleMux L branches flips wPar t).eval.1.mulVec (ket β) =
      teleAlpha0 s • ket β + teleAlpha1 s • ket (Function.update β t 1) := by
  have hu_mem : (u, s) ∈ branches.filter (fun p => β p.1 == 1) := by rw [hbr]; simp
  have hu : β u = 1 := (List.mem_filter.mp hu_mem).2 |> (beq_iff_eq ..).mp
  rw [cTeleMux_mulVec_ket_embed L branches flips wPar t hdisj β hwPar,
    ← teleMuxMat_filter_one L branches flips β, hbr, hfl,
    teleMuxMat_singleton_one L u s hbwd hfwd β hu,
    singleton_embedMatrix_mulVec_ket, ite_pos' ht, upd_eq_self β t ht]
  rfl


def cCtrl1Layer {n : ℕ} (a : Fin 4) (c t : Wire n) : Circuit n :=
  (if syllB0 a then cnotIf c t else Circuit.identity) ;;ᶜ
    Circuit.T t ;;ᶜ
    (if syllB0 a then cnotIf c t else Circuit.identity) ;;ᶜ
    Circuit.H t ;;ᶜ
    (if syllB1 a then cnotIf c t else Circuit.identity)


@[simp]
theorem count_toff_cCtrl1Layer {n : ℕ} (a : Fin 4) (c t : Wire n) :
    (cCtrl1Layer a c t).count PrimitiveGate.TOFF = 0 := by
  unfold cCtrl1Layer; split_ifs <;> simp


@[simp]
theorem count_t_cCtrl1Layer {n : ℕ} (a : Fin 4) (c t : Wire n) :
    (cCtrl1Layer a c t).count PrimitiveGate.T = 1 := by
  unfold cCtrl1Layer; split_ifs <;> simp [count_t_cnotIf]


theorem cnotCond_mulVec_ket_embed {n : ℕ} (cond : Bool) (c t : Wire n) (hct : c ≠ t)
    (β : BitAssignment n) :
    (if cond then cnotIf c t else Circuit.identity).eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix (pauliXPow (if cond then β c else 0))).mulVec (ket β) :=
        by
  cases cond
  · simp [pauliXPow, QRegister.embedMatrix_one]
  · simp only [↓reduceIte]
    rw [cnotIf_mulVec_ket c t hct β, ket_update_add_eq_pauliXPow_embed]


theorem cCtrl1Layer_mulVec_ket_embed {n : ℕ} (a : Fin 4) (c t : Wire n) (hct : c ≠ t)
    (β : BitAssignment n) :
    (cCtrl1Layer a c t).eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix
        (muxLayerMat (b0Xor [(c, a)] β) (b1Xor [(c, a)] β))).mulVec (ket β) := by
  have hb0 : (if syllB0 a then β c else 0) = b0Xor [(c, a)] β := (add_zero _).symm
  have hb1 : (if syllB1 a then β c else 0) = b1Xor [(c, a)] β := (add_zero _).symm
  have hcnot_step (cond : Bool) (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (if cond then cnotIf c t else Circuit.identity).eval.1.mulVec
          (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix
          (pauliXPow (if cond then β c else 0) * A)).mulVec (ket β) := by
    refine mulVec_singleton_embedMatrix_of_ket _ t A (pauliXPow (if cond then β c else 0))
      β β rfl (fun x => ?_)
    rw [cnotCond_mulVec_ket_embed cond c t hct (Function.update β t x),
      Function.update_of_ne hct]
  have hT_step (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (Circuit.T t).eval.1.mulVec (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix (wordMatrix2 [.T] * A)).mulVec (ket β) := by
    have hT : (Circuit.T t).eval.1 = (QRegister.singleton t).embedMatrix (wordMatrix2 [.T]) :=
      hstGate_eval_eq .T t
    rw [hT, Matrix.mulVec_mulVec, ← QRegister.embedMatrix_mul]
  have hH_step (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (Circuit.H t).eval.1.mulVec (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix (wordMatrix2 [.H] * A)).mulVec (ket β) := by
    have hH : (Circuit.H t).eval.1 = (QRegister.singleton t).embedMatrix (wordMatrix2 [.H]) :=
      hstGate_eval_eq .H t
    rw [hH, Matrix.mulVec_mulVec, ← QRegister.embedMatrix_mul]
  unfold cCtrl1Layer
  simp only [MeasureBranchHadamardSem.eval_seq_mulVec]
  rw [cnotCond_mulVec_ket_embed (syllB0 a) c t hct β, hT_step,
    hcnot_step (syllB0 a), hH_step, hcnot_step (syllB1 a), hb0, hb1]
  dsimp only [muxLayerMat]
  simp only [Matrix.mul_assoc]


def cCtrl1Word {n : ℕ} : ℕ → List (Fin 4) → Wire n → Wire n → Circuit n
  | 0, _, _, _ => Circuit.identity
  | L + 1, odds, c, t =>
      cCtrl1Layer (odds.headD 0) c t ;;ᶜ cCtrl1Word L odds.tail c t


@[simp]
theorem count_toff_cCtrl1Word {n : ℕ} (L : ℕ) (odds : List (Fin 4)) (c t : Wire n) :
    (cCtrl1Word L odds c t).count PrimitiveGate.TOFF = 0 := by
  induction L generalizing odds with
  | zero => rfl
  | succ L ih => simp [cCtrl1Word, ih]


@[simp]
theorem count_t_cCtrl1Word {n : ℕ} (L : ℕ) (odds : List (Fin 4)) (c t : Wire n) :
    (cCtrl1Word L odds c t).count PrimitiveGate.T = L := by
  induction L generalizing odds with
  | zero => rfl
  | succ L ih => simp [cCtrl1Word, ih]; omega


theorem cCtrl1Word_mulVec_ket_embed {n : ℕ} (L : ℕ) (odds : List (Fin 4))
    (c t : Wire n) (hct : c ≠ t) (β : BitAssignment n) :
    (cCtrl1Word L odds c t).eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix (muxWordMat L [(c, odds)] β)).mulVec (ket β) := by
  induction L generalizing odds β with
  | zero => simp [cCtrl1Word, muxWordMat, QRegister.embedMatrix_one]
  | succ L ih =>
    rw [cCtrl1Word, MeasureBranchHadamardSem.eval_seq_mulVec,
      cCtrl1Layer_mulVec_ket_embed (odds.headD 0) c t hct β]
    dsimp only [muxWordMat, List.map]
    refine mulVec_singleton_embedMatrix_of_ket (cCtrl1Word L odds.tail c t).eval.1 t
      (muxLayerMat (b0Xor [(c, odds.headD 0)] β) (b1Xor [(c, odds.headD 0)] β))
      (muxWordMat L [(c, odds.tail)] β) β β rfl (fun x => ?_)
    rw [ih odds.tail (Function.update β t x),
      muxWordMat_update_of_not_mem L [(c, odds.tail)] t x β (by simp [hct])]


def cTeleCtrl1 {n : ℕ} (s : TeleSpec) (c t : Wire n) : Circuit n :=
  (cCtrl1Word s.bwdOdds.length s.bwdOdds c t).inverse ;;ᶜ
    cnotList (([(c, s)].filter (fun p => p.2.mx)).map Prod.fst) t ;;ᶜ
    Circuit.H t ;;ᶜ
    cnotList (([(c, s)].filter (fun p => p.2.mz)).map Prod.fst) t ;;ᶜ
    Circuit.H t ;;ᶜ
    cCtrl1Word s.fwdOdds.length s.fwdOdds c t ;;ᶜ
    cnotList (([(c, s)].filter (fun p => p.2.fl)).map Prod.fst) t


@[simp]
theorem count_toff_cTeleCtrl1 {n : ℕ} (s : TeleSpec) (c t : Wire n) :
    (cTeleCtrl1 s c t).count PrimitiveGate.TOFF = 0 := by
  simp [cTeleCtrl1]


noncomputable def teleCtrl1Mat {n : ℕ} (s : TeleSpec) (c : Wire n)
    (β : BitAssignment n) : Matrix (Fin 2) (Fin 2) ℂ :=
  pauliXPow (listXor (([(c, s)].filter (fun p => p.2.fl)).map Prod.fst) β) *
    muxWordMat s.fwdOdds.length [(c, s.fwdOdds)] β *
    wordMatrix2 [.H] *
    pauliXPow (listXor (([(c, s)].filter (fun p => p.2.mz)).map Prod.fst) β) *
    wordMatrix2 [.H] *
    pauliXPow (listXor (([(c, s)].filter (fun p => p.2.mx)).map Prod.fst) β) *
    (muxWordMat s.bwdOdds.length [(c, s.bwdOdds)] β)ᴴ


theorem teleCtrl1Mat_update_of_ne {n : ℕ} (s : TeleSpec) (c t : Wire n) (hct : c ≠ t)
    (x : ZMod 2) (β : BitAssignment n) :
    teleCtrl1Mat s c (Function.update β t x) = teleCtrl1Mat s c β := by
  have hnot_fl : t ∉ (([(c, s)].filter (fun p => p.2.fl)).map Prod.fst) := by
    intro hm; exact hct (mem_filter_map_fst_sub [(c, s)] _ hm |> List.mem_singleton.mp).symm
  have hnot_mz : t ∉ (([(c, s)].filter (fun p => p.2.mz)).map Prod.fst) := by
    intro hm; exact hct (mem_filter_map_fst_sub [(c, s)] _ hm |> List.mem_singleton.mp).symm
  have hnot_mx : t ∉ (([(c, s)].filter (fun p => p.2.mx)).map Prod.fst) := by
    intro hm; exact hct (mem_filter_map_fst_sub [(c, s)] _ hm |> List.mem_singleton.mp).symm
  dsimp only [teleCtrl1Mat]
  rw [listXor_update_of_not_mem _ t x β (fun u hu => fun h => by subst h; exact hnot_fl hu),
    listXor_update_of_not_mem _ t x β (fun u hu => fun h => by subst h; exact hnot_mz hu),
    listXor_update_of_not_mem _ t x β (fun u hu => fun h => by subst h; exact hnot_mx hu),
    muxWordMat_update_of_not_mem _ _ t x β (by simp [hct]),
    muxWordMat_update_of_not_mem _ _ t x β (by simp [hct])]


theorem teleCtrl1Mat_unitary {n : ℕ} (s : TeleSpec) (c : Wire n) (β : BitAssignment n) :
    teleCtrl1Mat s c β * (teleCtrl1Mat s c β)ᴴ = 1 := by
  let xMx := listXor (([(c, s)].filter (fun p => p.2.mx)).map Prod.fst) β
  let xMz := listXor (([(c, s)].filter (fun p => p.2.mz)).map Prod.fst) β
  let xFl := listXor (([(c, s)].filter (fun p => p.2.fl)).map Prod.fst) β
  let mF := muxWordMat s.fwdOdds.length [(c, s.fwdOdds)] β
  let mB := muxWordMat s.bwdOdds.length [(c, s.bwdOdds)] β
  have hZ : wordMatrix2 [.H] * pauliXPow xMz * wordMatrix2 [.H] = pauliZPow xMz :=
    wordMatrix2_H_pauliXPow_H xMz
  have hrew : teleCtrl1Mat s c β = teleCoreMat xMx xMz xFl mF mB := by
    change pauliXPow xFl * mF * wordMatrix2 [.H] * pauliXPow xMz * wordMatrix2 [.H] *
        pauliXPow xMx * mBᴴ =
      pauliXPow xFl * mF * pauliZPow xMz * pauliXPow xMx * mBᴴ
    calc pauliXPow xFl * mF * wordMatrix2 [.H] * pauliXPow xMz * wordMatrix2 [.H] *
          pauliXPow xMx * mBᴴ
        = pauliXPow xFl * mF * (wordMatrix2 [.H] * pauliXPow xMz * wordMatrix2 [.H]) *
            pauliXPow xMx * mBᴴ := by simp only [Matrix.mul_assoc]
      _ = pauliXPow xFl * mF * pauliZPow xMz * pauliXPow xMx * mBᴴ := by rw [hZ]
  rw [hrew]
  exact teleCoreMat_unitary xMx xMz xFl mF mB (muxWordMat_unitary _ _ _) (muxWordMat_unitary _ _ _)


theorem cTeleCtrl1_mulVec_ket_embed {n : ℕ} (s : TeleSpec) (c t : Wire n) (hct : c ≠ t)
    (β : BitAssignment n) :
    (cTeleCtrl1 s c t).eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix (teleCtrl1Mat s c β)).mulVec (ket β) := by
  let wMx := ([(c, s)].filter (fun p => p.2.mx)).map Prod.fst
  let wMz := ([(c, s)].filter (fun p => p.2.mz)).map Prod.fst
  let wFl := ([(c, s)].filter (fun p => p.2.fl)).map Prod.fst
  have hwMx_t : ∀ u ∈ wMx, u ≠ t := fun u hu => by
    rcases List.mem_singleton.mp (mem_filter_map_fst_sub [(c, s)] _ hu) with rfl; exact hct
  have hwMz_t : ∀ u ∈ wMz, u ≠ t := fun u hu => by
    rcases List.mem_singleton.mp (mem_filter_map_fst_sub [(c, s)] _ hu) with rfl; exact hct
  have hwFl_t : ∀ u ∈ wFl, u ≠ t := fun u hu => by
    rcases List.mem_singleton.mp (mem_filter_map_fst_sub [(c, s)] _ hu) with rfl; exact hct
  have hinv : (cCtrl1Word s.bwdOdds.length s.bwdOdds c t).inverse.eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix ((muxWordMat s.bwdOdds.length [(c,
        s.bwdOdds)] β)ᴴ)).mulVec (ket β) := by
    refine inverse_mulVec_ket_of_embed_unitary (cCtrl1Word s.bwdOdds.length s.bwdOdds c t) t
      (muxWordMat s.bwdOdds.length [(c, s.bwdOdds)] β) β (muxWordMat_unitary _ _ _) (fun x => ?_)
    rw [cCtrl1Word_mulVec_ket_embed _ _ c t hct _,
      muxWordMat_update_of_not_mem _ _ t x β (by simp [hct])]
  have hcnot_step (ws : List (Wire n)) (hws_t : ∀ u ∈ ws, u ≠ t) (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (cnotList ws t).eval.1.mulVec (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix (pauliXPow (listXor ws β) * A)).mulVec (ket β) := by
    refine mulVec_singleton_embedMatrix_of_ket (cnotList ws t).eval.1 t A
      (pauliXPow (listXor ws β)) β β rfl (fun x => ?_)
    rw [cnotList_mulVec_ket_embed ws t hws_t, listXor_update_of_not_mem ws t x β hws_t]
  have hH_step (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (Circuit.H t).eval.1.mulVec (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix (wordMatrix2 [.H] * A)).mulVec (ket β) := by
    have hH : (Circuit.H t).eval.1 = (QRegister.singleton t).embedMatrix (wordMatrix2 [.H]) :=
      hstGate_eval_eq .H t
    rw [hH, Matrix.mulVec_mulVec, ← QRegister.embedMatrix_mul]
  have hfwd (A : Matrix (Fin 2) (Fin 2) ℂ) :
      (cCtrl1Word s.fwdOdds.length s.fwdOdds c t).eval.1.mulVec
          (((QRegister.singleton t).embedMatrix A).mulVec (ket β)) =
        ((QRegister.singleton t).embedMatrix
          (muxWordMat s.fwdOdds.length [(c, s.fwdOdds)] β * A)).mulVec (ket β) := by
    refine mulVec_singleton_embedMatrix_of_ket _ t A
      (muxWordMat s.fwdOdds.length [(c, s.fwdOdds)] β) β β rfl (fun x => ?_)
    rw [cCtrl1Word_mulVec_ket_embed _ _ c t hct _,
      muxWordMat_update_of_not_mem _ _ t x β (by simp [hct])]
  unfold cTeleCtrl1
  change ((cCtrl1Word s.bwdOdds.length s.bwdOdds c t).inverse ;;ᶜ cnotList wMx t ;;ᶜ
      Circuit.H t ;;ᶜ cnotList wMz t ;;ᶜ Circuit.H t ;;ᶜ
      cCtrl1Word s.fwdOdds.length s.fwdOdds c t ;;ᶜ cnotList wFl t).eval.1.mulVec (ket β) = _
  simp only [MeasureBranchHadamardSem.eval_seq_mulVec]
  rw [hinv, hcnot_step wMx hwMx_t, hH_step, hcnot_step wMz hwMz_t, hH_step, hfwd,
    hcnot_step wFl hwFl_t]
  dsimp only [teleCtrl1Mat, wMx, wMz, wFl]
  simp only [Matrix.mul_assoc]


theorem cTeleCtrl1_inv_mulVec_ket_embed {n : ℕ} (s : TeleSpec) (c t : Wire n) (hct : c ≠ t)
    (β : BitAssignment n) :
    (cTeleCtrl1 s c t).inverse.eval.1.mulVec (ket β) =
      ((QRegister.singleton t).embedMatrix ((teleCtrl1Mat s c β)ᴴ)).mulVec (ket β) := by
  refine inverse_mulVec_ket_of_embed_unitary (cTeleCtrl1 s c t) t (teleCtrl1Mat s c β) β
    (teleCtrl1Mat_unitary s c β) (fun x => ?_)
  rw [cTeleCtrl1_mulVec_ket_embed s c t hct (Function.update β t x),
    teleCtrl1Mat_update_of_ne s c t hct x β]


theorem teleCtrl1Mat_eq_teleMuxMat {n : ℕ} (s : TeleSpec) (c : Wire n)
    (hlen : s.bwdOdds.length = s.fwdOdds.length) (β : BitAssignment n) :
    teleCtrl1Mat s c β = teleMuxMat s.fwdOdds.length [(c, s)] [] β := by
  dsimp [teleCtrl1Mat, teleMuxMat, listXor]
  rw [show pauliXPow 0 = 1 from rfl, Matrix.one_mul, hlen]
  rfl


theorem cTeleCtrl1_mulVec_ket_zero {n : ℕ} (s : TeleSpec) (c t : Wire n) (hct : c ≠ t)
    (hlen : s.bwdOdds.length = s.fwdOdds.length)
    (β : BitAssignment n) (hc : β c = 0) :
    (cTeleCtrl1 s c t).eval.1.mulVec (ket β) = ket β := by
  have hbr : [(c, s)].filter (fun p => β p.1 == 1) = [] := by
    simp [hc]
  rw [cTeleCtrl1_mulVec_ket_embed s c t hct β, teleCtrl1Mat_eq_teleMuxMat s c hlen β,
    ← teleMuxMat_filter_one s.fwdOdds.length [(c, s)] [] β, hbr, List.filter_nil,
    teleMuxMat_nil _ β, QRegister.embedMatrix_one, Matrix.one_mulVec]


