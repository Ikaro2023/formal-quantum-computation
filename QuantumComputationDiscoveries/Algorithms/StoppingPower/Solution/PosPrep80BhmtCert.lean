        have q76 : Function.update q 62 0 ⟨76, by decide⟩ = p ⟨76, by decide⟩ + p 1 := by
          rw [Function.update_of_ne (by decide), hq_def]; rfl
        rw [q1] at e1; rw [q76] at e76
        dsimp [tailWitnessPayload80] at e1 e76
