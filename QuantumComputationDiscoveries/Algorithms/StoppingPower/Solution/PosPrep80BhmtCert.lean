        rw [show w = wPopT01_152 from Fin.ext hv]; exact ht01
      · rw [Function.update_of_ne (by decide), rSub128_wPopMaj] at hmaj
        rw [show w = wPopMaj_152 from Fin.ext hv]; exact hmaj
      · rw [Function.update_of_ne (by decide), rSub128_wPopPar] at hpar
        rw [show w = wPopPar_152 from Fin.ext hv]; exact hpar
      · rw [Function.update_of_ne (by decide), rSub128_wBrTop] at htop
        rw [show w = wBrTop_152 from Fin.ext hv]; exact htop
    · have h3 : 130 ≤ w.val ∧ w.val < 152 := by
        dsimp [isMuxCleanScrWire] at hm
