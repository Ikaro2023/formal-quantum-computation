    · rw [hUnchanged _ (by right; right; decide), e10]
    · rw [hUnchanged _ (by right; right; decide), e11]
    · rw [hUnchanged _ (by right; right; decide), e12]
  · rw [hUnchanged _ (by right; right; dsimp [scr30_128,
    PosPostPrep80InnerAmpS3Alt.qreg_block_apply, PosPostPrep80InnerAmpS3Alt.qreg_block_wires_apply,
    PosPostPrep80InnerAmpS3Alt.qreg_whole_wires, PosPostPrep80InnerAmpS3Alt.emb_trans_apply,
