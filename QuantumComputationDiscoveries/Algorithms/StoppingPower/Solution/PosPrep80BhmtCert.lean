theorem unitary_inv_mul_val_cert {M : ℕ} (U : Unitary M) :
    (U⁻¹).1 * U.1 = 1 :=
  congrArg Subtype.val (inv_mul_cancel U)


theorem unitary_mul_assoc {M : ℕ} (A B C : Unitary M) :
    A * B * C = A * (B * C) :=
  mul_assoc A B C


theorem unitary_mul_inv_rev {M : ℕ} (A B : Unitary M) :
    (A * B)⁻¹ = B⁻¹ * A⁻¹ :=
