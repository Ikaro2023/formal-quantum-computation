  let δ := writeData48 α₀ (b1, fine, ancHi, nuc)
  obtain ⟨hb1, hfine, hanc, hnuc⟩ := writeData48_regs α₀ b1 fine ancHi nuc
  change (∀ j : Fin 3, δ (rB1_152 j) = basisBits 3 b1 j) at hb1
  change (∀ j : Fin 30, δ (rFine30_152 j) = basisBits 30 fine j) at hfine
  change (∀ j : Fin 7, δ (rAnc7_152 j) = basisBits 7 ancHi j) at hanc
  change (∀ j : Fin 8, δ (rNuc_152 j) = basisBits 8 nuc j) at hnuc
  have hetδ : δ wEnTail_152 = if isHead then 0 else 1 :=
    (writeData48_apply_outside α₀ _ _ (Or.inr (Or.inr (Or.inr (by decide))))).trans het
  have hestδ : δ wEnS0Tail_152 = if !isHead && s0 then 1 else 0 :=
    (writeData48_apply_outside α₀ _ _ (Or.inr (Or.inr (Or.inr (by decide))))).trans hest
  have hs4hδ : δ wEnS4Head_152 = if isHead && s0 then 1 else 0 :=
    (writeData48_apply_outside α₀ _ _ (Or.inr (Or.inr (Or.inr (by decide))))).trans hs4h
  have hc0hδ : δ wEnC0Head_152 = if isHead && !s0 then 1 else 0 :=
    (writeData48_apply_outside α₀ _ _ (Or.inr (Or.inr (Or.inr (by decide))))).trans hc0h
  have hfineVal : fine30Val152 δ = fine.val := by
    unfold fine30Val152
    rw [show (fun j : Fin 30 ↦ δ (rFine30_152 j)) = basisBits 30 fine from funext hfine]
    exact bitsVal_basisBits_local fine
  have hanc7Val : anc7Val152 δ = ancHi.val := by
    unfold anc7Val152
    have hf7 : (fun j : Fin 7 ↦ δ (rAnc_152 ⟨j.val + 1, by omega⟩)) = basisBits 7 ancHi := by
      funext j
      have hr : rAnc_152 ⟨j.val + 1, by omega⟩ = rAnc7_152 j := by
        ext; dsimp [rAnc_152, rAnc7_152, mkBlock152]; omega
      rw [hr, hanc j]
    rw [hf7]
    exact bitsVal_basisBits_local ancHi
  have hnucVal : nuc8Val152 δ = nuc.val := by
    unfold nuc8Val152
    rw [show (fun j : Fin 8 ↦ δ (rNuc_152 j)) = basisBits 8 nuc from funext hnuc]
    exact bitsVal_basisBits_local nuc
  have hThresh0 : ∀ b : Fin (2 ^ 3),
      PosPostMuxSharedBhmtOracles.mThresh4
        (PosPostMuxSharedBhmtOracles.pop3Idx (basisBits 3 b 0) (basisBits 3 b 1) (basisBits 3 b 2))
          =
        tailKeepSpanOfDp b := by decide
  have hThresh : PosPostMuxSharedBhmtOracles.mThresh4 (dpPop3_152 δ) = tailKeepSpanOfDp b1 := by
    unfold dpPop3_152
    rw [hb1 0, hb1 1, hb1 2]
    exact hThresh0 b1
  have hJ : goodJointPred152 δ =
      (if isHead then true else decide (fine.val < tailKeepSpanOfDp b1)) := by
    unfold goodJointPred152
    rw [hetδ, hfineVal, hThresh]
    cases isHead <;> simp
  have hA : goodAncPred152 δ =
      (if isHead && !s0 then !(basisBits 7 ancHi 0 == 1 && basisBits 7 ancHi 1 == 1)
       else decide (ancHi.val < 109)) := by
    unfold goodAncPred152
    have ha1 : δ (rAnc_152 1) = basisBits 7 ancHi 0 := hanc 0
    have ha2 : δ (rAnc_152 2) = basisBits 7 ancHi 1 := hanc 1
    have hancIff : decide (anc8Val152 δ < 218) = decide (ancHi.val < 109) := by
      apply Bool.eq_iff_iff.mpr
      rw [decide_eq_true_eq, decide_eq_true_eq, ← anc7_lt_109_iff_anc8_lt_218 δ, hanc7Val]
    rw [hc0hδ, ha1, ha2, hancIff]
    cases isHead <;> cases s0 <;> simp
  have hN : goodNucPred152 δ =
      (if isHead && s0 then !(basisBits 8 nuc 0 == 1 && basisBits 8 nuc 1 == 1)
       else if !isHead && s0 then decide (nuc.val < 217)
       else decide (nuc.val < 218)) := by
    unfold goodNucPred152
    rw [hs4hδ, hestδ, hnuc 0, hnuc 1, hnucVal]
    cases isHead <;> cases s0 <;> simp
  unfold good48Pred152 branchGood48
  change (goodJointPred152 δ && goodAncPred152 δ && goodNucPred152 δ) = _
