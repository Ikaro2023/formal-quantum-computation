theorem writeReg_eq {k n : ℕ}
    (β : BitAssignment n)
    (r : QRegister k n)
    (γ : BitAssignment k) :
    ZeroAncillaUSP.writeReg β r γ =
      ZeroAncillaUSPS3.writeReg β r γ := rfl

theorem chIf_eq {n : ℕ}
    (c q : Wire n) :
    PosPostPrep80MergedVep.chIf c q =
      PosPostPrep80MergedVepS3.chIf c q := rfl

theorem unHadamardList_eq {n : ℕ}
    (c : Wire n)
    (qs : List (Wire n)) :
    PosPostPrep80MergedVep.unHadamardList c qs =
      PosPostPrep80MergedVepS3.unHadamardList c qs := by
  induction qs with
  | nil => rfl
  | cons q qs ih =>
    simp [PosPostPrep80MergedVep.unHadamardList,
      PosPostPrep80MergedVepS3.unHadamardList,
      chIf_eq, ih]

theorem cnotIf_eq {n : ℕ}
    (c t : Wire n) :
    ZeroAncillaUSP.cnotIf c t =
      ZeroAncillaUSPS3.cnotIf c t := rfl

end HelpersEq

