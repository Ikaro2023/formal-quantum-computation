theorem compile76_evalBits_unpackMask76 :
    ∀ (p : RevProg76), wfRevProg76 p = true → ∀ (m : ℕ),
      (compile76 p).evalBits (unpackMask76 m) = unpackMask76 (runMask76 (flatten76 p) m)
  | .nil, _, _ => rfl
  | .cliff ops, hw, m => (compileCliff76_eval_unpackMask76 ops hw m).1
  | .seq p₁ p₂, hw, m => by
      simp only [wfRevProg76, Bool.and_eq_true] at hw
      simp only [compile76, TempPhaseProg.evalBits, flatten76, runMask76_append,
        compile76_evalBits_unpackMask76 p₁ hw.1, compile76_evalBits_unpackMask76 p₂ hw.2]
  | .withCliff ops body, hw, m => by
      simp only [wfRevProg76, Bool.and_eq_true] at hw
      simp only [compile76, TempPhaseProg.evalBits, flatten76, runMask76_append,
        (compileCliff76_eval_unpackMask76 ops hw.1 m).1,
        compile76_evalBits_unpackMask76 body hw.2,
        (compileCliff76_eval_unpackMask76 ops hw.1 _).2]
  | .tempAnd c₁ c₂ anc body, hw, m => by
      simp only [wfRevProg76, Bool.and_eq_true, decide_eq_true_eq] at hw
      rcases hw with ⟨⟨⟨h12, h1a⟩, h2a⟩, hB⟩
      have htoff : ∀ k : ℕ,
          Function.update (unpackMask76 k) anc
              (unpackMask76 k anc + unpackMask76 k c₁ * unpackMask76 k c₂) =
            unpackMask76 (stepMask76 (.toff c₁ c₂ anc) k) := by
        intro k
        dsimp only [stepMask76]
        change Function.update (unpackMask76 k) anc
          (unpackMask76 k anc +
            (if k.testBit c₁.val then 1 else 0) * (if k.testBit c₂.val then 1 else 0)) = _
        cases k.testBit c₁.val <;> cases k.testBit c₂.val
        · simp only [Bool.false_eq_true, ↓reduceIte, zero_mul, add_zero]
          exact Function.update_eq_self anc (unpackMask76 k)
        · simp only [Bool.false_eq_true, ↓reduceIte, zero_mul, add_zero]
          exact Function.update_eq_self anc (unpackMask76 k)
        · simp only [Bool.false_eq_true, ↓reduceIte, mul_zero, add_zero]
          exact Function.update_eq_self anc (unpackMask76 k)
        · simp only [↓reduceIte, mul_one]
          exact (unpackMask76_xor_two_pow k anc).symm
      rw [compile76_tempAnd_ne h12 h1a h2a]
      simp only [TempPhaseProg.evalBits, flatten76, runMask76_append, runMask76, htoff,
        compile76_evalBits_unpackMask76 body hB]


