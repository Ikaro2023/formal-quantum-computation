private theorem sum_cond_abs_sub_le {α β : Type*} [Fintype α] [Fintype β]
    (a₁ b₁ : α → ℝ) (a₂ b₂ : α → β → ℝ) (ε₂ : ℝ)
    (ha₁ : ∀ x, 0 ≤ a₁ x) (hSumA₁ : ∑ x, a₁ x = 1)
    (hb₂ : ∀ x y, 0 ≤ b₂ x y) (hSumB₂ : ∀ x, ∑ y, b₂ x y = 1)
    (herr₂ : ∀ x, (∑ y, |a₂ x y - b₂ x y|) ≤ ε₂) :
    (∑ p : α × β, |a₁ p.1 * a₂ p.1 p.2 - b₁ p.1 * b₂ p.1 p.2|) ≤
      (∑ x, |a₁ x - b₁ x|) + ε₂ := by
  rw [Fintype.sum_prod_type]
  have hPt : ∀ x y, |a₁ x * a₂ x y - b₁ x * b₂ x y| ≤
