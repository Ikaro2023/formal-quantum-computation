      Function.update α (r w) b := by
  funext u
  by_cases hmem : ∃ i : Fin m, r i = u
  · obtain ⟨i, rfl⟩ := hmem
    rw [ZeroAncillaUSPS3.writeReg_apply_reg]
    by_cases hiw : i = w
    · subst hiw; simp
    · rw [Function.update_of_ne hiw, Function.update_of_ne (r.wires.injective.ne hiw)]
  · rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hmem]
    have hne : u ≠ r w := fun h ↦ hmem ⟨w, h.symm⟩
    rw [Function.update_of_ne hne]


