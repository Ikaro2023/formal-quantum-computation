theorem pre_masks_and_cAxis10_check (x : Fin 1024) :
    let y76 := runMask76 preFlat76 x.val
    let y67 := runMask67 preGates67 x.val
    (y76 &&& maskC0_76 = cAxis10 x.val 0 * 2 ^ 42) ∧
    (y76 &&& maskC1_76 = cAxis10 x.val 1 * 2 ^ 45) ∧
    (y76 &&& maskC2_76 = cAxis10 x.val 2 * 2 ^ 48) ∧
    (y67 &&& maskC0_67_cert = cAxis10 x.val 0 * 2 ^ 37) ∧
    (y67 &&& maskC1_67_cert = cAxis10 x.val 1 * 2 ^ 40) ∧
    (y67 &&& maskC2_67_cert = cAxis10 x.val 2 * 2 ^ 43) ∧
    (cAxis10 x.val 0 < 6) ∧ (cAxis10 x.val 1 < 6) ∧ (cAxis10 x.val 2 < 6) := by
  have hx : checkPre1024One x.val = true := by
    by_cases h64 : x.val < 64
    · exact checkNatRange_true 64 0 x.val checkPre1024_chunk0 (Nat.zero_le _) (by omega)
    · by_cases h128 : x.val < 128
      · exact checkNatRange_true 64 64 x.val checkPre1024_chunk1 (by omega) (by omega)
      · by_cases h192 : x.val < 192
        · exact checkNatRange_true 64 128 x.val checkPre1024_chunk2 (by omega) (by omega)
        · by_cases h256 : x.val < 256
          · exact checkNatRange_true 64 192 x.val checkPre1024_chunk3 (by omega) (by omega)
          · by_cases h320 : x.val < 320
            · exact checkNatRange_true 64 256 x.val checkPre1024_chunk4 (by omega) (by omega)
            · by_cases h384 : x.val < 384
              · exact checkNatRange_true 64 320 x.val checkPre1024_chunk5 (by omega) (by omega)
              · by_cases h448 : x.val < 448
                · exact checkNatRange_true 64 384 x.val checkPre1024_chunk6 (by omega) (by omega)
                · by_cases h512 : x.val < 512
                  · exact checkNatRange_true 64 448 x.val checkPre1024_chunk7 (by omega) (by omega)
                  · by_cases h576 : x.val < 576
                    · exact checkNatRange_true 64 512 x.val checkPre1024_chunk8 (by omega)
                        (by omega)
                    · by_cases h640 : x.val < 640
                      · exact checkNatRange_true 64 576 x.val checkPre1024_chunk9 (by omega)
                          (by omega)
                      · by_cases h704 : x.val < 704
                        · exact checkNatRange_true 64 640 x.val checkPre1024_chunk10 (by omega)
                            (by omega)
                        · by_cases h768 : x.val < 768
                          · exact checkNatRange_true 64 704 x.val checkPre1024_chunk11 (by omega)
                              (by omega)
                          · by_cases h832 : x.val < 832
                            · exact checkNatRange_true 64 768 x.val checkPre1024_chunk12 (by omega)
                                (by omega)
                            · by_cases h896 : x.val < 896
                              · exact checkNatRange_true 64 832 x.val checkPre1024_chunk13
                                  (by omega) (by omega)
                              · by_cases h960 : x.val < 960
                                · exact checkNatRange_true 64 896 x.val checkPre1024_chunk14
                                    (by omega) (by omega)
                                · exact checkNatRange_true 64 960 x.val checkPre1024_chunk15
                                    (by omega) (by have := x.isLt; omega)
  simp only [checkPre1024One, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hx
  rcases hx with ⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩
  exact ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩


