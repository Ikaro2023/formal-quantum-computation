theorem uPosPostAnc86_Bhmt_mulVec_ket_nonPos (γ : BitAssignment 86)
    (h : ¬(γ ⟨1, by decide⟩ = 0 ∧ γ ⟨2, by decide⟩ = 0)) :
    uPosPostAnc86_Bhmt.1.mulVec (ket γ) = ket γ := by
  let β : BitAssignment 128 := padZeroBits posPostHwa γ
  let α : BitAssignment 152 := liftBits128 β
  have hz : ∀ w : Wire 128, 86 ≤ w.val → β w = 0 := fun w hw ↦ by
    have hnl : ¬(w.val < 86) := by omega
    simp [β, padZeroBits, hnl]
  have hz152 : ∀ w : Wire 152, 86 ≤ w.val → α w = 0 := fun w hw ↦ by
    dsimp only [α, liftBits128]
    by_cases h128 : w.val < 128
    · rw [dite_eq_left h128]; exact hz ⟨w.val, h128⟩ hw
    · rw [dite_eq_right h128]
  have hep0 : (1 - β wCoin1_128) * (1 - β wCoin2_128) = 0 := by
    have hc1 : β wCoin1_128 = γ ⟨1, by decide⟩ := rfl
    have hc2 : β wCoin2_128 = γ ⟨2, by decide⟩ := rfl
    rw [hc1, hc2]
    rcases bit_cases (γ ⟨1, by decide⟩) with h1 | h1 <;>
    rcases bit_cases (γ ⟨2, by decide⟩) with h2 | h2
    · exact absurd ⟨h1, h2⟩ h
    · rw [h1, h2]; rfl
    · rw [h1, h2]; rfl
    · rw [h1, h2]; rfl
  have hOpenId : openMap128 β = β := by
    funext w
    by_cases hw : w = wEnPos_128 ∨ w = wEnS0_128 ∨ w = wEnC0_128
    · rcases hw with rfl | rfl | rfl
      · simp [openMap128, hep0, hz wEnPos_128 (by decide),
          Function.update_of_ne (by decide : wEnPos_128 ≠ wEnC0_128),
          Function.update_of_ne (by decide : wEnPos_128 ≠ wEnS0_128)]
      · simp [openMap128, hep0, hz wEnS0_128 (by decide),
          Function.update_of_ne (by decide : wEnS0_128 ≠ wEnC0_128)]
      · simp [openMap128, hep0, hz wEnC0_128 (by decide)]
    · push Not at hw
      rcases hw with ⟨h1, h2, h3⟩
      dsimp only [openMap128]
      rw [Function.update_of_ne h3, Function.update_of_ne h2, Function.update_of_ne h1]
  have hOpenFwd : cOpen_128.eval.1.mulVec (ket β) = ket β := by
    rw [ket_cOpen_128 β (hz _ (by decide)) (hz _ (by decide)) (hz _ (by decide)), hOpenId]
  have hOpenBwd : cOpen_128.inverse.eval.1.mulVec (ket β) = ket β :=
    inv_mulVec_ket_of_fwd_sub cOpen_128 β β hOpenFwd
  have hFl2Id : flags2Map128 β = β := by
    funext w
    by_cases hw : w = wEnHead_128 ∨ w = wEnTail_128 ∨ w = wEnS0Tail_128 ∨ w = wEnAnc_128
    · rcases hw with rfl | rfl | rfl | rfl
      · simp [flags2Map128, hz wEnPos_128 (by decide), hz wEnHead_128 (by decide),
          Function.update_of_ne (by decide : wEnHead_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnHead_128 ≠ wEnS0Tail_128),
          Function.update_of_ne (by decide : wEnHead_128 ≠ wEnTail_128)]
      · simp [flags2Map128, hz wEnPos_128 (by decide), hz wEnTail_128 (by decide),
          Function.update_of_ne (by decide : wEnTail_128 ≠ wEnAnc_128),
          Function.update_of_ne (by decide : wEnTail_128 ≠ wEnS0Tail_128)]
      · simp [flags2Map128, hz wEnS0_128 (by decide), hz wEnS0Tail_128 (by decide),
          Function.update_of_ne (by decide : wEnS0Tail_128 ≠ wEnAnc_128)]
      · simp [flags2Map128, hz wEnPos_128 (by decide), hz wEnC0_128 (by decide),
          hz wEnAnc_128 (by decide)]
    · push Not at hw
      rcases hw with ⟨h1, h2, h3, h4⟩
      dsimp only [flags2Map128]
      rw [Function.update_of_ne h4, Function.update_of_ne h3,
        Function.update_of_ne h2, Function.update_of_ne h1]
