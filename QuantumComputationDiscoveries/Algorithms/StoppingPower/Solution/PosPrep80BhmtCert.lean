open Classical in
theorem subDiagProj_mulVec_ket {N : ℕ} (S : BitAssignment N → Prop) (β : BitAssignment N) :
    (subDiagProj S).mulVec (ket β) = if S β then ket β else 0 :=
  PosPostPrep80FastSubblocks.subDiagProj_mulVec_ket (N := N) S β

open Classical in
private theorem subDiagProj_mulVec_apply {N : ℕ} (S : BitAssignment N → Prop)
    (ψ : Fin (2 ^ N) → ℂ) (x : Fin (2 ^ N)) :
    (subDiagProj S).mulVec ψ x = if S (basisBits N x) then ψ x else 0 :=
  PosPostPrep80FastSubblocks.subDiagProj_mulVec_apply (N := N) S ψ
      x

private theorem mem_of_subDiagProj_mulVec_eq {N : ℕ} {S : BitAssignment N → Prop}
    {ψ : Fin (2 ^ N) → ℂ} {x : Fin (2 ^ N)}
    (hpres : (subDiagProj S).mulVec ψ x = ψ x) (hnz : ψ x ≠ 0) :
    S (basisBits N x) :=
  PosPostPrep80FastSubblocks.mem_of_subDiagProj_mulVec_eq (N := N)
      (S := S) (ψ := ψ) (x := x) hpres hnz


theorem subDiagProj_mul_of_preservesSpanSub {N : ℕ} {S₁ S₂ : BitAssignment N → Prop}
    {c : Circuit N} (hc : PreservesSpanSub S₁ S₂ c) :
    subDiagProj S₂ * (c.eval.1 * subDiagProj S₁) = c.eval.1 * subDiagProj S₁ :=
  PosPostPrep80FastSubblocks.subDiagProj_mul_of_preservesSpanSub (N
      := N) (S₁ := S₁) (S₂ := S₂) (c := c) hc

private theorem subDiagProj_mul_inv_of_self {N : ℕ} (S : BitAssignment N → Prop)
    (U : Unitary (2 ^ N))
    (hU : subDiagProj S * (U.1 * subDiagProj S) = U.1 * subDiagProj S) :
    subDiagProj S * ((U⁻¹).1 * subDiagProj S) = (U⁻¹).1 * subDiagProj S :=
  PosPostPrep80FastSubblocks.subDiagProj_mul_inv_of_self (N := N) S
      U hU

private theorem inv_congr_of_subDiagProj_eq {N : ℕ} (S : BitAssignment N → Prop)
    (U₁ U₂ : Unitary (2 ^ N))
    (hEq : U₁.1 * subDiagProj S = U₂.1 * subDiagProj S)
    (hPres₂ : subDiagProj S * (U₂.1 * subDiagProj S) = U₂.1 * subDiagProj S) :
    (U₁⁻¹).1 * subDiagProj S = (U₂⁻¹).1 * subDiagProj S ∧
    subDiagProj S * ((U₂⁻¹).1 * subDiagProj S) = (U₂⁻¹).1 * subDiagProj S :=
  PosPostPrep80FastSubblocks.inv_congr_of_subDiagProj_eq (N := N) S
      U₁ U₂ hEq hPres₂

-- Root solution namespace already active.
private theorem realizesCleanUnitary_withTempAnd_subDiag
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (c₁ c₂ anc : Wire n)
    (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    (S_pre S_mid : BitAssignment n → Prop)
    (hPreZero : ∀ β, S_pre β → β anc = 0)
    (hMidEq : ∀ δ, S_mid δ → δ anc = δ c₁ * δ c₂)
    (hStepFwd : ∀ β, S_pre β → S_mid (Function.update β anc (β c₁ * β c₂)))
    (hStepBwd : ∀ δ, S_mid δ → S_pre (Function.update δ anc 0))
    (body : DynamicCircuit Var n) (U_body : Unitary (2 ^ n))
    (hbody : RealizesCleanUnitary v (subDiagProj S_mid) body U_body)
    (hBodyPres : subDiagProj S_mid * (U_body.1 * subDiagProj S_mid) = U_body.1 * subDiagProj S_mid)
        :
    let T_anc := (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval
    RealizesCleanUnitary v (subDiagProj S_pre)
      (.seq (DynamicCircuit.andCompute c₁ c₂ anc h₁a h₂a)
        (.seq body (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂)))
      (T_anc * U_body * T_anc) ∧
    subDiagProj S_pre * ((T_anc * U_body * T_anc).1 * subDiagProj S_pre) =
      (T_anc * U_body * T_anc).1 * subDiagProj S_pre :=
  PosPostPrep80FastSubblocks.realizesCleanUnitary_withTempAnd_subDiag (Var := Var) (n := n) v c₁ c₂
      anc h₁₂ h₁a h₂a S_pre S_mid hPreZero hMidEq hStepFwd hStepBwd body U_body hbody hBodyPres


private theorem SubDynPair128.seq {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^
    n)]
    {v : Var} {rFull128 : QRegister 128 n} {rExtra9 : QRegister 9 n}
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    {S : BitAssignment 128 → Prop} {t₁ t₂ : ℕ}
    {dFwd₁ dInv₁ dFwd₂ dInv₂ : DynamicCircuit Var n}
    {U₁ U₂ : Unitary (2 ^ 128)}
    (h₁ : SubDynPair128 v rFull128 rExtra9 S t₁ dFwd₁ dInv₁ U₁)
    (h₂ : SubDynPair128 v rFull128 rExtra9 S t₂ dFwd₂ dInv₂ U₂) :
    SubDynPair128 v rFull128 rExtra9 S (t₁ + t₂)
      (.seq dFwd₁ dFwd₂) (.seq dInv₂ dInv₁) (U₂ * U₁) :=
  PosPostPrep80FastSubblocks.SubDynPair128.seq (Var := Var) (n :=
      n) (v := v) (rFull128 := rFull128) (rExtra9 := rExtra9) hDisjExtra (S := S) (t₁ := t₁) (t₂ :=
      t₂) (dFwd₁ := dFwd₁) (dInv₁ := dInv₁) (dFwd₂ := dFwd₂) (dInv₂ := dInv₂) (U₁ := U₁) (U₂ := U₂)
      h₁ h₂

-- Root solution namespace already active.
private theorem realizesCleanUnitary_sandwich_circuit_sub
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    {v : Var} {P_pre P_mid : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hPpre : P_preᴴ = P_pre) (hPmid : P_midᴴ = P_mid)
    (cFwd cBwd : Circuit n)
    (hFwd : P_mid * (cFwd.eval.1 * P_pre) = cFwd.eval.1 * P_pre)
    {body : DynamicCircuit Var n} {U_body : Unitary (2 ^ n)}
    (hbody : RealizesCleanUnitary v P_mid body U_body) :
    RealizesCleanUnitary v P_pre
      (.seq (.circuit cFwd) (.seq body (.circuit cBwd)))
      (cBwd.eval * U_body * cFwd.eval) :=
  PosPostPrep80FastSubblocks.realizesCleanUnitary_sandwich_circuit_sub (Var := Var) (n := n) (v :=
      v) (P_pre := P_pre) (P_mid := P_mid) hPpre hPmid cFwd cBwd hFwd (body := body) (U_body :=
      U_body) hbody


