theorem evalProg152_zeroReflChainPrefix {α : BitAssignment 152} (hα : MuxFlagsInv152 α) :
    let α1 := evalProg152 (listRefl49_152.map CleanStep152.x) α
    ∀ k (hk : k ≤ 47),
      let γ := evalProg152 (pZeroRefl48ChainPrefix k) α1
      γ (listAcc48_152[k]'(by rw [length_listAcc48_152]; omega)) = zeroReflAccProd α k ∧
      (∀ j (_hjk : k < j) (hj48 : j < 48),
        γ (listAcc48_152[j]'(by rw [length_listAcc48_152]; exact hj48)) = 0) ∧
      (∀ m : Fin 49,
        γ (listRefl49_152[m.val]'(by rw [length_listRefl49_152]; exact m.isLt)) =
          α (listRefl49_152[m.val]'(by rw [length_listRefl49_152]; exact m.isLt)) + 1) ∧
      γ wTelePar_152 = 0 := by
  intro α1
  have hα1_eq : α1 = fun w ↦ if w ∈ listRefl49_152 then α w + 1 else α w :=
    evalProg152_map_x_nodup listRefl49_152 nodup_listRefl49_152 α
  intro k hk
  induction k with
  | zero =>
      dsimp only [pZeroRefl48ChainPrefix, evalProg152, zeroReflAccProd]
      refine ⟨?_, fun j hj0 hj48 ↦ ?_, fun m ↦ ?_, ?_⟩
      · have hnot : listAcc48_152[0]'(by rw [length_listAcc48_152]; omega) ∉ listRefl49_152 := by
          decide
        have h0 : listAcc48_152[0]'(by rw [length_listAcc48_152]; omega) = wEnPos_152 := rfl
        rw [hα1_eq]; dsimp only; rw [ite_eq_right hnot, h0]
      · have hnot : listAcc48_152[j]'(by rw [length_listAcc48_152]; exact hj48) ∉ listRefl49_152 :=
          by
            intro hmem
            obtain ⟨m, hm, hm_eq⟩ := List.getElem_of_mem hmem
            exact listAcc48_disj_refl49 ⟨j, hj48⟩ ⟨m,
              by rw [length_listRefl49_152] at hm; exact hm⟩ hm_eq.symm
        rw [hα1_eq]; simp only [hnot, ↓reduceIte]
        have hcl := listAcc48_succ_isClean ⟨j - 1, by omega⟩
        have hjeq : j - 1 + 1 = j := by omega
        simp only [hjeq] at hcl
        exact muxFlagsInv152_clean_of_mask hcl hα
      · have hmem : listRefl49_152[m.val]'(by rw [length_listRefl49_152]; exact m.isLt) ∈
        listRefl49_152 :=
          List.getElem_mem _
        rw [hα1_eq]; simp [hmem]
      · have hnot : wTelePar_152 ∉ listRefl49_152 := by decide
        rw [hα1_eq]; simp [hnot, hα.2.2.2.2.2]
  | succ k ih =>
      have hk47 : k < 47 := by omega
      obtain ⟨hAcc, hZero, hRefl, hTele⟩ := ih (by omega)
      simp only [pZeroRefl48ChainPrefix, hk47, ↓reduceDIte, evalProg152_append, evalProg152,
        evalStep152]
      have hk49 : k < 49 := by omega
      refine ⟨?_, fun j hjk hj48 ↦ ?_, fun m ↦ ?_, ?_⟩
      · rw [Function.update_self, hZero (k + 1) (by omega) (by omega), zero_add, hAcc,
          hRefl ⟨k, hk49⟩]
        simp [zeroReflAccProd, hk49]
      · have hne_j : listAcc48_152[j]'(by rw [length_listAcc48_152]; exact hj48) ≠
            listAcc48_152[k + 1]'(by rw [length_listAcc48_152]; omega) := by
          intro h
          have := (List.Nodup.getElem_inj_iff listAcc48_nodup).mp h
          omega
        rw [Function.update_of_ne hne_j]
        exact hZero j (by omega) hj48
      · have hne_m : listRefl49_152[m.val]'(by rw [length_listRefl49_152]; exact m.isLt) ≠
            listAcc48_152[k + 1]'(by rw [length_listAcc48_152]; omega) :=
          (listAcc48_disj_refl49 ⟨k + 1, by omega⟩ m).symm
        rw [Function.update_of_ne hne_m]
        exact hRefl m
      · rw [Function.update_of_ne (listAcc48_ne_telePar ⟨k + 1, by omega⟩).symm]
        exact hTele


def zeroRefl48PhaseBit (α : BitAssignment 152) : ZMod 2 :=
  if α wEnPos_152 = 1 ∧ ¬(∀ w ∈ listRefl49_152, α w = 0) then 1 else 0


theorem evalProg152_pZeroRefl48Prog152_phase {α : BitAssignment 152} (hα : MuxFlagsInv152 α) :
    evalProg152 pZeroRefl48Prog152 α wTelePar_152 *
        evalProg152 pZeroRefl48Prog152 α wSubReject_152 + α wEnPos_152 =
      zeroRefl48PhaseBit α := by
  dsimp only [pZeroRefl48Prog152]
  rw [pZeroRefl48Chain_eq_prefix47, evalProg152_append, evalProg152_append]
  obtain ⟨hAcc47, _, hRefl47, hTele47⟩ := evalProg152_zeroReflChainPrefix hα 47 le_rfl
  let γ47 :=
    evalProg152 (pZeroRefl48ChainPrefix 47) (evalProg152 (listRefl49_152.map CleanStep152.x) α)
  have hr47 : γ47 (listRefl49_152[47]'(by rw [length_listRefl49_152]; decide)) =
      α (listRefl49_152[47]'(by rw [length_listRefl49_152]; decide)) + 1 :=
    hRefl47 ⟨47, by decide⟩
  have hSubEq : wSubReject_152 = listRefl49_152[48]'(by rw [length_listRefl49_152]; decide) := by
    decide
  have hSub47 : γ47 wSubReject_152 =
      α (listRefl49_152[48]'(by rw [length_listRefl49_152]; decide)) + 1 := by
    rw [hSubEq]; exact hRefl47 ⟨48, by decide⟩
  have hneSubTele : wSubReject_152 ≠ wTelePar_152 := by decide
  dsimp only [evalProg152, evalStep152]
  rw [Function.update_self, Function.update_of_ne hneSubTele]
  change (γ47 wTelePar_152 +
      γ47 (listAcc48_152[47]'(by rw [length_listAcc48_152]; decide)) *
        γ47 (listRefl49_152[47]'(by rw [length_listRefl49_152]; decide))) *
      γ47 wSubReject_152 + α wEnPos_152 = zeroRefl48PhaseBit α
  have hTele47' : γ47 wTelePar_152 = 0 := hTele47
  have hAcc47' : γ47 (listAcc48_152[47]'(by rw [length_listAcc48_152]; decide)) =
      zeroReflAccProd α 47 := hAcc47
  have hStep49 :
      (γ47 wTelePar_152 +
        γ47 (listAcc48_152[47]'(by rw [length_listAcc48_152]; decide)) *
          γ47 (listRefl49_152[47]'(by rw [length_listRefl49_152]; decide))) *
        γ47 wSubReject_152 + α wEnPos_152 =
      zeroReflAccProd α 49 + α wEnPos_152 := by
    rw [hTele47', zero_add, hAcc47', hr47, hSub47]
    simp [zeroReflAccProd]
  rw [hStep49]
  have hall_iff : (∀ m (hm : m < 49),
    α (listRefl49_152[m]'(by rw [length_listRefl49_152]; omega)) = 0) ↔
      (∀ w ∈ listRefl49_152, α w = 0) := by
    constructor
    · intro hm w hw
      obtain ⟨m, hm_lt, rfl⟩ := List.getElem_of_mem hw
      exact hm m (by rw [length_listRefl49_152] at hm_lt; exact hm_lt)
    · intro hw m hm
      exact hw _ (List.getElem_mem _)
  by_cases hp1 : zeroReflAccProd α 49 = 1
  · obtain ⟨hen1, hall0⟩ := (zeroReflAccProd_eq_one_iff α 49 le_rfl).mp hp1
    have hallw : ∀ w ∈ listRefl49_152, α w = 0 := hall_iff.mp hall0
    rw [hp1, hen1, CharTwo.add_self_eq_zero]
    unfold zeroRefl48PhaseBit
    have hcond : ¬(α wEnPos_152 = 1 ∧ ¬(∀ w ∈ listRefl49_152, α w = 0)) := fun h ↦ h.2 hallw
    exact (ite_eq_right hcond).symm
  · have hp0 : zeroReflAccProd α 49 = 0 := by
      rcases bit_cases (zeroReflAccProd α 49) with h0 | h1
      · exact h0
      · exact absurd h1 hp1
    have hnot : ¬(α wEnPos_152 = 1 ∧ ∀ w ∈ listRefl49_152, α w = 0) := fun ⟨hen1, hallw⟩ ↦
      hp1 ((zeroReflAccProd_eq_one_iff α 49 le_rfl).mpr ⟨hen1, hall_iff.mpr hallw⟩)
    rw [hp0, zero_add]
    rcases bit_cases (α wEnPos_152) with hen0 | hen1
    · rw [hen0]; unfold zeroRefl48PhaseBit; simp [hen0]
    · have hnw : ¬(∀ w ∈ listRefl49_152, α w = 0) := fun hw ↦ hnot ⟨hen1, hw⟩
      rw [hen1]; unfold zeroRefl48PhaseBit; simp [hen1, hnw]


private theorem dZeroRefl48_pair {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^
    n)]
    (v : Var) (rFull152 : QRegister 152 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull152.DisjointWires rExtra9) :
    DynPair152 v rFull152 rExtra9 MuxFlagsInv152 192
      (dZeroRefl48Fwd v rFull152) (dZeroRefl48Inv v rFull152)
      (diagBitPhase zeroRefl48PhaseBit) := by
  have hClean : ∀ w : Wire 152, (!isMuxCleanScrWire w) = false → ∀ α, MuxFlagsInv152 α → α w = 0 :=
    by
    intro w hw α hα
    simp only [Bool.not_eq_false'] at hw
    exact muxFlagsInv152_clean_of_mask hw hα
  have hCore := compileCleanProg152_cz_pair v rFull152 rExtra9 hDisjExtra
    pZeroRefl48Prog152 (fun w ↦ !isMuxCleanScrWire w) checkFresh_pZeroRefl48Prog152
    MuxFlagsInv152 hClean wTelePar_152 wSubReject_152 (by decide)
  have hT : 4 * countTempAnd152 pZeroRefl48Prog152 = 192 := by
    rw [countTempAnd_pZeroRefl48Prog152]
  rw [hT] at hCore
  have hZToff : (Circuit.Z wEnPos_152).count PrimitiveGate.TOFF = 0 := rfl
  have hZT : (Circuit.Z wEnPos_152).count PrimitiveGate.T = 0 := rfl
  have hZSpan : PreservesSpanSub MuxFlagsInv152 MuxFlagsInv152 (Circuit.Z wEnPos_152) := by
    intro α hα; rw [ket_Z wEnPos_152 α]
    exact (KetSpanSub MuxFlagsInv152).smul_mem _ (ket_mem_ketSpanSub hα)
  have hZSq : (Circuit.Z wEnPos_152).eval * (Circuit.Z wEnPos_152).eval = 1 := by
    have h2 : PrimitiveGate.eval .z * PrimitiveGate.eval .z = (1 : Unitary 2) := by
      apply Subtype.ext; ext i j
      change (((PrimitiveGate.eval .z).1 * (PrimitiveGate.eval .z).1) i j) =
        (1 : Matrix (Fin 2) (Fin 2) ℂ) i j
      rw [Matrix.one_apply]
      fin_cases i <;> fin_cases j <;>
        simp [PrimitiveGate.eval, Qubit.Z, Matrix.mul_apply, Fin.sum_univ_two]
    rw [Circuit.eval_single, ← QRegister.embedUnitary_mul, h2, QRegister.embedUnitary_one]
  have hZPair := DynPair152.staticSelfInv v rFull152 rExtra9 MuxFlagsInv152 (Circuit.Z wEnPos_152)
    hZToff hZSpan hZSq
  rw [hZT] at hZPair
  have hSeq := DynPair152.seq hDisjExtra hCore hZPair
  rw [Nat.add_zero] at hSeq
  refine hSeq.congr_fwd fun α hα ↦ ?_
  simp only [Submonoid.coe_mul, mul_mulVec_sub, diagBitPhase_mulVec_ket,
    Matrix.mulVec_smul, ket_Z, smul_smul]
  have hbitSignMul : ∀ a b : ZMod 2, bitSign b * bitSign a = bitSign (a + b) := by
    intro a b; rcases bit_cases a with rfl | rfl <;> rcases bit_cases b with rfl | rfl <;>
      simp [bitSign]
  rw [hbitSignMul, add_comm (α wEnPos_152), evalProg152_pZeroRefl48Prog152_phase hα]

