  | r17 => exact (hδ0_out (scr21_152 6) (by decide) (by decide)).trans (hscr21 6)
  | r18 => exact (hδ0_out (scr21_152 7) (by decide) (by decide)).trans (hscr21 7)
  | r19 => exact (hδ0_out (scr21_152 16) (by decide) (by decide)).trans (hscr21 16)
  | r20 => exact (hδ0_out (scr21_152 17) (by decide) (by decide)).trans (hscr21 17)
