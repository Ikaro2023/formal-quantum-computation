      have hq78 : p ⟨78, by decide⟩ = 0 := by
        have : q 78 = p ⟨78, by decide⟩ := by rw [hq_def]; rfl
        exact this ▸ hcond.1.1.2
      have hb0z : (Pos24HeadCoordXor80.bitsVal
          fun j : Fin 3 ↦ q (pos80SubIdx 3 3 (by decide) j)) = 0 := by
        have hfun : (fun j : Fin 3 ↦ q (pos80SubIdx 3 3 (by decide) j)) = fun _ ↦ 0 := by
          funext j; fin_cases j <;> (rw [hq_def]; rfl)
