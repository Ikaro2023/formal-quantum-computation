    · simp only [hg, Bool.false_eq_true, ↓reduceIte, norm_mul, mul_pow, hrealSq, hpow11,
        norm_matMuxHead_00_sq]
      ring
  · simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte, norm_mul, mul_pow,
      hrealSq, hpow11, norm_matMuxHead_10_sq]
    ring


