theorem scr30_128_val_cert (j : Fin 30) : (scr30_128 j).val = 86 + j.val := rfl


theorem rHead67_ge37_eq_scr30 {k : ℕ} (hk : k < 30) :
    rHead67_128 ⟨37 + k, by omega⟩ = scr30_128 ⟨k, hk⟩ := by
  ext
  change (headMap67In128 ⟨37 + k, by omega⟩).val = (scr30_128 ⟨k, hk⟩).val
  rw [headMap67In128_val_of_ge37 (by dsimp; omega) (by dsimp; omega), scr30_128_val_cert]
  change 86 + (37 + k - 37) = 86 + k
  omega


theorem tailScr39_rHead76_zero {n : ℕ}
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (β : BitAssignment n) (hL : Lift128 rFull128 rExtra9 FlagsInv128 β)
    (j : Fin 39) :
    β (tailScr (rHead76Of rFull128 rExtra9 hDisjExtra) 39 (by decide) j) = 0 := by
  dsimp [tailScr, rHead76Of]
  by_cases hj30 : j.val < 30
  · have hidx : (⟨76 - 39 + j.val, by omega⟩ : Fin 76) =
        Fin.castAdd 9 (⟨37 + j.val, by omega⟩ : Fin 67) := by
      ext; change 76 - 39 + j.val = 37 + j.val; omega
    rw [hidx, QRegister.concat_apply_left, QRegister.compose_apply, rHead67_ge37_eq_scr30 hj30]
    exact ((flagsInv_iff (fun i ↦ β (rFull128 i))).mp hL.1).2 ⟨j.val, hj30⟩
  · have hidx : (⟨76 - 39 + j.val, by omega⟩ : Fin 76) =
        Fin.natAdd 67 (⟨j.val - 30, by omega⟩ : Fin 9) := by
      ext; change 76 - 39 + j.val = 67 + (j.val - 30); omega
    rw [hidx, QRegister.concat_apply_right]
    exact hL.2 ⟨j.val - 30, by omega⟩


private theorem embedUnitary_mulVec_ket_of_ket {k n : ℕ} (r : QRegister k n)
    (U : Unitary (2 ^ k)) (β : BitAssignment n) (α' : BitAssignment k)
    (h : U.1.mulVec (ket (fun i ↦ β (r i))) = ket α') :
    (r.embedUnitary U).1.mulVec (ket β) = ket (writeRegProg β r α') := by
  rw [QRegister.embedUnitary_val, embedMatrix_mulVec_ket_prog]
  have hcol : ∀ l : Fin (2 ^ k),
      U.1 l (localIdxProg r β) = if l = (basisBitsEquiv k).symm α' then (1 : ℂ) else 0 := by
    intro l
    rw [← ket_localIdxProg_eq r β l U.1, h, ket_eq_single_local]
    by_cases hl : l = (basisBitsEquiv k).symm α' <;> simp [hl]
  simp_rw [hcol, ite_smul, one_smul, zero_smul]
  simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  have hb : basisBits k ((basisBitsEquiv k).symm α') = α' :=
    (basisBitsEquiv k).apply_symm_apply α'
  rw [hb]


theorem writeRegProg_rHead76_eq {n : ℕ}
    (rFull128 : QRegister 128 n) (rExtra9 : QRegister 9 n)
    (hDisjExtra : rFull128.DisjointWires rExtra9)
    (β : BitAssignment n) (hL : Lift128 rFull128 rExtra9 FlagsInv128 β)
    (γOut : BitAssignment 76)
    (h67 : ∀ i : Fin 67, γOut (Fin.castAdd 9 i) =
      head67CleanMap (fun k : Fin 67 ↦ β (rFull128 (rHead67_128 k))) i)
    (h9 : ∀ j : Fin 9, γOut (Fin.natAdd 67 j) = 0) :
    writeRegProg β (rHead76Of rFull128 rExtra9 hDisjExtra) γOut =
      writeRegProg β rFull128
        (writeReg (fun u ↦ β (rFull128 u)) rHead67_128
          (head67CleanMap (fun k : Fin 67 ↦ β (rFull128 (rHead67_128 k))))) := by
  let rHead76 := rHead76Of rFull128 rExtra9 hDisjExtra
  let out67 := head67CleanMap (fun k : Fin 67 ↦ β (rFull128 (rHead67_128 k)))
  funext w
  by_cases hmem76 : w ∈ Set.range rHead76.wires
  · obtain ⟨idx, rfl⟩ := hmem76
    rw [writeRegProg_apply_reg]
    by_cases h67_lt : idx.val < 67
    · let i : Fin 67 := ⟨idx.val, h67_lt⟩
      have hidx : idx = Fin.castAdd 9 i := by ext; rfl
      rw [hidx, h67 i]
      have hw : rHead76 (Fin.castAdd 9 i) = rFull128 (rHead67_128 i) := by
        dsimp [rHead76, rHead76Of]; rw [QRegister.concat_apply_left]; rfl
      rw [hw, writeRegProg_apply_reg, writeReg_apply_reg]
    · let j : Fin 9 := ⟨idx.val - 67, by omega⟩
      have hidx : idx = Fin.natAdd 67 j := by
        ext; change idx.val = 67 + (idx.val - 67); omega
      rw [hidx, h9 j]
      have hw : rHead76 (Fin.natAdd 67 j) = rExtra9 j := by
        dsimp [rHead76, rHead76Of]; exact QRegister.concat_apply_right _ _ _ j
      rw [hw]
      have hnot128 : rExtra9 j ∉ Set.range rFull128.wires := by
        rintro ⟨u, hu⟩; exact hDisjExtra.ne u j hu
      rw [writeRegProg_apply_of_not_mem _ _ _ _ hnot128, hL.2 j]
  · rw [writeRegProg_apply_of_not_mem _ _ _ _ hmem76]
    by_cases hmem128 : w ∈ Set.range rFull128.wires
    · obtain ⟨u, rfl⟩ := hmem128
      rw [writeRegProg_apply_reg]
      have hnot67 : ¬∃ i : Fin 67, rHead67_128 i = u := by
        rintro ⟨i, rfl⟩
        apply hmem76
        refine ⟨Fin.castAdd 9 i, ?_⟩
        dsimp [rHead76, rHead76Of]; rw [QRegister.concat_apply_left]; rfl
      rw [writeReg_apply_of_not_mem _ _ _ _ hnot67]
    · rw [writeRegProg_apply_of_not_mem _ _ _ _ hmem128]


theorem cLeafHeadCoordXor_inv_eq_on_FlagsInv128 :
    ∀ α : BitAssignment 128, FlagsInv128 α →
      cLeafHeadCoordXor.eval.1.mulVec (ket α) =
        ((cLeafHeadCoordXor.eval)⁻¹).1.mulVec (ket α) := by
  intro α hα
  have hscr : ∀ j : Fin 30, α (scr30_128 j) = 0 := ((flagsInv_iff α).mp hα).2
  let γ67 : BitAssignment 67 := fun k ↦ α (rHead67_128 k)
  let α' := writeReg α rHead67_128 (head67CleanMap γ67)
  have h1 : cLeafHeadCoordXor.eval.1.mulVec (ket α) = ket α' := ket_cLeafHeadCoordXor α hscr
  have hscr' : ∀ j : Fin 30, α' (scr30_128 j) = 0 := by
    intro j
    have heq := rHead67_ge37_eq_scr30 j.isLt
    rw [← heq]
    dsimp [α']
    rw [writeReg_apply_reg, head67CleanMap]
    have hnot : (⟨37 + j.val, by omega⟩ : Fin 67) ∉ rOut24In67.image := by
      rw [QRegister.mem_image]
      rintro ⟨m, hm⟩
      have hv := congrArg Fin.val hm
      dsimp [rOut24In67, PosPostPrep80CertS3Alt.qreg_block_apply,
        PosPostPrep80CertS3Alt.qreg_block_wires_apply,
        PosPostPrep80CertS3Alt.qreg_whole_wires,
        PosPostPrep80CertS3Alt.emb_trans_apply,
        PosPostPrep80CertS3Alt.emb_refl_apply,
        PosPostPrep80CertS3Alt.emb_mk_apply] at hv
      omega
    rw [xorRegBits_apply_of_not_mem _ _ _ hnot]
    dsimp [γ67]; rw [heq, hscr j]
  have hγ' : (fun k : Fin 67 ↦ α' (rHead67_128 k)) = head67CleanMap γ67 := by
    funext k; exact writeReg_apply_reg _ _ _ k
  have hα'' : writeReg α' rHead67_128 (head67CleanMap (fun k ↦ α' (rHead67_128 k))) = α := by
    rw [hγ', head67CleanMap_involutive]
    funext w
    by_cases hm : ∃ k : Fin 67, rHead67_128 k = w
    · obtain ⟨k, rfl⟩ := hm; rw [writeReg_apply_reg]
    · rw [writeReg_apply_of_not_mem _ _ _ _ hm]
      dsimp [α']; exact writeReg_apply_of_not_mem _ _ _ _ hm
  have h2 : cLeafHeadCoordXor.eval.1.mulVec (ket α') = ket α := by
    rw [ket_cLeafHeadCoordXor α' hscr', hα'']
  rw [h1]
  conv_rhs => rw [← h2, ← mul_mulVec_prog]
  have hL : ((cLeafHeadCoordXor.eval)⁻¹).1 * cLeafHeadCoordXor.eval.1 = 1 :=
    unitary_inv_mul_val_cert cLeafHeadCoordXor.eval
  rw [hL, Matrix.one_mulVec]


