def liftBits128 (β : BitAssignment 128) : BitAssignment 152 :=
  fun w ↦ if hw : w.val < 128 then β ⟨w.val, hw⟩ else 0


theorem liftBits128_rSub128 (β : BitAssignment 128) :
    (fun i : Fin 128 ↦ liftBits128 β (rSub128 i)) = β := by
  funext i
  dsimp only [liftBits128]
  have hi : (rSub128 i).val < 128 := by rw [rSub128_val]; exact i.isLt
  rw [dite_eq_left hi]
  congr 1
  ext
  exact rSub128_val i


theorem writeReg_liftBits128_rSub128 (β γ : BitAssignment 128) :
    ZeroAncillaUSPS3.writeReg (liftBits128 β) rSub128 γ = liftBits128 γ := by
  funext w
  by_cases hw : w.val < 128
  · have hwEq : w = rSub128 ⟨w.val, hw⟩ := by ext; exact (rSub128_val ⟨w.val, hw⟩).symm
    rw [hwEq, ZeroAncillaUSPS3.writeReg_apply_reg]
    dsimp only [liftBits128]
    have hlt : (rSub128 ⟨w.val, hw⟩).val < 128 := by rw [rSub128_val]; exact hw
    rw [dite_eq_left hlt]
    congr 1; ext; exact (rSub128_val ⟨w.val, hw⟩).symm
  · have hnot : ¬∃ i : Fin 128, rSub128 i = w := by
      rintro ⟨i, rfl⟩
      exact hw (by rw [rSub128_val]; exact i.isLt)
    rw [ZeroAncillaUSPS3.writeReg_apply_of_not_mem _ _ _ _ hnot]
    dsimp only [liftBits128]
    rw [dite_eq_right hw, dite_eq_right hw]


