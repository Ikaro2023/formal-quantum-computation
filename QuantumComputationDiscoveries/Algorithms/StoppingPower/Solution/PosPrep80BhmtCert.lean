        false false false false false false false false false false false false)) .r20 =
        nucS1 n0 n1 n2 n5 s4h s0t (n3 && n4) (n6 && n7)
          false false false false false false false false false false := by
    rw [nucProg22_eq_rest0, nucRest0, evalProg22_append, eval_nucC0]
    simp only [Bool.false_bne]
    exact eval_nucRest1 n0 n1 n2 n3 n4 n5 n6 n7 s4h s0t (n3 && n4) (n6 && n7)
      false false false false false false false false false false
  have hspec := nucS1_spec s4h s0t n0 n1 n2 (n3 && n4) n5 (n6 && n7) hnot
  have hbad : badNucBool n0 n1 n2 (n3 && n4) true n5 (n6 && n7) true s4h s0t =
      badNucBool n0 n1 n2 n3 n4 n5 n6 n7 s4h s0t := by
    dsimp only [badNucBool]; simp only [Bool.and_true]
  rw [hbad] at hspec
