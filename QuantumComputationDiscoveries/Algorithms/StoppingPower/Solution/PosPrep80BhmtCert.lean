private theorem dOpenMuxBhmtPair_compressed {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rAct86 : QRegister 86 n) (rWork : QRegister 128 n)
    (hDisj86 : rAct86.DisjointWires rWork) :
    let rFull152 := rAct86.concat (rWork.slice 0 66 (by decide)) (hDisj86.compose_right _)
    let rExtra9 := rWork.slice 66 9 (by decide)
    let hDisjExtra := mkRFull152_disjoint_rExtra9 rAct86 rWork hDisj86
    DynCircuitExt.RealizesEmbeddedUnitaryWithCleanWorkspace
        rAct86 rWork uPosPostAnc86_Bhmt (dOpenMuxBhmtFwd v rFull152 rExtra9 hDisjExtra) ∧
      DynCircuitExt.RealizesEmbeddedUnitaryWithCleanWorkspace
        rAct86 rWork uPosPostAnc86_Bhmt⁻¹ (dOpenMuxBhmtInv v rFull152 rExtra9 hDisjExtra) := by
  intro rFull152 rExtra9 hDisjExtra
  have hp := dOpenMuxBhmt_pair v rFull152 rExtra9 hDisjExtra
  let EV : Unitary (2 ^ 152) :=
    (rCleanAct0 86 66 152 muxPostHwa).embedUnitary uPosPostAnc86_Bhmt
  have hCompEq : ∀ α : BitAssignment 152, Clean66_152 α →
      uPosPostBhmt_152.1.mulVec (ket α) = EV.1.mulVec (ket α) := by
    intro α hα
    have hMP := (embedUnitary_compressCleanUnitary_mul_proj muxPostHwa
      uPosPostBhmt_152 uPosPostBhmt_152_preserves_clean).symm
    have hv := congrArg (fun M ↦ M.mulVec (ket α)) hMP
    have hP0 : ((rCleanSubW 86 66 152 muxPostHwa).basisOutcomeProjector 0).mulVec (ket α) =
        ket α := by
      rw [basisOutcomeProjector_zero_eq_subDiagProj_Clean66, subDiagProj_mulVec_ket, ite_pos_sub hα]
    simpa only [EV, uPosPostAnc86_Bhmt, mul_mulVec_sub, hP0] using hv
  have hpEV := hp.congr_fwd hCompEq
  let P_lift := subDiagProj (SubLift152 rFull152 rExtra9 Clean66_152)
  let P_work := projZeroAll 128 rWork.wires
  have hPl : P_liftᴴ = P_lift := subDiagProj_conjTranspose _
  have hPw : P_workᴴ = P_work := projZeroAll_conjTranspose 128 _
  have hsub : P_lift * P_work = P_work := by
    apply matrix_ext_ket; intro β
    simp only [P_lift, P_work, mul_mulVec_sub, ket_projZeroAll]
    by_cases hw : ∀ i : Fin 128, β (rWork i) = 0
    · have hL := subLift152_clean66_of_work_zero rAct86 rWork hDisj86 β hw
      rw [ite_eq_left hw, subDiagProj_mulVec_ket, ite_pos_sub hL]
    · rw [ite_eq_right hw, Matrix.mulVec_zero]
  have hCompReg : rFull152.compose (rCleanAct0 86 66 152 muxPostHwa) = rAct86 :=
    rFull152_compose_rCleanAct0 rAct86 rWork hDisj86
  have hEmbFwd : rFull152.embedUnitary EV = rAct86.embedUnitary uPosPostAnc86_Bhmt := by
    dsimp [EV]; rw [← QRegister.embedUnitary_compose, hCompReg]
  have hEmbInv : rFull152.embedUnitary EV⁻¹ = rAct86.embedUnitary uPosPostAnc86_Bhmt⁻¹ := by
    rw [← embedUnitary_inv_eq, hEmbFwd, embedUnitary_inv_eq]
  have hMonoFwd := hEmbFwd ▸ RealizesCleanUnitary.mono_proj hPl hPw hsub hpEV.realFwd
  have hMonoInv := hEmbInv ▸ RealizesCleanUnitary.mono_proj hPl hPw hsub hpEV.realInv
  exact ⟨realizesCleanWorkspace_of_cleanUnitary_rWork v rAct86 rWork _ _ hpEV.storeFwd hMonoFwd,
    realizesCleanWorkspace_of_cleanUnitary_rWork v rAct86 rWork _ _ hpEV.storeInv hMonoInv⟩


