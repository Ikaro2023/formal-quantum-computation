  apply Nat.eq_of_testBit_eq; intro i; simp only [Nat.testBit_and, Nat.testBit_xor]
  cases a.testBit i <;> cases b.testBit i <;> cases M.testBit i <;> rfl


theorem nat_and_xor_of_disjoint76 {a δ M : ℕ} (hdisj : δ &&& M = 0) :
    (a ^^^ δ) &&& M = a &&& M := by
  rw [nat_and_xor_distrib_right76, hdisj, Nat.xor_zero]


theorem stepMask76_involutive {g : RevGate76} (hw : g.wf = true) (m : ℕ) :
    stepMask76 g (stepMask76 g m) = m := by
  cases g with
  | x t => exact nat_xor_cancel_right76 m (2 ^ t.val)
  | cnot c t =>
      have hne : t.val ≠ c.val := fun h ↦ by
        have heq : c = t := Fin.ext h.symm
        subst heq; simp [RevGate76.wf] at hw
      dsimp only [stepMask76]
      by_cases hc : m.testBit c.val = true
      · rw [ite_eq_left hc]
        have hc2 : (m ^^^ (2 ^ t.val)).testBit c.val = true := by
          rw [Nat.testBit_xor, Nat.testBit_two_pow, decide_eq_false hne, hc]; rfl
        rw [ite_eq_left hc2]; exact nat_xor_cancel_right76 m (2 ^ t.val)
      · rw [ite_eq_right hc, ite_eq_right hc]
  | toff c1 c2 t =>
      simp only [RevGate76.wf, Bool.and_eq_true, bne_iff_ne] at hw
      have h1 : t.val ≠ c1.val := fun h ↦ hw.1.2 (Fin.ext h.symm)
      have h2 : t.val ≠ c2.val := fun h ↦ hw.2 (Fin.ext h.symm)
      dsimp only [stepMask76]
      by_cases hc : (m.testBit c1.val && m.testBit c2.val) = true
      · rw [ite_eq_left hc]
        have hc' : ((m ^^^ (2 ^ t.val)).testBit c1.val &&
            (m ^^^ (2 ^ t.val)).testBit c2.val) = true := by
          rw [Nat.testBit_xor, Nat.testBit_xor, Nat.testBit_two_pow, Nat.testBit_two_pow,
            decide_eq_false h1, decide_eq_false h2]
          simpa using hc
        rw [ite_eq_left hc']; exact nat_xor_cancel_right76 m (2 ^ t.val)
      · rw [ite_eq_right hc, ite_eq_right hc]


