theorem good48Pred152_writeData48_eq {isHead s0 : Bool} {α₀ : BitAssignment 152}
    (het : α₀ wEnTail_152 = if isHead then 0 else 1)
    (hest : α₀ wEnS0Tail_152 = if !isHead && s0 then 1 else 0)
    (hs4h : α₀ wEnS4Head_152 = if isHead && s0 then 1 else 0)
    (hc0h : α₀ wEnC0Head_152 = if isHead && !s0 then 1 else 0)
    (d : Data48Tuple) :
