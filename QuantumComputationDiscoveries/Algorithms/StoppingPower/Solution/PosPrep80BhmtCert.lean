  if α wEnC0Head_152 = 1 then
    !(α (rAnc_152 1) == 1 && α (rAnc_152 2) == 1)
  else
    decide (anc8Val152 α < 218)


def goodNucPred152 (α : BitAssignment 152) : Bool :=
  if α wEnS4Head_152 = 1 then
    !(α (rNuc_152 0) == 1 && α (rNuc_152 1) == 1)
  else if α wEnS0Tail_152 = 1 then
    decide (nuc8Val152 α < 217)
  else
    decide (nuc8Val152 α < 218)


