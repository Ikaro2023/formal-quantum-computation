theorem ite_pos_eq {α : Sort*} {c : Prop} [Decidable c] (hc : c) {a b : α} :
    (if c then a else b) = a := by simp [hc]
theorem ite_neg_eq {α : Sort*} {c : Prop} [Decidable c] (hc : ¬c) {a b : α} :
    (if c then a else b) = b := by simp [hc]
theorem real_mul_le_one {a b : ℝ} (ha : a ≤ 1) (hb0 : 0 ≤ b) (hb1 : b ≤ 1) : a * b ≤ 1 := by
  have h : a * b ≤ 1 * b := mul_le_mul_of_nonneg_right ha hb0
  linarith
structure Vec16 where
  (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 : ℕ)
structure Vec160 where
  (b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 : Vec16)
def vec16Get (v : Vec16) (i : Fin 16) : ℕ :=
  match i.val with
  | 0 => v.x0 | 1 => v.x1 | 2 => v.x2 | 3 => v.x3 | 4 => v.x4 | 5 => v.x5 | 6 => v.x6 | 7 => v.x7
  | 8 =>
      v.x8 | 9 =>
        v.x9 | 10 => v.x10 | 11 => v.x11 | 12 => v.x12 | 13 => v.x13 | 14 => v.x14 | _ => v.x15
def vec160Get (v : Vec160) (b : Fin 10) (i : Fin 16) : ℕ :=
  match b.val with
  | 0 =>
      vec16Get v.b0 i | 1 =>
        vec16Get v.b1 i | 2 => vec16Get v.b2 i | 3 => vec16Get v.b3 i | 4 => vec16Get v.b4 i
  | 5 =>
      vec16Get v.b5 i | 6 =>
        vec16Get v.b6 i | 7 => vec16Get v.b7 i | 8 => vec16Get v.b8 i | _ => vec16Get v.b9 i
def sum16 (a : Vec16) : ℕ :=
  let s0 : ℕ := (a.x0 + a.x1 : ℕ) + (a.x2 + a.x3 : ℕ)
  let s1 : ℕ := (a.x4 + a.x5 : ℕ) + (a.x6 + a.x7 : ℕ)
  let s2 : ℕ := (a.x8 + a.x9 : ℕ) + (a.x10 + a.x11 : ℕ)
  let s3 : ℕ := (a.x12 + a.x13 : ℕ) + (a.x14 + a.x15 : ℕ)
  (s0 + s1 : ℕ) + (s2 + s3 : ℕ)
def sum160 (a : Vec160) : ℕ :=
  let s0 : ℕ := (sum16 a.b0 + sum16 a.b1 : ℕ) + (sum16 a.b2 + sum16 a.b3 : ℕ)
  let s1 : ℕ := (sum16 a.b4 + sum16 a.b5 : ℕ) + (sum16 a.b6 + sum16 a.b7 : ℕ)
  (s0 + s1 : ℕ) + (sum16 a.b8 + sum16 a.b9 : ℕ)
def dot16 (a b : Vec16) : ℕ :=
  let d0 : ℕ := (a.x0 * b.x0 + a.x1 * b.x1 : ℕ) + (a.x2 * b.x2 + a.x3 * b.x3 : ℕ)
  let d1 : ℕ := (a.x4 * b.x4 + a.x5 * b.x5 : ℕ) + (a.x6 * b.x6 + a.x7 * b.x7 : ℕ)
  let d2 : ℕ := (a.x8 * b.x8 + a.x9 * b.x9 : ℕ) + (a.x10 * b.x10 + a.x11 * b.x11 : ℕ)
  let d3 : ℕ := (a.x12 * b.x12 + a.x13 * b.x13 : ℕ) + (a.x14 * b.x14 + a.x15 * b.x15 : ℕ)
  (d0 + d1 : ℕ) + (d2 + d3 : ℕ)
def dot160 (a b : Vec160) : ℕ :=
  let d0 : ℕ := (dot16 a.b0 b.b0 + dot16 a.b1 b.b1 : ℕ) + (dot16 a.b2 b.b2 + dot16 a.b3 b.b3 : ℕ)
  let d1 : ℕ := (dot16 a.b4 b.b4 + dot16 a.b5 b.b5 : ℕ) + (dot16 a.b6 b.b6 + dot16 a.b7 b.b7 : ℕ)
  (d0 + d1 : ℕ) + (dot16 a.b8 b.b8 + dot16 a.b9 b.b9 : ℕ)
theorem sum_fin16 (f : Fin 16 → ℕ) : (∑ i : Fin 16, f i) = f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6 +
    f 7 + f 8 + f 9 + f 10 + f 11 + f 12 + f 13 + f 14 + f 15 := by
  simp only [Fin.sum_univ_castSucc, Fin.sum_univ_zero, zero_add]
  rfl
theorem sum_fin10 (f : Fin 10 → ℕ) : (∑ b : Fin 10, f b) = f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6 +
    f 7 + f 8 + f 9 := by
  simp only [Fin.sum_univ_castSucc, Fin.sum_univ_zero, zero_add]
  rfl
theorem sum16_eq (a : Vec16) : sum16 a = ∑ i : Fin 16, vec16Get a i := by
  rw [sum_fin16]
  simp [sum16, vec16Get]
  ring
theorem sum160_eq (a : Vec160) : sum160 a = ∑ b : Fin 10, ∑ i : Fin 16, vec160Get a b i := by
  rw [sum_fin10]
  simp [sum160, vec160Get, ← sum16_eq]
  ring
theorem dot16_eq (a b : Vec16) : dot16 a b = ∑ i : Fin 16, vec16Get a i * vec16Get b i := by
  rw [sum_fin16]
  simp [dot16, vec16Get]
  ring
theorem dot160_eq (a b : Vec160) : dot160 a b = ∑ blk : Fin 10, ∑ i : Fin 16, vec160Get a blk i *
    vec160Get b blk i := by
  rw [sum_fin10]
  simp [dot160, vec160Get, ← dot16_eq]
  ring
