def k6RowWord160 (q : ℕ) : ℕ :=
  cond (Nat.blt q 749) (k6Vec16At (k6RowBlock16 (q >>> 4)) (q &&& 15)) 0
def k6SuperRow (q : ℕ) : K6SuperRow := withStrictNat (k6RowWord160 q) (fun w ↦ ⟨w &&&
    0xffffffffffffffff, (w >>> 64) &&& 0xffffffffffffffff, (w >>> 128) &&& 0xffffff,
    k6UnpackSubGates (w >>> 158) ((w >>> 152) &&& 63)⟩)
def k6WithStrictBool {α : Type} (b : Bool) (f : Bool → α) : α :=
  match b with
  | false => f false
  | true => f true
@[scoped simp] theorem k6WithStrictBool_eq {α : Type} (b : Bool) (f : Bool → α) :
    k6WithStrictBool b f = f b := by
  cases b <;> rfl
def k6WithStrictSuperRow {α : Type} (r : K6SuperRow) (f : ℕ → ℕ → ℕ → List (ℕ × ℕ) → α) : α :=
  match r with
  | ⟨p0, p1, bp24, sgs⟩ => f p0 p1 bp24 sgs
@[scoped simp] theorem k6WithStrictSuperRow_eq {α : Type} (r : K6SuperRow)
    (f : ℕ → ℕ → ℕ → List (ℕ × ℕ) → α) :
    k6WithStrictSuperRow r f = f r.p0 r.p1 r.basePal24 r.subGates := by
  cases r; rfl
def k6BitNat (x k : ℕ) : Bool := Nat.beq ((x / (2 ^ k)) % 2) 1
def k6SubGatesPalBool : List (ℕ × ℕ) → ℕ → ℕ → Bool
  | [], _, _ => false
  | (sMask, dMask) :: rest, sl, t =>
      bne (k6BitNat sMask sl && k6BitNat dMask t) (k6SubGatesPalBool rest sl t)
def k6Pal24BitBool (q sl t : ℕ) : Bool :=
  let row := k6SuperRow q
  bne (k6BitNat row.basePal24 t) (k6SubGatesPalBool row.subGates sl t)
def k6ReconTop6BitBool (q sl j : ℕ) : Bool :=
  let row := k6SuperRow q
  let b0 := k6Pal24BitBool q sl j
  let c0 := k6BitNat row.p0 sl
  let c1 := k6BitNat row.p1 sl
  let d1 := k6Pal24BitBool q sl (6 + j)
  let d2 := k6Pal24BitBool q sl (12 + j)
  let d3 := k6Pal24BitBool q sl (18 + j)
  bne b0 (cond c1 (cond c0 d3 d2) (cond c0 d1 false))
def k6CutQbNat : ℕ → ℕ
  | 0 => 2553265499 | 1 => 2629544206 | 2 => 2602730294 | _ => 2578361638
def k6MidQbNat : ℕ → ℕ
  | 0 => 1781435396 | 1 => 1815366755 | 2 => 1806177994 | _ => 1793996619
theorem k6CutQbNat_eq_pos24CutQb (wt : Fin 4) : k6CutQbNat wt.val = pos24CutQb wt := by
  fin_cases wt <;> rfl
theorem k6MidQbNat_eq_pos24MidQb (wt : Fin 4) : k6MidQbNat wt.val = pos24MidQb wt := by
  fin_cases wt <;> rfl
def k6ExpectedTop6Ok (q sl wt qb : ℕ) : Bool :=
  let tQb := min qb (k6CutQbNat wt)
  let mQb := k6MidQbNat wt
  let sgn := decide (tQb < mQb)
  let mag := if tQb < mQb then mQb - tQb else tQb - mQb
  (k6ReconTop6BitBool q sl 0 == decide ((mag / 33554432) % 2 = 1)) &&
  (k6ReconTop6BitBool q sl 1 == decide ((mag / 67108864) % 2 = 1)) &&
  (k6ReconTop6BitBool q sl 2 == decide ((mag / 134217728) % 2 = 1)) &&
  (k6ReconTop6BitBool q sl 3 == decide ((mag / 268435456) % 2 = 1)) &&
  (k6ReconTop6BitBool q sl 4 == decide ((mag / 536870912) % 2 = 1)) &&
  (k6ReconTop6BitBool q sl 5 == sgn)
def k6BitFast (x k : ℕ) : Bool := Nat.beq ((x >>> k) &&& 1) 1
theorem k6BitFast_eq (x k : ℕ) : k6BitFast x k = k6BitNat x k := by
  unfold k6BitFast k6BitNat
  rw [Nat.and_one_is_mod, Nat.shiftRight_eq_div_pow]
theorem k6BitFast_eq_testBit (x k : ℕ) : k6BitFast x k = x.testBit k := by
  rw [k6BitFast_eq, BinaryTournamentSwap217.nat_testBit_eq_div_mod]
  unfold k6BitNat
  cases h : Nat.beq ((x / 2 ^ k) % 2) 1
  · have hne : (x / 2 ^ k) % 2 ≠ 1 := by
      rw [Bool.eq_false_iff, Ne, Nat.beq_eq] at h
      exact h
    simp [hne]
  · rw [Nat.beq_eq] at h
    simp [h]
theorem k6BitFast_zero (t : ℕ) : k6BitFast 0 t = false := by
  rw [k6BitFast_eq_testBit, Nat.zero_testBit]
theorem k6BitFast_xor (a b t : ℕ) :
    k6BitFast (Nat.xor a b) t = bne (k6BitFast a t) (k6BitFast b t) := by
  rw [k6BitFast_eq_testBit, k6BitFast_eq_testBit, k6BitFast_eq_testBit]
  exact Nat.testBit_xor a b t
theorem k6BitFast_shiftRight (a s j : ℕ) : k6BitFast (a >>> s) j = k6BitFast a (s + j) := by
  rw [k6BitFast_eq_testBit, k6BitFast_eq_testBit]
  exact Nat.testBit_shiftRight a
def k6SubGatesXorWord : List (ℕ × ℕ) → ℕ → ℕ
  | [], _ => 0
  | (sMask, dMask) :: rest, sl =>
      cond (k6BitFast sMask sl)
        (Nat.xor dMask (k6SubGatesXorWord rest sl))
        (k6SubGatesXorWord rest sl)
theorem k6BitFast_subGatesXorWord (gs : List (ℕ × ℕ)) (sl t : ℕ) :
    k6BitFast (k6SubGatesXorWord gs sl) t = k6SubGatesPalBool gs sl t := by
  induction gs with
  | nil =>
      dsimp only [k6SubGatesXorWord, k6SubGatesPalBool]
      exact k6BitFast_zero t
  | cons hd tl ih =>
      rcases hd with ⟨sMask, dMask⟩
      dsimp only [k6SubGatesXorWord, k6SubGatesPalBool]
      rw [← k6BitFast_eq sMask sl, ← k6BitFast_eq dMask t]
      cases k6BitFast sMask sl
      · simp only [cond, Bool.false_and, Bool.false_bne, ih]
      · simp only [cond, Bool.true_and, k6BitFast_xor, ih]
def k6ExpectedTop6OkFast (q sl wt qb : ℕ) : Bool := k6WithStrictSuperRow (k6SuperRow q) (fun
    p0 p1 bp24 sgs ↦ withStrictNat (Nat.xor bp24 (k6SubGatesXorWord sgs sl)) (fun pal24 ↦
    k6WithStrictBool (k6BitFast p0 sl) (fun c0 ↦ k6WithStrictBool (k6BitFast p1 sl) (fun c1 ↦
    withStrictNat (Nat.xor pal24 (cond c1 (cond c0 (pal24 >>> 18) (pal24 >>> 12)) (cond c0
    (pal24 >>> 6) 0))) (fun recon6 ↦ withStrictNat (k6CutQbNat wt) (fun cutQb ↦ withStrictNat
    (cond (Nat.blt qb cutQb) qb cutQb) (fun tQb ↦ withStrictNat (k6MidQbNat wt) (fun mQb ↦
    k6WithStrictBool (Nat.blt tQb mQb) (fun sgn ↦ withStrictNat (cond sgn (mQb - tQb) (tQb -
    mQb)) (fun mag ↦ withStrictNat (mag >>> 25) (fun magTop ↦ (k6BitFast recon6 0 == k6BitFast
    magTop 0) && (k6BitFast recon6 1 == k6BitFast magTop 1) && (k6BitFast recon6 2 ==
    k6BitFast magTop 2) && (k6BitFast recon6 3 == k6BitFast magTop 3) && (k6BitFast recon6 4
    == k6BitFast magTop 4) && (k6BitFast recon6 5 == sgn))))))))))))
theorem k6_cond_blt_min (a b : ℕ) : cond (Nat.blt a b) a b = min a b := by
  rw [Nat.min_def]
  cases h : Nat.blt a b
  · have hge : ¬ a ≤ b ∨ a = b := by
      rw [Bool.eq_false_iff, Ne, Nat.blt_eq] at h
      omega
    rcases hge with hgt | rfl
    · simp [hgt]
    · simp
  · rw [Nat.blt_eq] at h
