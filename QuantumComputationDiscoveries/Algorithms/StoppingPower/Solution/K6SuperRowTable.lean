theorem K6StageSpec.ofCleanUnitary {Var : Type} [Fintype Var] [DecidableEq Var] {n m : ℕ}
    [NeZero (2 ^ n)] (v : Var) {S : BitAssignment n → Prop} {fProj : Fin m → Wire n}
