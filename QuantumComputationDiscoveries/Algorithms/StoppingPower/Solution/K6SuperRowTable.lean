    (hReal : RealizesCleanUnitary v (projZeroAll m fProj) d U)
    (hClean : ∀ α, S α → ∀ j : Fin m, α (fProj j) = 0)
    (hKet : ∀ α, S α → U.1.mulVec (ket α) = phase α • ket (nextKet α)) : K6StageSpec S d
