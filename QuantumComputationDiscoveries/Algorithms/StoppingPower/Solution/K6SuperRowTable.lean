noncomputable def k6OuterPhaseCircuit {n : ℕ}
    (rOH64 : QRegister 64 n) (wPar : Wire n)
    (rBuf1728 : QRegister 1728 n) (rPal24 : QRegister 24 n)
    (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar) :
    {k : ℕ} → (base Q : ℕ) → (c : Option (Wire n)) →
    (rX rW : QRegister (1 + k) n) →
    rX.DisjointWires rW → (∀ i, wPar ≠ rW i) →
    rW.DisjointWires rBuf1728 → rW.DisjointWires rPal24 →
    (∀ i, CtrlNe c (rX i)) → CtrlNe c wPar → (∀ i, CtrlNe c (rW i)) →
    (∀ f, CtrlNe c (rBuf1728 f)) → (∀ t, CtrlNe c (rPal24 t)) → Circuit n
  | 0, base, _, c, _, rW, _, hPW, _, hWPal, _, hcP, hcW, hcBuf, hcPal =>
      czFanoutCircuit c rBuf1728 hcBuf (k6_bufWord1728 base) ;;ᶜ
        czFanoutCircuit c rPal24 hcPal (k6Mask24Bits (k6SuperRow base).basePal24) ;;ᶜ
        k6SubPalListPhaseCircuit rOH64 wPar rPal24 hOHP (k6SuperRow base).subGates c rW
