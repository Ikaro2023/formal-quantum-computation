def k6_subPalStepCircuit {n : ℕ} (rOH64 : QRegister 64 n) (wPar : Wire n)
    (rPal24 : QRegister 24 n) (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar) (sMask dMask : ℕ)
    (c : Option (Wire n)) (rW1 : QRegister 1 n) (hPW : wPar ≠ rW1 (Fin.last 0))
    (hWPal : rW1.DisjointWires rPal24) (hcP : CtrlNe c wPar) (hcW : ∀ i, CtrlNe c (rW1 i)) :
    Circuit n :=
  let cXor := k6_xorMask64 rOH64 wPar hOHP sMask 64 (le_refl 64)
  let hcHitPal : ∀ t : Fin 24, CtrlNe (some (rW1 (Fin.last 0))) (rPal24 t) :=
    fun t ↦ CtrlNe.some (hWPal.ne (Fin.last 0) t)
  cXor ;;ᶜ
    branchMsbCircuit c ((QRegister.singleton wPar) (Fin.last 0)) (rW1 (Fin.last 0))
      hcP (hcW (Fin.last 0)) hPW
      .identity
      (czFanoutCircuit (some (rW1 (Fin.last 0))) rPal24 hcHitPal (k6Mask24Bits dMask)) ;;ᶜ
    cXor
theorem k6_subPalStepCircuit_eval_mulVec_ket {n : ℕ} (rOH64 : QRegister 64 n) (wPar : Wire n)
    (rPal24 : QRegister 24 n) (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar)
    (hPPal : ∀ t : Fin 24, wPar ≠ rPal24 t) (sMask dMask : ℕ) (c : Option (Wire n))
    (rW1 : QRegister 1 n) (hPW : wPar ≠ rW1 (Fin.last 0)) (hWPal : rW1.DisjointWires rPal24)
    (hcP : CtrlNe c wPar) (hcW : ∀ i, CtrlNe c (rW1 i)) (sel : Fin 64) (β : BitAssignment n)
    (hPar0 : β wPar = 0) (hW0 : β (rW1 (Fin.last 0)) = 0)
    (hOH : ∀ sl : Fin 64, β (rOH64 sl) = if sl = sel then 1 else 0) : (k6_subPalStepCircuit
    rOH64 wPar rPal24 hOHP sMask dMask c rW1 hPW hWPal hcP hcW).eval.1.mulVec (ket β) = ((-1 :
    ℂ) ^ (ctrlVal c β * ∑ t : Fin 24, β (rPal24 t) * ((if k6BitNat sMask sel.val then (1 :
    ZMod 2) else 0) * (if k6BitNat dMask t.val then (1 : ZMod 2) else 0))).val) • ket β := by
  dsimp only [k6_subPalStepCircuit]
  have hPW_disj : (QRegister.singleton wPar).DisjointWires rW1 := by
    rw [QRegister.disjoint_iff]
    intro i j; fin_cases i; fin_cases j; exact hPW
  let sBit : ZMod 2 := k6_ohMaskSum sMask rOH64 β 64 (le_refl 64)
  let β₁ := Function.update β wPar (β wPar + sBit)
  have hsBit : sBit = if k6BitNat sMask sel.val then 1 else 0 := by
    dsimp only [sBit]
    rw [k6_ohMaskSum_oneHot sMask rOH64 sel β hOH 64 (le_refl 64)]
    simp [sel.isLt]
  rw [p2t_eval_seq_mulVec, p2t_eval_seq_mulVec,
      k6_xorMask64_ket rOH64 wPar hOHP sMask β 64 (le_refl 64)]
  change (k6_xorMask64 rOH64 wPar hOHP sMask 64 (le_refl 64)).eval.1.mulVec ((branchMsbCircuit
    c ((QRegister.singleton wPar) (Fin.last 0)) (rW1 (Fin.last 0)) hcP (hcW (Fin.last 0)) hPW
    .identity (czFanoutCircuit (some (rW1 (Fin.last 0))) rPal24 (fun t ↦ CtrlNe.some (hWPal.ne
    (Fin.last 0) t)) (k6Mask24Bits dMask))).eval.1.mulVec (ket β₁)) = _
  have hβ₁W : β₁ (rW1 (Fin.last 0)) = 0 := by
    dsimp only [β₁]; rw [Function.update_of_ne hPW.symm, hW0]
  let valR : ZMod 2 := ∑ t : Fin 24, β₁ (rPal24 t) * k6Mask24Bits dMask t
  have hBr := branchMsbCircuit_eval_mulVec_ket_diag (m := 0) c (QRegister.singleton wPar) rW1
    hPW_disj (fun i ↦ by fin_cases i; exact hcP) hcW
    .identity
    (czFanoutCircuit (some (rW1 (Fin.last 0))) rPal24
      (fun t ↦ CtrlNe.some (hWPal.ne (Fin.last 0) t)) (k6Mask24Bits dMask))
    0 valR β₁ hβ₁W
    (fun a ↦ by simp)
    (fun a ↦ by
      rw [czFanoutCircuit_eval_mulVec_ket]
      refine congrArg (fun e : ZMod 2 ↦ ((-1 : ℂ) ^ e.val) •
        ket (Function.update β₁ (rW1 (Fin.last 0)) a)) ?_
      dsimp only [valR]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun t _ ↦ ?_
      dsimp only [ctrlVal]
      rw [Function.update_self, Function.update_of_ne (hWPal.ne (Fin.last 0) t).symm, mul_assoc])
  rw [hBr, Matrix.mulVec_smul, k6_xorMask64_ket rOH64 wPar hOHP sMask β₁ 64 (le_refl 64)]
  have hSumEq : k6_ohMaskSum sMask rOH64 β₁ 64 (le_refl 64) = sBit := k6_ohMaskSum_eq_of_apply
      sMask rOH64 β₁ β (fun sl ↦ Function.update_of_ne (hOHP sl) _ _) 64 (le_refl 64)
  have hRest :
      Function.update β₁ wPar (β₁ wPar + k6_ohMaskSum sMask rOH64 β₁ 64 (le_refl 64)) = β := by
    rw [hSumEq]
    dsimp only [β₁]
    rw [Function.update_self, Function.update_idem]
    have h0 : β wPar + sBit + sBit = β wPar := by
      rcases bit_cases (β wPar) with h1 | h1 <;>
        rcases bit_cases sBit with h2 | h2 <;>
        rw [h1, h2] <;> decide
    rw [h0, Function.update_eq_self]
  rw [hRest]
  have hCtrlEq : ctrlVal c β₁ = ctrlVal c β := by
    cases c with
    | none => rfl
    | some wCtrl =>
        dsimp only [ctrlVal, β₁]
        exact Function.update_of_ne (hcP wCtrl rfl) _ _
  have hValREq : valR = ∑ t : Fin 24, β (rPal24 t) * k6Mask24Bits dMask t := by
    refine Finset.sum_congr rfl fun t _ ↦ ?_
    dsimp only [β₁]
    rw [Function.update_of_ne (hPPal t).symm]
  have hParVal : β₁ ((QRegister.singleton wPar) (Fin.last 0)) = sBit := by
    change β₁ wPar = sBit
    dsimp only [β₁]
    rw [Function.update_self, hPar0, zero_add]
  rw [hCtrlEq, hParVal, hValREq, hsBit]
  refine congrArg (fun e : ZMod 2 ↦ ((-1 : ℂ) ^ e.val) • ket β) ?_
  refine congrArg (fun x : ZMod 2 ↦ ctrlVal c β * x) ?_
  have h10z : (1 : ZMod 2) ≠ 0 := by decide
  by_cases hs : k6BitNat sMask sel.val = true
  · simp only [hs, ↓reduceIte, h10z, one_mul]
    refine Finset.sum_congr rfl fun t _ ↦ ?_
    unfold k6Mask24Bits
    rfl
  · simp [hs]
def k6SubPalListPhaseCircuit {n : ℕ}
    (rOH64 : QRegister 64 n) (wPar : Wire n) (rPal24 : QRegister 24 n)
    (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar) :
    List (ℕ × ℕ) → (c : Option (Wire n)) → (rW1 : QRegister 1 n) →
    wPar ≠ rW1 (Fin.last 0) → rW1.DisjointWires rPal24 →
    CtrlNe c wPar → (∀ i, CtrlNe c (rW1 i)) → Circuit n
  | [], _, _, _, _, _, _ => .identity
  | (sMask, dMask) :: rest, c, rW1, hPW, hWPal, hcP, hcW =>
      k6_subPalStepCircuit rOH64 wPar rPal24 hOHP sMask dMask c rW1 hPW hWPal hcP hcW ;;ᶜ
        k6SubPalListPhaseCircuit rOH64 wPar rPal24 hOHP rest c rW1 hPW hWPal hcP hcW
theorem k6SubPalListPhaseCircuit_eval_mulVec_ket {n : ℕ} (rOH64 : QRegister 64 n)
    (wPar : Wire n) (rPal24 : QRegister 24 n) (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar)
    (hPPal : ∀ t : Fin 24, wPar ≠ rPal24 t) (gates : List (ℕ × ℕ)) (c : Option (Wire n))
    (rW1 : QRegister 1 n) (hPW : wPar ≠ rW1 (Fin.last 0)) (hWPal : rW1.DisjointWires rPal24)
    (hcP : CtrlNe c wPar) (hcW : ∀ i, CtrlNe c (rW1 i)) (sel : Fin 64) (β : BitAssignment n)
    (hPar0 : β wPar = 0) (hW0 : β (rW1 (Fin.last 0)) = 0)
    (hOH : ∀ sl : Fin 64, β (rOH64 sl) = if sl = sel then 1 else 0) :
    (k6SubPalListPhaseCircuit rOH64 wPar rPal24 hOHP gates c rW1 hPW hWPal hcP
    hcW).eval.1.mulVec (ket β) = ((-1 : ℂ) ^ (ctrlVal c β * ∑ t : Fin 24, β (rPal24 t) *
    k6SubGatesPalBit gates sel t).val) • ket β := by
  induction gates with
  | nil =>
      have h0 : ∀ t : Fin 24, k6SubGatesPalBit [] sel t = 0 := fun _ ↦ by
        unfold k6SubGatesPalBit; rfl
      simp [k6SubPalListPhaseCircuit, h0]
  | cons hd tl ih =>
      rcases hd with ⟨sMask, dMask⟩
      have hcons : ∀ t : Fin 24,
          k6SubGatesPalBit ((sMask, dMask) :: tl) sel t =
            (if k6BitNat sMask sel.val then (1 : ZMod 2) else 0) *
              (if k6BitNat dMask t.val then (1 : ZMod 2) else 0) +
            k6SubGatesPalBit tl sel t := fun _ ↦ by
        conv_lhs => unfold k6SubGatesPalBit
      dsimp only [k6SubPalListPhaseCircuit]
      rw [p2t_eval_seq_mulVec,
          k6_subPalStepCircuit_eval_mulVec_ket rOH64 wPar rPal24 hOHP hPPal sMask dMask
            c rW1 hPW hWPal hcP hcW sel β hPar0 hW0 hOH,
          Matrix.mulVec_smul, ih, smul_smul, ← neg_one_pow_zmod2_add]
      refine congrArg (fun e : ZMod 2 ↦ ((-1 : ℂ) ^ e.val) • ket β) ?_
      simp_rw [hcons, mul_add, Finset.sum_add_distrib, mul_add]
