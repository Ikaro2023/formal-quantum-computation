section BinaryTournamentSwap217
local instance (priority := 1000000) instNeZeroTwoPow_BinaryTournamentSwap217 (k : ℕ) :
    NeZero (2 ^ k) := ⟨(Nat.two_pow_pos k).ne'⟩

/-!
# 8-Level Binary-Tournament Swap Barrel (`15,960 T` One-Way = `31,920 T/step`, `213` Clean Wires)

Replaces the `9`-wire streaming binary-to-unary Babbush swap tree (`4,123` `TempAnd`s enabled) with
an `8`-level binary tournament network (`[109, 54, 27, 14, 7, 3, 2, 1]` = `217` `18`-bit `CSWAP`s =
`3,906` `TempAnd`s + `8` level-control `TempAnd`s = `3,914` `TempAnd`s) using `2` clean swap
scratch wires (`[C + 211 .. C + 213)` right after the `211`-wire `[C .. C + 211)` `76`-`TempAnd`
decoder, `213` clean workspace wires total), zero Toffoli gates, fully proved in Lean, and no
native-decide:
- Forward pass (`b = 0 .. 7`) routes initial electron `anc` into slot `0`
  (`tourSlotPerm anc 0 = anc`) while bijecting `{1 .. 217}` onto `{0 .. 217} \ {anc}`
  (`tourPartnerEquiv anc`).
- Reverse pass (`b = 7 .. 0`) realizes exact `(uBarrelTour hmPay)⁻¹` (`(tourSlotPerm anc).symm`).
- Paired with `tourDecoderCtx213` (`76` `TempAnd`s from `FastCoinBarrelDecoder279.progAll145`),
  `tourHoistedBarrelSpec145` is polymorphic over `{mPayload mWork : ℕ} (hmPay : 80 ≤ mPayload)
  (hmWork : 213 ≤ mWork)` (covering `mWork = 288, 248, 220` at `+0 T`) and achieves
  `tBarrel = 4 * (76 + 3914) = 15960` (`31,920 T/walk`, saving `-836 T` one-way / `-1,672 T/walk`
  vs `16,796 T` / `33,592 T/walk`).
-/

public section

section ConfigBinaryTournamentSwap217
set_option maxRecDepth 512

namespace BinaryTournamentSwap217

open Operator Matrix _root_.DynamicCircuit DynCircuitExt QProg
open scoped Matrix ComplexOrder MatrixOrder Circuit.Notation BigOperators

theorem nat_testBit_eq_div_mod : ∀ (k m : ℕ), m.testBit k = decide ((m / 2 ^ k) % 2 = 1)
  | 0, m => by
      cases htb : m.testBit 0 <;> simp [Nat.testBit_zero] at htb ⊢ <;> omega
  | k + 1, m => by
      change m.testBit (Nat.succ k) = _
      rw [Nat.testBit_succ, nat_testBit_eq_div_mod k (m / 2), Nat.div_div_eq_div_mul, ← pow_succ']

end BinaryTournamentSwap217

end ConfigBinaryTournamentSwap217
end
end BinaryTournamentSwap217

