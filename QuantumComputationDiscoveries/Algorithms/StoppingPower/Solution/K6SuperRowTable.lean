theorem k6_disjoint_concat_right {n k₁ k₂ k₃ : ℕ} {r₁ : QRegister k₁ n} {r₂ : QRegister k₂ n}
    {r₃ : QRegister k₃ n} (h₁₂ : r₁.DisjointWires r₂) (h₁₃ : r₁.DisjointWires r₃)
    (h₂₃ : r₂.DisjointWires r₃) : r₁.DisjointWires (r₂.concat r₃ h₂₃) := by
  rw [QRegister.disjoint_iff]
  intro i idx
  refine Fin.addCases (fun a ↦ ?_) (fun b ↦ ?_) idx
  · rw [QRegister.concat_apply_left]; exact h₁₂.ne i a
  · rw [QRegister.concat_apply_right]; exact h₁₃.ne i b
