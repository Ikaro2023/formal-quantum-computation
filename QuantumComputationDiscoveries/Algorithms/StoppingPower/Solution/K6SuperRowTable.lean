theorem k6_xResetKraus_mulVec_ket {k n : ℕ} (r : QRegister k n) (f : Fin k → Bool)
    (α : BitAssignment n) : (DynCircuitExt.xResetKraus r f).mulVec (ket α) = ((((√(1 / 2)) ^
    k : ℝ) : ℂ) * ∏ b : Fin k, if f b then (-1 : ℂ) ^ (α (r b)).val else 1) • ket
    (writeReg α r (fun _ ↦ 0)) := by
  let g := (basisBitsEquiv n).symm α
  have hgα : basisBits n g = α := (basisBitsEquiv n).apply_symm_apply α
  rw [p2t_ket_eq_single α, DynCircuitExt.xResetKraus_mulVec_single k r f g]
  refine congrArg₂ (· • ·) ?_ ?_
  · congr 1
    refine Finset.prod_congr rfl fun b _ ↦ ?_
    have hb : basisBits k (r.extractIndex g) b = α (r b) := by
      rw [QRegister.basisBits_extractIndex, hgα]
    rw [hb]
    cases f b <;> rcases bit_cases (α (r b)) with h | h <;> simp [h]
  · have hzero_symm : (basisBitsEquiv k).symm (fun _ : Fin k ↦ (0 : ZMod 2)) = 0 := by
      apply (basisBitsEquiv k).injective
      rw [(basisBitsEquiv k).apply_symm_apply]
      funext idx
      change _ = basisBits k (0 : Fin (2 ^ k)) idx
      simp [-Nat.reducePow, basisBits_eq_div_mod]
