  have h1 :=
    p2t_RealizesConstCleanUnitary_of_clean v (projZeroAll_conjTranspose m fProj) hConst hReal
  rw [p2t_projZeroAll_eq_ketPredProj] at h1
  have h2 := p2t_RealizesConstCleanUnitary_mono_proj (p2t_ketPredProj_conjTranspose _)
      (p2t_ketPredProj_conjTranspose _) (p2t_ketPredProj_mul_imp hClean) h1
