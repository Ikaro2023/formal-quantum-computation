theorem k6_validQromTree_weaken_rY {Var : Type} [Fintype Var] [DecidableEq Var]
    {n k w₁ w₂ : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rW : QRegister k n) (rY₁ : QRegister w₁ n) (rY₂ : QRegister w₂ n)
    (hImp : ∀ q : Wire n, (∀ j : Fin w₂, q ≠ rY₂ j) → (∀ i : Fin w₁, q ≠ rY₁ i))
    (cTree : Circuit n) (dTree : DynamicCircuit Var n)
    (h : ValidQromTree v rW rY₁ cTree dTree) :
    ValidQromTree v rW rY₂ cTree dTree where
