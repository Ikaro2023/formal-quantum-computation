def k6_xorMask64 {n : ℕ}
    (rOH64 : QRegister 64 n) (wPar : Wire n)
    (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar) (sMask : ℕ) :
    (m : ℕ) → (hm : m ≤ 64) → Circuit n
  | 0, _ => .identity
  | m + 1, hm =>
      let sl : Fin 64 := ⟨m, by omega⟩
      k6_xorMask64 rOH64 wPar hOHP sMask m (by omega) ;;ᶜ
        if k6BitNat sMask m then
          Circuit.CNOT (rOH64 sl) wPar (hOHP sl)
        else
          .identity
def k6_ohMaskSum {n : ℕ} (sMask : ℕ) (rOH64 : QRegister 64 n) (β : BitAssignment n) :
    (m : ℕ) → (hm : m ≤ 64) → ZMod 2
  | 0, _ => 0
  | m + 1, hm =>
      k6_ohMaskSum sMask rOH64 β m (by omega) +
        if k6BitNat sMask m then β (rOH64 ⟨m, by omega⟩) else 0
theorem k6_ohMaskSum_eq_of_apply {n : ℕ} (sMask : ℕ) (rOH64 : QRegister 64 n)
    (β₁ β₂ : BitAssignment n) (h : ∀ sl : Fin 64, β₁ (rOH64 sl) = β₂ (rOH64 sl)) :
    ∀ (m : ℕ) (hm : m ≤ 64), k6_ohMaskSum sMask rOH64 β₁ m hm = k6_ohMaskSum sMask rOH64 β₂ m hm
  | 0, _ => rfl
  | m + 1, hm => by
      dsimp only [k6_ohMaskSum]
      rw [k6_ohMaskSum_eq_of_apply sMask rOH64 β₁ β₂ h m (by omega), h ⟨m, by omega⟩]
theorem k6_ohMaskSum_oneHot {n : ℕ} (sMask : ℕ) (rOH64 : QRegister 64 n)
    (sel : Fin 64) (β : BitAssignment n)
    (hOH : ∀ sl : Fin 64, β (rOH64 sl) = if sl = sel then 1 else 0) :
    ∀ (m : ℕ) (hm : m ≤ 64),
      k6_ohMaskSum sMask rOH64 β m hm =
        if sel.val < m ∧ k6BitNat sMask sel.val then 1 else 0
  | 0, _ => by simp [k6_ohMaskSum]
  | m + 1, hm => by
      dsimp only [k6_ohMaskSum]
      rw [k6_ohMaskSum_oneHot sMask rOH64 sel β hOH m (by omega), hOH ⟨m, by omega⟩]
      by_cases hsl : (⟨m, by omega⟩ : Fin 64) = sel
      · subst hsl
        have hlt : m < m + 1 := by omega
        by_cases hb : k6BitNat sMask m <;> simp [hb, hlt]
      · have hne : sel.val ≠ m := fun h ↦ hsl (Fin.ext h.symm)
        have hiff : sel.val < m ↔ sel.val < m + 1 := by omega
        simp [hsl, hiff]
theorem k6_xorMask64_ket {n : ℕ}
    (rOH64 : QRegister 64 n) (wPar : Wire n)
    (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar) (sMask : ℕ) (β : BitAssignment n) :
    ∀ (m : ℕ) (hm : m ≤ 64),
      (k6_xorMask64 rOH64 wPar hOHP sMask m hm).eval.1.mulVec (ket β) =
        ket (Function.update β wPar (β wPar + k6_ohMaskSum sMask rOH64 β m hm))
  | 0, _ => by
      simp [k6_xorMask64, k6_ohMaskSum]
  | m + 1, hm => by
      dsimp only [k6_xorMask64, k6_ohMaskSum]
      rw [p2t_eval_seq_mulVec, k6_xorMask64_ket rOH64 wPar hOHP sMask β m (by omega)]
      split_ifs with hb
      · rw [p2t_ket_CNOT, Function.update_self, Function.update_idem,
            Function.update_of_ne (hOHP ⟨m, by omega⟩), add_assoc]
      · simp
