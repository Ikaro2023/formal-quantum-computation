    PreservesStoreConst d ∧ ∃ A : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ, (∀ M : Observable (Fin (2 ^
    n)), ∀ σ : Store Var, p2t_ketPredProj S * (wp d.compile (fun _ ↦ M) σ).1.1 *
    p2t_ketPredProj S = p2t_ketPredProj S * (Aᴴ * M.1.1 * A) * p2t_ketPredProj S) ∧ (∀ α :
    BitAssignment n, S α → A.mulVec (ket α) = phase α • ket (nextKet α))
theorem K6StageSpec.congr {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] {S : BitAssignment n → Prop} {d : DynamicCircuit Var n}
    {next₁ next₂ : BitAssignment n → BitAssignment n} {phase₁ phase₂ : BitAssignment n → ℂ}
