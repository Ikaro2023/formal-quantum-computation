  rcases bit_cases (β wRootCtrl) with hb | hb <;> rw [hb]
  · have hv0 : (0 : ZMod 2).val = 0 := rfl
    have h01 : (0 : ZMod 2) + 1 = 1 := rfl
    have hq0 : q_eff = 0 + prunedEffIdx 9 512 (k6_highIdx rX10 β) := by
      dsimp only [q_eff]
      rw [hb, hv0, zero_mul, add_zero, prunedEffIdx]
      simp only [hnle, hlt9, ↓reduceIte, zero_add]
      exact (prunedEffIdx_eq_self 9 512 _ (by decide) hlt9).symm
    rw [h01, one_mul, zero_mul, add_zero, hq0]
  · have hv1 : (1 : ZMod 2).val = 1 := rfl
    have h11 : (1 : ZMod 2) + 1 = 0 := rfl
    have hq1 : q_eff = 512 + prunedEffIdx 9 237 (k6_highIdx rX10 β) := by
      dsimp only [q_eff]
      rw [hb, hv1, one_mul, prunedEffIdx]
      have hnlt : ¬ (k6_highIdx rX10 β + 512 < 2 ^ 9) := by omega
      have hmod : (k6_highIdx rX10 β + 512) % 2 ^ 9 = k6_highIdx rX10 β := by
        change (k6_highIdx rX10 β + 2 ^ 9) % 2 ^ 9 = _
        rw [Nat.add_mod_right, Nat.mod_eq_of_lt hlt9]
      simp only [hnle, hnlt, ↓reduceIte, hmod]
      rfl
    rw [h11, zero_mul, one_mul, zero_add, hq1]
theorem k6LoadTreeCircuit_eval_mulVec_ket {n : ℕ}
    (rOH64 : QRegister 64 n) (wPar wRootCtrl : Wire n)
    (rX10 rWalk10 : QRegister (1 + 9) n)
    (rBuf1728 : QRegister 1728 n) (rPal24 : QRegister 24 n)
    (hBufPal : rBuf1728.DisjointWires rPal24)
    (hOHP : ∀ sl : Fin 64, rOH64 sl ≠ wPar)
    (hP_Buf : ∀ f : Fin 1728, wPar ≠ rBuf1728 f)
    (hPPal : ∀ t : Fin 24, wPar ≠ rPal24 t)
    (hOHW : rOH64.DisjointWires rWalk10)
    (hOHRoot : ∀ sl : Fin 64, rOH64 sl ≠ wRootCtrl)
    (hOHBuf : rOH64.DisjointWires rBuf1728)
    (hOHPal : rOH64.DisjointWires rPal24)
    (hXW : rX10.DisjointWires rWalk10) (hPW : ∀ i, wPar ≠ rWalk10 i)
    (hWBuf : rWalk10.DisjointWires rBuf1728) (hWPal : rWalk10.DisjointWires rPal24)
    (hXBuf : rX10.DisjointWires rBuf1728) (hXPal : rX10.DisjointWires rPal24)
    (hcX : ∀ i, wRootCtrl ≠ rX10 i) (hcP : wRootCtrl ≠ wPar)
    (hcW : ∀ i, wRootCtrl ≠ rWalk10 i) (hcBuf : ∀ f, wRootCtrl ≠ rBuf1728 f)
    (hcPal : ∀ t, wRootCtrl ≠ rPal24 t)
    (sel : Fin 64) (β : BitAssignment n)
    (hPar0 : β wPar = 0) (hclean : ∀ i, β (rWalk10 i) = 0)
    (hOH : ∀ sl : Fin 64, β (rOH64 sl) = if sl = sel then 1 else 0) :
    let rTarget := rBuf1728.concat rPal24 hBufPal
    let q_eff := prunedEffIdx 10 749 (k6_highIdx rX10 β + (β wRootCtrl).val * 512)
    (k6LoadTreeCircuit rOH64 wPar wRootCtrl rX10 rWalk10 rBuf1728 rPal24
      hBufPal hOHP hXW hPW hWBuf hWPal hcX hcP hcW hcBuf hcPal).eval.1.mulVec (ket β) =
      ket (writeReg β rTarget (fun idx ↦
        β (rTarget idx) + k6_leafTargetWord1752 q_eff sel idx)) := by
  intro rTarget q_eff
  have hWT : rWalk10.DisjointWires rTarget := k6_disjoint_concat_right hWBuf hWPal hBufPal
  have hXT : rX10.DisjointWires rTarget := k6_disjoint_concat_right hXBuf hXPal hBufPal
  have hOHT : rOH64.DisjointWires rTarget := k6_disjoint_concat_right hOHBuf hOHPal hBufPal
  have hPT : ∀ idx, wPar ≠ rTarget idx := by
    intro idx
    refine Fin.addCases (fun a ↦ ?_) (fun b ↦ ?_) idx
    · rw [QRegister.concat_apply_left]; exact hP_Buf a
    · rw [QRegister.concat_apply_right]; exact hPPal b
  have hRootT : ∀ idx, wRootCtrl ≠ rTarget idx := by
    intro idx
    refine Fin.addCases (fun a ↦ ?_) (fun b ↦ ?_) idx
    · rw [QRegister.concat_apply_left]; exact hcBuf a
    · rw [QRegister.concat_apply_right]; exact hcPal b
  have hEval : (k6LoadTreeCircuit rOH64 wPar wRootCtrl rX10 rWalk10 rBuf1728 rPal24 hBufPal hOHP
      hXW hPW hWBuf hWPal hcX hcP hcW hcBuf hcPal).eval.1 = (hadamardReg rTarget).eval.1 *
      (k6RootPhaseCircuit rOH64 wPar wRootCtrl rX10 rWalk10 rBuf1728 rPal24 hOHP hXW hPW hWBuf
      hWPal hcX hcP hcW hcBuf hcPal).eval.1 * (hadamardReg rTarget).eval.1 := by
    dsimp only [k6LoadTreeCircuit, rTarget]
    simp only [Circuit.eval_seq, Submonoid.coe_mul, Matrix.mul_assoc]
  rw [hEval]
  apply hadamardReg_conj_phase_mulVec_ket rTarget _ (k6_leafTargetWord1752 q_eff sel) β
  intro γ
  have hParγ : writeReg β rTarget γ wPar = 0 := by
    rw [writeReg_apply_of_not_mem β rTarget γ wPar (fun ⟨j, hj⟩ ↦ hPT j hj.symm), hPar0]
  have hCleanγ : ∀ i, writeReg β rTarget γ (rWalk10 i) = 0 := fun i ↦ by
    rw [writeReg_apply_of_not_mem β rTarget γ (rWalk10 i) (fun ⟨j, hj⟩ ↦ hWT.ne i j hj.symm),
        hclean i]
  have hOHγ : ∀ sl : Fin 64, writeReg β rTarget γ (rOH64 sl) = if sl = sel then 1 else 0 :=
    fun sl ↦ by
      rw [writeReg_apply_of_not_mem β rTarget γ (rOH64 sl) (fun ⟨j, hj⟩ ↦ hOHT.ne sl j hj.symm),
          hOH sl]
  have hHiγ : k6_highIdx rX10 (writeReg β rTarget γ) = k6_highIdx rX10 β :=
    k6_highIdx_eq_of_apply rX10 _ _ fun i ↦
      writeReg_apply_of_not_mem β rTarget γ (rX10 i) (fun ⟨j, hj⟩ ↦ hXT.ne i j hj.symm)
  have hRootγ : writeReg β rTarget γ wRootCtrl = β wRootCtrl :=
    writeReg_apply_of_not_mem β rTarget γ wRootCtrl (fun ⟨j, hj⟩ ↦ hRootT j hj.symm)
  rw [k6RootPhaseCircuit_eval_mulVec_ket rOH64 wPar wRootCtrl rX10 rWalk10 rBuf1728 rPal24
        hOHP hPPal hOHW hOHRoot hXW hPW hWBuf hWPal hcX hcP hcW hcBuf hcPal
        sel (writeReg β rTarget γ) hParγ hCleanγ hOHγ]
  rw [hHiγ, hRootγ]
  refine congrArg (fun e : ZMod 2 ↦ ((-1 : ℂ) ^ e.val) • ket (writeReg β rTarget γ)) ?_
  rw [Fin.sum_univ_add]
  refine congrArg₂ (· + ·) ?_ ?_
  · refine Finset.sum_congr rfl fun f _ ↦ ?_
    have h1 : rTarget (Fin.castAdd 24 f) = rBuf1728 f := QRegister.concat_apply_left _ _ _ _
    rw [← h1, writeReg_apply_reg]
    dsimp [k6_leafTargetWord1752, q_eff]
    simp [f.isLt]
  · refine Finset.sum_congr rfl fun t _ ↦ ?_
    have h2 : rTarget (Fin.natAdd 1728 t) = rPal24 t := QRegister.concat_apply_right _ _ _ _
    rw [← h2, writeReg_apply_reg]
    dsimp [k6_leafTargetWord1752, q_eff]
    have hge : ¬ (1728 + t.val < 1728) := by omega
    simp [hge]
def k6_oneHot4Val (p0 p1 : ZMod 2) : Fin 4 → ZMod 2
  | ⟨0, _⟩ => (1 + p0) * (1 + p1)
  | ⟨1, _⟩ => p0 * (1 + p1)
  | ⟨2, _⟩ => (1 + p0) * p1
  | ⟨3, _⟩ => p0 * p1
def k6_cOneHot4Raw {n : ℕ} (rP2 : QRegister 2 n) (rOH4 : QRegister 4 n)
    (hPOH : rP2.DisjointWires rOH4) : Circuit n :=
  have h01 : rP2 0 ≠ rP2 1 := rP2.wires.injective.ne (by decide)
  have h31 : rOH4 3 ≠ rOH4 1 := rOH4.wires.injective.ne (by decide)
  have h32 : rOH4 3 ≠ rOH4 2 := rOH4.wires.injective.ne (by decide)
  have h30 : rOH4 3 ≠ rOH4 0 := rOH4.wires.injective.ne (by decide)
  Circuit.TOFF (rP2 0) (rP2 1) (rOH4 3) h01 (hPOH.ne 0 3) (hPOH.ne 1 3) ;;ᶜ
  Circuit.CNOT (rP2 0) (rOH4 1) (hPOH.ne 0 1) ;;ᶜ
  Circuit.CNOT (rOH4 3) (rOH4 1) h31 ;;ᶜ
  Circuit.CNOT (rP2 1) (rOH4 2) (hPOH.ne 1 2) ;;ᶜ
  Circuit.CNOT (rOH4 3) (rOH4 2) h32 ;;ᶜ
  Circuit.X (rOH4 0) ;;ᶜ
  Circuit.CNOT (rP2 0) (rOH4 0) (hPOH.ne 0 0) ;;ᶜ
  Circuit.CNOT (rP2 1) (rOH4 0) (hPOH.ne 1 0) ;;ᶜ
  Circuit.CNOT (rOH4 3) (rOH4 0) h30
theorem k6_cOneHot4Raw_not_mem_support {n : ℕ} (wAnc : Wire n) (rP2 : QRegister 2 n)
    (rOH4 : QRegister 4 n) (hPOH : rP2.DisjointWires rOH4) (hAncP : ∀ i : Fin 2, wAnc ≠ rP2 i)
    (hAncOH : ∀ k : Fin 4, wAnc ≠ rOH4 k) : wAnc ∉ (k6_cOneHot4Raw rP2 rOH4 hPOH).support
    := by
  dsimp only [k6_cOneHot4Raw]
  simp [Circuit.TOFF, Circuit.CNOT, Circuit.X,
    hAncP 0, hAncP 1, hAncOH 0, hAncOH 1, hAncOH 2, hAncOH 3]
theorem k6_cOneHot4Raw_counts {n : ℕ} (rP2 : QRegister 2 n) (rOH4 : QRegister 4 n)
    (hPOH : rP2.DisjointWires rOH4) : (k6_cOneHot4Raw rP2 rOH4 hPOH).count PrimitiveGate.T = 0
    ∧ (k6_cOneHot4Raw rP2 rOH4 hPOH).count PrimitiveGate.TOFF = 1 := by
  refine ⟨?_, ?_⟩
  · simp [k6_cOneHot4Raw, Circuit.TOFF, Circuit.CNOT, Circuit.X,
      Circuit.single, Circuit.count]
  · simp [k6_cOneHot4Raw, Circuit.TOFF, Circuit.CNOT, Circuit.X,
      Circuit.single, Circuit.count]
theorem k6_cOneHot4Raw_ket {n : ℕ} (rP2 : QRegister 2 n) (rOH4 : QRegister 4 n)
    (hPOH : rP2.DisjointWires rOH4) (β : BitAssignment n) (hOH0 : ∀ k : Fin 4, β (rOH4 k) = 0)
    : (k6_cOneHot4Raw rP2 rOH4 hPOH).eval.1.mulVec (ket β) = ket
    (writeReg β rOH4 (k6_oneHot4Val (β (rP2 0)) (β (rP2 1)))) := by
  have hUpd (f : BitAssignment n) (j i : Fin 4) (v : ZMod 2) :
      Function.update f (rOH4 j) v (rOH4 i) = if i = j then v else f (rOH4 i) := by
    simp only [Function.update_apply, rOH4.wires.injective.eq_iff]
  have hUpdP (f : BitAssignment n) (j : Fin 4) (i : Fin 2) (v : ZMod 2) :
      Function.update f (rOH4 j) v (rP2 i) = f (rP2 i) := by
    simp only [Function.update_of_ne (hPOH.ne i j)]
  dsimp only [k6_cOneHot4Raw]
  simp only [p2t_eval_seq_mulVec, p2t_ket_TOFF, p2t_ket_CNOT, p2t_ket_X]
  refine congrArg ket (funext fun w ↦ ?_)
  by_cases hw : w ∈ Set.range rOH4.wires
  · obtain ⟨k, rfl⟩ := hw
    rw [writeReg_apply_reg]
    simp only [hUpd, hUpdP, hOH0]
    generalize β (rP2 0) = p0, β (rP2 1) = p1
    revert p0 p1 k
    decide
  · have hne (j : Fin 4) : w ≠ rOH4 j := fun h ↦ hw ⟨j, h.symm⟩
    simp only [Function.update_of_ne (hne 0), Function.update_of_ne (hne 1),
      Function.update_of_ne (hne 2), Function.update_of_ne (hne 3),
      writeReg_apply_of_not_mem β rOH4 _ w hw]
def k6_cPhaseMux4Col {n : ℕ} (z : Wire n) (rOH4 : QRegister 4 n) (y1 y2 y3 : Wire n)
    (hOHz : ∀ k : Fin 4, rOH4 k ≠ z) (hy1z : y1 ≠ z) (hy2z : y2 ≠ z) (hy3z : y3 ≠ z) : Circuit
    n :=
  Circuit.H z ;;ᶜ
  p2t_oneHotBitStep z (rOH4 1) y1 (hOHz 1) hy1z ;;ᶜ
  p2t_oneHotBitStep z (rOH4 2) y2 (hOHz 2) hy2z ;;ᶜ
  p2t_oneHotBitStep z (rOH4 3) y3 (hOHz 3) hy3z ;;ᶜ
  p2t_oneHotBoundaryFix z (rOH4 0) (hOHz 0) ;;ᶜ
  Circuit.H z ;;ᶜ
  Circuit.S z
theorem k6_cPhaseMux4Col_count_toff {n : ℕ} (z : Wire n) (rOH4 : QRegister 4 n)
    (y1 y2 y3 : Wire n) (hOHz : ∀ k : Fin 4, rOH4 k ≠ z) (hy1z : y1 ≠ z) (hy2z : y2 ≠ z)
    (hy3z : y3 ≠ z) : (k6_cPhaseMux4Col z rOH4 y1 y2 y3 hOHz hy1z hy2z hy3z).count
    PrimitiveGate.TOFF = 0 := by
  simp [k6_cPhaseMux4Col, Circuit.H, Circuit.S, Circuit.single, Circuit.count,
    p2t_oneHotBitStep_count_toff, p2t_oneHotBoundaryFix_count_toff]
theorem k6_cPhaseMux4Col_count_t {n : ℕ} (z : Wire n) (rOH4 : QRegister 4 n)
    (y1 y2 y3 : Wire n) (hOHz : ∀ k : Fin 4, rOH4 k ≠ z) (hy1z : y1 ≠ z) (hy2z : y2 ≠ z)
    (hy3z : y3 ≠ z) : (k6_cPhaseMux4Col z rOH4 y1 y2 y3 hOHz hy1z hy2z hy3z).count
    PrimitiveGate.T = 8 := by
  simp only[k6_cPhaseMux4Col, Circuit.count_seq, p2t_oneHotBitStep_count_t,
      p2t_oneHotBoundaryFix_count_t, Circuit.H, Circuit.S, Circuit.single, Circuit.count]
  rfl
theorem k6_cPhaseMux4Col_ket {n : ℕ} (z : Wire n) (rOH4 : QRegister 4 n) (y1 y2 y3 : Wire n)
    (hOHz : ∀ k : Fin 4, rOH4 k ≠ z) (hy1z : y1 ≠ z) (hy2z : y2 ≠ z) (hy3z : y3 ≠ z)
    (p0 p1 : ZMod 2) (β : BitAssignment n) (hβz : β z = 0)
    (hOH : ∀ k : Fin 4, β (rOH4 k) = k6_oneHot4Val p0 p1 k) :
    (k6_cPhaseMux4Col z rOH4 y1 y2 y3 hOHz hy1z hy2z hy3z).eval.1.mulVec (ket β) = ket
    (Function.update β z (p0 * (1 + p1) * β y1 + (1 + p0) * p1 * β y2 + p0 * p1 * β y3)) := by
  let g0 := Function.update β z 0
  let g1 := Function.update β z 1
  have hg0z : g0 z = 0 := Function.update_self _ _ _
  have hg1z : g1 z = 1 := Function.update_self _ _ _
  have hg00 : Function.update g0 z 0 = g0 := Function.update_idem _ _ _
  have hg01 : Function.update g0 z 1 = g1 := Function.update_idem _ _ _
  have hg10 : Function.update g1 z 0 = g0 := Function.update_idem _ _ _
  have hg11 : Function.update g1 z 1 = g1 := Function.update_idem _ _ _
  have hAfterH0 : (Circuit.H z).eval.1.mulVec (sqrtHalf • (ket g0 + ket g1)) = ket g0 := by
    simp only [Matrix.mulVec_smul, Matrix.mulVec_add, p2t_ket_H,
      hg0z, hg1z, hg00, hg01, hg10, hg11]
    ext idx; simp [bitSign]
    linear_combination (ket g0 idx) * p2t_sqrtHalf_mul_self_two
  have hFinish : ∀ b : ZMod 2, (Circuit.S z).eval.1.mulVec ((Circuit.H z).eval.1.mulVec
      (sqrtHalf • ((p2t_diagTPhase b * p2t_boundTPhase 0) • ket g0 + (p2t_diagTPhase (1 + b) *
      p2t_boundTPhase 1) • ket g1))) = ket (Function.update β z b) := by
    intro b
    rcases bit_cases b with hb | hb <;> rw [hb]
    · rw [show p2t_diagTPhase 0 = p2t_diagTPhase (0 + 0) from rfl,
          p2t_diagTPhase_zero_mul_bound 0, p2t_diagTPhase_zero_mul_bound 1]
      simp only [one_smul, hAfterH0, p2t_ket_S, hg0z, ↓reduceIte]
      rfl
    · rw [show p2t_diagTPhase 1 = p2t_diagTPhase (0 + 1) from rfl,
          p2t_diagTPhase_one_mul_bound 0, p2t_diagTPhase_one_mul_bound 1]
      have hAfterH1 : (Circuit.H z).eval.1.mulVec (sqrtHalf • (((-Complex.I) * bitSign 0) •
          ket g0 + ((-Complex.I) * bitSign 1) • ket g1)) = (-Complex.I) • ket g1 := by
        simp only [Matrix.mulVec_smul, Matrix.mulVec_add, p2t_ket_H,
          hg0z, hg1z, hg00, hg01, hg10, hg11]
        ext idx; simp [bitSign]
        linear_combination (-Complex.I * ket g1 idx) * p2t_sqrtHalf_mul_self_two
      rw [hAfterH1, Matrix.mulVec_smul, p2t_ket_S, hg1z, smul_smul]
      have hI : (-Complex.I) * Complex.I = (1 : ℂ) := by
        calc (-Complex.I) * Complex.I = -(Complex.I ^ 2) := by ring
          _ = 1 := by rw [Complex.I_sq]; ring
      simp only [one_ne_zero, ↓reduceIte, hI, one_smul]
      rfl
  have hg0OH : ∀ k : Fin 4, g0 (rOH4 k) = k6_oneHot4Val p0 p1 k := fun k ↦ by
    dsimp [g0]; rw [Function.update_of_ne (hOHz k), hOH k]
  have hg1OH : ∀ k : Fin 4, g1 (rOH4 k) = k6_oneHot4Val p0 p1 k := fun k ↦ by
    dsimp [g1]; rw [Function.update_of_ne (hOHz k), hOH k]
  have hy0 : g0 y1 = β y1 ∧ g0 y2 = β y2 ∧ g0 y3 = β y3 :=
    ⟨Function.update_of_ne hy1z _ _, Function.update_of_ne hy2z _ _, Function.update_of_ne hy3z _ _⟩
  have hy1 : g1 y1 = β y1 ∧ g1 y2 = β y2 ∧ g1 y3 = β y3 :=
    ⟨Function.update_of_ne hy1z _ _, Function.update_of_ne hy2z _ _, Function.update_of_ne hy3z _ _⟩
  dsimp only [k6_cPhaseMux4Col]
  simp only [p2t_eval_seq_mulVec]
  rw [p2t_ket_H z β, hβz]
  change (Circuit.S z).eval.1.mulVec ((Circuit.H z).eval.1.mulVec ((p2t_oneHotBoundaryFix z
    (rOH4 0) (hOHz 0)).eval.1.mulVec ((p2t_oneHotBitStep z (rOH4 3) y3 (hOHz 3)
    hy3z).eval.1.mulVec ((p2t_oneHotBitStep z (rOH4 2) y2 (hOHz 2) hy2z).eval.1.mulVec
    ((p2t_oneHotBitStep z (rOH4 1) y1 (hOHz 1) hy1z).eval.1.mulVec (sqrtHalf • (ket g0 +
    bitSign 0 • ket g1))))))) = _
  have hInner : (p2t_oneHotBoundaryFix z (rOH4 0) (hOHz 0)).eval.1.mulVec ((p2t_oneHotBitStep
      z (rOH4 3) y3 (hOHz 3) hy3z).eval.1.mulVec ((p2t_oneHotBitStep z (rOH4 2) y2 (hOHz 2)
      hy2z).eval.1.mulVec ((p2t_oneHotBitStep z (rOH4 1) y1 (hOHz 1) hy1z).eval.1.mulVec
      (sqrtHalf • (ket g0 + bitSign 0 • ket g1))))) = sqrtHalf • (((((if k6_oneHot4Val p0 p1 1
      = 0 then (1 : ℂ) else p2t_diagTPhase (0 + β y1)) * (if k6_oneHot4Val p0 p1 2 = 0 then (1
      : ℂ) else p2t_diagTPhase (0 + β y2))) * (if k6_oneHot4Val p0 p1 3 = 0 then (1 : ℂ) else
      p2t_diagTPhase (0 + β y3))) * (if k6_oneHot4Val p0 p1 0 = 0 then p2t_boundTPhase 0 else
      1)) • ket g0 + ((((if k6_oneHot4Val p0 p1 1 = 0 then (1 : ℂ) else p2t_diagTPhase (1 + β
      y1)) * (if k6_oneHot4Val p0 p1 2 = 0 then (1 : ℂ) else p2t_diagTPhase (1 + β y2))) * (if
      k6_oneHot4Val p0 p1 3 = 0 then (1 : ℂ) else p2t_diagTPhase (1 + β y3))) * (if
      k6_oneHot4Val p0 p1 0 = 0 then p2t_boundTPhase 1 else 1)) • ket g1) := by
    simp only[bitSign, ↓reduceIte, one_smul, Matrix.mulVec_smul, Matrix.mulVec_add,
        p2t_oneHotBitStep_ket, p2t_oneHotBoundaryFix_ket, smul_smul, hg0z, hg1z, hg0OH 0,
        hg0OH 1, hg0OH 2, hg0OH 3, hg1OH 0, hg1OH 1, hg1OH 2, hg1OH 3, hy0.1, hy0.2.1,
        hy0.2.2, hy1.1, hy1.2.1, hy1.2.2]
  rw [hInner]
  have h10 : (1 : ZMod 2) ≠ 0 := by decide
  have h00a : (0 : ZMod 2) + 0 = 0 := rfl
  have h10a : (1 : ZMod 2) + 0 = 1 := rfl
  have h11a : (1 : ZMod 2) + 1 = 0 := rfl
  rcases bit_cases p0 with hp0 | hp0 <;> rcases bit_cases p1 with hp1 | hp1 <;> rw [hp0, hp1]
  · simp only [k6_oneHot4Val, h00a, h10a, mul_zero, zero_mul,
      h10, ↓reduceIte, mul_one, one_smul, hAfterH0, p2t_ket_S, hg0z]
    rfl
  · simp only [k6_oneHot4Val, h10a, h11a, mul_zero, zero_mul, one_mul, mul_one,
      zero_add, add_zero, h10, ↓reduceIte]
    exact hFinish (β y2)
  · simp only [k6_oneHot4Val, h10a, h11a, mul_zero, zero_mul, one_mul, mul_one,
      zero_add, add_zero, h10, ↓reduceIte]
    exact hFinish (β y1)
  · simp only [k6_oneHot4Val, h00a, h11a, mul_zero, zero_mul, one_mul, mul_one,
      zero_add, h10, ↓reduceIte]
    exact hFinish (β y3)
def k6_cPhaseMux4All6Raw {n : ℕ}
    (rOH4 : QRegister 4 n) (rPal18 : QRegister 18 n) (rDiff6 : QRegister 6 n)
    (hOHD : rOH4.DisjointWires rDiff6)
    (hPalD : rPal18.DisjointWires rDiff6) :
    (m : ℕ) → (hm : m ≤ 6) → Circuit n
  | 0, _ => .identity
  | m + 1, hm =>
      let j : Fin 6 := ⟨m, by omega⟩
      let i1 : Fin 18 := ⟨m, by omega⟩
      let i2 : Fin 18 := ⟨6 + m, by omega⟩
      let i3 : Fin 18 := ⟨12 + m, by omega⟩
      k6_cPhaseMux4All6Raw rOH4 rPal18 rDiff6 hOHD hPalD m (by omega) ;;ᶜ
        k6_cPhaseMux4Col (rDiff6 j) rOH4 (rPal18 i1) (rPal18 i2) (rPal18 i3)
          (fun k ↦ hOHD.ne k j) (hPalD.ne i1 j) (hPalD.ne i2 j) (hPalD.ne i3 j)
theorem k6_cPhaseMux4All6Raw_count_toff {n : ℕ}
    (rOH4 : QRegister 4 n) (rPal18 : QRegister 18 n) (rDiff6 : QRegister 6 n)
    (hOHD : rOH4.DisjointWires rDiff6)
    (hPalD : rPal18.DisjointWires rDiff6) :
    ∀ (m : ℕ) (hm : m ≤ 6),
      (k6_cPhaseMux4All6Raw rOH4 rPal18 rDiff6 hOHD hPalD m hm).count PrimitiveGate.TOFF = 0
  | 0, _ => rfl
  | m + 1, hm => by
      simp [k6_cPhaseMux4All6Raw, Circuit.count_seq, k6_cPhaseMux4Col_count_toff,
        k6_cPhaseMux4All6Raw_count_toff rOH4 rPal18 rDiff6 hOHD hPalD m (by omega)]
theorem k6_cPhaseMux4All6Raw_count_t {n : ℕ}
    (rOH4 : QRegister 4 n) (rPal18 : QRegister 18 n) (rDiff6 : QRegister 6 n)
    (hOHD : rOH4.DisjointWires rDiff6)
    (hPalD : rPal18.DisjointWires rDiff6) :
    ∀ (m : ℕ) (hm : m ≤ 6),
