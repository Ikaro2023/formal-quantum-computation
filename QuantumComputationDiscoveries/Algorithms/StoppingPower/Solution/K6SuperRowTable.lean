        k6_cPhaseMux4All6Raw_count_t rOH4 rPal18 rDiff6 hOHD hPalD m (by omega)]
      omega
theorem k6_cPhaseMux4All6Raw_ket {n : ℕ}
    (rOH4 : QRegister 4 n) (rPal18 : QRegister 18 n) (rDiff6 : QRegister 6 n)
    (hOHD : rOH4.DisjointWires rDiff6)
    (hPalD : rPal18.DisjointWires rDiff6)
    (p0 p1 : ZMod 2) (β : BitAssignment n)
    (hD0 : ∀ j : Fin 6, β (rDiff6 j) = 0)
    (hOH : ∀ k : Fin 4, β (rOH4 k) = k6_oneHot4Val p0 p1 k) :
    (k6_cPhaseMux4All6Raw rOH4 rPal18 rDiff6 hOHD hPalD 6 (le_refl 6)).eval.1.mulVec (ket β) =
      ket (writeReg β rDiff6 (fun j ↦
        p0 * (1 + p1) * β (rPal18 ⟨j.val, by omega⟩) +
        (1 + p0) * p1 * β (rPal18 ⟨6 + j.val, by omega⟩) +
        p0 * p1 * β (rPal18 ⟨12 + j.val, by omega⟩))) := by
  have haux : ∀ (m : ℕ) (hm : m ≤ 6),
      (k6_cPhaseMux4All6Raw rOH4 rPal18 rDiff6 hOHD hPalD m hm).eval.1.mulVec (ket β) =
        ket (writeReg β rDiff6 (fun j ↦
          if j.val < m then
            p0 * (1 + p1) * β (rPal18 ⟨j.val, by omega⟩) +
            (1 + p0) * p1 * β (rPal18 ⟨6 + j.val, by omega⟩) +
            p0 * p1 * β (rPal18 ⟨12 + j.val, by omega⟩)
          else 0)) := by
    intro m hm
    induction m with
    | zero =>
        simp only [k6_cPhaseMux4All6Raw, Circuit.eval_identity, Submonoid.coe_one,
          Matrix.one_mulVec]
        refine congrArg ket (funext fun w ↦ ?_)
        by_cases hw : w ∈ Set.range rDiff6.wires
        · obtain ⟨j, rfl⟩ := hw; rw [writeReg_apply_reg]; simp [hD0 j]
        · exact (writeReg_apply_of_not_mem β rDiff6 _ w hw).symm
    | succ m ih =>
        rw [k6_cPhaseMux4All6Raw, p2t_eval_seq_mulVec, ih (by omega)]
        let jm : Fin 6 := ⟨m, by omega⟩
        let i1 : Fin 18 := ⟨m, by omega⟩
        let i2 : Fin 18 := ⟨6 + m, by omega⟩
        let i3 : Fin 18 := ⟨12 + m, by omega⟩
        let βm := writeReg β rDiff6 (fun j ↦
          if j.val < m then
            p0 * (1 + p1) * β (rPal18 ⟨j.val, by omega⟩) +
            (1 + p0) * p1 * β (rPal18 ⟨6 + j.val, by omega⟩) +
            p0 * p1 * β (rPal18 ⟨12 + j.val, by omega⟩)
          else 0)
        have hβmz : βm (rDiff6 jm) = 0 := by
          dsimp [βm, jm]; rw [writeReg_apply_reg]; simp
        have hβmOH : ∀ k : Fin 4, βm (rOH4 k) = k6_oneHot4Val p0 p1 k := fun k ↦ by
          dsimp [βm]
          rw [writeReg_apply_of_not_mem β rDiff6 _ (rOH4 k) (fun ⟨j, hj⟩ ↦ hOHD.ne k j hj.symm),
              hOH k]
        have hβmP1 : βm (rPal18 i1) = β (rPal18 i1) :=
          writeReg_apply_of_not_mem β rDiff6 _ _ (fun ⟨j, hj⟩ ↦ hPalD.ne i1 j hj.symm)
        have hβmP2 : βm (rPal18 i2) = β (rPal18 i2) :=
          writeReg_apply_of_not_mem β rDiff6 _ _ (fun ⟨j, hj⟩ ↦ hPalD.ne i2 j hj.symm)
        have hβmP3 : βm (rPal18 i3) = β (rPal18 i3) :=
          writeReg_apply_of_not_mem β rDiff6 _ _ (fun ⟨j, hj⟩ ↦ hPalD.ne i3 j hj.symm)
        rw [k6_cPhaseMux4Col_ket (rDiff6 jm) rOH4 (rPal18 i1) (rPal18 i2) (rPal18 i3)
              (fun k ↦ hOHD.ne k jm) (hPalD.ne i1 jm) (hPalD.ne i2 jm) (hPalD.ne i3 jm)
              p0 p1 βm hβmz hβmOH,
            hβmP1, hβmP2, hβmP3]
        refine congrArg ket (funext fun w ↦ ?_)
        by_cases hw : w ∈ Set.range rDiff6.wires
        · obtain ⟨j, rfl⟩ := hw
          by_cases hjj : j = jm
          · subst hjj
            rw [Function.update_self, writeReg_apply_reg]
            have hlt : jm.val < m + 1 := by dsimp [jm]; omega
            simp [hlt, jm, i1, i2, i3]
          · rw [Function.update_of_ne (rDiff6.wires.injective.ne hjj)]
            dsimp [βm]
            rw [writeReg_apply_reg, writeReg_apply_reg]
            have hne : j.val ≠ m := fun h ↦ hjj (Fin.ext h)
            have hiff : j.val < m ↔ j.val < m + 1 := by omega
            simp [hiff]
        · have hneJ : w ≠ rDiff6 jm := fun h ↦ hw ⟨jm, h.symm⟩
          rw [Function.update_of_ne hneJ]
          dsimp [βm]
          rw [writeReg_apply_of_not_mem β rDiff6 _ w hw,
              writeReg_apply_of_not_mem β rDiff6 _ w hw]
  rw [haux 6 (le_refl 6)]
  refine congrArg ket (funext fun w ↦ ?_)
  by_cases hw : w ∈ Set.range rDiff6.wires
  · obtain ⟨j, rfl⟩ := hw
    rw [writeReg_apply_reg, writeReg_apply_reg]; simp [j.isLt]
  · rw[writeReg_apply_of_not_mem β rDiff6 _ w hw, writeReg_apply_of_not_mem β rDiff6 _ w hw]
def k6_cXorDiffTop6Raw {n : ℕ}
    (rDiff6 : QRegister 6 n) (rOutBTop6 : QRegister 6 n)
    (hDT : rDiff6.DisjointWires rOutBTop6) :
    (m : ℕ) → (hm : m ≤ 6) → Circuit n
  | 0, _ => .identity
  | m + 1, hm =>
      let j : Fin 6 := ⟨m, by omega⟩
      k6_cXorDiffTop6Raw rDiff6 rOutBTop6 hDT m (by omega) ;;ᶜ
        Circuit.CNOT (rDiff6 j) (rOutBTop6 j) (hDT.ne j j)
theorem k6_cXorDiffTop6Raw_count_toff {n : ℕ}
    (rDiff6 : QRegister 6 n) (rOutBTop6 : QRegister 6 n)
    (hDT : rDiff6.DisjointWires rOutBTop6) :
    ∀ (m : ℕ) (hm : m ≤ 6),
      (k6_cXorDiffTop6Raw rDiff6 rOutBTop6 hDT m hm).count PrimitiveGate.TOFF = 0
  | 0, _ => rfl
  | m + 1, hm => by
      simp [k6_cXorDiffTop6Raw, Circuit.CNOT,
        k6_cXorDiffTop6Raw_count_toff rDiff6 rOutBTop6 hDT m (by omega)]
theorem k6_cXorDiffTop6Raw_count_t {n : ℕ}
    (rDiff6 : QRegister 6 n) (rOutBTop6 : QRegister 6 n)
    (hDT : rDiff6.DisjointWires rOutBTop6) :
    ∀ (m : ℕ) (hm : m ≤ 6),
      (k6_cXorDiffTop6Raw rDiff6 rOutBTop6 hDT m hm).count PrimitiveGate.T = 0
  | 0, _ => rfl
  | m + 1, hm => by
      simp [k6_cXorDiffTop6Raw, Circuit.CNOT,
        k6_cXorDiffTop6Raw_count_t rDiff6 rOutBTop6 hDT m (by omega)]
theorem k6_cXorDiffTop6Raw_ket {n : ℕ} (rDiff6 : QRegister 6 n) (rOutBTop6 : QRegister 6 n)
    (hDT : rDiff6.DisjointWires rOutBTop6) (β : BitAssignment n) : (k6_cXorDiffTop6Raw rDiff6
    rOutBTop6 hDT 6 (le_refl 6)).eval.1.mulVec (ket β) = ket
    (writeReg β rOutBTop6 (fun j ↦ β (rOutBTop6 j) + β (rDiff6 j))) := by
  have haux : ∀ (m : ℕ) (hm : m ≤ 6),
      (k6_cXorDiffTop6Raw rDiff6 rOutBTop6 hDT m hm).eval.1.mulVec (ket β) =
        ket (writeReg β rOutBTop6 (fun j ↦
          if j.val < m then β (rOutBTop6 j) + β (rDiff6 j) else β (rOutBTop6 j))) := by
    intro m hm
    induction m with
    | zero =>
        simp only [k6_cXorDiffTop6Raw, Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec]
        refine congrArg ket (funext fun w ↦ ?_)
        by_cases hw : w ∈ Set.range rOutBTop6.wires
        · obtain ⟨j, rfl⟩ := hw; rw [writeReg_apply_reg]; simp
        · exact (writeReg_apply_of_not_mem β rOutBTop6 _ w hw).symm
    | succ m ih =>
        let jm : Fin 6 := ⟨m, by omega⟩
        let βm := writeReg β rOutBTop6 (fun j ↦
          if j.val < m then β (rOutBTop6 j) + β (rDiff6 j) else β (rOutBTop6 j))
        rw [k6_cXorDiffTop6Raw, p2t_eval_seq_mulVec, ih (by omega), p2t_ket_CNOT]
        change ket (Function.update βm (rOutBTop6 jm) (βm (rOutBTop6 jm) + βm (rDiff6 jm))) = _
        have hDj : βm (rDiff6 jm) = β (rDiff6 jm) :=
          writeReg_apply_of_not_mem β rOutBTop6 _ _ (fun ⟨j, hj⟩ ↦ hDT.ne jm j hj.symm)
        have hTj : βm (rOutBTop6 jm) = β (rOutBTop6 jm) := by
          dsimp [βm, jm]; rw [writeReg_apply_reg]; simp
        rw [hDj, hTj]
        refine congrArg ket (funext fun w ↦ ?_)
        by_cases hw : w ∈ Set.range rOutBTop6.wires
        · obtain ⟨j, rfl⟩ := hw
          by_cases hjj : j = jm
          · subst hjj
            rw [Function.update_self, writeReg_apply_reg]
            have hlt : jm.val < m + 1 := by dsimp [jm]; omega
            simp [hlt, jm]
          · rw [Function.update_of_ne (rOutBTop6.wires.injective.ne hjj)]
            dsimp [βm]
            rw [writeReg_apply_reg, writeReg_apply_reg]
            have hne : j.val ≠ m := fun h ↦ hjj (Fin.ext h)
            have hiff : j.val < m ↔ j.val < m + 1 := by omega
            simp [hiff]
        · have hneJ : w ≠ rOutBTop6 jm := fun h ↦ hw ⟨jm, h.symm⟩
          rw [Function.update_of_ne hneJ]
          dsimp [βm]
          rw [writeReg_apply_of_not_mem β rOutBTop6 _ w hw,
              writeReg_apply_of_not_mem β rOutBTop6 _ w hw]
  rw [haux 6 (le_refl 6)]
  refine congrArg ket (funext fun w ↦ ?_)
  by_cases hw : w ∈ Set.range rOutBTop6.wires
  · obtain ⟨j, rfl⟩ := hw
    rw [writeReg_apply_reg, writeReg_apply_reg]; simp [j.isLt]
  · rw [writeReg_apply_of_not_mem β rOutBTop6 _ w hw,
        writeReg_apply_of_not_mem β rOutBTop6 _ w hw]
