@[scoped simp] theorem tier2_append_countTempAnd {M : ℕ} (F G : TempCtx M) :
    (F.append G).countTempAnd = F.countTempAnd + G.countTempAnd := by
  induction F with
  | hole => simp [TempCtx.append, TempCtx.countTempAnd]
  | seqPre _ _ ih => simp [TempCtx.append, TempCtx.countTempAnd, ih]
  | seqPost _ _ ih => simp [TempCtx.append, TempCtx.countTempAnd, ih]
  | tempAnd _ _ _ _ _ _ _ ih =>
      simp only [TempCtx.append, TempCtx.countTempAnd, ih]
      omega
@[scoped simp] theorem tier2_ctxCliffAlloc_countTempAnd {M : ℕ} (c : CliffProg M) :
    (ctxCliffAlloc c).countTempAnd = 0 := rfl
@[scoped simp] theorem tier2_ctxTempBit_countTempAnd {M : ℕ} (c₁ c₂ anc : Wire M)
    (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc) :
    (ctxTempBit c₁ c₂ anc h₁₂ h₁a h₂a).countTempAnd = 1 := rfl
set_option maxRecDepth 2000
end Tier2ZeroPruned749AndPKickZero56

