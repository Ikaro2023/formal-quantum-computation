theorem K6StageSpec.seq {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    {S₁ S₂ : BitAssignment n → Prop} {d₁ d₂ : DynamicCircuit Var n}
    {next₁ next₂ : BitAssignment n → BitAssignment n} {phase₁ phase₂ : BitAssignment n → ℂ}
    (h₁ : K6StageSpec S₁ d₁ next₁ phase₁) (h₂ : K6StageSpec S₂ d₂ next₂ phase₂)
    (hImp : ∀ α, S₁ α → S₂ (next₁ α)) : K6StageSpec S₁ (.seq d₁ d₂) (fun α ↦ next₂ (next₁ α))
    (fun α ↦ phase₁ α * phase₂ (next₁ α)) := by
  classical
  rcases h₁ with ⟨hConst₁, A₁, hWp₁, hKet₁⟩
  rcases h₂ with ⟨hConst₂, A₂, hWp₂, hKet₂⟩
  have hConstSeq : PreservesStoreConst (.seq d₁ d₂) := by
    intro M
    obtain ⟨M₂, hM₂⟩ := hConst₂ M
    obtain ⟨M₁, hM₁⟩ := hConst₁ M₂
    refine ⟨M₁, funext fun σ ↦ ?_⟩
    simp only [DynamicCircuit.compile_seq, wp_qSeq, hM₂, hM₁]
  have hAbsorb : p2t_ketPredProj S₂ * (A₁ * p2t_ketPredProj S₁) = A₁ * p2t_ketPredProj S₁ := by
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro α
    rw [mbh_ket_eq_ket, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
      p2t_ketPredProj_mul_ket]
    by_cases hα : S₁ α
    · simp only [hα, ↓reduceIte, hKet₁ α hα, Matrix.mulVec_smul,
        p2t_ketPredProj_mul_ket, hImp α hα]
    · simp only [hα, ↓reduceIte, Matrix.mulVec_zero]
  have hAbsorbAdj :
      (A₁ * p2t_ketPredProj S₁)ᴴ * p2t_ketPredProj S₂ = (A₁ * p2t_ketPredProj S₁)ᴴ := by
    have h := congrArg conjTranspose hAbsorb
    simpa only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose] using h
  refine ⟨hConstSeq, A₂ * A₁, fun M σ ↦ ?_, fun α hα ↦ ?_⟩
  · obtain ⟨M₂, hM₂⟩ := hConst₂ M
    have hSeq : wp (DynamicCircuit.seq d₁ d₂).compile (fun _ ↦ M) σ =
        wp d₁.compile (fun _ ↦ M₂) σ := by
      simp only [DynamicCircuit.compile_seq, wp_qSeq, hM₂]
    have hM₂eq : M₂ = wp d₂.compile (fun _ ↦ M) σ := (congrFun hM₂ σ).symm
    rw [hSeq, hWp₁ M₂ σ]
    have hL : p2t_ketPredProj S₁ * (A₁ᴴ * M₂.1.1 * A₁) * p2t_ketPredProj S₁ =
        (A₁ * p2t_ketPredProj S₁)ᴴ * M₂.1.1 * (A₁ * p2t_ketPredProj S₁) := by
      simp only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose, Matrix.mul_assoc]
    rw [hL]
    calc (A₁ * p2t_ketPredProj S₁)ᴴ * M₂.1.1 * (A₁ * p2t_ketPredProj S₁)
        = ((A₁ * p2t_ketPredProj S₁)ᴴ * p2t_ketPredProj S₂) *
            (wp d₂.compile (fun _ ↦ M) σ).1.1 *
            (p2t_ketPredProj S₂ * (A₁ * p2t_ketPredProj S₁)) := by
              rw [hAbsorbAdj, hAbsorb, hM₂eq]
      _ = (A₁ * p2t_ketPredProj S₁)ᴴ *
            (p2t_ketPredProj S₂ * (wp d₂.compile (fun _ ↦ M) σ).1.1 * p2t_ketPredProj S₂) *
            (A₁ * p2t_ketPredProj S₁) := by
              simp only [Matrix.mul_assoc]
      _ = (A₁ * p2t_ketPredProj S₁)ᴴ *
            (p2t_ketPredProj S₂ * (A₂ᴴ * M.1.1 * A₂) * p2t_ketPredProj S₂) *
            (A₁ * p2t_ketPredProj S₁) := by
              rw [hWp₂ M σ]
      _ = ((A₁ * p2t_ketPredProj S₁)ᴴ * p2t_ketPredProj S₂) * (A₂ᴴ * M.1.1 * A₂) *
            (p2t_ketPredProj S₂ * (A₁ * p2t_ketPredProj S₁)) := by
              simp only [Matrix.mul_assoc]
      _ = p2t_ketPredProj S₁ * ((A₂ * A₁)ᴴ * M.1.1 * (A₂ * A₁)) * p2t_ketPredProj S₁ := by
              rw [hAbsorbAdj, hAbsorb]
              simp only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose, Matrix.mul_assoc]
  · rw [← Matrix.mulVec_mulVec, hKet₁ α hα, Matrix.mulVec_smul, hKet₂ _ (hImp α hα), smul_smul]
theorem K6StageSpec.measureXReset {Var : Type} [Fintype Var] [DecidableEq Var] {n k : ℕ}
    [NeZero (2 ^ n)] (v : Var) (r : QRegister k n) {S_pre S_post : BitAssignment n → Prop}
    {cont : (Fin k → Bool) → DynamicCircuit Var n}
    {next_cont : BitAssignment n → BitAssignment n} {phase_total : BitAssignment n → ℂ}
    {phase_cont : (Fin k → Bool) → BitAssignment n → ℂ}
    (hReset : ∀ α, S_pre α → S_post (writeReg α r (fun _ ↦ 0))) (hCont : ∀ f : Fin k → Bool,
    K6StageSpec S_post (cont f) next_cont (phase_cont f)) (hCancel : ∀ (f : Fin k → Bool) (α :
    BitAssignment n), S_pre α → (∏ b : Fin k, if f b then (-1 : ℂ) ^ (α (r b)).val else 1) *
    phase_cont f (writeReg α r (fun _ ↦ 0)) = phase_total α) : K6StageSpec S_pre
    (DynCircuitExt.measureXResetAndBranch v k r cont)
    (fun α ↦ next_cont (writeReg α r (fun _ ↦ 0))) phase_total := by
  classical
  choose hConst_f A_f hWp_f hKet_f using hCont
  have hConstMeas : PreservesStoreConst (DynCircuitExt.measureXResetAndBranch v k r cont) := by
    intro M
    choose M_f hMf using fun f ↦ (hConst_f f) M
    obtain ⟨M', hM', _⟩ := DynCircuitExt.wp_measureXResetAndBranch_const v k r cont M M_f hMf
    exact ⟨M', hM'⟩
  let w : ℝ := (√(1 / 2)) ^ k
  have hw_pos : 0 < w := pow_pos (Real.sqrt_pos.mpr (by norm_num)) k
  let f₀ : Fin k → Bool := fun _ ↦ false
  let B : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ :=
    (((w⁻¹ : ℝ) : ℂ)) • (A_f f₀ * DynCircuitExt.xResetKraus r f₀)
  have hBKet : ∀ α, S_pre α →
      B.mulVec (ket α) = phase_total α • ket (next_cont (writeReg α r (fun _ ↦ 0))) := by
    intro α hα
    dsimp only [B]
    rw [Matrix.smul_mulVec, ← Matrix.mulVec_mulVec, k6_xResetKraus_mulVec_ket,
      Matrix.mulVec_smul, hKet_f f₀ _ (hReset α hα), smul_smul, smul_smul]
    refine congrArg (· • ket (next_cont (writeReg α r (fun _ ↦ 0)))) ?_
    have hprod0 : (∏ b : Fin k, if f₀ b then (-1 : ℂ) ^ (α (r b)).val else 1) = 1 := by
      simp [f₀]
    have hc0 := hCancel f₀ α hα
    rw [hprod0, one_mul] at hc0
    have hww : ((w⁻¹ : ℝ) : ℂ) * ((w : ℝ) : ℂ) = 1 := by
      rw [← Complex.ofReal_mul, inv_mul_cancel₀ (ne_of_gt hw_pos), Complex.ofReal_one]
    rw [hprod0, mul_one, hc0]
    change (((w⁻¹ : ℝ) : ℂ) * ((w : ℝ) : ℂ)) * phase_total α = phase_total α
    rw [hww, one_mul]
  have hAfEq : ∀ f : Fin k → Bool, A_f f * DynCircuitExt.xResetKraus r f * p2t_ketPredProj
      S_pre = ((w : ℝ) : ℂ) • (B * p2t_ketPredProj S_pre) := by
    intro f
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro α
    rw [mbh_ket_eq_ket, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
      Matrix.smul_mulVec, ← Matrix.mulVec_mulVec, p2t_ketPredProj_mul_ket]
    by_cases hα : S_pre α
    · simp only [hα, ↓reduceIte, k6_xResetKraus_mulVec_ket, Matrix.mulVec_smul,
        hKet_f f _ (hReset α hα), hBKet α hα, smul_smul]
      refine congrArg (· • ket (next_cont (writeReg α r (fun _ ↦ 0)))) ?_
      rw [mul_assoc, hCancel f α hα]
    · simp only [hα, ↓reduceIte, Matrix.mulVec_zero, smul_zero]
  have hKAbsorb : ∀ f : Fin k → Bool,
      p2t_ketPredProj S_post * (DynCircuitExt.xResetKraus r f * p2t_ketPredProj S_pre) =
        DynCircuitExt.xResetKraus r f * p2t_ketPredProj S_pre := by
    intro f
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro α
    rw [mbh_ket_eq_ket, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
      p2t_ketPredProj_mul_ket]
    by_cases hα : S_pre α
    · simp only [hα, ↓reduceIte, k6_xResetKraus_mulVec_ket, Matrix.mulVec_smul,
        p2t_ketPredProj_mul_ket, hReset α hα]
    · simp only [hα, ↓reduceIte, Matrix.mulVec_zero]
  refine ⟨hConstMeas, B, fun M σ ↦ ?_, hBKet⟩
  choose M_f hMf using fun f ↦ (hConst_f f) M
  obtain ⟨M', hM'_wp, hM'_mat⟩ :=
    DynCircuitExt.wp_measureXResetAndBranch_const v k r cont M M_f hMf
  have hEqM' : wp (DynCircuitExt.measureXResetAndBranch v k r cont).compile (fun _ ↦ M) σ = M' :=
    congrFun hM'_wp σ
  rw [hEqM', hM'_mat, Finset.mul_sum, Finset.sum_mul]
  have hTerm : ∀ f : Fin k → Bool, p2t_ketPredProj S_pre * ((DynCircuitExt.xResetKraus r f)ᴴ
      * (M_f f).1.1 * DynCircuitExt.xResetKraus r f) * p2t_ketPredProj S_pre =
      ((w ^ 2 : ℝ) : ℂ) • (p2t_ketPredProj S_pre * (Bᴴ * M.1.1 * B) * p2t_ketPredProj S_pre)
      := by
    intro f
    let K := DynCircuitExt.xResetKraus r f
    have hKA : p2t_ketPredProj S_post * (K * p2t_ketPredProj S_pre) =
        K * p2t_ketPredProj S_pre := hKAbsorb f
    have hKAAdj : (K * p2t_ketPredProj S_pre)ᴴ * p2t_ketPredProj S_post =
        (K * p2t_ketPredProj S_pre)ᴴ := by
      have h := congrArg conjTranspose hKA
      simpa only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose] using h
    have hMfeq : M_f f = wp (cont f).compile (fun _ ↦ M) σ := (congrFun (hMf f) σ).symm
    have h1 : p2t_ketPredProj S_pre * (Kᴴ * (M_f f).1.1 * K) * p2t_ketPredProj S_pre =
        (K * p2t_ketPredProj S_pre)ᴴ * (M_f f).1.1 * (K * p2t_ketPredProj S_pre) := by
      simp only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose, Matrix.mul_assoc]
    rw [h1]
    have h2 : (K * p2t_ketPredProj S_pre)ᴴ * (M_f f).1.1 * (K * p2t_ketPredProj S_pre) =
        (A_f f * K * p2t_ketPredProj S_pre)ᴴ * M.1.1 *
          (A_f f * K * p2t_ketPredProj S_pre) := by
      calc (K * p2t_ketPredProj S_pre)ᴴ * (M_f f).1.1 * (K * p2t_ketPredProj S_pre)
          = ((K * p2t_ketPredProj S_pre)ᴴ * p2t_ketPredProj S_post) *
              (wp (cont f).compile (fun _ ↦ M) σ).1.1 *
              (p2t_ketPredProj S_post * (K * p2t_ketPredProj S_pre)) := by
                rw [hKAAdj, hKA, hMfeq]
        _ = (K * p2t_ketPredProj S_pre)ᴴ *
              (p2t_ketPredProj S_post * (wp (cont f).compile (fun _ ↦ M) σ).1.1 *
                p2t_ketPredProj S_post) *
              (K * p2t_ketPredProj S_pre) := by
                simp only [Matrix.mul_assoc]
        _ = (K * p2t_ketPredProj S_pre)ᴴ *
              (p2t_ketPredProj S_post * ((A_f f)ᴴ * M.1.1 * A_f f) *
                p2t_ketPredProj S_post) *
              (K * p2t_ketPredProj S_pre) := by
                rw [hWp_f f M σ]
        _ = ((K * p2t_ketPredProj S_pre)ᴴ * p2t_ketPredProj S_post) *
              ((A_f f)ᴴ * M.1.1 * A_f f) *
              (p2t_ketPredProj S_post * (K * p2t_ketPredProj S_pre)) := by
                simp only [Matrix.mul_assoc]
        _ = (A_f f * K * p2t_ketPredProj S_pre)ᴴ * M.1.1 *
              (A_f f * K * p2t_ketPredProj S_pre) := by
                rw [hKAAdj, hKA]
                simp only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose,
                  Matrix.mul_assoc]
    have hstar : star ((w : ℝ) : ℂ) = ((w : ℝ) : ℂ) := by simp
    rw [h2, hAfEq f, Matrix.conjTranspose_smul, hstar,
      Matrix.smul_mul, Matrix.mul_smul, Matrix.smul_mul, smul_smul]
    have hw2 : ((w : ℝ) : ℂ) * ((w : ℝ) : ℂ) = ((w ^ 2 : ℝ) : ℂ) := by
      push_cast; ring
    rw [hw2]
    refine congrArg (((w ^ 2 : ℝ) : ℂ) • ·) ?_
    simp only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose, Matrix.mul_assoc]
  simp_rw [hTerm, ← Finset.sum_smul]
  have hsum : (∑ _f : Fin k → Bool, ((w ^ 2 : ℝ) : ℂ)) = 1 := by
    exact_mod_cast DynCircuitExt.sum_sqrt_half_pow_sq k
  rw [hsum, one_smul]
theorem K6StageSpec.toRealizes {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] {S : BitAssignment n → Prop} {d : DynamicCircuit Var n}
    {phase : BitAssignment n → ℂ} {U : Unitary (2 ^ n)}
    (h : K6StageSpec S d (fun α ↦ α) phase)
    (hU : ∀ α, S α → U.1.mulVec (ket α) = phase α • ket α) : p2t_RealizesConstCleanUnitary
    (p2t_ketPredProj S) d U := by
  classical
  rcases h with ⟨hConst, A, hWp, hKet⟩
  have hEq : A * p2t_ketPredProj S = U.1 * p2t_ketPredProj S := by
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro α
    rw [mbh_ket_eq_ket, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, p2t_ketPredProj_mul_ket]
    by_cases hα : S α
    · simp only [hα, ↓reduceIte, hKet α hα, hU α hα]
    · simp only [hα, ↓reduceIte, Matrix.mulVec_zero]
  refine ⟨hConst, fun M σ ↦ ?_⟩
  rw [hWp M σ]
  calc p2t_ketPredProj S * (Aᴴ * M.1.1 * A) * p2t_ketPredProj S
      = (A * p2t_ketPredProj S)ᴴ * M.1.1 * (A * p2t_ketPredProj S) := by
          simp only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose, Matrix.mul_assoc]
    _ = (U.1 * p2t_ketPredProj S)ᴴ * M.1.1 * (U.1 * p2t_ketPredProj S) := by rw [hEq]
    _ = p2t_ketPredProj S * (U.1ᴴ * M.1.1 * U.1) * p2t_ketPredProj S := by
          simp only [Matrix.conjTranspose_mul, p2t_ketPredProj_conjTranspose, Matrix.mul_assoc]
