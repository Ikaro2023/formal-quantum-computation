        let hcX' : ∀ i, CtrlNe (some wAnc) ((regInit rX) i) :=
          fun i ↦ CtrlNe.some (hXW.ne i.castSucc (Fin.last (1 + m))).symm
        let hcP' : CtrlNe (some wAnc) wPar := CtrlNe.some (hPW (Fin.last (1 + m))).symm
        let hcW' : ∀ i, CtrlNe (some wAnc) ((regInit rW) i) :=
          fun i ↦ CtrlNe.some (regInit_ne_last rW i).symm
        let hcBuf' : ∀ f, CtrlNe (some wAnc) (rBuf1728 f) :=
          fun f ↦ CtrlNe.some (hWBuf.ne (Fin.last (1 + m)) f)
        let hcPal' : ∀ t, CtrlNe (some wAnc) (rPal24 t) :=
          fun t ↦ CtrlNe.some (hWPal.ne (Fin.last (1 + m)) t)
        branchMsbCircuit c (rX (Fin.last (1 + m))) wAnc
          (hcX (Fin.last (1 + m))) (hcW (Fin.last (1 + m)))
