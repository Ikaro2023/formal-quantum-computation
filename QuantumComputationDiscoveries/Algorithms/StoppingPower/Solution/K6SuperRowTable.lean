      dsimp only [writeReg, g]
      rw [hzero_symm]
      exact (basisBitsEquiv n).symm_apply_apply _
    rw [p2t_ket_eq_single (writeReg α r (fun _ ↦ 0)), hrep]
theorem k6_prod_ite_neg_one_pow {ι : Type*} [Fintype ι] (f : ι → Bool) (v : ι → ZMod 2) :
    (∏ i : ι, if f i then (-1 : ℂ) ^ (v i).val else 1) =
      (-1 : ℂ) ^ (∑ i : ι, if f i then v i else 0).val := by
  classical
  refine Finset.induction_on Finset.univ ?_ ?_
  · simp
  · intro a s ha ih
    rw [Finset.prod_insert ha, Finset.sum_insert ha, neg_one_pow_zmod2_add, ih]
    cases f a <;> simp
theorem k6_neg_one_pow_mul_self (z : ZMod 2) :
    ((-1 : ℂ) ^ z.val) * ((-1 : ℂ) ^ z.val) = 1 := by
  rcases zmod2_eq_zero_or_one z with rfl | rfl <;> norm_num
theorem k6_preservesStoreConst_of_storeConst {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)] {d : DynamicCircuit Var n} (h : ∀ {Ψ : CQAssertionCompat Var (2 ^ n)},
    StoreConst Ψ → StoreConst (wp d.compile Ψ)) : PreservesStoreConst d := fun M ↦ ⟨wp
    d.compile (fun _ ↦ M) (fun _ ↦ 0), funext fun σ ↦ h (fun _ _ ↦ rfl) σ (fun _ ↦ 0)⟩
def K6StageSpec {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (S : BitAssignment n → Prop) (d : DynamicCircuit Var n)
