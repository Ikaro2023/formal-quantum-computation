           hDiv11 := hDiv64 11 (by decide), hDiv12 := hDiv64 12 (by decide), hRotEq := ?_ }
  · intro k m_BE α A U_BE τ hα hτ hBE hβ_eq hnorm_A sys anc
    let rBE : QRegister (k + m_BE) (k + (m_BE + 1)) := QRegister.block 0 (k + m_BE) (by omega)
    let q_sig : Wire (k + (m_BE + 1)) := ⟨k + m_BE, by omega⟩
