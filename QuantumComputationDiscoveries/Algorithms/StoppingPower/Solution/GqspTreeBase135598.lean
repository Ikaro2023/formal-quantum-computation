/-- One-step decomposition of `gqsp_codeOrigLoop` for 4-step unrolling. -/
private theorem gqsp_codeOrigLoop_cons (n_exp c : ℕ) (cs : List ℕ) (cnt : ℕ) :
    gqsp_codeOrigLoop n_exp (c :: cs) cnt =
      Bool.and (Nat.blt c 4398046511104) (gqsp_codeOrigLoop n_exp cs (cnt + 1)) := by
  dsimp only [gqsp_codeOrigLoop]
  cases Nat.blt c 4398046511104
  · rfl
  · rw [Bool.true_and, gqsp_applyNat0Bool_eq,
      show Nat.add 1 cnt = cnt + 1 by simp only [Nat.add_eq]; omega]

/-- 4-step `@Nat.rec` unrolled base code-list validator (`fuel = 35000` covers `135,868 ≤
140,000`). -/
noncomputable def gqsp_codeOrigLoop4 (n_exp fuel : ℕ) : List ℕ → ℕ → Bool :=
  @Nat.rec (fun _ ↦ List ℕ → ℕ → Bool)
    (fun xs cnt ↦ gqsp_codeOrigLoop n_exp xs cnt)
    (fun _ ih xs cnt ↦
      match xs with
      | c0 :: c1 :: c2 :: c3 :: rest =>
          match Bool.and (Nat.blt c0 4398046511104)
            (Bool.and (Nat.blt c1 4398046511104)
              (Bool.and (Nat.blt c2 4398046511104) (Nat.blt c3 4398046511104))) with
          | true => gqsp_applyNat0Bool (ih rest) (Nat.add 4 cnt)
          | false => false
      | _ => gqsp_codeOrigLoop n_exp xs cnt)
    fuel

theorem gqsp_codeOrigLoop4_eq (n_exp : ℕ) :
    ∀ (fuel : ℕ) (xs : List ℕ) (cnt : ℕ),
      gqsp_codeOrigLoop4 n_exp fuel xs cnt = gqsp_codeOrigLoop n_exp xs cnt
  | 0, _, _ => rfl
  | _ + 1, [], _ => rfl
  | _ + 1, [_], _ => rfl
  | _ + 1, [_, _], _ => rfl
  | _ + 1, [_, _, _], _ => rfl
  | fuel + 1, c0 :: c1 :: c2 :: c3 :: rest, cnt => by
      dsimp only [gqsp_codeOrigLoop4]
      iterate 4 rw [gqsp_codeOrigLoop_cons]
      cases Nat.blt c0 4398046511104
      · rfl
      · cases Nat.blt c1 4398046511104
        · rfl
        · cases Nat.blt c2 4398046511104
          · rfl
          · cases Nat.blt c3 4398046511104
            · rfl
            · change gqsp_applyNat0Bool (gqsp_codeOrigLoop4 n_exp fuel rest) (Nat.add 4 cnt) =
                gqsp_codeOrigLoop n_exp rest (cnt + 1 + 1 + 1 + 1)
              rw [gqsp_applyNat0Bool_eq, gqsp_codeOrigLoop4_eq n_exp fuel rest (Nat.add 4 cnt),
                show Nat.add 4 cnt = cnt + 1 + 1 + 1 + 1 by simp only [Nat.add_eq]; omega]
