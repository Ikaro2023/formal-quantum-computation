    (@List.rec (ℕ × ℕ) (fun _ ↦ List ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ)) (fun
    cs1 ps1 acc1 ↦ (cs1, (ps1, acc1))) (fun hw _ ihw cs1 ps1 acc1 ↦ @Prod.rec ℕ ℕ (fun _ ↦
