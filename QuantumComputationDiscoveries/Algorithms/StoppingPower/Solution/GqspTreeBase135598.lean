  have hlo : C_orig_list.length = M + 1 := by simpa [Nat.add_eq] using hlo0
  have hDiv64 : ∀ (k_idle : ℕ), k_idle ≤ 12 → ∀ i : Fin (M + 1), 2 ^ (k_idle - 6) ∣ (C_tier
    i).val := by
