    gqsp_tf_fastDecPatchBlocks c_orig c_prev bss0 = gqsp_zwDecTierPatchBlocks c_orig c_prev
      bss0 := by
  unfold gqsp_tf_fastDecPatchBlocks gqsp_zwDecTierPatchBlocks
  rw [show gqsp_tf_fastDecPatchWord = gqsp_zwDecTierPatchWord from
    funext fun cnt ↦ funext fun cur ↦ funext fun cs ↦ funext fun ps ↦
      funext (gqsp_tf_fastDecPatchWord_eq cnt cur cs ps)]

