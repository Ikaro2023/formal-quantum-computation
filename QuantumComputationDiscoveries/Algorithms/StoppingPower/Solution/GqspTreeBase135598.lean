    ℕ → List ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ) :=
  @Nat.rec (fun _ ↦ ℕ → List ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ))
    (fun _ cs ps acc ↦ (cs, (ps, acc)))
    (fun _ ih cur cs ps acc ↦
      @List.rec ℕ
        (fun _ ↦ (ℕ → List ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ)) →
          ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ))
        (fun _ _ ps1 acc1 ↦ ([], (ps1, acc1)))
        (fun c ct _ ih1 cur1 ps1 acc1 ↦
          @List.rec ℕ
            (fun _ ↦ (ℕ → List ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ)) →
              ℕ → ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ))
            (fun _ _ _ ct2 acc2 ↦ (ct2, ([], acc2)))
            (fun cp pt _ ih2 cur2 c2 ct2 acc2 ↦
              @Bool.rec
                (fun _ ↦ (ℕ → List ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ)) →
                  ℕ → ℕ → List ℕ → ℕ → List ℕ → List ℕ → List ℕ × (List ℕ × List ℕ))
                (fun ih3 cur3 c3 ct3 _ pt3 acc3 ↦
                  let code := Nat.land (Nat.shiftRight cur3 1) 0x7f
                  let tz := Nat.add 5 (Nat.shiftRight code 1)
                  let c_opt := @Bool.rec (fun _ ↦ ℕ) (Nat.shiftLeft (Nat.add (Nat.shiftRight
                      c3 tz) (Nat.land code 1)) tz) 0 (Nat.ble 74 code)
                  @Nat.rec (fun _ ↦ List ℕ × (List ℕ × List ℕ)) ([], ([], []))
                    (fun v _ ↦
                      @Nat.rec (fun _ ↦ List ℕ × (List ℕ × List ℕ)) ([], ([], []))
                        (fun cur' _ ↦ ih3 cur' ct3 pt3 (v :: acc3))
                        (Nat.add 1 (Nat.shiftRight cur3 8)))
                    (Nat.add 1 c_opt))
                (fun ih3 cur3 _ ct3 cp3 pt3 acc3 ↦
                  @Nat.rec (fun _ ↦ List ℕ × (List ℕ × List ℕ)) ([], ([], []))
                    (fun cur' _ ↦ ih3 cur' ct3 pt3 (cp3 :: acc3))
                    (Nat.add 1 (Nat.shiftRight cur3 1)))
                (Nat.beq (Nat.land cur2 1) 0) ih2 cur2 c2 ct2 cp pt acc2)
            ps1 ih1 cur1 c ct acc1)
        cs ih cur ps acc)
    cnt0

theorem gqsp_tf_fastDecPatchWord_eq :
    ∀ (cnt cur : ℕ) (cs ps acc : List ℕ),
      gqsp_tf_fastDecPatchWord cnt cur cs ps acc = gqsp_zwDecTierPatchWord cnt cur cs ps acc
  | 0, _, _, _, _ => rfl
  | _ + 1, _, [], _, _ => rfl
  | _ + 1, _, _ :: _, [], _ => rfl
  | cnt + 1, cur, c :: ct, cp :: pt, acc => by
      dsimp only [gqsp_tf_fastDecPatchWord, gqsp_zwDecTierPatchWord]
      cases Nat.beq (Nat.land cur 1) 0
      · dsimp only
        rw [gqsp_zwForce_eq, gqsp_zwForce_eq, gqsp_zwForce_eq]
        exact gqsp_tf_fastDecPatchWord_eq cnt (Nat.shiftRight cur 8) ct pt (_ :: acc)
      · dsimp only
        rw [gqsp_zwForce_eq, gqsp_zwForce_eq]
        exact gqsp_tf_fastDecPatchWord_eq cnt (Nat.shiftRight cur 1) ct pt (cp :: acc)


