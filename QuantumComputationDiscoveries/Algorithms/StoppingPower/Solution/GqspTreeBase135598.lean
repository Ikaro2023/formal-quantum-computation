      cert_orig.h_seg_bound τ hα hτ hBE hβ_eq hnorm_A
    have hBE_sig : rBE.DisjointWires (QRegister.singleton q_sig) :=
      QRegister.disjoint_iff.mpr fun i j h ↦ by
