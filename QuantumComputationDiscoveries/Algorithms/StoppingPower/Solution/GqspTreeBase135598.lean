        simp [rBE, q_sig, QRegister.singleton, Fin.fin_one_eq_zero j] at hv
        omega
    have hDiffOp : ‖U_cat_eff - U_orig_eff‖ ≤ ((N_dist : ℕ) : ℝ) / 2 ^ 48 := by
      refine (norm_biGqspSegmentOp_sub_le rBE q_sig hBE_sig U_BE M (biCS M C_tier) (biCS M
        cert_orig.C)
        (fun _ _ ↦ le_of_eq (Real.cos_sq_add_sin_sq _))
        (fun _ _ ↦ le_of_eq (Real.cos_sq_add_sin_sq _))).trans
        ((Finset.sum_le_sum (g := fun j ↦ (2 * π / 2 ^ 42) *
          (natDist (biCode M C_tier j).val (biCode M cert_orig.C j).val : ℝ)) fun j _ ↦
