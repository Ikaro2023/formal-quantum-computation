          (catAngle42 (biCode M cert_orig.C j))).trans ?_
        rw [show |catAngle42 (biCode M C_tier j) - catAngle42 (biCode M cert_orig.C j)| / 2 =
            (2 * π / 2 ^ 42) * |((biCode M C_tier j).val : ℝ) - ((biCode M cert_orig.C j).val : ℝ)|
