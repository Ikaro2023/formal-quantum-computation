    ∀ (ch : List DyadicRyGate) (cs : List ℕ) (acc : ℕ),
      @Option.rec (List ℕ × ℕ) (fun _ ↦ ℕ) 0
        (@Prod.rec (List ℕ) ℕ (fun _ ↦ ℕ) (ih_chs 0))
