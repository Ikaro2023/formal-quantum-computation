private theorem b8_div_pow_mod2 (M : ℕ) (hM : M < 128) (sw : ZMod 2) (k : ℕ) (hk : k < 7) :
    let b8 := if sw.val = 1 then 255 - M else M
    let mk : ZMod 2 := if M.testBit k then 1 else 0
