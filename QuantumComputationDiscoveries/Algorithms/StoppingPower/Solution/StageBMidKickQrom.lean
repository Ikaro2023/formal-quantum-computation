            have hdiv : (regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 - 96) / 4 = 1 := by omega
            have hbS : bStar2Fn hm rCore γ = 1 := bStar2Fn_eq_of_div hm rCore γ 1 hdiv
            (rcases hb3 b with rfl | rfl | rfl) <;>
              simp [hw0, hw1, hw2, hv0, hv1, hv2, hc6, hc7, hc3v, hc4v, hSeed0', hen,
                act2Pred, hbS, γc, hc0_act, hge96, hlt108]
          · have hval3 : (γc (rNucIdx hm (QRegExt.idReg _) 3)).val = 1 := by
              change (γ (c 3)).val = 1; simp [hc3v]
            have hval4 : (γc (rNucIdx hm (QRegExt.idReg _) 4)).val = 1 := by
              change (γ (c 4)).val = 1; simp [hc4v]
            exfalso; omega
      · have hnotAct2 : ¬ act2Pred hm rCore γ := by
          rintro ⟨hc0_act, _, hlt108⟩
          have hlt108' : regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 < 108 := hlt108
          exact hen (decide_eq_true ⟨hc0_act, by omega⟩)
        (rcases hb3 b with rfl | rfl | rfl) <;>
          simp [hw0, hw1, hw2, hv0, hv1, hv2, hSeed0', hen, hnotAct2]
    · have hp_lt := p.isLt; have hb_lt := b.isLt
      have hne0 : wBlock2 rU108 b p ≠ rU108 0 := rU108.wires.injective.ne (by
        intro h;
        have hv :=
          congrArg Fin.val h; dsimp [wBlock2] at hv; omega)
      have hne32 : wBlock2 rU108 b p ≠ rU108 32 := rU108.wires.injective.ne (by
        intro h;
        have hv :=
          congrArg Fin.val h; dsimp [wBlock2] at hv; omega)
      have hne64 : wBlock2 rU108 b p ≠ rU108 64 := rU108.wires.injective.ne (by
        intro h;
        have hv :=
          congrArg Fin.val h; dsimp [wBlock2] at hv; omega)
      have hne96 : wBlock2 rU108 b p ≠ rU108 96 := rU108.wires.injective.ne (by
        intro h;
        have hv :=
          congrArg Fin.val h; dsimp [wBlock2] at hv; omega)
      have hne100 : wBlock2 rU108 b p ≠ rU108 100 := rU108.wires.injective.ne fun h ↦ by
        have hv := congrArg Fin.val h
        dsimp [wBlock2] at hv; omega
      have hne104 : wBlock2 rU108 b p ≠ rU108 104 := rU108.wires.injective.ne fun h ↦ by
        have hv := congrArg Fin.val h
        dsimp [wBlock2] at hv; omega
      have hneIdx : (⟨96 + 4 * b.val + p.val, ltAlt b p⟩ : Fin 108) ≠ 0 := by
        intro h; have hv := congrArg Fin.val h; dsimp at hv; omega
      rw [hs4, Function.update_of_ne hne96, Function.update_of_ne hne104,
        hs3, Function.update_of_ne hne96, Function.update_of_ne hne100,
        hs2, Function.update_of_ne hne32, Function.update_of_ne hne96,
        hs1, Function.update_of_ne hne0, Function.update_of_ne hne64,
        hs0, Function.update_of_ne hne0, Function.update_of_ne hne32]
      simp [wBlock2, hSeedPos _ hneIdx, hp0]

noncomputable def withU108WState {Var : Type} {mp mTail n : ℕ}
    (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rU108 : QRegister 108 n) (rTail : QRegister mTail n)
    (hCU : rCore.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail)
    (dInner : DynamicCircuit Var n) : DynamicCircuit Var n :=
  .seq (.circuit (symBankFwdCirc 5 (preSplits5 hm rCore rU108 hCU)))
    (.seq
      (dOptExpand3Clean v 5 (uLoNuc5 hm rCore) (wBlock5 rU108)
        (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2, auxItemExt hmTail⟩)
        (optInj5 hm hmTail rCore rU108 rTail hCU hCTail hUTail))
      (.seq
        (dOptExpand3Clean v 2 (uLoNuc2 hm rCore) (wBlock2 rU108)
          (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2,
            auxItemExt hmTail⟩)
          (optInj2 hm hmTail rCore rU108 rTail hCU hCTail hUTail))
        (.seq dInner
          (.seq
            (wUncompTreeDyn v 3 2 (uLoNuc2 hm rCore) (wBlock2 rU108)
              (inj2 rU108) (auxItem hm rCore rU108 hCU) (.circuit .identity) 2 le_rfl)
            (.seq
              (wUncompTreeDyn v 3 5 (uLoNuc5 hm rCore) (wBlock5 rU108)
                (inj5 rU108) (auxItemAux hm rCore rU108 hCU) (.circuit .identity) 5 le_rfl)
              (symBankRevDyn v 5 (preSplits5 hm rCore rU108 hCU)))))))

set_option maxHeartbeats 800000 in
-- Multi-stage W-state 108-bank subspace step composition.
theorem subspaceStep_withU108WState {Var : Type} [Fintype Var] [DecidableEq Var]
    {mp mTail n : ℕ} [NeZero (2 ^ n)]
    (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rU108 : QRegister 108 n) (rTail : QRegister mTail n)
    (hCU : rCore.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail)
    {M_set : Finset (Wire n)}
    (hCM : Disjoint rCore.image M_set)
    (hUM : Disjoint rU108.image M_set)
    {dInner : DynamicCircuit Var n} {U_inner : Unitary (2 ^ n)}
    {φInner : BitAssignment n → ℂ} {fInner : BitAssignment n → BitAssignment n}
    (hPerm : UnitaryPhasePerm U_inner φInner fInner)
    (hOut : ∀ β w, w ∉ M_set → fInner β w = β w)
    (hClean : CleanUnitaryEquiv rTail U_inner dInner)
    (P_start : BitAssignment n → Prop) [DecidablePred P_start]
    (gSeed : BitAssignment n → BitAssignment n)
    (hSeed0 : ∀ β, P_start β → gSeed β (rU108 0) =
      if decide (coin0Active (fun q ↦ gSeed β (rCore q)) = true ∧
          regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ gSeed β (rCore q)) < 216) = true
      then 1 else 0)
    (hSeedPos : ∀ β, P_start β → ∀ k : Fin 108, k ≠ 0 → gSeed β (rU108 k) = 0)
    (hSeedTail : ∀ β, P_start β → ∀ t : Fin mTail, gSeed β (rTail t) = 0) :
    let gBank : BitAssignment n → BitAssignment n := fun β ↦
      unaryBank108Fwd hm rCore rU108 hCU (gSeed β)
    let gPostSeed : BitAssignment n → BitAssignment n :=
      fun β w ↦ if w ∈ M_set then fInner (gBank β) w else gSeed β w
    SubspaceStep
      (mkVecOp fun β ↦ if P_start β then ket (gSeed β) else 0)
      (mkVecOp fun β ↦ if P_start β then φInner (gBank β) • ket (gPostSeed β) else 0)
      (withU108WState hm hmTail v rCore rU108 rTail hCU hCTail hUTail dInner) := by
  intro gBank gPostSeed
  let q0 := rTail ⟨0, auxItemAlt hmTail⟩
  let q1 := rTail ⟨1, auxItemSub hmTail⟩
  let q2 := rTail ⟨2, auxItemExt hmTail⟩
  let P_q0 : BitAssignment n → Prop := fun δ ↦ δ q0 = 0
  have : DecidablePred P_q0 := fun _ ↦ inferInstance
  let G_seed : Operator (2 ^ n) := mkVecOp fun β ↦ if P_start β then ket (gSeed β) else 0
  let gPre : BitAssignment n → BitAssignment n := fun β ↦
    bankFwd 5 (preSplits5 hm rCore rU108 hCU) (gSeed β)
  let G_pre : Operator (2 ^ n) := mkVecOp fun β ↦ if P_start β then ket (gPre β) else 0
  let gBase5 : BitAssignment n → BitAssignment n := fun β w ↦
    if ∃ (b : Fin 3) (p : Fin (2 ^ 5)), w = wBlock5 rU108 b p then 0 else gPre β w
  let G_base5 : Operator (2 ^ n) := mkVecOp fun β ↦ if P_start β then ket (gBase5 β) else 0
  let gExp5 : BitAssignment n → BitAssignment n := fun β ↦
    if act5Pred hm rCore (gSeed β) then
      Function.update (gBase5 β) (wBlock5 rU108 (bStar5Fn hm rCore (gSeed β))
        ⟨idxValPrefix (uLoNuc5 hm rCore) (gSeed β) 5 le_rfl,
          idxValPrefix_lt_two_pow (uLoNuc5 hm rCore) (gSeed β) 5 le_rfl⟩) 1
    else gBase5 β
  let gBase2 : BitAssignment n → BitAssignment n := fun β w ↦
    if ∃ (b : Fin 3) (p : Fin (2 ^ 2)), w = wBlock2 rU108 b p then 0 else gExp5 β w
  let G_base2 : Operator (2 ^ n) := mkVecOp fun β ↦ if P_start β then ket (gBase2 β) else 0
  let G_bank : Operator (2 ^ n) := mkVecOp fun β ↦ if P_start β then ket (gBank β) else 0
  have hSuppPre5 : SupportedOn (fun δ ↦
    ∀ i : Fin 5, δ (preSplits5 hm rCore rU108 hCU i).anc = 0) G_seed :=
    fun A B hAB ↦ by
      apply matrix_ext_ket; intro β
      simp only [G_seed, ← Matrix.mulVec_mulVec, mkVecOp_mulVec_ket]
      by_cases hP : P_start β
      · rw [ite_eq_left hP]
        refine hAB (gSeed β) fun i ↦ ?_
        fin_cases i <;> exact hSeedPos β hP _ (by decide)
      · rw [ite_eq_right hP, Matrix.mulVec_zero, Matrix.mulVec_zero]
  have hPreEq : (uSymBank 5 (preSplits5 hm rCore rU108 hCU)).1 * G_seed = G_pre := by
    apply matrix_ext_ket; intro β
    simp only [G_seed, G_pre, ← Matrix.mulVec_mulVec, mkVecOp_mulVec_ket]
    by_cases hP : P_start β
    · rw [ite_eq_left hP, ite_eq_left hP, uSymBank_mulVec_ket]
    · rw [ite_eq_right hP, ite_eq_right hP, Matrix.mulVec_zero]
  have sFwdPre5 : SubspaceStep (Var := Var) G_seed G_pre
      (.circuit (symBankFwdCirc 5 (preSplits5 hm rCore rU108 hCU))) :=
    subspaceStep_congr_out
      (subspaceStep_symBankFwdCirc (Var := Var) 5 (preSplits5 hm rCore rU108 hCU)
        (preSplits5_order hm rCore rU108 hCU) G_seed hSuppPre5) hPreEq
  have hBase5Core : ∀ β, P_start β → ∀ q, gBase5 β (rCore q) = gSeed β (rCore q) := fun β hP q ↦ by
    have hnw : ¬ ∃ b p, rCore q = wBlock5 rU108 b p := fun ⟨b, p, heq⟩ ↦ hCU.ne q _ heq
    have hnu : rCore q ∉ rU108.image := hCU.apply_not_mem_right q
    dsimp only [gBase5, gPre]
    rw [ite_eq_right hnw]
    exact (bankFwd_preSplits5_eval hm rCore rU108 hCU (gSeed β) (hSeed0 β hP) (hSeedPos β hP)).1 _
      hnu
  have hExp5Core : ∀ β, P_start β → ∀ q, gExp5 β (rCore q) = gSeed β (rCore q) := fun β hP q ↦ by
    dsimp only [gExp5]
    split_ifs
    · rw [wBlock5, Function.update_of_ne (hCU.ne q _), hBase5Core β hP q]
    · exact hBase5Core β hP q
  have hBase2Core : ∀ β, P_start β → ∀ q, gBase2 β (rCore q) = gSeed β (rCore q) := fun β hP q ↦ by
    have hnw : ¬ ∃ b p, rCore q = wBlock2 rU108 b p := fun ⟨b, p, heq⟩ ↦ hCU.ne q _ heq
    dsimp only [gBase2]; rw [ite_eq_right hnw]; exact hExp5Core β hP q
  have hBase5Tail : ∀ β, P_start β → ∀ t : Fin mTail, gBase5 β (rTail t) = 0 := fun β hP t ↦ by
    have hnw : ¬ ∃ b p, rTail t = wBlock5 rU108 b p := fun ⟨b, p, heq⟩ ↦ hUTail.ne _ t heq.symm
    dsimp only [gBase5, gPre]; rw [ite_eq_right hnw]
    rw [(bankFwd_preSplits5_eval hm rCore rU108 hCU (gSeed β) (hSeed0 β hP) (hSeedPos β hP)).1
      (rTail t) (hUTail.apply_not_mem_left t)]
    exact hSeedTail β hP t
  have hExp5Tail : ∀ β, P_start β → ∀ t : Fin mTail, gExp5 β (rTail t) = 0 := fun β hP t ↦ by
    dsimp only [gExp5]
    split_ifs
    · rw [wBlock5, Function.update_of_ne (hUTail.ne _ t).symm]; exact hBase5Tail β hP t
    · exact hBase5Tail β hP t
  have hBase2Tail : ∀ β, P_start β → ∀ t : Fin mTail, gBase2 β (rTail t) = 0 := fun β hP t ↦ by
    have hnw : ¬ ∃ b p, rTail t = wBlock2 rU108 b p := fun ⟨b, p, heq⟩ ↦ hUTail.ne _ t heq.symm
    dsimp only [gBase2]; rw [ite_eq_right hnw]; exact hExp5Tail β hP t
  have hOpt5In : oneHotOptPreOp (OptBasePred P_q0 q1 q2) (act5Pred hm rCore) (bStar5Fn hm rCore)
      (uLoNuc5 hm rCore) (wBlock5 rU108) 0 (Nat.zero_le 5) * G_base5 = G_pre := by
    apply matrix_ext_ket; intro β
    simp only [G_base5, G_pre, ← Matrix.mulVec_mulVec, oneHotOptPreOp, mkVecOp_mulVec_ket,
      oneHotOptPreVec]
    by_cases hP : P_start β
    · rw [ite_eq_left hP, ite_eq_left hP, mkVecOp_mulVec_ket]
      obtain ⟨_, hB5, _⟩ :=
        bankFwd_preSplits5_eval hm rCore rU108 hCU (gSeed β) (hSeed0 β hP) (hSeedPos β hP)
      have hw0 : ∀ b p, gBase5 β (wBlock5 rU108 b p) = 0 := fun b p ↦ ite_eq_left ⟨b, p, rfl⟩
      have hOB : OptBasePred P_q0 q1 q2 (gBase5 β) :=
        ⟨hBase5Tail β hP _, hBase5Tail β hP _, hBase5Tail β hP _⟩
      rw [ite_eq_left ⟨hOB, hw0⟩]
      have hActEq : act5Pred hm rCore (gBase5 β) ↔ act5Pred hm rCore (gSeed β) := by
        simp only [act5Pred, hBase5Core β hP]
      have hbSEq : bStar5Fn hm rCore (gBase5 β) = bStar5Fn hm rCore (gSeed β) := by
        simp only [bStar5Fn, hBase5Core β hP]
      by_cases hAct : act5Pred hm rCore (gSeed β)
      · have hp0Eq : (⟨idxValPrefix (uLoNuc5 hm rCore) (gBase5 β) 0 (Nat.zero_le 5),
            Nat.lt_of_lt_of_le (idxValPrefix_lt_two_pow (uLoNuc5 hm rCore) (gBase5 β) 0 (Nat.zero_le
              5))
              (Nat.pow_le_pow_right (by omega) (Nat.zero_le 5))⟩ : Fin (2 ^ 5)) =
            ⟨0, by decide⟩ := Fin.ext rfl
        rw [ite_eq_left (hActEq.mpr hAct), hbSEq, hp0Eq]
        congr 1; funext w
        by_cases hw : ∃ b p, w = wBlock5 rU108 b p
        · obtain ⟨b, p, rfl⟩ := hw
          dsimp only [gPre]
          rw [hB5 b p]
          by_cases hbp : b = bStar5Fn hm rCore (gSeed β) ∧ p.val = 0
          · obtain ⟨rfl, hpv⟩ := hbp
            have hp0' : p = ⟨0, by decide⟩ := Fin.ext hpv
            subst hp0'
            simp [hAct, Function.update_self]
          · have hne : wBlock5 rU108 b p ≠ wBlock5 rU108 (bStar5Fn hm rCore (gSeed β)) ⟨0, by
            decide⟩ :=
              fun heq ↦ by
                obtain ⟨hb, hp⟩ := inj5 rU108 _ _ _ _ heq
                exact hbp ⟨hb, congrArg Fin.val hp⟩
            rw [Function.update_of_ne hne, hw0 b p]
            have hn : ¬(act5Pred hm rCore (gSeed β) ∧ b = bStar5Fn hm rCore (gSeed β) ∧ p.val =
              0) :=
              fun ⟨_, hb, hp⟩ ↦ hbp ⟨hb, hp⟩
            rw [ite_eq_right hn]
        · have hne : w ≠ wBlock5 rU108 (bStar5Fn hm rCore (gSeed β)) ⟨0, by decide⟩ := fun h ↦
          hw ⟨_, _, h⟩
          rw [Function.update_of_ne hne]
          dsimp only [gBase5]; rw [ite_eq_right hw]
      · rw [ite_eq_right (mt hActEq.mp hAct)]
        congr 1; funext w
        by_cases hw : ∃ b p, w = wBlock5 rU108 b p
        · obtain ⟨b, p, rfl⟩ := hw
          dsimp only [gPre]
          rw [hw0 b p, hB5 b p, ite_eq_right (fun h ↦ hAct h.1)]
        · dsimp only [gBase5]; rw [ite_eq_right hw]
    · rw [ite_eq_right hP, ite_eq_right hP, Matrix.mulVec_zero]
  let G_exp5 : Operator (2 ^ n) := mkVecOp fun β ↦ if P_start β then ket (gExp5 β) else 0
  have hOpt5Out : oneHotOptPreOp (OptBasePred P_q0 q1 q2) (act5Pred hm rCore) (bStar5Fn hm rCore)
      (uLoNuc5 hm rCore) (wBlock5 rU108) 5 le_rfl * G_base5 = G_exp5 := by
    apply matrix_ext_ket; intro β
    simp only [G_base5, G_exp5, ← Matrix.mulVec_mulVec, oneHotOptPreOp, mkVecOp_mulVec_ket,
      oneHotOptPreVec]
    by_cases hP : P_start β
    · rw [ite_eq_left hP, ite_eq_left hP, mkVecOp_mulVec_ket]
      have hw0 : ∀ b p, gBase5 β (wBlock5 rU108 b p) = 0 := fun b p ↦ ite_eq_left ⟨b, p, rfl⟩
      have hOB : OptBasePred P_q0 q1 q2 (gBase5 β) :=
        ⟨hBase5Tail β hP _, hBase5Tail β hP _, hBase5Tail β hP _⟩
      rw [ite_eq_left ⟨hOB, hw0⟩]
      have hActEq : act5Pred hm rCore (gBase5 β) ↔ act5Pred hm rCore (gSeed β) := by
        simp only [act5Pred, hBase5Core β hP]
      have hbSEq : bStar5Fn hm rCore (gBase5 β) = bStar5Fn hm rCore (gSeed β) := by
        simp only [bStar5Fn, hBase5Core β hP]
      have hIdxEq : idxValPrefix (uLoNuc5 hm rCore) (gBase5 β) 5 le_rfl =
          idxValPrefix (uLoNuc5 hm rCore) (gSeed β) 5 le_rfl := by
        rw [idxValPrefix_uLoNuc5_eq, idxValPrefix_uLoNuc5_eq]; simp only [hBase5Core β hP]
      dsimp only [gExp5]
      by_cases hAct : act5Pred hm rCore (gSeed β)
      · rw [ite_eq_left (hActEq.mpr hAct), ite_eq_left hAct, hbSEq]
        exact congrArg (fun p ↦
          ket (Function.update (gBase5 β) (wBlock5 rU108 (bStar5Fn hm rCore (gSeed β)) p) 1))
          (Fin.ext hIdxEq)
      · rw [ite_eq_right (mt hActEq.mp hAct), ite_eq_right hAct]
    · rw [ite_eq_right hP, ite_eq_right hP, Matrix.mulVec_zero]
  have sExp5 : SubspaceStep (Var := Var) G_pre G_exp5
      (dOptExpand3Clean v 5 (uLoNuc5 hm rCore) (wBlock5 rU108) q0 q1 q2
        (optInj5 hm hmTail rCore rU108 rTail hCU hCTail hUTail)) :=
    subspaceStep_congr_in hOpt5In.symm
      (subspaceStep_congr_out
        (subspaceStep_mul_right G_base5
          (subspaceStep_dOptExpand3Clean v P_q0 (act5Pred hm rCore) (bStar5Fn hm rCore)
            (uLoNuc5 hm rCore) (wBlock5 rU108) q0 q1 q2 _ (fun _ h ↦ h)))
        hOpt5Out)
  have hExp5_w2 : ∀ β, P_start β → ∀ b p,
    gExp5 β (wBlock2 rU108 b p) = gPre β (wBlock2 rU108 b p) :=
    fun β _ b p ↦ by
      have hnw5 : ¬ ∃ b5 p5, wBlock2 rU108 b p = wBlock5 rU108 b5 p5 := by
        rintro ⟨b5, p5, heq⟩
        have hv := congrArg Fin.val (rU108.wires.injective heq)
        dsimp [wBlock2, wBlock5] at hv
        have := b5.isLt; have := p5.isLt; omega
      dsimp only [gExp5]
      split_ifs
      · rw [Function.update_of_ne (fun h ↦ hnw5 ⟨_, _, h⟩)]
        dsimp only [gBase5]; exact ite_eq_right hnw5
      · dsimp only [gBase5]; exact ite_eq_right hnw5
  have hOpt2In : oneHotOptPreOp (OptBasePred P_q0 q1 q2) (act2Pred hm rCore) (bStar2Fn hm rCore)
      (uLoNuc2 hm rCore) (wBlock2 rU108) 0 (Nat.zero_le 2) * G_base2 = G_exp5 := by
    apply matrix_ext_ket; intro β
    simp only [G_base2, G_exp5, ← Matrix.mulVec_mulVec, oneHotOptPreOp, mkVecOp_mulVec_ket,
      oneHotOptPreVec]
    by_cases hP : P_start β
    · rw [ite_eq_left hP, ite_eq_left hP, mkVecOp_mulVec_ket]
      obtain ⟨_, _, hB2⟩ :=
        bankFwd_preSplits5_eval hm rCore rU108 hCU (gSeed β) (hSeed0 β hP) (hSeedPos β hP)
      have hw0 : ∀ b p, gBase2 β (wBlock2 rU108 b p) = 0 := fun b p ↦ ite_eq_left ⟨b, p, rfl⟩
      have hOB : OptBasePred P_q0 q1 q2 (gBase2 β) :=
        ⟨hBase2Tail β hP _, hBase2Tail β hP _, hBase2Tail β hP _⟩
      rw [ite_eq_left ⟨hOB, hw0⟩]
      have hActEq : act2Pred hm rCore (gBase2 β) ↔ act2Pred hm rCore (gSeed β) := by
        simp only [act2Pred, hBase2Core β hP]
      have hbSEq : bStar2Fn hm rCore (gBase2 β) = bStar2Fn hm rCore (gSeed β) := by
        simp only [bStar2Fn, hBase2Core β hP]
      by_cases hAct : act2Pred hm rCore (gSeed β)
      · have hp0Eq : (⟨idxValPrefix (uLoNuc2 hm rCore) (gBase2 β) 0 (Nat.zero_le 2),
            Nat.lt_of_lt_of_le (idxValPrefix_lt_two_pow (uLoNuc2 hm rCore) (gBase2 β) 0 (Nat.zero_le
              2))
              (Nat.pow_le_pow_right (by omega) (Nat.zero_le 2))⟩ : Fin (2 ^ 2)) =
            ⟨0, by decide⟩ := Fin.ext rfl
        rw [ite_eq_left (hActEq.mpr hAct), hbSEq, hp0Eq]
        congr 1; funext w
        by_cases hw : ∃ b p, w = wBlock2 rU108 b p
        · obtain ⟨b, p, rfl⟩ := hw
          rw [hExp5_w2 β hP b p]
          dsimp only [gPre]
          rw [hB2 b p]
          by_cases hbp : b = bStar2Fn hm rCore (gSeed β) ∧ p.val = 0
          · obtain ⟨rfl, hpv⟩ := hbp
            have hp0' : p = ⟨0, by decide⟩ := Fin.ext hpv
