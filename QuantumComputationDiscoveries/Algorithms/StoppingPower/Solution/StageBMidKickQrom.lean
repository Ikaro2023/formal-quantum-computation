theorem writeRegProg_slice268_eq (k : ℕ) {n : ℕ} (rMK : QRegister (174 + (94 + k)) n)
    (β : BitAssignment n) (f : BitAssignment 268 → BitAssignment 268) :
    let r268 := rMK.compose (slice268Sel k)
    writeRegProg β r268 (f (fun i ↦ β (r268 i))) =
      writeRegProg β rMK (liftBits268 k f (fun w ↦ β (rMK w))) := by
  intro r268
  funext q
  by_cases hmem : q ∈ Set.range rMK.wires
  · obtain ⟨w, rfl⟩ := hmem
    rw [writeRegProg_apply_reg]
    by_cases hw : w.val < 268
    · let i : Fin 268 := ⟨w.val, hw⟩
      have hwi : rMK w = r268 i := congrArg rMK (Fin.ext (by simp [i]))
      rw [hwi, writeRegProg_apply_reg]
      simp [liftBits268, hw, r268, i]
    · have hnot268 : rMK w ∉ Set.range r268.wires := by
        rintro ⟨i, hi⟩
        have hv := congrArg Fin.val (rMK.wires.injective hi)
        dsimp [r268] at hv
        omega
      rw [writeRegProg_apply_of_not_mem _ _ _ _ hnot268]
      simp [liftBits268, hw]
  · have hnot268 : q ∉ Set.range r268.wires := by
      rintro ⟨i, rfl⟩
      exact hmem ⟨slice268Sel k i, rfl⟩
    rw [writeRegProg_apply_of_not_mem _ _ _ _ hnot268,
      writeRegProg_apply_of_not_mem _ _ _ _ hmem]
theorem liftBits268_preserves (k : ℕ) {Inv₁ Inv₂ : BitAssignment 268 → Prop}
    (f : BitAssignment 268 → BitAssignment 268)
    (hpres : ∀ γ : BitAssignment 268, Inv₁ γ → Inv₂ (f γ))
    (γ : BitAssignment (174 + (94 + k))) (hγ : liftInv268 k Inv₁ γ) :
    liftInv268 k Inv₂ (liftBits268 k f γ) := by
  refine ⟨?_, fun w hw ↦ ?_⟩
  · have hsub : (fun i : Wire 268 ↦ liftBits268 k f γ ⟨i.val, by omega⟩) =
        f (fun i ↦ γ ⟨i.val, by omega⟩) :=
      funext fun i ↦ by simp [liftBits268, i.isLt]
    rw [hsub]
    exact hpres _ hγ.1
  · dsimp [liftBits268]
    rw [dite_eq_right (by omega)]
    exact hγ.2 w hw
theorem diagProj_mono_compose {M₁ M₂ n : ℕ} [NeZero (2 ^ n)] (rMK : QRegister M₂ n)
    (sel : QRegister M₁ M₂) (Inv₂ : BitAssignment M₂ → Prop) (Inv₁ : BitAssignment M₁ → Prop)
    (hImp : ∀ γ : BitAssignment M₂, Inv₂ γ → Inv₁ (fun i ↦ γ (sel i))) : p57DiagProj
    (rMK.compose sel) Inv₁ * p57DiagProj rMK Inv₂ = p57DiagProj rMK Inv₂ := by
  apply matrix_ext_ket; intro β
  rw [mul_mulVec_prog, ket_p57DiagProj]
  by_cases h : Inv₂ (fun idx ↦ β (rMK idx))
  · simp [h, ket_p57DiagProj, hImp _ h]
  · simp [h]
theorem realizes_lift_slice268 {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] (k : ℕ) (v : Var) (rMK : QRegister (174 + (94 + k)) n)
    (Inv : BitAssignment 268 → Prop) (c : DynamicCircuit Var n) (U : Unitary (2 ^ n)) (h :
    RealizesCleanUnitary v (p57DiagProj (rMK.compose (slice268Sel k)) Inv) c U) :
    RealizesCleanUnitary v (p57DiagProj rMK (liftInv268 k Inv)) c U :=
    RealizesCleanUnitary.mono_proj (p57DiagProj_conjTranspose _ _)
    (p57DiagProj_conjTranspose _ _) (diagProj_mono_compose rMK (slice268Sel k) (liftInv268 k
    Inv) Inv (fun _ hγ ↦ hγ.1)) h
/-! ## Section 3: Equivalence of `mk94MulAxisFull36` on `rMul` and `r268` -/
attribute [irreducible] mk94Pass01BodyBits
theorem diagProj_cleanRem_opt (k : ℕ) {n : ℕ} [NeZero (2 ^ n)]
    (rMK : QRegister (174 + (94 + k)) n) : projZeroAll (94 + k)
    (tailScr rMK (94 + k) (by omega)) = p57DiagProj rMK (liftInv268 k (cleanRem 268 94)) := by
  apply matrix_ext_ket; intro β
  rw [ket_projZeroAll, ket_p57DiagProj]
  by_cases hz : ∀ j : Fin (94 + k), β (tailScr rMK (94 + k) (by omega) j) = 0
  · have hcl : liftInv268 k (cleanRem 268 94) (fun u ↦ β (rMK u)) := by
      refine ⟨fun w hw ↦ ?_, fun u hu ↦ ?_⟩
      · have heq : rMK ⟨w.val, by omega⟩ =
            tailScr rMK (94 + k) (by omega) ⟨w.val - 174, by omega⟩ :=
          congrArg rMK (Fin.ext (by dsimp [tailScr]; omega))
        exact (congrArg β heq).trans (hz _)
      · have heq : rMK u = tailScr rMK (94 + k) (by omega) ⟨u.val - 174, by omega⟩ :=
          congrArg rMK (Fin.ext (by dsimp [tailScr]; omega))
        exact (congrArg β heq).trans (hz _)
    simp [hz, hcl]
  · have hncl : ¬ liftInv268 k (cleanRem 268 94) (fun u ↦ β (rMK u)) := fun ⟨h1, h2⟩ ↦ hz fun j ↦ by
      have heq : tailScr rMK (94 + k) (by omega) j = rMK ⟨174 + j.val, by omega⟩ :=
        congrArg rMK (Fin.ext (by dsimp [tailScr]; omega))
      rw [heq]
      by_cases hj : 174 + j.val < 268
      · exact h1 ⟨174 + j.val, hj⟩ (by dsimp; omega)
      · exact h2 ⟨174 + j.val, by omega⟩ (by dsimp; omega)
    simp [hz, hncl]
theorem diagProj_liftInvCleanU54 (k : ℕ) {n : ℕ} [NeZero (2 ^ n)]
    (rMK : QRegister (174 + (94 + k)) n) :
    let r268 := rMK.compose (slice268Sel k)
    p57DiagProj rMK (liftInv268 k mk94InvCleanU54) =
      projZeroAll 36 (fun r ↦ r268 (mk94Bank36W r)) *
        p57DiagProj rMK (liftInv268 k mk94InvU54) := by
  intro r268
  apply matrix_ext_ket; intro β
  rw [ket_p57DiagProj, mul_mulVec_prog, ket_p57DiagProj]
  by_cases hU : liftInv268 k mk94InvU54 (fun u ↦ β (rMK u))
  · by_cases hB : ∀ r : Fin 36, β (r268 (mk94Bank36W r)) = 0
    · have hCl : liftInv268 k mk94InvCleanU54 (fun u ↦ β (rMK u)) := ⟨⟨hU.1, hB⟩, hU.2⟩
      simp [hU, hB, hCl, ket_projZeroAll]
    · have hnCl : ¬ liftInv268 k mk94InvCleanU54 (fun u ↦ β (rMK u)) := fun h ↦ hB h.1.2
      simp [hU, hB, hnCl, ket_projZeroAll]
  · have hnCl : ¬ liftInv268 k mk94InvCleanU54 (fun u ↦ β (rMK u)) := fun h ↦ hU ⟨h.1.1, h.2⟩
    simp [hU, hnCl]
end
