      (u3 * b0 + c3 * tv) + (u4 * b0 + c4 * tv) +
      ((2 + th4 + s0v) + (b0 + ca * tv)) =
    s0v + ((c0 + c1 + c2 + c3 + c4) + ca) * tv := by
  intro b0 tv th4
  have hBase0 : (2 + th4) + 218 * b0 = 0 := by
    dsimp only [b0, th4]; fin_cases th <;> decide
