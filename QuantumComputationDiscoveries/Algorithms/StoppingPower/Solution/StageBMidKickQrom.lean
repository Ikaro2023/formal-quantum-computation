      have hw1 : wBlock5 rU108 1 0 = rU108 32 := rfl
      have hw2 : wBlock5 rU108 2 0 = rU108 64 := rfl
      have hv0 : γ₄ (rU108 0) = (1 + γ (c 6)) * (1 + γ (c 7)) * γ (rU108 0) := by
        rw [hs4, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs3, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs2, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs1, Function.update_self, hc0, hs0, Function.update_self]
        ring
      have hv1 : γ₄ (rU108 32) = γ (c 6) * (1 + γ (c 7)) * γ (rU108 0) := by
        rw [hs4, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs3, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs2, Function.update_self, hc1, hs1,
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs0, Function.update_of_ne (rU108.wires.injective.ne (by decide)), Function.update_self]
        ring
      have hv2 : γ₄ (rU108 64) = (1 + γ (c 6)) * γ (c 7) * γ (rU108 0) := by
        rw [hs4, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs3, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs2, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          Function.update_of_ne (rU108.wires.injective.ne (by decide)),
          hs1, Function.update_of_ne (rU108.wires.injective.ne (by decide)), Function.update_self,
          hc0, hs0, Function.update_self]
        ring
      have hSeed0' : γ (rU108 0) = if en = true then 1 else 0 := hSeed0
      rcases bit_cases (γ (c 6)) with hc6 | hc6 <;> rcases bit_cases (γ (c 7)) with hc7 | hc7
      · have hval6 : (γc (rNucIdx hm (QRegExt.idReg _) 6)).val = 0 := by
          change (γ (c 6)).val = 0; simp [hc6]
        have hval7 : (γc (rNucIdx hm (QRegExt.idReg _) 7)).val = 0 := by
          change (γ (c 7)).val = 0; simp [hc7]
        have hlt96 : regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 < 32 := by omega
        have hlt216 : regVal (rNucIdx hm (QRegExt.idReg _)) γc < 216 := by omega
        have hdiv : regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 / 32 = 0 := by omega
        have hbS : bStar5Fn hm rCore γ = 0 := bStar5Fn_eq_of_div hm rCore γ 0 hdiv
