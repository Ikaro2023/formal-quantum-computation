/-- Total register width `(89 + (B + 1)) + (B + 10)` for Stage B of `dKickZeroSub37Opt` (`1 ≤ B ≤
  27`). -/
abbrev mBAux (B : ℕ) : ℕ := (89 + (B + 1)) + (B + 10)
/-- Clean `(B + 10)`-wire prefix `rSub[0..B+10)` (`rScr[3..B+13)`) used by Stage B (`B + 13 ≤
  mScr`). -/
abbrev rSubBAux {n mScr : ℕ} (B : ℕ) (hm20 : 20 ≤ mScr) (hmB : B + 13 ≤ mScr)
    (rScr : QRegister mScr n) : QRegister (B + 10) n :=
  (rSubAux hm20 rScr).slice 0 (B + 10) (by omega)
theorem rAct89_disjoint_rOutTop {n mScr : ℕ} (B : ℕ) (hm20 : 20 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rOutTop : QRegister (B + 1) n) (rScr : QRegister mScr n)
    (hCOut : rCore.DisjointWires rOutTop) (hCS : rCore.DisjointWires rScr)
    (hOutS : rOutTop.DisjointWires rScr) :
    (rAct89Aux hm20 rCore rScr hCS).DisjointWires rOutTop := by
  have h1 : (mk34_rCoreHi86 rCore).DisjointWires rOutTop := hCOut.compose_left _
  have h2 : (rHold3Aux hm20 rScr).DisjointWires rOutTop :=
    (QRegExt.disjointWires_symm (hOutS.compose_right _))
  exact QRegister.disjoint_iff.mpr fun a b heq ↦
    Fin.addCases (m := 86) (n := 3)
      (motive := fun a ↦ rAct89Aux hm20 rCore rScr hCS a = rOutTop b → False)
      (fun i hi ↦ h1.ne i b ((QRegister.concat_apply_left _ _ _ i).symm.trans hi))
      (fun j hj ↦ h2.ne j b ((QRegister.concat_apply_right _ _ _ j).symm.trans hj))
      a heq
/-- Active `(89 + (B + 1))`-wire register `rAct89 ++ rOutTop` for Stage B. -/
abbrev rActBAux {n mScr : ℕ} (B : ℕ) (hm20 : 20 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rOutTop : QRegister (B + 1) n) (rScr : QRegister mScr n)
    (hCOut : rCore.DisjointWires rOutTop) (hCS : rCore.DisjointWires rScr)
    (hOutS : rOutTop.DisjointWires rScr) : QRegister (89 + (B + 1)) n :=
  (rAct89Aux hm20 rCore rScr hCS).concat rOutTop
    (rAct89_disjoint_rOutTop B hm20 rCore rOutTop rScr hCOut hCS hOutS)
theorem rActB_disjoint_rSubB {n mScr : ℕ} (B : ℕ) (hm20 : 20 ≤ mScr) (hmB : B + 13 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rOutTop : QRegister (B + 1) n) (rScr : QRegister mScr n)
    (hCOut : rCore.DisjointWires rOutTop) (hCS : rCore.DisjointWires rScr)
    (hOutS : rOutTop.DisjointWires rScr) :
    (rActBAux B hm20 rCore rOutTop rScr hCOut hCS hOutS).DisjointWires
      (rSubBAux B hm20 hmB rScr) := by
  have h1 : (mk34_rCoreHi86 rCore).DisjointWires (rSubBAux B hm20 hmB rScr) :=
    ((hCS.compose_left _).compose_right _).compose_right _
  have h2 : (rHold3Aux hm20 rScr).DisjointWires (rSubBAux B hm20 hmB rScr) :=
    (rHold3_disjoint_rSub hm20 rScr).compose_right _
  have hAct89 : (rAct89Aux hm20 rCore rScr hCS).DisjointWires (rSubBAux B hm20 hmB rScr) :=
    QRegister.disjoint_iff.mpr fun a b heq ↦
      Fin.addCases (m := 86) (n := 3)
        (motive := fun a ↦
          rAct89Aux hm20 rCore rScr hCS a = rSubBAux B hm20 hmB rScr b → False)
        (fun i hi ↦ h1.ne i b ((QRegister.concat_apply_left _ _ _ i).symm.trans hi))
        (fun j hj ↦ h2.ne j b ((QRegister.concat_apply_right _ _ _ j).symm.trans hj))
        a heq
  have hOut : rOutTop.DisjointWires (rSubBAux B hm20 hmB rScr) :=
    (hOutS.compose_right _).compose_right _
  exact QRegister.disjoint_iff.mpr fun a b heq ↦
    Fin.addCases (m := 89) (n := B + 1)
      (motive := fun a ↦
        rActBAux B hm20 rCore rOutTop rScr hCOut hCS hOutS a =
          rSubBAux B hm20 hmB rScr b → False)
      (fun i hi ↦ hAct89.ne i b ((QRegister.concat_apply_left _ _ _ i).symm.trans hi))
      (fun j hj ↦ hOut.ne j b ((QRegister.concat_apply_right _ _ _ j).symm.trans hj))
      a heq
/-- Combined `(mBAux B)`-wire register `rActB ++ rSubB` for Stage B. -/
