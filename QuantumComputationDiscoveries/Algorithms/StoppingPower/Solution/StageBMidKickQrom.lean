theorem cliff_self_inv_onRegister {M n : ℕ} (rComb : QRegister M n)
    (c : CliffProg M) (hinv : c.inv = c) :
    let U_c := ((c.onRegister rComb).toCircuit).eval
    U_c * U_c = 1 ∧ U_c.1ᴴ = U_c.1 := by
  intro U_c
  have h1 : U_c * U_c = 1 := by
    apply Subtype.ext
    apply matrix_ext_ket; intro β
    rw [Submonoid.coe_mul, Submonoid.coe_one, mul_mulVec_prog, Matrix.one_mulVec]
    have hket : ∀ δ : BitAssignment n,
        U_c.1.mulVec (ket δ) = ket (writeRegProg δ rComb (c.eval (fun i ↦ δ (rComb i)))) := by
      intro δ
      have h := eval_onRegister_prog_ket rComb (.cliff c) δ
      simpa [TempPhaseProg.onRegister, TempPhaseProg.toToffCircuit,
        TempPhaseProg.evalSign, TempPhaseProg.evalBits] using h
    rw [hket, hket]
    apply congrArg ket
    funext w
    by_cases hmem : w ∈ Set.range rComb.wires
    · obtain ⟨i, rfl⟩ := hmem
      rw [writeRegProg_apply_reg]
      have hreg : (fun j ↦ writeRegProg β rComb (c.eval (fun k ↦ β (rComb k))) (rComb j)) =
          c.eval (fun k ↦ β (rComb k)) :=
        funext fun j ↦ writeRegProg_apply_reg _ _ _ j
      have hc2 : c.eval (c.eval (fun k ↦ β (rComb k))) = fun k ↦ β (rComb k) := by
        have h0 := CliffProg.inv_eval c (fun k ↦ β (rComb k))
        rwa [hinv] at h0
      rw [hreg, congrFun hc2 i]
    · rw [writeRegProg_apply_of_not_mem _ _ _ _ hmem,
        writeRegProg_apply_of_not_mem _ _ _ _ hmem]
  have h_mat : U_c.1 * U_c.1 = 1 := congrArg Subtype.val h1
  refine ⟨h1, ?_⟩
  calc U_c.1ᴴ = U_c.1ᴴ * (U_c.1 * U_c.1) := by rw [h_mat, Matrix.mul_one]
    _ = (U_c.1ᴴ * U_c.1) * U_c.1 := by rw [Matrix.mul_assoc]
    _ = U_c.1 := by rw [unitary_coe_star_mul_self U_c, Matrix.one_mul]
theorem realizesCleanUnitary_wrapCliffAlloc
    {Var : Type} [Fintype Var] [DecidableEq Var] {M n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rComb : QRegister M n) (c : CliffProg M) (hinv : c.inv = c)
    (K : TempCtx M)
    (P_all : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (hPall_herm : P_allᴴ = P_all) (hPall_idem : P_all * P_all = P_all)
    (dInner : DynamicCircuit Var n) (U_body : Unitary (2 ^ n))
    (hBody : RealizesCleanUnitary v
      ((((c.onRegister rComb).toCircuit).eval).1 * P_all *
        (((c.onRegister rComb).toCircuit).eval).1ᴴ)
      (p57ToDynWith v rComb dInner K) U_body)
    (hBodyPres :
      let U_c := ((c.onRegister rComb).toCircuit).eval
      let P_body := U_c.1 * P_all * U_c.1ᴴ
      P_body * (U_body.1 * P_body) = U_body.1 * P_body) :
    let U_c := ((c.onRegister rComb).toCircuit).eval
    let V := U_c * U_body * U_c
    RealizesCleanUnitary v P_all
      (p57ToDynWith v rComb dInner ((ctxCliffAlloc c).append K))
      V ∧
      P_all * (V.1 * P_all) = V.1 * P_all := by
  intro U_c V
  let P_body := U_c.1 * P_all * U_c.1ᴴ
  obtain ⟨hU_sq, hU_symm⟩ := cliff_self_inv_onRegister rComb c hinv
  have hU_sq_mat : U_c.1 * U_c.1 = 1 := congrArg Subtype.val hU_sq
  have hPb_herm : P_bodyᴴ = P_body := conj_hermitian hPall_herm U_c
  have hUPb : U_c.1 * P_body = P_all * U_c.1 := by
    dsimp [P_body]
    rw [hU_symm, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hU_sq_mat, Matrix.one_mul]
  have hPbU : P_body * U_c.1 = U_c.1 * P_all := by
    dsimp [P_body]
    rw [Matrix.mul_assoc, unitary_coe_star_mul_self U_c, Matrix.mul_one]
  have hStep1 : P_body * (U_c.1 * P_all) = U_c.1 * P_all := by
    dsimp [P_body]
    calc (U_c.1 * P_all * U_c.1ᴴ) * (U_c.1 * P_all)
        = U_c.1 * P_all * (U_c.1ᴴ * U_c.1) * P_all := by simp only [Matrix.mul_assoc]
      _ = U_c.1 * (P_all * P_all) := by
        rw [unitary_coe_star_mul_self U_c, Matrix.mul_one, Matrix.mul_assoc]
      _ = U_c.1 * P_all := by rw [hPall_idem]
  have h1_herm : (1 : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)ᴴ = 1 := conjTranspose_one
  have hR23 := RealizesCleanUnitary_seq_asym hPb_herm h1_herm
    hBody
    (RealizesCleanUnitary.circuit v 1 (((c.inv).onRegister rComb).toCircuit))
    (Matrix.one_mul _)
  have hinv_eq : (((c.inv).onRegister rComb).toCircuit).eval = U_c := by
    rw [hinv]
  rw [hinv_eq] at hR23
  have hR123 := RealizesCleanUnitary_seq_asym hPall_herm hPb_herm
    (RealizesCleanUnitary.circuit v P_all ((c.onRegister rComb).toCircuit))
    hR23 hStep1
  have hDyn_eq : p57ToDynWith v rComb dInner ((ctxCliffAlloc c).append K) =
      .seq (.circuit ((c.onRegister rComb).toCircuit))
        (.seq (p57ToDynWith v rComb dInner K)
          (.circuit (((c.inv).onRegister rComb).toCircuit))) := rfl
  rw [← hDyn_eq] at hR123
  have hV_pres : P_all * (V.1 * P_all) = V.1 * P_all := by
    calc P_all * (V.1 * P_all)
        = (P_all * U_c.1) * U_body.1 * (U_c.1 * P_all) := by
            dsimp [V]; simp only [Matrix.mul_assoc]
      _ = (U_c.1 * P_body) * U_body.1 * (P_body * U_c.1) := by
            rw [← hUPb, ← hPbU]
      _ = U_c.1 * (P_body * (U_body.1 * P_body)) * U_c.1 := by
            simp only [Matrix.mul_assoc]
      _ = U_c.1 * (U_body.1 * P_body) * U_c.1 := by
            rw [hBodyPres]
      _ = U_c.1 * U_body.1 * (P_body * U_c.1) := by
            simp only [Matrix.mul_assoc]
      _ = U_c.1 * U_body.1 * (U_c.1 * P_all) := by
            rw [hPbU]
      _ = V.1 * P_all := by
            dsimp [V]; simp only [Matrix.mul_assoc]
  exact ⟨hR123, hV_pres⟩
def ctxPreUnitary {M n : ℕ} (rComb : QRegister M n) : TempCtx M → Unitary (2 ^ n)
  | .hole => 1
  | .seqPre c K => ctxPreUnitary rComb K * ((c.onRegister rComb).toCircuit).eval
  | .seqPost K _ => ctxPreUnitary rComb K
  | .tempAnd c₁ c₂ anc h₁₂ h₁a h₂a K =>
      ctxPreUnitary rComb K *
        (Circuit.TOFF (rComb c₁) (rComb c₂) (rComb anc)
          (rComb.wires.injective.ne h₁₂)
          (rComb.wires.injective.ne h₁a)
          (rComb.wires.injective.ne h₂a)).eval
theorem ctxPreUnitary_append {M n : ℕ} (rComb : QRegister M n) :
    ∀ (F G : TempCtx M),
      ctxPreUnitary rComb (F.append G) = ctxPreUnitary rComb G * ctxPreUnitary rComb F
  | .hole, _ => by simp [TempCtx.append, ctxPreUnitary]
  | .seqPre c K, G => by
      dsimp only [TempCtx.append, ctxPreUnitary]
      rw [ctxPreUnitary_append rComb K G, mul_assoc]
  | .seqPost K _, G => by
      dsimp only [TempCtx.append, ctxPreUnitary]
      exact ctxPreUnitary_append rComb K G
  | .tempAnd _ _ _ _ _ _ K, G => by
      dsimp only [TempCtx.append, ctxPreUnitary]
      rw [ctxPreUnitary_append rComb K G, mul_assoc]
theorem writeRegProg_idem {M n : ℕ} (β : BitAssignment n) (rComb : QRegister M n)
    (γ₁ γ₂ : BitAssignment M) :
    writeRegProg (writeRegProg β rComb γ₁) rComb γ₂ = writeRegProg β rComb γ₂ := by
  funext w
  by_cases hmem : w ∈ Set.range rComb.wires
  · obtain ⟨i, rfl⟩ := hmem
    rw [writeRegProg_apply_reg, writeRegProg_apply_reg]
  · rw [writeRegProg_apply_of_not_mem _ _ _ _ hmem,
      writeRegProg_apply_of_not_mem _ _ _ _ hmem,
      writeRegProg_apply_of_not_mem _ _ _ _ hmem]
theorem writeRegProg_reg_fn {M n : ℕ} (β : BitAssignment n) (rComb : QRegister M n)
    (γ : BitAssignment M) :
    (fun i ↦ writeRegProg β rComb γ (rComb i)) = γ :=
  funext fun i ↦ writeRegProg_apply_reg β rComb γ i
theorem ctxPreUnitary_mulVec_ket {M n : ℕ} (rComb : QRegister M n) :
    ∀ (K : TempCtx M) (β : BitAssignment n),
      (ctxPreUnitary rComb K).1.mulVec (ket β) =
        ket (writeRegProg β rComb (K.fwdBits (fun i ↦ β (rComb i))))
  | .hole, β => by
      dsimp only [ctxPreUnitary, TempCtx.fwdBits]
      rw [Submonoid.coe_one, Matrix.one_mulVec, writeRegProg_id]
  | .seqPre c K, β => by
      dsimp only [ctxPreUnitary, TempCtx.fwdBits]
      have hc : (((c.onRegister rComb).toCircuit).eval).1.mulVec (ket β) =
          ket (writeRegProg β rComb (c.eval (fun i ↦ β (rComb i)))) := by
        have h := eval_onRegister_prog_ket rComb (.cliff c) β
        simpa [TempPhaseProg.onRegister, TempPhaseProg.toToffCircuit,
          TempPhaseProg.evalSign, TempPhaseProg.evalBits] using h
      rw [Submonoid.coe_mul, mul_mulVec_prog, hc,
        ctxPreUnitary_mulVec_ket rComb K, writeRegProg_reg_fn, writeRegProg_idem]
  | .seqPost K _, β => ctxPreUnitary_mulVec_ket rComb K β
  | .tempAnd c₁ c₂ anc h₁₂ h₁a h₂a K, β => by
      dsimp only [ctxPreUnitary, TempCtx.fwdBits]
      let γ : BitAssignment M := fun i ↦ β (rComb i)
      let γ₁ : BitAssignment M := Function.update γ anc (γ anc + γ c₁ * γ c₂)
      have hT : (Circuit.TOFF (rComb c₁) (rComb c₂) (rComb anc)
            (rComb.wires.injective.ne h₁₂)
            (rComb.wires.injective.ne h₁a)
            (rComb.wires.injective.ne h₂a)).eval.1.mulVec (ket β) =
          ket (writeRegProg β rComb γ₁) := by
        rw [ket_TOFF]
        apply congrArg ket
        funext w
        by_cases hw : w = rComb anc
        · subst hw
          rw [Function.update_self, writeRegProg_apply_reg]
          dsimp [γ₁, γ]; rw [Function.update_self]
        · rw [Function.update_of_ne hw]
          by_cases hmem : w ∈ Set.range rComb.wires
          · obtain ⟨i, rfl⟩ := hmem
            have hne_i : i ≠ anc := fun h ↦ hw (congrArg rComb.wires h)
            rw [writeRegProg_apply_reg]
            dsimp [γ₁, γ]; rw [Function.update_of_ne hne_i]
          · exact (writeRegProg_apply_of_not_mem _ _ _ _ hmem).symm
      rw [Submonoid.coe_mul, mul_mulVec_prog, hT,
        ctxPreUnitary_mulVec_ket rComb K, writeRegProg_reg_fn, writeRegProg_idem]
theorem ctxMicroRun_p57ToDynWith_realizes
    {Var : Type} [Fintype Var] [DecidableEq Var] {M n nIn : ℕ} [NeZero (2 ^ n)]
    (v : Var) (rComb : QRegister M n)
    (inW : Fin nIn → Wire M) (hin_inj : Function.Injective inW)
    (cur : ℕ) (hin_lt : ∀ i, (inW i).val < cur)
    (dInner : DynamicCircuit Var n) (U_inner : Unitary (2 ^ n)) :
    ∀ (ops : List MicroOp) (top : ℕ) (hn : nIn ≤ top)
      (hv : microValid top ops = true)
      (hcur : cur + (top - nIn) + microAllocs ops ≤ M)
      (P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ),
      let K := ctxMicroRun inW hin_inj cur hin_lt top hn ops hv hcur
      let U_pre := ctxPreUnitary rComb K
      let P_hole := U_pre.1 * P * U_pre.1ᴴ
      Pᴴ = P →
      P * P = P →
      (∀ k : Fin (microAllocs ops),
        (QRegister.singleton (rComb ⟨cur + (top - nIn) + k.val, by
          omega⟩)).basisOutcomeProjector 0 * P = P) →
      RealizesCleanUnitary v P_hole dInner U_inner →
      P_hole * (U_inner.1 * P_hole) = U_inner.1 * P_hole →
      RealizesCleanUnitary v P (p57ToDynWith v rComb dInner K) (star U_pre * U_inner * U_pre) ∧
        P * ((star U_pre * U_inner * U_pre).1 * P) = (star U_pre * U_inner * U_pre).1 * P
 := by
  intro ops; induction ops with
  | nil =>
      intro top hn hv hcur P K U_pre P_hole _ _ hClean hIn hPres
      dsimp only [K, U_pre, P_hole, ctxMicroRun, ctxPreUnitary, p57ToDynWith] at hIn hPres ⊢
      rw [Submonoid.coe_one, conjTranspose_one, Matrix.one_mul, Matrix.mul_one] at hIn hPres
      rw [star_one, one_mul, mul_one]
      exact ⟨hIn, hPres⟩
  | cons op rest ih =>
      intro top hn hv hcur P K U_pre P_hole hPherm hPidem hClean hIn hPres
      dsimp only [K, U_pre, P_hole] at hIn hPres ⊢
      cases op with
      | notW a =>
      have ha := (microValid_notW hv).1
      have hvR := (microValid_notW hv).2
      dsimp only [microAllocs] at hcur hClean
      let wA := microWire inW cur a (fun _ ↦ by omega)
      have hwA_lt : wA.val < cur + (top - nIn) := microWire_val_lt inW cur hin_lt hn ha (by omega)
      let c := CliffProg.x wA
      let U_c := ((c.onRegister rComb).toCircuit).eval
      let P' := U_c.1 * P * U_c.1ᴴ
      let K_rest := ctxMicroRun inW hin_inj cur hin_lt top hn rest hvR hcur
      let U_rest := ctxPreUnitary rComb K_rest
      have hinv : c.inv = c := rfl
      obtain ⟨hU_sq, hU_symm⟩ := cliff_self_inv_onRegister rComb c hinv
      have hU_star : star U_c = U_c := Subtype.ext hU_symm
      have hPreEq : ctxPreUnitary rComb (ctxMicroRun inW hin_inj cur hin_lt top hn (.notW a :: rest)
        hv hcur) =
          U_rest * U_c := by
        dsimp only [ctxMicroRun]
        rw [ctxPreUnitary_append]
        dsimp only [ctxCliffAlloc, ctxPreUnitary]
        rw [one_mul]
      have hPholeEq : (U_rest * U_c).1 * P * (U_rest * U_c).1ᴴ = U_rest.1 * P' * U_rest.1ᴴ := by
        dsimp only [P']
        simp only [Submonoid.coe_mul, conjTranspose_mul, Matrix.mul_assoc]
      rw [hPreEq, hPholeEq] at hIn hPres
      have hClean' : ∀ k : Fin (microAllocs rest),
          (QRegister.singleton (rComb ⟨cur + (top - nIn) + k.val, by
            omega⟩)).basisOutcomeProjector 0 * P' = P' := by
        intro k
        have hne : rComb wA ≠ rComb ⟨cur + (top - nIn) + k.val, by omega⟩ :=
          rComb.wires.injective.ne (wire_ne_of_lt (Nat.lt_of_lt_of_le hwA_lt (by dsimp; omega)))
        exact basisOutcomeProjector_zero_mul_conj _ U_c P
          (basisOutcomeProjector_zero_comm_x _ (rComb wA) hne) (hClean k)
      obtain ⟨ihR, ihP⟩ :=
        ih top hn hvR hcur P' (conj_hermitian hPherm U_c) (conj_idempotent hPidem U_c) hClean' hIn
        hPres
      obtain ⟨hWrapR, hWrapP⟩ :=
        realizesCleanUnitary_wrapCliffAlloc v rComb c hinv K_rest P hPherm hPidem
        dInner (star U_rest * U_inner * U_rest) ihR ihP
      have hV_eq : U_c * (star U_rest * U_inner * U_rest) * U_c =
          star (U_rest * U_c) * U_inner * (U_rest * U_c) := by
        rw [star_mul, hU_star]; simp only [mul_assoc]
      rw [hPreEq, ← hV_eq]
      exact ⟨hWrapR, hWrapP⟩
      | cnotW a b =>
      have h := microValid_cnotW hv
      have ha := h.1; have hb := h.2.1; have hab := h.2.2.1; have hvR := h.2.2.2
      dsimp only [microAllocs] at hcur hClean
      let wA := microWire inW cur a (fun _ ↦ by omega)
      let wB := microWire inW cur b (fun _ ↦ by omega)
      have hwA_lt : wA.val < cur + (top - nIn) := microWire_val_lt inW cur hin_lt hn ha (by omega)
      have hwB_lt : wB.val < cur + (top - nIn) := microWire_val_lt inW cur hin_lt hn hb (by omega)
      let c := CliffProg.cnot wA wB (microWire_ne inW hin_inj cur hin_lt hab _ _)
      let U_c := ((c.onRegister rComb).toCircuit).eval
      let P' := U_c.1 * P * U_c.1ᴴ
      let K_rest := ctxMicroRun inW hin_inj cur hin_lt top hn rest hvR hcur
      let U_rest := ctxPreUnitary rComb K_rest
      have hinv : c.inv = c := rfl
      obtain ⟨hU_sq, hU_symm⟩ := cliff_self_inv_onRegister rComb c hinv
      have hU_star : star U_c = U_c := Subtype.ext hU_symm
      have hPreEq : ctxPreUnitary rComb (ctxMicroRun inW hin_inj cur hin_lt top hn (.cnotW a b ::
        rest) hv hcur) =
          U_rest * U_c := by
        dsimp only [ctxMicroRun]
        rw [ctxPreUnitary_append]
        dsimp only [ctxCliffAlloc, ctxPreUnitary]
        rw [one_mul]
      have hPholeEq : (U_rest * U_c).1 * P * (U_rest * U_c).1ᴴ = U_rest.1 * P' * U_rest.1ᴴ := by
        dsimp only [P']
        simp only [Submonoid.coe_mul, conjTranspose_mul, Matrix.mul_assoc]
      rw [hPreEq, hPholeEq] at hIn hPres
      have hClean' : ∀ k : Fin (microAllocs rest),
          (QRegister.singleton (rComb ⟨cur + (top - nIn) + k.val, by
            omega⟩)).basisOutcomeProjector 0 * P' = P' := by
        intro k
        have hneA : rComb wA ≠ rComb ⟨cur + (top - nIn) + k.val, by omega⟩ :=
          rComb.wires.injective.ne (wire_ne_of_lt (Nat.lt_of_lt_of_le hwA_lt (by dsimp; omega)))
        have hneB : rComb wB ≠ rComb ⟨cur + (top - nIn) + k.val, by omega⟩ :=
          rComb.wires.injective.ne (wire_ne_of_lt (Nat.lt_of_lt_of_le hwB_lt (by dsimp; omega)))
        exact basisOutcomeProjector_zero_mul_conj _ U_c P
          (basisOutcomeProjector_zero_comm_cnot _ (rComb wA) (rComb wB) _ hneA hneB) (hClean k)
      obtain ⟨ihR, ihP⟩ :=
        ih top hn hvR hcur P' (conj_hermitian hPherm U_c) (conj_idempotent hPidem U_c) hClean' hIn
        hPres
      obtain ⟨hWrapR, hWrapP⟩ :=
        realizesCleanUnitary_wrapCliffAlloc v rComb c hinv K_rest P hPherm hPidem
        dInner (star U_rest * U_inner * U_rest) ihR ihP
      have hV_eq : U_c * (star U_rest * U_inner * U_rest) * U_c =
          star (U_rest * U_c) * U_inner * (U_rest * U_c) := by
        rw [star_mul, hU_star]; simp only [mul_assoc]
      rw [hPreEq, ← hV_eq]
      exact ⟨hWrapR, hWrapP⟩
      | andAlloc a b =>
      have h := microValid_andAlloc hv
      have ha := h.1; have hb := h.2.1; have hab := h.2.2.1; have hvR := h.2.2.2
      have hcur' : cur + (top + 1 - nIn) + microAllocs rest ≤ M := by
        dsimp [microAllocs] at hcur; omega
      let curTop := cur + (top - nIn)
      let wA := microWire inW cur a (fun _ ↦ by dsimp [microAllocs] at hcur; omega)
      let wB := microWire inW cur b (fun _ ↦ by dsimp [microAllocs] at hcur; omega)
      let anc : Wire M := ⟨curTop, by dsimp [curTop]; dsimp [microAllocs] at hcur; omega⟩
      have hwA_lt : wA.val < curTop :=
        microWire_val_lt inW cur hin_lt hn ha (by dsimp [microAllocs] at hcur; omega)
      have hwB_lt : wB.val < curTop :=
        microWire_val_lt inW cur hin_lt hn hb (by dsimp [microAllocs] at hcur; omega)
      have h₁₂ : wA ≠ wB := microWire_ne inW hin_inj cur hin_lt hab _ _
      have h₁a : wA ≠ anc := wire_ne_of_lt hwA_lt
      have h₂a : wB ≠ anc := wire_ne_of_lt hwB_lt
      let T_anc := (Circuit.TOFF (rComb wA) (rComb wB) (rComb anc)
        (rComb.wires.injective.ne h₁₂)
        (rComb.wires.injective.ne h₁a)
        (rComb.wires.injective.ne h₂a)).eval
      let P' := T_anc.1 * P * T_anc.1ᴴ
      let K_rest := ctxMicroRun inW hin_inj cur hin_lt (top + 1) (by omega) rest hvR hcur'
      let U_rest := ctxPreUnitary rComb K_rest
      have hT_sq : T_anc * T_anc = 1 := toffoli_eval_sq _ _ _ _ _ _
      have hT_sq_mat : T_anc.1 * T_anc.1 = 1 := congrArg Subtype.val hT_sq
      have hT_symm : T_anc.1ᴴ = T_anc.1 := by
        calc T_anc.1ᴴ = T_anc.1ᴴ * (T_anc.1 * T_anc.1) := by rw [hT_sq_mat, Matrix.mul_one]
          _ = (T_anc.1ᴴ * T_anc.1) * T_anc.1 := by rw [Matrix.mul_assoc]
          _ = T_anc.1 := by rw [unitary_coe_star_mul_self T_anc, Matrix.one_mul]
      have hT_star : star T_anc = T_anc := Subtype.ext hT_symm
      have hPreEq : ctxPreUnitary rComb (ctxMicroRun inW hin_inj cur hin_lt top hn (.andAlloc a b ::
        rest) hv hcur) =
          U_rest * T_anc := by
        dsimp only [ctxMicroRun]
        rw [ctxPreUnitary_append]
        dsimp only [ctxTempBit, ctxPreUnitary]
        rw [one_mul]
      have hPholeEq : (U_rest * T_anc).1 * P * (U_rest * T_anc).1ᴴ = U_rest.1 * P' * U_rest.1ᴴ := by
        dsimp only [P']
        simp only [Submonoid.coe_mul, conjTranspose_mul, Matrix.mul_assoc]
      rw [hPreEq, hPholeEq] at hIn hPres
      have hClean0 : (QRegister.singleton (rComb anc)).basisOutcomeProjector 0 * P = P := by
        have h0 := hClean ⟨0, by dsimp [microAllocs]; omega⟩
        have hanc_eq : (⟨cur + (top - nIn) + 0, by omega⟩ : Wire M) = anc :=
          Fin.ext (Nat.add_zero _)
        rwa [hanc_eq] at h0
      have hClean' : ∀ k : Fin (microAllocs rest),
          (QRegister.singleton (rComb ⟨cur + (top + 1 - nIn) + k.val, by
            omega⟩)).basisOutcomeProjector 0 * P' = P' := by
        intro k
        have hk_succ : (⟨cur + (top + 1 - nIn) + k.val, by omega⟩ : Wire M) =
            ⟨cur + (top - nIn) + (k.val + 1), by dsimp [microAllocs] at hcur; omega⟩ :=
          Fin.ext (by dsimp; omega)
        have hne_anc : rComb anc ≠ rComb ⟨cur + (top + 1 - nIn) + k.val, by omega⟩ :=
          rComb.wires.injective.ne (wire_ne_of_lt (by dsimp [anc, curTop]; omega))
        rw [hk_succ] at hne_anc ⊢
        exact basisOutcomeProjector_zero_mul_conj _ T_anc P
          (basisOutcomeProjector_zero_comm_toff _ _ _ (rComb anc) _ _ _ hne_anc)
          (hClean ⟨k.val + 1, by dsimp [microAllocs]; omega⟩)
      obtain ⟨ihR, ihP⟩ :=
        ih (top +
        1) (by omega) hvR hcur' P' (conj_hermitian hPherm T_anc) (conj_idempotent hPidem T_anc)
        hClean' hIn hPres
      obtain ⟨hWrapR, hWrapP⟩ := realizesCleanUnitary_wrapAnd v (rComb wA) (rComb wB) (rComb anc)
        (rComb.wires.injective.ne h₁₂) (rComb.wires.injective.ne h₁a) (rComb.wires.injective.ne h₂a)
        P hPherm _ rfl hClean0 (p57ToDynWith v rComb dInner K_rest) (star U_rest * U_inner *
          U_rest) ihR ihP
      have hV_eq : T_anc * (star U_rest * U_inner * U_rest) * T_anc =
          star (U_rest * T_anc) * U_inner * (U_rest * T_anc) := by
        rw [star_mul, hT_star]; simp only [mul_assoc]
      rw [hPreEq, ← hV_eq]
      exact ⟨hWrapR, hWrapP⟩
      | zeroAlloc =>
      have hvR : microValid (top + 1) rest = true := by simpa [microValid] using hv
      have hcur' : cur + (top + 1 - nIn) + microAllocs rest ≤ M := by
        dsimp [microAllocs] at hcur; omega
      have hClean' : ∀ k : Fin (microAllocs rest),
          (QRegister.singleton (rComb ⟨cur + (top + 1 - nIn) + k.val, by
            omega⟩)).basisOutcomeProjector 0 * P = P := by
        intro k
        have hk_succ : (⟨cur + (top + 1 - nIn) + k.val, by omega⟩ : Wire M) =
            ⟨cur + (top - nIn) + (k.val + 1), by dsimp [microAllocs] at hcur; omega⟩ :=
          Fin.ext (by dsimp; omega)
        rw [hk_succ]
        exact hClean ⟨k.val + 1, by dsimp [microAllocs]; omega⟩
      exact ih (top + 1) (by omega) hvR hcur' P hPherm hPidem hClean' hIn hPres
theorem le_of_cleanRem_imp {M rem remMid : ℕ} (hM : remMid ≤ M)
    (himp : ∀ β : BitAssignment M, cleanRem M rem β → cleanRem M remMid β) :
    remMid ≤ rem := by
  by_contra hlt
  let β : BitAssignment M := fun w ↦ if w.val = M - remMid then 1 else 0
  have hcl : cleanRem M rem β := fun w hw ↦ by
    dsimp [β]; rw [ite_eq_right (by omega)]
  have h0 := himp β hcl ⟨M - remMid, by omega⟩ (le_refl _)
  dsimp [β] at h0
  rw [ite_eq_left rfl] at h0
  exact one_ne_zero h0
theorem validCleanRem_of_ctxCliffAlloc_plug {M rem : ℕ} (_hrem : rem ≤ M)
    (c : CliffProg M) (hinv : c.inv = c) (hsupp : c.SupportsBelow (M - rem))
    (K : TempCtx M) (p : TempPhaseProg M)
    (hv : ValidCleanRem M rem (((ctxCliffAlloc c).append K).plug p)) :
    ValidCleanRem M rem (K.plug p) := by
  dsimp only [ctxCliffAlloc, TempCtx.append, TempCtx.plug] at hv
  rcases hv with ⟨remMid, hmid, _, ⟨_, _, hvK, _, _⟩, hpres⟩
  have himp : ∀ β : BitAssignment M, cleanRem M rem β → cleanRem M remMid β := by
    intro β hβ
    let β₀ := c.eval β
    have hβ₀ : cleanRem M rem β₀ := fun w hw ↦ by
      dsimp [β₀]; rw [c.eval_outside hsupp β w hw]; exact hβ w hw
    have h1 := hpres β₀ hβ₀
    dsimp [TempPhaseProg.evalBits, β₀] at h1
    have h2 := CliffProg.inv_eval c β
    rw [hinv] at h2
    rwa [h2] at h1
  exact validCleanRem_mono (le_of_cleanRem_imp hmid himp) hvK
def noZeroAlloc : List MicroOp → Bool
  | [] => true
  | .zeroAlloc :: _ => false
  | _ :: rest => noZeroAlloc rest
theorem validCleanRem_of_ctxMicroRun_plug
    {M nIn : ℕ} (inW : Fin nIn → Wire M) (hin_inj : Function.Injective inW)
    (cur : ℕ) (hin_lt : ∀ i, (inW i).val < cur) (p : TempPhaseProg M) :
    ∀ (ops : List MicroOp) (top : ℕ) (hn : nIn ≤ top)
      (hv : microValid top ops = true)
      (hcur : cur + (top - nIn) + microAllocs ops ≤ M)
      (_hnoZ : noZeroAlloc ops = true),
      let K := ctxMicroRun inW hin_inj cur hin_lt top hn ops hv hcur
      ValidCleanRem M (M - (cur + (top - nIn))) (K.plug p) →
      ValidCleanRem M (M - (cur + (top - nIn) + microAllocs ops)) p
 := by
  intro ops; induction ops with
  | nil =>
      intro top hn hv hcur hnoZ K hvPlug
      simpa only [K, ctxMicroRun, TempCtx.plug, microAllocs, Nat.add_zero] using hvPlug
  | cons op rest ih =>
      intro top hn hv hcur hnoZ K hvPlug
      dsimp only [K] at hvPlug
