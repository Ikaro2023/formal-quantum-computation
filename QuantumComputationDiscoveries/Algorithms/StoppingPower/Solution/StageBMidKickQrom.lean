      (u3 * b0 + c3 * tv) + (u4 * b0 + c4 * tv) +
      ((2 + th4 + s0v) + (b0 + ca * tv)) =
      ((2 + th4) + ((u0 + u1 + u2 + u3 + u4) + 1) * b0) +
        (s0v + ((c0 + c1 + c2 + c3 + c4) + ca) * tv) := by ring
