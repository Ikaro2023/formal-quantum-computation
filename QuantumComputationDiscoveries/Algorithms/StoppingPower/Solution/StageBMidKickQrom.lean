  have hPlug : (ctxTail3 B).plug (.z q) =
      withLitAnd (96 + 2 * B + 1) (by dsimp [mBAux]; omega)
        ⟨96 + 2 * B, by dsimp [mBAux]; omega⟩ false
        ⟨95 + B, by dsimp [mBAux]; omega⟩ true
        (wire_ne_of_gt (by dsimp; omega)) (by dsimp; omega) (by dsimp; omega)
        (withLitAndXor2 (96 + 2 * B + 2) (by dsimp [mBAux]; omega)
          ⟨96 + 2 * B + 1, by dsimp [mBAux]; omega⟩ false
          ⟨89 + B, by dsimp [mBAux]; omega⟩
          ⟨85, by dsimp [mBAux]; omega⟩
          ⟨0, by dsimp [mBAux]; omega⟩ true
          (wire_ne_of_gt (by dsimp; omega))
          (wire_ne_of_lt (by dsimp; omega))
          (wire_ne_of_lt (by dsimp; omega))
          (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega)
