      hs1, Function.update_of_ne (hne 0), Function.update_of_ne (hne 64),
      hs0, Function.update_of_ne (hne 0), Function.update_of_ne (hne 32)]
  have hb3 : ∀ b : Fin 3, b = 0 ∨ b = 1 ∨ b = 2 := fun b ↦ by fin_cases b <;> decide
  refine ⟨hOut, fun b p ↦ ?_, fun b p ↦ ?_⟩
  · rw [hEq4]
    by_cases hp0 : p.val = 0
    · have hpEq : p = 0 := Fin.ext hp0
      subst hpEq
