def cDiagDecode218 {n : ℕ} (wEn wTh wSlot0 : Wire n)
    (hET : wEn ≠ wTh) (hES : wEn ≠ wSlot0) : Circuit n :=
  Circuit.S wEn ;;ᶜ DynCircuitExt.czCircuit wEn wTh hET ;;ᶜ DynCircuitExt.czCircuit wEn wSlot0 hES
@[simp] theorem count_cDiagDecode218_toff {n : ℕ} (wEn wTh wSlot0 : Wire n) (hET : wEn ≠ wTh)
    (hES : wEn ≠ wSlot0) : (cDiagDecode218 wEn wTh wSlot0 hET hES).count TOFF = 0 := by
  simp [cDiagDecode218, DynCircuitExt.count_czCircuit_toff, Circuit.S, Circuit.single]
@[simp] theorem count_cDiagDecode218_t {n : ℕ} (wEn wTh wSlot0 : Wire n) (hET : wEn ≠ wTh)
    (hES : wEn ≠ wSlot0) : (cDiagDecode218 wEn wTh wSlot0 hET hES).count T = 0 := by
  simp [cDiagDecode218, DynCircuitExt.count_czCircuit_t, Circuit.S, Circuit.single]
/-- `ZMod 8` phase exponent of `cDiagDecode218`. -/
def pDiagDecode218 {n : ℕ} (wEn wTh wSlot0 : Wire n) (γ : BitAssignment n) : ZMod 8 :=
    (if γ wEn = 0 then 0 else 2) + (if γ wEn * γ wTh = 0 then 0 else 4) +
    (if γ wEn * γ wSlot0 = 0 then 0 else 4)
