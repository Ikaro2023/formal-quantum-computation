theorem stepToCliffGen_disj_outsideDec61 {mPayload off mClean cur : ℕ} (hmPay : 80 ≤ mPayload)
    (hcur : cur ≤ 61 + mClean) (s : DecStep) (hwf : s.wellFormed cur = true) :
    Internal.CliffDisjoint (outsideDec61 (fullSysCoreWires mPayload))
      (stepToCliffGen hmPay off mClean cur hcur s hwf) := by
  cases s with
  | allocZero => exact trivial
  | andAlloc _ _ => exact trivial
  | x _ => exact decWireGen_not_outsideDec61 hmPay _
  | cnot _ _ => exact ⟨decWireGen_not_outsideDec61 hmPay _, decWireGen_not_outsideDec61 hmPay _⟩
theorem cliffOfProgGen_disj_outsideDec61 {mPayload off mClean : ℕ} (hmPay : 80 ≤ mPayload) :
    ∀ (p : List DecStep) (cur : ℕ) (hend : progEndCur cur p ≤ 61 + mClean)
      (hwf : progWellFormed cur p = true),
      Internal.CliffDisjoint (outsideDec61 (fullSysCoreWires mPayload))
        (cliffOfProgGen hmPay off mClean p cur hend hwf)
  | [], _, _, _ => trivial
  | s :: rest, cur, hend, hwf => by
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + mClean :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + mClean := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      exact ⟨stepToCliffGen_disj_outsideDec61 hmPay hcur_le s hw.1,
        cliffOfProgGen_disj_outsideDec61 hmPay rest (s.nextCur cur) hend hw.2⟩
theorem stepToCtxGen_disj_outsideDec61 {mPayload off mClean cur : ℕ} (hmPay : 80 ≤ mPayload)
    (h61 : 61 ≤ cur) (hcur : cur ≤ 61 + mClean) (s : DecStep) (hwf : s.wellFormed cur = true)
    (hnext : s.nextCur cur ≤ 61 + mClean) : (stepToCtxGen hmPay off mClean cur h61 hcur s hwf
    hnext).DisjointFrom (outsideDec61 (fullSysCoreWires mPayload)) := by
  cases s with
  | allocZero => exact trivial
  | x _ =>
    exact ⟨decWireGen_not_outsideDec61 hmPay _, ⟨trivial, decWireGen_not_outsideDec61 hmPay _⟩⟩
  | cnot _ _ =>
      exact ⟨⟨decWireGen_not_outsideDec61 hmPay _, decWireGen_not_outsideDec61 hmPay _⟩,
        ⟨trivial, ⟨decWireGen_not_outsideDec61 hmPay _, decWireGen_not_outsideDec61 hmPay _⟩⟩⟩
  | andAlloc _ _ =>
      refine ⟨decWireGen_not_outsideDec61 hmPay _, decWireGen_not_outsideDec61 hmPay _, ?_, trivial⟩
      rintro ⟨hlt, _⟩
      dsimp at hlt; omega
theorem listToCtxGen_disj_outsideDec61 {mPayload off mClean : ℕ} (hmPay : 80 ≤ mPayload) :
    ∀ (p : List DecStep) (cur : ℕ) (h61 : 61 ≤ cur) (hend : progEndCur cur p ≤ 61 + mClean)
      (hwf : progWellFormed cur p = true),
      (listToCtxGen hmPay off mClean p cur h61 hend hwf).DisjointFrom
        (outsideDec61 (fullSysCoreWires mPayload))
  | [], _, _, _, _ => trivial
  | s :: rest, cur, h61, hend, hwf => by
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + mClean :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + mClean := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      have h61' : 61 ≤ s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
      exact Internal.TempCtx.disjointFrom_append
        (stepToCtxGen_disj_outsideDec61 hmPay h61 hcur_le s hw.1 hnext_le)
        (listToCtxGen_disj_outsideDec61 hmPay rest (s.nextCur cur) h61' hend hw.2)
def stHighCore {n mPayload : ℕ} (hmPay : 80 ≤ mPayload)
    (rCore : QRegister (fullSysCoreWires mPayload) n) (β : BitAssignment n) (w : ℕ) : Bool :=
    if hw : w < 61 then decide (β (rCore ⟨decWireNum (fullSysCoreWires mPayload) w,
