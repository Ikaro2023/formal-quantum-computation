theorem ctxComp17_fwdBits_wire (q : Wire 106)
    (γ : BitAssignment 106) (hγ : cleanRem 106 17 γ) :
    ∃ s17 : BitAssignment 106 → BitAssignment 106,
      ctxComp17.fwdBits γ q = s17 γ q ∧
      comp17Spec (s17 γ)
        (ge216Bit (γ ⟨15, by decide⟩) (γ ⟨16, by decide⟩) (γ ⟨17, by decide⟩)
          (γ ⟨18, by decide⟩) (γ ⟨19, by decide⟩))
        (ge218Bit (γ ⟨21, by decide⟩) (γ ⟨22, by decide⟩) (γ ⟨23, by decide⟩)
          (γ ⟨24, by decide⟩) (γ ⟨25, by decide⟩) (γ ⟨26, by decide⟩) (γ ⟨27, by decide⟩))
        (ge217Bit (γ ⟨28, by decide⟩) (γ ⟨29, by decide⟩) (γ ⟨30, by decide⟩) (γ ⟨31, by decide⟩)
          (γ ⟨32, by decide⟩) (γ ⟨33, by decide⟩) (γ ⟨34, by decide⟩) (γ ⟨35, by decide⟩))
        (γ ⟨86, by decide⟩) (γ ⟨87, by decide⟩) (γ ⟨88, by decide⟩) := by
  obtain ⟨s17, hB, hSpec⟩ := ctxComp17_scoped_of_wire q
  have h₁ := ctxComp17.plug_evalSign (.z q) γ
  have h₂ := hB.sign γ hγ
  dsimp [TempPhaseProg.evalSign] at h₁ h₂
  exact ⟨s17, h₁.symm.trans h₂, hSpec γ⟩
theorem ctxComp17_fwdBits_fLeaf
    (γ : BitAssignment 106) (hγ : cleanRem 106 17 γ) :
    let ge216 := ge216Bit (γ ⟨15, by decide⟩) (γ ⟨16, by decide⟩) (γ ⟨17, by decide⟩)
      (γ ⟨18, by decide⟩) (γ ⟨19, by decide⟩)
    let ge218 := ge218Bit (γ ⟨21, by decide⟩) (γ ⟨22, by decide⟩) (γ ⟨23, by decide⟩)
      (γ ⟨24, by decide⟩) (γ ⟨25, by decide⟩) (γ ⟨26, by decide⟩) (γ ⟨27, by decide⟩)
    let ge217 := ge217Bit (γ ⟨28, by decide⟩) (γ ⟨29, by decide⟩) (γ ⟨30, by decide⟩)
      (γ ⟨31, by decide⟩) (γ ⟨32, by decide⟩) (γ ⟨33, by decide⟩) (γ ⟨34, by decide⟩)
      (γ ⟨35, by decide⟩)
    fLeafComp17 (ctxComp17.fwdBits γ) =
      γ ⟨86, by decide⟩ * ge216 + γ ⟨87, by decide⟩ * ge218 + γ ⟨88, by decide⟩ * ge217 := by
  obtain ⟨_, he86, hw86⟩ := ctxComp17_fwdBits_wire ⟨86, by decide⟩ γ hγ
  obtain ⟨_, he87, hw87⟩ := ctxComp17_fwdBits_wire ⟨87, by decide⟩ γ hγ
  obtain ⟨_, he88, hw88⟩ := ctxComp17_fwdBits_wire ⟨88, by decide⟩ γ hγ
  obtain ⟨_, he92, hw92⟩ := ctxComp17_fwdBits_wire ⟨92, by decide⟩ γ hγ
  obtain ⟨_, he98, hw98⟩ := ctxComp17_fwdBits_wire ⟨98, by decide⟩ γ hγ
  obtain ⟨_, he105, hw105⟩ := ctxComp17_fwdBits_wire ⟨105, by decide⟩ γ hγ
  dsimp only [fLeafComp17]
  rw[he86.trans hw86.1, he87.trans hw87.2.1, he88.trans hw88.2.2.1, he92.trans hw92.2.2.2.1,
      he98.trans hw98.2.2.2.2.1, he105.trans hw105.2.2.2.2.2]
/-- Plugged `TempPhaseProg 106` witness for `ctxComp17`. -/
def pComp17 : TempPhaseProg 106 :=
  ctxComp17.plug (.z ⟨0, by decide⟩)
theorem pComp17_eq : ctxComp17.plug (.z ⟨0, by decide⟩) = pComp17 := rfl
theorem pComp17_valid_and_bits : ValidCleanRem 106 17 pComp17 ∧ (∀ γ :
    BitAssignment 106, cleanRem 106 17 γ → pComp17.evalBits γ = γ) := by
  obtain ⟨_, hB, _⟩ := ctxComp17_scoped_of_wire ⟨0, by decide⟩
  exact ⟨hB.valid, hB.bits⟩
/-- Inner diagonal phase `Circuit n` for Stages A and C (`17` Toffoli pairs + `3` `CZ`s). -/
def cComp17Inner {n mScr : ℕ} (hm20 : 20 ≤ mScr) (rCore : QRegister posCoreWires n)
    (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) : Circuit n :=
  let rComb := rComb106 hm20 rCore rScr hCS
  mk34_ctxToToff rComb (cLeafComp17On rComb) ctxComp17
/-- Inner diagonal phase `DynamicCircuit Var n` for Stages A and C (`68 T`, `0` `.TOFF`). -/
def dComp17Inner {Var : Type} {n mScr : ℕ} (hm20 : 20 ≤ mScr) (v : Var)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) : DynamicCircuit Var n :=
  let rComb := rComb106 hm20 rCore rScr hCS
  mk34_ctxToDyn v rComb (cLeafComp17On rComb) ctxComp17
/-- Stage A / Stage C reversible `Circuit n` XORing `holdVecAux rCore β` onto `rHold3`. -/
def cComp17 {n mScr : ℕ} (hm20 : 20 ≤ mScr) (rCore : QRegister posCoreWires n)
    (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) : Circuit n :=
  hadamardReg (rHold3Aux hm20 rScr) ;;ᶜ
    cComp17Inner hm20 rCore rScr hCS ;;ᶜ
    hadamardReg (rHold3Aux hm20 rScr)
/-- Stage A / Stage C `0`-`.TOFF` `DynamicCircuit Var n` (`68 T`) XORing `holdVecAux rCore β`
  onto `rHold3`. -/
def dComp17 {Var : Type} {n mScr : ℕ} (hm20 : 20 ≤ mScr) (v : Var)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) : DynamicCircuit Var n := .seq
    (.circuit (hadamardReg (rHold3Aux hm20 rScr))) (.seq (dComp17Inner hm20 v rCore
    rScr hCS) (.circuit (hadamardReg (rHold3Aux hm20 rScr))))
