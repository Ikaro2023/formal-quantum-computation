/-- `4`-step `SymTempAndStep` list (`16 T`) computing `wScr 16 = en * u_7`,
`wScr 17 = wScr 16 * u_6`, `wScr 18 = wScr 17 * u_4`, `wScr 19 = wScr 18 * u_3`. -/
def headPreSteps4 {n mScr : ℕ} (hm20 : 20 ≤ mScr) (rCore : QRegister posCoreWires n)
    (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) : List (SymTempAndStep n) :=
  have hScrNe : ∀ (a b : ℕ) (ha : a < mScr) (hb : b < mScr), a ≠ b → rScr ⟨a, ha⟩ ≠ rScr ⟨b, hb⟩ :=
    fun a b _ _ h heq ↦ h (congrArg Fin.val (rScr.wires.injective heq));
  [ litAndSymStep false false false (rScr ⟨15, by omega⟩) (rAnchorIdx rCore 7) (rScr ⟨16, by omega⟩)
      (anc_ne_scr rCore rScr hCS 7 _).symm
      (hScrNe 15 16 _ _ (by decide))
      (anc_ne_scr rCore rScr hCS 7 _),
    litAndSymStep false false false (rScr ⟨16, by omega⟩) (rAnchorIdx rCore 6) (rScr ⟨17, by omega⟩)
      (anc_ne_scr rCore rScr hCS 6 _).symm
      (hScrNe 16 17 _ _ (by decide))
      (anc_ne_scr rCore rScr hCS 6 _),
    litAndSymStep false false false (rScr ⟨17, by omega⟩) (rAnchorIdx rCore 4) (rScr ⟨18, by omega⟩)
      (anc_ne_scr rCore rScr hCS 4 _).symm
      (hScrNe 17 18 _ _ (by decide))
      (anc_ne_scr rCore rScr hCS 4 _),
    litAndSymStep false false false (rScr ⟨18, by omega⟩) (rAnchorIdx rCore 3) (rScr ⟨19, by omega⟩)
      (anc_ne_scr rCore rScr hCS 3 _).symm
      (hScrNe 18 19 _ _ (by decide))
      (anc_ne_scr rCore rScr hCS 3 _) ]
theorem headPreSteps4_valid_and_eval {n mScr : ℕ} (hm20 : 20 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) :
    let L4 := headPreSteps4 hm20 rCore rScr hCS
    ValidSymStepList (∅ : Finset (Wire n)) rScr 16 L4 ∧
    (∀ (b : BitAssignment n),
      b (rScr ⟨16, by omega⟩) = 0 → b (rScr ⟨17, by omega⟩) = 0 →
      b (rScr ⟨18, by omega⟩) = 0 → b (rScr ⟨19, by omega⟩) = 0 →
      let b' := symStepFwdList L4 b
      b' (rScr ⟨16, by omega⟩) = b (rScr ⟨15, by omega⟩) * b (rAnchorIdx rCore 7) ∧
      b' (rScr ⟨17, by omega⟩) = b (rScr ⟨15, by
        omega⟩) * b (rAnchorIdx rCore 7) * b (rAnchorIdx rCore 6) ∧
      b' (rScr ⟨18, by omega⟩) = b (rScr ⟨15, by
        omega⟩) * b (rAnchorIdx rCore 7) * b (rAnchorIdx rCore 6) * b (rAnchorIdx rCore 4) ∧
      b' (rScr ⟨19, by omega⟩) = b (rScr ⟨15, by
        omega⟩) * b (rAnchorIdx rCore 7) * b (rAnchorIdx rCore 6) * b (rAnchorIdx rCore 4) *
        b (rAnchorIdx rCore 3) ∧
      (∀ z, z ≠ rScr ⟨16, by omega⟩ → z ≠ rScr ⟨17, by omega⟩ →
        z ≠ rScr ⟨18, by omega⟩ → z ≠ rScr ⟨19, by omega⟩ → b' z = b z)) := by
  intro L4
  have hScrNe : ∀ (a b : ℕ) (ha : a < mScr) (hb : b < mScr), a ≠ b → rScr ⟨a, ha⟩ ≠ rScr ⟨b, hb⟩ :=
    fun a b _ _ h heq ↦ h (congrArg Fin.val (rScr.wires.injective heq))
  refine ⟨?_, ?_⟩
  · dsimp only [L4, headPreSteps4, ValidSymStepList, litAndSymStep]
    refine ⟨by omega, rfl, Finset.disjoint_empty_right _, ?_,
      ⟨by omega, rfl, Finset.disjoint_empty_right _, ?_,
      ⟨by omega, rfl, Finset.disjoint_empty_right _, ?_,
      ⟨by omega, rfl, Finset.disjoint_empty_right _, ?_, trivial⟩⟩⟩⟩
    · intro idx hlt; simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega,
        (anc_ne_scr rCore rScr hCS 7 idx).symm,
        fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega⟩
    · intro idx hlt; simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega,
        (anc_ne_scr rCore rScr hCS 6 idx).symm,
        fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega⟩
    · intro idx hlt; simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega,
        (anc_ne_scr rCore rScr hCS 4 idx).symm,
        fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega⟩
    · intro idx hlt; simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega,
        (anc_ne_scr rCore rScr hCS 3 idx).symm,
        fun h ↦ by have hv := congrArg Fin.val (rScr.wires.injective h); dsimp at hv; omega⟩
  · intro b hb16 hb17 hb18 hb19
    have hpol : ∀ x y : ZMod 2, polBit false (polBit false x * polBit false y) = x * y := fun _ _ ↦
      rfl
    dsimp only [L4, headPreSteps4, symStepFwdList]
    rw [litAndSymStep_stepFwd _ _ _ _ _ _ _ _ _ b hb16]
    simp only [hpol]
    let u16 :=
      Function.update b (rScr ⟨16, by omega⟩) (b (rScr ⟨15, by omega⟩) * b (rAnchorIdx rCore 7))
    have eq16 : Function.update b (rScr ⟨16, by omega⟩) (b (rScr ⟨15, by
      omega⟩) * b (rAnchorIdx rCore 7)) = u16 := rfl
    rw [eq16]
    have hu16_17 : u16 (rScr ⟨17, by omega⟩) = 0 := by
      dsimp only [u16]; rw [Function.update_of_ne (hScrNe 17 16 _ _ (by decide)), hb17]
    rw [litAndSymStep_stepFwd _ _ _ _ _ _ _ _ _ u16 hu16_17]
    simp only [hpol]
    let u17 :=
      Function.update u16 (rScr ⟨17, by omega⟩) (u16 (rScr ⟨16, by
      omega⟩) * u16 (rAnchorIdx rCore 6))
    have eq17 : Function.update u16 (rScr ⟨17, by omega⟩) (u16 (rScr ⟨16, by
      omega⟩) * u16 (rAnchorIdx rCore 6)) = u17 := rfl
    rw [eq17]
    have hu17_18 : u17 (rScr ⟨18, by omega⟩) = 0 := by
      dsimp only [u17, u16]
      rw [Function.update_of_ne (hScrNe 18 17 _ _ (by decide)),
          Function.update_of_ne (hScrNe 18 16 _ _ (by decide)), hb18]
    rw [litAndSymStep_stepFwd _ _ _ _ _ _ _ _ _ u17 hu17_18]
    simp only [hpol]
    let u18 :=
      Function.update u17 (rScr ⟨18, by omega⟩) (u17 (rScr ⟨17, by
      omega⟩) * u17 (rAnchorIdx rCore 4))
    have eq18 : Function.update u17 (rScr ⟨18, by omega⟩) (u17 (rScr ⟨17, by
      omega⟩) * u17 (rAnchorIdx rCore 4)) = u18 := rfl
    rw [eq18]
    have hu18_19 : u18 (rScr ⟨19, by omega⟩) = 0 := by
      dsimp only [u18, u17, u16]
      rw [Function.update_of_ne (hScrNe 19 18 _ _ (by decide)),
          Function.update_of_ne (hScrNe 19 17 _ _ (by decide)),
          Function.update_of_ne (hScrNe 19 16 _ _ (by decide)), hb19]
    rw [litAndSymStep_stepFwd _ _ _ _ _ _ _ _ _ u18 hu18_19]
    simp only [hpol]
    refine ⟨?_, ?_, ?_, ?_, fun z hz16 hz17 hz18 hz19 ↦ ?_⟩
    · simp only[u18, u17, u16, Function.update_of_ne (hScrNe 16 19 _ _ (by decide)),
        Function.update_of_ne (hScrNe 16 18 _ _ (by decide)),
        Function.update_of_ne (hScrNe 16 17 _ _ (by decide)), Function.update_self]
    · simp only[u18, u17, u16, Function.update_of_ne (hScrNe 17 19 _ _ (by decide)),
        Function.update_of_ne (hScrNe 17 18 _ _ (by decide)), Function.update_self,
        Function.update_of_ne (anc_ne_scr rCore rScr hCS 6 _)]
    · simp only[u18, u17, u16, Function.update_of_ne (hScrNe 18 19 _ _ (by decide)),
        Function.update_self, Function.update_of_ne (anc_ne_scr rCore rScr hCS 6 _),
        Function.update_of_ne (anc_ne_scr rCore rScr hCS 4 _)]
    · simp only[u18, u17, u16, Function.update_self,
        Function.update_of_ne (anc_ne_scr rCore rScr hCS 6 _),
        Function.update_of_ne (anc_ne_scr rCore rScr hCS 4 _),
        Function.update_of_ne (anc_ne_scr rCore rScr hCS 3 _)]
    · simp only[u18, u17, u16, Function.update_of_ne hz19, Function.update_of_ne hz18,
        Function.update_of_ne hz17, Function.update_of_ne hz16]
theorem length_headPreSteps4 {n mScr : ℕ} (hm20 : 20 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) :
    (headPreSteps4 hm20 rCore rScr hCS).length = 4 := rfl
attribute [irreducible] headPreSteps4
/-- Masked core-electron origin-`0` hit set on `posCoreWires + 18` excluding `e.val = u`
  (`rAnchorIdx`). -/
def anchorCoreHitSet (γ : BitAssignment (posCoreWires + 18)) : Finset (Fin 218) :=
  let rCore := selDataInAct posCoreWires
  let u := regVal (rAnchorIdx rCore) γ
  Finset.univ.filter fun e : Fin 218 ↦
    decide (e.val ≠ u ∧ ∀ q : Fin 18, γ (rElecSlot rCore e q) = 0)
/-- `0/1` `ZMod 8` hit indicator of `rAnchor18` (`selMeasInAct posCoreWires`) gated by `s0 = 0`. -/
def anchorSlotHitZ8 (γ : BitAssignment (posCoreWires + 18)) : ZMod 8 :=
  let rCore := selDataInAct posCoreWires
  let rAnc := selMeasInAct posCoreWires
  if (γ (wSlot0Core rCore) = 0 ∧ ∀ q : Fin 18, γ (rAnc q) = 0) then 1 else 0
/-- `ZMod 8` phase exponent of `uHeadAnchorCore` on `posCoreWires + 18`. -/
def headAnchorCoreZ8Spec (γ : BitAssignment (posCoreWires + 18)) : ZMod 8 :=
  let rCore := selDataInAct posCoreWires
  if Bool.not (headEnBoolSpec (fun i ↦ γ (rCore i))) then 0
  else
    let s0Z8 : ZMod 8 := if γ (wSlot0Core rCore) == 1 then 4 else 0
    let tZ8 : ZMod 8 := if γ (wHeadThresh rCore) == 1 then 4 else 0
    s0Z8 + (((anchorCoreHitSet γ).card : ZMod 8) + anchorSlotHitZ8 γ) * (2 + tZ8)
/-- Unshifted `219`-slot masked origin-`0` anchor-frame unitary on `posCoreWires + 18`. -/
noncomputable def uHeadAnchorCore : Unitary (2 ^ (posCoreWires + 18)) := monomialZ8UnitaryN
    (wHeadThresh (selDataInAct posCoreWires))
    (fun γ ↦ headEnBoolSpec (fun i ↦ γ (selDataInAct posCoreWires i))) headAnchorCoreZ8Spec
theorem prod_add_one_zmod2_eq_one_iff :
    ∀ {K : ℕ} (f : Fin K → ZMod 2), (∏ idx : Fin K, (f idx + 1)) = 1 ↔ ∀ idx, f idx = 0
  | 0, _ => by simp
  | K + 1, f => by
      rw [Fin.prod_univ_succ]
      rcases bit_cases (f 0) with h0 | h1
      · rw [h0, zero_add, one_mul, prod_add_one_zmod2_eq_one_iff]
        exact ⟨fun h idx ↦ Fin.cases h0 (fun j ↦ h j) idx, fun h j ↦ h j.succ⟩
      · have h11 : (1 : ZMod 2) + 1 = 0 := by decide
        rw [h1, h11, zero_mul]
        exact ⟨fun h ↦ False.elim (zero_ne_one h), fun hall ↦
          False.elim (one_ne_zero (h1.symm.trans (hall 0)))⟩
theorem slotHitBit_false_eq_one_iff {n K : ℕ} (f l : Wire n) (m : Fin K → Wire n)
    (γ : BitAssignment n) : slotHitBit f l m (fun _ ↦ false) γ = 1 ↔
    (γ f = 0 ∧ γ l = 0 ∧ ∀ j : Fin K, γ (m j) = 0) := by
  unfold slotHitBit
  simp only [Bool.false_eq_true, ↓reduceIte]
  rw [prod_add_one_zmod2_eq_one_iff]
  constructor
  · intro hall; exact ⟨hall 0, hall 1, fun j ↦ hall j.succ.succ⟩
  · rintro ⟨h0, h1, hm⟩ idx
    exact Fin.cases h0 (fun idx' ↦ Fin.cases h1 (fun j ↦ hm j) idx') idx
theorem idxValPrefix_congr_prefix {D₁ D₂ n : ℕ} (w₁ : Fin D₁ → Wire n) (w₂ : Fin D₂ → Wire n)
    (β₁ β₂ : BitAssignment n) :
    ∀ (k : ℕ) (hk₁ : k ≤ D₁) (hk₂ : k ≤ D₂),
      (∀ d : Fin k, β₁ (w₁ ⟨d.val, by omega⟩) = β₂ (w₂ ⟨d.val, by omega⟩)) →
      idxValPrefix w₁ β₁ k hk₁ = idxValPrefix w₂ β₂ k hk₂
  | 0, _, _, _ => rfl
  | k + 1, hk₁, hk₂, hEq => by
      dsimp only [idxValPrefix]
      rw [idxValPrefix_congr_prefix w₁ w₂ β₁ β₂ k (Nat.le_of_succ_le hk₁) (Nat.le_of_succ_le hk₂)
            (fun d ↦ hEq ⟨d.val, by omega⟩),
          hEq ⟨k, Nat.lt_succ_self k⟩]
theorem idxValPrefix_eq_sum {D n : ℕ} (w : Fin D → Wire n) (β : BitAssignment n) :
    ∀ (k : ℕ) (hk : k ≤ D),
      idxValPrefix w β k hk = ∑ d : Fin k, (β (w ⟨d.val, by omega⟩)).val * 2 ^ d.val
  | 0, _ => by simp [idxValPrefix]
  | k + 1, hk => by
      dsimp only [idxValPrefix]
      rw [idxValPrefix_eq_sum w β k (Nat.le_of_succ_le hk), Fin.sum_univ_castSucc]
      dsimp only [Fin.val_castSucc, Fin.val_last]
      rcases bit_cases (β (w ⟨k, hk⟩)) with h0 | h1
      · simp [h0, ZMod.val_zero]
      · simp [h1]
theorem idxValPrefix_8_eq_regVal {n : ℕ} (r : QRegister 8 n) (β : BitAssignment n) :
    idxValPrefix r.wires β 8 le_rfl = regVal r β := by
  rw [idxValPrefix_eq_sum]
  rfl
theorem eval_X_comm_of_not_mem_support {n : ℕ} (w : Wire n) :
    ∀ (c : Circuit n), w ∉ c.support →
      (Circuit.X w).eval.1 * c.eval.1 = c.eval.1 * (Circuit.X w).eval.1
  | .identity, _ => by simp [Circuit.eval_identity]
  | .gate g r, hw => by
      have hDisj : (QRegister.singleton w).DisjointWires r := by
        rw [QRegister.disjoint_iff]
        intro _ j hj
        exact hw (QRegister.mem_image r w |>.mpr ⟨j, hj.symm⟩)
      exact (QRegister.singleton w).embedMatrix_comm_of_disjoint r hDisj
        (PrimitiveGate.eval .X).1 g.eval.1
  | .seq c₁ c₂, hw => by
      rw [Circuit.support_seq, Finset.mem_union, not_or] at hw
      simp only [Circuit.eval_seq, Submonoid.coe_mul]
      rw [← Matrix.mul_assoc, eval_X_comm_of_not_mem_support w c₂ hw.2,
          Matrix.mul_assoc, eval_X_comm_of_not_mem_support w c₁ hw.1, ← Matrix.mul_assoc]
theorem card_fin218_range_bij (P : (k : ℕ) → k < 218 → Bool)
    (base N : ℕ) (hBase : base + N ≤ 218) :
    (Finset.univ.filter fun i : Fin N ↦ P (base + i.val) (by have := i.isLt; omega)).card =
      (Finset.univ.filter fun e : Fin 218 ↦
        P e.val e.isLt && decide (base ≤ e.val ∧ e.val < base + N)).card := by
  refine Finset.card_bij (fun (i : Fin N) _ ↦ (⟨base + i.val, by have := i.isLt; omega⟩ : Fin 218))
    (fun i hi ↦ ?_)
    (fun i₁ _ i₂ _ h ↦ Fin.ext (by have hv := congrArg Fin.val h; dsimp at hv; omega))
    (fun e he ↦ ?_)
  · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi ⊢
    rw [hi, Bool.true_and, decide_eq_true_eq]
    have := i.isLt; omega
  · simp only [Finset.mem_filter, Finset.mem_univ, true_and, Bool.and_eq_true,
    decide_eq_true_eq] at he
    refine ⟨⟨e.val - base, by omega⟩, ?_, Fin.ext (by dsimp; omega)⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    convert he.1 using 2; omega
theorem card_fin218_split5 (P : (k : ℕ) → k < 218 → Bool) :
    (Finset.univ.filter fun i : Fin 128 ↦ P (0 + i.val) (by have := i.isLt; omega)).card +
      (Finset.univ.filter fun i : Fin 64 ↦ P (128 + i.val) (by have := i.isLt; omega)).card +
      (Finset.univ.filter fun i : Fin 16 ↦ P (192 + i.val) (by have := i.isLt; omega)).card +
      (Finset.univ.filter fun i : Fin 8 ↦ P (208 + i.val) (by have := i.isLt; omega)).card +
      (Finset.univ.filter fun i : Fin 2 ↦ P (216 + i.val) (by have := i.isLt; omega)).card =
    (Finset.univ.filter fun e : Fin 218 ↦ P e.val e.isLt).card := by
  rw[card_fin218_range_bij P 0 128 (by decide), card_fin218_range_bij P 128 64 (by decide),
      card_fin218_range_bij P 192 16 (by decide), card_fin218_range_bij P 208 8 (by decide),
      card_fin218_range_bij P 216 2 (by decide)]
  let S := Finset.univ.filter fun e : Fin 218 ↦ P e.val e.isLt
  have hSplit : ∀ (A : Finset (Fin 218)) (q : Fin 218 → Prop) [DecidablePred q],
      A.card = (A.filter q).card + (A.filter fun x ↦ ¬q x).card := fun A q _ ↦ by
    have hDisj : Disjoint (A.filter q) (A.filter fun x ↦ ¬q x) :=
      Finset.disjoint_left.mpr fun x h1 h2 ↦ (Finset.mem_filter.mp h2).2 (Finset.mem_filter.mp h1).2
    have hUni : A.filter q ∪ A.filter (fun x ↦ ¬q x) = A := by
      ext x; simp only [Finset.mem_union, Finset.mem_filter]; tauto
    have hCard := Finset.card_union_of_disjoint hDisj
    rw [hUni] at hCard; exact hCard
  let R128 := S.filter fun e ↦ ¬(e.val < 128)
  let R192 := R128.filter fun e ↦ ¬(e.val < 192)
  let R208 := R192.filter fun e ↦ ¬(e.val < 208)
  have hs0 := hSplit S (fun e ↦ e.val < 128)
  have hs1 := hSplit R128 (fun e ↦ e.val < 192)
  have hs2 := hSplit R192 (fun e ↦ e.val < 208)
  have hs3 := hSplit R208 (fun e ↦ e.val < 216)
  have hf0 : (Finset.univ.filter fun e : Fin 218 ↦
    P e.val e.isLt && decide (0 ≤ e.val ∧ e.val < 0 + 128)) =
