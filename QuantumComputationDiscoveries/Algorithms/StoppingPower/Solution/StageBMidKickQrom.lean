  have hs4 : γ₄ = Function.update (Function.update γ₃ (rU108 104) (γ₃ (c 4) * γ₃ (rU108 96)))
      (rU108 96) (γ₃ (rU108 96) + γ₃ (c 4) * γ₃ (rU108 96)) :=
    splitSymStep_stepFwd _ _ _ _ _ _ γ₃ hz104
  have hc0 : ∀ j, γ₀ (c j) = γ (c j) := fun j ↦ by
    rw [hs0, Function.update_of_ne (hcNotU j (hU_mem 0)),
      Function.update_of_ne (hcNotU j (hU_mem 32))]
  have hc1 : ∀ j, γ₁ (c j) = γ (c j) := fun j ↦ by
    rw [hs1, Function.update_of_ne (hcNotU j (hU_mem 0)),
      Function.update_of_ne (hcNotU j (hU_mem 64)), hc0]
  have hc2 : ∀ j, γ₂ (c j) = γ (c j) := fun j ↦ by
