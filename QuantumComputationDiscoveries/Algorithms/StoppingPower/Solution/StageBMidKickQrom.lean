theorem zmod8_combine_218 (th : ZMod 2) (s0v u0 u1 u2 u3 u4 c0 c1 c2 c3 c4 ca : ZMod 8)
    (hu : u0 + u1 + u2 + u3 + u4 = 217) :
    let b0 : ZMod 8 := if th = 0 then 7 else 1
    let tv : ZMod 8 := 2 + (if th = 1 then 4 else 0)
    let th4 : ZMod 8 := if th = 1 then 4 else 0
