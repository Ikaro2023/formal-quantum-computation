  have hP₀_herm : P₀ᴴ = P₀ := by
    rw [hP₀_def]; exact QRegister.basisOutcomeProjector_conjTranspose _ 0
  have hP₀_in_adj : P_all * P₀ = P_all := by
    have h := congrArg conjTranspose hP₀_in
    simpa [conjTranspose_mul, hPall_herm, hP₀_herm] using h
  have hT_sq : T_anc * T_anc = 1 := toffoli_eval_sq qc₁ qc₂ qanc hq₁₂ hq₁a hq₂a
  have hT_sq_mat : T_anc.1 * T_anc.1 = 1 := congrArg Subtype.val hT_sq
  have hTPb_adj : T_anc.1ᴴ * P_body = P_all * T_anc.1ᴴ := by
    dsimp [P_body]
    rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, unitary_coe_star_mul_self T_anc, Matrix.one_mul]
  have hPbT : P_body * T_anc.1 = T_anc.1 * P_all := by
    dsimp [P_body]
    rw [Matrix.mul_assoc, unitary_coe_star_mul_self T_anc, Matrix.mul_one]
  have hPT : P_all * T_anc.1 = T_anc.1ᴴ * P_body := by
    rw [hTPb_adj]
    have hT_symm : T_anc.1ᴴ = T_anc.1 := by
      calc T_anc.1ᴴ = T_anc.1ᴴ * (T_anc.1 * T_anc.1) := by rw [hT_sq_mat, Matrix.mul_one]
        _ = (T_anc.1ᴴ * T_anc.1) * T_anc.1 := by rw [Matrix.mul_assoc]
        _ = T_anc.1 := by rw [unitary_coe_star_mul_self T_anc, Matrix.one_mul]
    rw [hT_symm]
  have hV_pres : P_all * (V.1 * P_all) = V.1 * P_all := by
    have hT_symm : T_anc.1ᴴ = T_anc.1 := by
      calc T_anc.1ᴴ = T_anc.1ᴴ * (T_anc.1 * T_anc.1) := by rw [hT_sq_mat, Matrix.mul_one]
        _ = (T_anc.1ᴴ * T_anc.1) * T_anc.1 := by rw [Matrix.mul_assoc]
        _ = T_anc.1 := by rw [unitary_coe_star_mul_self T_anc, Matrix.one_mul]
    calc P_all * (V.1 * P_all)
        = (P_all * T_anc.1) * U_body.1 * (T_anc.1 * P_all) := by
            dsimp [V]; simp only [Matrix.mul_assoc]
      _ = (T_anc.1 * P_body) * U_body.1 * (P_body * T_anc.1) := by
            rw [hPT, hT_symm, ← hPbT]
      _ = T_anc.1 * (P_body * (U_body.1 * P_body)) * T_anc.1 := by
            simp only [Matrix.mul_assoc]
      _ = T_anc.1 * (U_body.1 * P_body) * T_anc.1 := by
            rw [hBodyPres]
      _ = T_anc.1 * U_body.1 * (P_body * T_anc.1) := by
            simp only [Matrix.mul_assoc]
      _ = T_anc.1 * U_body.1 * (T_anc.1 * P_all) := by
            rw [hPbT]
      _ = V.1 * P_all := by
            dsimp [V]; simp only [Matrix.mul_assoc]
  have hU_clean_P₀ : P₀ * (V.1 * P_all) = V.1 * P_all := by
    rw [← hV_pres, ← Matrix.mul_assoc, hP₀_in]
  have hclean_adj : P_all * V.1ᴴ * P₀ = P_all * V.1ᴴ := by
    have h := congrArg conjTranspose hU_clean_P₀
    simpa [conjTranspose_mul, hP₀_herm, hPall_herm, ← Matrix.mul_assoc] using h
  have hU_eq : U_body * T_anc = T_anc * V := by
    dsimp [V]; rw [← mul_assoc, ← mul_assoc, hT_sq, one_mul]
  have hprod_adj : P_all * T_anc.1ᴴ * U_body.1ᴴ = (P_all * V.1ᴴ) * (P₀ * T_anc.1ᴴ) := by
    have h1 : T_anc.1ᴴ * U_body.1ᴴ = V.1ᴴ * T_anc.1ᴴ := by
      have h := congrArg (fun u : Unitary (2 ^ n) ↦ u.1ᴴ) hU_eq
      simpa [Submonoid.coe_mul, conjTranspose_mul] using h
    calc P_all * T_anc.1ᴴ * U_body.1ᴴ
        = P_all * (T_anc.1ᴴ * U_body.1ᴴ) := by rw [Matrix.mul_assoc]
      _ = P_all * (V.1ᴴ * T_anc.1ᴴ) := by rw [h1]
      _ = (P_all * V.1ᴴ) * T_anc.1ᴴ := by rw [Matrix.mul_assoc]
      _ = (P_all * V.1ᴴ * P₀) * T_anc.1ᴴ := by rw [hclean_adj]
      _ = (P_all * V.1ᴴ) * (P₀ * T_anc.1ᴴ) := by rw [Matrix.mul_assoc]
  refine ⟨⟨fun Ψ _ σ val ↦ ?_, fun Θ hΘ σ ↦ ?_⟩, hV_pres⟩
  · simp only [DynamicCircuit.andCompute, DynamicCircuit.compile_seq,
      DynamicCircuit.compile_circuit, wp_qSeq, wp_circuit_compile_compat, wpQAssignCompat]
    congr 1
    have hinner := hBody.1 (wp (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂).compile Ψ)
      (fun σ' v' ↦ wp_andUncompute_update_self v qc₁ qc₂ qanc hq₁₂ Ψ σ' v') σ val
    exact congrArg (fun x ↦ (x : Observable (Fin (2 ^ n)))) hinner
  · let Ψ := wp (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂).compile Θ
    have hΨ_inv : ∀ σ' v', Ψ (Function.update σ' v v') = Ψ σ' :=
      fun σ' v' ↦ wp_andUncompute_update_self v qc₁ qc₂ qanc hq₁₂ Θ σ' v'
    have hstep1 :
        ((wp (.qSeq (DynamicCircuit.andCompute (Var := Var) qc₁ qc₂ qanc hq₁a hq₂a).compile
            (.qSeq dBody.compile
              (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂).compile)) Θ σ).1).conj P₀ =
        ((wpQAssignCompat T_anc (wp dBody.compile Ψ) σ).1).conj P₀ := by
      rw [hP₀_def]
      have h := congrFun
        (restrictToZeroAncilla_wp_andCompute_seq_compat qc₁ qc₂ qanc hq₁₂ hq₁a hq₂a
          (.qSeq dBody.compile
            (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂).compile) Θ) σ
      exact congrArg Subtype.val h
    have hstep_uncomp :
        ((wpQAssignCompat T_anc Ψ σ).1).conj P₀ = (Θ σ).1.conj P₀ := by
      rw [hP₀_def]
      have h := congrFun
        (restrictAssertionToZeroAncilla_wpQAssign_toffoli_wp_andUncompute_of_update_eq
          v qc₁ qc₂ qanc hq₁₂ hq₁a hq₂a Θ hΘ) σ
      exact congrArg Subtype.val h
    have hmid : (Ψ σ).1.conj (P₀ * T_anc.1ᴴ) = (Θ σ).1.conj P₀ := by
      simpa [wpQAssignCompat, wpQAssignCompat_apply, qAssignObsMap, Observable.conj_coe,
        Unitary.coe_star,
        Matrix.star_eq_conjTranspose, conj_conj] using hstep_uncomp
    change ((wp (.qSeq (DynamicCircuit.andCompute (Var := Var) qc₁ qc₂ qanc hq₁a hq₂a).compile
        (.qSeq dBody.compile
          (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂).compile)) Θ σ).1).conj P_all =
      ((wpQAssignCompat V Θ σ).1).conj P_all
    calc ((wp (.qSeq (DynamicCircuit.andCompute (Var := Var) qc₁ qc₂ qanc hq₁a hq₂a).compile
            (.qSeq dBody.compile
              (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂).compile)) Θ σ).1).conj P_all
        = (((wp (.qSeq (DynamicCircuit.andCompute (Var := Var) qc₁ qc₂ qanc hq₁a hq₂a).compile
            (.qSeq dBody.compile
              (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂).compile)) Θ σ).1).conj P₀).conj
                P_all := by
            rw [conj_conj, hP₀_in_adj]
      _ = (((wpQAssignCompat T_anc (wp dBody.compile Ψ) σ).1).conj P₀).conj P_all := by
            rw [hstep1]
      _ = ((wp dBody.compile Ψ σ).1).conj ((P_all * P₀) * T_anc.1ᴴ) := by
            simp only [wpQAssignCompat, qAssignObsMap, Observable.conj_coe, Unitary.coe_star,
              Matrix.star_eq_conjTranspose, conj_conj, Matrix.mul_assoc]
      _ = ((wp dBody.compile Ψ σ).1).conj (T_anc.1ᴴ * P_body) := by
            rw [hP₀_in_adj, ← hTPb_adj]
      _ = (((wp dBody.compile Ψ σ).1).conj P_body).conj T_anc.1ᴴ := by
            rw [conj_conj]
      _ = (((wpQAssignCompat U_body Ψ σ).1).conj P_body).conj T_anc.1ᴴ := by
            rw [hBody.2 Ψ hΨ_inv σ]
      _ = (Ψ σ).1.conj ((T_anc.1ᴴ * P_body) * U_body.1ᴴ) := by
            simp only [wpQAssignCompat, qAssignObsMap, Observable.conj_coe, Unitary.coe_star,
              Matrix.star_eq_conjTranspose, conj_conj, Matrix.mul_assoc]
      _ = (Ψ σ).1.conj ((P_all * V.1ᴴ) * (P₀ * T_anc.1ᴴ)) := by
            rw [hTPb_adj, hprod_adj]
      _ = ((Ψ σ).1.conj (P₀ * T_anc.1ᴴ)).conj (P_all * V.1ᴴ) := by
            rw [conj_conj]
      _ = ((Θ σ).1.conj P₀).conj (P_all * V.1ᴴ) := by
            rw [hmid]
      _ = (Θ σ).1.conj (P_all * V.1ᴴ * P₀) := by
            rw [conj_conj]
