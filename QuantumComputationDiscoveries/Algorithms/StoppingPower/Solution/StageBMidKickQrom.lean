  by_cases hq : β q = 0
  · simp only [hq, ↓reduceIte, ket_CNOT]
  · simp only [hq, ↓reduceIte, Matrix.mulVec_zero]
theorem basisOutcomeProjector_zero_comm_toff {n : ℕ} [NeZero (2 ^ n)]
    (q c₁ c₂ anc : Wire n) (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    (hqa : anc ≠ q) :
    (QRegister.singleton q).basisOutcomeProjector 0 *
      (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 =
    (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 *
      (QRegister.singleton q).basisOutcomeProjector 0 := by
  apply matrix_ext_ket; intro β
  rw [mul_mulVec_prog, mul_mulVec_prog, ket_TOFF, ket_projector_zero, ket_projector_zero,
    Function.update_of_ne hqa.symm]
  by_cases hq : β q = 0
  · simp only [hq, ↓reduceIte, ket_TOFF]
  · simp only [hq, ↓reduceIte, Matrix.mulVec_zero]
theorem realizesCleanUnitary_wrapAnd
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (qc₁ qc₂ qanc : Wire n)
    (hq₁₂ : qc₁ ≠ qc₂) (hq₁a : qc₁ ≠ qanc) (hq₂a : qc₂ ≠ qanc)
    (P_all : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (hPall_herm : P_allᴴ = P_all)
    (P₀ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (hP₀_def : P₀ = (QRegister.singleton qanc).basisOutcomeProjector 0)
    (hP₀_in : P₀ * P_all = P_all)
    (dBody : DynamicCircuit Var n) (U_body : Unitary (2 ^ n))
    (hBody : RealizesCleanUnitary v
      ((Circuit.TOFF qc₁ qc₂ qanc hq₁₂ hq₁a hq₂a).eval.1 * P_all *
        (Circuit.TOFF qc₁ qc₂ qanc hq₁₂ hq₁a hq₂a).eval.1ᴴ)
      dBody U_body)
    (hBodyPres :
      let T_anc := (Circuit.TOFF qc₁ qc₂ qanc hq₁₂ hq₁a hq₂a).eval
      let P_body := T_anc.1 * P_all * T_anc.1ᴴ
      P_body * (U_body.1 * P_body) = U_body.1 * P_body) :
    let T_anc := (Circuit.TOFF qc₁ qc₂ qanc hq₁₂ hq₁a hq₂a).eval
    let V := T_anc * U_body * T_anc
    RealizesCleanUnitary v P_all
      (.seq (DynamicCircuit.andCompute qc₁ qc₂ qanc hq₁a hq₂a)
        (.seq dBody (DynamicCircuit.andUncompute v qc₁ qc₂ qanc hq₁₂)))
      V ∧
      P_all * (V.1 * P_all) = V.1 * P_all := by
