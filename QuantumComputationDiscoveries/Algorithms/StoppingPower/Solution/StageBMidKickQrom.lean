  have hb5 : ∀ w : Wire (mBAux B), w.val < 90 + B → g5 w = γ w := fun w hw ↦
    (hne5 w (by omega)).trans (hb4 w hw)
  have hb6 : ∀ w : Wire (mBAux B), w.val < 90 + B → g6 w = γ w := fun w hw ↦
    (hne6 w (by omega)).trans (hb5 w hw)
  have hg6_clean : cleanRem (mBAux B) (B + 4) g6 := fun w hw ↦ by
