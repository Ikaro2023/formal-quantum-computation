/-- Diagonal `±1` matrix indexed by `basisBits n`. -/
noncomputable def l26DiagMat {n : ℕ} (φ : BitAssignment n → ZMod 2) : Matrix (Fin (2 ^ n))
    (Fin (2 ^ n)) ℂ := Matrix.diagonal
    (fun g : Fin (2 ^ n) ↦ (-1 : ℂ) ^ (φ (basisBits n g)).val)
theorem l26DiagMat_conjTranspose {n : ℕ} (φ : BitAssignment n → ZMod 2) :
    (l26DiagMat φ)ᴴ = l26DiagMat φ := by
  ext i j
  by_cases hij : i = j
  · subst hij
    simp [l26DiagMat, Matrix.diagonal]
  · have hji : j ≠ i := Ne.symm hij
    simp [l26DiagMat, Matrix.conjTranspose_apply, Matrix.diagonal, hij, hji]
theorem l26DiagMat_mul {n : ℕ} (φ₁ φ₂ : BitAssignment n → ZMod 2) :
    l26DiagMat φ₂ * l26DiagMat φ₁ = l26DiagMat (fun β ↦ φ₁ β + φ₂ β) := by
  dsimp only [l26DiagMat]
  rw [Matrix.diagonal_mul_diagonal]
  congr 1; funext g
  rw [← neg_one_pow_zmod2_add, add_comm]
theorem l26DiagMat_mul_self {n : ℕ} (φ : BitAssignment n → ZMod 2) :
    l26DiagMat φ * l26DiagMat φ = 1 := by
  rw [l26DiagMat_mul]
  ext i j
  by_cases hij : i = j
  · subst hij
    simp [l26DiagMat, Matrix.diagonal, CharTwo.add_self_eq_zero]
  · simp [l26DiagMat, Matrix.diagonal, hij]
/-- Diagonal `±1` unitary on `n` wires from `φ : BitAssignment n → ZMod 2`. -/
noncomputable def l26DiagUnitary {n : ℕ} (φ : BitAssignment n → ZMod 2) : Unitary (2 ^ n) :=
  ⟨l26DiagMat φ, Matrix.mem_unitaryGroup_iff.mpr (by
    rw [Matrix.star_eq_conjTranspose, l26DiagMat_conjTranspose, l26DiagMat_mul_self])⟩
theorem l26DiagUnitary_mulVec_ket_p2t {n : ℕ} (φ : BitAssignment n → ZMod 2)
    (β : BitAssignment n) : (l26DiagUnitary φ).1.mulVec (OctahedralOrbit.ket β) =
    ((-1 : ℂ) ^ (φ β).val) • OctahedralOrbit.ket β := by
  let g := (basisBitsEquiv n).symm β
  have hg : basisBits n g = β := (basisBitsEquiv n).apply_symm_apply β
  rw [p2t_ket_eq_single β]
  ext i
  dsimp only [l26DiagUnitary, l26DiagMat]
  rw [Matrix.mulVec_diagonal]
  by_cases hig : i = g
  · rw [hig, hg]; simp [g]
  · simp [hig, g]
theorem l26DiagUnitary_mulVec_ket {n : ℕ} (φ : BitAssignment n → ZMod 2) (β : BitAssignment n)
    : (l26DiagUnitary φ).1.mulVec (ket β) = ((-1 : ℂ) ^ (φ β).val) • ket β := by
  rw [mbh_ket_eq_ket, l26DiagUnitary_mulVec_ket_p2t]
theorem l26DiagUnitary_mul {n : ℕ} (φ₁ φ₂ : BitAssignment n → ZMod 2) :
    l26DiagUnitary φ₂ * l26DiagUnitary φ₁ = l26DiagUnitary (fun β ↦ φ₁ β + φ₂ β) :=
  Subtype.ext (l26DiagMat_mul φ₁ φ₂)
theorem l26DiagUnitary_zero {n : ℕ} :
    l26DiagUnitary (fun _ : BitAssignment n ↦ (0 : ZMod 2)) = 1 := by
  apply Subtype.ext
  apply matrix_ext_ket; intro β
  rw [l26DiagUnitary_mulVec_ket, ZMod.val_zero, _root_.pow_zero, one_smul,
      Submonoid.coe_one, Matrix.one_mulVec]
theorem l26DiagUnitary_congr {n : ℕ} {φ₁ φ₂ : BitAssignment n → ZMod 2}
    (h : ∀ β, φ₁ β = φ₂ β) : l26DiagUnitary φ₁ = l26DiagUnitary φ₂ := by
  congr 1; funext β; exact h β
theorem l26DiagUnitary_diagIndepOf {n : ℕ} {W : Wire n → Prop} {φ : BitAssignment n → ZMod 2}
    (hIndep : ∀ β w val, W w → φ (Function.update β w val) = φ β) : p2t_DiagIndepOf W
    (l26DiagUnitary φ) :=
  ⟨fun β ↦ (-1 : ℂ) ^ (φ β).val, l26DiagUnitary_mulVec_ket_p2t φ,
   fun β w val hw ↦ by dsimp only; rw [hIndep β w val hw]⟩
theorem ketPredProj_comm_l26DiagUnitary {n : ℕ} (S : BitAssignment n → Prop)
    (φ : BitAssignment n → ZMod 2) :
    p2t_ketPredProj S * (l26DiagUnitary φ).1 = (l26DiagUnitary φ).1 * p2t_ketPredProj S := by
  classical
  dsimp only [p2t_ketPredProj, l26DiagUnitary, l26DiagMat]
  rw [Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
  congr 1; funext g; exact mul_comm _ _
theorem ketPredProj_mul_self {n : ℕ} (S : BitAssignment n → Prop) : p2t_ketPredProj S *
    p2t_ketPredProj S = p2t_ketPredProj S := p2t_ketPredProj_mul_imp (fun _ h ↦ h)
/-- Single-qubit Hadamard commutes with `p2t_ketPredProj S` when `S` is independent of `q`. -/
theorem hadamard_comm_ketPredProj {n : ℕ} (q : Wire n) (S : BitAssignment n → Prop)
    (hIndep : ∀ β val, S (Function.update β q val) ↔ S β) :
    p2t_ketPredProj S * (Circuit.H q).eval.1 = (Circuit.H q).eval.1 * p2t_ketPredProj S := by
  classical
  apply matrix_ext_ket; intro β
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  by_cases hs : S β
  · have hR : (p2t_ketPredProj S).mulVec (ket β) = ket β := by
      rw [mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_left hs]
    have h0 : (p2t_ketPredProj S).mulVec (ket (Function.update β q 0)) =
        ket (Function.update β q 0) := by
      rw [mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_left ((hIndep β 0).mpr hs)]
    have h1 : (p2t_ketPredProj S).mulVec (ket (Function.update β q 1)) =
        ket (Function.update β q 1) := by
      rw [mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_left ((hIndep β 1).mpr hs)]
    rw [hR, ket_H]
    simp only [Matrix.mulVec_smul, Matrix.mulVec_add, h0, h1]
  · have hR : (p2t_ketPredProj S).mulVec (ket β) = 0 := by
      rw [mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_right hs]
    have h0 : (p2t_ketPredProj S).mulVec (ket (Function.update β q 0)) = 0 := by
      rw [mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_right (mt (hIndep β 0).mp hs)]
    have h1 : (p2t_ketPredProj S).mulVec (ket (Function.update β q 1)) = 0 := by
      rw [mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_right (mt (hIndep β 1).mp hs)]
    rw [hR, ket_H]
    simp only [Matrix.mulVec_smul, Matrix.mulVec_add, h0, h1,
      Matrix.mulVec_zero, smul_zero, add_zero]
/-- `hadamardReg r` commutes with `p2t_ketPredProj S` when `S` is independent of every wire in
  `r`. -/
theorem hadamardReg_comm_ketPredProj {n : ℕ} (S : BitAssignment n → Prop) :
    ∀ {b : ℕ} (r : QRegister b n),
      (∀ (i : Fin b) β val, S (Function.update β (r i) val) ↔ S β) →
      p2t_ketPredProj S * (hadamardReg r).eval.1 = (hadamardReg r).eval.1 * p2t_ketPredProj S
  | 0, _, _ => by simp [hadamardReg, Circuit.eval_identity]
  | b + 1, r, hInd => by
      dsimp only [hadamardReg]
      rw [Circuit.eval_seq, Submonoid.coe_mul, ← Matrix.mul_assoc,
        hadamardReg_comm_ketPredProj S (r.slice 1 b (by omega))
          (fun i β val ↦ by rw [QRegister.slice_apply]; exact hInd _ β val),
        Matrix.mul_assoc, hadamard_comm_ketPredProj (r 0) S (hInd 0), ← Matrix.mul_assoc]
