/-- A unitary `U : Unitary (2 ^ n)` acts as the classical bit-assignment map `f` on every
computational-basis ket `basisKet β`. -/
def UnitaryPerm {n : ℕ} (U : Unitary (2 ^ n)) (f : BitAssignment n → BitAssignment n) : Prop :=
  ∀ β : BitAssignment n, U.1.mulVec (basisKet β) = basisKet (f β)


theorem UnitaryPerm.mul {n : ℕ} {U₁ U₂ : Unitary (2 ^ n)}
    {f₁ f₂ : BitAssignment n → BitAssignment n}
    (h₁ : UnitaryPerm U₁ f₁) (h₂ : UnitaryPerm U₂ f₂) :
    UnitaryPerm (U₂ * U₁) (f₂ ∘ f₁) := fun β ↦ by
  rw [Submonoid.coe_mul, ← Matrix.mulVec_mulVec, h₁ β, Function.comp_apply, h₂ (f₁ β)]

/-- Level-`(offset, count)` `splitSymStep` bank on `rU108 : QRegister 108 n`. -/
def splitU108Steps {n : ℕ} (offset count : ℕ)
    (hCnt : count ≤ offset) (hBound : offset + count ≤ 108)
    (ctrl : Wire n) (rU108 : QRegister 108 n)
    (hcU : ∀ k : Fin 108, ctrl ≠ rU108 k) : Fin count → SymTempAndStep n :=
  have hSD : (rU108.slice 0 count (by omega)).DisjointWires (rU108.slice offset count hBound) := by
    rw [QRegExt.disjointWires_iff_disjoint_image, Finset.disjoint_left]
    intro w hw1 hw2
    obtain ⟨i, rfl⟩ := (QRegister.mem_image _ w).mp hw1
    obtain ⟨j, hj⟩ := (QRegister.mem_image _ _).mp hw2
    have hv := congrArg Fin.val (rU108.wires.injective hj)
    change offset + j.val = 0 + i.val at hv
    have := i.isLt
    omega
  splitBankSteps ctrl (rU108.slice 0 count (by omega)) (rU108.slice offset count hBound)
    (fun i ↦ hcU ⟨0 + i.val, by omega⟩)
    (fun i ↦ hcU ⟨offset + i.val, by omega⟩)
    hSD

/-- Inductive one-hot splitting invariant on `rU108` across any level `(offset, count)`
(covering both full levels `count = offset` and the pruned top level `offset = 64, count = 44`). -/
theorem splitU108_oneHot_step {n : ℕ} (offset count : ℕ)
    (hCnt : count ≤ offset) (hBound : offset + count ≤ 108)
    (ctrl : Wire n) (rU108 : QRegister 108 n)
    (hcU : ∀ k : Fin 108, ctrl ≠ rU108 k)
    (β : BitAssignment n) (en : Bool) (lowVal : ℕ)
    (hLowLt : en = true → lowVal < offset)
    (hPrune : en = true → lowVal + (β ctrl).val * offset < offset + count)
    (hInv : ∀ k : Fin 108,
      β (rU108 k) = if (en = true ∧ k.val < offset ∧ lowVal = k.val) then 1 else 0) :
    let β' := bankFwd count (splitU108Steps offset count hCnt hBound ctrl rU108 hcU) β
    (∀ w, w ∉ rU108.image → β' w = β w) ∧
    (∀ k : Fin 108,
      β' (rU108 k) =
        if (en = true ∧ k.val < offset + count ∧ lowVal + (β ctrl).val * offset = k.val)
        then 1 else 0) := by
  intro β'
  let rSrc := rU108.slice 0 count (by omega)
  let rDst := rU108.slice offset count hBound
  have hSrcApply : ∀ i : Fin count, rSrc i = rU108 ⟨i.val, by omega⟩ := fun i ↦
    congrArg rU108 (Fin.ext (by simp))
  have hDstApply : ∀ i : Fin count, rDst i = rU108 ⟨offset + i.val, by omega⟩ := fun i ↦
    congrArg rU108 (Fin.ext rfl)
  have hzDst : ∀ i : Fin count, β (rDst i) = 0 := fun i ↦ by
    rw [hDstApply i, hInv]
    have hn : ¬(offset + i.val < offset) := by omega
    simp [hn]
  obtain ⟨hOut, hSrc, hDst⟩ := splitBank_eval ctrl count rSrc rDst _ _ _ β hzDst
  refine ⟨fun w hw ↦ hOut w
    (fun hm ↦ hw (rU108.image_compose_subset _ hm))
    (fun hm ↦ hw (rU108.image_compose_subset _ hm)), fun k ↦ ?_⟩
  by_cases hk1 : k.val < count
  · have hkEq : rU108 k = rSrc ⟨k.val, hk1⟩ := (hSrcApply ⟨k.val, hk1⟩).symm
    change bankFwd count (splitU108Steps offset count hCnt hBound ctrl rU108 hcU) β (rU108 k) = _
    rw [hkEq, splitU108Steps, hSrc ⟨k.val, hk1⟩, hSrcApply ⟨k.val, hk1⟩]
    have hkEq' : (⟨k.val, by omega⟩ : Fin 108) = k := Fin.ext rfl
    rw [hkEq', hInv k]
    rcases zmod2_cases (β ctrl) with hc | hc <;> rw [hc]
    · have hkOff : k.val < offset := by omega
      have hkBnd : k.val < offset + count := by omega
      simp [hkOff, hkBnd]
    · have hne : lowVal + offset ≠ k.val := by omega
      simp [hne, CharTwo.add_self_eq_zero]
  · by_cases hk2 : k.val < offset
    · have hNotSrc : rU108 k ∉ rSrc.image := fun hm ↦ by
        obtain ⟨i, hi⟩ := (QRegister.mem_image rSrc _).mp hm
        rw [hSrcApply i] at hi
        have hv := congrArg Fin.val (rU108.wires.injective hi)
        change i.val = k.val at hv
        have := i.isLt
        omega
      have hNotDst : rU108 k ∉ rDst.image := fun hm ↦ by
        obtain ⟨i, hi⟩ := (QRegister.mem_image rDst _).mp hm
        rw [hDstApply i] at hi
        have hv := congrArg Fin.val (rU108.wires.injective hi)
        change offset + i.val = k.val at hv
        omega
      change bankFwd count (splitU108Steps offset count hCnt hBound ctrl rU108 hcU) β (rU108 k) = _
      rw [splitU108Steps, hOut (rU108 k) hNotSrc hNotDst, hInv k]
      rcases zmod2_cases (β ctrl) with hc | hc <;> rw [hc]
      · have hkBnd : k.val < offset + count := by omega
        simp [hk2, hkBnd]
      · cases en
        · simp
        · have hp := hPrune rfl
          rw [hc] at hp
          change lowVal + 1 * offset < offset + count at hp
          have hne1 : lowVal ≠ k.val := by omega
          have hne2 : lowVal + offset ≠ k.val := by omega
          simp [hne1, hne2]
    · by_cases hk3 : k.val < offset + count
      · let j : Fin count := ⟨k.val - offset, by omega⟩
        have hkEq : rU108 k = rDst j := by
          rw [hDstApply j]
          exact congrArg rU108 (Fin.ext (by
            dsimp [j]
            omega))
        change bankFwd count (splitU108Steps offset count hCnt hBound ctrl rU108 hcU) β (rU108 k) =
          _
        rw [hkEq, splitU108Steps, hDst j, hSrcApply j, hInv]
        have hjOff : j.val < offset := by
          dsimp [j]
          omega
        rcases zmod2_cases (β ctrl) with hc | hc <;> rw [hc]
        · cases en
          · simp
          · have hlt := hLowLt rfl
            have hne : lowVal ≠ k.val := by omega
            simp [hne]
        · simp only [one_mul, ZMod.val_one, hjOff, hk3, true_and]
          by_cases hen : en = true
          · simp only [hen, true_and]
            by_cases heq : lowVal = j.val
            · have heq2 : j.val + offset = k.val := by
                dsimp [j]
                omega
              simp [heq, heq2]
            · have heq2 : lowVal + offset ≠ k.val := by
                dsimp [j] at heq
                omega
              simp [heq, heq2]
          · simp [hen]
      · have hNotSrc : rU108 k ∉ rSrc.image := fun hm ↦ by
          obtain ⟨i, hi⟩ := (QRegister.mem_image rSrc _).mp hm
          rw [hSrcApply i] at hi
          have hv := congrArg Fin.val (rU108.wires.injective hi)
          change i.val = k.val at hv
          have := i.isLt
          omega
        have hNotDst : rU108 k ∉ rDst.image := fun hm ↦ by
          obtain ⟨i, hi⟩ := (QRegister.mem_image rDst _).mp hm
          rw [hDstApply i] at hi
          have hv := congrArg Fin.val (rU108.wires.injective hi)
          change offset + i.val = k.val at hv
          have := i.isLt
          omega
        change bankFwd count (splitU108Steps offset count hCnt hBound ctrl rU108 hcU) β (rU108 k) =
          _
        rw [splitU108Steps, hOut (rU108 k) hNotSrc hNotDst, hInv k]
        simp [hk2, hk3]

/-- `2`-`CNOT` seed circuit setting `rU108 0 ⊕= rS7 1 + rS7 6` (`= coin0Active ∧ nucIdx < 216`). -/
def cSeedEnLt216 {n : ℕ} (rS7 : QRegister 7 n) (rU108 : QRegister 108 n)
    (hSU : rS7.DisjointWires rU108) : Circuit n :=
  Circuit.CNOT (rS7 1) (rU108 0) (hSU.ne 1 0) ;;ᶜ
    Circuit.CNOT (rS7 6) (rU108 0) (hSU.ne 6 0)

/-- Inverse of `cSeedEnLt216`. -/
def cSeedEnLt216Inv {n : ℕ} (rS7 : QRegister 7 n) (rU108 : QRegister 108 n)
    (hSU : rS7.DisjointWires rU108) : Circuit n :=
  Circuit.CNOT (rS7 6) (rU108 0) (hSU.ne 6 0) ;;ᶜ
    Circuit.CNOT (rS7 1) (rU108 0) (hSU.ne 1 0)

