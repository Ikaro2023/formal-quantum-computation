    ctxComp17_countTempAnd, cLeafComp17On_count_t]
theorem dComp17_preservesStoreConst {Var : Type} [Fintype Var] [DecidableEq Var]
    {n mScr : ℕ} (hm20 : 20 ≤ mScr) (v : Var) (rCore : QRegister posCoreWires n)
    (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) : PreservesStoreConst
    (dComp17 hm20 v rCore rScr hCS) := by
  let _ : NeZero (2 ^ n) := ⟨(Nat.two_pow_pos n).ne'⟩
  exact PreservesStoreConst.seq (PreservesStoreConst.circuit _)
    (PreservesStoreConst.seq (mk34_ctxToDyn_preservesStoreConst v _ _ ctxComp17)
      (PreservesStoreConst.circuit _))
