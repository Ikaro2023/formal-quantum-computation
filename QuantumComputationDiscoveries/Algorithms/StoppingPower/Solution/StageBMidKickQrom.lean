/-- Right-multiply both sides of a `SubspaceStep` by any operator `G`. -/
theorem SubspaceStep.mul_right {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    {R_in R_out : Operator (2 ^ n)} (G : Operator (2 ^ n)) {p : DynamicCircuit Var n}
    (hp : SubspaceStep R_in R_out p) :
    SubspaceStep (R_in * G) (R_out * G) p := fun M ↦
  let ⟨N, hw, hm⟩ := hp M
