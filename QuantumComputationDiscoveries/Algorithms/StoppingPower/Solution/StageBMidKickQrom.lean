            simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]
      _ = Gᴴ * (R_inᴴ * N.1.1 * R_in) * G := by rw [hm]
      _ = (R_in * G)ᴴ * N.1.1 * (R_in * G) := by
