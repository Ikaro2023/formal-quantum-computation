  obtain ⟨_, he85, hw85⟩ := ctxMidB_fwdBits_wire B hB1 hB27 ⟨85, by dsimp [mBAux]; omega⟩ γ hγ
  obtain ⟨_, heu1, hwu1⟩ := ctxMidB_fwdBits_wire B hB1 hB27 ⟨90 + B, by dsimp [mBAux]; omega⟩ γ hγ
  obtain ⟨_, hevL, hwvL⟩ := ctxMidB_fwdBits_wire B hB1 hB27 ⟨94 + B, by dsimp [mBAux]; omega⟩ γ hγ
  obtain ⟨_, hed6, hwd6⟩ :=
    ctxMidB_fwdBits_wire B hB1 hB27 ⟨96 + 2 * B + 2, by dsimp [mBAux]; omega⟩ γ hγ
  obtain ⟨_, hed7, hwd7⟩ :=
