def outsideDec61 (C : ℕ) {M : ℕ} (u : Wire M) : Prop :=
  u.val < C ∧ ∀ (q : ℕ), q < 61 → u.val ≠ decWireNum C q
theorem decWireGen_not_outsideDec61 {mPayload off mClean w : ℕ} (hmPay : 80 ≤ mPayload)
    (hw : w < 61 + mClean) :
    ¬ outsideDec61 (fullSysCoreWires mPayload) (decWireGen hmPay off mClean w hw) := by
  rintro ⟨hlt, hne⟩
  by_cases hw61 : w < 61
  · exact hne w hw61 (decWireNumGen_lt_61 hw61)
