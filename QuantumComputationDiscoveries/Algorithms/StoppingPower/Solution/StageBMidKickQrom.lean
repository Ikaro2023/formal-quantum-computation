noncomputable def pebBitFnGen {n mPayload mWB : ℕ} (hmPay : 80 ≤ mPayload) (p : List DecStep)
    (hWB : 114 ≤ mWB) (rCore : QRegister (fullSysCoreWires mPayload) n)
    (rWB : QRegister mWB n) (β : BitAssignment n) : BitAssignment n := Internal.writeRegProg β
    (rWB.slice 8 106 (by omega)) (fun m ↦ if rawPebble p 61 (stHighCore hmPay rCore β) (61 +
