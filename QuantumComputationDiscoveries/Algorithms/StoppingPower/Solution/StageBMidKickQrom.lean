    rw [hv, hv, hc19]
    simpa [add_assoc] using hz2 (γ (rScr ⟨24, by omega⟩)) (1 + γ (rScr ⟨19, by omega⟩))
  · by_cases h23 : w = rScr ⟨23, by omega⟩
    · subst h23
      have hv : ∀ δ, initChunkDums5Bits hm25 rScr δ (rScr ⟨23, by omega⟩) =
          δ (rScr ⟨23, by omega⟩) + 1 + δ (rScr ⟨18, by omega⟩) + δ (rScr ⟨19, by omega⟩) := fun δ ↦
            by
        simp [initChunkDums5Bits]
      rw [hv, hv, hc18, hc19]
      simpa [add_assoc] using hz2 (γ (rScr ⟨23, by omega⟩))
        (1 + (γ (rScr ⟨18, by omega⟩) + γ (rScr ⟨19, by omega⟩)))
    · by_cases h22 : w = rScr ⟨22, by omega⟩
      · subst h22
        have hv : ∀ δ, initChunkDums5Bits hm25 rScr δ (rScr ⟨22, by omega⟩) =
            δ (rScr ⟨22, by omega⟩) + 1 + δ (rScr ⟨17, by omega⟩) + δ (rScr ⟨18, by omega⟩) :=
              fun δ ↦ by
          simp [initChunkDums5Bits]
        rw [hv, hv, hc17, hc18]
        simpa [add_assoc] using hz2 (γ (rScr ⟨22, by omega⟩))
          (1 + (γ (rScr ⟨17, by omega⟩) + γ (rScr ⟨18, by omega⟩)))
      · by_cases h21 : w = rScr ⟨21, by omega⟩
        · subst h21
          have hv : ∀ δ, initChunkDums5Bits hm25 rScr δ (rScr ⟨21, by omega⟩) =
              δ (rScr ⟨21, by omega⟩) + 1 + δ (rScr ⟨16, by omega⟩) + δ (rScr ⟨17, by omega⟩) :=
                fun δ ↦ by
            simp [initChunkDums5Bits]
          rw [hv, hv, hc16, hc17]
          simpa [add_assoc] using hz2 (γ (rScr ⟨21, by omega⟩))
            (1 + (γ (rScr ⟨16, by omega⟩) + γ (rScr ⟨17, by omega⟩)))
        · by_cases h20 : w = rScr ⟨20, by omega⟩
          · subst h20
            have hv : ∀ δ, initChunkDums5Bits hm25 rScr δ (rScr ⟨20, by omega⟩) =
                δ (rScr ⟨20, by omega⟩) + 1 + δ (rScr ⟨15, by omega⟩) + δ (rScr ⟨16, by omega⟩) :=
                  fun δ ↦ by
              simp [initChunkDums5Bits]
            rw [hv, hv, hc15, hc16]
            simpa [add_assoc] using hz2 (γ (rScr ⟨20, by omega⟩))
              (1 + (γ (rScr ⟨15, by omega⟩) + γ (rScr ⟨16, by omega⟩)))
          · rw [initChunkDums5Bits_apply_outside hm25 rScr _ w h20 h21 h22 h23 h24,
