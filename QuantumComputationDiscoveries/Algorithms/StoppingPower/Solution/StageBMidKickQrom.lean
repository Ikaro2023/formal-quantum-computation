        (γ ⟨1, by dsimp [mBAux]; omega⟩)
        (γ ⟨0, by dsimp [mBAux]; omega⟩)
        (γ ⟨68, by dsimp [mBAux]; omega⟩)
        (γ ⟨36, by dsimp [mBAux]; omega⟩)
        (γ ⟨85, by dsimp [mBAux]; omega⟩)
        ge216 ge218 ge217 1
        (if bitsVal (fun k : Fin 30 ↦ γ ⟨38 + k.val, by dsimp [mBAux]; omega⟩) <
            2 ^ (29 - B) + 2 ^ (30 - B) *
              bitsVal (fun j : Fin B ↦ γ ⟨89 + j.val, by dsimp [mBAux]; omega⟩)
         then 1 else 0)
        (γ ⟨89 + B, by dsimp [mBAux]; omega⟩) := by
