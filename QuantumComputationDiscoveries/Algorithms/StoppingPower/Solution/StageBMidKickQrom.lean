theorem UnitaryPhasePerm.of_eq {n : ℕ} {U : Unitary (2 ^ n)}
    {φ ψ : BitAssignment n → ℂ} {f g : BitAssignment n → BitAssignment n}
    (h : UnitaryPhasePerm U φ f) (hφ : ∀ β, φ β = ψ β) (hf : ∀ β, f β = g β) :
    UnitaryPhasePerm U ψ g := fun β ↦ by
  rw [h β, hφ β, hf β]
noncomputable def unaryBank108Fwd {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) (γ : BitAssignment n) : BitAssignment n :=
  let hcU : ∀ (b : Fin 8) (k : Fin 108), rCore (rNucIdx hm (QRegExt.idReg _) b) ≠ rU108 k :=
    fun b k ↦ hCU.ne _ k
  bankFwd 44 (splitU108Steps 64 44 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _) 7))
    rU108 (hcU 7))
    (bankFwd 32 (splitU108Steps 32 32 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _)
      6)) rU108 (hcU 6))
      (bankFwd 16 (splitU108Steps 16 16 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _)
        5)) rU108 (hcU 5))
        (bankFwd 8 (splitU108Steps 8 8 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _)
          4)) rU108 (hcU 4))
          (bankFwd 4 (splitU108Steps 4 4 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg
            _) 3)) rU108 (hcU 3))
            (bankFwd 2 (splitU108Steps 2 2 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg
              _) 2)) rU108 (hcU 2))
              (bankFwd 1 (splitU108Steps 1 1 (by decide) (by decide) (rCore (rNucIdx hm
                (QRegExt.idReg _) 1)) rU108 (hcU 1))
                γ))))))
theorem unaryBank108Fwd_eval {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108)
    (β_seed : BitAssignment n) (γc : BitAssignment (fullSysCoreWires mp))
    (hCoreSeed : ∀ q, β_seed (rCore q) = γc q)
    (hSeedInv : ∀ k : Fin 108,
      β_seed (rU108 k) =
        if (decide (coin0Active γc = true ∧ regVal (rNucIdx hm (QRegExt.idReg _)) γc < 216) = true ∧
            k.val < 1 ∧ 0 = k.val)
        then 1 else 0) :
    (∀ u, u ∉ rU108.image → unaryBank108Fwd hm rCore rU108 hCU β_seed u = β_seed u) ∧
    (∀ k : Fin 108,
      unaryBank108Fwd hm rCore rU108 hCU β_seed (rU108 k) =
        if (coin0Active γc = true ∧ regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 = k.val)
        then 1 else 0) := by
  let hcU : ∀ (b : Fin 8) (k : Fin 108), rCore (rNucIdx hm (QRegExt.idReg _) b) ≠ rU108 k :=
    fun b k ↦ hCU.ne _ k
  let en : Bool := decide (coin0Active γc = true ∧ regVal (rNucIdx hm (QRegExt.idReg _)) γc < 216)
  obtain ⟨bi, hbi_def, hDecomp, hbLe⟩ : ∃ bi : Fin 8 → ℕ,
      (∀ i : Fin 8, (γc (rNucIdx hm (QRegExt.idReg _) i)).val = bi i) ∧
      regVal (rNucIdx hm (QRegExt.idReg _)) γc =
        bi 0 + 2 * (bi 1 * 1 + bi 2 * 2 + bi 3 * 4 + bi 4 * 8 + bi 5 * 16 + bi 6 * 32 + bi 7 * 64) ∧
      (∀ i : Fin 8, bi i ≤ 1) := by
    obtain ⟨hd, hle⟩ := regVal_rNucIdx_div2_decomp hm γc
    exact ⟨_, fun _ ↦ rfl, hd, hle⟩
  have hCtrlVal : ∀ (stepOut : BitAssignment n),
      (∀ u, u ∉ rU108.image → stepOut u = β_seed u) →
      ∀ i : Fin 8, (stepOut (rCore (rNucIdx hm (QRegExt.idReg _) i))).val = bi i :=
    fun stepOut hSO i ↦ by
      rw [hSO _ (hCU.apply_not_mem_right _), hCoreSeed, hbi_def]
  obtain ⟨hO_0, hI_0⟩ := splitU108_oneHot_step 1 1 (by decide) (by decide)
    (rCore (rNucIdx hm (QRegExt.idReg _) 1)) rU108 (hcU 1) β_seed en 0
    (fun _ ↦ by decide)
    (fun _ ↦ by rw [hCtrlVal β_seed (fun _ _ ↦ rfl) 1]; have := hbLe 1; omega)
    hSeedInv
  rw [hCtrlVal β_seed (fun _ _ ↦ rfl) 1] at hI_0
  let βu1 :=
    bankFwd 1 (splitU108Steps 1 1 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _) 1))
    rU108 (hcU 1)) β_seed
  have hSO_1 : ∀ u, u ∉ rU108.image → βu1 u = β_seed u := hO_0
  obtain ⟨hO_1, hI_1⟩ := splitU108_oneHot_step 2 2 (by decide) (by decide)
    (rCore (rNucIdx hm (QRegExt.idReg _) 2)) rU108 (hcU 2) βu1 en (0 + bi 1 * 1)
    (fun _ ↦ by have := hbLe 1; omega)
    (fun _ ↦ by rw [hCtrlVal βu1 hSO_1 2]; have := hbLe 1; have := hbLe 2; omega)
    hI_0
  rw [hCtrlVal βu1 hSO_1 2] at hI_1
  let βu2 :=
    bankFwd 2 (splitU108Steps 2 2 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _) 2))
    rU108 (hcU 2)) βu1
  have hSO_2 : ∀ u, u ∉ rU108.image → βu2 u = β_seed u := fun u hu ↦ (hO_1 u hu).trans (hSO_1 u hu)
  obtain ⟨hO_2, hI_2⟩ := splitU108_oneHot_step 4 4 (by decide) (by decide)
    (rCore (rNucIdx hm (QRegExt.idReg _) 3)) rU108 (hcU 3) βu2 en (0 + bi 1 * 1 + bi 2 * 2)
    (fun _ ↦ by have := hbLe 1; have := hbLe 2; omega)
    (fun _ ↦ by rw [hCtrlVal βu2 hSO_2 3]; have := hbLe 1; have := hbLe 2; have := hbLe 3; omega)
    hI_1
  rw [hCtrlVal βu2 hSO_2 3] at hI_2
  let βu3 :=
    bankFwd 4 (splitU108Steps 4 4 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _) 3))
    rU108 (hcU 3)) βu2
  have hSO_3 : ∀ u, u ∉ rU108.image → βu3 u = β_seed u := fun u hu ↦ (hO_2 u hu).trans (hSO_2 u hu)
  obtain ⟨hO_3, hI_3⟩ := splitU108_oneHot_step 8 8 (by decide) (by decide)
    (rCore (rNucIdx hm (QRegExt.idReg _) 4)) rU108 (hcU 4) βu3 en
    (0 + bi 1 * 1 + bi 2 * 2 + bi 3 * 4)
    (fun _ ↦ by have := hbLe 1; have := hbLe 2; have := hbLe 3; omega)
    (fun _ ↦ by
      rw [hCtrlVal βu3 hSO_3 4];
      have := hbLe 1;
      have := hbLe 2;
      have := hbLe 3;
      have :=
        hbLe 4; omega)
    hI_2
  rw [hCtrlVal βu3 hSO_3 4] at hI_3
  let βu4 :=
    bankFwd 8 (splitU108Steps 8 8 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _) 4))
    rU108 (hcU 4)) βu3
  have hSO_4 : ∀ u, u ∉ rU108.image → βu4 u = β_seed u := fun u hu ↦ (hO_3 u hu).trans (hSO_3 u hu)
  obtain ⟨hO_4, hI_4⟩ := splitU108_oneHot_step 16 16 (by decide) (by decide)
    (rCore (rNucIdx hm (QRegExt.idReg _) 5)) rU108 (hcU 5) βu4 en
    (0 + bi 1 * 1 + bi 2 * 2 + bi 3 * 4 + bi 4 * 8)
    (fun _ ↦ by have := hbLe 1; have := hbLe 2; have := hbLe 3; have := hbLe 4; omega)
    (fun _ ↦ by
      rw [hCtrlVal βu4 hSO_4 5];
      have := hbLe 1;
      have := hbLe 2;
      have := hbLe 3;
      have :=
        hbLe 4; have := hbLe 5; omega)
    hI_3
  rw [hCtrlVal βu4 hSO_4 5] at hI_4
  let βu5 :=
    bankFwd 16 (splitU108Steps 16 16 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _)
    5)) rU108 (hcU 5)) βu4
  have hSO_5 : ∀ u, u ∉ rU108.image → βu5 u = β_seed u := fun u hu ↦ (hO_4 u hu).trans (hSO_4 u hu)
  obtain ⟨hO_5, hI_5⟩ := splitU108_oneHot_step 32 32 (by decide) (by decide)
    (rCore (rNucIdx hm (QRegExt.idReg _) 6)) rU108 (hcU 6) βu5 en
    (0 + bi 1 * 1 + bi 2 * 2 + bi 3 * 4 + bi 4 * 8 + bi 5 * 16)
    (fun _ ↦ by
      have := hbLe 1;
      have := hbLe 2;
      have := hbLe 3;
      have := hbLe 4;
      have :=
        hbLe 5; omega)
    (fun _ ↦ by
      rw [hCtrlVal βu5 hSO_5 6];
      have := hbLe 1;
      have := hbLe 2;
      have := hbLe 3;
      have :=
        hbLe 4; have := hbLe 5; have := hbLe 6; omega)
    hI_4
  rw [hCtrlVal βu5 hSO_5 6] at hI_5
  let βu6 :=
    bankFwd 32 (splitU108Steps 32 32 (by decide) (by decide) (rCore (rNucIdx hm (QRegExt.idReg _)
    6)) rU108 (hcU 6)) βu5
  have hSO_6 : ∀ u, u ∉ rU108.image → βu6 u = β_seed u := fun u hu ↦ (hO_5 u hu).trans (hSO_5 u hu)
  obtain ⟨hO_6, hI_6⟩ := splitU108_oneHot_step 64 44 (by decide) (by decide)
    (rCore (rNucIdx hm (QRegExt.idReg _) 7)) rU108 (hcU 7) βu6 en
    (0 + bi 1 * 1 + bi 2 * 2 + bi 3 * 4 + bi 4 * 8 + bi 5 * 16 + bi 6 * 32)
    (fun _ ↦ by
      have := hbLe 1;
      have := hbLe 2;
      have := hbLe 3;
      have := hbLe 4;
      have :=
        hbLe 5; have := hbLe 6; omega)
    (fun hen ↦ by
      rw [hCtrlVal βu6 hSO_6 7]
      have hlt216 : regVal (rNucIdx hm (QRegExt.idReg _)) γc < 216 := (of_decide_eq_true hen).2
      have hdec := hDecomp
      omega)
    hI_5
  rw [hCtrlVal βu6 hSO_6 7] at hI_6
  refine ⟨fun u hu ↦ (hO_6 u hu).trans (hSO_6 u hu), fun k ↦ ?_⟩
  have hI_bank : unaryBank108Fwd hm rCore rU108 hCU β_seed (rU108 k) =
      if (en = true ∧ k.val < 64 + 44 ∧
          0 + bi 1 * 1 + bi 2 * 2 + bi 3 * 4 + bi 4 * 8 + bi 5 * 16 + bi 6 * 32 + bi 7 * 64 = k.val)
      then 1 else 0 := hI_6 k
  rw [hI_bank]
  have hdec := hDecomp
  have hb0_le : bi 0 ≤ 1 := hbLe 0
  have hk_lt : k.val < 64 + 44 := k.isLt
  have hdiv : 0 + bi 1 * 1 + bi 2 * 2 + bi 3 * 4 + bi 4 * 8 + bi 5 * 16 + bi 6 * 32 + bi 7 * 64 =
      regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 := by omega
  rw [hdiv]
  by_cases hc0 : coin0Active γc = true
  · by_cases heq : regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 = k.val
    · have hlt216 : regVal (rNucIdx hm (QRegExt.idReg _)) γc < 216 := by omega
      have hen : en = true := decide_eq_true ⟨hc0, hlt216⟩
      simp [hen, hk_lt, hc0, heq]
    · simp [hc0, heq]
  · have hen : en = false := Bool.eq_false_iff.mpr (fun ht ↦ hc0 (of_decide_eq_true ht).1)
    simp [hen, hc0]

/-! ### Section 1: `ket`/`basisKet` & `CleanUnitaryEquiv ↔ SubspaceStep` Bridges -/

theorem eq_basisKet {n : ℕ} (β : BitAssignment n) : ket β = basisKet β := by
  ext i
  simp [ket, basisKet, basisState, basisBitsEquiv]

theorem subspaceStep_of_cleanUnitaryEquiv {Var : Type} [Fintype Var] [DecidableEq Var]
    {m n : ℕ} [NeZero (2 ^ n)]
    {rWork : QRegister m n} {U : Unitary (2 ^ n)} {d : DynamicCircuit Var n}
    (hc : CleanUnitaryEquiv rWork U d)
    {R : Operator (2 ^ n)}
    (hPR : rWork.basisOutcomeProjector 0 * R = R) :
    SubspaceStep R (U.1 * R) d := fun M ↦ by
  let P := rWork.basisOutcomeProjector 0
  have hPh : Pᴴ = P := QRegister.basisOutcomeProjector_conjTranspose rWork 0
  have hRP : Rᴴ * P = Rᴴ := by
    simpa only [P, Matrix.conjTranspose_mul, hPh] using congrArg Matrix.conjTranspose hPR
  obtain ⟨M', hwp, hrest⟩ := hc M
  refine ⟨M', hwp, ?_⟩
  have h0 : P * (M'.1.mat * P) = P * (U.1ᴴ * (M.1.mat * (U.1 * P))) := by
    have hm := congrArg (fun X ↦ (X (fun _ : Var ↦ (0 : ℤ))).1.mat) hrest
    simpa only [P, CQAssertion.restrictToZeroAncilla_coe, wpQAssignCompat, qAssignObsMap,
      Observable.conj_coe, Unitary.coe_star, Matrix.star_eq_conjTranspose,
      HermitianMat.conj_apply_mat, conjTranspose_conjTranspose, hPh, Matrix.mul_assoc] using hm
  have h0' : P * M'.1.1 * P = P * (U.1ᴴ * M.1.1 * U.1) * P := by
    change P * M'.1.mat * P = P * (U.1ᴴ * M.1.mat * U.1) * P
    simpa only [Matrix.mul_assoc] using h0
  calc (U.1 * R)ᴴ * M.1.1 * (U.1 * R)
      = Rᴴ * (P * (U.1ᴴ * M.1.1 * U.1) * P) * R := by
          rw [Matrix.conjTranspose_mul]
          simp only [Matrix.mul_assoc]
          rw [hPR, ← Matrix.mul_assoc Rᴴ P, hRP]
    _ = Rᴴ * (P * M'.1.1 * P) * R := by rw [h0'.symm]
    _ = Rᴴ * M'.1.1 * R := by
          simp only [Matrix.mul_assoc]
          rw [hPR, ← Matrix.mul_assoc Rᴴ P, hRP]

theorem cleanUnitaryEquiv_of_subspaceStep {Var : Type} [Fintype Var] [DecidableEq Var]
    {m n : ℕ} [NeZero (2 ^ n)]
    {rWork : QRegister m n} {U : Unitary (2 ^ n)} {d : DynamicCircuit Var n}
    (hs : SubspaceStep (rWork.basisOutcomeProjector 0) (U.1 * rWork.basisOutcomeProjector 0) d) :
    CleanUnitaryEquiv rWork U d := fun M ↦ by
  let P := rWork.basisOutcomeProjector 0
  have hPh : Pᴴ = P := QRegister.basisOutcomeProjector_conjTranspose rWork 0
  obtain ⟨N, hwp, hm⟩ := hs M
  refine ⟨N, hwp, ?_⟩
  have hproj : P * (N.1.mat * P) = P * (U.1ᴴ * (M.1.mat * (U.1 * P))) := by
    change P * (N.1.1 * P) = P * (U.1ᴴ * (M.1.1 * (U.1 * P)))
    calc P * (N.1.1 * P)
        = Pᴴ * N.1.1 * P := by rw [hPh, Matrix.mul_assoc]
      _ = (U.1 * P)ᴴ * M.1.1 * (U.1 * P) := hm.symm
      _ = P * (U.1ᴴ * (M.1.1 * (U.1 * P))) := by
          simp only [Matrix.conjTranspose_mul, hPh, Matrix.mul_assoc]
  funext σ
  ext1
  ext1
  simpa only [P, CQAssertion.restrictToZeroAncilla_coe, wpQAssignCompat, qAssignObsMap,
    Observable.conj_coe, Unitary.coe_star, Matrix.star_eq_conjTranspose,
    HermitianMat.conj_apply_mat, conjTranspose_conjTranspose, hPh, Matrix.mul_assoc] using hproj

/-! ### Section 2: Decoupled Forward (`4*m T`) & Zero-`T` Reverse `SymTempAndStep` Banks -/

def symStepFwdCirc {n : ℕ} (s : SymTempAndStep n) : Circuit n :=
  s.pre ;;ᶜ Circuit.andCompute s.c₁ s.c₂ s.anc s.h₁a s.h₂a ;;ᶜ s.midPre

def symStepRevDyn {Var : Type} {n : ℕ} (v : Var) (s : SymTempAndStep n) : DynamicCircuit Var n :=
  .seq (.circuit s.midPost)
    (.seq (xUnloadCzPairsSeqDyn v s.anc [⟨s.c₁, ⟨s.c₂, s.h₁₂⟩⟩] (.circuit .identity))
      (.circuit s.post))

theorem symStep_clifford_counts {n : ℕ} (s : SymTempAndStep n) :
    s.pre.count .T = 0 ∧ s.midPre.count .T = 0 ∧ s.midPost.count .T = 0 ∧ s.post.count .T = 0 ∧
    s.pre.count .TOFF = 0 ∧ s.midPre.count .TOFF = 0 ∧ s.midPost.count .TOFF = 0 ∧
      s.post.count .TOFF = 0 := by
  have ht := count_withSymBank_t_fast (Unit.unit) 1 (fun _ ↦ s) (.circuit .identity)
  have hf := count_withSymBank_toff_fast (Unit.unit) 1 (fun _ ↦ s) (.circuit .identity)
  have hand_t : (Circuit.andCompute s.c₁ s.c₂ s.anc s.h₁a s.h₂a).count .T = 4 := by
    simp [Circuit.andCompute, Circuit.count, Circuit.T, Circuit.H, Circuit.CNOT, Circuit.S,
      Circuit.inverse, Circuit.inverseGate, Circuit.sequence]
  have hand_f : (Circuit.andCompute s.c₁ s.c₂ s.anc s.h₁a s.h₂a).count .TOFF = 0 := by
    simp [Circuit.andCompute, Circuit.count, Circuit.T, Circuit.H, Circuit.CNOT, Circuit.S,
      Circuit.inverse, Circuit.inverseGate, Circuit.sequence]
  simp only [withSymBank, TempAndStep.wrapDynamic, DynamicCircuit.andCompute,
    DynamicCircuit.count, Circuit.count_identity, hand_t] at ht
  simp only [withSymBank, TempAndStep.wrapDynamic, DynamicCircuit.andCompute,
    DynamicCircuit.count, Circuit.count_identity, hand_f] at hf
  omega

theorem count_symStepFwdCirc {n : ℕ} (s : SymTempAndStep n) :
    (symStepFwdCirc s).count .T = 4 ∧ (symStepFwdCirc s).count .TOFF = 0 := by
  obtain ⟨hp_t, hmp_t, _, _, hp_f, hmp_f, _, _⟩ := symStep_clifford_counts s
  have hand_t : (Circuit.andCompute s.c₁ s.c₂ s.anc s.h₁a s.h₂a).count .T = 4 := by
    simp [Circuit.andCompute, Circuit.count, Circuit.T, Circuit.H, Circuit.CNOT, Circuit.S,
      Circuit.inverse, Circuit.inverseGate, Circuit.sequence]
  have hand_f : (Circuit.andCompute s.c₁ s.c₂ s.anc s.h₁a s.h₂a).count .TOFF = 0 := by
    simp [Circuit.andCompute, Circuit.count, Circuit.T, Circuit.H, Circuit.CNOT, Circuit.S,
      Circuit.inverse, Circuit.inverseGate, Circuit.sequence]
  simp [symStepFwdCirc, Circuit.count_seq, hp_t, hmp_t, hp_f, hmp_f, hand_t, hand_f]

theorem count_symStepRevDyn {Var : Type} {n : ℕ} (v : Var) (s : SymTempAndStep n) :
    (symStepRevDyn v s).count .T = 0 ∧ (symStepRevDyn v s).count .TOFF = 0 := by
  obtain ⟨_, _, hmo_t, hpo_t, _, _, hmo_f, hpo_f⟩ := symStep_clifford_counts s
  obtain ⟨xu_t, xu_f⟩ :=
    count_xUnloadCzPairsSeqDyn v s.anc [⟨s.c₁, ⟨s.c₂, s.h₁₂⟩⟩] (.circuit .identity)
  simp [symStepRevDyn, DynamicCircuit.count, Circuit.count_identity, hmo_t, hpo_t, hmo_f, hpo_f,
    xu_t, xu_f]

noncomputable def uSymStep {n : ℕ} (s : SymTempAndStep n) : Unitary (2 ^ n) :=
  s.midPre.eval * (Circuit.TOFF s.c₁ s.c₂ s.anc s.h₁₂ s.h₁a s.h₂a).eval * s.pre.eval

theorem uSymStep_mulVec_ket {n : ℕ} (s : SymTempAndStep n) (δ : BitAssignment n) :
    (uSymStep s).1.mulVec (ket δ) = ket (s.stepFwd δ) := by
  have hpre := s.local_pre.perm
  have htoff := ClassicalPerm.TOFF s.c₁ s.c₂ s.anc s.h₁₂ s.h₁a s.h₂a
  have hmid := s.local_midPre.perm
  rw [eq_basisKet, eq_basisKet]
  dsimp only [uSymStep]
  rw [Submonoid.coe_mul, Submonoid.coe_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
    hpre δ, htoff (s.f_pre δ), hmid _]
  rfl

theorem subspaceStep_circuit_andCompute {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)]
    (c₁ c₂ anc : Wire n) (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    (G : Operator (2 ^ n)) (hAnc0 : (QRegister.singleton anc).basisOutcomeProjector 0 * G = G) :
    SubspaceStep (Var := Var) G ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * G)
      (.circuit (Circuit.andCompute c₁ c₂ anc h₁a h₂a)) := by
  let P₀ := (QRegister.singleton anc).basisOutcomeProjector 0
  have hP₀_herm : P₀ᴴ = P₀ := QRegister.basisOutcomeProjector_conjTranspose _ 0
  have hBase : SubspaceStep (Var := Var) P₀
      ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * P₀)
      (.circuit (Circuit.andCompute c₁ c₂ anc h₁a h₂a)) := fun M ↦ by
    refine ⟨qAssignObsMap (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval M,
      wp_circuit_compile_loc _ M, ?_⟩
    have hr := DynCircuitExt.restrictAssertionToZeroAncilla_wpQAssign_andCompute
      (Var := Var) c₁ c₂ anc h₁₂ h₁a h₂a (fun _ ↦ M)
    have hm := congrArg (fun X ↦ (X (fun _ : Var ↦ (0 : ℤ))).1.mat) hr
    have hm' : P₀ * ((Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1ᴴ *
          (M.1.mat * ((Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1 * P₀))) =
        P₀ * ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1ᴴ *
          (M.1.mat * ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * P₀))) := by
      simpa only [P₀, CQAssertion.restrictToZeroAncilla_coe, wpQAssignCompat, qAssignObsMap,
        Observable.conj_coe, Unitary.coe_star, Matrix.star_eq_conjTranspose,
        HermitianMat.conj_apply_mat, conjTranspose_conjTranspose, hP₀_herm,
          Matrix.mul_assoc] using hm
    have hm'' : P₀ * ((Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1ᴴ * M.1.1 *
          (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1) * P₀ =
        P₀ * ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1ᴴ * M.1.1 *
          (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1) * P₀ := by
      change P₀ * ((Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1ᴴ * M.1.mat *
            (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1) * P₀ =
          P₀ * ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1ᴴ * M.1.mat *
            (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1) * P₀
      simpa only [Matrix.mul_assoc] using hm'
    have hq : (qAssignObsMap (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval M).1.1 =
        (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1ᴴ * M.1.1 *
          (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1 := by
      simp [qAssignObsMap, Observable.conj_coe, HermitianMat.conj_apply_mat,
        Unitary.coe_star, Matrix.star_eq_conjTranspose, Matrix.mul_assoc]
    rw [hq]
    calc ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * P₀)ᴴ * M.1.1 *
            ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * P₀)
        = P₀ * ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1ᴴ * M.1.1 *
            (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1) * P₀ := by
            rw [Matrix.conjTranspose_mul, hP₀_herm]
            simp only [Matrix.mul_assoc]
      _ = P₀ * ((Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1ᴴ * M.1.1 *
            (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1) * P₀ := hm''.symm
      _ = P₀ᴴ * ((Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1ᴴ * M.1.1 *
            (Circuit.andCompute c₁ c₂ anc h₁a h₂a).eval.1) * P₀ := by rw [hP₀_herm]
  have hMul := subspaceStep_mul_right G hBase
  simpa only [P₀, Matrix.mul_assoc, hAnc0] using hMul

theorem symStep_f_pre_anc_zero {n : ℕ} (s : SymTempAndStep n) (δ : BitAssignment n)
    (h0 : δ s.anc = 0) : s.f_pre δ s.anc = 0 := by
  have hcomm := DynCircuitExt.circuit_eval_comm_basisOutcomeProjector_of_not_mem_support
    s.pre (QRegister.singleton s.anc) 0 (fun _ ↦ s.anc_not_mem_pre)
  have hv := congrArg (fun M ↦ M.mulVec (ket δ)) hcomm
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ket_projector_zero, ite_eq_left h0] at hv
  have hpre : s.pre.eval.1.mulVec (ket δ) = ket (s.f_pre δ) := by
    rw [eq_basisKet, eq_basisKet]
    exact s.local_pre.perm δ
  rw [hpre, ket_projector_zero] at hv
  by_cases hf0 : s.f_pre δ s.anc = 0
  · exact hf0
  · rw [ite_eq_right hf0] at hv
    let g := (basisBitsEquiv n).symm (s.f_pre δ)
    have h1 := congrFun hv g
    simp [ket, basisState, g] at h1

theorem subspaceStep_symStepFwdCirc {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)] (s : SymTempAndStep n)
    (G : Operator (2 ^ n)) (hSupp : SupportedOn (fun δ ↦ δ s.anc = 0) G) :
    SubspaceStep (Var := Var) G ((uSymStep s).1 * G) (.circuit (symStepFwdCirc s)) := by
  have hAnc0 : (QRegister.singleton s.anc).basisOutcomeProjector 0 * (s.pre.eval.1 * G) =
      s.pre.eval.1 * G := by
    have hEq := hSupp ((QRegister.singleton s.anc).basisOutcomeProjector 0 * s.pre.eval.1)
      s.pre.eval.1 fun δ h0 ↦ by
        rw [← Matrix.mulVec_mulVec, eq_basisKet, s.local_pre.perm δ,
          ← eq_basisKet, ket_projector_zero, ite_eq_left (symStep_f_pre_anc_zero s δ h0)]
    simpa only [Matrix.mul_assoc] using hEq
  have s1 := subspaceStep_of_circuit (Var := Var) G s.pre
  have s2 := subspaceStep_circuit_andCompute (Var := Var) s.c₁ s.c₂ s.anc s.h₁₂ s.h₁a s.h₂a
    (s.pre.eval.1 * G) hAnc0
  have s3 := subspaceStep_of_circuit (Var := Var)
    ((Circuit.TOFF s.c₁ s.c₂ s.anc s.h₁₂ s.h₁a s.h₂a).eval.1 * (s.pre.eval.1 * G)) s.midPre
  have hSeqDyn : SubspaceStep (Var := Var) G ((uSymStep s).1 * G)
      (.seq (.circuit s.pre)
        (.seq (.circuit (Circuit.andCompute s.c₁ s.c₂ s.anc s.h₁a s.h₂a))
          (.circuit s.midPre))) := by
    refine s1.seq (s2.seq (subspaceStep_congr_out s3 ?_))
    simp only [uSymStep, Submonoid.coe_mul, Matrix.mul_assoc]
  intro M
  obtain ⟨N, hwp, hm⟩ := hSeqDyn M
  refine ⟨N, ?_, hm⟩
  funext σ
  have hσ := congrFun hwp σ
  simpa only [symStepFwdCirc, DynamicCircuit.compile_circuit, DynamicCircuit.compile_seq,
    Circuit.compile_seq, wp] using hσ

theorem subspaceStep_symStepRevDyn {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)] (v : Var) (s : SymTempAndStep n)
    (G : Operator (2 ^ n)) (hSupp : SupportedOn (fun δ ↦ δ s.anc = 0) G) :
    SubspaceStep (Var := Var) ((uSymStep s).1 * G) G (symStepRevDyn v s) := by
  let fProd : BitAssignment n → ZMod 2 := fun β ↦ β s.c₁ * β s.c₂
  have hf : ∀ β a, fProd (Function.update β s.anc a) = fProd β := fun β a ↦ by
    dsimp only [fProd]
    rw [Function.update_of_ne s.h₁a, Function.update_of_ne s.h₂a]
  have hf_eq : ∀ β, fProd β = czPairsParity [⟨s.c₁, ⟨s.c₂, s.h₁₂⟩⟩] β := fun β ↦ by
    simp [fProd, czPairsParity]
  have hMidEq : s.midPost.eval.1 * ((uSymStep s).1 * G) =
      (xorWireUnitary s.anc fProd hf).1 * (s.pre.eval.1 * G) := by
    simpa only [Matrix.mul_assoc] using
      hSupp (s.midPost.eval.1 * (uSymStep s).1) ((xorWireUnitary s.anc fProd hf).1 * s.pre.eval.1)
        fun δ h0 ↦ by
          rw [← Matrix.mulVec_mulVec, uSymStep_mulVec_ket, eq_basisKet,
            s.local_midPost.perm _, ← eq_basisKet]
          dsimp only [SymTempAndStep.stepFwd]
          rw [s.midPost_midPre_id]
          rw [← Matrix.mulVec_mulVec, eq_basisKet δ, s.local_pre.perm δ,
            ← eq_basisKet, xorWireUnitary_mulVec_ket]
  have hq0 : projBit_dqmu s.anc 0 * (s.pre.eval.1 * G) = s.pre.eval.1 * G := by
    simpa only [projBit_dqmu, Matrix.mul_assoc] using
      hSupp ((QRegister.singleton s.anc).basisOutcomeProjector 0 * s.pre.eval.1) s.pre.eval.1
        fun δ h0 ↦ by
          rw [← Matrix.mulVec_mulVec, eq_basisKet, s.local_pre.perm δ,
            ← eq_basisKet, ket_projector_zero, ite_eq_left (symStep_f_pre_anc_zero s δ h0)]
  have hPostEq : s.post.eval.1 * (s.pre.eval.1 * G) = G := by
    have h1 := hSupp (s.post.eval.1 * s.pre.eval.1) 1 fun δ _ ↦ by
      rw [← Matrix.mulVec_mulVec, Matrix.one_mulVec, eq_basisKet,
        s.local_pre.perm δ, s.local_post.perm _, s.post_pre_id δ]
    simpa only [Matrix.mul_assoc, Matrix.one_mul] using h1
  have s1 := subspaceStep_congr_out (subspaceStep_of_circuit (Var :=
    Var) ((uSymStep s).1 * G) s.midPost) hMidEq
  have sId : SubspaceStep (Var := Var) (s.pre.eval.1 * G) (s.pre.eval.1 * G) (.circuit .identity) :=
    by
    simpa only [Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mul] using
      subspaceStep_of_circuit (Var := Var) (s.pre.eval.1 * G) (.identity : Circuit n)
  have s2 := subspaceStep_xUnloadCzPairsSeqDyn v s.anc [⟨s.c₁, ⟨s.c₂, s.h₁₂⟩⟩] (.circuit .identity)
    fProd hf hf_eq (s.pre.eval.1 * G) (s.pre.eval.1 * G) hq0 sId
  have s3 := subspaceStep_congr_out (subspaceStep_of_circuit (Var :=
    Var) (s.pre.eval.1 * G) s.post) hPostEq
  exact s1.seq (s2.seq s3)

def symBankFwdCirc {n : ℕ} : (m : ℕ) → (Fin m → SymTempAndStep n) → Circuit n
  | 0, _ => .identity
  | m + 1, steps => symStepFwdCirc (steps 0) ;;ᶜ symBankFwdCirc m (fun i ↦ steps i.succ)

def symBankRevDyn {Var : Type} {n : ℕ} (v : Var) :
    (m : ℕ) → (Fin m → SymTempAndStep n) → DynamicCircuit Var n
  | 0, _ => .circuit .identity
  | m + 1, steps => .seq (symBankRevDyn v m (fun i ↦ steps i.succ)) (symStepRevDyn v (steps 0))

noncomputable def uSymBank {n : ℕ} : (m : ℕ) → (Fin m → SymTempAndStep n) → Unitary (2 ^ n)
  | 0, _ => 1
  | m + 1, steps => uSymBank m (fun i ↦ steps i.succ) * uSymStep (steps 0)

theorem count_symBankFwdCirc {n : ℕ} :
    ∀ (m : ℕ) (steps : Fin m → SymTempAndStep n),
      (symBankFwdCirc m steps).count .T = 4 * m ∧ (symBankFwdCirc m steps).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | m + 1, steps => by
      obtain ⟨t0, f0⟩ := count_symStepFwdCirc (steps 0)
      obtain ⟨tm, fm⟩ := count_symBankFwdCirc m (fun i ↦ steps i.succ)
      simp only [symBankFwdCirc, Circuit.count_seq, t0, tm, f0, fm]
      exact ⟨by omega, trivial⟩

theorem count_symBankRevDyn {Var : Type} {n : ℕ} (v : Var) :
    ∀ (m : ℕ) (steps : Fin m → SymTempAndStep n),
      (symBankRevDyn v m steps).count .T = 0 ∧ (symBankRevDyn v m steps).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | m + 1, steps => by
      obtain ⟨tm, fm⟩ := count_symBankRevDyn v m (fun i ↦ steps i.succ)
      obtain ⟨t0, f0⟩ := count_symStepRevDyn v (steps 0)
      simp [symBankRevDyn, tm, fm, t0, f0]

theorem uSymBank_mulVec_ket {n : ℕ} :
    ∀ (m : ℕ) (steps : Fin m → SymTempAndStep n) (δ : BitAssignment n),
      (uSymBank m steps).1.mulVec (ket δ) = ket (bankFwd m steps δ)
  | 0, _, δ => by simp [uSymBank, bankFwd]
  | m + 1, steps, δ => by
      dsimp only [uSymBank, bankFwd]
      rw [Submonoid.coe_mul, ← Matrix.mulVec_mulVec, uSymStep_mulVec_ket,
        uSymBank_mulVec_ket m (fun i ↦ steps i.succ)]

theorem supportedOn_uSymStep {n : ℕ} {P Q : BitAssignment n → Prop}
    (s : SymTempAndStep n) {G : Operator (2 ^ n)}
    (hSupp : SupportedOn P G) (hImp : ∀ δ, P δ → Q (s.stepFwd δ)) :
    SupportedOn Q ((uSymStep s).1 * G) := fun A B hAB ↦ by
  simpa only [Matrix.mul_assoc] using
    hSupp (A * (uSymStep s).1) (B * (uSymStep s).1) fun δ hP ↦ by
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, uSymStep_mulVec_ket]
      exact hAB _ (hImp δ hP)

theorem subspaceStep_circuit_seq {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)] {G₁ G₂ G₃ : Operator (2 ^ n)} {c₁ c₂ : Circuit n}
    (h₁ : SubspaceStep (Var := Var) G₁ G₂ (.circuit c₁))
    (h₂ : SubspaceStep (Var := Var) G₂ G₃ (.circuit c₂)) :
    SubspaceStep (Var := Var) G₁ G₃ (.circuit (c₁ ;;ᶜ c₂)) := fun M ↦ by
  obtain ⟨N, hwp, hm⟩ := (h₁.seq h₂) M
  refine ⟨N, ?_, hm⟩
  funext σ
  simpa only [DynamicCircuit.compile_circuit, DynamicCircuit.compile_seq,
    Circuit.compile_seq, wp] using congrFun hwp σ

theorem subspaceStep_symBankFwdCirc {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)] :
    ∀ (m : ℕ) (steps : Fin m → SymTempAndStep n)
      (_hOrder : ∀ i j : Fin m, i.val < j.val → (steps j).anc ∉ (steps i).S)
      (G : Operator (2 ^ n))
      (_hSupp : SupportedOn (fun δ ↦ ∀ i : Fin m, δ (steps i).anc = 0) G),
      SubspaceStep (Var := Var) G ((uSymBank m steps).1 * G) (.circuit (symBankFwdCirc m steps))
  | 0, _, _, G, _ => by
      simpa only [symBankFwdCirc, uSymBank, Circuit.eval_identity, Submonoid.coe_one,
        Matrix.one_mul] using
        subspaceStep_of_circuit (Var := Var) G (.identity : Circuit n)
  | m + 1, steps, hOrder, G, hSupp => by
      have hSupp0 : SupportedOn (fun δ ↦ δ (steps 0).anc = 0) G :=
        fun A B hAB ↦ hSupp A B fun δ hAll ↦ hAB δ (hAll 0)
      have hSuppTail : SupportedOn (fun δ ↦ ∀ i : Fin m, δ (steps i.succ).anc = 0)
          ((uSymStep (steps 0)).1 * G) :=
        supportedOn_uSymStep (steps 0) hSupp fun δ hAll i ↦ by
          rw [SymTempAndStep.stepFwd_outside (steps 0) δ (hOrder 0 i.succ (Nat.succ_pos i.val))]
          exact hAll i.succ
      have s0 := subspaceStep_symStepFwdCirc (Var := Var) (steps 0) G hSupp0
      have sm := subspaceStep_symBankFwdCirc (Var := Var) m (fun i ↦ steps i.succ)
        (fun i j hij ↦ hOrder i.succ j.succ (Nat.succ_lt_succ hij))
        ((uSymStep (steps 0)).1 * G) hSuppTail
      exact subspaceStep_congr_out (subspaceStep_circuit_seq s0 sm)
        (by simp only [uSymBank, Submonoid.coe_mul, Matrix.mul_assoc])

theorem subspaceStep_symBankRevDyn {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)] (v : Var) :
    ∀ (m : ℕ) (steps : Fin m → SymTempAndStep n)
      (_hOrder : ∀ i j : Fin m, i.val < j.val → (steps j).anc ∉ (steps i).S)
      (G : Operator (2 ^ n))
      (_hSupp : SupportedOn (fun δ ↦ ∀ i : Fin m, δ (steps i).anc = 0) G),
      SubspaceStep (Var := Var) ((uSymBank m steps).1 * G) G (symBankRevDyn v m steps)
  | 0, _, _, G, _ => by
      simpa only [symBankRevDyn, uSymBank, Circuit.eval_identity, Submonoid.coe_one,
        Matrix.one_mul] using
        subspaceStep_of_circuit (Var := Var) G (.identity : Circuit n)
  | m + 1, steps, hOrder, G, hSupp => by
      have hSupp0 : SupportedOn (fun δ ↦ δ (steps 0).anc = 0) G :=
        fun A B hAB ↦ hSupp A B fun δ hAll ↦ hAB δ (hAll 0)
      have hSuppTail : SupportedOn (fun δ ↦ ∀ i : Fin m, δ (steps i.succ).anc = 0)
          ((uSymStep (steps 0)).1 * G) :=
        supportedOn_uSymStep (steps 0) hSupp fun δ hAll i ↦ by
          rw [SymTempAndStep.stepFwd_outside (steps 0) δ (hOrder 0 i.succ (Nat.succ_pos i.val))]
          exact hAll i.succ
      have sm := subspaceStep_symBankRevDyn v m (fun i ↦ steps i.succ)
        (fun i j hij ↦ hOrder i.succ j.succ (Nat.succ_lt_succ hij))
        ((uSymStep (steps 0)).1 * G) hSuppTail
      have s0 := subspaceStep_symStepRevDyn v (steps 0) G hSupp0
      exact (subspaceStep_congr_in (by
        simp only [uSymBank, Submonoid.coe_mul,
          Matrix.mul_assoc]) sm).seq s0

/-! ### Section 3: Clean `R = 3` Optional W-State Expander (`2*3*(2^k - 1) + 2*k` `T`s, `0
  .TOFF`) -/

def cSetDum3 {n : ℕ} (k : ℕ) (w : Fin 3 → Fin (2 ^ k) → Wire n) (q0 : Wire n)
    (hne : ∀ b p, w b p ≠ q0) : Circuit n :=
  let p0 : Fin (2 ^ k) := ⟨0, Nat.two_pow_pos k⟩
  Circuit.X q0 ;;ᶜ
    Circuit.CNOT (w 0 p0) q0 (hne 0 p0) ;;ᶜ
    Circuit.CNOT (w 1 p0) q0 (hne 1 p0) ;;ᶜ
    Circuit.CNOT (w 2 p0) q0 (hne 2 p0)

theorem cSetDum3_mulVec_ket {n : ℕ} (k : ℕ) (w : Fin 3 → Fin (2 ^ k) → Wire n) (q0 : Wire n)
    (hne : ∀ b p, w b p ≠ q0) (γ : BitAssignment n) :
    (cSetDum3 k w q0 hne).eval.1.mulVec (ket γ) =
      ket (Function.update γ q0
        (γ q0 + 1 + γ (w 0 ⟨0, Nat.two_pow_pos k⟩) +
          γ (w 1 ⟨0, Nat.two_pow_pos k⟩) + γ (w 2 ⟨0, Nat.two_pow_pos k⟩))) := by
  dsimp only [cSetDum3]
  simp only [eval_seq_mulVec, ket_X, ket_CNOT, Function.update_idem, Function.update_self,
    Function.update_of_ne (hne 0 ⟨0, Nat.two_pow_pos k⟩),
    Function.update_of_ne (hne 1 ⟨0, Nat.two_pow_pos k⟩),
    Function.update_of_ne (hne 2 ⟨0, Nat.two_pow_pos k⟩)]

def cXorBlockTo {n : ℕ} (k : ℕ) (wb : Fin (2 ^ k) → Wire n) (q0 : Wire n)
    (hne : ∀ p, wb p ≠ q0) : Circuit n :=
  seqNat (2 ^ k) fun p hp ↦ Circuit.CNOT (wb ⟨p, hp⟩) q0 (hne ⟨p, hp⟩)

def cClearDum3 {n : ℕ} (k : ℕ) (w : Fin 3 → Fin (2 ^ k) → Wire n) (q0 : Wire n)
    (hne : ∀ b p, w b p ≠ q0) : Circuit n :=
  Circuit.X q0 ;;ᶜ
    cXorBlockTo k (w 0) q0 (hne 0) ;;ᶜ
    cXorBlockTo k (w 1) q0 (hne 1) ;;ᶜ
    cXorBlockTo k (w 2) q0 (hne 2)

/-- Clean 3-block optional W-state expander (`2*3*(2^k - 1) + 2*k` `T`s, `0 .TOFF`),
requiring `q0, q1, q2 = 0` on entry and returning `q0, q1, q2 = 0` on exit. -/
def dOptExpand3Clean {Var : Type} {n : ℕ} (v : Var) (k : ℕ)
    (uLo : Fin k → Wire n) (w : Fin 3 → Fin (2 ^ k) → Wire n)
    (q0 q1 q2 : Wire n) (hInj : WOptInj 3 k uLo w q0 q1 q2) : DynamicCircuit Var n :=
  .seq (.circuit (cSetDum3 k w q0 hInj.w_ne_rDum))
    (.seq (wOptExpandDyn v 3 k uLo w q0 q1 q2 hInj)
      (.circuit (cClearDum3 k w q0 hInj.w_ne_rDum)))

theorem count_dOptExpand3Clean {Var : Type} {n : ℕ} (v : Var) (k : ℕ)
    (uLo : Fin k → Wire n) (w : Fin 3 → Fin (2 ^ k) → Wire n)
    (q0 q1 q2 : Wire n) (hInj : WOptInj 3 k uLo w q0 q1 q2) :
    (dOptExpand3Clean v k uLo w q0 q1 q2 hInj).count .T = 2 * 3 * (2 ^ k - 1) + 2 * k ∧
    (dOptExpand3Clean v k uLo w q0 q1 q2 hInj).count .TOFF = 0 := by
  have hs_t : (cSetDum3 k w q0 hInj.w_ne_rDum).count .T = 0 := by
    simp [cSetDum3, Circuit.count_seq, Circuit.X, Circuit.CNOT, Circuit.count]
  have hs_f : (cSetDum3 k w q0 hInj.w_ne_rDum).count .TOFF = 0 := by
    simp [cSetDum3, Circuit.count_seq, Circuit.X, Circuit.CNOT, Circuit.count]
  have hxb_t : ∀ b : Fin 3, (cXorBlockTo k (w b) q0 (hInj.w_ne_rDum b)).count .T = 0 := fun b ↦ by
    simpa [cXorBlockTo] using
      count_seqNat_T 0 (2 ^ k) _ (fun _ _ ↦ by simp [Circuit.count])
  have hxb_f : ∀ b : Fin 3, (cXorBlockTo k (w b) q0 (hInj.w_ne_rDum b)).count .TOFF = 0 := fun b ↦
    count_seqNat_TOFF_zero (2 ^ k) _ (fun _ _ ↦ by simp [Circuit.count])
  have hc_t : (cClearDum3 k w q0 hInj.w_ne_rDum).count .T = 0 := by
    simp [cClearDum3, Circuit.count_seq, hxb_t 0, hxb_t 1, hxb_t 2, Circuit.X, Circuit.count]
  have hc_f : (cClearDum3 k w q0 hInj.w_ne_rDum).count .TOFF = 0 := by
    simp [cClearDum3, Circuit.count_seq, hxb_f 0, hxb_f 1, hxb_f 2, Circuit.X, Circuit.count]
  obtain ⟨te, fe⟩ := count_wOptExpandDyn v 3 k uLo w q0 q1 q2 hInj
  simp [dOptExpand3Clean, DynamicCircuit.count, hs_t, hs_f, hc_t, hc_f, te, fe]

theorem cXorBlockTo_mulVec_zero {n : ℕ} (k : ℕ) (wb : Fin (2 ^ k) → Wire n) (q0 : Wire n)
    (hne : ∀ p, wb p ≠ q0) (δ : BitAssignment n) (hz : ∀ p, δ (wb p) = 0) :
    (cXorBlockTo k wb q0 hne).eval.1.mulVec (ket δ) = ket δ :=
  seqNat_mulVec_fixed (ket δ) (2 ^ k) _ fun p hp ↦
    ket_CNOT_ctrl_zero _ (hz ⟨p, hp⟩)

theorem cXorBlockTo_mulVec_one {n : ℕ} (k : ℕ) (wb : Fin (2 ^ k) → Wire n)
    (_hwb : Function.Injective wb) (q0 : Wire n)
    (hne : ∀ p, wb p ≠ q0) (pStar : Fin (2 ^ k)) (δ : BitAssignment n)
    (hp1 : δ (wb pStar) = 1) (hp0 : ∀ p, p ≠ pStar → δ (wb p) = 0) :
    (cXorBlockTo k wb q0 hne).eval.1.mulVec (ket δ) =
      ket (Function.update δ q0 (δ q0 + 1)) := by
  have hSeq := seqNat_mulVec_single (ket δ) (ket (Function.update δ q0 (δ q0 + 1)))
    pStar.val (2 ^ k) (fun p hp ↦ Circuit.CNOT (wb ⟨p, hp⟩) q0 (hne ⟨p, hp⟩))
    (fun p hp hlt ↦ ket_CNOT_ctrl_zero _ (hp0 ⟨p, hp⟩ (Fin.ne_of_val_ne (Nat.ne_of_lt hlt))))
    (fun hp' ↦ by
      have hpEq : (⟨pStar.val, hp'⟩ : Fin (2 ^ k)) = pStar := Fin.ext rfl
      rw [ket_CNOT, hpEq, hp1])
    (fun p hp hgt ↦ ket_CNOT_ctrl_zero _ (by
      rw [Function.update_of_ne (hne ⟨p, hp⟩)]
      exact hp0 ⟨p, hp⟩ (Fin.ne_of_val_ne (Nat.ne_of_gt hgt))))
  rw [ite_eq_left pStar.isLt] at hSeq
  exact hSeq

theorem cClearDum3_mulVec_active {n : ℕ} (k : ℕ) (w : Fin 3 → Fin (2 ^ k) → Wire n)
    (hw : WInj w) (q0 : Wire n) (hne : ∀ b p, w b p ≠ q0)
    (bStar : Fin 3) (pStar : Fin (2 ^ k)) (δ : BitAssignment n)
    (hq0 : δ q0 = 0) (hw0 : ∀ b p, δ (w b p) = 0) :
    (cClearDum3 k w q0 hne).eval.1.mulVec (ket (Function.update δ (w bStar pStar) 1)) =
      ket (Function.update δ (w bStar pStar) 1) := by
  let δX := Function.update (Function.update δ (w bStar pStar) 1) q0 1
  have hX : (Circuit.X q0).eval.1.mulVec (ket (Function.update δ (w bStar pStar) 1)) = ket δX := by
    rw [ket_X, Function.update_of_ne (hne bStar pStar).symm, hq0, zero_add]
  have hwInjB : ∀ b : Fin 3, Function.Injective (w b) :=
    fun b p1 p2 hp ↦ (hw b p1 b p2 hp).2
  have hw_other : ∀ b : Fin 3, b ≠ bStar → ∀ p, δX (w b p) = 0 := fun b hb p ↦ by
    dsimp only [δX]
    rw [Function.update_of_ne (hne b p),
      Function.update_of_ne (fun e ↦ hb (hw b p bStar pStar e).1), hw0 b p]
  have hw_same_1 : ∀ γ : BitAssignment n,
      (∀ p, γ (w bStar p) = Function.update δ (w bStar pStar) 1 (w bStar p)) →
      γ (w bStar pStar) = 1 ∧ (∀ p, p ≠ pStar → γ (w bStar p) = 0) := fun γ hγ ↦ by
    refine ⟨(hγ pStar).trans (Function.update_self _ 1 δ), fun p hp ↦ ?_⟩
    rw [hγ p, Function.update_of_ne (fun e ↦ hp (hwInjB bStar e)), hw0 bStar p]
  have hδX_same : ∀ p, δX (w bStar p) = Function.update δ (w bStar pStar) 1 (w bStar p) :=
    fun p ↦ Function.update_of_ne (hne bStar p) 1 _
  have hFinal : Function.update δX q0 (δX q0 + 1) = Function.update δ (w bStar pStar) 1 := by
    dsimp only [δX]
    rw [Function.update_self, CharTwo.add_self_eq_zero, Function.update_idem]
    exact update_eq_self_of_zero ((Function.update_of_ne (hne bStar pStar).symm 1 δ).trans hq0)
  dsimp only [cClearDum3]
  simp only [eval_seq_mulVec]
  rw [hX]
  have hbCases : bStar = 0 ∨ bStar = 1 ∨ bStar = 2 := by fin_cases bStar <;> decide
  rcases hbCases with rfl | rfl | rfl
  · obtain ⟨h1, h0⟩ := hw_same_1 δX hδX_same
    rw [cXorBlockTo_mulVec_one k (w 0) (hwInjB 0) q0 (hne 0) pStar δX h1 h0, hFinal,
      cXorBlockTo_mulVec_zero k (w 1) q0 (hne 1) _ (fun p ↦ by
        rw [Function.update_of_ne (fun e ↦ absurd (hw 1 p 0 pStar e).1 (by decide)), hw0 1 p]),
      cXorBlockTo_mulVec_zero k (w 2) q0 (hne 2) _ (fun p ↦ by
        rw [Function.update_of_ne (fun e ↦ absurd (hw 2 p 0 pStar e).1 (by decide)), hw0 2 p])]
  · obtain ⟨h1, h0⟩ := hw_same_1 δX hδX_same
    rw [cXorBlockTo_mulVec_zero k (w 0) q0 (hne 0) δX (hw_other 0 (by decide)),
      cXorBlockTo_mulVec_one k (w 1) (hwInjB 1) q0 (hne 1) pStar δX h1 h0, hFinal,
      cXorBlockTo_mulVec_zero k (w 2) q0 (hne 2) _ (fun p ↦ by
        rw [Function.update_of_ne (fun e ↦ absurd (hw 2 p 1 pStar e).1 (by decide)), hw0 2 p])]
  · obtain ⟨h1, h0⟩ := hw_same_1 δX hδX_same
    rw [cXorBlockTo_mulVec_zero k (w 0) q0 (hne 0) δX (hw_other 0 (by decide)),
      cXorBlockTo_mulVec_zero k (w 1) q0 (hne 1) δX (hw_other 1 (by decide)),
      cXorBlockTo_mulVec_one k (w 2) (hwInjB 2) q0 (hne 2) pStar δX h1 h0, hFinal]

theorem subspaceStep_dOptExpand3Clean {Var : Type} [Fintype Var] [DecidableEq Var]
    {n k : ℕ} (v : Var)
    (P activePred : BitAssignment n → Prop) [DecidablePred P] [DecidablePred activePred]
    (bStarFn : BitAssignment n → Fin 3)
    (uLo : Fin k → Wire n) (w : Fin 3 → Fin (2 ^ k) → Wire n)
    (q0 q1 q2 : Wire n) (hInj : WOptInj 3 k uLo w q0 q1 q2)
    (hQ0Zero : ∀ δ, P δ → δ q0 = 0) :
    SubspaceStep (Var := Var)
      (oneHotOptPreOp (OptBasePred P q1 q2) activePred bStarFn uLo w 0 (Nat.zero_le k))
      (oneHotOptPreOp (OptBasePred P q1 q2) activePred bStarFn uLo w k le_rfl)
      (dOptExpand3Clean v k uLo w q0 q1 q2 hInj) := by
  let act_mid : BitAssignment n → Prop := fun δ ↦ activePred (Function.update δ q0 0)
  have : DecidablePred act_mid := fun δ ↦
    inferInstanceAs (Decidable (activePred (Function.update δ q0 0)))
  let P_mid : BitAssignment n → Prop := fun δ ↦
    P (Function.update δ q0 0) ∧ δ q0 = (if act_mid δ then 0 else 1)
  have : DecidablePred P_mid := fun δ ↦
    inferInstanceAs (Decidable (P (Function.update δ q0 0) ∧ δ q0 = (if act_mid δ then 0 else 1)))
  let bStar_mid : BitAssignment n → Fin 3 := fun δ ↦ bStarFn (Function.update δ q0 0)
  have hDumMid : ∀ δ, P_mid δ → δ q0 = (if act_mid δ then 0 else 1) := fun _ h ↦ h.2
  let opToggleIn : Operator (2 ^ n) :=
    mkVecOp fun δ ↦
      if OptBasePred P q1 q2 δ ∧ ∀ b p, δ (w b p) = 0 then
        ket (Function.update δ q0 (if activePred δ then 0 else 1))
      else 0
  let p0 : Fin (2 ^ k) := ⟨0, Nat.two_pow_pos k⟩
  have hp0Eq : ∀ f, (⟨idxValPrefix uLo f 0 (Nat.zero_le k),
      Nat.lt_of_lt_of_le (idxValPrefix_lt_two_pow uLo f 0 (Nat.zero_le k))
        (Nat.pow_le_pow_right (by omega) (Nat.zero_le k))⟩ : Fin (2 ^ k)) = p0 :=
    fun _ ↦ Fin.ext rfl
  have hSetEq : (cSetDum3 k w q0 hInj.w_ne_rDum).eval.1 *
      oneHotOptPreOp (OptBasePred P q1 q2) activePred bStarFn uLo w 0 (Nat.zero_le k) =
      oneHotOptPreOp (OptBasePred P_mid q1 q2) act_mid bStar_mid uLo w 0 (Nat.zero_le k) *
        opToggleIn := by
    apply matrix_ext_ket; intro δ
    simp only [← Matrix.mulVec_mulVec, opToggleIn, oneHotOptPreOp, mkVecOp_mulVec_ket,
      oneHotOptPreVec]
    by_cases hV : OptBasePred P q1 q2 δ ∧ ∀ b p, δ (w b p) = 0
    · have ⟨⟨hP, hq1, hq2⟩, hw0⟩ := hV
      have hq0 := hQ0Zero δ hP
      have hδ0 : Function.update δ q0 0 = δ := hq0 ▸ Function.update_eq_self q0 δ
      simp only [ite_eq_left hV]
      by_cases hAct : activePred δ
      · simp only [ite_eq_left hAct]
        rw [hδ0, mkVecOp_mulVec_ket]
        have hMidV : OptBasePred P_mid q1 q2 δ ∧ ∀ b p, δ (w b p) = 0 :=
          ⟨⟨⟨by rw [hδ0]; exact hP, by
            rw [ite_eq_left (show act_mid δ by
              dsimp [act_mid]; rw [hδ0]; exact hAct)]; exact hq0⟩, hq1, hq2⟩, hw0⟩
        have hActM : act_mid δ := by dsimp [act_mid]; rw [hδ0]; exact hAct
        have hbM : bStar_mid δ = bStarFn δ := by dsimp [bStar_mid]; rw [hδ0]
        rw [ite_eq_left hMidV, ite_eq_left hActM, hbM, hp0Eq]
        have hActiveSet : ∀ (bS : Fin 3),
            let γ := Function.update δ (w bS p0) 1
            (cSetDum3 k w q0 hInj.w_ne_rDum).eval.1.mulVec (ket γ) = ket γ := fun bS ↦ by
          intro γ
          rw [cSetDum3_mulVec_ket]
          have h01 : w 0 p0 ≠ w 1 p0 := fun e ↦ absurd (hInj.w_inj 0 p0 1 p0 e).1 (by decide)
          have h02 : w 0 p0 ≠ w 2 p0 := fun e ↦ absurd (hInj.w_inj 0 p0 2 p0 e).1 (by decide)
          have h12 : w 1 p0 ≠ w 2 p0 := fun e ↦ absurd (hInj.w_inj 1 p0 2 p0 e).1 (by decide)
          have hsum : γ (w 0 p0) + γ (w 1 p0) + γ (w 2 p0) = 1 := by
            dsimp only [γ]
            fin_cases bS
            · simp [Function.update_self, Function.update_of_ne h01.symm,
              Function.update_of_ne h02.symm, hw0]
            · simp [Function.update_self, Function.update_of_ne h01, Function.update_of_ne h12.symm,
              hw0]
            · simp [Function.update_self, Function.update_of_ne h02, Function.update_of_ne h12, hw0]
          have hval0 : γ q0 + 1 + γ (w 0 p0) + γ (w 1 p0) + γ (w 2 p0) = γ q0 := by
            have hassoc : γ q0 + 1 + γ (w 0 p0) + γ (w 1 p0) + γ (w 2 p0) =
                γ q0 + (1 + (γ (w 0 p0) + γ (w 1 p0) + γ (w 2 p0))) := by ring
            rw [hassoc, hsum, CharTwo.add_self_eq_zero, add_zero]
          change ket (Function.update γ q0 (γ q0 + 1 + γ (w 0 p0) + γ (w 1 p0) + γ (w 2 p0))) =
            ket γ
          rw [hval0, Function.update_eq_self]
        exact hActiveSet (bStarFn δ)
      · simp only [ite_eq_right hAct]
        rw [mkVecOp_mulVec_ket]
        let δ₁ := Function.update δ q0 1
        have hδ₁0 : Function.update δ₁ q0 0 = δ := by
          dsimp [δ₁]; rw [Function.update_idem]; exact hδ0
        have hNotActM : ¬ act_mid δ₁ := by dsimp [act_mid]; rw [hδ₁0]; exact hAct
        have hMidV : OptBasePred P_mid q1 q2 δ₁ ∧ ∀ b p, δ₁ (w b p) = 0 := by
          refine ⟨⟨⟨by rw [hδ₁0]; exact hP, ?_⟩, ?_, ?_⟩, fun b p ↦ ?_⟩
          · rw [ite_eq_right hNotActM]; exact Function.update_self q0 1 δ
          · exact (Function.update_of_ne hInj.rDum_ne_wDum.symm 1 δ).trans hq1
          · exact (Function.update_of_ne hInj.rDum_ne_qEnc.symm 1 δ).trans hq2
          · exact (Function.update_of_ne (hInj.w_ne_rDum b p) 1 δ).trans (hw0 b p)
        rw [ite_eq_left hMidV, ite_eq_right hNotActM, cSetDum3_mulVec_ket,
          hq0, hw0 0, hw0 1, hw0 2]
        simp only [zero_add, add_zero]
    · simp only [ite_eq_right hV, Matrix.mulVec_zero]
  have hClearEq : (cClearDum3 k w q0 hInj.w_ne_rDum).eval.1 *
      (oneHotOptPreOp (OptBasePred P_mid q1 q2) act_mid bStar_mid uLo w k le_rfl * opToggleIn) =
      oneHotOptPreOp (OptBasePred P q1 q2) activePred bStarFn uLo w k le_rfl := by
    apply matrix_ext_ket; intro δ
    simp only [← Matrix.mulVec_mulVec, opToggleIn, oneHotOptPreOp, mkVecOp_mulVec_ket,
      oneHotOptPreVec]
    by_cases hV : OptBasePred P q1 q2 δ ∧ ∀ b p, δ (w b p) = 0
    · have ⟨⟨hP, hq1, hq2⟩, hw0⟩ := hV
      have hq0 := hQ0Zero δ hP
      have hδ0 : Function.update δ q0 0 = δ := hq0 ▸ Function.update_eq_self q0 δ
      simp only [ite_eq_left hV]
      by_cases hAct : activePred δ
      · rw [ite_eq_left hAct, hδ0, mkVecOp_mulVec_ket]
        have hActM : act_mid δ := by dsimp [act_mid]; rw [hδ0]; exact hAct
        have hMidV : OptBasePred P_mid q1 q2 δ ∧ ∀ b p, δ (w b p) = 0 :=
          ⟨⟨⟨by rw [hδ0]; exact hP, by rw [ite_eq_left hActM]; exact hq0⟩, hq1, hq2⟩, hw0⟩
        have hbM : bStar_mid δ = bStarFn δ := by dsimp [bStar_mid]; rw [hδ0]
        rw [ite_eq_left hMidV, ite_eq_left hAct, ite_eq_left hActM, hbM]
        exact cClearDum3_mulVec_active k w hInj.w_inj q0 hInj.w_ne_rDum (bStarFn δ) _ δ hq0 hw0
      · rw [ite_eq_right hAct, mkVecOp_mulVec_ket]
        let δ₁ := Function.update δ q0 1
        have hδ₁0 : Function.update δ₁ q0 0 = δ := by
          dsimp [δ₁]; rw [Function.update_idem]; exact hδ0
        have hNotActM : ¬ act_mid δ₁ := by dsimp [act_mid]; rw [hδ₁0]; exact hAct
        have hMidV : OptBasePred P_mid q1 q2 δ₁ ∧ ∀ b p, δ₁ (w b p) = 0 := by
          refine ⟨⟨⟨by rw [hδ₁0]; exact hP, ?_⟩, ?_, ?_⟩, fun b p ↦ ?_⟩
          · rw [ite_eq_right hNotActM]; exact Function.update_self q0 1 δ
          · exact (Function.update_of_ne hInj.rDum_ne_wDum.symm 1 δ).trans hq1
          · exact (Function.update_of_ne hInj.rDum_ne_qEnc.symm 1 δ).trans hq2
          · exact (Function.update_of_ne (hInj.w_ne_rDum b p) 1 δ).trans (hw0 b p)
        rw [ite_eq_left hMidV, ite_eq_right hAct, ite_eq_right hNotActM]
        dsimp only [cClearDum3]
        simp only [eval_seq_mulVec]
        have hX₁ : (Circuit.X q0).eval.1.mulVec (ket δ₁) = ket δ := by
          dsimp only [δ₁]
          rw [ket_X, Function.update_idem, Function.update_self, CharTwo.add_self_eq_zero, hδ0]
        rw [hX₁,
          cXorBlockTo_mulVec_zero k (w 0) q0 (hInj.w_ne_rDum 0) δ (hw0 0),
          cXorBlockTo_mulVec_zero k (w 1) q0 (hInj.w_ne_rDum 1) δ (hw0 1),
          cXorBlockTo_mulVec_zero k (w 2) q0 (hInj.w_ne_rDum 2) δ (hw0 2)]
    · simp only [ite_eq_right hV, Matrix.mulVec_zero]
  have s1 := subspaceStep_congr_out
    (subspaceStep_of_circuit (Var := Var)
      (oneHotOptPreOp (OptBasePred P q1 q2) activePred bStarFn uLo w 0 (Nat.zero_le k))
      (cSetDum3 k w q0 hInj.w_ne_rDum)) hSetEq
  have s2 := subspaceStep_mul_right opToggleIn
    (subspaceStep_wOptExpandDyn v P_mid act_mid bStar_mid uLo w q0 q1 q2 hInj hDumMid)
  have s3 := subspaceStep_congr_out
    (subspaceStep_of_circuit (Var := Var)
      (oneHotOptPreOp (OptBasePred P_mid q1 q2) act_mid bStar_mid uLo w k le_rfl * opToggleIn)
      (cClearDum3 k w q0 hInj.w_ne_rDum)) hClearEq
  exact s1.seq (s2.seq s3)

/-! ### Section 4: `withSharedBank114WState` (`266 T`) & `withSharedBank109WState` (`290 T`) -/

theorem ne_u32 : (0 : Fin 108) ≠ 32 := by decide
theorem ne_u64 : (0 : Fin 108) ≠ 64 := by decide
theorem ne_u96 : (32 : Fin 108) ≠ 96 := by decide
theorem ne_u100 : (96 : Fin 108) ≠ 100 := by decide
theorem ne_u104 : (96 : Fin 108) ≠ 104 := by decide
theorem ltAux (b : Fin 3) (p : Fin (2 ^ 5)) : 32 * b.val + p.val < 108 := by
  have := b.isLt; have := p.isLt; omega
theorem ltAlt (b : Fin 3) (p : Fin (2 ^ 2)) : 96 + 4 * b.val + p.val < 108 := by
  have := b.isLt; have := p.isLt; omega
theorem ltExt (d : Fin 5) : 1 + d.val < 8 := by have := d.isLt; omega
theorem ltSub (d : Fin 2) : 1 + d.val < 8 := by have := d.isLt; omega
theorem auxItemAlt {mTail : ℕ} (hm : 3 ≤ mTail) : 0 < mTail := by omega
theorem auxItemSub {mTail : ℕ} (hm : 3 ≤ mTail) : 1 < mTail := by omega
theorem auxItemExt {mTail : ℕ} (hm : 3 ≤ mTail) : 2 < mTail := by omega

def preSplits5 {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) : Fin 5 → SymTempAndStep n
  | ⟨0, _⟩ => splitSymStep (rCore (rNucIdx hm (QRegExt.idReg _) 6)) (rU108 0) (rU108 32)
      (hCU.ne _ 0) (hCU.ne _ 32) (rU108.wires.injective.ne ne_u32)
  | ⟨1, _⟩ => splitSymStep (rCore (rNucIdx hm (QRegExt.idReg _) 7)) (rU108 0) (rU108 64)
      (hCU.ne _ 0) (hCU.ne _ 64) (rU108.wires.injective.ne ne_u64)
  | ⟨2, _⟩ => splitSymStep (rCore (rNucIdx hm (QRegExt.idReg _) 7)) (rU108 32) (rU108 96)
      (hCU.ne _ 32) (hCU.ne _ 96) (rU108.wires.injective.ne ne_u96)
  | ⟨3, _⟩ => splitSymStep (rCore (rNucIdx hm (QRegExt.idReg _) 3)) (rU108 96) (rU108 100)
      (hCU.ne _ 96) (hCU.ne _ 100) (rU108.wires.injective.ne ne_u100)
  | ⟨_ + 4, _⟩ => splitSymStep (rCore (rNucIdx hm (QRegExt.idReg _) 4)) (rU108 96) (rU108 104)
      (hCU.ne _ 96) (hCU.ne _ 104) (rU108.wires.injective.ne ne_u104)

def wBlock5 {n : ℕ} (rU108 : QRegister 108 n) (b : Fin 3) (p : Fin (2 ^ 5)) : Wire n :=
  rU108 ⟨32 * b.val + p.val, ltAux b p⟩

def wBlock2 {n : ℕ} (rU108 : QRegister 108 n) (b : Fin 3) (p : Fin (2 ^ 2)) : Wire n :=
  rU108 ⟨96 + 4 * b.val + p.val, ltAlt b p⟩

def uLoNuc5 {mp n : ℕ} (hm : 22 ≤
    mp) (rCore : QRegister (fullSysCoreWires mp) n) (d : Fin 5) : Wire n :=
  rCore (rNucIdx hm (QRegExt.idReg _) ⟨1 + d.val, ltExt d⟩)

def uLoNuc2 {mp n : ℕ} (hm : 22 ≤
    mp) (rCore : QRegister (fullSysCoreWires mp) n) (d : Fin 2) : Wire n :=
  rCore (rNucIdx hm (QRegExt.idReg _) ⟨1 + d.val, ltSub d⟩)

theorem inj5 {n : ℕ} (rU108 : QRegister 108 n) : WInj (wBlock5 rU108) := by
  intro b1 p1 b2 p2 heq
  have hv := congrArg Fin.val (rU108.wires.injective heq)
  dsimp [wBlock5] at hv
  have := p1.isLt; have := p2.isLt
  exact ⟨Fin.ext (by omega), Fin.ext (by omega)⟩

theorem inj2 {n : ℕ} (rU108 : QRegister 108 n) : WInj (wBlock2 rU108) := by
  intro b1 p1 b2 p2 heq
  have hv := congrArg Fin.val (rU108.wires.injective heq)
  dsimp [wBlock2] at hv
  have := p1.isLt; have := p2.isLt
  exact ⟨Fin.ext (by omega), Fin.ext (by omega)⟩

theorem auxItemAux {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) :
    ∀ d b p, uLoNuc5 hm rCore d ≠ wBlock5 rU108 b p :=
  fun _ _ _ ↦ hCU.ne _ _

theorem auxItem {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) :
    ∀ d b p, uLoNuc2 hm rCore d ≠ wBlock2 rU108 b p :=
  fun _ _ _ ↦ hCU.ne _ _

theorem optInj5 {mp mTail n : ℕ} (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (rTail : QRegister mTail n)
    (hCU : rCore.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail) :
    WOptInj 3 5 (uLoNuc5 hm rCore) (wBlock5 rU108)
      (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2,
        auxItemExt hmTail⟩) where
  w_inj := inj5 rU108
  uLo_ne_w := auxItemAux hm rCore rU108 hCU
  uLo_ne_rDum _ := hCTail.ne _ _
  uLo_ne_wDum _ := hCTail.ne _ _
  uLo_ne_qEnc _ := hCTail.ne _ _
  w_ne_rDum _ _ := hUTail.ne _ _
  w_ne_wDum _ _ := hUTail.ne _ _
  w_ne_qEnc _ _ := hUTail.ne _ _
  rDum_ne_wDum := rTail.wires.injective.ne (by
    intro h;
    have hv :=
      congrArg Fin.val h; dsimp at hv; omega)
  rDum_ne_qEnc := rTail.wires.injective.ne (by
    intro h;
    have hv :=
      congrArg Fin.val h; dsimp at hv; omega)
  wDum_ne_qEnc := rTail.wires.injective.ne (by
    intro h;
    have hv :=
      congrArg Fin.val h; dsimp at hv; omega)

theorem optInj2 {mp mTail n : ℕ} (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (rTail : QRegister mTail n)
    (hCU : rCore.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail) :
    WOptInj 3 2 (uLoNuc2 hm rCore) (wBlock2 rU108)
      (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2,
        auxItemExt hmTail⟩) where
  w_inj := inj2 rU108
  uLo_ne_w := auxItem hm rCore rU108 hCU
  uLo_ne_rDum _ := hCTail.ne _ _
  uLo_ne_wDum _ := hCTail.ne _ _
  uLo_ne_qEnc _ := hCTail.ne _ _
  w_ne_rDum _ _ := hUTail.ne _ _
  w_ne_wDum _ _ := hUTail.ne _ _
  w_ne_qEnc _ _ := hUTail.ne _ _
  rDum_ne_wDum := rTail.wires.injective.ne (by
    intro h;
    have hv :=
      congrArg Fin.val h; dsimp at hv; omega)
  rDum_ne_qEnc := rTail.wires.injective.ne (by
    intro h;
    have hv :=
      congrArg Fin.val h; dsimp at hv; omega)
  wDum_ne_qEnc := rTail.wires.injective.ne (by
    intro h;
    have hv :=
      congrArg Fin.val h; dsimp at hv; omega)

noncomputable def dLoadShared114Fwd {Var : Type} {mp mTail n : ℕ}
    (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rS7 : QRegister 7 n) (rU108 : QRegister 108 n) (rTail : QRegister mTail n)
    (hCS7 : rCore.DisjointWires rS7) (hCU : rCore.DisjointWires rU108)
    (hSU : rS7.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail) : DynamicCircuit Var n :=
  .seq
    (.circuit (symBankFwdCirc 7 (vepFlagSteps hm rCore rS7 hCS7) ;;ᶜ
      cSeedEnLt216 rS7 rU108 hSU ;;ᶜ
      symBankFwdCirc 5 (preSplits5 hm rCore rU108 hCU)))
    (.seq
      (dOptExpand3Clean v 5 (uLoNuc5 hm rCore) (wBlock5 rU108)
        (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2, auxItemExt hmTail⟩)
        (optInj5 hm hmTail rCore rU108 rTail hCU hCTail hUTail))
      (dOptExpand3Clean v 2 (uLoNuc2 hm rCore) (wBlock2 rU108)
        (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2, auxItemExt hmTail⟩)
        (optInj2 hm hmTail rCore rU108 rTail hCU hCTail hUTail)))

noncomputable def dLoadShared114Rev {Var : Type} {mp n : ℕ}
    (hm : 22 ≤ mp) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rS7 : QRegister 7 n) (rU108 : QRegister 108 n)
    (hCS7 : rCore.DisjointWires rS7) (hCU : rCore.DisjointWires rU108)
    (hSU : rS7.DisjointWires rU108) : DynamicCircuit Var n :=
  .seq
    (wUncompTreeDyn v 3 2 (uLoNuc2 hm rCore) (wBlock2 rU108)
      (inj2 rU108) (auxItem hm rCore rU108 hCU) (.circuit .identity) 2 le_rfl)
    (.seq
      (wUncompTreeDyn v 3 5 (uLoNuc5 hm rCore) (wBlock5 rU108)
        (inj5 rU108) (auxItemAux hm rCore rU108 hCU) (.circuit .identity) 5 le_rfl)
      (.seq (symBankRevDyn v 5 (preSplits5 hm rCore rU108 hCU))
        (.seq (.circuit (cSeedEnLt216Inv rS7 rU108 hSU))
          (symBankRevDyn v 7 (vepFlagSteps hm rCore rS7 hCS7)))))

/-- W-state shared-bank 108 loader (`mS = 7`, `3 ≤ mTail`, `266 + dInner.count .T`). -/
noncomputable def withSharedBank114WState {Var : Type} {mp mTail n : ℕ}
    (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rS7 : QRegister 7 n) (rU108 : QRegister 108 n) (rTail : QRegister mTail n)
    (hCS7 : rCore.DisjointWires rS7) (hCU : rCore.DisjointWires rU108)
    (hSU : rS7.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail)
    (dInner : DynamicCircuit Var n) : DynamicCircuit Var n :=
  .seq (dLoadShared114Fwd hm hmTail v rCore rS7 rU108 rTail hCS7 hCU hSU hCTail hUTail)
    (.seq dInner (dLoadShared114Rev hm v rCore rS7 rU108 hCS7 hCU hSU))

theorem count_dLoadShared114Fwd {Var : Type} {mp mTail n : ℕ}
    (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rS7 : QRegister 7 n) (rU108 : QRegister 108 n) (rTail : QRegister mTail n)
    (hCS7 : rCore.DisjointWires rS7) (hCU : rCore.DisjointWires rU108)
    (hSU : rS7.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail) :
    (dLoadShared114Fwd hm hmTail v rCore rS7 rU108 rTail hCS7 hCU hSU hCTail hUTail).count .T =
      266 ∧
    (dLoadShared114Fwd hm hmTail v rCore rS7 rU108 rTail hCS7 hCU hSU hCTail hUTail).count .TOFF =
      0 := by
  obtain ⟨t7, f7⟩ := count_symBankFwdCirc 7 (vepFlagSteps hm rCore rS7 hCS7)
  obtain ⟨t5, f5⟩ := count_symBankFwdCirc 5 (preSplits5 hm rCore rU108 hCU)
  have hsd_t : (cSeedEnLt216 rS7 rU108 hSU).count .T = 0 := by
    simp [cSeedEnLt216, Circuit.count_seq, Circuit.CNOT, Circuit.count]
  have hsd_f : (cSeedEnLt216 rS7 rU108 hSU).count .TOFF = 0 := by
    simp [cSeedEnLt216, Circuit.count_seq, Circuit.CNOT, Circuit.count]
  obtain ⟨te5, fe5⟩ := count_dOptExpand3Clean v 5 (uLoNuc5 hm rCore) (wBlock5 rU108)
    (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2, auxItemExt hmTail⟩)
    (optInj5 hm hmTail rCore rU108 rTail hCU hCTail hUTail)
  obtain ⟨te2, fe2⟩ := count_dOptExpand3Clean v 2 (uLoNuc2 hm rCore) (wBlock2 rU108)
    (rTail ⟨0, auxItemAlt hmTail⟩) (rTail ⟨1, auxItemSub hmTail⟩) (rTail ⟨2, auxItemExt hmTail⟩)
    (optInj2 hm hmTail rCore rU108 rTail hCU hCTail hUTail)
  simp only [dLoadShared114Fwd, DynamicCircuit.count, Circuit.count_seq,
    t7, f7, t5, f5, hsd_t, hsd_f, te5, fe5, te2, fe2]
  exact ⟨by decide, trivial⟩

theorem count_dLoadShared114Rev {Var : Type} {mp n : ℕ}
    (hm : 22 ≤ mp) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rS7 : QRegister 7 n) (rU108 : QRegister 108 n)
    (hCS7 : rCore.DisjointWires rS7) (hCU : rCore.DisjointWires rU108)
    (hSU : rS7.DisjointWires rU108) :
    (dLoadShared114Rev hm v rCore rS7 rU108 hCS7 hCU hSU).count .T = 0 ∧
    (dLoadShared114Rev hm v rCore rS7 rU108 hCS7 hCU hSU).count .TOFF = 0 := by
  obtain ⟨ut2, uf2⟩ := count_wUncompTreeDyn_opt v 3 2 (uLoNuc2 hm rCore) (wBlock2 rU108)
    (inj2 rU108) (auxItem hm rCore rU108 hCU) (.circuit .identity) 2 le_rfl
  obtain ⟨ut5, uf5⟩ := count_wUncompTreeDyn_opt v 3 5 (uLoNuc5 hm rCore) (wBlock5 rU108)
    (inj5 rU108) (auxItemAux hm rCore rU108 hCU) (.circuit .identity) 5 le_rfl
  obtain ⟨rt5, rf5⟩ := count_symBankRevDyn v 5 (preSplits5 hm rCore rU108 hCU)
  obtain ⟨rt7, rf7⟩ := count_symBankRevDyn v 7 (vepFlagSteps hm rCore rS7 hCS7)
  have hsi_t : (cSeedEnLt216Inv rS7 rU108 hSU).count .T = 0 := by
    simp [cSeedEnLt216Inv, Circuit.count_seq, Circuit.CNOT, Circuit.count]
  have hsi_f : (cSeedEnLt216Inv rS7 rU108 hSU).count .TOFF = 0 := by
    simp [cSeedEnLt216Inv, Circuit.count_seq, Circuit.CNOT, Circuit.count]
  simp [dLoadShared114Rev, DynamicCircuit.count, Circuit.count_identity,
    ut2, uf2, ut5, uf5, rt5, rf5, rt7, rf7, hsi_t, hsi_f]

@[simp]
theorem count_withSharedBank114WState_toff {Var : Type} {mp mTail n : ℕ}
    (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rS7 : QRegister 7 n) (rU108 : QRegister 108 n) (rTail : QRegister mTail n)
    (hCS7 : rCore.DisjointWires rS7) (hCU : rCore.DisjointWires rU108)
    (hSU : rS7.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail)
    (dInner : DynamicCircuit Var n) :
    (withSharedBank114WState hm hmTail v rCore rS7 rU108 rTail hCS7 hCU hSU hCTail hUTail
      dInner).count .TOFF =
      dInner.count .TOFF := by
  obtain ⟨_, ff⟩ :=
    count_dLoadShared114Fwd hm hmTail v rCore rS7 rU108 rTail hCS7 hCU hSU hCTail hUTail
  obtain ⟨_, fr⟩ := count_dLoadShared114Rev hm v rCore rS7 rU108 hCS7 hCU hSU
  simp [withSharedBank114WState, DynamicCircuit.count, ff, fr]

@[simp]
theorem count_withSharedBank114WState_t {Var : Type} {mp mTail n : ℕ}
    (hm : 22 ≤ mp) (hmTail : 3 ≤ mTail) (v : Var)
    (rCore : QRegister (fullSysCoreWires mp) n)
    (rS7 : QRegister 7 n) (rU108 : QRegister 108 n) (rTail : QRegister mTail n)
    (hCS7 : rCore.DisjointWires rS7) (hCU : rCore.DisjointWires rU108)
    (hSU : rS7.DisjointWires rU108) (hCTail : rCore.DisjointWires rTail)
    (hUTail : rU108.DisjointWires rTail)
    (dInner : DynamicCircuit Var n) :
    (withSharedBank114WState hm hmTail v rCore rS7 rU108 rTail hCS7 hCU hSU hCTail hUTail
      dInner).count .T =
      266 + dInner.count .T := by
  obtain ⟨tf, _⟩ :=
    count_dLoadShared114Fwd hm hmTail v rCore rS7 rU108 rTail hCS7 hCU hSU hCTail hUTail
  obtain ⟨tr, _⟩ := count_dLoadShared114Rev hm v rCore rS7 rU108 hCS7 hCU hSU
  simp [withSharedBank114WState, DynamicCircuit.count, tf, tr]

theorem c1Aux : 1 ≤ 1 := le_rfl
theorem b1Aux : 1 + 1 ≤ 108 := by decide
theorem c2Aux : 2 ≤ 2 := le_rfl
theorem b2Aux : 2 + 2 ≤ 108 := by decide
theorem c4Aux : 4 ≤ 4 := le_rfl
theorem b4Aux : 4 + 4 ≤ 108 := by decide
theorem c8Aux : 8 ≤ 8 := le_rfl
theorem b8Aux : 8 + 8 ≤ 108 := by decide
theorem c16Aux : 16 ≤ 16 := le_rfl
theorem b16Aux : 16 + 16 ≤ 108 := by decide
theorem c32 : 32 ≤ 32 := le_rfl
theorem b32Aux : 32 + 32 ≤ 108 := by decide
theorem c44 : 44 ≤ 64 := by decide
theorem b44 : 64 + 44 ≤ 108 := by decide

noncomputable def uUnaryBank108 {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) : Unitary (2 ^ n) :=
  let hcU : ∀ (b : Fin 8) (k : Fin 108), rCore (rNucIdx hm (QRegExt.idReg _) b) ≠ rU108 k :=
    fun _ k ↦ hCU.ne _ k
  uSymBank 44 (splitU108Steps 64 44 c44 b44 (rCore (rNucIdx hm (QRegExt.idReg _) 7)) rU108 (hcU 7))
    *
    (uSymBank 32 (splitU108Steps 32 32 c32 b32Aux (rCore (rNucIdx hm (QRegExt.idReg _) 6)) rU108
      (hcU 6)) *
      (uSymBank 16 (splitU108Steps 16 16 c16Aux b16Aux (rCore (rNucIdx hm (QRegExt.idReg _) 5))
        rU108 (hcU 5)) *
        (uSymBank 8 (splitU108Steps 8 8 c8Aux b8Aux (rCore (rNucIdx hm (QRegExt.idReg _) 4)) rU108
          (hcU 4)) *
          (uSymBank 4 (splitU108Steps 4 4 c4Aux b4Aux (rCore (rNucIdx hm (QRegExt.idReg _) 3)) rU108
            (hcU 3)) *
            (uSymBank 2 (splitU108Steps 2 2 c2Aux b2Aux (rCore (rNucIdx hm (QRegExt.idReg _) 2))
              rU108 (hcU 2)) *
              uSymBank 1 (splitU108Steps 1 1 c1Aux b1Aux (rCore (rNucIdx hm (QRegExt.idReg _) 1))
                rU108 (hcU 1)))))))

theorem uUnaryBank108_mulVec_ket {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) (γ : BitAssignment n) :
    (uUnaryBank108 hm rCore rU108 hCU).1.mulVec (ket γ) =
      ket (unaryBank108Fwd hm rCore rU108 hCU γ) := by
  dsimp only [uUnaryBank108, unaryBank108Fwd]
  simp only [Submonoid.coe_mul, ← Matrix.mulVec_mulVec, uSymBank_mulVec_ket]

theorem conj_unitaryPerm_phasePerm {n : ℕ} [NeZero (2 ^ n)]
    {U_load U_inner : Unitary (2 ^ n)}
    {gLoad fInner : BitAssignment n → BitAssignment n}
    {φInner : BitAssignment n → ℂ} {M_set : Finset (Wire n)}
    (hLoad : ∀ β, U_load.1.mulVec (ket β) = ket (gLoad β))
    (hPerm : UnitaryPhasePerm U_inner φInner fInner)
    (hOut : ∀ γ w, w ∉ M_set → fInner γ w = γ w)
    (hPresM : ∀ γ w, w ∈ M_set → gLoad γ w = γ w)
    (hIndepM : ∀ γ₁ γ₂, (∀ w, w ∉ M_set → γ₁ w = γ₂ w) → ∀ w, w ∉ M_set → gLoad γ₁ w = gLoad γ₂ w) :
    let U_sh : Unitary (2 ^ n) := star U_load * U_inner * U_load
    let φ_sh : BitAssignment n → ℂ := fun β ↦ φInner (gLoad β)
    let f_sh : BitAssignment n → BitAssignment n :=
      fun β w ↦ if w ∈ M_set then fInner (gLoad β) w else β w
    UnitaryPhasePerm U_sh φ_sh f_sh ∧ (∀ β w, w ∉ M_set → f_sh β w = β w) := by
  intro U_sh φ_sh f_sh
  have hInv : ∀ β, (star U_load).1.mulVec (ket (gLoad β)) = ket β := fun β ↦ by
    rw [← hLoad β, Matrix.mulVec_mulVec, Unitary.coe_star,
      (Unitary.mem_iff.mp U_load.2).1, Matrix.one_mulVec]
  refine ⟨fun β ↦ ?_, fun β w hw ↦ by simp [f_sh, hw]⟩
  have hComm : gLoad (f_sh β) = fInner (gLoad β) := by
    funext w
    by_cases hw : w ∈ M_set
    · simp only [f_sh, hw, ↓reduceIte, hPresM (f_sh β) w hw]
    · rw [hIndepM (f_sh β) β (fun u hu ↦ by simp [f_sh, hu]) w hw, (hOut (gLoad β) w hw).symm]
  rw [← eq_basisKet, ← eq_basisKet]
  dsimp only [U_sh]
  rw [Submonoid.coe_mul, Submonoid.coe_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
    hLoad β, eq_basisKet, hPerm (gLoad β), ← eq_basisKet,
    ← hComm, Matrix.mulVec_smul, hInv (f_sh β)]

theorem symStep_pres_and_indep {n : ℕ} (s : SymTempAndStep n) {M_set : Finset (Wire n)}
    (hSM : Disjoint s.S M_set) :
    (∀ γ w, w ∈ M_set → s.stepFwd γ w = γ w) ∧
    (∀ γ₁ γ₂, (∀ w, w ∉ M_set → γ₁ w = γ₂ w) →
      ∀ w, w ∉ M_set → s.stepFwd γ₁ w = s.stepFwd γ₂ w) := by
  let f_t : BitAssignment n → BitAssignment n :=
    fun δ ↦ Function.update δ s.anc (δ s.anc + δ s.c₁ * δ s.c₂)
  have hStepEq : ∀ δ, s.stepFwd δ = s.f_midPre (f_t (s.f_pre δ)) := fun _ ↦ rfl
  refine ⟨fun γ w hwM ↦ ?_, fun γ₁ γ₂ hEq w hwM ↦ ?_⟩
  · have hwS : w ∉ s.S := Finset.disjoint_right.mp hSM hwM
    have hwAnc : w ≠ s.anc := fun h ↦ hwS (h ▸ s.anc_mem)
    rw [hStepEq, s.local_midPre.preserves_outside _ w hwS]
    dsimp only [f_t]
    rw [Function.update_of_ne hwAnc, s.local_pre.preserves_outside _ w hwS]
  · have hPreEq : ∀ u, u ∉ M_set → s.f_pre γ₁ u = s.f_pre γ₂ u := fun u huM ↦ by
      by_cases huS : u ∈ s.S
      · exact s.local_pre.depends_on γ₁ γ₂
          (fun v hv ↦ hEq v (Finset.disjoint_left.mp hSM hv)) u huS
      · exact (s.local_pre.preserves_outside γ₁ u huS).trans
          ((hEq u huM).trans (s.local_pre.preserves_outside γ₂ u huS).symm)
    have hToffEq : ∀ u, u ∉ M_set → f_t (s.f_pre γ₁) u = f_t (s.f_pre γ₂) u := fun u huM ↦ by
      dsimp only [f_t]
      by_cases hua : u = s.anc
      · subst hua
        simp only [Function.update_self,
          hPreEq s.anc (Finset.disjoint_left.mp hSM s.anc_mem),
          hPreEq s.c₁ (Finset.disjoint_left.mp hSM s.c₁_mem),
          hPreEq s.c₂ (Finset.disjoint_left.mp hSM s.c₂_mem)]
      · simp only [Function.update_of_ne hua, hPreEq u huM]
    rw [hStepEq, hStepEq]
    by_cases hwS : w ∈ s.S
    · exact s.local_midPre.depends_on _ _
        (fun v hv ↦ hToffEq v (Finset.disjoint_left.mp hSM hv)) w hwS
    · exact (s.local_midPre.preserves_outside _ w hwS).trans
        ((hToffEq w hwM).trans (s.local_midPre.preserves_outside _ w hwS).symm)

theorem bankFwd_pres_and_indep {n : ℕ} {M_set : Finset (Wire n)} :
    ∀ (m : ℕ) (steps : Fin m → SymTempAndStep n),
      (∀ i : Fin m, Disjoint (steps i).S M_set) →
      (∀ γ w, w ∈ M_set → bankFwd m steps γ w = γ w) ∧
      (∀ γ₁ γ₂, (∀ w, w ∉ M_set → γ₁ w = γ₂ w) →
        ∀ w, w ∉ M_set → bankFwd m steps γ₁ w = bankFwd m steps γ₂ w)
  | 0, _, _ => ⟨fun _ _ _ ↦ rfl, fun _ _ hEq w hw ↦ hEq w hw⟩
  | m + 1, steps, hDisj => by
    obtain ⟨hPres0, hIndep0⟩ := symStep_pres_and_indep (steps 0) (hDisj 0)
    obtain ⟨hPresT, hIndepT⟩ := bankFwd_pres_and_indep m (fun i ↦ steps i.succ) (fun i ↦
      hDisj i.succ)
    exact ⟨fun γ w hw ↦ (hPresT _ w hw).trans (hPres0 γ w hw),
      fun γ₁ γ₂ hEq w hw ↦ hIndepT _ _ (hIndep0 γ₁ γ₂ hEq) w hw⟩

theorem splitU108Steps_disjoint_M {n : ℕ} (offset count : ℕ)
    (hCnt : count ≤ offset) (hBound : offset + count ≤ 108)
    (ctrl : Wire n) (rU108 : QRegister 108 n) (hcU : ∀ k : Fin 108, ctrl ≠ rU108 k)
    {M_set : Finset (Wire n)} (hcM : ctrl ∉ M_set) (hUM : Disjoint rU108.image M_set)
    (i : Fin count) :
    Disjoint (splitU108Steps offset count hCnt hBound ctrl rU108 hcU i).S M_set := by
  rw [Finset.disjoint_left]
  intro w hwS hwM
  simp only [splitU108Steps, splitBankSteps, splitSymStep, Finset.mem_insert,
    Finset.mem_singleton] at hwS
  rcases hwS with rfl | rfl | rfl
  · exact hcM hwM
  · exact Finset.disjoint_left.mp hUM (rU108.image_compose_subset _ ((QRegister.mem_image _ _).mpr
    ⟨i, rfl⟩)) hwM
  · exact Finset.disjoint_left.mp hUM (rU108.image_compose_subset _ ((QRegister.mem_image _ _).mpr
    ⟨i, rfl⟩)) hwM

theorem unaryBank108Fwd_pres_and_indep {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108)
    {M_set : Finset (Wire n)} (hCM : Disjoint rCore.image M_set) (hUM : Disjoint rU108.image M_set)
      :
    (∀ γ w, w ∈ M_set → unaryBank108Fwd hm rCore rU108 hCU γ w = γ w) ∧
    (∀ γ₁ γ₂, (∀ w, w ∉ M_set → γ₁ w = γ₂ w) →
      ∀ w,
        w ∉ M_set → unaryBank108Fwd hm rCore rU108 hCU γ₁ w =
        unaryBank108Fwd hm rCore rU108 hCU γ₂ w) := by
  have hcM : ∀ b : Fin 8, rCore (rNucIdx hm (QRegExt.idReg _) b) ∉ M_set :=
    fun b hm_in ↦ Finset.disjoint_left.mp hCM ((QRegister.mem_image rCore _).mpr ⟨_, rfl⟩) hm_in
  have hP : ∀ (off cnt : ℕ) (h1 : cnt ≤ off) (h2 : off + cnt ≤ 108) (b : Fin 8)
      (hc : ∀ k : Fin 108, rCore (rNucIdx hm (QRegExt.idReg _) b) ≠ rU108 k)
      (γ : BitAssignment n) (w : Wire n), w ∈ M_set →
      bankFwd cnt (splitU108Steps off cnt h1 h2 (rCore (rNucIdx hm (QRegExt.idReg _) b)) rU108 hc) γ
        w = γ w :=
    fun off cnt h1 h2 b hc γ w hw ↦
      (bankFwd_pres_and_indep cnt _ (splitU108Steps_disjoint_M off cnt h1 h2 _ rU108 hc (hcM b)
        hUM)).1 γ w hw
  have hI : ∀ (off cnt : ℕ) (h1 : cnt ≤ off) (h2 : off + cnt ≤ 108) (b : Fin 8)
      (hc : ∀ k : Fin 108, rCore (rNucIdx hm (QRegExt.idReg _) b) ≠ rU108 k)
      (γ₁ γ₂ : BitAssignment n), (∀ w, w ∉ M_set → γ₁ w = γ₂ w) →
      ∀ w, w ∉ M_set →
      bankFwd cnt (splitU108Steps off cnt h1 h2 (rCore (rNucIdx hm (QRegExt.idReg _) b)) rU108 hc)
        γ₁ w =
        bankFwd cnt (splitU108Steps off cnt h1 h2 (rCore (rNucIdx hm (QRegExt.idReg _) b)) rU108 hc)
          γ₂ w :=
    fun off cnt h1 h2 b hc γ₁ γ₂ hEq w hw ↦
      (bankFwd_pres_and_indep cnt _ (splitU108Steps_disjoint_M off cnt h1 h2 _ rU108 hc (hcM b)
        hUM)).2 γ₁ γ₂ hEq w hw
  refine ⟨fun γ w hw ↦ ?_, fun γ₁ γ₂ hEq w hw ↦ ?_⟩
  · unfold unaryBank108Fwd
    rw [hP 64 44 _ _ 7 _ _ w hw, hP 32 32 _ _ 6 _ _ w hw, hP 16 16 _ _ 5 _ _ w hw,
      hP 8 8 _ _ 4 _ _ w hw, hP 4 4 _ _ 3 _ _ w hw, hP 2 2 _ _ 2 _ _ w hw, hP 1 1 _ _ 1 _ _ w hw]
  · unfold unaryBank108Fwd
    exact hI 64 44 _ _ 7 _ _ _ (hI 32 32 _ _ 6 _ _ _ (hI 16 16 _ _ 5 _ _ _
      (hI 8 8 _ _ 4 _ _ _ (hI 4 4 _ _ 3 _ _ _ (hI 2 2 _ _ 2 _ _ _ (hI 1 1 _ _ 1 _ _ _ hEq)))))) w hw

theorem exists_unaryBank108_phasePerm {mp n : ℕ} [NeZero (2 ^ n)] (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108)
    {M_set : Finset (Wire n)} (hCM : Disjoint rCore.image M_set) (hUM : Disjoint rU108.image M_set)
    {U_inner : Unitary (2 ^ n)} {φInner : BitAssignment n → ℂ} {fInner : BitAssignment n →
      BitAssignment n}
    (hPerm : UnitaryPhasePerm U_inner φInner fInner)
    (hOut : ∀ β w, w ∉ M_set → fInner β w = β w) :
    ∃ U_108 : Unitary (2 ^ n),
      UnitaryPhasePerm U_108 (fun γ ↦ φInner (unaryBank108Fwd hm rCore rU108 hCU γ))
        (fun γ w ↦ if w ∈ M_set then fInner (unaryBank108Fwd hm rCore rU108 hCU γ) w else γ w) := by
  obtain ⟨hPres, hIndep⟩ := unaryBank108Fwd_pres_and_indep hm rCore rU108 hCU hCM hUM
  exact ⟨_, (conj_unitaryPerm_phasePerm (uUnaryBank108_mulVec_ket hm rCore rU108 hCU)
    hPerm hOut hPres hIndep).1⟩

theorem preSplits5_order {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) :
    ∀ i j : Fin 5, i.val < j.val →
      (preSplits5 hm rCore rU108 hCU j).anc ∉ (preSplits5 hm rCore rU108 hCU i).S := by
  intro i j hij hmem
  fin_cases i <;> fin_cases j <;> dsimp only at hij <;> (try omega) <;>
    simp only [preSplits5, splitSymStep, Finset.mem_insert, Finset.mem_singleton] at hmem <;>
    rcases hmem with h | h | h <;>
    first
    | exact hCU.ne _ _ h.symm
    | exact absurd (rU108.wires.injective h) (by decide)

theorem vepFlagSteps_order {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rS7 : QRegister 7 n)
    (hCS7 : rCore.DisjointWires rS7) :
    ∀ i j : Fin 7, i.val < j.val →
      (vepFlagSteps hm rCore rS7 hCS7 j).anc ∉ (vepFlagSteps hm rCore rS7 hCS7 i).S := by
  intro i j hij hmem
  fin_cases i <;> fin_cases j <;> dsimp only at hij <;> (try omega) <;>
    simp only [vepFlagSteps, genBoolSymStep, Finset.mem_insert, Finset.mem_singleton] at hmem <;>
    rcases hmem with h | h | h <;>
    first
    | exact hCS7.ne _ _ h.symm
    | exact absurd (rS7.wires.injective h) (by decide)

def act5Pred {mp n : ℕ} (hm : 22 ≤ mp) (rCore : QRegister (fullSysCoreWires mp) n)
    (δ : BitAssignment n) : Prop :=
  coin0Active (fun q ↦ δ (rCore q)) = true ∧
    regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2 < 96

instance instDecidableAct5Pred {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) : DecidablePred (act5Pred hm rCore) :=
  fun _ ↦ by unfold act5Pred; infer_instance

def bStar5Fn {mp n : ℕ} (hm : 22 ≤ mp) (rCore : QRegister (fullSysCoreWires mp) n)
    (δ : BitAssignment n) : Fin 3 :=
  let q := regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2
  if h : q / 32 < 3 then ⟨q / 32, h⟩ else 0

def act2Pred {mp n : ℕ} (hm : 22 ≤ mp) (rCore : QRegister (fullSysCoreWires mp) n)
    (δ : BitAssignment n) : Prop :=
  coin0Active (fun q ↦ δ (rCore q)) = true ∧
    96 ≤ regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2 ∧
    regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2 < 108

instance instDecidableAct2Pred {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) : DecidablePred (act2Pred hm rCore) :=
  fun _ ↦ by unfold act2Pred; infer_instance

def bStar2Fn {mp n : ℕ} (hm : 22 ≤ mp) (rCore : QRegister (fullSysCoreWires mp) n)
    (δ : BitAssignment n) : Fin 3 :=
  let q := regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2
  if h : (q - 96) / 4 < 3 then ⟨(q - 96) / 4, h⟩ else 0

theorem bStar5Fn_eq_of_div {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (δ : BitAssignment n) (b : Fin 3)
    (h : regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2 / 32 = b.val) :
    bStar5Fn hm rCore δ = b := by
  dsimp only [bStar5Fn]
  rw [dite_eq_left (h.symm ▸ b.isLt)]
  exact Fin.ext h

theorem bStar2Fn_eq_of_div {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (δ : BitAssignment n) (b : Fin 3)
    (h : (regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2 - 96) / 4 = b.val) :
    bStar2Fn hm rCore δ = b := by
  dsimp only [bStar2Fn]
  rw [dite_eq_left (h.symm ▸ b.isLt)]
  exact Fin.ext h

theorem idx_decompAux {mp : ℕ} (hm : 22 ≤ mp)
    (γc : BitAssignment (fullSysCoreWires mp)) :
    regVal (rNucIdx hm (QRegExt.idReg _)) γc =
      (γc (rNucIdx hm (QRegExt.idReg _) 0)).val +
      2 * ((γc (rNucIdx hm (QRegExt.idReg _) 1)).val * 1 +
           (γc (rNucIdx hm (QRegExt.idReg _) 2)).val * 2 +
           (γc (rNucIdx hm (QRegExt.idReg _) 3)).val * 4 +
           (γc (rNucIdx hm (QRegExt.idReg _) 4)).val * 8 +
           (γc (rNucIdx hm (QRegExt.idReg _) 5)).val * 16 +
           (γc (rNucIdx hm (QRegExt.idReg _) 6)).val * 32 +
           (γc (rNucIdx hm (QRegExt.idReg _) 7)).val * 64) ∧
    (∀ i : Fin 8, (γc (rNucIdx hm (QRegExt.idReg _) i)).val ≤ 1) := by
  obtain ⟨hd, hle⟩ := regVal_rNucIdx_div2_decomp hm γc
  exact ⟨hd, hle⟩

theorem idxValPrefix_uLoNuc5_eq {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (δ : BitAssignment n) :
    idxValPrefix (uLoNuc5 hm rCore) δ 5 le_rfl =
      (regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2) % 32 := by
  let γc : BitAssignment (fullSysCoreWires mp) := fun q ↦ δ (rCore q)
  obtain ⟨hd, hle⟩ := idx_decompAux hm γc
  have hb0 := hle 0; have hb1 := hle 1; have hb2 := hle 2; have hb3 := hle 3
  have hb4 := hle 4; have hb5 := hle 5; have hb6 := hle 6; have hb7 := hle 7
  have hi : ∀ (d : Fin 5) (m : ℕ), (if δ (uLoNuc5 hm rCore d) = 1 then m else 0) =
      (γc (rNucIdx hm (QRegExt.idReg _) ⟨1 + d.val, ltExt d⟩)).val * m := fun d m ↦ by
    dsimp only [uLoNuc5, γc]
    rcases bit_cases (δ (rCore (rNucIdx hm (QRegExt.idReg _) ⟨1 + d.val, ltExt d⟩))) with
      hbit | hbit <;>
      simp [hbit]
  have h0 :=
    hi ⟨0, by decide⟩ (2 ^ 0); change _ = (γc (rNucIdx hm (QRegExt.idReg _) 1)).val * 1 at h0
  have h1 :=
    hi ⟨1, by decide⟩ (2 ^ 1); change _ = (γc (rNucIdx hm (QRegExt.idReg _) 2)).val * 2 at h1
  have h2 :=
    hi ⟨2, by decide⟩ (2 ^ 2); change _ = (γc (rNucIdx hm (QRegExt.idReg _) 3)).val * 4 at h2
  have h3 :=
    hi ⟨3, by decide⟩ (2 ^ 3); change _ = (γc (rNucIdx hm (QRegExt.idReg _) 4)).val * 8 at h3
  have h4 :=
    hi ⟨4, by decide⟩ (2 ^ 4); change _ = (γc (rNucIdx hm (QRegExt.idReg _) 5)).val * 16 at h4
  dsimp only [idxValPrefix]
  rw [h0, h1, h2, h3, h4]
  change 0 + (γc (rNucIdx hm (QRegExt.idReg _) 1)).val * 1 +
      (γc (rNucIdx hm (QRegExt.idReg _) 2)).val * 2 +
      (γc (rNucIdx hm (QRegExt.idReg _) 3)).val * 4 +
      (γc (rNucIdx hm (QRegExt.idReg _) 4)).val * 8 +
      (γc (rNucIdx hm (QRegExt.idReg _) 5)).val * 16 =
      regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 % 32
  omega

theorem idxValPrefix_uLoNuc2_eq {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (δ : BitAssignment n)
    (hge96 : 96 ≤ regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2) :
    idxValPrefix (uLoNuc2 hm rCore) δ 2 le_rfl =
      (regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ δ (rCore q)) / 2 - 96) % 4 := by
  let γc : BitAssignment (fullSysCoreWires mp) := fun q ↦ δ (rCore q)
  obtain ⟨hd, hle⟩ := idx_decompAux hm γc
  have hb0 := hle 0; have hb1 := hle 1; have hb2 := hle 2; have hb3 := hle 3
  have hb4 := hle 4; have hb5 := hle 5; have hb6 := hle 6; have hb7 := hle 7
  have hi : ∀ (d : Fin 2) (m : ℕ), (if δ (uLoNuc2 hm rCore d) = 1 then m else 0) =
      (γc (rNucIdx hm (QRegExt.idReg _) ⟨1 + d.val, ltSub d⟩)).val * m := fun d m ↦ by
    dsimp only [uLoNuc2, γc]
    rcases bit_cases (δ (rCore (rNucIdx hm (QRegExt.idReg _) ⟨1 + d.val, ltSub d⟩))) with
      hbit | hbit <;>
      simp [hbit]
  have h0 :=
    hi ⟨0, by decide⟩ (2 ^ 0); change _ = (γc (rNucIdx hm (QRegExt.idReg _) 1)).val * 1 at h0
  have h1 :=
    hi ⟨1, by decide⟩ (2 ^ 1); change _ = (γc (rNucIdx hm (QRegExt.idReg _) 2)).val * 2 at h1
  have hge96' : 96 ≤ regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 := hge96
  dsimp only [idxValPrefix]
  rw [h0, h1]
  change 0 + (γc (rNucIdx hm (QRegExt.idReg _) 1)).val * 1 +
      (γc (rNucIdx hm (QRegExt.idReg _) 2)).val * 2 =
      (regVal (rNucIdx hm (QRegExt.idReg _)) γc / 2 - 96) % 4
  omega

theorem bankFwd_preSplits5_eval {mp n : ℕ} (hm : 22 ≤ mp)
    (rCore : QRegister (fullSysCoreWires mp) n) (rU108 : QRegister 108 n)
    (hCU : rCore.DisjointWires rU108) (γ : BitAssignment n)
    (hSeed0 : γ (rU108 0) =
      if decide (coin0Active (fun q ↦ γ (rCore q)) = true ∧
          regVal (rNucIdx hm (QRegExt.idReg _)) (fun q ↦ γ (rCore q)) < 216) = true
      then 1 else 0)
    (hSeedPos : ∀ k : Fin 108, k ≠ 0 → γ (rU108 k) = 0) :
    let γ_pre := bankFwd 5 (preSplits5 hm rCore rU108 hCU) γ
    (∀ w, w ∉ rU108.image → γ_pre w = γ w) ∧
    (∀ b : Fin 3, ∀ p : Fin (2 ^ 5),
      γ_pre (wBlock5 rU108 b p) =
        if act5Pred hm rCore γ ∧ b = bStar5Fn hm rCore γ ∧ p.val = 0 then 1 else 0) ∧
    (∀ b : Fin 3, ∀ p : Fin (2 ^ 2),
      γ_pre (wBlock2 rU108 b p) =
        if act2Pred hm rCore γ ∧ b = bStar2Fn hm rCore γ ∧ p.val = 0 then 1 else 0) := by
  intro γ_pre
  let γc : BitAssignment (fullSysCoreWires mp) := fun q ↦ γ (rCore q)
  let en : Bool := decide (coin0Active γc = true ∧ regVal (rNucIdx hm (QRegExt.idReg _)) γc < 216)
  obtain ⟨hd, hle⟩ := idx_decompAux hm γc
  have hb0 := hle 0; have hb1 := hle 1; have hb2 := hle 2; have hb3 := hle 3
  have hb4 := hle 4; have hb5 := hle 5; have hb6 := hle 6; have hb7 := hle 7
  let c : Fin 8 → Wire n := fun j ↦ rCore (rNucIdx hm (QRegExt.idReg _) j)
  have hcNotU : ∀ (j : Fin 8) {u : Wire n}, u ∈ rU108.image → c j ≠ u := fun j u hu h ↦ by
    obtain ⟨k, rfl⟩ := (QRegister.mem_image rU108 u).mp hu
    exact hCU.ne _ k h
  have hU_mem : ∀ k : Fin 108, rU108 k ∈ rU108.image := fun k ↦
    (QRegister.mem_image rU108 _).mpr ⟨k, rfl⟩
  let γ₀ := (preSplits5 hm rCore rU108 hCU 0).stepFwd γ
  let γ₁ := (preSplits5 hm rCore rU108 hCU 1).stepFwd γ₀
  let γ₂ := (preSplits5 hm rCore rU108 hCU 2).stepFwd γ₁
  let γ₃ := (preSplits5 hm rCore rU108 hCU 3).stepFwd γ₂
  let γ₄ := (preSplits5 hm rCore rU108 hCU 4).stepFwd γ₃
  have hEq4 : γ_pre = γ₄ := rfl
  have hs0 : γ₀ = Function.update (Function.update γ (rU108 32) (γ (c 6) * γ (rU108 0)))
      (rU108 0) (γ (rU108 0) + γ (c 6) * γ (rU108 0)) :=
    splitSymStep_stepFwd _ _ _ _ _ _ γ (hSeedPos 32 (by decide))
  have hz64 : γ₀ (rU108 64) = 0 := by
    rw [hs0, Function.update_of_ne (rU108.wires.injective.ne (by decide)),
      Function.update_of_ne (rU108.wires.injective.ne (by decide)), hSeedPos 64 (by decide)]
  have hs1 : γ₁ = Function.update (Function.update γ₀ (rU108 64) (γ₀ (c 7) * γ₀ (rU108 0)))
      (rU108 0) (γ₀ (rU108 0) + γ₀ (c 7) * γ₀ (rU108 0)) :=
    splitSymStep_stepFwd _ _ _ _ _ _ γ₀ hz64
  have hz96 : γ₁ (rU108 96) = 0 := by
    rw [hs1, hs0]
    repeat rw [Function.update_of_ne (rU108.wires.injective.ne (by decide))]
    exact hSeedPos 96 (by decide)
  have hs2 : γ₂ = Function.update (Function.update γ₁ (rU108 96) (γ₁ (c 7) * γ₁ (rU108 32)))
      (rU108 32) (γ₁ (rU108 32) + γ₁ (c 7) * γ₁ (rU108 32)) :=
    splitSymStep_stepFwd _ _ _ _ _ _ γ₁ hz96
  have hz100 : γ₂ (rU108 100) = 0 := by
    rw [hs2, hs1, hs0]
    repeat rw [Function.update_of_ne (rU108.wires.injective.ne (by decide))]
    exact hSeedPos 100 (by decide)
  have hs3 : γ₃ = Function.update (Function.update γ₂ (rU108 100) (γ₂ (c 3) * γ₂ (rU108 96)))
      (rU108 96) (γ₂ (rU108 96) + γ₂ (c 3) * γ₂ (rU108 96)) :=
    splitSymStep_stepFwd _ _ _ _ _ _ γ₂ hz100
  have hz104 : γ₃ (rU108 104) = 0 := by
