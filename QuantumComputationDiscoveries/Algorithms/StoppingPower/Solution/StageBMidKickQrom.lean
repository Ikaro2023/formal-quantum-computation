    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) :
    (dComp17 hm20 v rCore rScr hCS).count PrimitiveGate.TOFF = 0 := by
  simp [dComp17, dComp17Inner, mk34_ctxToDyn_count_toff,
    cLeafComp17On_count_toff]
