  Circuit.T top ;;ᶜ
  Circuit.CNOT wEn top he ;;ᶜ
  Circuit.CNOT wMask top hm ;;ᶜ
  (Circuit.T top).inverse ;;ᶜ
  Circuit.CNOT wMask top hm ;;ᶜ
  Circuit.CNOT wEn top he ;;ᶜ
  Circuit.CNOT wTh top hth
