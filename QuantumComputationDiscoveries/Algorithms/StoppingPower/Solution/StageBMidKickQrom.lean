        hm20 rScr) _ _ (fun ⟨i, hi⟩ ↦ (rHold3_disjoint_rSub hm20 rScr).ne i j
        hi)).trans (hz j)
    rw [ite_eq_left hz, hk, ket_projZeroAll, ite_eq_left hz']
  · rw [ite_eq_right hz, Matrix.mulVec_zero, Matrix.mulVec_zero]
