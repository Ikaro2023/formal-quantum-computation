  have hEq : U.1 * conjProj W P = (conjUnit W U).1 * conjProj W P := by
    change U.1 * (W.1 * P * W.1ᴴ) = (W.1 * U.1 * W.1ᴴ) * (W.1 * P * W.1ᴴ)
    calc U.1 * (W.1 * P * W.1ᴴ)
        = (U.1 * (W.1 * P)) * W.1ᴴ := by simp only [Matrix.mul_assoc]
      _ = (W.1 * (U.1 * P)) * W.1ᴴ := by rw [hComm]
      _ = W.1 * U.1 * (W.1ᴴ * W.1) * P * W.1ᴴ := by
            rw [unitary_coe_star_mul_self W, Matrix.mul_one]; simp only [Matrix.mul_assoc]
      _ = (W.1 * U.1 * W.1ᴴ) * (W.1 * P * W.1ᴴ) := by simp only [Matrix.mul_assoc]
  exact RealizesCleanUnitary.congr_unitary (conjProj_herm W hP) hMono hEq
