  have h3 := ScopedBlock.withLitAndXor1_block (M := mBAux B)
    (96 + 2 * B + 3) (by dsimp [mBAux]; omega)
    ⟨36, by dsimp [mBAux]; omega⟩ false
    ⟨85, by dsimp [mBAux]; omega⟩
    ⟨96 + 2 * B + 2, by dsimp [mBAux]; omega⟩ false
    (wire_ne_of_lt (by dsimp; omega)) (wire_ne_of_gt (by dsimp; omega))
    (by dsimp; omega) (by dsimp; omega) (by dsimp; omega)
    (ScopedBlock.z_kick q)
  have h2 := ScopedBlock.withLitAndXor2_block (M := mBAux B)
