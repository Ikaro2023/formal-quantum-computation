/-! ### Generic W-State Hybrid Pruned 10-Bit Router (`749 = 512 + 237`) -/
theorem l26_pool_pow2_lt {B_max B p : ℕ} (hBm : B_max ≤ 9) (hB1 : 1 ≤ B) (hBB : B ≤ B_max)
    (hp : p < 2 ^ B) : (9 - B) + p < (9 - B_max) + 2 ^ B_max := by
  interval_cases B_max <;> interval_cases B <;> omega
theorem l26_pool_anc_lt {B_max m : ℕ} (hBm : B_max ≤ 9) (hm : m < 9) :
    8 - m < (9 - B_max) + 2 ^ B_max := by
  interval_cases B_max <;> omega
/-- Routing `T` count for hybrid pruned tree switching to W-state expansion at `Q = 2^k, k ≤
  B_max`. -/
def l26_wTreeRoutingT (B_max : ℕ) : (k Q : ℕ) → ℕ
  | 0, _ => 0
  | m + 1, Q =>
      if Q = 2 ^ (m + 1) ∧ m + 1 ≤ B_max then
        2 * 2 ^ (m + 1) + 2 * (m + 1) - 2
      else if Q ≤ 2 ^ m then
        l26_wTreeRoutingT B_max m Q
      else
        4 + l26_wTreeRoutingT B_max m (2 ^ m) + l26_wTreeRoutingT B_max m (Q - 2 ^ m)
/-- Sum of `leafCost` over the `Q` active leaves `[base .. base + Q)` of a `k`-bit pruned tree. -/
def l26_treeLeafCostSum (leafCost : ℕ → ℕ) : (k base Q : ℕ) → ℕ
  | 0, base, _ => leafCost base
  | m + 1, base, Q =>
      if Q ≤ 2 ^ m then
        l26_treeLeafCostSum leafCost m base Q
      else
        l26_treeLeafCostSum leafCost m base (2 ^ m) +
          l26_treeLeafCostSum leafCost m (base + 2 ^ m) (Q - 2 ^ m)
/-- Sequential leaf prefix `0 .. m - 1` inside a `2^B` W-state block. -/
def l26_leafRangeCost (leafCost : ℕ → ℕ) (base : ℕ) : ℕ → ℕ
  | 0 => 0
  | m + 1 => l26_leafRangeCost leafCost base m + leafCost (base + m)
theorem l26_leafRangeCost_pow2_eq (leafCost : ℕ → ℕ) :
    ∀ (k base : ℕ), l26_leafRangeCost leafCost base (2 ^ k) =
      l26_treeLeafCostSum leafCost k base (2 ^ k)
  | 0, base => by simp [l26_leafRangeCost, l26_treeLeafCostSum]
  | m + 1, base => by
      have hsplit : ∀ a b c : ℕ, l26_leafRangeCost leafCost c (a + b) = l26_leafRangeCost
          leafCost c a + l26_leafRangeCost leafCost (c + a) b := by
        intro a b c
        induction b with
        | zero => simp [l26_leafRangeCost]
        | succ b ih =>
            rw [← Nat.add_assoc a b 1]
            dsimp only [l26_leafRangeCost]
            rw [ih, Nat.add_assoc c a b, Nat.add_assoc]
      have hpow : 2 ^ (m + 1) = 2 ^ m + 2 ^ m := by ring
      have hnle : ¬ (2 ^ (m + 1) ≤ 2 ^ m) := by
        have : 1 ≤ 2 ^ m := Nat.one_le_two_pow; omega
      have hsub : 2 ^ (m + 1) - 2 ^ m = 2 ^ m := by omega
      dsimp only [l26_treeLeafCostSum]
      rw [ite_eq_right hnle, hsub, hpow, hsplit (2 ^ m) (2 ^ m) base,
          l26_leafRangeCost_pow2_eq leafCost m base,
          l26_leafRangeCost_pow2_eq leafCost m (base + 2 ^ m)]
/-- Control wire provenance inside the hybrid pruned tree: either `wRootCtrl` or a wire of
  `rPool`. -/
def IsTreeCtrlWire {n M : ℕ} (wRootCtrl : Wire n) (rPool : QRegister M n) (wCtrl : Wire n) : Prop :=
  wCtrl = wRootCtrl ∨ ∃ j : Fin M, wCtrl = rPool j
/-- Stronger level-`k` control bound: either `wRootCtrl` or `rPool j` with `j.val < 9 - k`. -/
def IsTreeCtrlAt {n M : ℕ} (wRootCtrl : Wire n) (rPool : QRegister M n)
    (k : ℕ) (wCtrl : Wire n) : Prop :=
  wCtrl = wRootCtrl ∨ ∃ j : Fin M, j.val < 9 - k ∧ wCtrl = rPool j
theorem IsTreeCtrlAt.toWire {n M k : ℕ} {wRootCtrl : Wire n} {rPool : QRegister M n}
    {wCtrl : Wire n} (h : IsTreeCtrlAt wRootCtrl rPool k wCtrl) :
    IsTreeCtrlWire wRootCtrl rPool wCtrl := by
  rcases h with rfl | ⟨j, _, rfl⟩
  · exact Or.inl rfl
  · exact Or.inr ⟨j, rfl⟩
theorem IsTreeCtrlAt.step {n M m : ℕ} {wRootCtrl : Wire n} {rPool : QRegister M n}
    {wCtrl : Wire n} (hm : m < 9) (h : IsTreeCtrlAt wRootCtrl rPool (m + 1) wCtrl) :
    IsTreeCtrlAt wRootCtrl rPool m wCtrl := by
  rcases h with rfl | ⟨j, hj, rfl⟩
  · exact Or.inl rfl
  · exact Or.inr ⟨j, by omega, rfl⟩
/-- Sequential execution of `m ≤ 2^B` controlled leaf phase circuits on `wOut 0 .. wOut (m - 1)`. -/
def wLeafSeqDyn {Var : Type} {n M B : ℕ}
    (wRootCtrl : Wire n) (rPool : QRegister M n) (base : ℕ)
    (wOut : Fin (2 ^ B) → Wire n)
    (hwOut : ∀ p : Fin (2 ^ B), IsTreeCtrlWire wRootCtrl rPool (wOut p))
    (dLeaf : (q : ℕ) → (wCtrl : Wire n) → IsTreeCtrlWire wRootCtrl rPool wCtrl →
      DynamicCircuit Var n) :
    (m : ℕ) → m ≤ 2 ^ B → DynamicCircuit Var n
  | 0, _ => .circuit .identity
  | m + 1, hm =>
      .seq (wLeafSeqDyn wRootCtrl rPool base wOut hwOut dLeaf m (Nat.le_of_succ_le hm))
        (dLeaf (base + m) (wOut ⟨m, hm⟩) (hwOut ⟨m, hm⟩))
theorem count_wLeafSeqDyn {Var : Type} {n M B : ℕ}
    (wRootCtrl : Wire n) (rPool : QRegister M n) (base : ℕ)
    (wOut : Fin (2 ^ B) → Wire n)
    (hwOut : ∀ p : Fin (2 ^ B), IsTreeCtrlWire wRootCtrl rPool (wOut p))
    (dLeaf : (q : ℕ) → (wCtrl : Wire n) → IsTreeCtrlWire wRootCtrl rPool wCtrl →
      DynamicCircuit Var n)
    (leafCost : ℕ → ℕ)
    (hLeafT : ∀ q wCtrl hc, (dLeaf q wCtrl hc).count .T = leafCost q)
    (hLeafToff : ∀ q wCtrl hc, (dLeaf q wCtrl hc).count .TOFF = 0) :
    ∀ (m : ℕ) (hm : m ≤ 2 ^ B),
      (wLeafSeqDyn wRootCtrl rPool base wOut hwOut dLeaf m hm).count .T =
        l26_leafRangeCost leafCost base m ∧
      (wLeafSeqDyn wRootCtrl rPool base wOut hwOut dLeaf m hm).count .TOFF = 0
  | 0, _ => ⟨rfl, rfl⟩
  | m + 1, hm => by
      obtain ⟨ht, hf⟩ := count_wLeafSeqDyn wRootCtrl rPool base wOut hwOut dLeaf
        leafCost hLeafT hLeafToff m (Nat.le_of_succ_le hm)
      dsimp only [wLeafSeqDyn, l26_leafRangeCost, DynamicCircuit.count]
      rw [ht, hf, hLeafT, hLeafToff]
      exact ⟨rfl, rfl⟩
theorem wLeafSeqDyn_realizes {Var : Type} [Fintype Var] [DecidableEq Var] {n M B : ℕ}
    (S_leaf : BitAssignment n → Prop)
    (wRootCtrl : Wire n) (rPool : QRegister M n) (base : ℕ)
    (wOut : Fin (2 ^ B) → Wire n)
    (hwOut : ∀ p : Fin (2 ^ B), IsTreeCtrlWire wRootCtrl rPool (wOut p))
    (dLeaf : (q : ℕ) → (wCtrl : Wire n) → IsTreeCtrlWire wRootCtrl rPool wCtrl →
      DynamicCircuit Var n)
    (leafPhase : ℕ → BitAssignment n → ZMod 2)
    (hLeafReal : ∀ q wCtrl hc,
      p2t_RealizesConstCleanUnitary (p2t_ketPredProj S_leaf) (dLeaf q wCtrl hc)
        (l26DiagUnitary (fun β ↦ β wCtrl * leafPhase q β))) :
    ∀ (m : ℕ) (hm : m ≤ 2 ^ B),
      p2t_RealizesConstCleanUnitary (p2t_ketPredProj S_leaf)
        (wLeafSeqDyn wRootCtrl rPool base wOut hwOut dLeaf m hm)
        (l26DiagUnitary (fun β ↦ ∑ p : Fin (2 ^ B),
          if p.val < m then β (wOut p) * leafPhase (base + p.val) β else 0))
  | 0, _ => by
      have h0 : l26DiagUnitary (fun β : BitAssignment n ↦ ∑ p : Fin (2 ^ B),
          if p.val < 0 then β (wOut p) * leafPhase (base + p.val) β else 0) = 1 := by
        simpa using (l26DiagUnitary_congr (fun _ ↦ by simp)).trans l26DiagUnitary_zero
      rw [h0]
      simpa only [wLeafSeqDyn, Circuit.eval_identity] using
        p2t_RealizesConstCleanUnitary_circuit (Var := Var) (p2t_ketPredProj S_leaf) .identity
  | m + 1, hm => by
      let P := p2t_ketPredProj S_leaf
      have hPh : Pᴴ = P := p2t_ketPredProj_conjTranspose S_leaf
      have ih := wLeafSeqDyn_realizes S_leaf wRootCtrl rPool base wOut hwOut dLeaf
        leafPhase hLeafReal m (Nat.le_of_succ_le hm)
      have hStep := hLeafReal (base + m) (wOut ⟨m, hm⟩) (hwOut ⟨m, hm⟩)
      have hClean : P * ((l26DiagUnitary (fun β ↦ ∑ p : Fin (2 ^ B),
          if p.val < m then β (wOut p) * leafPhase (base + p.val) β else 0)).1 * P) =
          (l26DiagUnitary (fun β ↦ ∑ p : Fin (2 ^ B),
            if p.val < m then β (wOut p) * leafPhase (base + p.val) β else 0)).1 * P := by
        rw [← Matrix.mul_assoc, ketPredProj_comm_l26DiagUnitary, Matrix.mul_assoc,
            ketPredProj_mul_self]
      have hSeq := p2t_RealizesConstCleanUnitary_seq_proj hPh hPh ih hStep hClean
      rw [l26DiagUnitary_mul] at hSeq
      refine p2t_RealizesConstCleanUnitary_congr_unitary hPh hSeq ?_
      rw [l26DiagUnitary_congr (fun β ↦ ?_)]
      have hSplit : ∀ p : Fin (2 ^ B),
          (if p.val < m + 1 then β (wOut p) * leafPhase (base + p.val) β else 0) =
          (if p.val < m then β (wOut p) * leafPhase (base + p.val) β else 0) +
          (if p = ⟨m, hm⟩ then β (wOut ⟨m, hm⟩) * leafPhase (base + m) β else 0) := fun p ↦ by
        by_cases hpm : p = ⟨m, hm⟩
        · subst hpm
          have hnlt : ¬ (m < m) := by omega
          have hlt1 : m < m + 1 := by omega
          simp [hlt1]
        · have hne : p.val ≠ m := fun h ↦ hpm (Fin.ext h)
          have hiff : p.val < m + 1 ↔ p.val < m := by omega
          simp [hpm, hiff]
      simp_rw [hSplit]
      rw [Finset.sum_add_distrib, Finset.sum_ite_eq', ite_eq_left (Finset.mem_univ _)]
/-- Power-of-two (`Q = 2^B`, `1 ≤ B ≤ B_max`) W-state one-hot phase block (`2*2^B + 2*B - 2`
  routing `T`s). -/
def wPow2PhaseBlockDyn {Var : Type} {n B_max B : ℕ} (hBm : B_max ≤ 9) (hB1 : 1 ≤ B)
    (hBB : B ≤ B_max) (v : Var) (base : ℕ) (rIdx9 : QRegister 9 n)
    (wRootCtrl wDum qEnc : Wire n) (rPool : QRegister ((9 - B_max) + 2 ^ B_max) n)
    (hIdxPool : rIdx9.DisjointWires rPool) (hRootIdx : ∀ d : Fin 9, wRootCtrl ≠ rIdx9 d)
    (hRootPool : ∀ j, wRootCtrl ≠ rPool j) (hRootDum : wRootCtrl ≠ wDum)
    (hRootEnc : wRootCtrl ≠ qEnc) (hDumIdx : ∀ d : Fin 9, wDum ≠ rIdx9 d)
    (hEncIdx : ∀ d : Fin 9, qEnc ≠ rIdx9 d) (hDumPool : ∀ j, wDum ≠ rPool j)
    (hEncPool : ∀ j, qEnc ≠ rPool j) (hDumEnc : wDum ≠ qEnc) (wCtrl : Wire n)
    (hc : IsTreeCtrlAt wRootCtrl rPool B wCtrl) (dLeaf : (q : ℕ) → (wCtrlLeaf : Wire n) →
    IsTreeCtrlWire wRootCtrl rPool wCtrlLeaf → DynamicCircuit Var n) : DynamicCircuit Var n :=
  let uLo : Fin B → Wire n := fun d ↦ rIdx9 ⟨d.val, by omega⟩
  let wOut : Fin (2 ^ B) → Wire n :=
    fun p ↦ rPool ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩
  let w : Fin 1 → Fin (2 ^ B) → Wire n := fun _ p ↦ wOut p
  have hwInj : WInj w := fun b₁ p₁ b₂ p₂ heq ↦ by
    have hb : b₁ = b₂ := Subsingleton.elim _ _
    have hp := congrArg Fin.val (rPool.wires.injective heq)
    dsimp at hp
    exact ⟨hb, Fin.ext (by omega)⟩
  have huw : ∀ d b p, uLo d ≠ w b p := fun d _ p ↦
    hIdxPool.ne ⟨d.val, by omega⟩ ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩
  have hcIdx : ∀ d : Fin B, uLo d ≠ wCtrl := fun d ↦ by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact (hRootIdx ⟨d.val, by omega⟩).symm
    · exact hIdxPool.ne ⟨d.val, by omega⟩ j
  have hcOut : ∀ (b : Fin 1) (p : Fin (2 ^ B)), w b p ≠ wCtrl := fun _ p ↦ by
    rcases hc with rfl | ⟨j, hj, rfl⟩
    · exact (hRootPool _).symm
    · exact rPool.wires.injective.ne (fun h ↦ by
        have hv := congrArg Fin.val h; dsimp at hv; omega)
  have hcDum : wCtrl ≠ wDum := by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact hRootDum
    · exact (hDumPool j).symm
  have hcEnc : wCtrl ≠ qEnc := by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact hRootEnc
    · exact (hEncPool j).symm
  have hOptInj : WOptInj 1 B uLo w wCtrl wDum qEnc :=
    { w_inj := hwInj
      uLo_ne_w := huw
      uLo_ne_rDum := hcIdx
      uLo_ne_wDum := fun d ↦ (hDumIdx ⟨d.val, by omega⟩).symm
      uLo_ne_qEnc := fun d ↦ (hEncIdx ⟨d.val, by omega⟩).symm
      w_ne_rDum := hcOut
      w_ne_wDum := fun _ p ↦ (hDumPool _).symm
      w_ne_qEnc := fun _ p ↦ (hEncPool _).symm
      rDum_ne_wDum := hcDum
      rDum_ne_qEnc := hcEnc
      wDum_ne_qEnc := hDumEnc }
  have hcOut0 : wCtrl ≠ wOut ⟨0, Nat.two_pow_pos B⟩ := (hcOut 0 ⟨0, Nat.two_pow_pos B⟩).symm
  let cInit : Circuit n :=
    Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0 ;;ᶜ Circuit.X wCtrl
  let cUninit : Circuit n :=
    Circuit.X wCtrl ;;ᶜ Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0
  have hwOutCtrl : ∀ p : Fin (2 ^ B), IsTreeCtrlWire wRootCtrl rPool (wOut p) :=
    fun p ↦ Or.inr ⟨⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩, rfl⟩
  .seq (.circuit cInit)
    (.seq (wOptExpandDyn v 1 B uLo w wCtrl wDum qEnc hOptInj)
      (.seq (wLeafSeqDyn wRootCtrl rPool base wOut hwOutCtrl dLeaf (2 ^ B) le_rfl)
        (wUncompTreeDyn v 1 B uLo w hwInj huw (.circuit cUninit) B le_rfl)))
theorem count_wPow2PhaseBlockDyn {Var : Type} {n B_max B : ℕ} (hBm : B_max ≤ 9) (hB1 : 1 ≤ B)
    (hBB : B ≤ B_max) (v : Var) (base : ℕ) (rIdx9 : QRegister 9 n)
    (wRootCtrl wDum qEnc : Wire n) (rPool : QRegister ((9 - B_max) + 2 ^ B_max) n)
    (hIdxPool : rIdx9.DisjointWires rPool) (hRootIdx : ∀ d : Fin 9, wRootCtrl ≠ rIdx9 d)
    (hRootPool : ∀ j, wRootCtrl ≠ rPool j) (hRootDum : wRootCtrl ≠ wDum)
    (hRootEnc : wRootCtrl ≠ qEnc) (hDumIdx : ∀ d : Fin 9, wDum ≠ rIdx9 d)
    (hEncIdx : ∀ d : Fin 9, qEnc ≠ rIdx9 d) (hDumPool : ∀ j, wDum ≠ rPool j)
    (hEncPool : ∀ j, qEnc ≠ rPool j) (hDumEnc : wDum ≠ qEnc) (wCtrl : Wire n)
    (hc : IsTreeCtrlAt wRootCtrl rPool B wCtrl) (dLeaf : (q : ℕ) → (wCtrlLeaf : Wire n) →
    IsTreeCtrlWire wRootCtrl rPool wCtrlLeaf → DynamicCircuit Var n) (leafCost : ℕ → ℕ)
    (hLeafT : ∀ q wCtrlL hcL, (dLeaf q wCtrlL hcL).count .T = leafCost q)
    (hLeafToff : ∀ q wCtrlL hcL, (dLeaf q wCtrlL hcL).count .TOFF = 0) : (wPow2PhaseBlockDyn
    hBm hB1 hBB v base rIdx9 wRootCtrl wDum qEnc rPool hIdxPool hRootIdx hRootPool hRootDum
    hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc wCtrl hc dLeaf).count .T =
    (2 * 2 ^ B + 2 * B - 2) + l26_treeLeafCostSum leafCost B base (2 ^ B) ∧
    (wPow2PhaseBlockDyn hBm hB1 hBB v base rIdx9 wRootCtrl wDum qEnc rPool hIdxPool hRootIdx
    hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc wCtrl hc
    dLeaf).count .TOFF = 0 := by
  let uLo : Fin B → Wire n := fun d ↦ rIdx9 ⟨d.val, by omega⟩
  let wOut : Fin (2 ^ B) → Wire n :=
    fun p ↦ rPool ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩
  let w : Fin 1 → Fin (2 ^ B) → Wire n := fun _ p ↦ wOut p
  have hwInj : WInj w := fun b₁ p₁ b₂ p₂ heq ↦ by
    have hb : b₁ = b₂ := Subsingleton.elim _ _
    have hp := congrArg Fin.val (rPool.wires.injective heq)
    dsimp at hp
    exact ⟨hb, Fin.ext (by omega)⟩
  have huw : ∀ d b p, uLo d ≠ w b p := fun d _ p ↦
    hIdxPool.ne ⟨d.val, by omega⟩ ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩
  have hcIdx : ∀ d : Fin B, uLo d ≠ wCtrl := fun d ↦ by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact (hRootIdx ⟨d.val, by omega⟩).symm
    · exact hIdxPool.ne ⟨d.val, by omega⟩ j
  have hcOut : ∀ (b : Fin 1) (p : Fin (2 ^ B)), w b p ≠ wCtrl := fun _ p ↦ by
    rcases hc with rfl | ⟨j, hj, rfl⟩
    · exact (hRootPool _).symm
    · exact rPool.wires.injective.ne (fun h ↦ by
        have hv := congrArg Fin.val h; dsimp at hv; omega)
  have hcDum : wCtrl ≠ wDum := by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact hRootDum
    · exact (hDumPool j).symm
  have hcEnc : wCtrl ≠ qEnc := by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact hRootEnc
    · exact (hEncPool j).symm
  have hOptInj : WOptInj 1 B uLo w wCtrl wDum qEnc :=
    { w_inj := hwInj
      uLo_ne_w := huw
      uLo_ne_rDum := hcIdx
      uLo_ne_wDum := fun d ↦ (hDumIdx ⟨d.val, by omega⟩).symm
      uLo_ne_qEnc := fun d ↦ (hEncIdx ⟨d.val, by omega⟩).symm
      w_ne_rDum := hcOut
      w_ne_wDum := fun _ p ↦ (hDumPool _).symm
      w_ne_qEnc := fun _ p ↦ (hEncPool _).symm
      rDum_ne_wDum := hcDum
      rDum_ne_qEnc := hcEnc
      wDum_ne_qEnc := hDumEnc }
  have hcOut0 : wCtrl ≠ wOut ⟨0, Nat.two_pow_pos B⟩ := (hcOut 0 ⟨0, Nat.two_pow_pos B⟩).symm
  let cInit : Circuit n :=
    Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0 ;;ᶜ Circuit.X wCtrl
  let cUninit : Circuit n :=
    Circuit.X wCtrl ;;ᶜ Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0
  have hwOutCtrl : ∀ p : Fin (2 ^ B), IsTreeCtrlWire wRootCtrl rPool (wOut p) :=
    fun p ↦ Or.inr ⟨⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩, rfl⟩
  dsimp only [wPow2PhaseBlockDyn]
  obtain ⟨tExp, fExp⟩ := count_wOptExpandDyn v 1 B uLo w wCtrl wDum qEnc hOptInj
  obtain ⟨tLf, fLf⟩ := count_wLeafSeqDyn wRootCtrl rPool base wOut hwOutCtrl dLeaf leafCost
    hLeafT hLeafToff (2 ^ B) le_rfl
  obtain ⟨tUnc, fUnc⟩ := count_wUncompTreeDyn_opt v 1 B uLo w hwInj huw (.circuit cUninit) B le_rfl
  have hcInitT : ∀ (c t : Wire n) (h : c ≠ t),
      (Circuit.CNOT c t h ;;ᶜ Circuit.X c).count .T = 0 := fun _ _ _ ↦ by
    simp [Circuit.count]
  have hcInitF : ∀ (c t : Wire n) (h : c ≠ t),
      (Circuit.CNOT c t h ;;ᶜ Circuit.X c).count .TOFF = 0 := fun _ _ _ ↦ by
    simp [Circuit.count]
  have hcUninitT : ∀ (c t : Wire n) (h : c ≠ t),
      (Circuit.X c ;;ᶜ Circuit.CNOT c t h).count .T = 0 := fun _ _ _ ↦ by
    simp [Circuit.count]
  have hcUninitF : ∀ (c t : Wire n) (h : c ≠ t),
      (Circuit.X c ;;ᶜ Circuit.CNOT c t h).count .TOFF = 0 := fun _ _ _ ↦ by
    simp [Circuit.count]
  simp only [DynamicCircuit.count] at tUnc fUnc ⊢
  rw [hcInitT, hcInitF, tExp, fExp, tLf, fLf, tUnc, fUnc, hcUninitT, hcUninitF,
      l26_leafRangeCost_pow2_eq]
  have hp1 : 1 ≤ 2 ^ B := Nat.one_le_two_pow
  exact ⟨by omega, rfl⟩
/-- Subtree clean invariant at depth `k ≤ 9`. -/
def SubtreeCleanPred {n M : ℕ} (P_ext : BitAssignment n → Prop)
    (wDum qEnc : Wire n) (rPool : QRegister M n) (k : ℕ) (β : BitAssignment n) : Prop :=
  P_ext β ∧ β wDum = 0 ∧ β qEnc = 0 ∧ ∀ j : Fin M, 9 - k ≤ j.val → β (rPool j) = 0
theorem wPow2PhaseBlockDyn_realizes {Var : Type} [Fintype Var] [DecidableEq Var]
    {n B_max B : ℕ}
    (hBm : B_max ≤ 9) (hB1 : 1 ≤ B) (hBB : B ≤ B_max)
    (v : Var) (base : ℕ)
    (P_ext : BitAssignment n → Prop)
    (rIdx9 : QRegister 9 n) (wRootCtrl wDum qEnc : Wire n)
    (rPool : QRegister ((9 - B_max) + 2 ^ B_max) n)
    (hIdxPool : rIdx9.DisjointWires rPool)
    (hRootIdx : ∀ d : Fin 9, wRootCtrl ≠ rIdx9 d)
    (hRootPool : ∀ j, wRootCtrl ≠ rPool j)
    (hRootDum : wRootCtrl ≠ wDum) (hRootEnc : wRootCtrl ≠ qEnc)
    (hDumIdx : ∀ d : Fin 9, wDum ≠ rIdx9 d)
    (hEncIdx : ∀ d : Fin 9, qEnc ≠ rIdx9 d)
    (hDumPool : ∀ j, wDum ≠ rPool j)
    (hEncPool : ∀ j, qEnc ≠ rPool j)
    (hDumEnc : wDum ≠ qEnc)
    (hExtRoot : ∀ β val, P_ext (Function.update β wRootCtrl val) ↔ P_ext β)
    (hExtPool : ∀ j β val, P_ext (Function.update β (rPool j) val) ↔ P_ext β)
    (wCtrl : Wire n) (hc : IsTreeCtrlAt wRootCtrl rPool B wCtrl)
    (dLeaf : (q : ℕ) → (wCtrlLeaf : Wire n) →
      IsTreeCtrlWire wRootCtrl rPool wCtrlLeaf → DynamicCircuit Var n)
    (leafPhase : ℕ → BitAssignment n → ZMod 2)
    (hPhaseRoot : ∀ q β val, leafPhase q (Function.update β wRootCtrl val) = leafPhase q β)
    (hPhasePool : ∀ q j β val, leafPhase q (Function.update β (rPool j) val) = leafPhase q β)
    (hLeafReal : ∀ q wCtrlL hcL,
      p2t_RealizesConstCleanUnitary
        (p2t_ketPredProj (fun β ↦ P_ext β ∧ β wDum = 0 ∧ β qEnc = 0))
        (dLeaf q wCtrlL hcL)
        (l26DiagUnitary (fun β ↦ β wCtrlL * leafPhase q β))) :
    p2t_RealizesConstCleanUnitary
      (p2t_ketPredProj (SubtreeCleanPred P_ext wDum qEnc rPool B))
      (wPow2PhaseBlockDyn hBm hB1 hBB v base rIdx9 wRootCtrl wDum qEnc rPool
        hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
        wCtrl hc dLeaf)
      (l26DiagUnitary (fun β ↦
        β wCtrl * leafPhase (base + idxValPrefix (fun d : Fin B ↦
          rIdx9 ⟨d.val, by omega⟩) β B le_rfl) β)) := by
  classical
  let M := (9 - B_max) + 2 ^ B_max
  let uLo : Fin B → Wire n := fun d ↦ rIdx9 ⟨d.val, by omega⟩
  let wOut : Fin (2 ^ B) → Wire n :=
    fun p ↦ rPool ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩
  let w : Fin 1 → Fin (2 ^ B) → Wire n := fun _ p ↦ wOut p
  let bStarFn : BitAssignment n → Fin 1 := fun _ ↦ 0
  let P_inv : BitAssignment n → Prop := fun δ ↦
    P_ext δ ∧ ∀ j : Fin M, 9 - B ≤ j.val → 9 - B + 2 ^ B ≤ j.val → δ (rPool j) = 0
  let activePred : BitAssignment n → Prop := fun δ ↦ δ wCtrl = 0
  let S_in := SubtreeCleanPred P_ext wDum qEnc rPool B
  let S_leaf : BitAssignment n → Prop := fun β ↦ P_ext β ∧ β wDum = 0 ∧ β qEnc = 0
  have hcExt : ∀ β val, P_ext (Function.update β wCtrl val) ↔ P_ext β := by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact hExtRoot
    · exact hExtPool j
  have hcPhase : ∀ q β val, leafPhase q (Function.update β wCtrl val) = leafPhase q β :=
    fun q ↦ by
      rcases hc with rfl | ⟨j, _, rfl⟩
      · exact hPhaseRoot q
      · exact hPhasePool q j
  have hcRest : ∀ (j : Fin M), 9 - B ≤ j.val → wCtrl ≠ rPool j := fun j hj ↦ by
    rcases hc with rfl | ⟨j₀, hj₀, rfl⟩
    · exact hRootPool j
    · exact rPool.wires.injective.ne (fun h ↦ by have hv := congrArg Fin.val h; omega)
  have hcDum : wCtrl ≠ wDum := by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact hRootDum
    · exact (hDumPool j).symm
  have hcEnc : wCtrl ≠ qEnc := by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact hRootEnc
    · exact (hEncPool j).symm
  have hcIdx : ∀ d : Fin B, uLo d ≠ wCtrl := fun d ↦ by
    rcases hc with rfl | ⟨j, _, rfl⟩
    · exact (hRootIdx ⟨d.val, by omega⟩).symm
    · exact hIdxPool.ne ⟨d.val, by omega⟩ j
  have hInvCtrl : ∀ δ val, P_inv (Function.update δ wCtrl val) ↔ P_inv δ := fun δ val ↦ by
    dsimp only [P_inv]
    refine and_congr (hcExt δ val) (forall_congr' fun j ↦ imp_congr_right fun hj ↦
      imp_congr_right fun _ ↦ ?_)
    rw [Function.update_of_ne (hcRest j hj).symm]
  have hSin_iff : ∀ δ : BitAssignment n,
      (OptBasePred P_inv wDum qEnc δ ∧ ∀ b p, δ (w b p) = 0) ↔ S_in δ := fun δ ↦ by
    constructor
    · rintro ⟨⟨⟨hext, hhi⟩, hwd, hqe⟩, hw0⟩
      refine ⟨hext, hwd, hqe, fun j hj ↦ ?_⟩
      by_cases hlt : j.val < 9 - B + 2 ^ B
      · let p : Fin (2 ^ B) := ⟨j.val - (9 - B), by omega⟩
        have hjEq : j = ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩ :=
          Fin.ext (by dsimp [p]; omega)
        rw [hjEq]; exact hw0 0 p
      · exact hhi j hj (by omega)
    · rintro ⟨hext, hwd, hqe, hpool⟩
      refine ⟨⟨⟨hext, fun j hj _ ↦ hpool j hj⟩, hwd, hqe⟩, fun _ p ↦ ?_⟩
      exact hpool ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩ (by dsimp; omega)
  have hSin_x : ∀ δ : BitAssignment n,
      (OptBasePred P_inv wDum qEnc (Function.update δ wCtrl (δ wCtrl + 1)) ∧
        ∀ b p, Function.update δ wCtrl (δ wCtrl + 1) (w b p) = 0) ↔ S_in δ := fun δ ↦ by
    have h1 : OptBasePred P_inv wDum qEnc (Function.update δ wCtrl (δ wCtrl + 1)) ↔
        OptBasePred P_inv wDum qEnc δ := by
      dsimp only [OptBasePred]
      rw [hInvCtrl, Function.update_of_ne hcDum.symm, Function.update_of_ne hcEnc.symm]
    have h2 : (∀ b p, Function.update δ wCtrl (δ wCtrl + 1) (w b p) = 0) ↔
        ∀ b p, δ (w b p) = 0 :=
      forall_congr' fun _ ↦ forall_congr' fun p ↦ by
        rw [Function.update_of_ne (hcRest _ (by dsimp; omega)).symm]
    exact (and_congr h1 h2).trans (hSin_iff δ)
  have hcOut0 : wCtrl ≠ wOut ⟨0, Nat.two_pow_pos B⟩ := hcRest _ (by dsimp; omega)
  let cInit : Circuit n :=
    Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0 ;;ᶜ Circuit.X wCtrl
  let cUninit : Circuit n :=
    Circuit.X wCtrl ;;ᶜ Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0
  let Xc : Operator (2 ^ n) := (Circuit.X wCtrl).eval.1
  let O_0 := oneHotOptPreOp (OptBasePred P_inv wDum qEnc) activePred bStarFn uLo w 0 (Nat.zero_le B)
  let O_B := oneHotOptPreOp (OptBasePred P_inv wDum qEnc) activePred bStarFn uLo w B le_rfl
  let P_sub := p2t_ketPredProj S_in
  have hInitEq : cInit.eval.1 * P_sub = O_0 * Xc := by
    apply matrix_ext_ket; intro δ
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    have hXket : Xc.mulVec (ket δ) = ket (Function.update δ wCtrl (δ wCtrl + 1)) := ket_X wCtrl δ
    rw [hXket, mbh_ket_eq_ket, p2t_ketPredProj_mul_ket]
    dsimp only [O_0, oneHotOptPreOp]
    rw [← mbh_ket_eq_ket, mkVecOp_mulVec_ket]
    dsimp only [oneHotOptPreVec]
    by_cases hs : S_in δ
    · rw [ite_eq_left hs, ite_eq_left ((hSin_x δ).mpr hs)]
      have hw0_0 : δ (wOut ⟨0, Nat.two_pow_pos B⟩) = 0 :=
        hs.2.2.2 ⟨(9 - B) + 0, l26_pool_pow2_lt hBm hB1 hBB (Nat.two_pow_pos B)⟩ (by dsimp; omega)
      dsimp only [cInit]
      rw [eval_seq_mulVec, ket_CNOT, hw0_0, zero_add, ket_X]
      rcases bit_cases (δ wCtrl) with h0 | h1
      · rw [h0, zero_add, update_eq_self_of_zero hw0_0]
        have hnact : ¬ activePred (Function.update δ wCtrl 1) := by
          dsimp [activePred]; rw [Function.update_self]; decide
        rw [ite_eq_right hnact, h0, zero_add]
      · rw [h1, show (1 : ZMod 2) + 1 = 0 by decide]
        have hact : activePred (Function.update δ wCtrl 0) := by
          dsimp [activePred]; exact Function.update_self _ _ _
        rw [ite_eq_left hact]
        have hp0 : (⟨idxValPrefix uLo (Function.update δ wCtrl 0) 0 (Nat.zero_le B),
            Nat.lt_of_lt_of_le (idxValPrefix_lt_two_pow _ _ 0 _)
              (Nat.pow_le_pow_right (by omega) (Nat.zero_le B))⟩ : Fin (2 ^ B)) =
            ⟨0, Nat.two_pow_pos B⟩ := Fin.ext rfl
        rw [hp0]
        apply congrArg ket; funext q
        dsimp only [w]
        by_cases hqc : q = wCtrl
        · subst hqc
          rw [Function.update_self, Function.update_of_ne hcOut0,
              Function.update_of_ne hcOut0, Function.update_self, h1]
          decide
        · by_cases hqo : q = wOut ⟨0, Nat.two_pow_pos B⟩
          · subst hqo
            rw [Function.update_of_ne hcOut0.symm, Function.update_self, Function.update_self]
          · rw [Function.update_of_ne hqc, Function.update_of_ne hqo,
                Function.update_of_ne hqo, Function.update_of_ne hqc]
    · rw [ite_eq_right hs, ite_eq_right (mt (hSin_x δ).mp hs), Matrix.mulVec_zero]
  have hCInv : cUninit.eval.1 * cInit.eval.1 = 1 := by
    dsimp only [cUninit, cInit]
    simp only [Circuit.eval_seq, Submonoid.coe_mul]
    calc ((Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0).eval.1 *
            (Circuit.X wCtrl).eval.1) *
          ((Circuit.X wCtrl).eval.1 *
            (Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0).eval.1)
        = (Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0).eval.1 *
            ((Circuit.X wCtrl).eval.1 * (Circuit.X wCtrl).eval.1) *
            (Circuit.CNOT wCtrl (wOut ⟨0, Nat.two_pow_pos B⟩) hcOut0).eval.1 := by
              simp only [Matrix.mul_assoc]
      _ = 1 := by rw [eval_X_mul_self_opt, Matrix.mul_one, eval_CNOT_mul_self_opt]
  have hUninitEq : cUninit.eval.1 * O_0 = P_sub * Xc := by
    have hO0 : O_0 = cInit.eval.1 * P_sub * Xc := by
      calc O_0 = O_0 * 1 := (Matrix.mul_one _).symm
        _ = O_0 * (Xc * Xc) := by rw [eval_X_mul_self_opt wCtrl]
        _ = (O_0 * Xc) * Xc := (Matrix.mul_assoc _ _ _).symm
        _ = (cInit.eval.1 * P_sub) * Xc := by rw [hInitEq]
    calc cUninit.eval.1 * O_0
        = (cUninit.eval.1 * cInit.eval.1) * (P_sub * Xc) := by
            rw [hO0]; simp only [Matrix.mul_assoc]
      _ = P_sub * Xc := by rw [hCInv, Matrix.one_mul]
  have hDumBit : ∀ δ, P_inv δ → δ wCtrl = (if activePred δ then 0 else 1) := fun δ _ ↦ by
    dsimp only [activePred]
    rcases bit_cases (δ wCtrl) with h0 | h1
    · simp [h0]
    · simp [h1]
  let U_leaves := l26DiagUnitary (fun β ↦ ∑ p : Fin (2 ^ B),
    if p.val < 2 ^ B then β (wOut p) * leafPhase (base + p.val) β else 0)
  let U_block := l26DiagUnitary (fun β ↦
    β wCtrl * leafPhase (base + idxValPrefix uLo β B le_rfl) β)
  have hLeafProj_OB : p2t_ketPredProj S_leaf * O_B = O_B := by
    apply matrix_ext_ket; intro δ
    rw [← Matrix.mulVec_mulVec]
    dsimp only [O_B, oneHotOptPreOp]
    rw [mkVecOp_mulVec_ket]
    dsimp only [oneHotOptPreVec]
    split_ifs with hV hAct
    · rw [mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_left]
      refine ⟨?_, ?_, ?_⟩
      · exact (hExtPool _ _ _).mpr hV.1.1.1
      · rw [Function.update_of_ne (hDumPool _)]; exact hV.1.2.1
      · rw [Function.update_of_ne (hEncPool _)]; exact hV.1.2.2
    · rw[mbh_ket_eq_ket, p2t_ketPredProj_mul_ket, ite_eq_left ⟨hV.1.1.1, hV.1.2.1, hV.1.2.2⟩]
    · exact Matrix.mulVec_zero _
  have hLeavesEq : U_leaves.1 * (O_B * Xc) = O_B * (Xc * U_block.1) := by
    apply matrix_ext_ket; intro δ
    have hIdxEq : ∀ (m : ℕ) (hm : m ≤ B), idxValPrefix uLo
        (Function.update δ wCtrl (δ wCtrl + 1)) m hm = idxValPrefix uLo δ m hm := by
      intro m hm
      induction m with
      | zero => rfl
      | succ r ih =>
          dsimp only [idxValPrefix]
          rw [ih (Nat.le_of_succ_le hm), Function.update_of_ne (hcIdx ⟨r, hm⟩)]
    let δ' := Function.update δ wCtrl (δ wCtrl + 1)
    have hXket : Xc.mulVec (ket δ) = ket δ' := ket_X wCtrl δ
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        ← Matrix.mulVec_mulVec, l26DiagUnitary_mulVec_ket, Matrix.mulVec_smul,
        Matrix.mulVec_smul, hXket]
    dsimp only [O_B, oneHotOptPreOp]
    rw [mkVecOp_mulVec_ket]
    dsimp only [oneHotOptPreVec]
    by_cases hs : S_in δ
    · have hVx := (hSin_x δ).mpr hs
      rw [ite_eq_left hVx]
      rcases bit_cases (δ wCtrl) with h0 | h1
      · have hnact : ¬ activePred δ' := by
          dsimp [activePred, δ']; rw [Function.update_self, h0]; decide
        rw [ite_eq_right hnact, l26DiagUnitary_mulVec_ket, h0, zero_mul]
        refine congrArg (fun e : ZMod 2 ↦ ((-1 : ℂ) ^ e.val) • ket δ') ?_
        have hSum0 : (∑ p : Fin (2 ^ B),
            if p.val < 2 ^ B then δ' (wOut p) * leafPhase (base + p.val) δ' else 0) = 0 := by
          apply Finset.sum_eq_zero; intro p _
          have hw0 : δ' (wOut p) = 0 := hVx.2 0 p
          simp [p.isLt, hw0]
        exact hSum0
      · have hact : activePred δ' := by
          dsimp [activePred, δ']; rw [Function.update_self, h1]; decide
        rw [ite_eq_left hact, l26DiagUnitary_mulVec_ket, h1, one_mul]
        let pStar : Fin (2 ^ B) := ⟨idxValPrefix uLo δ' B le_rfl,
          Nat.lt_of_lt_of_le (idxValPrefix_lt_two_pow uLo δ' B le_rfl) le_rfl⟩
        change ((-1 : ℂ) ^ (∑ p : Fin (2 ^ B), if p.val < 2 ^ B then Function.update δ' (wOut
          pStar) 1 (wOut p) * leafPhase (base + p.val) (Function.update δ' (wOut pStar) 1)
          else 0).val) • _ = _
        refine congrArg (fun e : ZMod 2 ↦
          ((-1 : ℂ) ^ e.val) • ket (Function.update δ' (wOut pStar) 1)) ?_
        have hTerm : ∀ p : Fin (2 ^ B),
            (if p.val < 2 ^ B then
              Function.update δ' (wOut pStar) 1 (wOut p) *
                leafPhase (base + p.val) (Function.update δ' (wOut pStar) 1)
             else 0) =
            if p = pStar then leafPhase (base + pStar.val) δ else 0 := fun p ↦ by
          simp only [p.isLt, ↓reduceIte]
          by_cases hp : p = pStar
          · rw [hp, ite_eq_left rfl, Function.update_self, one_mul,
                hPhasePool (base + pStar.val) ⟨(9 - B) + pStar.val,
                  l26_pool_pow2_lt hBm hB1 hBB pStar.isLt⟩ δ' 1,
                hcPhase (base + pStar.val) δ (δ wCtrl + 1)]
          · have hneW : wOut p ≠ wOut pStar :=
              rPool.wires.injective.ne (fun h ↦ hp (Fin.ext (by
                have hv := congrArg Fin.val h; dsimp at hv; omega)))
            have hw0p : δ' (wOut p) = 0 := hVx.2 0 p
            rw [Function.update_of_ne hneW, hw0p, zero_mul, ite_eq_right hp]
        simp_rw [hTerm]
        rw [Finset.sum_ite_eq', ite_eq_left (Finset.mem_univ _)]
        dsimp only [pStar]
        rw [hIdxEq B le_rfl]
    · rw [ite_eq_right (mt (hSin_x δ).mp hs), Matrix.mulVec_zero, smul_zero]
  have hwInj : WInj w := fun b₁ p₁ b₂ p₂ heq ↦ by
    have hb : b₁ = b₂ := Subsingleton.elim _ _
    have hp := congrArg Fin.val (rPool.wires.injective heq)
    dsimp at hp
    exact ⟨hb, Fin.ext (by omega)⟩
  have huw : ∀ d b p, uLo d ≠ w b p := fun d _ p ↦
    hIdxPool.ne ⟨d.val, by omega⟩ ⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩
  have hcOut : ∀ (b : Fin 1) (p : Fin (2 ^ B)), w b p ≠ wCtrl := fun _ p ↦
    (hcRest _ (by dsimp; omega)).symm
  have hOptInj : WOptInj 1 B uLo w wCtrl wDum qEnc :=
    { w_inj := hwInj
      uLo_ne_w := huw
      uLo_ne_rDum := hcIdx
      uLo_ne_wDum := fun d ↦ (hDumIdx ⟨d.val, by omega⟩).symm
      uLo_ne_qEnc := fun d ↦ (hEncIdx ⟨d.val, by omega⟩).symm
      w_ne_rDum := hcOut
      w_ne_wDum := fun _ _ ↦ (hDumPool _).symm
      w_ne_qEnc := fun _ _ ↦ (hEncPool _).symm
      rDum_ne_wDum := hcDum
      rDum_ne_qEnc := hcEnc
      wDum_ne_qEnc := hDumEnc }
  have hwOutCtrl : ∀ p : Fin (2 ^ B), IsTreeCtrlWire wRootCtrl rPool (wOut p) :=
    fun p ↦ Or.inr ⟨⟨(9 - B) + p.val, l26_pool_pow2_lt hBm hB1 hBB p.isLt⟩, rfl⟩
  dsimp only [wPow2PhaseBlockDyn]
  have s1 : SubspaceStep (Var := Var) P_sub (O_0 * Xc) (.circuit cInit) :=
    subspaceStep_congr_out (subspaceStep_of_circuit P_sub cInit) hInitEq
  have s2 : SubspaceStep (O_0 * Xc) (O_B *
    Xc) (wOptExpandDyn v 1 B uLo w wCtrl wDum qEnc hOptInj) :=
    (subspaceStep_wOptExpandDyn v P_inv activePred bStarFn uLo w wCtrl wDum qEnc hOptInj
      hDumBit).mul_right Xc
  have s3_raw : SubspaceStep O_B (U_leaves.1 * O_B) (wLeafSeqDyn wRootCtrl rPool base wOut
      hwOutCtrl dLeaf (2 ^ B) le_rfl) := SubspaceStep.ofConstCleanUnitary
      (p2t_ketPredProj_conjTranspose S_leaf) (wLeafSeqDyn_realizes S_leaf wRootCtrl rPool base
      wOut hwOutCtrl dLeaf leafPhase hLeafReal (2 ^ B) le_rfl) hLeafProj_OB
  have s3 : SubspaceStep (O_B * Xc) (O_B * (Xc * U_block.1))
      (wLeafSeqDyn wRootCtrl rPool base wOut hwOutCtrl dLeaf (2 ^ B) le_rfl) :=
    subspaceStep_congr_out (s3_raw.mul_right Xc) (by rw [Matrix.mul_assoc, hLeavesEq])
  have sUninit : SubspaceStep (Var := Var) O_0 (P_sub * Xc) (.circuit cUninit) :=
    subspaceStep_congr_out (subspaceStep_of_circuit O_0 cUninit) hUninitEq
  have s4_raw : SubspaceStep O_B (P_sub * Xc)
      (wUncompTreeDyn v 1 B uLo w hwInj huw (.circuit cUninit) B le_rfl) :=
    subspaceStep_wUncompTreeDyn_opt v (OptBasePred P_inv wDum qEnc) activePred bStarFn uLo w
      hwInj huw sUninit B le_rfl
  have s4 : SubspaceStep (O_B * (Xc * U_block.1)) (U_block.1 * P_sub)
      (wUncompTreeDyn v 1 B uLo w hwInj huw (.circuit cUninit) B le_rfl) :=
    subspaceStep_congr_out (s4_raw.mul_right (Xc * U_block.1)) (by
      calc (P_sub * Xc) * (Xc * U_block.1)
          = P_sub * (Xc * Xc) * U_block.1 := by simp only [Matrix.mul_assoc]
        _ = P_sub * U_block.1 := by rw [eval_X_mul_self_opt wCtrl, Matrix.mul_one]
        _ = U_block.1 * P_sub := ketPredProj_comm_l26DiagUnitary S_in _)
  exact SubspaceStep.toConstCleanUnitary (p2t_ketPredProj_conjTranspose S_in)
    (s1.seq (s2.seq (s3.seq s4)))
/-- 4-`T` MSB branch split without mutating `wMsb`. -/
def l26_branchSplitDyn {Var : Type} {n : ℕ} (v : Var) (wCtrl wMsb wAnc : Wire n)
    (hCM : wCtrl ≠ wMsb) (hCA : wCtrl ≠ wAnc) (hMA : wMsb ≠ wAnc)
    (dLeft dRight : DynamicCircuit Var n) : DynamicCircuit Var n := .seq
    (DynamicCircuit.andCompute wCtrl wMsb wAnc hCA hMA) (.seq (.seq (.circuit (Circuit.CNOT
    wCtrl wAnc hCA)) (.seq dLeft (.seq (.circuit (Circuit.CNOT wCtrl wAnc hCA)) dRight)))
    (DynamicCircuit.andUncompute v wCtrl wMsb wAnc hCM))
theorem count_l26_branchSplitDyn {Var : Type} {n : ℕ} (v : Var) (wCtrl wMsb wAnc : Wire n)
    (hCM : wCtrl ≠ wMsb) (hCA : wCtrl ≠ wAnc) (hMA : wMsb ≠ wAnc)
    (dLeft dRight : DynamicCircuit Var n) : (l26_branchSplitDyn v wCtrl wMsb wAnc hCM hCA hMA
    dLeft dRight).count .T = 4 + dLeft.count .T + dRight.count .T ∧ (l26_branchSplitDyn v
    wCtrl wMsb wAnc hCM hCA hMA dLeft dRight).count .TOFF = dLeft.count .TOFF + dRight.count
    .TOFF := by
  have hcnotT : (Circuit.CNOT wCtrl wAnc hCA).count .T = 0 := by simp [Circuit.CNOT]
  have hcnotF : (Circuit.CNOT wCtrl wAnc hCA).count .TOFF = 0 := by simp [Circuit.CNOT]
  dsimp only [l26_branchSplitDyn]
  simp only [DynamicCircuit.count, DynamicCircuit.count_andCompute_t,
    DynamicCircuit.count_andUncompute_t, DynamicCircuit.count_andCompute_toff,
    DynamicCircuit.count_andUncompute_toff, hcnotT, hcnotF]
  exact ⟨by omega, by omega⟩
theorem l26_branchSplitDyn_realizes {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    (v : Var) (wCtrl wMsb wAnc : Wire n) (hCM : wCtrl ≠ wMsb) (hCA : wCtrl ≠ wAnc)
    (hMA : wMsb ≠ wAnc) (S_pre S_sub : BitAssignment n → Prop)
    (hPreAnc : ∀ β, S_pre β → β wAnc = 0)
    (hPreSub : ∀ β val, S_pre β → S_sub (Function.update β wAnc val))
    (hSubAnc : ∀ γ val, S_sub (Function.update γ wAnc val) ↔ S_sub γ)
    (dLeft dRight : DynamicCircuit Var n) (ψ_L ψ_R : BitAssignment n → ZMod 2)
    (hLAnc : ∀ γ val, ψ_L (Function.update γ wAnc val) = ψ_L γ)
    (hRAnc : ∀ γ val, ψ_R (Function.update γ wAnc val) = ψ_R γ) (hdLeft :
    p2t_RealizesConstCleanUnitary (p2t_ketPredProj S_sub) dLeft (l26DiagUnitary (fun γ ↦ γ
    wAnc * ψ_L γ))) (hdRight : p2t_RealizesConstCleanUnitary (p2t_ketPredProj S_sub) dRight
    (l26DiagUnitary (fun γ ↦ γ wAnc * ψ_R γ))) : p2t_RealizesConstCleanUnitary
    (p2t_ketPredProj S_pre) (l26_branchSplitDyn v wCtrl wMsb wAnc hCM hCA hMA dLeft dRight)
    (l26DiagUnitary (fun γ ↦ γ wCtrl * ((1 + γ wMsb) * ψ_L γ + γ wMsb * ψ_R γ))) := by
  classical
  let C := Circuit.CNOT wCtrl wAnc hCA
  let P_sub := p2t_ketPredProj S_sub
  have hPsubH : P_subᴴ = P_sub := p2t_ketPredProj_conjTranspose S_sub
  have hCommC : P_sub * C.eval.1 = C.eval.1 * P_sub := by
    apply matrix_ext_ket; intro γ
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, mbh_ket_eq_ket,
        p2t_ketPredProj_mul_ket, ← mbh_ket_eq_ket, ket_CNOT]
    by_cases hs : S_sub γ
    · rw [ite_eq_left hs, ket_CNOT, mbh_ket_eq_ket,
          p2t_ketPredProj_mul_ket, ite_eq_left ((hSubAnc γ _).mpr hs)]
    · rw [ite_eq_right hs, mbh_ket_eq_ket, p2t_ketPredProj_mul_ket,
          ite_eq_right (mt (hSubAnc γ _).mp hs), Matrix.mulVec_zero]
  let U_L := l26DiagUnitary (fun γ ↦ γ wAnc * ψ_L γ)
  let U_R := l26DiagUnitary (fun γ ↦ γ wAnc * ψ_R γ)
  have hAbsC : ∀ U : Operator (2 ^ n), P_sub * U = U * P_sub → P_sub * (U * P_sub) = U * P_sub :=
    fun U hcomm ↦ by rw [← Matrix.mul_assoc, hcomm, Matrix.mul_assoc, ketPredProj_mul_self]
  have hd4 := hdRight
  have hd34 := p2t_RealizesConstCleanUnitary_seq_proj hPsubH hPsubH
    (p2t_RealizesConstCleanUnitary_circuit P_sub C) hd4 (hAbsC C.eval.1 hCommC)
  have hd234 := p2t_RealizesConstCleanUnitary_seq_proj hPsubH hPsubH
    hdLeft hd34 (hAbsC U_L.1 (ketPredProj_comm_l26DiagUnitary S_sub _))
  have hd1234 := p2t_RealizesConstCleanUnitary_seq_proj hPsubH hPsubH
    (p2t_RealizesConstCleanUnitary_circuit P_sub C) hd234 (hAbsC C.eval.1 hCommC)
  let U_body := l26DiagUnitary (fun γ ↦ (γ wAnc + γ wCtrl) * ψ_L γ + γ wAnc * ψ_R γ)
  have hBodyEq : ((U_R * C.eval) * U_L * C.eval) = U_body := by
    apply Subtype.ext; apply matrix_ext_ket; intro γ
    dsimp only [C, U_L, U_R, U_body]
    simp only [Submonoid.coe_mul, Matrix.mul_assoc, ← Matrix.mulVec_mulVec, ket_CNOT,
      l26DiagUnitary_mulVec_ket, Matrix.mulVec_smul, smul_smul, ← neg_one_pow_zmod2_add]
    have hRet : Function.update (Function.update γ wAnc (γ wAnc + γ wCtrl)) wAnc
        (Function.update γ wAnc (γ wAnc + γ wCtrl) wAnc +
          Function.update γ wAnc (γ wAnc + γ wCtrl) wCtrl) = γ := by
      rw [Function.update_self, Function.update_of_ne hCA, Function.update_idem]
      have hcancel : γ wAnc + γ wCtrl + γ wCtrl = γ wAnc := by
        rw [add_assoc, CharTwo.add_self_eq_zero, add_zero]
      rw [hcancel, Function.update_eq_self]
    rw [hRet, Function.update_self, hLAnc γ (γ wAnc + γ wCtrl)]
  have hdBodySub : p2t_RealizesConstCleanUnitary P_sub
      (.seq (.circuit C) (.seq dLeft (.seq (.circuit C) dRight))) U_body :=
    p2t_RealizesConstCleanUnitary_congr_unitary hPsubH hd1234 (by
      dsimp only [U_L, U_R, U_body] at hBodyEq ⊢
      simp only [← hBodyEq, Submonoid.coe_mul, Matrix.mul_assoc])
  let S_post : BitAssignment n → Prop := fun γ ↦ S_sub γ ∧ γ wAnc = γ wCtrl * γ wMsb
  let U_target := l26DiagUnitary (fun γ ↦ γ wCtrl * ((1 + γ wMsb) * ψ_L γ + γ wMsb * ψ_R γ))
  have hdBodyPost0 : p2t_RealizesConstCleanUnitary (p2t_ketPredProj S_post)
      (.seq (.circuit C) (.seq dLeft (.seq (.circuit C) dRight))) U_body :=
      p2t_RealizesConstCleanUnitary_mono_proj (p2t_ketPredProj_conjTranspose S_sub)
      (p2t_ketPredProj_conjTranspose S_post) (p2t_ketPredProj_mul_imp fun _ h ↦ h.1) hdBodySub
  have hdBodyPost : p2t_RealizesConstCleanUnitary (p2t_ketPredProj S_post)
      (.seq (.circuit C) (.seq dLeft (.seq (.circuit C) dRight))) U_target := by
    refine p2t_RealizesConstCleanUnitary_congr_unitary
      (p2t_ketPredProj_conjTranspose S_post) hdBodyPost0 ?_
    apply matrix_ext_ket; intro γ
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, mbh_ket_eq_ket, p2t_ketPredProj_mul_ket]
    by_cases hp : S_post γ
    · rw [ite_eq_left hp, ← mbh_ket_eq_ket, l26DiagUnitary_mulVec_ket, l26DiagUnitary_mulVec_ket]
      refine congrArg (fun e : ZMod 2 ↦ ((-1 : ℂ) ^ e.val) • ket γ) ?_
      rw [hp.2]; ring
    · rw [ite_eq_right hp, Matrix.mulVec_zero, Matrix.mulVec_zero]
  dsimp only [l26_branchSplitDyn]
  refine p2t_RealizesConstCleanUnitary_withTempAnd_diag v wCtrl wMsb wAnc hCM hCA hMA
    (W := fun w ↦ w = wAnc) rfl ?_ hPreAnc ?_ hdBodyPost
  · refine l26DiagUnitary_diagIndepOf fun β w val hw ↦ ?_
    subst hw
    rw [Function.update_of_ne hCA, Function.update_of_ne hMA, hLAnc β val, hRAnc β val]
  · intro β hs
    refine ⟨hPreSub β _ hs, ?_⟩
    rw [Function.update_self, Function.update_of_ne hCA, Function.update_of_ne hMA]
/-- Hybrid pruned subtree (`k ≤ 9`), switching to W-state expansion at `Q = 2^m, m ≤ B_max`. -/
def wPrunedSubtreeDyn {Var : Type} {n B_max : ℕ}
    (hBm : B_max ≤ 9) (v : Var)
    (rIdx9 : QRegister 9 n) (wRootCtrl wDum qEnc : Wire n)
    (rPool : QRegister ((9 - B_max) + 2 ^ B_max) n)
    (hIdxPool : rIdx9.DisjointWires rPool)
    (hRootIdx : ∀ d : Fin 9, wRootCtrl ≠ rIdx9 d)
    (hRootPool : ∀ j, wRootCtrl ≠ rPool j)
    (hRootDum : wRootCtrl ≠ wDum) (hRootEnc : wRootCtrl ≠ qEnc)
    (hDumIdx : ∀ d : Fin 9, wDum ≠ rIdx9 d)
    (hEncIdx : ∀ d : Fin 9, qEnc ≠ rIdx9 d)
    (hDumPool : ∀ j, wDum ≠ rPool j)
    (hEncPool : ∀ j, qEnc ≠ rPool j)
    (hDumEnc : wDum ≠ qEnc)
    (dLeaf : (q : ℕ) → (wCtrlLeaf : Wire n) →
      IsTreeCtrlWire wRootCtrl rPool wCtrlLeaf → DynamicCircuit Var n) :
    (k : ℕ) → (hk : k ≤ 9) → (base Q : ℕ) → (wCtrl : Wire n) →
      IsTreeCtrlAt wRootCtrl rPool k wCtrl → DynamicCircuit Var n
  | 0, _, base, _, wCtrl, hc =>
      dLeaf base wCtrl hc.toWire
  | m + 1, hm, base, Q, wCtrl, hc =>
      if hPow : Q = 2 ^ (m + 1) ∧ m + 1 ≤ B_max then
        wPow2PhaseBlockDyn hBm (by omega) hPow.2 v base rIdx9 wRootCtrl wDum qEnc rPool
          hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
          wCtrl hc dLeaf
      else if Q ≤ 2 ^ m then
        wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
          hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
          dLeaf m (Nat.le_of_succ_le hm) base Q wCtrl (hc.step hm)
      else
        let wMsb := rIdx9 ⟨m, hm⟩
        let wAnc := rPool ⟨8 - m, l26_pool_anc_lt hBm hm⟩
        have hCM : wCtrl ≠ wMsb := by
          rcases hc with rfl | ⟨j, _, rfl⟩
          · exact hRootIdx ⟨m, hm⟩
          · exact (hIdxPool.ne ⟨m, hm⟩ j).symm
        have hCA : wCtrl ≠ wAnc := by
          rcases hc with rfl | ⟨j, hj, rfl⟩
          · exact hRootPool _
          · exact rPool.wires.injective.ne (fun h ↦ by
              have hv := congrArg Fin.val h; dsimp at hv; omega)
        have hMA : wMsb ≠ wAnc := hIdxPool.ne ⟨m, hm⟩ _
        have hcAnc : IsTreeCtrlAt wRootCtrl rPool m wAnc :=
          Or.inr ⟨⟨8 - m, l26_pool_anc_lt hBm hm⟩, by dsimp; omega, rfl⟩
        l26_branchSplitDyn v wCtrl wMsb wAnc hCM hCA hMA
          (wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
            hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
            dLeaf m (Nat.le_of_succ_le hm) base (2 ^ m) wAnc hcAnc)
          (wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
            hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
            dLeaf m (Nat.le_of_succ_le hm) (base + 2 ^ m) (Q - 2 ^ m) wAnc hcAnc)
theorem count_wPrunedSubtreeDyn {Var : Type} {n B_max : ℕ}
    (hBm : B_max ≤ 9) (v : Var)
    (rIdx9 : QRegister 9 n) (wRootCtrl wDum qEnc : Wire n)
    (rPool : QRegister ((9 - B_max) + 2 ^ B_max) n)
    (hIdxPool : rIdx9.DisjointWires rPool)
    (hRootIdx : ∀ d : Fin 9, wRootCtrl ≠ rIdx9 d)
    (hRootPool : ∀ j, wRootCtrl ≠ rPool j)
    (hRootDum : wRootCtrl ≠ wDum) (hRootEnc : wRootCtrl ≠ qEnc)
    (hDumIdx : ∀ d : Fin 9, wDum ≠ rIdx9 d)
    (hEncIdx : ∀ d : Fin 9, qEnc ≠ rIdx9 d)
    (hDumPool : ∀ j, wDum ≠ rPool j)
    (hEncPool : ∀ j, qEnc ≠ rPool j)
    (hDumEnc : wDum ≠ qEnc)
    (dLeaf : (q : ℕ) → (wCtrlLeaf : Wire n) →
      IsTreeCtrlWire wRootCtrl rPool wCtrlLeaf → DynamicCircuit Var n)
    (leafCost : ℕ → ℕ)
    (hLeafT : ∀ q wCtrlL hcL, (dLeaf q wCtrlL hcL).count .T = leafCost q)
    (hLeafToff : ∀ q wCtrlL hcL, (dLeaf q wCtrlL hcL).count .TOFF = 0) :
    ∀ (k : ℕ) (hk : k ≤ 9) (base Q : ℕ) (wCtrl : Wire n)
      (hc : IsTreeCtrlAt wRootCtrl rPool k wCtrl),
      1 ≤ Q → Q ≤ 2 ^ k →
      (wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
        hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
        dLeaf k hk base Q wCtrl hc).count .T =
        l26_wTreeRoutingT B_max k Q + l26_treeLeafCostSum leafCost k base Q ∧
      (wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
        hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
        dLeaf k hk base Q wCtrl hc).count .TOFF = 0
  | 0, _, base, Q, wCtrl, hc, _, _ => by
      dsimp only [wPrunedSubtreeDyn, l26_wTreeRoutingT, l26_treeLeafCostSum]
      rw [hLeafT, hLeafToff, zero_add]
      exact ⟨rfl, rfl⟩
  | m + 1, hm, base, Q, wCtrl, hc, hQ1, hQk => by
      dsimp only [wPrunedSubtreeDyn]
      by_cases hPow : Q = 2 ^ (m + 1) ∧ m + 1 ≤ B_max
      · rw [dite_eq_left hPow]
        obtain ⟨ht, hf⟩ := count_wPow2PhaseBlockDyn hBm (by omega) hPow.2 v base
          rIdx9 wRootCtrl wDum qEnc rPool hIdxPool hRootIdx hRootPool hRootDum hRootEnc
          hDumIdx hEncIdx hDumPool hEncPool hDumEnc wCtrl hc dLeaf leafCost hLeafT hLeafToff
        have hR : l26_wTreeRoutingT B_max (m + 1) Q = 2 * 2 ^ (m + 1) + 2 * (m + 1) - 2 := by
          dsimp only [l26_wTreeRoutingT]; rw [ite_eq_left hPow]
        rw [ht, hf, hR, hPow.1]
        exact ⟨rfl, rfl⟩
      · rw [dite_eq_right hPow]
        by_cases hle : Q ≤ 2 ^ m
        · rw [ite_eq_left hle]
          obtain ⟨ht, hf⟩ := count_wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
            hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
            dLeaf leafCost hLeafT hLeafToff m (Nat.le_of_succ_le hm) base Q wCtrl (hc.step hm)
            hQ1 hle
          have hR : l26_wTreeRoutingT B_max (m + 1) Q = l26_wTreeRoutingT B_max m Q := by
            dsimp only [l26_wTreeRoutingT]; rw [ite_eq_right hPow, ite_eq_left hle]
          have hL : l26_treeLeafCostSum leafCost (m + 1) base Q =
              l26_treeLeafCostSum leafCost m base Q := by
            dsimp only [l26_treeLeafCostSum]; rw [ite_eq_left hle]
          rw [ht, hf, hR, hL]
          exact ⟨rfl, rfl⟩
        · rw [ite_eq_right hle]
          have hpow1 : 1 ≤ 2 ^ m := Nat.one_le_two_pow
          have hsucc : 2 ^ (m + 1) = 2 ^ m + 2 ^ m := by ring
          let wMsb := rIdx9 ⟨m, hm⟩
          let wAnc := rPool ⟨8 - m, l26_pool_anc_lt hBm hm⟩
          have hCM : wCtrl ≠ wMsb := by
            rcases hc with rfl | ⟨j, _, rfl⟩
            · exact hRootIdx ⟨m, hm⟩
            · exact (hIdxPool.ne ⟨m, hm⟩ j).symm
          have hCA : wCtrl ≠ wAnc := by
            rcases hc with rfl | ⟨j, hj, rfl⟩
            · exact hRootPool _
            · exact rPool.wires.injective.ne (fun h ↦ by
                have hv := congrArg Fin.val h; dsimp at hv; omega)
          have hMA : wMsb ≠ wAnc := hIdxPool.ne ⟨m, hm⟩ _
          have hcAnc : IsTreeCtrlAt wRootCtrl rPool m wAnc :=
            Or.inr ⟨⟨8 - m, l26_pool_anc_lt hBm hm⟩, by dsimp; omega, rfl⟩
          obtain ⟨htB, hfB⟩ := count_l26_branchSplitDyn v wCtrl wMsb wAnc hCM hCA hMA
            (wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
              hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool
                hDumEnc
              dLeaf m (Nat.le_of_succ_le hm) base (2 ^ m) wAnc hcAnc)
            (wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
              hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool
                hDumEnc
              dLeaf m (Nat.le_of_succ_le hm) (base + 2 ^ m) (Q - 2 ^ m) wAnc hcAnc)
          obtain ⟨htL, hfL⟩ := count_wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
            hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
            dLeaf leafCost hLeafT hLeafToff m (Nat.le_of_succ_le hm) base (2 ^ m) wAnc hcAnc
            hpow1 le_rfl
          obtain ⟨htR, hfR⟩ := count_wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
            hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
            dLeaf leafCost hLeafT hLeafToff m (Nat.le_of_succ_le hm) (base + 2 ^ m) (Q - 2 ^ m)
            wAnc hcAnc (by omega) (by omega)
          have hR : l26_wTreeRoutingT B_max (m + 1) Q =
              4 + l26_wTreeRoutingT B_max m (2 ^ m) + l26_wTreeRoutingT B_max m (Q - 2 ^ m) := by
            dsimp only [l26_wTreeRoutingT]; rw [ite_eq_right hPow, ite_eq_right hle]
          have hL : l26_treeLeafCostSum leafCost (m + 1) base Q = l26_treeLeafCostSum leafCost
              m base (2 ^ m) + l26_treeLeafCostSum leafCost m (base + 2 ^ m) (Q - 2 ^ m) := by
            dsimp only [l26_treeLeafCostSum]; rw [ite_eq_right hle]
          rw [htB, hfB, htL, hfL, htR, hfR, hR, hL]
          exact ⟨by omega, rfl⟩
theorem idxValPrefix_slice9_eq {n B : ℕ} (hB : B ≤ 9) (rIdx9 : QRegister 9 n)
    (β : BitAssignment n) :
    ∀ (m : ℕ) (hm : m ≤ B),
      idxValPrefix (fun d : Fin B ↦ rIdx9 ⟨d.val, by omega⟩) β m hm =
        idxValPrefix rIdx9.wires β m (Nat.le_trans hm hB)
  | 0, _ => rfl
  | m + 1, hm => by
      dsimp only [idxValPrefix]
      rw [idxValPrefix_slice9_eq hB rIdx9 β m (Nat.le_of_succ_le hm)]
theorem idxValPrefix_upd_ne9 {n : ℕ} (rIdx9 : QRegister 9 n) (β : BitAssignment n)
    (w : Wire n) (val : ZMod 2) (hne : ∀ d : Fin 9, rIdx9 d ≠ w) :
    ∀ (k : ℕ) (hk : k ≤ 9),
      idxValPrefix rIdx9.wires (Function.update β w val) k hk = idxValPrefix rIdx9.wires β k hk
  | 0, _ => rfl
  | k + 1, hk => by
      dsimp only [idxValPrefix]
      rw [idxValPrefix_upd_ne9 rIdx9 β w val hne k (Nat.le_of_succ_le hk),
          Function.update_of_ne (hne ⟨k, hk⟩)]
theorem wPrunedSubtreeDyn_realizes {Var : Type} [Fintype Var] [DecidableEq Var]
    {n B_max : ℕ}
    (hBm : B_max ≤ 9) (v : Var)
    (P_ext : BitAssignment n → Prop)
    (rIdx9 : QRegister 9 n) (wRootCtrl wDum qEnc : Wire n)
    (rPool : QRegister ((9 - B_max) + 2 ^ B_max) n)
    (hIdxPool : rIdx9.DisjointWires rPool)
    (hRootIdx : ∀ d : Fin 9, wRootCtrl ≠ rIdx9 d)
    (hRootPool : ∀ j, wRootCtrl ≠ rPool j)
    (hRootDum : wRootCtrl ≠ wDum) (hRootEnc : wRootCtrl ≠ qEnc)
    (hDumIdx : ∀ d : Fin 9, wDum ≠ rIdx9 d)
    (hEncIdx : ∀ d : Fin 9, qEnc ≠ rIdx9 d)
    (hDumPool : ∀ j, wDum ≠ rPool j)
    (hEncPool : ∀ j, qEnc ≠ rPool j)
    (hDumEnc : wDum ≠ qEnc)
    (hExtRoot : ∀ β val, P_ext (Function.update β wRootCtrl val) ↔ P_ext β)
    (hExtPool : ∀ j β val, P_ext (Function.update β (rPool j) val) ↔ P_ext β)
    (dLeaf : (q : ℕ) → (wCtrlLeaf : Wire n) →
      IsTreeCtrlWire wRootCtrl rPool wCtrlLeaf → DynamicCircuit Var n)
    (leafPhase : ℕ → BitAssignment n → ZMod 2)
    (hPhaseRoot : ∀ q β val, leafPhase q (Function.update β wRootCtrl val) = leafPhase q β)
    (hPhasePool : ∀ q j β val, leafPhase q (Function.update β (rPool j) val) = leafPhase q β)
    (hLeafReal : ∀ q wCtrlL hcL,
      p2t_RealizesConstCleanUnitary
        (p2t_ketPredProj (fun β ↦ P_ext β ∧ β wDum = 0 ∧ β qEnc = 0))
        (dLeaf q wCtrlL hcL)
        (l26DiagUnitary (fun β ↦ β wCtrlL * leafPhase q β))) :
    ∀ (k : ℕ) (hk : k ≤ 9) (base Q : ℕ) (wCtrl : Wire n)
      (hc : IsTreeCtrlAt wRootCtrl rPool k wCtrl),
      1 ≤ Q → Q ≤ 2 ^ k →
      p2t_RealizesConstCleanUnitary
        (p2t_ketPredProj (SubtreeCleanPred P_ext wDum qEnc rPool k))
        (wPrunedSubtreeDyn hBm v rIdx9 wRootCtrl wDum qEnc rPool
          hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool hDumEnc
          dLeaf k hk base Q wCtrl hc)
        (l26DiagUnitary (fun β ↦
          β wCtrl * leafPhase (base + prunedEffIdx k Q (idxValPrefix rIdx9.wires β k hk)) β))
  | 0, hk, base, Q, wCtrl, hc, _, _ => by
      dsimp only [wPrunedSubtreeDyn]
      have h0 : l26DiagUnitary (fun β ↦
          β wCtrl * leafPhase (base + prunedEffIdx 0 Q (idxValPrefix rIdx9.wires β 0 hk)) β) =
          l26DiagUnitary (fun β ↦ β wCtrl * leafPhase base β) := by
        apply l26DiagUnitary_congr; intro β
        unfold prunedEffIdx
        rw [Nat.add_zero]
      rw [h0]
      exact p2t_RealizesConstCleanUnitary_mono_proj
        (p2t_ketPredProj_conjTranspose _) (p2t_ketPredProj_conjTranspose _)
        (p2t_ketPredProj_mul_imp fun _ h ↦ ⟨h.1, h.2.1, h.2.2.1⟩)
        (hLeafReal base wCtrl hc.toWire)
  | m + 1, hm, base, Q, wCtrl, hc, hQ1, hQk => by
      dsimp only [wPrunedSubtreeDyn]
      by_cases hPow : Q = 2 ^ (m + 1) ∧ m + 1 ≤ B_max
      · rw [dite_eq_left hPow]
        have hBlk := wPow2PhaseBlockDyn_realizes hBm (by omega) hPow.2 v base P_ext
          rIdx9 wRootCtrl wDum qEnc rPool hIdxPool hRootIdx hRootPool hRootDum hRootEnc
          hDumIdx hEncIdx hDumPool hEncPool hDumEnc hExtRoot hExtPool wCtrl hc dLeaf
          leafPhase hPhaseRoot hPhasePool hLeafReal
        refine p2t_RealizesConstCleanUnitary_congr_unitary
          (p2t_ketPredProj_conjTranspose _) hBlk ?_
        rw [l26DiagUnitary_congr (fun β ↦ ?_)]
        rw [idxValPrefix_slice9_eq hm rIdx9 β (m + 1) le_rfl, hPow.1,
            prunedEffIdx_eq_self (m + 1) (2 ^ (m + 1)) _ le_rfl
              (idxValPrefix_lt_two_pow rIdx9.wires β (m + 1) hm)]
      · rw [dite_eq_right hPow]
        let hm_le : m ≤ 9 := Nat.le_of_succ_le hm
        have hlt_sub : ∀ β, idxValPrefix rIdx9.wires β m hm_le < 2 ^ m :=
          fun β ↦ idxValPrefix_lt_two_pow rIdx9.wires β m hm_le
        have hstep_idx : ∀ β, idxValPrefix rIdx9.wires β (m + 1) hm = idxValPrefix rIdx9.wires
            β m hm_le + (β (rIdx9 ⟨m, hm⟩)).val * 2 ^ m :=
          fun β ↦ by dsimp only [idxValPrefix]; rw [l26_ite_eq_zmod2_val_mul]
        by_cases hle : Q ≤ 2 ^ m
        · rw [ite_eq_left hle]
          have ih := wPrunedSubtreeDyn_realizes hBm v P_ext
            rIdx9 wRootCtrl wDum qEnc rPool hIdxPool hRootIdx hRootPool hRootDum hRootEnc
            hDumIdx hEncIdx hDumPool hEncPool hDumEnc hExtRoot hExtPool dLeaf
            leafPhase hPhaseRoot hPhasePool hLeafReal m hm_le base Q wCtrl (hc.step hm) hQ1 hle
          have ih' := p2t_RealizesConstCleanUnitary_mono_proj
            (p2t_ketPredProj_conjTranspose _) (p2t_ketPredProj_conjTranspose _)
            (p2t_ketPredProj_mul_imp fun β (h : SubtreeCleanPred P_ext wDum qEnc rPool (m + 1) β) ↦
              ⟨h.1, h.2.1, h.2.2.1, fun j hj ↦ h.2.2.2 j (by omega)⟩) ih
          refine p2t_RealizesConstCleanUnitary_congr_unitary
            (p2t_ketPredProj_conjTranspose _) ih' ?_
          rw [l26DiagUnitary_congr (fun β ↦ ?_)]
          have hmod : idxValPrefix rIdx9.wires β (m + 1) hm % 2 ^ m =
              idxValPrefix rIdx9.wires β m hm_le := by
            rw [hstep_idx β]
            rcases bit_cases (β (rIdx9 ⟨m, hm⟩)) with hb | hb <;> rw [hb]
            · rw [ZMod.val_zero, zero_mul, add_zero, Nat.mod_eq_of_lt (hlt_sub β)]
            · rw [ZMod.val_one, one_mul, Nat.add_mod_right, Nat.mod_eq_of_lt (hlt_sub β)]
          have heff : prunedEffIdx (m + 1) Q (idxValPrefix rIdx9.wires β (m + 1) hm) =
              prunedEffIdx m Q (idxValPrefix rIdx9.wires β m hm_le) := by
            conv_lhs => unfold prunedEffIdx
            simp only [hle, ↓reduceIte, hmod]
          rw [heff]
        · rw [ite_eq_right hle]
          let wMsb := rIdx9 ⟨m, hm⟩
          let jAnc : Fin ((9 - B_max) + 2 ^ B_max) := ⟨8 - m, l26_pool_anc_lt hBm hm⟩
          let wAnc := rPool jAnc
          have hCM : wCtrl ≠ wMsb := by
            rcases hc with rfl | ⟨j, _, rfl⟩
            · exact hRootIdx ⟨m, hm⟩
            · exact (hIdxPool.ne ⟨m, hm⟩ j).symm
          have hCA : wCtrl ≠ wAnc := by
            rcases hc with rfl | ⟨j, hj, rfl⟩
            · exact hRootPool _
            · exact rPool.wires.injective.ne (fun h ↦ by
                have hv := congrArg Fin.val h; dsimp [jAnc] at hv; omega)
          have hMA : wMsb ≠ wAnc := hIdxPool.ne ⟨m, hm⟩ _
          have hcAnc : IsTreeCtrlAt wRootCtrl rPool m wAnc :=
            Or.inr ⟨jAnc, by dsimp [jAnc]; omega, rfl⟩
          have hdL := wPrunedSubtreeDyn_realizes hBm v P_ext rIdx9 wRootCtrl wDum qEnc rPool
              hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool
              hDumEnc hExtRoot hExtPool dLeaf leafPhase hPhaseRoot hPhasePool hLeafReal m
              hm_le base (2 ^ m) wAnc hcAnc Nat.one_le_two_pow le_rfl
          have hsucc : 2 ^ (m + 1) = 2 ^ m + 2 ^ m := by ring
          have hpow1 : 1 ≤ 2 ^ m := Nat.one_le_two_pow
          have hdR := wPrunedSubtreeDyn_realizes hBm v P_ext rIdx9 wRootCtrl wDum qEnc rPool
              hIdxPool hRootIdx hRootPool hRootDum hRootEnc hDumIdx hEncIdx hDumPool hEncPool
              hDumEnc hExtRoot hExtPool dLeaf leafPhase hPhaseRoot hPhasePool hLeafReal m
              hm_le (base + 2 ^ m) (Q - 2 ^ m) wAnc hcAnc (by omega) (by omega)
          have hSplit := l26_branchSplitDyn_realizes v wCtrl wMsb wAnc hCM hCA hMA
            (SubtreeCleanPred P_ext wDum qEnc rPool (m + 1))
            (SubtreeCleanPred P_ext wDum qEnc rPool m)
            (fun β hs ↦ hs.2.2.2 jAnc (by dsimp [jAnc]; omega))
            (fun β val hs ↦ ⟨(hExtPool jAnc β val).mpr hs.1,
              by rw [Function.update_of_ne (hDumPool jAnc)]; exact hs.2.1,
              by rw [Function.update_of_ne (hEncPool jAnc)]; exact hs.2.2.1,
              fun j hj ↦ by
                have hne : rPool j ≠ wAnc := rPool.wires.injective.ne (fun h ↦ by
                  have hv := congrArg Fin.val h; dsimp [jAnc] at hv; omega)
                rw [Function.update_of_ne hne]; exact hs.2.2.2 j (by omega)⟩)
            (fun γ val ↦ by
              dsimp only [SubtreeCleanPred]
              refine and_congr (hExtPool jAnc γ val) (and_congr ?_ (and_congr ?_ ?_))
              · rw [Function.update_of_ne (hDumPool jAnc)]
              · rw [Function.update_of_ne (hEncPool jAnc)]
              · refine forall_congr' fun j ↦ imp_congr_right fun hj ↦ ?_
                have hne : rPool j ≠ wAnc := rPool.wires.injective.ne (fun h ↦ by
                  have hv := congrArg Fin.val h; dsimp [jAnc] at hv; omega)
                rw [Function.update_of_ne hne])
            _ _
            (fun γ ↦
              leafPhase (base + prunedEffIdx m (2 ^ m) (idxValPrefix rIdx9.wires γ m hm_le)) γ)
            (fun γ ↦
              leafPhase ((base + 2 ^ m) + prunedEffIdx m (Q -
              2 ^ m) (idxValPrefix rIdx9.wires γ m hm_le)) γ)
            (fun γ val ↦ by
              rw [idxValPrefix_upd_ne9 rIdx9 γ wAnc val (fun d ↦ hIdxPool.ne d jAnc) m hm_le,
                  hPhasePool _ jAnc γ val])
            (fun γ val ↦ by
              rw [idxValPrefix_upd_ne9 rIdx9 γ wAnc val (fun d ↦ hIdxPool.ne d jAnc) m hm_le,
