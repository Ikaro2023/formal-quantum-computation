    ⟨96 + 2 * B + 1, by dsimp [mBAux]; omega⟩ false
    ⟨89 + B, by dsimp [mBAux]; omega⟩
    ⟨85, by dsimp [mBAux]; omega⟩
    ⟨0, by dsimp [mBAux]; omega⟩ true
    (wire_ne_of_gt (by dsimp; omega))
    (wire_ne_of_lt (by dsimp; omega))
    (wire_ne_of_lt (by dsimp; omega))
    (by dsimp; omega) (by dsimp; omega) (by dsimp; omega) (by dsimp; omega)
    (h3.cast_rem (by omega))
  have h1 := (ScopedBlock.withLitAnd_block (M := mBAux B)
    (96 + 2 * B + 1) (by dsimp [mBAux]; omega)
