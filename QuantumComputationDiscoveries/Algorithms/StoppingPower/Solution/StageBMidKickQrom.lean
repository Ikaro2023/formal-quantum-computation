          _ = (T_anc.1ᴴ * T_anc.1) * T_anc.1 := by rw [Matrix.mul_assoc]
          _ = T_anc.1 := by rw [unitary_coe_star_mul_self T_anc, Matrix.one_mul]
      have hT_star : star T_anc = T_anc := Subtype.ext hT_symm
      have hPreEq : ctxPreUnitary rComb (ctxMicroRun inW hin_inj cur hin_lt top hn (.andAlloc a b ::
        rest) hv hcur) =
