/-- Specification for `ctxCompAndTailB` on wires below `96 + B` and `(d6, d7)`. -/
def compAndTailBSpec (B : ℕ) (φ γ : BitAssignment (mBAux B)) (keepLt : ZMod 2) : Prop :=
  let s0 := γ ⟨0, by dsimp [mBAux]; omega⟩
  let rz := γ ⟨85, by dsimp [mBAux]; omega⟩
  let ih := γ ⟨36, by dsimp [mBAux]; omega⟩
  let d3 := γ ⟨95 + B, by dsimp [mBAux]; omega⟩
  let tSign := γ ⟨89 + B, by dsimp [mBAux]; omega⟩
  let d6 := (keepLt * (1 + d3)) * (1 + (tSign + rz + s0))
  (∀ w : Wire (mBAux B), w.val < 96 + B → φ w = γ w) ∧
  φ ⟨96 + 2 * B + 2, by dsimp [mBAux]; omega⟩ = d6 ∧
  φ ⟨96 + 2 * B + 3, by dsimp [mBAux]; omega⟩ = ih * (rz + d6)
theorem ctxCompAndTailB_scoped_of_wire (B : ℕ) (hB1 : 1 ≤ B) (hB27 : B ≤ 27)
    (q : Wire (mBAux B)) :
    ∃ sCT : BitAssignment (mBAux B) → BitAssignment (mBAux B),
      ScopedBlock (mBAux B) (B + 4) sCT (.z q) ((ctxCompAndTailB B hB1 hB27).plug (.z q)) ∧
      ∀ γ : BitAssignment (mBAux B), cleanRem (mBAux B) (B + 4) γ →
        compAndTailBSpec B (sCT γ) γ
          (if bitsVal (fun k : Fin 30 ↦ γ ⟨38 + k.val, by dsimp [mBAux]; omega⟩) <
              2 ^ (29 - B) + 2 ^ (30 - B) *
                bitsVal (fun j : Fin B ↦ γ ⟨89 + j.val, by dsimp [mBAux]; omega⟩)
           then 1 else 0) := by
  obtain ⟨sTail, hTail, hTailBelow, hTailD6, hTailD7⟩ := ctxTail3_spec B q
  obtain ⟨setupLt, hLt, hSpecLt⟩ :=
    ScopedBlock.withLtCompLoop_block (M := mBAux B) B (96 + B) (by dsimp [mBAux]; omega)
      (fun j ↦ ⟨38 + (30 - B) + j.val, by dsimp [mBAux]; omega⟩)
      (fun j ↦ ⟨89 + j.val, by dsimp [mBAux]; omega⟩)
      (fun j ↦ wire_ne_of_lt (by dsimp; omega))
      (fun j ↦ by dsimp; omega)
      (fun j ↦ by dsimp; omega)
      (.z q) ((ctxTail3 B).plug (.z q)) sTail
      (hTail.cast_rem (by dsimp [mBAux]; omega))
  have hPlug : (ctxCompAndTailB B hB1 hB27).plug (.z q) =
      withCliffAlloc (cInitPrev B hB1 hB27)
        (withLtCompLoop B (96 + B) (by dsimp [mBAux]; omega)
          (fun j ↦ ⟨38 + (30 - B) + j.val, by dsimp [mBAux]; omega⟩)
          (fun j ↦ ⟨89 + j.val, by dsimp [mBAux]; omega⟩)
          (fun j ↦ wire_ne_of_lt (by dsimp; omega))
          (fun j ↦ by dsimp; omega)
          (fun j ↦ by dsimp; omega)
          ((ctxTail3 B).plug (.z q))) := by
    simp only [ctxCompAndTailB, TempCtx.append_plug, ctxCliffAlloc_plug, mk34_ctxLtCompLoop_plug]
  have hSuppInit : (cInitPrev B hB1 hB27).SupportsBelow (mBAux B - (B + 3)) := by
    dsimp [cInitPrev, CliffProg.SupportsBelow, mBAux]
    exact ⟨by omega, by omega, by omega⟩
  have hBlock := ScopedBlock.withCliffAlloc_block (M := mBAux B)
    (rem := B + 4) (remIn := B + 3)
    (by dsimp [mBAux]; omega) (by omega)
    (cInitPrev B hB1 hB27) hSuppInit
    (hLt.cast_rem (by dsimp [mBAux]; omega))
  rw [← hPlug] at hBlock
  refine ⟨_, hBlock, fun γ hγ ↦ ?_⟩
  let γ₁ := (cInitPrev B hB1 hB27).eval γ
  have hγ₁_ne : ∀ w : Wire (mBAux B), w.val ≠ 96 + B → γ₁ w = γ w := fun w hw ↦ by
    dsimp only [γ₁, cInitPrev, CliffProg.eval]
    rw [Function.update_of_ne (fun h ↦ hw (congrArg Fin.val h)),
        Function.update_of_ne (fun h ↦ hw (congrArg Fin.val h))]
  have hγ₁_prev : γ₁ ⟨96 + B, by dsimp [mBAux]; omega⟩ =
      1 + γ ⟨38 + (29 - B), by dsimp [mBAux]; omega⟩ := by
    have h96 : γ ⟨96 + B, by dsimp [mBAux]; omega⟩ = 0 :=
      hγ _ (by dsimp [mBAux]; omega)
    dsimp only [γ₁, cInitPrev, CliffProg.eval]
    rw [Function.update_self, Function.update_self,
        Function.update_of_ne (wire_ne_of_lt (by dsimp; omega)), h96, zero_add]
  have hγ₁_clean : cleanRem (mBAux B) (mBAux B - ((96 + B) + 1)) γ₁ := fun w hw ↦ by
    rw [hγ₁_ne w (by dsimp [mBAux] at hw; omega)]
    exact hγ w (by dsimp [mBAux] at hw ⊢; omega)
  obtain ⟨_, hLtBelow, hLtCarry⟩ := hSpecLt γ₁ hγ₁_clean
  have hBelowAll : ∀ w : Wire (mBAux B), w.val < 96 + B → sTail (setupLt γ₁) w = γ w :=
      fun w hw ↦ (hTailBelow (setupLt γ₁) w (by omega)).trans
      ((hLtBelow w hw).trans (hγ₁_ne w (by omega)))
  have hCarryWire : (⟨96 + 2 * B, by dsimp [mBAux]; omega⟩ : Wire (mBAux B)) =
      ⟨(96 + B) + B, by dsimp [mBAux]; omega⟩ := Fin.ext (by dsimp; omega)
  have hA_eq : (fun j : Fin B ↦ γ₁ ⟨38 + (30 - B) + j.val, by dsimp [mBAux]; omega⟩) =
      (fun j : Fin B ↦ γ ⟨38 + ((30 - B) + j.val), by dsimp [mBAux]; omega⟩) :=
    funext fun j ↦ (hγ₁_ne _ (by dsimp; omega)).trans
      (congrArg γ (Fin.ext (by dsimp; omega)))
  have hB_eq : (fun j : Fin B ↦ γ₁ ⟨89 + j.val, by dsimp [mBAux]; omega⟩) =
      (fun j : Fin B ↦ γ ⟨89 + j.val, by dsimp [mBAux]; omega⟩) :=
    funext fun j ↦ hγ₁_ne _ (by dsimp; omega)
  have hIff : setupLt γ₁ ⟨96 + 2 * B, by dsimp [mBAux]; omega⟩ = 1 ↔
      bitsVal (fun k : Fin 30 ↦ γ ⟨38 + k.val, by dsimp [mBAux]; omega⟩) <
        2 ^ (29 - B) + 2 ^ (30 - B) *
          bitsVal (fun j : Fin B ↦ γ ⟨89 + j.val, by dsimp [mBAux]; omega⟩) := by
    rw [hCarryWire, hLtCarry, hA_eq, hB_eq, hγ₁_prev]
    exact mk34_midpoint_lt_iff B hB1 hB27
      (fun k : Fin 30 ↦ γ ⟨38 + k.val, by dsimp [mBAux]; omega⟩)
      (fun j : Fin B ↦ γ ⟨89 + j.val, by dsimp [mBAux]; omega⟩)
  have hKeepEq : setupLt γ₁ ⟨96 + 2 * B, by dsimp [mBAux]; omega⟩ =
      (if bitsVal (fun k : Fin 30 ↦ γ ⟨38 + k.val, by dsimp [mBAux]; omega⟩) <
          2 ^ (29 - B) + 2 ^ (30 - B) *
            bitsVal (fun j : Fin B ↦ γ ⟨89 + j.val, by dsimp [mBAux]; omega⟩)
       then 1 else 0) := by
    rcases zmod2_eq_zero_or_one (setupLt γ₁ ⟨96 + 2 * B, by dsimp [mBAux]; omega⟩) with hs | hs
    · have hnot : ¬ bitsVal (fun k : Fin 30 ↦ γ ⟨38 + k.val, by dsimp [mBAux]; omega⟩) <
          2 ^ (29 - B) + 2 ^ (30 - B) *
            bitsVal (fun j : Fin B ↦ γ ⟨89 + j.val, by dsimp [mBAux]; omega⟩) := by
        rw [← hIff, hs]; decide
      simp only [hs, hnot, ↓reduceIte]
    · have hyes := hIff.mp hs
      simp only [hs, hyes, ↓reduceIte]
  have hs0 : setupLt γ₁ ⟨0, by dsimp [mBAux]; omega⟩ = γ ⟨0, by dsimp [mBAux]; omega⟩ :=
    (hLtBelow _ (by dsimp; omega)).trans (hγ₁_ne _ (by dsimp; omega))
  have hrz : setupLt γ₁ ⟨85, by dsimp [mBAux]; omega⟩ = γ ⟨85, by dsimp [mBAux]; omega⟩ :=
    (hLtBelow _ (by dsimp; omega)).trans (hγ₁_ne _ (by dsimp; omega))
  have hih : setupLt γ₁ ⟨36, by dsimp [mBAux]; omega⟩ = γ ⟨36, by dsimp [mBAux]; omega⟩ :=
