    (v : Var) (rComb : QRegister M n)
    (inW : Fin nIn → Wire M) (hin_inj : Function.Injective inW)
    (cur : ℕ) (hin_lt : ∀ i, (inW i).val < cur)
    (p : TempPhaseProg M)
    (ops : List MicroOp) (top : ℕ) (hn : nIn ≤ top)
    (hv : microValid top ops = true)
    (hcur : cur + (top - nIn) + microAllocs ops ≤ M)
    (hv_p : ValidCleanRem M (M - (cur + (top - nIn) + microAllocs ops)) p) :
    let K := ctxMicroRun inW hin_inj cur hin_lt top hn ops hv hcur
    let U_pre := ctxPreUnitary rComb K
    let U_plug := (((K.plug p).onRegister rComb).toToffCircuit).eval
    let rem₁ := M - (cur + (top - nIn) + microAllocs ops)
    RealizesCleanUnitary v (projZeroAll rem₁ (tailScr rComb rem₁ (by omega)))
      ((p.onRegister rComb).toDyn v)
      (U_pre * U_plug * star U_pre) := by
  intro K U_pre U_plug rem₁
  have hR := realizes_of_validCleanRem v rComb p rem₁ (by omega) hv_p
  have hEq := ctxMicroRun_plug_eval_eq rComb inW hin_inj cur hin_lt p ops top hn hv hcur
  change U_plug = star U_pre * ((p.onRegister rComb).toToffCircuit).eval * U_pre at hEq
  have hU_mul_star : U_pre * star U_pre = 1 := Subtype.ext (unitary_coe_mul_star_self U_pre)
  have hU_eq : U_pre * U_plug * star U_pre = ((p.onRegister rComb).toToffCircuit).eval := by
    rw [hEq]
    calc U_pre * (star U_pre * ((p.onRegister rComb).toToffCircuit).eval * U_pre) * star U_pre
        = (U_pre * star U_pre) * ((p.onRegister rComb).toToffCircuit).eval * (U_pre * star U_pre) :=
          by
            simp only [mul_assoc]
      _ = ((p.onRegister rComb).toToffCircuit).eval := by
            rw [hU_mul_star, one_mul, mul_one]
  rwa [hU_eq]
def conjProj {n : ℕ} (W : Unitary (2 ^ n)) (P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) :
    Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ :=
  W.1 * P * W.1ᴴ
def conjUnit {n : ℕ} (W U : Unitary (2 ^ n)) : Unitary (2 ^ n) :=
  W * U * star W
theorem conjProj_herm {n : ℕ} (W : Unitary (2 ^ n)) {P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hP : Pᴴ = P) : (conjProj W P)ᴴ = conjProj W P :=
  conj_hermitian hP W
theorem conjProj_sub {n : ℕ} (W : Unitary (2 ^ n))
    {P₁ P₂ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (hsub : P₁ * P₂ = P₂) :
    conjProj W P₁ * conjProj W P₂ = conjProj W P₂ := by
  dsimp [conjProj]
  calc (W.1 * P₁ * W.1ᴴ) * (W.1 * P₂ * W.1ᴴ)
      = W.1 * P₁ * (W.1ᴴ * W.1) * P₂ * W.1ᴴ := by simp only [Matrix.mul_assoc]
    _ = W.1 * (P₁ * P₂) * W.1ᴴ := by
      rw [unitary_coe_star_mul_self W, Matrix.mul_one]; simp only [Matrix.mul_assoc]
    _ = W.1 * P₂ * W.1ᴴ := by rw [hsub]
theorem conjUnit_pres {n : ℕ} (W U : Unitary (2 ^ n))
    {P₁ P₂ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hpres : P₂ * (U.1 * P₁) = U.1 * P₁) :
    conjProj W P₂ * ((conjUnit W U).1 * conjProj W P₁) = (conjUnit W U).1 * conjProj W P₁ := by
  change (W.1 * P₂ * W.1ᴴ) * ((W.1 * U.1 * W.1ᴴ) * (W.1 * P₁ * W.1ᴴ)) =
    (W.1 * U.1 * W.1ᴴ) * (W.1 * P₁ * W.1ᴴ)
  calc (W.1 * P₂ * W.1ᴴ) * ((W.1 * U.1 * W.1ᴴ) * (W.1 * P₁ * W.1ᴴ))
      = W.1 * P₂ * (W.1ᴴ * W.1) * U.1 * (W.1ᴴ * W.1) * P₁ * W.1ᴴ := by simp only [Matrix.mul_assoc]
    _ = W.1 * (P₂ * (U.1 * P₁)) * W.1ᴴ := by
          rw [unitary_coe_star_mul_self W, Matrix.mul_one,
            Matrix.mul_one]; simp only [Matrix.mul_assoc]
    _ = W.1 * (U.1 * P₁) * W.1ᴴ := by rw [hpres]
    _ = W.1 * U.1 * (W.1ᴴ * W.1) * P₁ * W.1ᴴ := by
          rw [unitary_coe_star_mul_self W, Matrix.mul_one]; simp only [Matrix.mul_assoc]
    _ = (W.1 * U.1 * W.1ᴴ) * (W.1 * P₁ * W.1ᴴ) := by simp only [Matrix.mul_assoc]
theorem conjUnit_mul {n : ℕ} (W U₂ U₁ : Unitary (2 ^ n)) :
    conjUnit W U₂ * conjUnit W U₁ = conjUnit W (U₂ * U₁) := by
  apply Subtype.ext
  change W.1 * U₂.1 * W.1ᴴ * (W.1 * U₁.1 * W.1ᴴ) = W.1 * (U₂.1 * U₁.1) * W.1ᴴ
  calc W.1 * U₂.1 * W.1ᴴ * (W.1 * U₁.1 * W.1ᴴ)
      = W.1 * U₂.1 * (W.1ᴴ * W.1) * U₁.1 * W.1ᴴ := by simp only [Matrix.mul_assoc]
    _ = W.1 * (U₂.1 * U₁.1) * W.1ᴴ := by
      rw [unitary_coe_star_mul_self W, Matrix.mul_one]; simp only [Matrix.mul_assoc]
theorem conjUnit_congr {n : ℕ} (W U₁ U₂ : Unitary (2 ^ n))
    {P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (heq : U₁.1 * P = U₂.1 * P) :
    (conjUnit W U₁).1 * conjProj W P = (conjUnit W U₂).1 * conjProj W P := by
  change (W.1 * U₁.1 * W.1ᴴ) * (W.1 * P * W.1ᴴ) = (W.1 * U₂.1 * W.1ᴴ) * (W.1 * P * W.1ᴴ)
  calc (W.1 * U₁.1 * W.1ᴴ) * (W.1 * P * W.1ᴴ)
      = W.1 * U₁.1 * (W.1ᴴ * W.1) * P * W.1ᴴ := by simp only [Matrix.mul_assoc]
    _ = W.1 * (U₁.1 * P) * W.1ᴴ := by
      rw [unitary_coe_star_mul_self W, Matrix.mul_one]; simp only [Matrix.mul_assoc]
    _ = W.1 * (U₂.1 * P) * W.1ᴴ := by rw [heq]
    _ = W.1 * U₂.1 * (W.1ᴴ * W.1) * P * W.1ᴴ := by
          rw [unitary_coe_star_mul_self W, Matrix.mul_one]; simp only [Matrix.mul_assoc]
    _ = (W.1 * U₂.1 * W.1ᴴ) * (W.1 * P * W.1ᴴ) := by simp only [Matrix.mul_assoc]
theorem star_mul_conjUnit_mul {n : ℕ} (W U : Unitary (2 ^ n)) :
    star W * conjUnit W U * W = U := by
  apply Subtype.ext
  change W.1ᴴ * (W.1 * U.1 * W.1ᴴ) * W.1 = U.1
  calc W.1ᴴ * (W.1 * U.1 * W.1ᴴ) * W.1
      = (W.1ᴴ * W.1) * U.1 * (W.1ᴴ * W.1) := by simp only [Matrix.mul_assoc]
    _ = U.1 := by rw [unitary_coe_star_mul_self W, Matrix.one_mul, Matrix.mul_one]
theorem realizes_conj_of_comm
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (W U : Unitary (2 ^ n))
    {P₀ P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hP₀ : P₀ᴴ = P₀) (hP : Pᴴ = P)
    (d : DynamicCircuit Var n)
    (hR : RealizesCleanUnitary v P₀ d U)
    (hSub : P₀ * (W.1 * P) = W.1 * P)
    (hComm : U.1 * (W.1 * P) = W.1 * (U.1 * P)) :
    RealizesCleanUnitary v (conjProj W P) d (conjUnit W U) := by
  have hSub' : P₀ * conjProj W P = conjProj W P := by
    dsimp [conjProj]
