@[local simp]
theorem pLoadMK108_countTempAnd (K H : ℕ) (hH54 : H ≤ 54) (c : Configuration) (w : Fin 3) :
    (pLoadMK108 K H hH54 c w).countTempAnd = (54 - H) + K := by
  rw [pLoadMK108, vepLockVal_eq, leafLoadMK108, vepLockVal_eq]
