    · have hp_lt := p.isLt; have hb_lt := b.isLt
      have hne0 : wBlock5 rU108 b p ≠ rU108 0 := rU108.wires.injective.ne (by
        intro h;
        have hv :=
          congrArg Fin.val h; dsimp [wBlock5] at hv; omega)
      have hne32 : wBlock5 rU108 b p ≠ rU108 32 := rU108.wires.injective.ne (by
