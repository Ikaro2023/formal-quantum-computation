theorem realizesCleanUnitary_dComp17_sub {Var : Type} [Fintype Var] [DecidableEq Var]
    {n mScr : ℕ} [NeZero (2 ^ n)] (hm20 : 20 ≤ mScr) (v : Var)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) : RealizesCleanUnitary v
    (projZeroAll (mScr - 3) (rSubAux hm20 rScr).wires)
    (dComp17 hm20 v rCore rScr hCS) (cComp17 hm20 rCore rScr hCS).eval := by
  let P := projZeroAll (mScr - 3) (rSubAux hm20 rScr).wires
  have hP : Pᴴ = P := projZeroAll_conjTranspose (mScr - 3) _
  let rComb := rComb106 hm20 rCore rScr hCS
  have hpv : ValidCleanRem 106 17 (ctxComp17.plug (.z ⟨0, by decide⟩)) := by
    rw [pComp17_eq]
    exact pComp17_valid_and_bits.1
  have hInner17 : RealizesCleanUnitary v (projZeroAll 17 (rSub17 hm20 rScr).wires)
      (dComp17Inner hm20 v rCore rScr hCS) (cComp17Inner hm20 rCore rScr hCS).eval := by
    have hTail := tailScr_rComb106 hm20 rCore rScr hCS
    have h0 := mk34_realizesCleanUnitary_ctxToDyn v rComb (cLeafComp17On rComb)
      fLeafComp17 (cLeafComp17On_eval_mbh_ket rComb)
      ⟨0, by decide⟩ ctxComp17 17 (by decide) hpv
    rw [hTail] at h0
    exact h0
  have hInnerSub : RealizesCleanUnitary v P
      (dComp17Inner hm20 v rCore rScr hCS) (cComp17Inner hm20 rCore rScr hCS).eval :=
    RealizesCleanUnitary.mono_proj (projZeroAll_conjTranspose 17 _) hP
      (projZeroAll_slice_sub hm20 rScr 17 (by omega)) hInner17
  have hH_disj : ∀ i : Fin 3, ∀ j : Fin (mScr - 3), rHold3Aux hm20 rScr i ≠ rSubAux
      hm20 rScr j := fun i j ↦ (rHold3_disjoint_rSub hm20 rScr).ne i j
  have hH_real : RealizesCleanUnitary v P (.circuit (hadamardReg (rHold3Aux hm20 rScr)))
      (hadamardReg (rHold3Aux hm20 rScr)).eval := RealizesCleanUnitary.circuit v P _
  have hH_pres : P * ((hadamardReg (rHold3Aux hm20 rScr)).eval.1 * P) =
      (hadamardReg (rHold3Aux hm20 rScr)).eval.1 * P :=
    mk34_hadamardReg_preserves_projZeroAll (rHold3Aux hm20 rScr) (rSubAux hm20 rScr).wires hH_disj
  have hInner_pres : P * ((cComp17Inner hm20 rCore rScr hCS).eval.1 * P) =
      (cComp17Inner hm20 rCore rScr hCS).eval.1 * P :=
    cComp17Inner_preserves_sub hm20 rCore rScr hCS
  have h23_seq := RealizesCleanUnitary.seq hP hInnerSub hH_real hInner_pres
  have h123_seq := RealizesCleanUnitary.seq hP hH_real h23_seq hH_pres
  have hU_eq : ((hadamardReg (rHold3Aux hm20 rScr)).eval * (cComp17Inner hm20 rCore
      rScr hCS).eval) * (hadamardReg (rHold3Aux hm20 rScr)).eval =
      (cComp17 hm20 rCore rScr hCS).eval := by
    simp [cComp17, Circuit.eval_seq, mul_assoc]
  dsimp only [dComp17]
  rwa [hU_eq] at h123_seq
theorem cComp17_preserves_sub {n mScr : ℕ} (hm20 : 20 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) :
    let P := projZeroAll (mScr - 3) (rSubAux hm20 rScr).wires
