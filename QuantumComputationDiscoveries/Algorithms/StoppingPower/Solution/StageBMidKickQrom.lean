-- Masked core 218-entry one-hot chunk phase sum evaluation
theorem pMaskedCoreChunk_eval_true {n mScr : ℕ} (hm172 : 172 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr)
    (k N base dIdx : ℕ) (hk : k ≤ 7) (hN : N ≤ 2 ^ k) (hBase : base + N ≤ 218) (hd : dIdx < 5)
    (β δ : BitAssignment n) (u : ℕ)
    (h15_1 : δ (rScr ⟨15, by omega⟩) = 1)
    (hδ_core : ∀ i : Fin posCoreWires, δ (rCore i) = β (rCore i))
    (hMaskIff : ∀ i : Fin N,
      (optOneHotBits (fun d : Fin k ↦ rAnchorIdx rCore ⟨d.val, by omega⟩)
        (fun p : Fin (2 ^ k) ↦ rScr ⟨27 + p.val, by
          have := p.isLt;
          have :=
            pow2_le_128_of_le_7 hk; omega⟩)
        (rScr ⟨20 + dIdx, by omega⟩) δ)
        (rScr ⟨27 + i.val, by
          have := Nat.lt_of_lt_of_le i.isLt hN;
          have :=
            pow2_le_128_of_le_7 hk; omega⟩) = 0 ↔
      base + i.val ≠ u) :
    pMaskedCoreChunk hm172 rCore rScr k N base dIdx hk hN hBase hd δ =
      ((Finset.univ.filter fun i : Fin N ↦ decide (base + i.val ≠ u)).card : ZMod 8) *
        (if β (wHeadThresh rCore) = 0 then 7 else 1) +
      ((Finset.univ.filter fun i : Fin N ↦
        decide (base + i.val ≠ u ∧ ∀ q : Fin 18, β (rElecSlot rCore ⟨base + i.val, by
          omega⟩ q) = 0)).card : ZMod 8) *
        (2 + (if β (wHeadThresh rCore) = 1 then 4 else 0)) := by
  have hScrNe : ∀ (a b : ℕ) (ha : a < mScr) (hb : b < mScr), a ≠ b → rScr ⟨a, ha⟩ ≠ rScr ⟨b, hb⟩ :=
    fun a b _ _ h heq ↦ h (congrArg Fin.val (rScr.wires.injective heq))
  have h2k := pow2_le_128_of_le_7 hk
  let uLo : Fin k → Wire n := fun d ↦ rAnchorIdx rCore ⟨d.val, by omega⟩
  let wOut : Fin (2 ^ k) → Wire n := fun p ↦ rScr ⟨27 + p.val, by have := p.isLt; omega⟩
  let rDum : Wire n := rScr ⟨20 + dIdx, by omega⟩
  let γc := optOneHotBits uLo wOut rDum δ
  have hγc_15 : γc (rScr ⟨15, by omega⟩) = 1 := by
    dsimp only [γc, optOneHotBits]; split_ifs
    · rw [Function.update_of_ne (hScrNe 15 _ _ _ (by omega)), h15_1]
    · exact h15_1
  have hγc_th : γc (wHeadThresh rCore) = β (wHeadThresh rCore) := by
    have hThCore : wHeadThresh rCore = rCore (wHeadThresh (QRegExt.ofFin posCoreWires)) := rfl
    dsimp only [γc, optOneHotBits]; split_ifs
    · rw [Function.update_of_ne (wHeadThresh_ne_scr rCore rScr hCS _), hThCore, hδ_core _]
    · rw [hThCore, hδ_core _]
  have hγc_elec : ∀ (e : Fin 218) (q : Fin 18),
    γc (rElecSlot rCore e q) = β (rElecSlot rCore e q) := by
    intro e q
    have hEC : rElecSlot rCore e q = rCore (rElecSlot (QRegExt.ofFin posCoreWires) e q) := rfl
    dsimp only [γc, optOneHotBits]; split_ifs
    · rw [Function.update_of_ne (rElecSlot_ne_rScr rCore rScr hCS e q _), hEC, hδ_core _]
    · rw [hEC, hδ_core _]
  let b0 : ZMod 8 := if β (wHeadThresh rCore) = 0 then 7 else 1
  let tv : ZMod 8 := 2 + (if β (wHeadThresh rCore) = 1 then 4 else 0)
  have hTerm : ∀ i : Fin N,
      leafMod4XorMaskZ8 (γc (rScr ⟨15, by omega⟩))
        (γc (rScr ⟨27 + i.val, by have := Nat.lt_of_lt_of_le i.isLt hN; omega⟩))
        (γc (wHeadThresh rCore))
        (slotHitBit
          (rElecSlot rCore ⟨base + i.val, by omega⟩ ⟨16, by decide⟩)
          (rElecSlot rCore ⟨base + i.val, by omega⟩ ⟨17, by decide⟩)
          (fun j : Fin 16 ↦ rElecSlot rCore ⟨base + i.val, by omega⟩ ⟨j.val, by omega⟩)
          (fun _ ↦ false) γc) =
      (if decide (base + i.val ≠ u) = true then (1 : ZMod 8) else 0) * b0 +
      (if decide (base + i.val ≠ u ∧ ∀ q : Fin 18, β (rElecSlot rCore ⟨base + i.val, by
        omega⟩ q) = 0) = true
        then (1 : ZMod 8) else 0) * tv := by
    intro i
    rw [hγc_15, hγc_th]
    let m_i := γc (rScr ⟨27 + i.val, by have := Nat.lt_of_lt_of_le i.isLt hN; omega⟩)
    let hit_i := slotHitBit
      (rElecSlot rCore ⟨base + i.val, by omega⟩ ⟨16, by decide⟩)
      (rElecSlot rCore ⟨base + i.val, by omega⟩ ⟨17, by decide⟩)
      (fun j : Fin 16 ↦ rElecSlot rCore ⟨base + i.val, by omega⟩ ⟨j.val, by omega⟩)
      (fun _ ↦ false) γc
    change leafMod4XorMaskZ8 1 m_i (β (wHeadThresh rCore)) hit_i = _
    have hHitIff : hit_i = 1 ↔ ∀ q : Fin 18, β (rElecSlot rCore ⟨base + i.val, by omega⟩ q) = 0 :=
      by
      dsimp only [hit_i]
      rw [slotHitBit_false_eq_one_iff,
          hγc_elec ⟨base + i.val, by omega⟩ ⟨16, by decide⟩,
          hγc_elec ⟨base + i.val, by omega⟩ ⟨17, by decide⟩]
      constructor
      · rintro ⟨h16, h17, hm⟩ q
        by_cases hq17 : q.val = 17
        · rwa [show q = ⟨17, by decide⟩ from Fin.ext hq17]
        · by_cases hq16 : q.val = 16
          · rwa [show q = ⟨16, by decide⟩ from Fin.ext hq16]
          · have hqlt : q.val < 16 := by have := q.isLt; omega
            have hmj := hm ⟨q.val, hqlt⟩
            rwa [hγc_elec] at hmj
      · intro hall
        exact ⟨hall ⟨16, by decide⟩, hall ⟨17, by decide⟩,
          fun j ↦ by rw [hγc_elec]; exact hall ⟨j.val, by omega⟩⟩
    by_cases hne : base + i.val ≠ u
    · have hm0 : m_i = 0 := (hMaskIff i).mpr hne
      rw [hm0, leafMod4XorMaskZ8_one_zero, decide_eq_true hne]; simp only [↓reduceIte, one_mul]
      by_cases hall : ∀ q : Fin 18, β (rElecSlot rCore ⟨base + i.val, by omega⟩ q) = 0
      · rw [decide_eq_true (hHitIff.mpr hall), decide_eq_true ⟨hne, hall⟩]
      · rw [decide_eq_false (mt hHitIff.mp hall),
            decide_eq_false (fun h : base + i.val ≠ u ∧ _ ↦ hall h.2)]
    · have hm1 : m_i = 1 := by
        rcases bit_cases m_i with h0 | h1
        · exact False.elim (hne ((hMaskIff i).mp h0))
        · exact h1
      rw [hm1, leafMod4XorMaskZ8_one_one, decide_eq_false hne,
          decide_eq_false (fun h : base + i.val ≠ u ∧ _ ↦ hne h.1)]
      simp
  dsimp only [pMaskedCoreChunk]
  change (∑ i : Fin N, leafMod4XorMaskZ8 (γc (rScr ⟨15, by omega⟩)) _ _ _) = _
  rw [Finset.sum_congr rfl fun i _ ↦ hTerm i, Finset.sum_add_distrib,
      ← Finset.sum_mul, ← Finset.sum_mul, Finset.sum_boole, Finset.sum_boole]
theorem pAnchorSlotAccum_eval_true {n mScr : ℕ} (hm172 : 172 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rAnchor18 : QRegister 18 n) (rScr : QRegister mScr n)
    (hCA : rCore.DisjointWires rAnchor18)
    (β δ : BitAssignment n)
    (h15_1 : δ (rScr ⟨15, by omega⟩) = 1)
    (h25_0 : δ (rScr ⟨25, by omega⟩) = 0)
    (hδ_core : ∀ i : Fin posCoreWires, δ (rCore i) = β (rCore i))
    (hδ_anc : ∀ q : Fin 18, δ (rAnchor18 q) = β (rAnchor18 q)) :
    pAnchorSlotAccum hm172 rCore rAnchor18 rScr δ =
      ((2 : ZMod 8) + (if β (wHeadThresh rCore) = 1 then 4 else 0) +
        (if β (wSlot0Core rCore) = 1 then 4 else 0)) +
      ((if β (wHeadThresh rCore) = 0 then (7 : ZMod 8) else 1) +
        anchorSlotHitZ8 (fun j ↦ β ((rCore.concat rAnchor18 hCA) j)) *
          (2 + (if β (wHeadThresh rCore) = 1 then 4 else 0))) := by
  let rCA := rCore.concat rAnchor18 hCA
  have hrCA_data : ∀ i : Fin posCoreWires, rCA (selDataInAct posCoreWires i) = rCore i :=
    fun i ↦ congrArg (fun r ↦ r i) (concat_compose_selDataInAct rCore rAnchor18 hCA)
  have hrCA_meas : ∀ q : Fin 18, rCA (selMeasInAct posCoreWires q) = rAnchor18 q :=
    fun q ↦ congrArg (fun r ↦ r q) (concat_compose_selMeasInAct rCore rAnchor18 hCA)
  have hs0Eq : wSlot0Core rCore = rCore (wSlot0Core (QRegExt.ofFin posCoreWires)) := rfl
  have hthEq : wHeadThresh rCore = rCore (wHeadThresh (QRegExt.ofFin posCoreWires)) := rfl
  have hHitIff : slotHitBit (wSlot0Core rCore) (rAnchor18 ⟨17, by decide⟩)
        (fun j : Fin 17 ↦ rAnchor18 ⟨j.val, by omega⟩) (fun _ ↦ false) δ = 1 ↔
      (β (wSlot0Core rCore) = 0 ∧ ∀ q : Fin 18, β (rCA (selMeasInAct posCoreWires q)) = 0) := by
    rw [slotHitBit_false_eq_one_iff,
        hs0Eq, hδ_core (wSlot0Core (QRegExt.ofFin posCoreWires)), ← hs0Eq,
        hδ_anc ⟨17, by decide⟩]
    constructor
    · rintro ⟨hs0, h17, hm⟩
      refine ⟨hs0, fun q ↦ ?_⟩
      rw [hrCA_meas q]
      by_cases hq17 : q.val = 17
      · rwa [show q = ⟨17, by decide⟩ from Fin.ext hq17]
      · have hqlt : q.val < 17 := by have := q.isLt; omega
        simpa [hδ_anc] using hm ⟨q.val, hqlt⟩
    · rintro ⟨hs0, hall⟩
      exact ⟨hs0, by simpa [hrCA_meas] using hall ⟨17, by decide⟩,
        fun j ↦ by rw [hδ_anc]; simpa [hrCA_meas] using hall ⟨j.val, by omega⟩⟩
  have hHitZ8 : (if decide (slotHitBit (wSlot0Core rCore) (rAnchor18 ⟨17, by decide⟩)
          (fun j : Fin 17 ↦ rAnchor18 ⟨j.val, by omega⟩) (fun _ ↦ false) δ = 1)
        then (1 : ZMod 8) else 0) =
      anchorSlotHitZ8 (fun j ↦ β (rCA j)) := by
    unfold anchorSlotHitZ8
    dsimp only
    have hs0CA : (fun j ↦
      β (rCA j)) (wSlot0Core (selDataInAct posCoreWires)) = β (wSlot0Core rCore) := by
      dsimp only [wSlot0Core]; rw [hrCA_data]
    have hCondIff : ((fun j ↦ β (rCA j)) (wSlot0Core (selDataInAct posCoreWires)) = 0 ∧
        ∀ q : Fin 18, (fun j ↦ β (rCA j)) (selMeasInAct posCoreWires q) = 0) ↔
        (β (wSlot0Core rCore) = 0 ∧ ∀ q : Fin 18, β (rCA (selMeasInAct posCoreWires q)) = 0) := by
      rw [hs0CA]
    by_cases hCond : β (wSlot0Core rCore) = 0 ∧ ∀ q : Fin 18,
      β (rCA (selMeasInAct posCoreWires q)) = 0
    · rw [ite_true_eq (hCondIff.mpr hCond), decide_eq_true (hHitIff.mpr hCond)]; rfl
    · rw [ite_false_eq (mt hCondIff.mp hCond), decide_eq_false (mt hHitIff.mp hCond)]; rfl
  have hIte4 : ∀ x : ZMod 2, (if x = 0 then (0 : ZMod 8) else 4) = if x = 1 then 4 else 0 := by
    intro x; fin_cases x <;> decide
  dsimp only [pAnchorSlotAccum, pDiagDecode218]
