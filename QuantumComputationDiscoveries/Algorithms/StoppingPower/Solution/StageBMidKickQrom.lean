theorem vPeb_ket_of_scr0_gen {n mPayload mWB : ℕ}
    (hmPay : 80 ≤ mPayload) (p : List DecStep)
    (hend : progEndCur 61 p ≤ 61 + 106) (hwf : progWellFormed 61 p = true)
    (hWB : 114 ≤ mWB)
    (rCore : QRegister (fullSysCoreWires mPayload) n)
    (rWB : QRegister mWB n) (hCW : rCore.DisjointWires rWB)
    (β : BitAssignment n)
    (hscr0 : ∀ s : Fin (mWB - 8), β ((rWB.slice 8 (mWB - 8) (by omega)) s) = 0) :
    let rComb := rCombPeb rCore rWB hWB hCW
    let cPebCliff := cliffOfProgGen hmPay 8 106 p 61 hend hwf
    let C_inv := (((cPebCliff.inv).onRegister rComb).toCircuit).eval
    let U_p := (progFwdCircuit hmPay rComb p 61 le_rfl hend hwf).eval
    (C_inv.1 * U_p.1).mulVec (ket β) = ket (pebBitFnGen hmPay p hWB rCore rWB β) := by
  intro rComb cPebCliff C_inv U_p
  let C := fullSysCoreWires mPayload
  have hC := core_lo_4034 hmPay
  let KPeb := listToCtxGen hmPay 8 106 p 61 le_rfl hend hwf
  let γ₀ : BitAssignment (C + 8 + 106) := fun idx ↦ β (rComb idx)
  have hcl₀ : Internal.cleanRem (C + 8 + 106) ((C + 8 + 106) - (C + 8 + (61 - 61))) γ₀ := by
    intro w hw
    let k : Fin 106 := ⟨w.val - (C + 8), by omega⟩
    have hwk : w = ⟨C + 8 + k.val, by omega⟩ := Fin.ext (by dsimp [k]; omega)
    dsimp only [γ₀]
    rw [hwk, rCombPeb_cln106]
    exact hscr0 ⟨k.val, by omega⟩
  obtain ⟨hmut_inv, hbits_inv⟩ := cliffOfProgGen_inv_eval hmPay p 61 le_rfl
    hend hwf γ₀ hcl₀ (KPeb.fwdBits γ₀) (fun _ _ ↦ rfl)
  obtain ⟨_, hspPeb, _⟩ := listToCtxGen_correct (off := 8) (mClean := 106)
    hmPay p 61 le_rfl hend hwf
  have hDisjOutCtx := listToCtxGen_disj_outsideDec61 (off := 8) (mClean := 106)
    hmPay p 61 le_rfl hend hwf
  have hDisjOutCliff := cliffOfProgGen_disj_outsideDec61 (off := 8) (mClean := 106)
    hmPay p 61 hend hwf
  have hst_eq : bitsOfAssignGen hmPay 8 106 γ₀ = stHighCore hmPay rCore β := by
    funext w
    by_cases hw61 : w < 61
    · have hwB : w < 61 + 106 := by omega
      have hrc : rComb (decWireGen hmPay 8 106 w hwB) =
          rCore ⟨decWireNum C w, decWireNum_lt_core hC hw61⟩ := by
        have hdw : decWireGen hmPay 8 106 w hwB =
            ⟨(⟨decWireNum C w, decWireNum_lt_core hC hw61⟩ : Fin C).val, by
              have := decWireNum_lt_core hC hw61; omega⟩ :=
          Fin.ext (decWireNumGen_lt_61 hw61)
        rw [hdw]
        exact rCombPeb_lt_core rCore rWB hWB hCW _
      simp [bitsOfAssignGen, stHighCore, hw61, hwB, γ₀, hrc, C]
    · by_cases hwB : w < 61 + 106
      · have hz : γ₀ (decWireGen hmPay 8 106 w hwB) = 0 := by
          apply hcl₀
          dsimp [decWireGen, decWireNumGen]; split_ifs <;> omega
        simp [bitsOfAssignGen, stHighCore, hw61, hwB, hz]
      · simp [bitsOfAssignGen, stHighCore, hw61, hwB]
  rw [Internal.mul_mulVec_prog]
  dsimp only [U_p, C_inv]
  rw [progFwdCircuit_ket, cliffProg_onRegister_ket]
  have hreg : (fun idx ↦ Internal.writeRegProg β rComb (KPeb.fwdBits γ₀) (rComb idx)) =
      KPeb.fwdBits γ₀ := funext fun idx ↦ Internal.writeRegProg_apply_reg _ _ _ idx
  rw [hreg, writeRegProg_idem]
  apply congrArg ket
  have hγ_out : ∀ u : Wire (C + 8 + 106), cPebCliff.inv.eval (KPeb.fwdBits γ₀) u = if h : C +
      8 ≤ u.val then if rawPebble p 61 (stHighCore hmPay rCore β) (61 + (u.val - (C + 8)))
      then 1 else 0 else γ₀ u := by
    intro u
    by_cases hge : C + 8 ≤ u.val
    · rw [Internal.dite_true_eq hge]
      let m : ℕ := u.val - (C + 8)
      have hm : 61 + m < 61 + 106 := by dsimp [m]; omega
      have hu_eq : u = decWireGen hmPay 8 106 (61 + m) hm := by
        apply Fin.ext
        dsimp [decWireGen, decWireNumGen, m]
        split_ifs <;> omega
      rw [congrArg (cPebCliff.inv.eval (KPeb.fwdBits γ₀)) hu_eq]
      have hb := hbits_inv (61 + m) hm
