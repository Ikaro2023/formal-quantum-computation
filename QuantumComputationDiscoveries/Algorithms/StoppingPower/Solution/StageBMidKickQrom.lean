  intro b8 mk
  have hmk : mk.val = (M / 2 ^ k) % 2 := testBit_eq_div_mod2 M k
  rcases bit_cases sw with rfl | rfl
  · dsimp [b8]; rw [add_zero, hmk]
  · dsimp [b8]
    have htb_flip : (255 - M).testBit k = !M.testBit k := by revert M hM k hk; decide
    rw [← testBit_eq_div_mod2 (255 - M) k, htb_flip]
    dsimp [mk]; cases M.testBit k <;> decide
theorem magCarryZMod_induction (P M : ℕ) (hP : P < 256) (hM : M < 128)
    (fP fPB : Fin 8 → ZMod 2) (fM : Fin 7 → ZMod 2) (sw : ZMod 2)
    (hfP : ∀ b : Fin 8, fP b = if P.testBit b.val then 1 else 0)
    (hfM : ∀ b : Fin 7, fM b = if M.testBit b.val then 1 else 0)
    (hPB : ∀ b : Fin 8, fPB b = if (p57AxisFastVal P M sw.val).testBit b.val then 1 else 0) :
    let b8 := if sw.val = 1 then 255 - M else M
    let lt := ((magCarryZMod fP fPB sw 0) + sw).val
    ∀ (k : ℕ) (hk : k ≤ 7),
      (magCarryZMod fP fPB sw k + sw).val = (P % 2 ^ k + b8 % 2 ^ k + lt) / 2 ^ k ∧
      (∀ (j : ℕ) (hj : j < k),
        fM ⟨j, by omega⟩ = fP ⟨j, by omega⟩ + fPB ⟨j, by omega⟩ + magCarryZMod fP fPB sw j) := by
  intro b8 lt k hk
  induction k with
  | zero =>
      refine ⟨?_, fun _ hj ↦ absurd hj (Nat.not_lt_zero _)⟩
      dsimp [lt]; omega
  | succ k ih =>
      obtain ⟨ihC, ihM⟩ := ih (by omega)
      have hfast_lt : p57AxisFastVal P M sw.val < 256 := Nat.mod_lt _ (by decide)
      have hp7 : fP ⟨7, by decide⟩ = if 128 ≤ P then 1 else 0 := by
        rw [hfP ⟨7, by decide⟩]; simp [Prod57BoothHoist.nat_testBit_seven_of_lt_256 hP]
      have hpb7 : fPB ⟨7, by decide⟩ = if 128 ≤ p57AxisFastVal P M sw.val then 1 else 0 := by
        rw [hPB ⟨7, by decide⟩]; simp [Prod57BoothHoist.nat_testBit_seven_of_lt_256 hfast_lt]
      have hlt_eq : lt = (let pFlip :=
        if P < 128 then P + 128 else P - 128; if 255 - pFlip < b8 then 1 else 0) := by
        change ((1 + sw + fP ⟨7, by decide⟩) * (sw + fPB ⟨7, by decide⟩) + sw).val = _
        rw [hp7, hpb7]; exact wWrap_add_sw_nat P M sw hP hM
      have hpb_eq : p57AxisFastVal P M sw.val = (P + b8 + lt) % 256 := by
        dsimp [p57AxisFastVal]; rw [hlt_eq]
      set pk := fP ⟨k, by omega⟩
      set mk := fM ⟨k, by omega⟩
      set pbk := fPB ⟨k, by omega⟩
      set dk := magCarryZMod fP fPB sw k
      have hpk_val : pk.val = (P / 2 ^ k) % 2 := by
        dsimp [pk]; rw [hfP ⟨k, by omega⟩]; exact testBit_eq_div_mod2 P k
      have hbk_val : (b8 / 2 ^ k) % 2 = (mk + sw).val := by
        dsimp [mk]; rw [hfM ⟨k, by omega⟩]; exact b8_div_pow_mod2 M hM sw k (by omega)
      obtain ⟨hmod_k, hdiv_k⟩ := add3_div_pow_mod2 P b8 lt k
      have hpbk_val : pbk.val = (pk.val + (mk + sw).val + (dk + sw).val) % 2 := by
        dsimp [pbk]; rw [hPB ⟨k, by omega⟩]
        have htb : (p57AxisFastVal P M sw.val).testBit k = (P + b8 + lt).testBit k := by
          rw [hpb_eq]
          change ((P + b8 + lt) % 2 ^ 8).testBit k = _
          rw [Nat.testBit_mod_two_pow]; simp [show k < 8 by omega]
        change (if (p57AxisFastVal P M sw.val).testBit k then (1 : ZMod 2) else 0).val = _
        rw [htb, testBit_eq_div_mod2, hmod_k, ← hpk_val, hbk_val, ← ihC]
      obtain ⟨hmk_eq, hdk1_val⟩ := zmod2_carry_step pk mk sw dk pbk hpbk_val
      have hdk1_def : magCarryZMod fP fPB sw (k + 1) = dk + (pk + pbk) * (pk + sw + dk) := by
        dsimp [magCarryZMod]; exact dite_eq_left (by omega : k < 7)
      refine ⟨?_, fun j hj ↦ ?_⟩
      · rw [hdk1_def, hdk1_val, hdiv_k, hpk_val, ← hbk_val, ihC]
      · by_cases hjk : j < k
        · exact ihM j hjk
