theorem cComp17Inner_eval_ket {n mScr : ℕ} (hm20 : 20 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) (β : BitAssignment n)
    (h17 : ∀ j : Fin 17, β (rSub17 hm20 rScr j) = 0) :
    (cComp17Inner hm20 rCore rScr hCS).eval.1.mulVec (ket β) = ((-1 : ℂ) ^ (∑ i : Fin
    3, β (rHold3Aux hm20 rScr i) * holdVecAux rCore β i).val) • ket β := by
  let rComb := rComb106 hm20 rCore rScr hCS
  have hcr : cleanRem 106 17 (fun idx ↦ β (rComb idx)) := fun w hw ↦ by
    let j : Fin 17 := ⟨w.val - 89, by omega⟩
    have hwEq : rComb w = tailScr rComb 17 (by decide) j := by
      dsimp only [tailScr, j]
      congr 1; ext; dsimp; omega
    change β (rComb w) = 0
    rw [hwEq, congrFun (tailScr_rComb106 hm20 rCore rScr hCS) j]
    exact h17 j
  rw [cComp17Inner, ← mbh_ket_eq_ket,
      mk34_ctxToToff_eval_ket rComb _ _ (cLeafComp17On_eval_mbh_ket rComb)
        ⟨0, by decide⟩ ctxComp17 β]
  rw [pComp17_eq, pComp17_valid_and_bits.2 _ hcr,
      mk34_writeRegProg_self, mbh_ket_eq_ket]
  congr 2
  rw [ctxComp17_fwdBits_fLeaf _ hcr, Fin.sum_univ_three]
  have hc (k : Fin 86) : β (rComb ⟨k.val, by omega⟩) =
      β (rCore ⟨3948 + k.val, by dsimp [posCoreWires]; omega⟩) :=
    congrArg β (rComb106_core hm20 rCore rScr hCS k)
  have hh0 : β (rComb ⟨86, by decide⟩) = β (rHold3Aux hm20 rScr 0) :=
    congrArg β (rComb106_hold hm20 rCore rScr hCS 0)
  have hh1 : β (rComb ⟨87, by decide⟩) = β (rHold3Aux hm20 rScr 1) :=
    congrArg β (rComb106_hold hm20 rCore rScr hCS 1)
  have hh2 : β (rComb ⟨88, by decide⟩) = β (rHold3Aux hm20 rScr 2) :=
    congrArg β (rComb106_hold hm20 rCore rScr hCS 2)
  rw [hh0, hh1, hh2]
  simp only [holdVecAux, Fin.val_zero, Fin.val_one, Fin.val_two, ↓reduceIte,
    (by decide : (1 : ℕ) ≠ 0), (by decide : (2 : ℕ) ≠ 0), (by decide : (2 : ℕ) ≠ 1)]
  rw [hc ⟨15, by decide⟩, hc ⟨16, by decide⟩, hc ⟨17, by decide⟩, hc ⟨18, by decide⟩, hc ⟨19, by
    decide⟩,
      hc ⟨21, by decide⟩, hc ⟨22, by decide⟩, hc ⟨23, by decide⟩, hc ⟨24, by decide⟩,
      hc ⟨25, by decide⟩, hc ⟨26, by decide⟩, hc ⟨27, by decide⟩,
      hc ⟨28, by decide⟩, hc ⟨29, by decide⟩, hc ⟨30, by decide⟩, hc ⟨31, by decide⟩,
      hc ⟨32, by decide⟩, hc ⟨33, by decide⟩, hc ⟨34, by decide⟩, hc ⟨35, by decide⟩]
  rfl
theorem cComp17_eval_ket {n mScr : ℕ} (hm20 : 20 ≤ mScr)
    (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) (β : BitAssignment n)
    (h17 : ∀ j : Fin 17, β (rSub17 hm20 rScr j) = 0) :
    (cComp17 hm20 rCore rScr hCS).eval.1.mulVec (ket β) =
      ket (writeReg β (rHold3Aux hm20 rScr)
        (fun i ↦ β (rHold3Aux hm20 rScr i) + holdVecAux rCore β i)) := by
  dsimp only [cComp17]
  simp only [Circuit.eval_seq, Submonoid.coe_mul]
  refine hadamardReg_conj_phase_mulVec_ket (rHold3Aux hm20 rScr)
