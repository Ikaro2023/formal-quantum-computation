    wpQAssignCompat U₁ (wpQAssignCompat U₂ θ) = wpQAssignCompat (U₂ * U₁) θ := by
  funext σ
  simp [wpQAssignCompat, qAssignObsMap]
theorem wp_circuit_compile_compat {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} [NeZero (2 ^ n)] (c : Circuit n) (Θ : CQAssertionCompat Var (2 ^ n)) :
    wp c.compile Θ = wpQAssignCompat c.eval Θ := by
  rw [DynCircuitExt.wp_circuit_compile_compat]
  rfl
theorem restrictToZeroAncilla_wp_andCompute_seq_compat
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (control₁ control₂ ancilla : Wire n)
    (h₁₂ : control₁ ≠ control₂) (h₁a : control₁ ≠ ancilla) (h₂a : control₂ ≠ ancilla)
    (P : QProg Var (2 ^ n)) (Θ : CQAssertionCompat Var (2 ^ n)) :
    CQAssertion.restrictToZeroAncilla
      (wp (.qSeq (DynamicCircuit.andCompute (Var :=
        Var) control₁ control₂ ancilla h₁a h₂a).compile P) Θ)
      (QRegister.singleton ancilla) =
    CQAssertion.restrictToZeroAncilla
      (wpQAssignCompat (toffCirc control₁ control₂ ancilla h₁₂ h₁a h₂a).eval (wp P Θ))
      (QRegister.singleton ancilla) :=
  DynCircuitExt.restrictToZeroAncilla_wp_andCompute_seq_compat
    control₁ control₂ ancilla h₁₂ h₁a h₂a P Θ
theorem restrictToZeroAncilla_wp_andCompute_circuit_andUncompute_of_update_eq_compat
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (v : Var) (control₁ control₂ ancilla : Wire n)
    (h₁₂ : control₁ ≠ control₂) (h₁a : control₁ ≠ ancilla) (h₂a : control₂ ≠ ancilla)
    (c : Circuit n)
    (hc :
      let P₀ := (QRegister.singleton ancilla).basisOutcomeProjector 0
      let T_anc := (toffCirc control₁ control₂ ancilla h₁₂ h₁a h₂a).eval.1
      P₀ * (T_anc * c.eval.1 * T_anc * P₀) = T_anc * c.eval.1 * T_anc * P₀)
    (Θ : CQAssertionCompat Var (2 ^ n))
    (hΘ : ∀ σ val, Θ (Function.update σ v val) = Θ σ) :
    CQAssertion.restrictToZeroAncilla
      (wp (DynamicCircuit.seq (DynamicCircuit.andCompute control₁ control₂ ancilla h₁a h₂a)
        (DynamicCircuit.seq (.circuit c)
          (DynamicCircuit.andUncompute v control₁ control₂ ancilla h₁₂))).compile Θ)
      (QRegister.singleton ancilla) =
    CQAssertion.restrictToZeroAncilla
      (wpQAssignCompat
        (toffCirc control₁ control₂ ancilla h₁₂ h₁a h₂a ;;ᶜ
          c ;;ᶜ
          toffCirc control₁ control₂ ancilla h₁₂ h₁a h₂a).eval Θ)
      (QRegister.singleton ancilla) :=
  DynCircuitExt.restrictToZeroAncilla_wp_andCompute_circuit_andUncompute_of_update_eq_compat
    v control₁ control₂ ancilla h₁₂ h₁a h₂a c hc Θ hΘ
theorem restrictAssertionToZeroAncilla_wpQAssign_toffoli_wp_andUncompute_of_update_eq
    {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)] (v : Var)
    (control₁ control₂ ancilla : Wire n) (h₁₂ : control₁ ≠ control₂)
    (h₁a : control₁ ≠ ancilla) (h₂a : control₂ ≠ ancilla) (Θ : CQAssertionCompat Var (2 ^ n))
    (hΘ : ∀ σ val, Θ (Function.update σ v val) = Θ σ) : CQAssertion.restrictToZeroAncilla
    (wpQAssignCompat (toffCirc control₁ control₂ ancilla h₁₂ h₁a h₂a).eval (wp
    (DynamicCircuit.andUncompute v control₁ control₂ ancilla h₁₂).compile Θ))
    (QRegister.singleton ancilla) = CQAssertion.restrictToZeroAncilla Θ
    (QRegister.singleton ancilla) := by
  let cToff := toffCirc control₁ control₂ ancilla h₁₂ h₁a h₂a
  have hinv : cToff.eval = cToff.eval⁻¹ := Circuit.eval_inverse cToff
  have hsq : cToff.eval * cToff.eval = 1 := by
    nth_rw 2 [hinv]
    exact mul_inv_cancel cToff.eval
  have hsq_mat : cToff.eval.1 * (Circuit.identity : Circuit n).eval.1 * cToff.eval.1 = 1 := by
    simpa only [Circuit.eval_identity, Submonoid.coe_one, Matrix.mul_one,
      ← Submonoid.coe_mul] using congrArg Subtype.val hsq
  have hc :
      let P₀ := (QRegister.singleton ancilla).basisOutcomeProjector 0
      let T_anc := cToff.eval.1
      P₀ * (T_anc * (Circuit.identity : Circuit n).eval.1 * T_anc * P₀) =
        T_anc * (Circuit.identity : Circuit n).eval.1 * T_anc * P₀ := by
    dsimp only
    rw [hsq_mat, Matrix.one_mul, QRegister.basisOutcomeProjector_mul_self]
  have hmain :=
    restrictToZeroAncilla_wp_andCompute_circuit_andUncompute_of_update_eq_compat
      v control₁ control₂ ancilla h₁₂ h₁a h₂a Circuit.identity hc Θ hΘ
  have heval : (cToff ;;ᶜ Circuit.identity ;;ᶜ cToff).eval = 1 := by
    simpa [Circuit.eval_seq] using hsq
  rw [heval, wpQAssignCompat_one] at hmain
  rw [← restrictToZeroAncilla_wp_andCompute_seq_compat
    control₁ control₂ ancilla h₁₂ h₁a h₂a _ Θ]
  exact hmain
theorem anc_ne_scr {n mScr : ℕ} (rCore : QRegister posCoreWires n) (rScr : QRegister mScr n)
    (hCS : rCore.DisjointWires rScr) (i : Fin 8) (j : Fin mScr) : rAnchorIdx rCore i ≠ rScr j
    := hCS.ne _ j
theorem wSlot0_ne_scr {n mScr : ℕ} (rCore : QRegister posCoreWires n)
    (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) (j : Fin mScr) : wSlot0Core
    rCore ≠ rScr j := hCS.ne _ j
theorem wHeadThresh_ne_scr {n mScr : ℕ} (rCore : QRegister posCoreWires n)
    (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) (j : Fin mScr) : wHeadThresh
    rCore ≠ rScr j := hCS.ne _ j
theorem rElecSlot_ne_rScr {n mScr : ℕ} (rCore : QRegister posCoreWires n)
    (rScr : QRegister mScr n) (hCS : rCore.DisjointWires rScr) (e : Fin 218) (q : Fin 18)
    (j : Fin mScr) : rElecSlot rCore e q ≠ rScr j := hCS.ne _ j
/-- Selector `selDataInAct kData : QRegister kData (kData + 18)` extracting `rData` (`[0 .. kData)`)
from `rData.concat rMeas hDM`. -/
def selDataInAct (kData : ℕ) : QRegister kData (kData + 18) :=
  QRegister.block 0 kData (by omega)
/-- Selector `selMeasInAct kData : QRegister 18 (kData + 18)` extracting `rMeas` (`[kData .. kData +
  18)`)
from `rData.concat rMeas hDM`. -/
def selMeasInAct (kData : ℕ) : QRegister 18 (kData + 18) :=
  QRegister.block kData 18 (by omega)
theorem selDataInAct_apply {kData : ℕ} (i : Fin kData) :
    selDataInAct kData i = Fin.castAdd 18 i :=
  Fin.ext (by simp [selDataInAct])
theorem selMeasInAct_apply {kData : ℕ} (j : Fin 18) :
    selMeasInAct kData j = Fin.natAdd kData j :=
  Fin.ext (by simp [selMeasInAct])
theorem concat_compose_selDataInAct {n kData : ℕ} (rData : QRegister kData n)
    (rMeas : QRegister 18 n) (hDM : rData.DisjointWires rMeas) :
    (rData.concat rMeas hDM).compose (selDataInAct kData) = rData := by
  apply qreg_ext; intro i
  rw [QRegister.compose_apply, selDataInAct_apply, QRegister.concat_apply_left]
theorem concat_compose_selMeasInAct {n kData : ℕ} (rData : QRegister kData n)
    (rMeas : QRegister 18 n) (hDM : rData.DisjointWires rMeas) :
    (rData.concat rMeas hDM).compose (selMeasInAct kData) = rMeas := by
  apply qreg_ext; intro j
  rw [QRegister.compose_apply, selMeasInAct_apply, QRegister.concat_apply_right]
theorem selDataInAct_disj_selMeasInAct (kData : ℕ) :
    (selDataInAct kData).DisjointWires (selMeasInAct kData) := by
  rw [QRegister.disjoint_iff]
  intro i j h
  have hv := congrArg Fin.val h
  simp only [selDataInAct_apply, selMeasInAct_apply, Fin.val_castAdd, Fin.val_natAdd] at hv
  have := i.isLt
  omega
theorem ite_true_eq {α : Sort _} {P : Prop} [inst : Decidable P] {a b : α} (h : P) :
    (if P then a else b) = a := by
  cases inst with
  | isFalse hnp => exact False.elim (hnp h)
  | isTrue _ => rfl
theorem ite_false_eq {α : Sort _} {P : Prop} [inst : Decidable P] {a b : α} (h : ¬P) :
    (if P then a else b) = b := by
  cases inst with
  | isFalse _ => rfl
  | isTrue hp => exact False.elim (h hp)
theorem dite_true_eq {α : Sort _} {P : Prop} [inst : Decidable P] {a : P → α} {b : ¬P → α}
    (h : P) : (if hp : P then a hp else b hp) = a h := by
  cases inst with
  | isFalse hnp => exact False.elim (hnp h)
  | isTrue _ => rfl
theorem dite_false_eq {α : Sort _} {P : Prop} [inst : Decidable P] {a : P → α} {b : ¬P → α}
    (h : ¬P) : (if hp : P then a hp else b hp) = b h := by
  cases inst with
  | isFalse _ => rfl
  | isTrue hp => exact False.elim (h hp)
/-! ## Part 3A: Generic `SubspaceStep` Combinators for `SymTempAndStep` & `symWrapDynList` -/
/-- Reference classical-permutation circuit `s.pre ;; toff ;; s.midPre` whose action on `ket β`
matches `ket (s.stepFwd β)`. -/
def cSymStepFwd {n : ℕ} (s : SymTempAndStep n) : Circuit n :=
  s.pre ;;ᶜ toffCirc s.c₁ s.c₂ s.anc s.h₁₂ s.h₁a s.h₂a ;;ᶜ s.midPre
theorem cSymStepFwd_mulVec_ket {n : ℕ} (s : SymTempAndStep n) (β : BitAssignment n) :
    (cSymStepFwd s).eval.1.mulVec (ket β) = ket (s.stepFwd β) := by
  dsimp only [cSymStepFwd, SymTempAndStep.stepFwd]
  rw [OctahedralOrbit.eval_seq_mulVec, OctahedralOrbit.eval_seq_mulVec,
      s.local_pre.perm β, OctahedralOrbit.ket_TOFF, s.local_midPre.perm _]
theorem cSymStepFwd_support_sub {n : ℕ} (s : SymTempAndStep n) :
    (cSymStepFwd s).support ⊆ s.S := by
  intro w hw
  dsimp only [cSymStepFwd] at hw
  rw [Circuit.support_seq, Finset.mem_union] at hw
  rcases hw with h1 | h23
  · exact s.local_pre.support_sub h1
  · rw [Circuit.support_seq, Finset.mem_union] at h23
    rcases h23 with h2 | h3
    · simp only [toffCirc, Circuit.support_toffoli, Finset.mem_insert, Finset.mem_singleton] at h2
      rcases h2 with rfl | rfl | rfl
      · exact s.c₁_mem
      · exact s.c₂_mem
      · exact s.anc_mem
    · exact s.local_midPre.support_sub h3
/-- Reference circuit for a list `L : List (SymTempAndStep n)` mapping `ket β` to `ket
  (symStepFwdList L β)`. -/
def cSymStepFwdList {n : ℕ} : List (SymTempAndStep n) → Circuit n
  | [] => Circuit.identity
  | s :: rest => cSymStepFwd s ;;ᶜ cSymStepFwdList rest
theorem cSymStepFwdList_mulVec_ket {n : ℕ} :
    ∀ (L : List (SymTempAndStep n)) (β : BitAssignment n),
      (cSymStepFwdList L).eval.1.mulVec (ket β) = ket (symStepFwdList L β)
  | [], β => by simp [cSymStepFwdList, Circuit.eval_identity]
  | s :: rest, β => by
      dsimp only [cSymStepFwdList, symStepFwdList]
      rw [OctahedralOrbit.eval_seq_mulVec, cSymStepFwd_mulVec_ket, cSymStepFwdList_mulVec_ket]
theorem cSymStepFwdList_support_not_mem {n : ℕ} {w : Wire n} :
    ∀ {L : List (SymTempAndStep n)}, (∀ s ∈ L, w ∉ s.S) → w ∉ (cSymStepFwdList L).support
  | [], _ => by simp [cSymStepFwdList]
  | s :: rest, h => by
      dsimp only [cSymStepFwdList]
      rw [Circuit.support_seq, Finset.mem_union, not_or]
      exact ⟨fun hm ↦ h s List.mem_cons_self (cSymStepFwd_support_sub s hm),
        cSymStepFwdList_support_not_mem fun s' hs' ↦ h s' (List.mem_cons_of_mem s hs')⟩
/-- Generic `SubspaceStep` rule for `andCompute ;; dBody ;; andUncompute` on any input/output
subspaces `R_in, R_out` where `anc` is `|0⟩`. -/
theorem subspaceStep_tempAnd {Var : Type} [Fintype Var] [DecidableEq Var]
    {n : ℕ} (v : Var)
    (c₁ c₂ anc : Wire n) (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc) (h₂a : c₂ ≠ anc)
    {R_in R_out : Operator (2 ^ n)} {dBody : DynamicCircuit Var n}
    (hIn0 : (QRegister.singleton anc).basisOutcomeProjector 0 * R_in = R_in)
    (hOut0 : (QRegister.singleton anc).basisOutcomeProjector 0 * R_out = R_out)
    (hBody : SubspaceStep ((toffCirc c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * R_in)
      ((toffCirc c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * R_out) dBody) :
    SubspaceStep R_in R_out
      (.seq (DynamicCircuit.andCompute c₁ c₂ anc h₁a h₂a)
        (.seq dBody (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂))) := fun M ↦ by
  let P₀ := (QRegister.singleton anc).basisOutcomeProjector 0
  let T_anc := (toffCirc c₁ c₂ anc h₁₂ h₁a h₂a).eval
  let dUncomp := DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂
  have hP₀H : P₀ᴴ = P₀ := QRegister.basisOutcomeProjector_conjTranspose _ 0
  have hIn0' : P₀ * R_in = R_in := hIn0
  have hOut0' : P₀ * R_out = R_out := hOut0
  have hIn0H : R_inᴴ * P₀ = R_inᴴ := by
    simpa only [Matrix.conjTranspose_mul, hP₀H] using congrArg (·ᴴ) hIn0'
  have hOut0H : R_outᴴ * P₀ = R_outᴴ := by
    simpa only [Matrix.conjTranspose_mul, hP₀H] using congrArg (·ᴴ) hOut0'
  obtain ⟨M_uncomp, hUncomp_wp⟩ := PreservesStoreConst.andUncompute v c₁ c₂ anc h₁₂ M
  obtain ⟨M_body, hBody_wp, hBody_mat⟩ := hBody M_uncomp
  obtain ⟨M_all, hAll_wp⟩ :=
    PreservesStoreConst.circuit (Var := Var) (Circuit.andCompute c₁ c₂ anc h₁a h₂a) M_body
  have hBodySeqWp : wp (.qSeq dBody.compile dUncomp.compile) (fun _ ↦ M) = fun _ ↦ M_body := by
    funext τ
    change wp dBody.compile (wp dUncomp.compile (fun _ ↦ M)) τ = M_body
    rw [hUncomp_wp, hBody_wp]
  have hSeqWp : wp (DynamicCircuit.seq (DynamicCircuit.andCompute c₁ c₂ anc h₁a h₂a)
      (DynamicCircuit.seq dBody dUncomp)).compile (fun _ ↦ M) = fun _ ↦ M_all := by
    funext τ
    change wp (DynamicCircuit.andCompute c₁ c₂ anc h₁a h₂a).compile
      (wp (.qSeq dBody.compile dUncomp.compile) (fun _ ↦ M)) τ = M_all
    rw [hBodySeqWp]
    exact congrFun hAll_wp τ
  refine ⟨M_all, hSeqWp, ?_⟩
  let σ₀ : Store Var := fun _ ↦ 0
  have h1Raw := congrArg (fun X : Observable (Fin (2 ^ n)) ↦ X.1.mat) (congrFun
    (restrictToZeroAncilla_wp_andCompute_seq_compat c₁ c₂ anc h₁₂ h₁a h₂a
      (.qSeq dBody.compile dUncomp.compile) (fun _ ↦ M)) σ₀)
  have hAllQSeq : wp (.qSeq (DynamicCircuit.andCompute c₁ c₂ anc h₁a h₂a).compile (.qSeq
      dBody.compile dUncomp.compile)) (fun _ ↦ M) = fun _ ↦ M_all := hSeqWp
  rw [hAllQSeq, hBodySeqWp] at h1Raw
  have hStep1 : P₀ * M_all.1.1 * P₀ = P₀ * (T_anc.1ᴴ * M_body.1.1 * T_anc.1) * P₀ := by
    have hL : (CQAssertion.restrictToZeroAncilla (fun _ ↦
      M_all) (QRegister.singleton anc) σ₀).1.mat =
        P₀ * M_all.1.mat * P₀ := by
      simp [CQAssertion.restrictToZeroAncilla, CQAssertion.conj, P₀, HermitianMat.conj_apply_mat,
        QRegister.basisOutcomeProjector_conjTranspose, Matrix.mul_assoc]
    have hR : (CQAssertion.restrictToZeroAncilla (wpQAssignCompat T_anc (fun _ ↦ M_body))
        (QRegister.singleton anc) σ₀).1.mat =
        P₀ * (T_anc.1ᴴ * M_body.1.mat * T_anc.1) * P₀ := by
      simp [CQAssertion.restrictToZeroAncilla, CQAssertion.conj, P₀, wpQAssignCompat, qAssignObsMap,
        Matrix.star_eq_conjTranspose, HermitianMat.conj_apply_mat,
        QRegister.basisOutcomeProjector_conjTranspose, Matrix.mul_assoc]
    dsimp only [T_anc, toffCirc] at hR h1Raw ⊢
    exact hL.symm.trans (h1Raw.trans hR)
  have h2Raw := congrArg (fun X : Observable (Fin (2 ^ n)) ↦ X.1.mat) (congrFun
    (restrictAssertionToZeroAncilla_wpQAssign_toffoli_wp_andUncompute_of_update_eq
      v c₁ c₂ anc h₁₂ h₁a h₂a (fun _ ↦ M) (fun _ _ ↦ rfl)) σ₀)
  rw [hUncomp_wp] at h2Raw
  have hStepUncomp : P₀ * (T_anc.1ᴴ * M_uncomp.1.1 * T_anc.1) * P₀ = P₀ * M.1.1 * P₀ := by
    have hL : (CQAssertion.restrictToZeroAncilla (wpQAssignCompat T_anc (fun _ ↦ M_uncomp))
        (QRegister.singleton anc) σ₀).1.mat =
        P₀ * (T_anc.1ᴴ * M_uncomp.1.mat * T_anc.1) * P₀ := by
      simp [CQAssertion.restrictToZeroAncilla, CQAssertion.conj, P₀, wpQAssignCompat, qAssignObsMap,
        Matrix.star_eq_conjTranspose, HermitianMat.conj_apply_mat,
        QRegister.basisOutcomeProjector_conjTranspose, Matrix.mul_assoc]
    have hR : (CQAssertion.restrictToZeroAncilla (fun _ ↦ M) (QRegister.singleton anc) σ₀).1.mat =
        P₀ * M.1.mat * P₀ := by
      simp [CQAssertion.restrictToZeroAncilla, CQAssertion.conj, P₀, HermitianMat.conj_apply_mat,
        QRegister.basisOutcomeProjector_conjTranspose, Matrix.mul_assoc]
    dsimp only [T_anc, toffCirc] at hL h2Raw ⊢
    exact hL.symm.trans (h2Raw.trans hR)
  calc R_outᴴ * M.1.1 * R_out
      = R_outᴴ * (P₀ * M.1.1 * P₀) * R_out := by
          simp only [← Matrix.mul_assoc, hOut0H]; simp only [Matrix.mul_assoc, hOut0']
    _ = R_outᴴ * (P₀ * (T_anc.1ᴴ * M_uncomp.1.1 * T_anc.1) * P₀) * R_out := by rw [← hStepUncomp]
    _ = (T_anc.1 * R_out)ᴴ * M_uncomp.1.1 * (T_anc.1 * R_out) := by
          rw [Matrix.conjTranspose_mul]
          simp only [← Matrix.mul_assoc, hOut0H]; simp only [Matrix.mul_assoc, hOut0']
    _ = (T_anc.1 * R_in)ᴴ * M_body.1.1 * (T_anc.1 * R_in) := hBody_mat
    _ = R_inᴴ * (P₀ * (T_anc.1ᴴ * M_body.1.1 * T_anc.1) * P₀) * R_in := by
          rw [Matrix.conjTranspose_mul]
          simp only [← Matrix.mul_assoc, hIn0H]; simp only [Matrix.mul_assoc, hIn0']
    _ = R_inᴴ * (P₀ * M_all.1.1 * P₀) * R_in := by rw [← hStep1]
    _ = R_inᴴ * M_all.1.1 * R_in := by
          simp only [← Matrix.mul_assoc, hIn0H]; simp only [Matrix.mul_assoc, hIn0']
theorem singleton_proj0_comm_circuit_of_not_mem {n : ℕ} (w : Wire n) (c : Circuit n)
    (hw : w ∉ c.support) : (QRegister.singleton w).basisOutcomeProjector 0 * c.eval.1 =
    c.eval.1 * (QRegister.singleton w).basisOutcomeProjector 0 := by
  rw [← projZeroAll_eq_basisOutcomeProjector_zero (QRegister.singleton w)]
  exact (circuit_eval_comm_projZeroAll (QRegister.singleton w).wires c (fun _ ↦ hw)).symm
theorem localClassicalPerm_inv_mul {n : ℕ} {S : Finset (Wire n)} {cPre cPost : Circuit n}
    {fPre fPost : BitAssignment n → BitAssignment n} (hPre : LocalClassicalPerm S cPre fPre)
    (hPost : LocalClassicalPerm S cPost fPost) (hId : ∀ β, fPost (fPre β) = β) : cPost.eval.1
    * cPre.eval.1 = 1 := by
  apply MeasureBranchHadamardSem.matrix_ext_ket
  intro β
  rw [Matrix.one_mulVec, ← Matrix.mulVec_mulVec,
      mbh_ket_eq_ket, hPre.perm β, hPost.perm (fPre β), hId β]
/-- Generic `SubspaceStep` rule for a single `SymTempAndStep` (`s.toTempAndStep.wrapDynamic v
  inner`). -/
theorem subspaceStep_symStep {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} (v : Var)
    (s : SymTempAndStep n) {R_in R_out : Operator (2 ^ n)} {inner : DynamicCircuit Var n}
    (hIn0 : (QRegister.singleton s.anc).basisOutcomeProjector 0 * R_in = R_in) (hOut0 :
    (QRegister.singleton s.anc).basisOutcomeProjector 0 * R_out = R_out) (hInner :
    SubspaceStep ((cSymStepFwd s).eval.1 * R_in) ((cSymStepFwd s).eval.1 * R_out) inner) :
    SubspaceStep R_in R_out (s.toTempAndStep.wrapDynamic v inner) := by
  let P₀ := (QRegister.singleton s.anc).basisOutcomeProjector 0
  let T_anc := (toffCirc s.c₁ s.c₂ s.anc s.h₁₂ s.h₁a s.h₂a).eval
  have hPostPre : s.post.eval.1 * s.pre.eval.1 = 1 :=
    localClassicalPerm_inv_mul s.local_pre s.local_post s.post_pre_id
  have hMidPostPre : s.midPost.eval.1 * s.midPre.eval.1 = 1 :=
    localClassicalPerm_inv_mul s.local_midPre s.local_midPost s.midPost_midPre_id
  have hCommPre : P₀ * s.pre.eval.1 = s.pre.eval.1 * P₀ :=
    singleton_proj0_comm_circuit_of_not_mem s.anc s.pre s.anc_not_mem_pre
  have hIn1 : P₀ * (s.pre.eval.1 * R_in) = s.pre.eval.1 * R_in := by
    rw [← Matrix.mul_assoc, hCommPre, Matrix.mul_assoc, hIn0]
  have hOut1 : P₀ * (s.pre.eval.1 * R_out) = s.pre.eval.1 * R_out := by
    rw [← Matrix.mul_assoc, hCommPre, Matrix.mul_assoc, hOut0]
  have hCFwdEq : ∀ R : Operator (2 ^ n),
      s.midPre.eval.1 * (T_anc.1 * (s.pre.eval.1 * R)) = (cSymStepFwd s).eval.1 * R := fun R ↦ by
    dsimp only [cSymStepFwd, T_anc]
    simp only [Circuit.eval_seq, Submonoid.coe_mul, Matrix.mul_assoc]
  have hMidStep1 : SubspaceStep (Var := Var)
      (T_anc.1 * (s.pre.eval.1 * R_in)) ((cSymStepFwd s).eval.1 * R_in) (.circuit s.midPre) :=
    subspaceStep_congr_out (subspaceStep_of_circuit _ s.midPre) (hCFwdEq R_in)
  have hMidStep3 : SubspaceStep (Var := Var)
      ((cSymStepFwd s).eval.1 * R_out) (T_anc.1 * (s.pre.eval.1 * R_out)) (.circuit s.midPost) :=
    subspaceStep_congr_out (subspaceStep_of_circuit _ s.midPost) (by
      rw [← hCFwdEq R_out, ← Matrix.mul_assoc, hMidPostPre, Matrix.one_mul])
  have hAnd := subspaceStep_tempAnd v s.c₁ s.c₂ s.anc s.h₁₂ s.h₁a s.h₂a hIn1 hOut1
    (hMidStep1.seq (hInner.seq hMidStep3))
  have hPreStep : SubspaceStep (Var := Var) R_in (s.pre.eval.1 * R_in) (.circuit s.pre) :=
    subspaceStep_of_circuit R_in s.pre
  have hPostStep : SubspaceStep (Var := Var) (s.pre.eval.1 * R_out) R_out (.circuit s.post) :=
    subspaceStep_congr_out (subspaceStep_of_circuit _ s.post) (by
      rw [← Matrix.mul_assoc, hPostPre, Matrix.one_mul])
  exact hPreStep.seq (hAnd.seq hPostStep)
/-- Generic `SubspaceStep` rule for `symWrapDynList v L core` over a `ValidSymStepList`. -/
theorem subspaceStep_symWrapDynList {Var : Type} [Fintype Var] [DecidableEq Var]
    {n m_anc : ℕ} (v : Var) {M_guard : Finset (Wire n)} (rAnc : QRegister m_anc n) :
    ∀ (offset : ℕ) (L : List (SymTempAndStep n)),
      ValidSymStepList M_guard rAnc offset L →
      ∀ (hfit : offset + L.length ≤ m_anc)
        {R_in R_out : Operator (2 ^ n)} {core : DynamicCircuit Var n},
        (∀ i : Fin L.length,
          (QRegister.singleton (rAnc ⟨offset + i.val, by
            omega⟩)).basisOutcomeProjector 0 * R_in = R_in) →
        (∀ i : Fin L.length,
          (QRegister.singleton (rAnc ⟨offset + i.val, by
            omega⟩)).basisOutcomeProjector 0 * R_out = R_out) →
        SubspaceStep ((cSymStepFwdList L).eval.1 * R_in)
          ((cSymStepFwdList L).eval.1 * R_out) core →
        SubspaceStep R_in R_out (symWrapDynList v L core)
  | _, [], _, _, R_in, R_out, _, _, _, hCore => by
      have hEmpty : (cSymStepFwdList ([] : List (SymTempAndStep n))).eval.1 = 1 := by
        simp [cSymStepFwdList, Circuit.eval_identity]
      rw [hEmpty, Matrix.one_mul, Matrix.one_mul] at hCore
      exact hCore
  | offset, s :: rest, hvalid, hfit, R_in, R_out, core, hIn0, hOut0, hCore => by
      rcases hvalid with ⟨hlt, hanc_s, _, hlat_s, hvalid_rest⟩
      have hfit_rest : (offset + 1) + rest.length ≤ m_anc := by
        simp only [List.length_cons] at hfit; omega
      have hAncIn : (QRegister.singleton s.anc).basisOutcomeProjector 0 * R_in = R_in := by
        rw [hanc_s]
        simpa using hIn0 ⟨0, by simp⟩
      have hAncOut : (QRegister.singleton s.anc).basisOutcomeProjector 0 * R_out = R_out := by
        rw [hanc_s]
        simpa using hOut0 ⟨0, by simp⟩
      have hLatComm : ∀ i : Fin rest.length,
          let w := rAnc ⟨(offset + 1) + i.val, by omega⟩
          (QRegister.singleton w).basisOutcomeProjector 0 * (cSymStepFwd s).eval.1 =
            (cSymStepFwd s).eval.1 * (QRegister.singleton w).basisOutcomeProjector 0 := fun i ↦ by
        refine singleton_proj0_comm_circuit_of_not_mem _ (cSymStepFwd s) fun hm ↦ ?_
        exact hlat_s ⟨(offset + 1) + i.val, by
          omega⟩ (by dsimp; omega) (cSymStepFwd_support_sub s hm)
      have hInRest : ∀ i : Fin rest.length,
          (QRegister.singleton (rAnc ⟨(offset + 1) + i.val, by omega⟩)).basisOutcomeProjector 0 *
            ((cSymStepFwd s).eval.1 * R_in) =
          (cSymStepFwd s).eval.1 * R_in := fun i ↦ by
        have hi := hIn0 ⟨i.val + 1, by simp⟩
        have hIdx : (⟨offset + (i.val + 1), by
          simp only [List.length_cons] at hfit; omega⟩ : Fin m_anc) =
            ⟨(offset + 1) + i.val, by omega⟩ := Fin.ext (by dsimp; omega)
        rw [hIdx] at hi
        rw [← Matrix.mul_assoc, hLatComm i, Matrix.mul_assoc, hi]
      have hOutRest : ∀ i : Fin rest.length,
          (QRegister.singleton (rAnc ⟨(offset + 1) + i.val, by omega⟩)).basisOutcomeProjector 0 *
            ((cSymStepFwd s).eval.1 * R_out) =
          (cSymStepFwd s).eval.1 * R_out := fun i ↦ by
        have hi := hOut0 ⟨i.val + 1, by simp⟩
        have hIdx : (⟨offset + (i.val + 1), by
          simp only [List.length_cons] at hfit; omega⟩ : Fin m_anc) =
            ⟨(offset + 1) + i.val, by omega⟩ := Fin.ext (by dsimp; omega)
        rw [hIdx] at hi
        rw [← Matrix.mul_assoc, hLatComm i, Matrix.mul_assoc, hi]
      have hCoreAssoc : ∀ R : Operator (2 ^ n),
          (cSymStepFwdList rest).eval.1 * ((cSymStepFwd s).eval.1 * R) =
            (cSymStepFwdList (s :: rest)).eval.1 * R := fun R ↦ by
        dsimp only [cSymStepFwdList]
        rw [Circuit.eval_seq, Submonoid.coe_mul, Matrix.mul_assoc]
      have hRest := subspaceStep_symWrapDynList v rAnc (offset + 1) rest hvalid_rest hfit_rest
        hInRest hOutRest (by rwa [hCoreAssoc R_in, hCoreAssoc R_out])
      exact subspaceStep_symStep v s hAncIn hAncOut hRest
/-! ## Part 3B: Optional One-Hot Power-of-2 Router Wrapper `dOptPow2Wrap` -/
/-- `0-T`, `0-TOFF` root initialization `X (wOut 0) ;; CNOT rDum (wOut 0)` setting `wOut 0 = 1 +
  rDum`
from clean `wOut 0 = 0`. -/
def cOptRootInit {n : ℕ} (k : ℕ) (uLo : Fin k → Wire n) (wOut : Fin (2 ^ k) → Wire n)
    (rDum wDum qEnc : Wire n) (hInj : WOptInj 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc) : Circuit n :=
  let w0 : Wire n := wOut ⟨0, Nat.two_pow_pos k⟩
  Circuit.X w0 ;;ᶜ Circuit.CNOT rDum w0 (hInj.w_ne_rDum 0 ⟨0, Nat.two_pow_pos k⟩).symm
/-- `0-T`, `0-TOFF` root uninitialization `CNOT rDum (wOut 0) ;; X (wOut 0)` inverse to
  `cOptRootInit`. -/
def cOptRootUninit {n : ℕ} (k : ℕ) (uLo : Fin k → Wire n) (wOut : Fin (2 ^ k) → Wire n)
    (rDum wDum qEnc : Wire n) (hInj : WOptInj 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc) : Circuit n :=
  let w0 : Wire n := wOut ⟨0, Nat.two_pow_pos k⟩
  Circuit.CNOT rDum w0 (hInj.w_ne_rDum 0 ⟨0, Nat.two_pow_pos k⟩).symm ;;ᶜ Circuit.X w0
/-- Bit-assignment image of `ket δ` after optional `2^k`-way one-hot expansion gated by `δ rDum =
  0`. -/
def optOneHotBits {n k : ℕ} (uLo : Fin k → Wire n) (wOut : Fin (2 ^ k) → Wire n)
    (rDum : Wire n) (δ : BitAssignment n) : BitAssignment n := if δ rDum = 0 then
    Function.update δ (wOut ⟨idxValPrefix uLo δ k le_rfl, idxValPrefix_lt_two_pow uLo δ k
    le_rfl⟩) 1 else δ
/-- Combined clean scratch wire list `wDum :: qEnc :: (wOut ++ scrInner)` of `dOptPow2Wrap`. -/
def optPow2AllScr {n k k_in : ℕ} (wDum qEnc : Wire n) (wOut : Fin (2 ^ k) → Wire n)
    (scrInner : Fin k_in → Wire n) : Fin ((2 ^ k + k_in) + 1 + 1) → Wire n := Fin.cons wDum
    (Fin.cons qEnc (Fin.append wOut scrInner))
/-- Optional `2^k`-way one-hot W-router wrapper (`(2 * (2^k - 1) + 2 * k) + dMid.count T` `T`s,
`dMid.count TOFF` `TOFF`s). -/
def dOptPow2Wrap {Var : Type} {n : ℕ} (v : Var) (k : ℕ) (uLo : Fin k → Wire n)
    (wOut : Fin (2 ^ k) → Wire n) (rDum wDum qEnc : Wire n)
    (hInj : WOptInj 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc) (dMid : DynamicCircuit Var n) :
    DynamicCircuit Var n := .seq (.circuit (cOptRootInit k uLo wOut rDum wDum qEnc hInj))
    (.seq (wOptExpandDyn v 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc hInj) (.seq dMid
    (wUncompTreeDyn v 1 k uLo (fun _ ↦ wOut) hInj.w_inj hInj.uLo_ne_w (.circuit
    (cOptRootUninit k uLo wOut rDum wDum qEnc hInj)) k le_rfl)))
@[simp] theorem count_dOptPow2Wrap_toff {Var : Type} {n : ℕ} (v : Var) (k : ℕ)
    (uLo : Fin k → Wire n) (wOut : Fin (2 ^ k) → Wire n) (rDum wDum qEnc : Wire n)
    (hInj : WOptInj 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc) (dMid : DynamicCircuit Var n) :
    (dOptPow2Wrap v k uLo wOut rDum wDum qEnc hInj dMid).count TOFF = dMid.count TOFF := by
  obtain ⟨_, hf1⟩ := count_wOptExpandDyn v 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc hInj
  obtain ⟨_, hf2⟩ := count_wUncompTreeDyn_opt v 1 k uLo (fun _ ↦ wOut) hInj.w_inj hInj.uLo_ne_w
    (.circuit (cOptRootUninit k uLo wOut rDum wDum qEnc hInj)) k le_rfl
  dsimp only [dOptPow2Wrap, DynamicCircuit.count]
  rw [hf1, hf2]
  simp [cOptRootInit, cOptRootUninit, Circuit.CNOT, Circuit.X, Circuit.single]
@[simp] theorem count_dOptPow2Wrap_t {Var : Type} {n : ℕ} (v : Var) (k : ℕ)
    (uLo : Fin k → Wire n) (wOut : Fin (2 ^ k) → Wire n) (rDum wDum qEnc : Wire n)
    (hInj : WOptInj 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc) (dMid : DynamicCircuit Var n) :
    (dOptPow2Wrap v k uLo wOut rDum wDum qEnc hInj dMid).count T =
    (2 * 1 * (2 ^ k - 1) + 2 * k) + dMid.count T := by
  obtain ⟨ht1, _⟩ := count_wOptExpandDyn v 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc hInj
  obtain ⟨ht2, _⟩ := count_wUncompTreeDyn_opt v 1 k uLo (fun _ ↦ wOut) hInj.w_inj hInj.uLo_ne_w
    (.circuit (cOptRootUninit k uLo wOut rDum wDum qEnc hInj)) k le_rfl
  have hcInit : (cOptRootInit k uLo wOut rDum wDum qEnc hInj).count T = 0 := by
    simp [cOptRootInit, Circuit.CNOT, Circuit.X, Circuit.single]
  have hcUninit : (cOptRootUninit k uLo wOut rDum wDum qEnc hInj).count T = 0 := by
    simp [cOptRootUninit, Circuit.CNOT, Circuit.X, Circuit.single]
  dsimp only [dOptPow2Wrap, DynamicCircuit.count]
  rw [hcInit, ht1, ht2]
  dsimp only [DynamicCircuit.count]
  rw [hcUninit]
  omega
theorem optPow2AllScr_zero_iff {n k k_in : ℕ} (wDum qEnc : Wire n)
    (wOut : Fin (2 ^ k) → Wire n) (scrInner : Fin k_in → Wire n) (δ : BitAssignment n) :
    (∀ idx, δ (optPow2AllScr wDum qEnc wOut scrInner idx) = 0) ↔
      (OptBasePred (fun γ ↦ ∀ j : Fin k_in, γ (scrInner j) = 0) wDum qEnc δ ∧
        ∀ (_b : Fin 1) (p : Fin (2 ^ k)), δ (wOut p) = 0) := by
  constructor
  · intro h
    have hwD : δ wDum = 0 := by simpa [optPow2AllScr] using h 0
    have hqE : δ qEnc = 0 := by simpa [optPow2AllScr] using h (Fin.succ 0)
    have hwO : ∀ p : Fin (2 ^ k), δ (wOut p) = 0 := fun p ↦ by
      simpa [optPow2AllScr, Fin.append_left] using h (Fin.succ (Fin.succ (Fin.castAdd k_in p)))
    have hsI : ∀ j : Fin k_in, δ (scrInner j) = 0 := fun j ↦ by
      simpa [optPow2AllScr, Fin.append_right] using h (Fin.succ (Fin.succ (Fin.natAdd (2 ^ k) j)))
    exact ⟨⟨hsI, hwD, hqE⟩, fun _ p ↦ hwO p⟩
  · rintro ⟨⟨hsI, hwD, hqE⟩, hwO⟩ idx
    refine Fin.cases ?_ (fun idx₁ ↦ Fin.cases ?_ (fun idx₂ ↦ ?_) idx₁) idx
    · simpa [optPow2AllScr] using hwD
    · simpa [optPow2AllScr] using hqE
    · refine Fin.addCases (fun p ↦ ?_) (fun j ↦ ?_) idx₂
      · simpa [optPow2AllScr, Fin.append_left] using hwO 0 p
      · simpa [optPow2AllScr, Fin.append_right] using hsI j
theorem dOptPow2Wrap_constCleanUnitary_diagZ8 {Var : Type} [Fintype Var] [DecidableEq Var]
    {n k k_in : ℕ} (v : Var) (uLo : Fin k → Wire n) (wOut : Fin (2 ^ k) → Wire n)
    (rDum wDum qEnc : Wire n) (hInj : WOptInj 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc)
    (scrInner : Fin k_in → Wire n) (hScr_ne_wOut : ∀ (j : Fin k_in) (p : Fin (2 ^ k)),
    scrInner j ≠ wOut p) {dMid : DynamicCircuit Var n} {pMid : BitAssignment n → ZMod 8}
    (hdMid_pres : PreservesStoreConst dMid) (hdMid : RealizesCleanUnitary v (projZeroAll k_in
    scrInner) dMid (diagZ8UnitaryN pMid)) : p2t_RealizesConstCleanUnitary (projZeroAll ((2 ^ k
    + k_in) + 1 + 1) (optPow2AllScr wDum qEnc wOut scrInner))
    (dOptPow2Wrap v k uLo wOut rDum wDum qEnc hInj dMid)
    (diagZ8UnitaryN fun δ ↦ pMid (optOneHotBits uLo wOut rDum δ)) := by
  let P : BitAssignment n → Prop := fun γ ↦ ∀ j : Fin k_in, γ (scrInner j) = 0
  let act : BitAssignment n → Prop := fun γ ↦ γ rDum = 0
  let bStar : BitAssignment n → Fin 1 := fun _ ↦ 0
  let scrAll := optPow2AllScr wDum qEnc wOut scrInner
  let P_all := projZeroAll ((2 ^ k + k_in) + 1 + 1) scrAll
  let R_0 := oneHotOptPreOp (OptBasePred P wDum qEnc) act bStar uLo (fun _ ↦ wOut) 0 (Nat.zero_le k)
  let R_k := oneHotOptPreOp (OptBasePred P wDum qEnc) act bStar uLo (fun _ ↦ wOut) k le_rfl
  let cInit := cOptRootInit k uLo wOut rDum wDum qEnc hInj
  let cUninit := cOptRootUninit k uLo wOut rDum wDum qEnc hInj
  let pOut : BitAssignment n → ZMod 8 := fun δ ↦ pMid (optOneHotBits uLo wOut rDum δ)
  let U_out := diagZ8UnitaryN pOut
  have hPAll_sa : P_allᴴ = P_all := projZeroAll_conjTranspose _ scrAll
  have hPIn_sa : (projZeroAll k_in scrInner)ᴴ = projZeroAll k_in scrInner :=
    projZeroAll_conjTranspose k_in scrInner
  have hInitEq : cInit.eval.1 * P_all = R_0 := by
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro δ
    rw [← Matrix.mulVec_mulVec, ket_projZeroAll]
    dsimp only [R_0, oneHotOptPreOp]
    rw [MultiBankWStateRouter.mkVecOp_mulVec_ket]
    dsimp only [oneHotOptPreVec]
    have hIff := optPow2AllScr_zero_iff wDum qEnc wOut scrInner δ
    by_cases hCond : OptBasePred P wDum qEnc δ ∧ ∀ (_b : Fin 1) (p : Fin (2 ^ k)), δ (wOut p) = 0
    · have hAll : ∀ idx, δ (scrAll idx) = 0 := hIff.mpr hCond
      rw [ite_true_eq hAll, ite_true_eq hCond]
      dsimp only [cInit, cOptRootInit]
      let w0 : Wire n := wOut ⟨0, Nat.two_pow_pos k⟩
      have hw0_zero : δ w0 = 0 := hCond.2 0 ⟨0, Nat.two_pow_pos k⟩
      have hne0 := (hInj.w_ne_rDum 0 ⟨0, Nat.two_pow_pos k⟩).symm
      rw [mbh_ket_eq_ket, OctahedralOrbit.eval_seq_mulVec, OctahedralOrbit.ket_X,
        OctahedralOrbit.ket_CNOT]
      have hupd0 : Function.update δ w0 (δ w0 + 1) rDum = δ rDum :=
        Function.update_of_ne hne0 _ _
      rw [Function.update_self, Function.update_idem, hupd0, hw0_zero, zero_add]
      split_ifs with hAct
      · have hidx0 : ∀ hp, (⟨idxValPrefix uLo δ 0 (Nat.zero_le k), hp⟩ : Fin (2 ^ k)) =
            ⟨0, Nat.two_pow_pos k⟩ := fun _ ↦ Fin.ext (by simp [idxValPrefix])
        rw [hidx0]
        dsimp only [act] at hAct
        rw [hAct, add_zero, ← mbh_ket_eq_ket]
      · dsimp only [act] at hAct
        have hr1 : δ rDum = 1 := by
          rcases bit_cases (δ rDum) with h0 | h1
          · exact False.elim (hAct h0)
          · exact h1
        have h11 : (1 : ZMod 2) + 1 = 0 := by decide
        rw [hr1, h11, ← hw0_zero, Function.update_eq_self, ← mbh_ket_eq_ket]
    · have hNotAll : ¬∀ idx, δ (scrAll idx) = 0 := mt hIff.mp hCond
      rw [ite_false_eq hNotAll, ite_false_eq hCond, Matrix.mulVec_zero]
  have hUninitEq : cUninit.eval.1 * R_0 = P_all := by
    have hInv : cUninit.eval.1 * cInit.eval.1 = 1 := by
      apply MeasureBranchHadamardSem.matrix_ext_ket
      intro γ
      rw [Matrix.one_mulVec, ← Matrix.mulVec_mulVec]
      dsimp only [cInit, cUninit, cOptRootInit, cOptRootUninit]
      let w0 : Wire n := wOut ⟨0, Nat.two_pow_pos k⟩
      have hne0 := (hInj.w_ne_rDum 0 ⟨0, Nat.two_pow_pos k⟩).symm
      rw [mbh_ket_eq_ket, OctahedralOrbit.eval_seq_mulVec, OctahedralOrbit.eval_seq_mulVec,
          OctahedralOrbit.ket_X, OctahedralOrbit.ket_CNOT,
          OctahedralOrbit.ket_CNOT, OctahedralOrbit.ket_X]
      simp only [Function.update_self, Function.update_idem, Function.update_of_ne hne0]
      have hcancel : γ w0 + 1 + γ rDum + γ rDum + 1 = γ w0 := by
        rcases bit_cases (γ w0) with a | a <;> rcases bit_cases (γ rDum) with b | b <;>
          (rw [a, b]; decide)
      rw [hcancel, Function.update_eq_self]
    rw [← hInitEq, ← Matrix.mul_assoc, hInv, Matrix.one_mul]
  have hStep1 : SubspaceStep (Var := Var) P_all R_0 (.circuit cInit) :=
    subspaceStep_congr_out (subspaceStep_of_circuit P_all cInit) hInitEq
  have hStep2 : SubspaceStep R_0 R_k (wOptExpandDyn v 1 k uLo (fun _ ↦ wOut) rDum wDum qEnc hInj) :=
    subspaceStep_wOptExpandDyn v P act bStar uLo (fun _ ↦ wOut) rDum wDum qEnc hInj fun δ _ ↦ by
      rcases bit_cases (δ rDum) with h | h <;> simp [act, h]
  have hMidConst : p2t_RealizesConstCleanUnitary (projZeroAll k_in scrInner) dMid (diagZ8UnitaryN
    pMid) :=
    p2t_RealizesConstCleanUnitary_of_clean v hPIn_sa hdMid_pres hdMid
  have hProjRk : projZeroAll k_in scrInner * R_k = R_k := by
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro δ
    rw [← Matrix.mulVec_mulVec]
    dsimp only [R_k, oneHotOptPreOp]
    rw [MultiBankWStateRouter.mkVecOp_mulVec_ket]
    dsimp only [oneHotOptPreVec]
    split_ifs with hCond hAct
    · rw [ket_projZeroAll]
      have hall0 : ∀ j : Fin k_in, Function.update δ (wOut ⟨idxValPrefix uLo δ k le_rfl,
          Nat.lt_of_lt_of_le (idxValPrefix_lt_two_pow uLo δ k le_rfl) (Nat.pow_le_pow_right
          (by omega) le_rfl)⟩) 1 (scrInner j) = 0 :=
        fun j ↦ by rw [Function.update_of_ne (hScr_ne_wOut j _), hCond.1.1 j]
      rw [ite_true_eq hall0]
    · rw [ket_projZeroAll, ite_true_eq hCond.1.1]
    · rw [Matrix.mulVec_zero]
  have hDiagRk : (diagZ8UnitaryN pMid).1 * R_k = R_k * U_out.1 := by
    apply MeasureBranchHadamardSem.matrix_ext_ket
    intro δ
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    dsimp only [U_out, R_k, oneHotOptPreOp]
    rw [mbh_ket_eq_ket, ket_diagZ8UnitaryN, Matrix.mulVec_smul,
        ← mbh_ket_eq_ket, MultiBankWStateRouter.mkVecOp_mulVec_ket]
    dsimp only [oneHotOptPreVec]
    split_ifs with hCond hAct
    · have hOpt : optOneHotBits uLo wOut rDum δ =
          Function.update δ (wOut ⟨idxValPrefix uLo δ k le_rfl,
            idxValPrefix_lt_two_pow uLo δ k le_rfl⟩) 1 := by
        dsimp only [optOneHotBits]; rw [ite_true_eq hAct]
      rw [mbh_ket_eq_ket, ket_diagZ8UnitaryN]
      dsimp only [pOut, bStar]
      rw [hOpt, ← mbh_ket_eq_ket]
    · have hOpt : optOneHotBits uLo wOut rDum δ = δ := by
        dsimp only [optOneHotBits]; rw [ite_false_eq hAct]
      rw [mbh_ket_eq_ket, ket_diagZ8UnitaryN]
      dsimp only [pOut]
      rw [hOpt, ← mbh_ket_eq_ket]
    · rw [Matrix.mulVec_zero, smul_zero]
  have hStep3 : SubspaceStep R_k (R_k * U_out.1) dMid :=
    subspaceStep_congr_out (SubspaceStep.ofConstCleanUnitary hPIn_sa hMidConst hProjRk) hDiagRk
  have hStepUninit : SubspaceStep (Var := Var) R_0 P_all (.circuit cUninit) :=
