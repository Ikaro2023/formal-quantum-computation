def rCombPeb {n mPayload mWB : ℕ} (rCore : QRegister (fullSysCoreWires mPayload) n)
    (rWB : QRegister mWB n) (hWB : 114 ≤ mWB) (hCW : rCore.DisjointWires rWB) :
    QRegister (fullSysCoreWires mPayload + 8 + 106) n :=
  let rIdx8 := rWB.slice 0 8 (by omega)
  let rCln106 := rWB.slice 8 106 (by omega)
  have hCI : rCore.DisjointWires rIdx8 := hCW.compose_right _
  have hCC : rCore.DisjointWires rCln106 := hCW.compose_right _
  have hIC : rIdx8.DisjointWires rCln106 :=
    rWB.slice_disjoint_of_le 0 8 8 106 (by omega) (by omega) le_rfl
  (rCore.concat rIdx8 hCI).concat rCln106 (qreg_disjoint_concat_left hCC hIC)
theorem rCombPeb_lt_core {n mPayload mWB : ℕ}
    (rCore : QRegister (fullSysCoreWires mPayload) n)
    (rWB : QRegister mWB n) (hWB : 114 ≤ mWB) (hCW : rCore.DisjointWires rWB)
    (i : Fin (fullSysCoreWires mPayload)) :
    rCombPeb rCore rWB hWB hCW ⟨i.val, by have := i.isLt; omega⟩ = rCore i := by
  have heq : (⟨i.val, by have := i.isLt; omega⟩ :
      Fin (fullSysCoreWires mPayload + 8 + 106)) =
      Fin.castAdd 106 (Fin.castAdd 8 i) := Fin.ext rfl
  rw [heq]
  dsimp only [rCombPeb]
  rw [QRegister.concat_apply_left, QRegister.concat_apply_left]
theorem rCombPeb_cln106 {n mPayload mWB : ℕ}
    (rCore : QRegister (fullSysCoreWires mPayload) n)
    (rWB : QRegister mWB n) (hWB : 114 ≤ mWB) (hCW : rCore.DisjointWires rWB)
    (k : Fin 106) :
    rCombPeb rCore rWB hWB hCW
      ⟨fullSysCoreWires mPayload + 8 + k.val, by have := k.isLt; omega⟩ =
      rWB ⟨8 + k.val, by have := k.isLt; omega⟩ := by
  have heq : (⟨fullSysCoreWires mPayload + 8 + k.val, by have := k.isLt; omega⟩ :
      Fin (fullSysCoreWires mPayload + 8 + 106)) =
      Fin.natAdd (fullSysCoreWires mPayload + 8) k := Fin.ext rfl
  rw [heq]
  dsimp only [rCombPeb]
  rw [QRegister.concat_apply_right]
  rfl
theorem singleton_rWB_mul_proj0 {n mWB : ℕ} (rWB : QRegister mWB n) (j : Fin mWB) :
    (QRegister.singleton (rWB j)).basisOutcomeProjector 0 * rWB.basisOutcomeProjector 0 =
      rWB.basisOutcomeProjector 0 := by
  apply matrix_ext_ket
  intro β
  rw [Internal.mul_mulVec_prog, ket_basisOutcomeProjector_zero]
  by_cases hz : ∀ k : Fin mWB, β (rWB k) = 0
  · simp [hz, ket_projector_zero]
  · simp [hz]
theorem hasCleanTailFrom_rWB_proj0 {n mPayload mWB : ℕ}
    (rCore : QRegister (fullSysCoreWires mPayload) n)
    (rWB : QRegister mWB n) (hWB : 114 ≤ mWB) (hCW : rCore.DisjointWires rWB) :
    HasCleanTailFrom (rCombPeb rCore rWB hWB hCW) (fullSysCoreWires mPayload + 8)
      (rWB.basisOutcomeProjector 0) := by
  intro q hq
  let k : Fin 106 := ⟨q.val - (fullSysCoreWires mPayload + 8), by have := q.isLt; omega⟩
  have hqk : q = ⟨fullSysCoreWires mPayload + 8 + k.val, by have := k.isLt; omega⟩ :=
    Fin.ext (by dsimp [k]; omega)
