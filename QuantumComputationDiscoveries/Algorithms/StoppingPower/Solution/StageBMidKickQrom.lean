  have h2 := ScopedBlock.withLitAnd_block (M := mBAux B)
    (91 + B) (by dsimp [mBAux]; omega)
    ⟨0, by dsimp [mBAux]; omega⟩ true ⟨86, by dsimp [mBAux]; omega⟩ false
    (wire_ne_of_lt (show (0 : ℕ) < 86 by decide))
    (show (0 : ℕ) < 91 + B by omega)
    (show (86 : ℕ) < 91 + B by omega)
    (h3.cast_rem (by dsimp [mBAux]; omega))
  have h1 := (ScopedBlock.withLitAnd_block (M := mBAux B)
    (90 + B) (by dsimp [mBAux]; omega)
    ⟨2, by dsimp [mBAux]; omega⟩ true ⟨1, by dsimp [mBAux]; omega⟩ true
    (wire_ne_of_gt (show (1 : ℕ) < 2 by decide))
    (show (2 : ℕ) < 90 + B by omega)
    (show (1 : ℕ) < 90 + B by omega)
    (h2.cast_rem (by dsimp [mBAux]; omega))).cast_rem
      (rem₂ := B + 10) (by dsimp [mBAux]; omega)
  refine ⟨_, h1, fun γ hγ ↦ ?_⟩
  dsimp only [Function.comp_apply]
  generalize hg1 : stepLitAnd (90 + B) _ _ _ _ _ γ = g1
  generalize hg2 : stepLitAnd (91 + B) _ _ _ _ _ g1 = g2
  generalize hg3 : stepLitAnd (92 + B) _ _ _ _ _ g2 = g3
  generalize hg4 : stepLitAnd (93 + B) _ _ _ _ _ g3 = g4
  generalize hg5 : stepLitAnd (94 + B) _ _ _ _ _ g4 = g5
  generalize hg6 : stepLitAnd (95 + B) _ _ _ _ _ g5 = g6
  obtain ⟨hne1, heq1⟩ := eval_stepLitAnd hg1
  obtain ⟨hne2, heq2⟩ := eval_stepLitAnd hg2
  obtain ⟨hne3, heq3⟩ := eval_stepLitAnd hg3
  obtain ⟨hne4, heq4⟩ := eval_stepLitAnd hg4
  obtain ⟨hne5, heq5⟩ := eval_stepLitAnd hg5
  obtain ⟨hne6, heq6⟩ := eval_stepLitAnd hg6
  have hb1 : ∀ w : Wire (mBAux B), w.val < 90 + B → g1 w = γ w := fun w hw ↦ hne1 w (by omega)
  have hb2 : ∀ w : Wire (mBAux B), w.val < 90 + B → g2 w = γ w := fun w hw ↦
