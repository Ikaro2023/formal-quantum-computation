/-- Full leaf wire specification for `ctxMidB` (`B + 9` `TempAnd`s). -/
def midBSpec (B : ℕ) (φ γ : BitAssignment (mBAux B)) (keepLt : ZMod 2) : Prop :=
  let s0 := γ ⟨0, by dsimp [mBAux]; omega⟩
  let b1 := γ ⟨1, by dsimp [mBAux]; omega⟩
  let b2 := γ ⟨2, by dsimp [mBAux]; omega⟩
  let sr := γ ⟨68, by dsimp [mBAux]; omega⟩
  let ih := γ ⟨36, by dsimp [mBAux]; omega⟩
  let rz := γ ⟨85, by dsimp [mBAux]; omega⟩
  let ge216 := γ ⟨86, by dsimp [mBAux]; omega⟩
  let ge218 := γ ⟨87, by dsimp [mBAux]; omega⟩
  let ge217 := γ ⟨88, by dsimp [mBAux]; omega⟩
  let tSign := γ ⟨89 + B, by dsimp [mBAux]; omega⟩
  let u1 := (1 + b2) * (1 + b1)
  let d0 := (1 + s0) * ge216
  let u2 := (1 + sr) * (1 + ge218)
  let u3 := u2 * (1 + d0)
  let vL := u1 * u3
  let d3 := s0 * ge217
  let d6 := (keepLt * (1 + d3)) * (1 + (tSign + rz + s0))
  (∀ w : Wire (mBAux B), w.val < 90 + B → φ w = γ w) ∧
  φ ⟨90 + B, by dsimp [mBAux]; omega⟩ = u1 ∧
  φ ⟨94 + B, by dsimp [mBAux]; omega⟩ = vL ∧
  φ ⟨96 + 2 * B + 2, by dsimp [mBAux]; omega⟩ = d6 ∧
  φ ⟨96 + 2 * B + 3, by dsimp [mBAux]; omega⟩ = ih * (rz + d6)
