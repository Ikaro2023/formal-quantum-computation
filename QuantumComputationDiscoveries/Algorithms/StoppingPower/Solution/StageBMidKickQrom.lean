theorem pLoadMK108_spec (K H : ℕ) (hH54 : H ≤ 54) (c : Configuration) (w : Fin 3) :
    let M := (K + (56 + H)) + (56 - H)
    RevTempPerm.ValidCleanRem M (56 - H) (pLoadMK108 K H hH54 c w) ∧
    ∀ β : BitAssignment M, CleanRem M (56 - H) β →
      (∀ q : Wire M, K ≤ q.val → (pLoadMK108 K H hH54 c w).evalBits β q = β q) ∧
      (∀ k : Fin K,
        (pLoadMK108 K H hH54 c w).evalBits β ⟨k.val, by omega⟩ =
          β ⟨k.val, by omega⟩ +
            localBit108 K H hH54 c w (fun q : Fin (56 + H) ↦ β ⟨K + q.val, by omega⟩) k) := by
  intro M
  obtain ⟨hvLeaf, hLoopEval⟩ := selectSwapXorBitLoop_eval_any (M := M) (K + 2) 108 K (by omega)
    (by dsimp [M]; omega) (by dsimp [M]; omega)
    ⟨K, by dsimp [M]; omega⟩ le_rfl (by dsimp; omega) (lo216Table K c w) K le_rfl
  have hLeafEq : selectSwapXorBitLoop (M := M) (K + 2) 108 K (by omega) (by dsimp [M]; omega)
      ⟨K, by dsimp [M]; omega⟩ le_rfl (by dsimp; omega) (lo216Table K c w) K le_rfl =
      leafLoadMK108 K H hH54 c w :=
    (vepLockVal_eq _).symm
  rw [hLeafEq] at hvLeaf hLoopEval
  have hLeafAlloc : ScopedAlloc M K (M - ((K + 2) + 2 * 54)) 2
      (fun γ δ ↦ δ = γ) (leafLoadMK108 K H hH54 c w) (leafLoadMK108 K H hH54 c w) :=
    ScopedAlloc.cast_rem (by dsimp [M]; omega)
      (ScopedAlloc.id_leaf (K_mut := K) hvLeaf (fun γ hγ ↦ (hLoopEval γ hγ).1))
  have h1 : ScopedAlloc M K (56 - H) 2
      (fun β δ ↦ ∃ γ, RevTempPerm.SplitRangePost (M := M) (K + 2) 54 (54 - H)
        (by dsimp [M]; omega) ⟨K + 1, by dsimp [M]; omega⟩ β γ ∧ δ = γ)
      (leafLoadMK108 K H hH54 c w)
      (RevTempPerm.withUnarySplitRange (M := M) (K + 2) 54
        ⟨K + 1, by dsimp [M]; omega⟩ (by dsimp; omega) (by dsimp [M]; omega)
        (54 - H) (by omega) (leafLoadMK108 K H hH54 c w)) :=
    ScopedAlloc.cast_rem (by dsimp [M]; omega)
      (ScopedAlloc.withUnarySplitRange_alloc (M := M) (K_mut := K) (K + 2) 54
        ⟨K + 1, by dsimp [M]; omega⟩ (by dsimp; omega) (by dsimp; omega) (by dsimp [M]; omega)
        (54 - H) (by omega) hLeafAlloc)
  rw [pLoadMK108, vepLockVal_eq]
  refine ⟨h1.1, fun β hβ ↦ ?_⟩
  obtain ⟨hhigh, δ, hclδ, ⟨γ, ⟨hbelow, hsplit⟩, hδγ⟩, hlow⟩ := h1.2 β hβ
  subst hδγ
  obtain ⟨_, _, hmid⟩ := hLoopEval δ hclδ
  have hδK : δ ⟨K, by dsimp [M]; omega⟩ = β ⟨K, by dsimp [M]; omega⟩ :=
    hbelow ⟨K, by dsimp [M]; omega⟩ (Or.inl (by dsimp; omega))
  have hδ_u108 : ∀ a : Fin 108,
      δ ⟨(K + 2) + a.val, by dsimp [M]; omega⟩ =
        u108 H hH54 (fun q : Fin (56 + H) ↦ β ⟨K + q.val, by dsimp [M]; omega⟩) a := fun a ↦ by
    dsimp only [u108]
    by_cases ha1 : a.val < H
    · rw [dite_pos_eq ha1,
        hbelow ⟨(K + 2) + a.val, by dsimp [M]; omega⟩ (Or.inl (by dsimp; omega))]
      exact congrArg β (Fin.ext (by dsimp; omega))
    · rw [dite_neg_eq ha1]
      by_cases ha2 : a.val < 54
      · rw [dite_pos_eq ha2, (hsplit a.val (by omega) ha2).1]
        have h1' : (⟨(K + 2) + a.val, by dsimp [M]; omega⟩ : Wire M) =
            ⟨K + (2 + a.val), by dsimp [M]; omega⟩ := Fin.ext (by dsimp; omega)
        rw [h1']
      · rw [dite_neg_eq ha2]
        by_cases ha3 : a.val < 54 + H
        · rw [dite_pos_eq ha3,
            hbelow ⟨(K + 2) + a.val, by dsimp [M]; omega⟩
              (Or.inr ⟨by dsimp; omega, by dsimp; omega⟩)]
          exact congrArg β (Fin.ext (by dsimp; omega))
        · rw [dite_neg_eq ha3]
          let i := a.val - 54
          have hiH : 54 - (54 - H) ≤ i := by dsimp [i]; omega
          have hi54 : i < 54 := by have := a.isLt; dsimp [i]; omega
          have hpos : (⟨(K + 2) + a.val, by dsimp [M]; omega⟩ : Wire M) =
              ⟨(K + 2) + 54 + i, by dsimp [M]; omega⟩ := Fin.ext (by dsimp [i]; omega)
          rw [hpos, (hsplit i hiH hi54).2]
          have h1' : (⟨(K + 2) + i, by dsimp [M]; omega⟩ : Wire M) =
              ⟨K + (2 + i), by dsimp [M]; omega⟩ := Fin.ext (by dsimp; omega)
          rw [h1']
  refine ⟨hhigh, fun k ↦ ?_⟩
  let wk : Wire M := ⟨k.val, by dsimp [M]; omega⟩
  have hstep_k := hlow wk k.isLt
  have hδ_k : δ wk = β wk := hbelow wk (Or.inl (by have := k.isLt; dsimp [wk]; omega))
  rw [hstep_k, hmid wk (by dsimp [wk]; omega) k.isLt, hδ_k, hδK, add_assoc,
    localBit108, vepLockVal_eq]
  dsimp only [wk]
  have hK0 : β ⟨K, by dsimp [M]; omega⟩ =
      β ⟨K + (⟨0, by omega⟩ : Fin (56 + H)).val, by dsimp [M]; omega⟩ :=
    congrArg β (Fin.ext (by dsimp))
  rw [hK0]
  refine congrArg (β ⟨k.val, by dsimp [M]; omega⟩ + ·) ?_
  refine congrArg₂ HAdd.hAdd (Finset.sum_congr rfl fun a _ ↦ ?_)
    (congrArg (β ⟨K + (⟨0, by omega⟩ : Fin (56 + H)).val, by dsimp [M]; omega⟩ * ·)
      (Finset.sum_congr rfl fun a _ ↦ ?_))
  · rw [hδ_u108 a]
  · rw [hδ_u108 a]
theorem sum_fin108_pair_split (g : Fin 108 → ZMod 2) :
    (∑ a : Fin 108, g a) = ∑ i : Fin 54, (g (Fin.castAdd 54 i) + g (Fin.natAdd 54 i)) := by
  let e : Fin 54 ⊕ Fin 54 ≃ Fin 108 := finSumFinEquiv.trans (finCongr (by decide))
  rw [← Equiv.sum_comp e, Fintype.sum_sum_type, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ ↦ congrArg₂ HAdd.hAdd ?_ ?_
  · exact congrArg g (Fin.ext rfl)
  · exact congrArg g (Fin.ext rfl)
theorem loadMK108_eq_sum54 {mPayload : ℕ} (K H : ℕ) (hH54 : H ≤ 54)
    (c : Configuration) (hm : 22 ≤ mPayload) (w : Fin 3)
    (xCH : BitAssignment ((fullSysCoreWires mPayload + 61) + H)) (k : Fin K) :
    let kC := fullSysCoreWires mPayload
    let b0 := xCH (Fin.castAdd H (Fin.castAdd 61 (rNucIdx hm (QRegExt.idReg kC) ⟨0, by decide⟩)))
    let b1 := xCH (Fin.castAdd H (Fin.castAdd 61 (rNucIdx hm (QRegExt.idReg kC) ⟨1, by decide⟩)))
    let xHi : Fin 54 → ZMod 2 := fun i ↦ xCH (Fin.castAdd H (Fin.natAdd kC ⟨7 + i.val, by omega⟩))
    let xPre : Fin H → ZMod 2 := fun m ↦ xCH (Fin.natAdd (kC + 61) m)
    loadMK108BitFn K H hH54 c hm w xCH k =
      (∑ i : Fin 54,
        ((if (mkEntry54 K c w i false false).testBit k.val then uLeaf54 b1 xHi xPre i false else
          0) +
         (if (mkEntry54 K c w i true false).testBit k.val then uLeaf54 b1 xHi xPre i true else
           0))) +
      b0 *
        (∑ i : Fin 54,
          ((if xor ((mkEntry54 K c w i false false).testBit k.val)
                   ((mkEntry54 K c w i false true).testBit k.val) then
              uLeaf54 b1 xHi xPre i false else 0) +
           (if xor ((mkEntry54 K c w i true false).testBit k.val)
                   ((mkEntry54 K c w i true true).testBit k.val) then
              uLeaf54 b1 xHi xPre i true else 0))) := by
  intro kC b0 b1 xHi xPre
  rw [loadMK108BitFn, localBit108, vepLockVal_eq]
  have hCtrl0 : xCH (subCtrl54 hm H ⟨0, by omega⟩) = b0 := rfl
  rw [hCtrl0]
  have h108_u : ∀ i : Fin 54,
      u108 H hH54 (fun q ↦ xCH (subCtrl54 hm H q)) (Fin.castAdd 54 i) =
        uLeaf54 b1 xHi xPre i false ∧
      u108 H hH54 (fun q ↦ xCH (subCtrl54 hm H q)) (Fin.natAdd 54 i) =
        uLeaf54 b1 xHi xPre i true := fun i ↦ by
    have hi54 := i.isLt
    have hHi_i : xCH (subCtrl54 hm H ⟨2 + i.val, by omega⟩) = xHi i := by
      dsimp only [subCtrl54, xHi, QRegister.wires, Function.Embedding.coeFn_mk]
      rw [ite_neg_eq (by omega), ite_neg_eq (by omega), dite_pos_eq (by omega)]
      exact congrArg xCH (congrArg (Fin.castAdd H) (congrArg (Fin.natAdd kC) (Fin.ext (by
        dsimp;
          omega))))
    have hB1 : xCH (subCtrl54 hm H ⟨1, by omega⟩) = b1 := rfl
    constructor
    · dsimp only [u108, uLeaf54, Fin.val_castAdd]
      by_cases hiH : i.val < H
      · rw [dite_pos_eq hiH, dite_pos_eq hiH]; exact hHi_i
      · rw [dite_neg_eq hiH, dite_pos_eq hi54, dite_neg_eq hiH]
        simp only [Bool.false_eq_true, ↓reduceIte, hHi_i, hB1]
    · dsimp only [u108, uLeaf54, Fin.val_natAdd]
      rw [dite_neg_eq (by omega), dite_neg_eq (by omega)]
      by_cases hiH : i.val < H
      · rw [dite_pos_eq (by omega : 54 + i.val < 54 + H), dite_pos_eq hiH]
        dsimp only [subCtrl54, xPre, QRegister.wires, Function.Embedding.coeFn_mk]
        rw [ite_neg_eq (by omega), ite_neg_eq (by omega), dite_neg_eq (by omega)]
        exact congrArg xCH (congrArg (Fin.natAdd (kC + 61)) (Fin.ext (by dsimp; omega)))
      · rw [dite_neg_eq (by omega : ¬(54 + i.val < 54 + H)), dite_neg_eq hiH]
        have hSub : (⟨2 + (54 + i.val - 54), by omega⟩ : Fin (56 + H)) = ⟨2 + i.val, by omega⟩ :=
          Fin.ext (by dsimp; omega)
        simp only [↓reduceIte, hSub, hHi_i, hB1]
  have h108_tbl : ∀ i : Fin 54,
      lo216Table K c w ⟨2 * i.val, by omega⟩ = mkEntry54 K c w i false false ∧
      lo216Table K c w ⟨2 * i.val + 1, by omega⟩ = mkEntry54 K c w i false true ∧
      lo216Table K c w ⟨2 * (54 + i.val), by omega⟩ = mkEntry54 K c w i true false ∧
      lo216Table K c w ⟨2 * (54 + i.val) + 1, by omega⟩ = mkEntry54 K c w i true true := fun i ↦ by
    have hi54 := i.isLt
    refine ⟨?_, ?_, ?_, ?_⟩ <;> dsimp only [lo216Table, mkEntry54]
    · rw [dite_pos_eq (by omega : (2 * i.val) / 2 < 54)]
      exact congrArg (fun idx ↦
        Nat.shiftRight (nuclearM48 c idx w) (48 - K)) (Fin.ext (by dsimp; omega))
    · rw [dite_pos_eq (by omega : (2 * i.val + 1) / 2 < 54)]
      exact congrArg (fun idx ↦
        Nat.shiftRight (nuclearM48 c idx w) (48 - K)) (Fin.ext (by dsimp; omega))
    · rw [dite_neg_eq (by omega : ¬((2 * (54 + i.val)) / 2 < 54))]
      exact congrArg (fun idx ↦
        Nat.shiftRight (nuclearM48 c idx w) (48 - K)) (Fin.ext (by dsimp; omega))
    · rw [dite_neg_eq (by omega : ¬((2 * (54 + i.val) + 1) / 2 < 54))]
      exact congrArg (fun idx ↦
        Nat.shiftRight (nuclearM48 c idx w) (48 - K)) (Fin.ext (by dsimp; omega))
  rw [sum_fin108_pair_split, sum_fin108_pair_split]
  refine congrArg₂ HAdd.hAdd (Finset.sum_congr rfl fun i _ ↦ ?_)
    (congrArg (b0 * ·) (Finset.sum_congr rfl fun i _ ↦ ?_))
  · simp only [Fin.val_castAdd, Fin.val_natAdd,
      (h108_tbl i).1, (h108_tbl i).2.2.1, (h108_u i).1, (h108_u i).2]
  · simp only [Fin.val_castAdd, Fin.val_natAdd,
      (h108_tbl i).1, (h108_tbl i).2.1, (h108_tbl i).2.2.1, (h108_tbl i).2.2.2, (h108_u i).1,
        (h108_u i).2]
/-- `(4 * ((54 - H) + K)) T`, `0 .TOFF` unified `108`-leaf nuclear loader on `rAnc : QRegister mAnc
  n`
(`56 - H ≤ mAnc`). -/
noncomputable def dLoadMK108Anc {Var : Type} {mPayload K H mAnc n : ℕ}
    (hmClean : 56 - H ≤ mAnc) (hH54 : H ≤ 54) (c : Configuration) (hm : 22 ≤ mPayload)
    (v : Var) (w : Fin 3) (rCH : QRegister ((fullSysCoreWires mPayload + 61) + H) n)
    (rMK : QRegister K n) (rAnc : QRegister mAnc n) (hCHM : rCH.DisjointWires rMK)
    (hCHA : rCH.DisjointWires rAnc) (hMKA : rMK.DisjointWires rAnc) : DynamicCircuit Var n :=
    dProgOfRevTempAnc v rCH rMK rAnc hCHM hCHA hMKA (subCtrl54 hm H) hmClean
    (pLoadMK108 K H hH54 c w)
@[local simp] theorem count_dLoadMK108Anc_toff {Var : Type} {mPayload K H mAnc n : ℕ}
    (hmClean : 56 - H ≤ mAnc) (hH54 : H ≤ 54) (c : Configuration) (hm : 22 ≤
      mPayload) (v : Var) (w : Fin 3)
    (rCH : QRegister ((fullSysCoreWires mPayload + 61) + H) n)
    (rMK : QRegister K n) (rAnc : QRegister mAnc n)
    (hCHM : rCH.DisjointWires rMK) (hCHA : rCH.DisjointWires rAnc) (hMKA : rMK.DisjointWires rAnc) :
    (dLoadMK108Anc hmClean hH54 c hm v w rCH rMK rAnc hCHM hCHA hMKA).count .TOFF = 0 := by
  simp [dLoadMK108Anc, count_dProgOfRevTempAnc_toff]
@[local simp] theorem count_dLoadMK108Anc_t {Var : Type} {mPayload K H mAnc n : ℕ}
    (hmClean : 56 - H ≤ mAnc) (hH54 : H ≤ 54) (c : Configuration) (hm : 22 ≤ mPayload)
    (v : Var) (w : Fin 3) (rCH : QRegister ((fullSysCoreWires mPayload + 61) + H) n)
    (rMK : QRegister K n) (rAnc : QRegister mAnc n) (hCHM : rCH.DisjointWires rMK)
    (hCHA : rCH.DisjointWires rAnc) (hMKA : rMK.DisjointWires rAnc) : (dLoadMK108Anc hmClean
    hH54 c hm v w rCH rMK rAnc hCHM hCHA hMKA).count .T = 4 * ((54 - H) + K) := by
  simp [dLoadMK108Anc, count_dProgOfRevTempAnc_t]
theorem dLoadMK108Anc_realizesPair {Var : Type} [Fintype Var] [DecidableEq Var]
    {mPayload K H mAnc n : ℕ} [NeZero (2 ^ n)] (hmClean : 56 - H ≤ mAnc) (hH54 : H ≤ 54)
    (c : Configuration) (hm : 22 ≤ mPayload) (v : Var) (w : Fin 3)
    (rCH : QRegister ((fullSysCoreWires mPayload + 61) + H) n) (rMK : QRegister K n)
    (rAnc : QRegister mAnc n) (hCHM : rCH.DisjointWires rMK) (hCHA : rCH.DisjointWires rAnc)
