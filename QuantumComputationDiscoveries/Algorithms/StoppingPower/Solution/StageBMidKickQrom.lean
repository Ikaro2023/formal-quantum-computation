    exact writeRegProg_apply_reg β rComb _ i
  · exact writeRegProg_apply_of_not_mem β rComb _ w hmem
theorem unitary_coe_star_mul_self {N : ℕ} (U : Unitary N) : U.1ᴴ * U.1 = 1 :=
  (Matrix.mem_unitaryGroup_iff'.mp U.2)
theorem unitary_coe_mul_star_self {N : ℕ} (U : Unitary N) : U.1 * U.1ᴴ = 1 :=
  (Matrix.mem_unitaryGroup_iff.mp U.2)
theorem conj_hermitian {N : ℕ} {P : Matrix (Fin N) (Fin N) ℂ} (hP : Pᴴ = P)
    (U : Unitary N) : (U.1 * P * U.1ᴴ)ᴴ = U.1 * P * U.1ᴴ := by
  simp only [conjTranspose_mul, conjTranspose_conjTranspose, hP, Matrix.mul_assoc]
theorem conj_idempotent {N : ℕ} {P : Matrix (Fin N) (Fin N) ℂ} (hP : P * P = P)
    (U : Unitary N) : (U.1 * P * U.1ᴴ) * (U.1 * P * U.1ᴴ) = U.1 * P * U.1ᴴ := by
  calc (U.1 * P * U.1ᴴ) * (U.1 * P * U.1ᴴ)
      = U.1 * P * (U.1ᴴ * U.1) * P * U.1ᴴ := by simp only [Matrix.mul_assoc]
    _ = U.1 * (P * P) * U.1ᴴ := by
      rw [unitary_coe_star_mul_self U, Matrix.mul_one]; simp only [Matrix.mul_assoc]
    _ = U.1 * P * U.1ᴴ := by rw [hP]
theorem basisOutcomeProjector_zero_mul_conj {n : ℕ} [NeZero (2 ^ n)]
    (q : Wire n) (U : Unitary (2 ^ n)) (P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (hcomm : (QRegister.singleton q).basisOutcomeProjector 0 * U.1 =
      U.1 * (QRegister.singleton q).basisOutcomeProjector 0)
    (hP : (QRegister.singleton q).basisOutcomeProjector 0 * P = P) :
    (QRegister.singleton q).basisOutcomeProjector 0 * (U.1 * P * U.1ᴴ) = U.1 * P * U.1ᴴ := by
  let P₀ := (QRegister.singleton q).basisOutcomeProjector 0
  calc P₀ * (U.1 * P * U.1ᴴ)
      = (P₀ * U.1) * P * U.1ᴴ := by simp only [Matrix.mul_assoc]
    _ = (U.1 * P₀) * P * U.1ᴴ := by rw [hcomm]
    _ = U.1 * (P₀ * P) * U.1ᴴ := by simp only [Matrix.mul_assoc]
    _ = U.1 * P * U.1ᴴ := by rw [hP]
theorem basisOutcomeProjector_zero_comm_x {n : ℕ} [NeZero (2 ^ n)]
    (q w : Wire n) (hne : w ≠ q) :
    (QRegister.singleton q).basisOutcomeProjector 0 *
      (((CliffProg.x w).toCircuit).eval).1 =
    (((CliffProg.x w).toCircuit).eval).1 *
      (QRegister.singleton q).basisOutcomeProjector 0 := by
