/-- Diagonal leaf phase polynomial for Stage B on `mBAux B` wires (`u1` at `90 + B`, `vL` at `94 +
  B`,
`d6` at `96 + 2 * B + 2`, `d7` at `96 + 2 * B + 3`). -/
def fLeafMidB (B : ℕ) (γ : BitAssignment (mBAux B)) : ZMod 2 :=
  γ ⟨0, by dsimp [mBAux]; omega⟩ +
  γ ⟨2, by dsimp [mBAux]; omega⟩ * γ ⟨0, by dsimp [mBAux]; omega⟩ +
  γ ⟨90 + B, by dsimp [mBAux]; omega⟩ * γ ⟨0, by dsimp [mBAux]; omega⟩ +
  γ ⟨90 + B, by dsimp [mBAux]; omega⟩ * γ ⟨85, by dsimp [mBAux]; omega⟩ +
  γ ⟨94 + B, by dsimp [mBAux]; omega⟩ * γ ⟨96 + 2 * B + 2, by dsimp [mBAux]; omega⟩ +
  γ ⟨94 + B, by dsimp [mBAux]; omega⟩ * γ ⟨96 + 2 * B + 3, by dsimp [mBAux]; omega⟩
/-- `0`-`T`, `0`-`.TOFF` diagonal `Z` + five-`CZ` leaf circuit for Stage B. -/
def cLeafMidBOn {n : ℕ} (B : ℕ) (rComb : QRegister (mBAux B) n) : Circuit n :=
  let w0 : Wire (mBAux B) := ⟨0, by dsimp [mBAux]; omega⟩
  let w2 : Wire (mBAux B) := ⟨2, by dsimp [mBAux]; omega⟩
  let w85 : Wire (mBAux B) := ⟨85, by dsimp [mBAux]; omega⟩
  let wu1 : Wire (mBAux B) := ⟨90 + B, by dsimp [mBAux]; omega⟩
  let wvL : Wire (mBAux B) := ⟨94 + B, by dsimp [mBAux]; omega⟩
  let wd6 : Wire (mBAux B) := ⟨96 + 2 * B + 2, by dsimp [mBAux]; omega⟩
  let wd7 : Wire (mBAux B) := ⟨96 + 2 * B + 3, by dsimp [mBAux]; omega⟩
  Circuit.Z (rComb w0) ;;ᶜ
  asymMid_czCircuit (rComb w2) (rComb w0)
    (rComb.wires.injective.ne (wire_ne_of_gt (by dsimp [w2, w0]; omega))) ;;ᶜ
  asymMid_czCircuit (rComb wu1) (rComb w0)
    (rComb.wires.injective.ne (wire_ne_of_gt (by dsimp [wu1, w0]; omega))) ;;ᶜ
  asymMid_czCircuit (rComb wu1) (rComb w85)
    (rComb.wires.injective.ne (wire_ne_of_gt (by dsimp [wu1, w85]; omega))) ;;ᶜ
  asymMid_czCircuit (rComb wvL) (rComb wd6)
    (rComb.wires.injective.ne (wire_ne_of_lt (by dsimp [wvL, wd6]; omega))) ;;ᶜ
  asymMid_czCircuit (rComb wvL) (rComb wd7)
    (rComb.wires.injective.ne (wire_ne_of_lt (by dsimp [wvL, wd7]; omega)))
