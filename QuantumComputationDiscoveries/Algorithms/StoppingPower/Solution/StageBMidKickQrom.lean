    cases st₀ 1 <;> cases st₀ 2 <;> cases decide (regValList st₀ u8Wires < 218) <;> rfl
  refine ⟨hst₁₀_165, fun hen0 ↦
    coinBarrelIdxFastPure_of_en_false st₀ (hst₁₀_165 ▸ hen0), fun hen1 j ↦ ?_⟩
  have hmux_j : st₉ (69 + j.val) = Bool.xor (st₈ (69 + j.val))
      (st₈ 2 && Bool.xor (st₈ (69 + j.val)) (st₈ (muxSrcWire68 j.val))) := by
    rw [← hst₉]
    exact checkSymWire progOutMux_68 155 (by omega) progOutMux_68_wf
      [2, 69 + j.val, muxSrcWire68 j.val] (69 + j.val) (by omega) (.xor (.var (69 + j.val))
      (.and (.var 2) (.xor (.var (69 + j.val)) (.var (muxSrcWire68 j.val)))))
      (List.all_eq_true.mp outMux68Sym_ok j.val (List.mem_range.mpr j.isLt)) st₈ hcl₈
  rw [hidx_cp j, hmux_j, hst₈_2, hst₈_u8 j.val j.isLt]
  have hu8_bit : st₀ (17 + j.val) = (regValList st₀ u8Wires).testBit j.val := by
    rw [regValList_testBit u8Wires j.val (by simp [u8Wires]) st₀, u8Wires145_get_eq j]
  have hq8_bit : st₈ (muxSrcWire68 j.val) = (regValList st₈ q8SrcWires68).testBit j.val := by
    rw [regValList_testBit q8SrcWires68 j.val (by simp [q8SrcWires68]) st₈, q8SrcWires68_get_eq j]
  rw [hu8_bit, hq8_bit, hq8_val]
  exact coinBarrelIdxFastPure_mux_bit st₀ j (hst₁₀_165 ▸ hen1)
def rawPebble : List DecStep → ℕ → (ℕ → Bool) → ℕ → Bool
  | [], _, _, _ => false
  | s :: rest, cur, st, w =>
      match s with
      | .andAlloc a b =>
          if w = cur then (st a && st b)
          else rawPebble rest (cur + 1) (s.stepBool cur st) w
      | _ => rawPebble rest (s.nextCur cur) (s.stepBool cur st) w
def isAndTarget : List DecStep → ℕ → ℕ → Bool
  | [], _, _ => false
  | s :: rest, cur, w =>
      match s with
      | .andAlloc _ _ => if w = cur then true else isAndTarget rest (cur + 1) w
      | _ => isAndTarget rest (s.nextCur cur) w
theorem isAndTarget_lt :
    ∀ (p : List DecStep) (cur w : ℕ), w < cur → isAndTarget p cur w = false
  | [], _, _, _ => rfl
  | s :: rest, cur, w, hlt => by
      cases s with
      | allocZero => exact isAndTarget_lt rest (cur + 1) w (by omega)
      | x _ => exact isAndTarget_lt rest cur w hlt
      | cnot _ _ => exact isAndTarget_lt rest cur w hlt
      | andAlloc _ _ =>
          have hne : w ≠ cur := by omega
          simp only [isAndTarget, hne, ↓reduceIte]
          exact isAndTarget_lt rest (cur + 1) w (by omega)
theorem rawPebble_of_not_andTarget :
    ∀ (p : List DecStep) (cur : ℕ) (st : ℕ → Bool) (w : ℕ),
      isAndTarget p cur w = false → rawPebble p cur st w = false
  | [], _, _, _, _ => rfl
  | s :: rest, cur, st, w, hnot => by
      cases s with
      | allocZero => exact rawPebble_of_not_andTarget rest _ _ w hnot
      | x _ => exact rawPebble_of_not_andTarget rest _ _ w hnot
      | cnot _ _ => exact rawPebble_of_not_andTarget rest _ _ w hnot
      | andAlloc a b =>
          dsimp only [isAndTarget, rawPebble] at hnot ⊢
          by_cases hw : w = cur
          · simp [hw] at hnot
          · simp only [hw, ↓reduceIte] at hnot ⊢
            exact rawPebble_of_not_andTarget rest _ _ w hnot
theorem rawPebble_lt (p : List DecStep) (cur : ℕ) (st : ℕ → Bool) (w : ℕ) (hlt : w < cur) :
    rawPebble p cur st w = false :=
  rawPebble_of_not_andTarget p cur st w (isAndTarget_lt p cur w hlt)
def stepToCliffGen {mPayload : ℕ} (hmPay : 80 ≤ mPayload) (off mClean cur : ℕ)
    (hcur : cur ≤ 61 + mClean) :
    (s : DecStep) → s.wellFormed cur = true →
    Internal.CliffProg (fullSysCoreWires mPayload + off + mClean)
  | .allocZero, _ => .nil
  | .andAlloc _ _, _ => .nil
  | .x w, hwf =>
      have hw : w < 61 + mClean := by
        simp only [DecStep.wellFormed, decide_eq_true_eq] at hwf; omega
      .x (decWireGen hmPay off mClean w hw)
  | .cnot src dst, hwf =>
      have h : src ≠ dst ∧ src < cur ∧ dst < cur := by
        simpa only [DecStep.wellFormed, decide_eq_true_eq] using hwf
      .cnot (decWireGen hmPay off mClean src (lt_of_lt_of_le h.2.1 hcur))
        (decWireGen hmPay off mClean dst (lt_of_lt_of_le h.2.2 hcur))
        (fun heq ↦ h.1 (decWireGen_inj hmPay heq))
def cliffOfProgGen {mPayload : ℕ} (hmPay : 80 ≤ mPayload) (off mClean : ℕ) :
    (p : List DecStep) → (cur : ℕ) → progEndCur cur p ≤ 61 + mClean →
    progWellFormed cur p = true →
    Internal.CliffProg (fullSysCoreWires mPayload + off + mClean)
  | [], _, _, _ => .nil
  | s :: rest, cur, hend, hwf =>
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + mClean :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + mClean := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      .seq (stepToCliffGen hmPay off mClean cur hcur_le s hw.1)
        (cliffOfProgGen hmPay off mClean rest (s.nextCur cur) hend hw.2)
theorem stepToCliffGen_disj_supp {mPayload off mClean cur : ℕ} (hmPay : 80 ≤ mPayload)
    (h61 : 61 ≤ cur) (hcur : cur ≤ 61 + mClean)
    (s : DecStep) (hwf : s.wellFormed cur = true) :
    let C := fullSysCoreWires mPayload
    let c := stepToCliffGen hmPay off mClean cur hcur s hwf
    Internal.CliffDisjoint (mutIdxWindow C off) c ∧
    c.SupportsBelow (C + off + (cur - 61)) := by
  have hC := core_lo_4034 hmPay
  cases s with
  | allocZero => exact ⟨trivial, trivial⟩
  | andAlloc _ _ => exact ⟨trivial, trivial⟩
  | x q =>
      have hq : q < cur := by simpa [DecStep.wellFormed] using hwf
      exact ⟨decWireGen_nonMut hmPay _, decWireNumGen_lt_cur hC h61 hq⟩
  | cnot src dst =>
      have h : src ≠ dst ∧ src < cur ∧ dst < cur := by
        simpa only [DecStep.wellFormed, decide_eq_true_eq] using hwf
      exact ⟨⟨decWireGen_nonMut hmPay _, decWireGen_nonMut hmPay _⟩,
        ⟨decWireNumGen_lt_cur hC h61 h.2.1, decWireNumGen_lt_cur hC h61 h.2.2⟩⟩
theorem cliffOfProgGen_inv_eval {mPayload off mClean : ℕ} (hmPay : 80 ≤ mPayload) :
    ∀ (p : List DecStep) (cur : ℕ) (h61 : 61 ≤ cur) (hend : progEndCur cur p ≤ 61 + mClean)
      (hwf : progWellFormed cur p = true)
      (β : BitAssignment (fullSysCoreWires mPayload + off + mClean)),
      Internal.cleanRem (fullSysCoreWires mPayload + off + mClean)
        ((fullSysCoreWires mPayload + off + mClean) -
          (fullSysCoreWires mPayload + off + (cur - 61))) β →
      ∀ (γ : BitAssignment (fullSysCoreWires mPayload + off + mClean)),
      (∀ u, ¬ mutIdxWindow (fullSysCoreWires mPayload) off u →
        γ u = (listToCtxGen hmPay off mClean p cur h61 hend hwf).fwdBits β u) →
      let C := fullSysCoreWires mPayload
      let c := cliffOfProgGen hmPay off mClean p cur hend hwf
      (∀ u, mutIdxWindow C off u → c.inv.eval γ u = γ u) ∧
      (∀ (w : ℕ) (hw : w < 61 + mClean),
        decide (c.inv.eval γ (decWireGen hmPay off mClean w hw) = 1) =
          if w < cur then bitsOfAssignGen hmPay off mClean β w
          else rawPebble p cur (bitsOfAssignGen hmPay off mClean β) w)
  | [], cur, h61, hend, hwf, β, hβ, γ, hγ_nonMut => by
      refine ⟨fun _ _ ↦ rfl, fun w hw ↦ ?_⟩
      have hev : (cliffOfProgGen hmPay off mClean [] cur hend hwf).inv.eval γ
          (decWireGen hmPay off mClean w hw) =
          (listToCtxGen hmPay off mClean [] cur h61 hend hwf).fwdBits β
          (decWireGen hmPay off mClean w hw) := hγ_nonMut _ (decWireGen_nonMut hmPay hw)
      rw [hev]
      dsimp only [rawPebble, listToCtxGen, Internal.TempCtx.fwdBits]
      by_cases hlt : w < cur
      · simp only [hlt, ↓reduceIte, bitsOfAssignGen, hw, ↓reduceDIte]
        rfl
      · simp only [hlt, ↓reduceIte]
        have hz : β (decWireGen hmPay off mClean w hw) = 0 := by
          apply hβ
          have hC := core_lo_4034 hmPay
          dsimp [decWireGen, decWireNumGen]
          split_ifs <;> omega
        simp [hz]
  | s :: rest, cur, h61, hend, hwf, β, hβ, γ, hγ_nonMut => by
      have hC := core_lo_4034 hmPay
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + mClean :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + mClean := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      obtain ⟨h61', _, hsp1, hsem1⟩ := stepToCtxGen_correct hmPay h61 hcur_le s hw.1 hnext_le
      let β₁ := (stepToCtxGen hmPay off mClean cur h61 hcur_le s hw.1 hnext_le).fwdBits β
      have hβ₁_clean := hsp1.fwd_clean hβ
      have hγ_rest : ∀ u, ¬ mutIdxWindow (fullSysCoreWires mPayload) off u →
          γ u = (listToCtxGen hmPay off mClean rest (s.nextCur cur) h61' hend hw.2).fwdBits β₁ u :=
            by
        intro u hu
        rw [hγ_nonMut u hu]
        dsimp only [listToCtxGen]
        exact congrFun (Internal.TempCtx.append_fwdBits _ _ β) u
      obtain ⟨ih_mut, ih_bits⟩ := cliffOfProgGen_inv_eval hmPay rest (s.nextCur cur) h61' hend hw.2
        β₁ hβ₁_clean γ hγ_rest
      let c1 := stepToCliffGen hmPay off mClean cur hcur_le s hw.1
      let c2 := cliffOfProgGen hmPay off mClean rest (s.nextCur cur) hend hw.2
      obtain ⟨hd1, hs1⟩ := stepToCliffGen_disj_supp hmPay h61 hcur_le s hw.1
      have hmut_all : ∀ u, mutIdxWindow (fullSysCoreWires mPayload) off u →
          (Internal.CliffProg.seq c1 c2).inv.eval γ u = γ u := by
        intro u hu
        dsimp only [Internal.CliffProg.inv, Internal.CliffProg.eval]
        rw [hd1.inv.eval_mut _ hu]
        exact ih_mut u hu
      have hbits1 : bitsOfAssignGen hmPay off mClean β₁ =
          s.stepBool cur (bitsOfAssignGen hmPay off mClean β) := by
        funext q
        by_cases hq : q < 61 + mClean
        · simp only [bitsOfAssignGen, hq, ↓reduceDIte]
          exact hsem1 β hβ q hq
        · have hrhs : s.stepBool cur (bitsOfAssignGen hmPay off mClean β) q = false := by
            cases s with
            | allocZero => simp [DecStep.stepBool, bitsOfAssignGen, hq]
            | x q0 =>
                have : q0 < cur := by simpa [DecStep.wellFormed] using hw.1
                simp [DecStep.stepBool, show q ≠ q0 by omega, bitsOfAssignGen, hq]
            | cnot c0 d0 =>
                have hd0 : d0 < cur := (by simpa [DecStep.wellFormed] using hw.1 : _ ∧ _ ∧ _).2.2
                simp [DecStep.stepBool, show q ≠ d0 by omega, bitsOfAssignGen, hq]
            | andAlloc a0 b0 =>
                simp [DecStep.stepBool, show q ≠ cur by dsimp [DecStep.nextCur] at hnext_le; omega,
                  bitsOfAssignGen, hq]
          simp [bitsOfAssignGen, hq, hrhs]
      refine ⟨hmut_all, fun w hlt ↦ ?_⟩
      let γ' := c2.inv.eval γ
      change decide (c1.inv.eval γ' (decWireGen hmPay off mClean w hlt) = 1) = _
      by_cases hw_ge : cur ≤ w
      · have hw_out : fullSysCoreWires mPayload + off + (cur - 61) ≤
            (decWireGen hmPay off mClean w hlt).val := by
          dsimp [decWireGen, decWireNumGen]; split_ifs <;> omega
        rw [Internal.CliffProg.eval_outside c1.inv (Internal.CliffProg.inv_supportsBelow c1 hs1)
          γ' _ hw_out]
        have h_ih := ih_bits w hlt
        dsimp only [γ'] at *
        rw [h_ih, hbits1]
        have hnot_lt : ¬ w < cur := by omega
        simp only [hnot_lt, ↓reduceIte]
        cases s with
        | allocZero =>
            dsimp only [DecStep.nextCur, DecStep.stepBool, rawPebble]
            by_cases hwc : w = cur
            · subst hwc
              have hz : β (decWireGen hmPay off mClean w hlt) = 0 := hβ _ (by omega)
              rw [rawPebble_lt rest (w + 1) _ w (by omega)]
              simp [bitsOfAssignGen, hlt, hz]
            · have hnot1 : ¬ w < cur + 1 := by omega
              simp [hnot1]
        | x q0 =>
            dsimp only [DecStep.nextCur, rawPebble]
            simp [hnot_lt]
        | cnot a0 b0 =>
            dsimp only [DecStep.nextCur, rawPebble]
            simp [hnot_lt]
        | andAlloc a0 b0 =>
            dsimp only [DecStep.nextCur, DecStep.stepBool, rawPebble]
            by_cases hwc : w = cur
            · subst hwc
              simp [bitsOfAssignGen]
            · have hnot1 : ¬ w < cur + 1 := by omega
              simp [hwc, hnot1]
      · have hw_lt : w < cur := by omega
        have hw_lt' : w < s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
        have hγ'_lt : ∀ (q : ℕ) (hq : q < cur) (hqB : q < 61 + mClean),
            decide (γ' (decWireGen hmPay off mClean q hqB) = 1) =
              s.stepBool cur (bitsOfAssignGen hmPay off mClean β) q := by
          intro q hq hqB
          have hq' : q < s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
          have h_ih := ih_bits q hqB
          dsimp only [γ']
          rw [h_ih, ite_eq_left_iff.mpr (fun h ↦ absurd hq' h), hbits1]
        simp only [hw_lt, ↓reduceIte]
        cases s with
        | allocZero =>
            have hev1 : c1.inv.eval γ' (decWireGen hmPay off mClean w hlt) =
                γ' (decWireGen hmPay off mClean w hlt) := rfl
            rw [hev1, hγ'_lt w hw_lt hlt]
            simp [DecStep.stepBool, bitsOfAssignGen, hlt]
        | andAlloc a0 b0 =>
            have hev1 : c1.inv.eval γ' (decWireGen hmPay off mClean w hlt) =
                γ' (decWireGen hmPay off mClean w hlt) := rfl
            rw [hev1, hγ'_lt w hw_lt hlt]
            simp [DecStep.stepBool, show w ≠ cur by omega, bitsOfAssignGen, hlt]
        | x q0 =>
            have hq0 : q0 < cur := by simpa [DecStep.wellFormed] using hw.1
            have hq0B : q0 < 61 + mClean := lt_of_lt_of_le hq0 hcur_le
            have hev1 : c1.inv.eval γ' (decWireGen hmPay off mClean w hlt) =
                Function.update γ' (decWireGen hmPay off mClean q0 hq0B)
                  (γ' (decWireGen hmPay off mClean q0 hq0B) + 1)
                  (decWireGen hmPay off mClean w hlt) := by
              dsimp [c1, stepToCliffGen, Internal.CliffProg.inv, Internal.CliffProg.eval]
            rw [hev1]
            by_cases hwq : w = q0
            · subst hwq
              have hprf : hlt = hq0B := Subsingleton.elim _ _
              subst hprf
              rw [Function.update_self, zmod2_add_one_decide, hγ'_lt w hw_lt hlt]
              simp [DecStep.stepBool, bitsOfAssignGen, hlt]
            · have hne : decWireGen hmPay off mClean w hlt ≠ decWireGen hmPay off mClean q0 hq0B :=
                fun he ↦ hwq (decWireGen_inj hmPay he)
              rw [Function.update_of_ne hne, hγ'_lt w hw_lt hlt]
              simp [DecStep.stepBool, hwq, bitsOfAssignGen, hlt]
        | cnot a0 b0 =>
            have h : a0 ≠ b0 ∧ a0 < cur ∧ b0 < cur := by
              simpa only [DecStep.wellFormed, decide_eq_true_eq] using hw.1
            have haB : a0 < 61 + mClean := lt_of_lt_of_le h.2.1 hcur_le
            have hbB : b0 < 61 + mClean := lt_of_lt_of_le h.2.2 hcur_le
            have hev1 : c1.inv.eval γ' (decWireGen hmPay off mClean w hlt) = Function.update
                γ' (decWireGen hmPay off mClean b0 hbB) (γ' (decWireGen hmPay off mClean b0
                hbB) + γ' (decWireGen hmPay off mClean a0 haB))
                (decWireGen hmPay off mClean w hlt) := by
              dsimp [c1, stepToCliffGen, Internal.CliffProg.inv, Internal.CliffProg.eval]
            rw [hev1]
            by_cases hwb : w = b0
            · subst hwb
              have hprf : hlt = hbB := Subsingleton.elim _ _
              subst hprf
              rw [Function.update_self, zmod2_add_decide,
                hγ'_lt w hw_lt hlt, hγ'_lt a0 h.2.1 haB]
              simp [DecStep.stepBool, h.1, bitsOfAssignGen, hlt, haB]
            · have hne : decWireGen hmPay off mClean w hlt ≠ decWireGen hmPay off mClean b0 hbB :=
                fun he ↦ hwb (decWireGen_inj hmPay he)
              rw [Function.update_of_ne hne, hγ'_lt w hw_lt hlt]
              simp [DecStep.stepBool, hwb, bitsOfAssignGen, hlt]
theorem progNumAnd_le_endCur_sub :
    ∀ (p : List DecStep) (cur : ℕ), progNumAnd p ≤ progEndCur cur p - cur
  | [], _ => by simp [progNumAnd, progEndCur]
  | s :: rest, cur => by
      have ih := progNumAnd_le_endCur_sub rest (s.nextCur cur)
      have hm := progEndCur_mono rest (s.nextCur cur)
      cases s <;> simp only [progNumAnd, progEndCur, DecStep.numAnd, DecStep.nextCur] at ih hm ⊢ <;>
        omega
def permOfProg (mWB : ℕ) :
    (p : List DecStep) → (cur off : ℕ) →
    off + (progEndCur cur p - cur) ≤ mWB → Equiv.Perm (Fin mWB)
  | [], _, _, _ => Equiv.refl _
  | s :: rest, cur, off, hbound =>
      match s with
      | .x _ => permOfProg mWB rest cur off hbound
      | .cnot _ _ => permOfProg mWB rest cur off hbound
      | .andAlloc _ _ =>
          permOfProg mWB rest (cur + 1) (off + 1) (by
            have hm := progEndCur_mono rest (cur + 1)
            dsimp [progEndCur, DecStep.nextCur] at hbound; omega)
      | .allocZero =>
          have hm := progEndCur_mono rest (cur + 1)
          have hkr := progNumAnd_le_endCur_sub rest (cur + 1)
          have hbound' : (off + 1) + (progEndCur (cur + 1) rest - (cur + 1)) ≤ mWB := by
            dsimp [progEndCur, DecStep.nextCur] at hbound; omega
          (permOfProg mWB rest (cur + 1) (off + 1) hbound').trans
            (Equiv.swap ⟨off, by omega⟩ ⟨off + progNumAnd rest, by
              dsimp [progEndCur, DecStep.nextCur] at hbound; omega⟩)
private theorem ite_false_eq {α : Sort*} (A B : α) : (if false = true then A else B) = B := rfl
private theorem ite_true_eq {α : Sort*} (A B : α) : (if true = true then A else B) = A := rfl
theorem permOfProg_spec (mWB : ℕ) :
    ∀ (p : List DecStep) (cur off : ℕ) (hbound : off + (progEndCur cur p - cur) ≤ mWB)
      (idx : Fin mWB),
      (idx.val < off → permOfProg mWB p cur off hbound idx = idx) ∧
      (off + (progEndCur cur p - cur) ≤ idx.val → permOfProg mWB p cur off hbound idx = idx) ∧
      (∀ _h : off ≤ idx.val ∧ idx.val < off + (progEndCur cur p - cur),
        if isAndTarget p cur (cur + (idx.val - off)) then
          off ≤ (permOfProg mWB p cur off hbound idx).val ∧
            (permOfProg mWB p cur off hbound idx).val < off + progNumAnd p
        else
          off + progNumAnd p ≤ (permOfProg mWB p cur off hbound idx).val ∧
            (permOfProg mWB p cur off hbound idx).val < off + (progEndCur cur p - cur))
  | [], cur, off, hbound, idx => by
      refine ⟨fun _ ↦ rfl, fun _ ↦ rfl, fun h ↦ ?_⟩
      exfalso
      simp only [progEndCur, Nat.sub_self, Nat.add_zero] at h
      omega
  | s :: rest, cur, off, hbound, idx => by
      cases s with
      | x _ =>
          simp only [permOfProg, progEndCur, DecStep.nextCur, progNumAnd, DecStep.numAnd,
            Nat.zero_add, isAndTarget]
          exact permOfProg_spec mWB rest cur off hbound idx
      | cnot _ _ =>
          simp only [permOfProg, progEndCur, DecStep.nextCur, progNumAnd, DecStep.numAnd,
            Nat.zero_add, isAndTarget]
          exact permOfProg_spec mWB rest cur off hbound idx
      | andAlloc a b =>
          have hm := progEndCur_mono rest (cur + 1)
          have hsub : progEndCur (cur + 1) rest - cur =
              1 + (progEndCur (cur + 1) rest - (cur + 1)) := by omega
          have hbound' : (off + 1) + (progEndCur (cur + 1) rest - (cur + 1)) ≤ mWB := by
            dsimp [progEndCur, DecStep.nextCur] at hbound; omega
          obtain ⟨hlo, hhi, hmid⟩ := permOfProg_spec mWB rest (cur + 1) (off + 1) hbound' idx
          dsimp only [permOfProg, progEndCur, DecStep.nextCur, progNumAnd, DecStep.numAnd]
          rw [hsub]
          refine ⟨fun h ↦ hlo (by omega), fun h ↦ hhi (by omega), fun h ↦ ?_⟩
          by_cases h0 : idx.val = off
          · have he0 : permOfProg mWB rest (cur + 1) (off + 1) hbound' idx = idx := hlo (by omega)
            simp [isAndTarget, he0, h0]
          · have h_in : off + 1 ≤ idx.val ∧ idx.val < (off + 1) + (progEndCur (cur + 1) rest -
            (cur + 1)) :=
              ⟨by omega, by omega⟩
            have hm_in := hmid h_in
            have ht_ne : cur + (idx.val - off) ≠ cur := by omega
            have ht_eq : cur + (idx.val - off) = (cur + 1) + (idx.val - (off + 1)) := by omega
            have htar : isAndTarget (.andAlloc a b :: rest) cur (cur + (idx.val - off)) =
                isAndTarget rest (cur + 1) ((cur + 1) + (idx.val - (off + 1))) := by
              dsimp only [isAndTarget]
              rw [ite_eq_right_iff.mpr (fun hc ↦ absurd hc ht_ne), ht_eq]
            rw [htar]
            rcases Bool.eq_false_or_eq_true
                (isAndTarget rest (cur + 1) ((cur + 1) + (idx.val - (off + 1)))) with his | his
            · rw [his, ite_true_eq] at hm_in ⊢
              omega
            · rw [his, ite_false_eq] at hm_in ⊢
              omega
      | allocZero =>
          have hm := progEndCur_mono rest (cur + 1)
          have hsub : progEndCur (cur + 1) rest - cur =
              1 + (progEndCur (cur + 1) rest - (cur + 1)) := by omega
          have hkr := progNumAnd_le_endCur_sub rest (cur + 1)
          have hbound' : (off + 1) + (progEndCur (cur + 1) rest - (cur + 1)) ≤ mWB := by
            dsimp [progEndCur, DecStep.nextCur] at hbound; omega
          obtain ⟨hlo, hhi, hmid⟩ := permOfProg_spec mWB rest (cur + 1) (off + 1) hbound' idx
          let eR := permOfProg mWB rest (cur + 1) (off + 1) hbound'
          let u0 : Fin mWB := ⟨off, by dsimp [progEndCur, DecStep.nextCur] at hbound; omega⟩
          let uk : Fin mWB :=
            ⟨off + progNumAnd rest, by dsimp [progEndCur, DecStep.nextCur] at hbound; omega⟩
          have heq_e : permOfProg mWB (.allocZero :: rest) cur off hbound idx =
              Equiv.swap u0 uk (eR idx) := rfl
          rw [heq_e]
          dsimp only [progEndCur, DecStep.nextCur, progNumAnd, DecStep.numAnd]
          rw [hsub]
          refine ⟨fun h ↦ ?_, fun h ↦ ?_, fun h ↦ ?_⟩
          · rw [show eR idx = idx from hlo (by omega)]
            exact Equiv.swap_apply_of_ne_of_ne
              (Fin.ne_of_val_ne (by dsimp [u0]; omega))
              (Fin.ne_of_val_ne (by dsimp [uk]; omega))
          · rw [show eR idx = idx from hhi (by omega)]
            exact Equiv.swap_apply_of_ne_of_ne
              (Fin.ne_of_val_ne (by dsimp [u0]; omega))
              (Fin.ne_of_val_ne (by dsimp [uk]; omega))
          · by_cases h0 : idx.val = off
            · have he0 : eR idx = u0 := by
                dsimp only [eR]; rw [hlo (by omega)]; exact Fin.ext h0
              have ht_eq : isAndTarget (.allocZero :: rest) cur (cur + (idx.val - off)) = false :=
                isAndTarget_lt rest (cur + 1) (cur + (idx.val - off)) (by omega)
              rw [ht_eq, ite_false_eq, he0, Equiv.swap_apply_left]
              dsimp [uk]
              omega
            · have h_in : off + 1 ≤ idx.val ∧ idx.val < (off + 1) + (progEndCur (cur + 1) rest -
              (cur + 1)) :=
                ⟨by omega, by omega⟩
              have hm_in := hmid h_in
              have ht_eq : cur + (idx.val - off) = (cur + 1) + (idx.val - (off + 1)) := by omega
              have htar : isAndTarget (.allocZero :: rest) cur (cur + (idx.val - off)) =
                  isAndTarget rest (cur + 1) ((cur + 1) + (idx.val - (off + 1))) :=
                congrArg (isAndTarget rest (cur + 1)) ht_eq
              rw [htar]
              rcases Bool.eq_false_or_eq_true
                  (isAndTarget rest (cur + 1) ((cur + 1) + (idx.val - (off + 1)))) with his | his
              · rw [his, ite_true_eq] at hm_in ⊢
                by_cases hek : eR idx = uk
                · have hek_val : (eR idx).val = off + progNumAnd rest := congrArg Fin.val hek
                  rw [hek, Equiv.swap_apply_right]
                  dsimp [u0]; omega
                · have hne0 : eR idx ≠ u0 := Fin.ne_of_val_ne (by dsimp [u0, eR]; omega)
                  have hlt_uk : (eR idx).val < off + progNumAnd rest := by
                    have hne_val : (eR idx).val ≠ off + progNumAnd rest :=
                      fun hv ↦ hek (Fin.ext hv)
                    dsimp [eR] at hne_val ⊢; omega
                  rw [Equiv.swap_apply_of_ne_of_ne hne0 hek]
                  dsimp [eR] at hlt_uk ⊢; omega
              · rw [his, ite_false_eq] at hm_in ⊢
                have hsw : Equiv.swap u0 uk (eR idx) = eR idx :=
                  Equiv.swap_apply_of_ne_of_ne
                    (Fin.ne_of_val_ne (by dsimp [u0, eR]; omega))
                    (Fin.ne_of_val_ne (by dsimp [uk, eR]; omega))
                rw [hsw]; dsimp [eR]; omega
def RealizesOnProj {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ} [NeZero (2 ^ n)]
    (P U : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) (d : DynamicCircuit Var n) : Prop := ∀ M :
    Observable (Fin (2 ^ n)), ∃ M' : Observable (Fin (2 ^ n)), wp d.compile (fun _ ↦ M) = (fun _ ↦
      M') ∧ P
    * M'.1.1 * P = P * (Uᴴ * M.1.1 * U) * P
theorem RealizesOnProj.to_cleanWorkspace {Var : Type} [Fintype Var] [DecidableEq Var]
    {n k m : ℕ} [NeZero (2 ^ n)] {rAct : QRegister k n} {rScr : QRegister m n}
    {u : Unitary (2 ^ k)} {d : DynamicCircuit Var n} (h : RealizesOnProj
    (rScr.basisOutcomeProjector 0) (rAct.embedUnitary u).1 d) :
    DynCircuitExt.RealizesEmbeddedUnitaryWithCleanWorkspace rAct rScr u d := h
theorem RealizesOnProj.circuit {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] (P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) (c : Circuit n) :
    RealizesOnProj (Var := Var) P c.eval.1 (.circuit c) := by
  intro M
  refine ⟨qAssignObsMap c.eval M, ?_, ?_⟩
  · funext σ
    simp [DynamicCircuit.compile_circuit, wpQAssignCompat]
  · simp [qAssignObsMap, Matrix.star_eq_conjTranspose, Matrix.mul_assoc]
theorem RealizesOnProj.congr_op {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] {P U₁ U₂ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    {d : DynamicCircuit Var n} (hP : Pᴴ = P) (hd : RealizesOnProj P U₁ d)
    (heq : U₁ * P = U₂ * P) : RealizesOnProj P U₂ d := by
  have hadj : P * U₁ᴴ = P * U₂ᴴ := by
    have h := congrArg conjTranspose heq
    simpa [Matrix.conjTranspose_mul, hP] using h
  intro M
  obtain ⟨M', hwp, hproj⟩ := hd M
  refine ⟨M', hwp, ?_⟩
  calc P * M'.1.1 * P
      = P * (U₁ᴴ * M.1.1 * U₁) * P := hproj
    _ = (P * U₁ᴴ) * M.1.1 * (U₁ * P) := by simp only [Matrix.mul_assoc]
    _ = (P * U₂ᴴ) * M.1.1 * (U₂ * P) := by rw [hadj, heq]
    _ = P * (U₂ᴴ * M.1.1 * U₂) * P := by simp only [Matrix.mul_assoc]
theorem RealizesOnProj.mono_proj {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] {P_s P_b U : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    {d : DynamicCircuit Var n} (hPs : P_sᴴ = P_s) (hPb : P_bᴴ = P_b) (hsub : P_s * P_b = P_b)
    (hd : RealizesOnProj P_s U d) : RealizesOnProj P_b U d := by
  have hleft : P_b * P_s = P_b := by
    have h := congrArg conjTranspose hsub
    simpa [Matrix.conjTranspose_mul, hPs, hPb] using h
  intro M
  obtain ⟨M', hwp, hproj⟩ := hd M
  refine ⟨M', hwp, ?_⟩
  calc P_b * M'.1.1 * P_b
      = (P_b * P_s) * M'.1.1 * (P_s * P_b) := by rw [hleft, hsub]
    _ = P_b * (P_s * M'.1.1 * P_s) * P_b := by simp only [Matrix.mul_assoc]
    _ = P_b * (P_s * (Uᴴ * M.1.1 * U) * P_s) * P_b := by rw [hproj]
    _ = (P_b * P_s) * (Uᴴ * M.1.1 * U) * (P_s * P_b) := by simp only [Matrix.mul_assoc]
    _ = P_b * (Uᴴ * M.1.1 * U) * P_b := by rw [hleft, hsub]
theorem RealizesOnProj.withConjCircuit {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] {P U : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (c c_inv : Circuit n)
    (hinv : c_inv.eval = c.eval⁻¹) {d : DynamicCircuit Var n} (hd : RealizesOnProj (c.eval.1 *
    P * c.eval.1ᴴ) (c.eval.1 * U * c.eval.1ᴴ) d) : RealizesOnProj P U
    (.seq (.circuit c) (.seq d (.circuit c_inv))) := by
  intro M
  let V := c.eval
  let M₂ : Observable (Fin (2 ^ n)) := qAssignObsMap c_inv.eval M
  have hwp₂ : wp (DynamicCircuit.circuit (Var := Var) c_inv).compile (fun _ ↦ M) = fun _ ↦ M₂ := by
    funext σ; simp [DynamicCircuit.compile_circuit, wpQAssignCompat, M₂]
  obtain ⟨M₁, hwp₁, hproj₁⟩ := hd M₂
  let M' : Observable (Fin (2 ^ n)) := qAssignObsMap c.eval M₁
  refine ⟨M', ?_, ?_⟩
  · funext σ
    simp only [DynamicCircuit.compile_seq, wp_qSeq, hwp₂, hwp₁]
    simp [DynamicCircuit.compile_circuit, wpQAssignCompat, M']
  · have hV_unit : c.eval.1ᴴ * c.eval.1 = 1 := by
      simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_star_mul_self c.eval
    let A : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ := M.1.1
    let A₁ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ := M₁.1.1
    have hM₂_mat : M₂.1.1 = c.eval.1 * A * c.eval.1ᴴ := by
      have hci : c_inv.eval.1 = c.eval.1ᴴ := by
        rw [hinv, ← Unitary.star_eq_inv, Unitary.coe_star, Matrix.star_eq_conjTranspose]
      simp [M₂, A, qAssignObsMap, Matrix.star_eq_conjTranspose, hci, Matrix.mul_assoc]
    have hM'_mat : M'.1.1 = c.eval.1ᴴ * A₁ * c.eval.1 := by
      simp [M', A₁, qAssignObsMap, Matrix.star_eq_conjTranspose, Matrix.mul_assoc]
    have hproj₁' : c.eval.1 * P * c.eval.1ᴴ * A₁ * (c.eval.1 * P * c.eval.1ᴴ) = c.eval.1 * P *
        c.eval.1ᴴ * ((c.eval.1 * U * c.eval.1ᴴ)ᴴ * (c.eval.1 * A * c.eval.1ᴴ) * (c.eval.1 * U
        * c.eval.1ᴴ)) * (c.eval.1 * P * c.eval.1ᴴ) := by
      simpa only [A₁, hM₂_mat] using hproj₁
    have hmul := congrArg (fun X ↦ c.eval.1ᴴ * X * c.eval.1) hproj₁'
    simp only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose] at hmul
    have hL : c.eval.1ᴴ * (c.eval.1 * P * c.eval.1ᴴ * A₁ * (c.eval.1 * P * c.eval.1ᴴ)) * c.eval.1 =
        P * (c.eval.1ᴴ * A₁ * c.eval.1) * P := by
      calc c.eval.1ᴴ * (c.eval.1 * P * c.eval.1ᴴ * A₁ * (c.eval.1 * P * c.eval.1ᴴ)) * c.eval.1
          = (c.eval.1ᴴ * c.eval.1) * P * ((c.eval.1ᴴ * A₁ * c.eval.1) * (P * (c.eval.1ᴴ *
            c.eval.1))) := by
              simp only [Matrix.mul_assoc]
        _ = P * (c.eval.1ᴴ * A₁ * c.eval.1) * P := by
              simp only [hV_unit, Matrix.one_mul, Matrix.mul_one, Matrix.mul_assoc]
    have hR : c.eval.1ᴴ * (c.eval.1 * P * c.eval.1ᴴ * (c.eval.1 * (Uᴴ * c.eval.1ᴴ) * (c.eval.1
        * A * c.eval.1ᴴ) * (c.eval.1 * U * c.eval.1ᴴ)) * (c.eval.1 * P * c.eval.1ᴴ)) *
        c.eval.1 = P * (Uᴴ * A * U) * P := by
      calc c.eval.1ᴴ * (c.eval.1 * P * c.eval.1ᴴ *
            (c.eval.1 * (Uᴴ * c.eval.1ᴴ) * (c.eval.1 * A * c.eval.1ᴴ) * (c.eval.1 * U *
              c.eval.1ᴴ)) *
            (c.eval.1 * P * c.eval.1ᴴ)) * c.eval.1
          = (c.eval.1ᴴ * c.eval.1) * P * ((c.eval.1ᴴ * c.eval.1) * Uᴴ * ((c.eval.1ᴴ * c.eval.1) *
            A *
              ((c.eval.1ᴴ * c.eval.1) * U * ((c.eval.1ᴴ * c.eval.1) * P * (c.eval.1ᴴ *
                c.eval.1))))) := by
              simp only [Matrix.mul_assoc]
        _ = P * (Uᴴ * A * U) * P := by
              simp only [hV_unit, Matrix.one_mul, Matrix.mul_one, Matrix.mul_assoc]
    change P * M'.1.1 * P = P * (Uᴴ * A * U) * P
    rw [hM'_mat]
    exact hL.symm.trans (hmul.trans hR)
theorem RealizesOnProj.withTempAnd {Var : Type} [Fintype Var] [DecidableEq Var] {n : ℕ}
    [NeZero (2 ^ n)] (v : Var) (c₁ c₂ anc : Wire n) (h₁₂ : c₁ ≠ c₂) (h₁a : c₁ ≠ anc)
    (h₂a : c₂ ≠ anc) {P U : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} {d : DynamicCircuit Var n}
    (hP : Pᴴ = P) (hP₀ : (QRegister.singleton anc).basisOutcomeProjector 0 * P = P) (hU₀ :
    (QRegister.singleton anc).basisOutcomeProjector 0 * (U * P) = U * P) (hd : RealizesOnProj
    ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * P * (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a
    h₂a).eval.1) ((Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval.1 * U * (Circuit.TOFF c₁ c₂ anc
    h₁₂ h₁a h₂a).eval.1) d) : RealizesOnProj P U (.seq (DynamicCircuit.andCompute c₁ c₂ anc
    h₁a h₂a) (.seq d (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂))) := by
  let P₀ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ :=
    (QRegister.singleton anc).basisOutcomeProjector 0
  let T := (Circuit.TOFF c₁ c₂ anc h₁₂ h₁a h₂a).eval
  have hP₀_herm : P₀ᴴ = P₀ := QRegister.basisOutcomeProjector_conjTranspose _ 0
  have hP_P₀ : P * P₀ = P := by
    have h := congrArg conjTranspose hP₀
    simpa [Matrix.conjTranspose_mul, hP₀_herm, hP] using h
  have hU₀_adj : P * Uᴴ * P₀ = P * Uᴴ := by
    have h := congrArg conjTranspose hU₀
    simpa [Matrix.conjTranspose_mul, hP₀_herm, hP, Matrix.mul_assoc] using h
  have hT_sq : T.1 * T.1 = 1 := congrArg Subtype.val (toffoli_eval_sq c₁ c₂ anc h₁₂ h₁a h₂a)
  have hT_herm : T.1ᴴ = T.1 := by
    have hinv : T⁻¹ = T := mul_eq_one_iff_inv_eq.mp (toffoli_eval_sq c₁ c₂ anc h₁₂ h₁a h₂a)
    rw [← Matrix.star_eq_conjTranspose, ← Unitary.coe_star, Unitary.star_eq_inv, hinv]
  intro M
  obtain ⟨M₂, hwp₂⟩ := PreservesStoreConst.andUncompute v c₁ c₂ anc h₁₂ M
  obtain ⟨M₁, hwp₁, hproj₁⟩ := hd M₂
  obtain ⟨M', hwp'⟩ := PreservesStoreConst.circuit (Var := Var)
    (Circuit.andCompute c₁ c₂ anc h₁a h₂a) M₁
  have hwp_all : wp (DynamicCircuit.seq (DynamicCircuit.andCompute (Var := Var) c₁ c₂ anc h₁a h₂a)
      (DynamicCircuit.seq d (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂))).compile
      (fun _ ↦ M) = fun _ ↦ M' := by
    funext σ
    simp only [DynamicCircuit.andCompute, DynamicCircuit.compile_seq, wp_qSeq, hwp₂, hwp₁, hwp']
  refine ⟨M', hwp_all, ?_⟩
  let σ₀ : Store Var := fun _ ↦ 0
  have hstep1_hm :
      ((wp (.qSeq (DynamicCircuit.andCompute (Var := Var) c₁ c₂ anc h₁a h₂a).compile
          (.qSeq d.compile (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile))
        (fun _ ↦ M) σ₀).1).conj P₀ =
      ((wpQAssignCompat T (wp d.compile (wp (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile
        (fun _ ↦ M))) σ₀).1).conj P₀ :=
    congrArg Subtype.val (congrFun
      (restrictToZeroAncilla_wp_andCompute_seq_compat c₁ c₂ anc
        h₁₂ h₁a h₂a (.qSeq d.compile (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile)
        (fun _ ↦ M)) σ₀)
  have hstep1 : P₀ * M'.1.1 * P₀ = P₀ * (T.1 * M₁.1.1 * T.1) * P₀ := by
    have h := congrArg Subtype.val hstep1_hm
    change P₀ * ((wp (DynamicCircuit.seq (DynamicCircuit.andCompute (Var := Var) c₁ c₂ anc h₁a h₂a)
        (DynamicCircuit.seq d (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂))).compile
        (fun _ ↦ M) σ₀).1.1) * P₀ᴴ =
      P₀ *
        ((wpQAssignCompat T (wp d.compile (wp (DynamicCircuit.andUncompute v c₁ c₂ anc h₁₂).compile
        (fun _ ↦ M))) σ₀).1.1) * P₀ᴴ at h
    rw [hwp_all, hwp₂, hwp₁] at h
    simpa [wpQAssignCompat, wpQAssignCompat_apply, qAssignObsMap, Matrix.star_eq_conjTranspose,
      hP₀_herm, hT_herm,
      Matrix.mul_assoc] using h
  have hstep_un_hm : ((wpQAssignCompat T (wp (DynamicCircuit.andUncompute v c₁ c₂ anc
      h₁₂).compile (fun _ ↦ M)) σ₀).1).conj P₀ = (M.1).conj P₀ := congrArg Subtype.val
      (congrFun (restrictAssertionToZeroAncilla_wpQAssign_toffoli_wp_andUncompute_of_update_eq
      v c₁ c₂ anc h₁₂ h₁a h₂a (fun _ ↦ M) (fun _ _ ↦ rfl)) σ₀)
  have hstep_un : P₀ * (T.1 * M₂.1.1 * T.1) * P₀ = P₀ * M.1.1 * P₀ := by
    have h := congrArg Subtype.val hstep_un_hm
    rw [hwp₂] at h
    simpa [wpQAssignCompat, wpQAssignCompat_apply, qAssignObsMap, Matrix.star_eq_conjTranspose,
      hP₀_herm, hT_herm,
      Matrix.mul_assoc] using h
  let A : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ := M.1.1
  let A₂ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ := M₂.1.1
  let A₁ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ := M₁.1.1
  let A' : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ := M'.1.1
  have hproj₁' : T.1 * P * T.1 * A₁ * (T.1 * P * T.1) = T.1 * P * T.1 *
      ((T.1 * U * T.1)ᴴ * A₂ * (T.1 * U * T.1)) * (T.1 * P * T.1) := hproj₁
  have hmul := congrArg (fun X ↦ T.1 * X * T.1) hproj₁'
  simp only [Matrix.conjTranspose_mul, hT_herm] at hmul
  have hL : T.1 * (T.1 * P * T.1 * A₁ * (T.1 * P * T.1)) * T.1 =
      P * (T.1 * A₁ * T.1) * P := by
    calc T.1 * (T.1 * P * T.1 * A₁ * (T.1 * P * T.1)) * T.1
        = (T.1 * T.1) * P * ((T.1 * A₁ * T.1) * (P * (T.1 * T.1))) := by
            simp only [Matrix.mul_assoc]
      _ = P * (T.1 * A₁ * T.1) * P := by
            simp only [hT_sq, Matrix.one_mul, Matrix.mul_one, Matrix.mul_assoc]
  have hR : T.1 * (T.1 * P * T.1 * (T.1 * (Uᴴ * T.1) * A₂ * (T.1 * U * T.1)) * (T.1 * P *
      T.1)) * T.1 = P * Uᴴ * (T.1 * A₂ * T.1) * U * P := by
    calc T.1 * (T.1 * P * T.1 *
          (T.1 * (Uᴴ * T.1) * A₂ * (T.1 * U * T.1)) *
          (T.1 * P * T.1)) * T.1
        = (T.1 * T.1) * P * ((T.1 * T.1) * Uᴴ * (T.1 * A₂ * (T.1 * U *
            ((T.1 * T.1) * P * (T.1 * T.1))))) := by
            simp only [Matrix.mul_assoc]
      _ = P * Uᴴ * (T.1 * A₂ * T.1) * U * P := by
            simp only [hT_sq, Matrix.one_mul, Matrix.mul_one, Matrix.mul_assoc]
  have hmid_eq : P * (T.1 * A₁ * T.1) * P = P * Uᴴ * (T.1 * A₂ * T.1) * U * P :=
    hL.symm.trans (hmul.trans hR)
  change P * A' * P = P * (Uᴴ * A * U) * P
  calc P * A' * P
      = (P * P₀) * A' * (P₀ * P) := by rw [hP_P₀, hP₀]
    _ = P * (P₀ * A' * P₀) * P := by simp only [Matrix.mul_assoc]
    _ = P * (P₀ * (T.1 * A₁ * T.1) * P₀) * P := by
      rw [show P₀ * A' * P₀ = P₀ * (T.1 * A₁ * T.1) * P₀ from hstep1]
    _ = (P * P₀) * (T.1 * A₁ * T.1) * (P₀ * P) := by simp only [Matrix.mul_assoc]
    _ = P * (T.1 * A₁ * T.1) * P := by rw [hP_P₀, hP₀]
    _ = P * Uᴴ * (T.1 * A₂ * T.1) * U * P := hmid_eq
    _ = (P * Uᴴ * P₀) * (T.1 * A₂ * T.1) * (P₀ * (U * P)) := by
          rw [hU₀_adj, hU₀]; simp only [Matrix.mul_assoc]
    _ = (P * Uᴴ) * (P₀ * (T.1 * A₂ * T.1) * P₀) * (U * P) := by
          simp only [Matrix.mul_assoc]
    _ = (P * Uᴴ) * (P₀ * A * P₀) * (U * P) := by
      rw [show P₀ * (T.1 * A₂ * T.1) * P₀ = P₀ * A * P₀ from hstep_un]
    _ = (P * Uᴴ * P₀) * A * (P₀ * (U * P)) := by simp only [Matrix.mul_assoc]
    _ = P * (Uᴴ * A * U) * P := by rw [hU₀_adj, hU₀]; simp only [Matrix.mul_assoc]
theorem isAndTarget_ge :
    ∀ (p : List DecStep) (cur w : ℕ), progEndCur cur p ≤ w → isAndTarget p cur w = false
  | [], _, _, _ => rfl
  | s :: rest, cur, w, hge => by
      cases s with
      | allocZero => exact isAndTarget_ge rest (cur + 1) w hge
      | x _ => exact isAndTarget_ge rest cur w hge
      | cnot _ _ => exact isAndTarget_ge rest cur w hge
      | andAlloc _ _ =>
          have hm := progEndCur_mono rest (cur + 1)
          have hne : w ≠ cur := by dsimp [progEndCur, DecStep.nextCur] at hge; omega
          simp only [isAndTarget, hne, ↓reduceIte]
          exact isAndTarget_ge rest (cur + 1) w hge
theorem tempCtx_disjoint_fwdBits_mut {M : ℕ} {mutW : Wire M → Prop}
    {K : Internal.TempCtx M} (hD : K.DisjointFrom mutW) :
    ∀ (β : BitAssignment M) {w : Wire M}, mutW w → K.fwdBits β w = β w := by
  induction K with
  | hole => intro _ _ _; rfl
  | seqPre c _ ih =>
      intro β w hw
      dsimp only [Internal.TempCtx.fwdBits]
      rw [ih hD.2 _ hw, hD.1.eval_mut β hw]
  | seqPost _ _ ih => exact ih hD.1
  | tempAnd _ _ anc _ _ _ _ ih =>
      intro β w hw
      dsimp only [Internal.TempCtx.fwdBits]
      rw [ih hD.2.2.2 _ hw, Function.update_of_ne (fun heq : w = anc ↦ hD.2.2.1 (heq ▸ hw))]
theorem writeRegProg_self {M n : ℕ} (β : BitAssignment n) (r : QRegister M n) :
    Internal.writeRegProg β r (fun idx ↦ β (r idx)) = β := by
  funext w
  by_cases hw : w ∈ Set.range r.wires
  · obtain ⟨i, rfl⟩ := hw
    exact Internal.writeRegProg_apply_reg β r _ i
  · exact Internal.writeRegProg_apply_of_not_mem β r _ w hw
theorem writeRegProg_idem {M n : ℕ} (β : BitAssignment n) (r : QRegister M n)
    (γ₁ γ₂ : BitAssignment M) :
    Internal.writeRegProg (Internal.writeRegProg β r γ₁) r γ₂ = Internal.writeRegProg β r γ₂ := by
  funext w
  by_cases hw : w ∈ Set.range r.wires
  · obtain ⟨i, rfl⟩ := hw
    rw [Internal.writeRegProg_apply_reg, Internal.writeRegProg_apply_reg]
  · rw [Internal.writeRegProg_apply_of_not_mem _ r γ₂ w hw,
      Internal.writeRegProg_apply_of_not_mem _ r γ₁ w hw,
      Internal.writeRegProg_apply_of_not_mem _ r γ₂ w hw]
theorem writeRegProg_update {M n : ℕ} (β : BitAssignment n) (r : QRegister M n) (idx : Fin M)
    (val : ZMod 2) : Function.update β (r idx) val = Internal.writeRegProg β r
    (Function.update (fun i ↦ β (r i)) idx val) := by
  funext w
  by_cases hw : w ∈ Set.range r.wires
  · obtain ⟨j, rfl⟩ := hw
    rw [Internal.writeRegProg_apply_reg]
    by_cases hji : j = idx
    · subst hji; simp
    · simp [Function.update_of_ne (r.wires.injective.ne hji), Function.update_of_ne hji]
  · have hne : w ≠ r idx := fun heq ↦ hw ⟨idx, heq.symm⟩
    rw [Function.update_of_ne hne, Internal.writeRegProg_apply_of_not_mem _ _ _ _ hw]
theorem cliffProg_onRegister_ket {M n : ℕ} (r : QRegister M n) (c : Internal.CliffProg M)
    (β : BitAssignment n) : (((c.onRegister r).toCircuit).eval).1.mulVec (ket β) = ket
    (Internal.writeRegProg β r (c.eval (fun idx ↦ β (r idx)))) := by
  simpa [Internal.TempPhaseProg.onRegister, Internal.TempPhaseProg.toToffCircuit,
    Internal.TempPhaseProg.evalSign, Internal.TempPhaseProg.evalBits] using
    Internal.eval_onRegister_prog_ket r (.cliff c) β
theorem cliffProg_onRegister_eval_inv {M n : ℕ} (r : QRegister M n) (c : Internal.CliffProg M)
    : ((c.onRegister r).toCircuit).eval = (((c.inv.onRegister r).toCircuit).eval)⁻¹ := by
  symm
  apply mul_eq_one_iff_inv_eq.mp
  apply Subtype.ext
  apply matrix_ext_ket
  intro β
  change ((((c.inv.onRegister r).toCircuit).eval).1 *
      (((c.onRegister r).toCircuit).eval).1).mulVec (ket β) =
    (1 : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ).mulVec (ket β)
  rw [Internal.mul_mulVec_prog, cliffProg_onRegister_ket, cliffProg_onRegister_ket]
  have hreg : (fun idx ↦ Internal.writeRegProg β r (c.eval (fun i ↦ β (r i))) (r idx)) =
      c.eval (fun i ↦ β (r i)) := by
    funext idx; exact Internal.writeRegProg_apply_reg _ _ _ idx
  rw [hreg, writeRegProg_idem, c.inv_eval, writeRegProg_self, Matrix.one_mulVec]
theorem ket_basisOutcomeProjector_zero {w n : ℕ} (r : QRegister w n) (β : BitAssignment n) :
    (r.basisOutcomeProjector 0).mulVec (ket β) =
      if (∀ j : Fin w, β (r j) = 0) then ket β else 0 := by
  let g : Fin (2 ^ n) := (basisBitsEquiv n).symm β
  have hket : ket β = Pi.single g 1 := rfl
  have hbg : basisBits n g = β := (basisBitsEquiv n).apply_symm_apply β
  rw [hket, proj0_mulVec_single r g]
  have hiff : r.extractIndex g = 0 ↔ ∀ j : Fin w, β (r j) = 0 := by
    constructor
    · intro h0 j
      rw [← hbg, ← QRegister.basisBits_extractIndex, h0]
      simp [-Nat.reducePow, basisBits_eq_div_mod]
    · intro hall
      apply (basisBitsEquiv w).injective
      funext j
      change basisBits w (r.extractIndex g) j = basisBits w 0 j
      rw [QRegister.basisBits_extractIndex, hbg, hall j]
      simp [-Nat.reducePow, basisBits_eq_div_mod]
  by_cases hz : r.extractIndex g = 0
  · simp [hz, hiff.mp hz]
  · simp [hz, mt hiff.mpr hz]
theorem singleton_proj0_comm_of_ket {n : ℕ} (a : Wire n)
    (A : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) (F : BitAssignment n → BitAssignment n)
    (hA : ∀ β, A.mulVec (ket β) = ket (F β)) (ha : ∀ β, F β a = β a) :
    (QRegister.singleton a).basisOutcomeProjector 0 * A = A *
    (QRegister.singleton a).basisOutcomeProjector 0 := by
  apply matrix_ext_ket
  intro β
  rw [Internal.mul_mulVec_prog, Internal.mul_mulVec_prog, hA β, ket_projector_zero,
    ket_projector_zero, ha β]
  by_cases hb : β a = 0 <;> simp [hb, hA]
theorem x_eval_inv {n : ℕ} (a : Wire n) : (Circuit.X a).eval = ((Circuit.X a).eval)⁻¹ := by
  symm
  apply mul_eq_one_iff_inv_eq.mp
  apply Subtype.ext
  apply matrix_ext_ket
  intro β
  change ((Circuit.X a).eval.1 * (Circuit.X a).eval.1).mulVec (ket β) =
    (1 : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ).mulVec (ket β)
  rw [Internal.mul_mulVec_prog, ket_X, ket_X, Function.update_self, Function.update_idem,
    Matrix.one_mulVec]
  have h11 : (1 + 1 : ZMod 2) = 0 := rfl
  rw [add_assoc, h11, add_zero, Function.update_eq_self]
theorem cnot_eval_inv {n : ℕ} (a b : Wire n) (h : a ≠ b) :
    (Circuit.CNOT a b h).eval = ((Circuit.CNOT a b h).eval)⁻¹ := by
  symm
  apply mul_eq_one_iff_inv_eq.mp
  apply Subtype.ext
  apply matrix_ext_ket
  intro β
  change ((Circuit.CNOT a b h).eval.1 * (Circuit.CNOT a b h).eval.1).mulVec (ket β) =
    (1 : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ).mulVec (ket β)
  rw [Internal.mul_mulVec_prog, ket_CNOT, ket_CNOT, Function.update_self,
    Function.update_of_ne h, Function.update_idem, add_assoc, CharTwo.add_self_eq_zero,
    add_zero, Function.update_eq_self, Matrix.one_mulVec]
def HasCleanTailFrom {M n : ℕ} (rComb : QRegister M n) (pos : ℕ)
    (X : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) : Prop := ∀ (q : Fin M), pos ≤ q.val →
    (QRegister.singleton (rComb q)).basisOutcomeProjector 0 * X = X
theorem HasCleanTailFrom.mul_right {M n : ℕ} {rComb : QRegister M n} {pos : ℕ}
    {X : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (h : HasCleanTailFrom rComb pos X)
    (Y : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) : HasCleanTailFrom rComb pos (X * Y) :=
  fun q hq ↦ by rw [← Matrix.mul_assoc, h q hq]
theorem HasCleanTailFrom.conj_perm {M n : ℕ} {rComb : QRegister M n} {pos bound : ℕ}
    {X : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (V : Unitary (2 ^ n))
    (F : BitAssignment n → BitAssignment n) (hV : ∀ β, V.1.mulVec (ket β) = ket (F β)) (hfix :
    ∀ β (q : Fin M), bound ≤ q.val → F β (rComb q) = β (rComb q)) (hle : pos ≤ bound)
    (hX : HasCleanTailFrom rComb pos X) : HasCleanTailFrom rComb bound (V.1 * X * V.1ᴴ) := by
  refine HasCleanTailFrom.mul_right (fun q hq ↦ ?_) V.1ᴴ
  have hcomm := singleton_proj0_comm_of_ket (rComb q) V.1 F hV (fun β ↦ hfix β q hq)
  rw [← Matrix.mul_assoc, hcomm, Matrix.mul_assoc, hX q (le_trans hle hq)]
def stepFwdCircuit {n mPayload : ℕ} (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n)
    (cur : ℕ) (h61 : 61 ≤ cur) (hcur : cur ≤ 61 + 106) :
    (s : DecStep) → s.wellFormed cur = true → s.nextCur cur ≤ 61 + 106 → Circuit n
  | .allocZero, _, _ => .identity
  | .x q, hwf, _ =>
      have hq : q < 61 + 106 := by simp only [DecStep.wellFormed, decide_eq_true_eq] at hwf; omega
      Circuit.X (rComb (decWireGen hmPay 8 106 q hq))
  | .cnot src dst, hwf, _ =>
      have h : src ≠ dst ∧ src < cur ∧ dst < cur := by
        simpa only [DecStep.wellFormed, decide_eq_true_eq] using hwf
      let sW := rComb (decWireGen hmPay 8 106 src (lt_of_lt_of_le h.2.1 hcur))
      let dW := rComb (decWireGen hmPay 8 106 dst (lt_of_lt_of_le h.2.2 hcur))
      Circuit.CNOT sW dW (rComb.wires.injective.ne (fun heq ↦ h.1 (decWireGen_inj hmPay heq)))
  | .andAlloc a b, hwf, hnext =>
      have h : a ≠ b ∧ a < cur ∧ b < cur ∧ cur + 1 ≤ 337 := by
        simpa only [DecStep.wellFormed, decide_eq_true_eq] using hwf
      let pos := fullSysCoreWires mPayload + 8 + (cur - 61)
      have hpos : pos + 1 ≤ fullSysCoreWires mPayload + 8 + 106 := by
        dsimp [pos, DecStep.nextCur] at hnext ⊢; omega
      let aW := rComb (decWireGen hmPay 8 106 a (lt_of_lt_of_le h.2.1 hcur))
      let bW := rComb (decWireGen hmPay 8 106 b (lt_of_lt_of_le h.2.2.1 hcur))
      let ancW := rComb ⟨pos, hpos⟩
      Circuit.TOFF aW bW ancW
        (rComb.wires.injective.ne (fun heq ↦ h.1 (decWireGen_inj hmPay heq)))
        (rComb.wires.injective.ne (Internal.wire_ne_of_lt (decWireNumGen_lt_cur (core_lo_4034 hmPay)
          h61 h.2.1)))
        (rComb.wires.injective.ne (Internal.wire_ne_of_lt (decWireNumGen_lt_cur (core_lo_4034 hmPay)
          h61 h.2.2.1)))
def progFwdCircuit {n mPayload : ℕ} (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) :
    (p : List DecStep) → (cur : ℕ) → 61 ≤ cur → progEndCur cur p ≤ 61 + 106 →
    progWellFormed cur p = true → Circuit n
  | [], _, _, _, _ => .identity
  | s :: rest, cur, h61, hend, hwf =>
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + 106 :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + 106 := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      have h61' : 61 ≤ s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
      stepFwdCircuit hmPay rComb cur h61 hcur_le s hw.1 hnext_le ;;ᶜ
        progFwdCircuit hmPay rComb rest (s.nextCur cur) h61' hend hw.2
def stepToDynWrap {Var : Type} {n mPayload : ℕ} (v : Var) (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n)
    (cur : ℕ) (h61 : 61 ≤ cur) (hcur : cur ≤ 61 + 106) :
    (s : DecStep) → s.wellFormed cur = true → s.nextCur cur ≤ 61 + 106 →
    DynamicCircuit Var n → DynamicCircuit Var n
  | .allocZero, _, _, d => d
  | .x q, hwf, _, d =>
      have hq : q < 61 + 106 := by simp only [DecStep.wellFormed, decide_eq_true_eq] at hwf; omega
      let w := rComb (decWireGen hmPay 8 106 q hq)
      .seq (.circuit (Circuit.X w)) (.seq d (.circuit (Circuit.X w)))
  | .cnot src dst, hwf, _, d =>
      have h : src ≠ dst ∧ src < cur ∧ dst < cur := by
        simpa only [DecStep.wellFormed, decide_eq_true_eq] using hwf
      let sW := rComb (decWireGen hmPay 8 106 src (lt_of_lt_of_le h.2.1 hcur))
      let dW := rComb (decWireGen hmPay 8 106 dst (lt_of_lt_of_le h.2.2 hcur))
      have hne : sW ≠ dW := rComb.wires.injective.ne (fun heq ↦ h.1 (decWireGen_inj hmPay heq))
      .seq (.circuit (Circuit.CNOT sW dW hne)) (.seq d (.circuit (Circuit.CNOT sW dW hne)))
  | .andAlloc a b, hwf, hnext, d =>
      have h : a ≠ b ∧ a < cur ∧ b < cur ∧ cur + 1 ≤ 337 := by
        simpa only [DecStep.wellFormed, decide_eq_true_eq] using hwf
      let pos := fullSysCoreWires mPayload + 8 + (cur - 61)
      have hpos : pos + 1 ≤ fullSysCoreWires mPayload + 8 + 106 := by
        dsimp [pos, DecStep.nextCur] at hnext ⊢; omega
      let aW := rComb (decWireGen hmPay 8 106 a (lt_of_lt_of_le h.2.1 hcur))
      let bW := rComb (decWireGen hmPay 8 106 b (lt_of_lt_of_le h.2.2.1 hcur))
      let ancW := rComb ⟨pos, hpos⟩
      have hab : aW ≠ bW := rComb.wires.injective.ne (fun heq ↦ h.1 (decWireGen_inj hmPay heq))
      have ha_anc : aW ≠ ancW := rComb.wires.injective.ne
        (Internal.wire_ne_of_lt (decWireNumGen_lt_cur (core_lo_4034 hmPay) h61 h.2.1))
      have hb_anc : bW ≠ ancW := rComb.wires.injective.ne
        (Internal.wire_ne_of_lt (decWireNumGen_lt_cur (core_lo_4034 hmPay) h61 h.2.2.1))
      .seq (DynamicCircuit.andCompute aW bW ancW ha_anc hb_anc)
        (.seq d (DynamicCircuit.andUncompute v aW bW ancW hab))
def progToDynWrap {Var : Type} {n mPayload : ℕ} (v : Var) (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) :
    (p : List DecStep) → (cur : ℕ) → 61 ≤ cur → progEndCur cur p ≤ 61 + 106 →
    progWellFormed cur p = true → DynamicCircuit Var n → DynamicCircuit Var n
  | [], _, _, _, _, d => d
  | s :: rest, cur, h61, hend, hwf, d =>
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + 106 :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + 106 := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      have h61' : 61 ≤ s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
      stepToDynWrap v hmPay rComb cur h61 hcur_le s hw.1 hnext_le
        (progToDynWrap v hmPay rComb rest (s.nextCur cur) h61' hend hw.2 d)
@[simp]
theorem count_progToDynWrap_toff {Var : Type} {n mPayload : ℕ} (v : Var) (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) :
    ∀ (p : List DecStep) (cur : ℕ) (h61 : 61 ≤ cur) (hend : progEndCur cur p ≤ 61 + 106)
      (hwf : progWellFormed cur p = true) (d : DynamicCircuit Var n),
      (progToDynWrap v hmPay rComb p cur h61 hend hwf d).count .TOFF = d.count .TOFF
  | [], _, _, _, _, _ => rfl
  | s :: rest, cur, h61, hend, hwf, d => by
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have h61' : 61 ≤ s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
      have ih := count_progToDynWrap_toff v hmPay rComb rest (s.nextCur cur) h61' hend hw.2 d
      dsimp only [progToDynWrap]
      cases s <;> simp [stepToDynWrap, DynamicCircuit.count, DynamicCircuit.count_andCompute_toff,
        DynamicCircuit.count_andUncompute_toff, ih]
@[simp]
theorem count_progToDynWrap_t {Var : Type} {n mPayload : ℕ} (v : Var) (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) :
    ∀ (p : List DecStep) (cur : ℕ) (h61 : 61 ≤ cur) (hend : progEndCur cur p ≤ 61 + 106)
      (hwf : progWellFormed cur p = true) (d : DynamicCircuit Var n),
      (progToDynWrap v hmPay rComb p cur h61 hend hwf d).count .T =
        4 * progNumAnd p + d.count .T
  | [], _, _, _, _, _ => by simp [progToDynWrap, progNumAnd]
  | s :: rest, cur, h61, hend, hwf, d => by
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have h61' : 61 ≤ s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
      have ih := count_progToDynWrap_t v hmPay rComb rest (s.nextCur cur) h61' hend hw.2 d
      dsimp only [progToDynWrap]
      cases s with
      | andAlloc _ _ =>
          simp [stepToDynWrap, progNumAnd, DecStep.numAnd, DynamicCircuit.count,
            DynamicCircuit.count_andCompute_t, DynamicCircuit.count_andUncompute_t, ih]
          omega
      | _ =>
          simp [stepToDynWrap, progNumAnd, DecStep.numAnd, DynamicCircuit.count, ih]
theorem stepFwdCircuit_ket {n mPayload : ℕ} (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) (cur : ℕ) (h61 : 61 ≤ cur)
    (hcur : cur ≤ 61 + 106) (s : DecStep) (hwf : s.wellFormed cur = true)
    (hnext : s.nextCur cur ≤ 61 + 106) (β : BitAssignment n) :
    (stepFwdCircuit hmPay rComb cur h61 hcur s hwf hnext).eval.1.mulVec (ket β) = ket
    (Internal.writeRegProg β rComb ((stepToCtxGen hmPay 8 106 cur h61 hcur s hwf
    hnext).fwdBits (fun idx ↦ β (rComb idx)))) := by
  cases s with
  | allocZero =>
      change (Circuit.identity (n := n)).eval.1.mulVec (ket β) =
        ket (Internal.writeRegProg β rComb (fun idx ↦ β (rComb idx)))
      rw [writeRegProg_self]; simp
  | x q =>
      dsimp only [stepFwdCircuit, stepToCtxGen, Internal.ctxCliffAlloc, Internal.TempCtx.fwdBits,
        Internal.CliffProg.eval]
      rw [ket_X, writeRegProg_update]
  | cnot src dst =>
      dsimp only [stepFwdCircuit, stepToCtxGen, Internal.ctxCliffAlloc, Internal.TempCtx.fwdBits,
        Internal.CliffProg.eval]
      rw [ket_CNOT, writeRegProg_update]
  | andAlloc a b =>
      dsimp only [stepFwdCircuit, stepToCtxGen, Internal.ctxTempBit, Internal.TempCtx.fwdBits]
      rw [ket_TOFF, writeRegProg_update]
theorem stepFwdCircuit_fixes_above {n mPayload : ℕ} (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) (cur : ℕ) (h61 : 61 ≤ cur)
    (hcur : cur ≤ 61 + 106) (s : DecStep) (hwf : s.wellFormed cur = true)
    (hnext : s.nextCur cur ≤ 61 + 106) (β : BitAssignment n)
    (q : Fin (fullSysCoreWires mPayload + 8 + 106))
    (hq : fullSysCoreWires mPayload + 8 + (s.nextCur cur - 61) ≤ q.val) :
    Internal.writeRegProg β rComb ((stepToCtxGen hmPay 8 106 cur h61 hcur s hwf hnext).fwdBits
    (fun idx ↦ β (rComb idx))) (rComb q) = β (rComb q) := by
  have hC := core_lo_4034 hmPay
  rw [Internal.writeRegProg_apply_reg]
  cases s with
  | allocZero => rfl
  | x w =>
      have hw : w < cur := by simpa [DecStep.wellFormed] using hwf
      have hw_lt : (decWireGen hmPay 8 106 w (lt_of_lt_of_le hw hcur)).val < q.val :=
        lt_of_lt_of_le (decWireNumGen_lt_cur hC h61 hw) hq
      dsimp [stepToCtxGen, Internal.ctxCliffAlloc, Internal.TempCtx.fwdBits,
        Internal.CliffProg.eval]
      exact Function.update_of_ne (Internal.wire_ne_of_gt hw_lt) _ _
  | cnot src dst =>
      have h : src ≠ dst ∧ src < cur ∧ dst < cur := by
        simpa only [DecStep.wellFormed, decide_eq_true_eq] using hwf
      have hd_lt : (decWireGen hmPay 8 106 dst (lt_of_lt_of_le h.2.2 hcur)).val < q.val :=
        lt_of_lt_of_le (decWireNumGen_lt_cur hC h61 h.2.2) hq
      dsimp [stepToCtxGen, Internal.ctxCliffAlloc, Internal.TempCtx.fwdBits,
        Internal.CliffProg.eval]
      exact Function.update_of_ne (Internal.wire_ne_of_gt hd_lt) _ _
  | andAlloc a b =>
      dsimp [DecStep.nextCur] at hq
      dsimp [stepToCtxGen, Internal.ctxTempBit, Internal.TempCtx.fwdBits]
      exact Function.update_of_ne (Fin.ne_of_val_ne (by dsimp; omega)) _ _
theorem progFwdCircuit_ket {n mPayload : ℕ} (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) :
    ∀ (p : List DecStep) (cur : ℕ) (h61 : 61 ≤ cur) (hend : progEndCur cur p ≤ 61 + 106)
      (hwf : progWellFormed cur p = true) (β : BitAssignment n),
      (progFwdCircuit hmPay rComb p cur h61 hend hwf).eval.1.mulVec (ket β) =
        ket (Internal.writeRegProg β rComb
          ((listToCtxGen hmPay 8 106 p cur h61 hend hwf).fwdBits
            (fun idx ↦ β (rComb idx))))
  | [], _, _, _, _, β => by
      dsimp only [progFwdCircuit, listToCtxGen, Internal.TempCtx.fwdBits]
      rw [writeRegProg_self]; simp
  | s :: rest, cur, h61, hend, hwf, β => by
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + 106 :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + 106 := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      have h61' : 61 ≤ s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
      dsimp only [progFwdCircuit, listToCtxGen]
      rw [eval_seq_mulVec, stepFwdCircuit_ket,
        progFwdCircuit_ket hmPay rComb rest (s.nextCur cur) h61' hend hw.2]
      have hreg : (fun idx ↦ Internal.writeRegProg β rComb ((stepToCtxGen hmPay 8 106 cur h61
          hcur_le s hw.1 hnext_le).fwdBits (fun i ↦ β (rComb i))) (rComb idx)) =
          (stepToCtxGen hmPay 8 106 cur h61 hcur_le s hw.1 hnext_le).fwdBits
          (fun i ↦ β (rComb i)) := by
        funext idx; exact Internal.writeRegProg_apply_reg _ _ _ idx
      rw [hreg, writeRegProg_idem, ← Internal.TempCtx.append_fwdBits]
theorem progToDynWrap_realizes {Var : Type} [Fintype Var] [DecidableEq Var] {n mPayload : ℕ}
    [NeZero (2 ^ n)] (v : Var) (hmPay : 80 ≤ mPayload)
    (rComb : QRegister (fullSysCoreWires mPayload + 8 + 106) n) :
    ∀ (p : List DecStep) (cur : ℕ) (h61 : 61 ≤ cur) (hend : progEndCur cur p ≤ 61 + 106)
      (hwf : progWellFormed cur p = true)
      {P U : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
      {dHole : DynamicCircuit Var n},
      Pᴴ = P →
      HasCleanTailFrom rComb (fullSysCoreWires mPayload + 8 + (cur - 61)) P →
      HasCleanTailFrom rComb (fullSysCoreWires mPayload + 8 + (cur - 61)) (U * P) →
      RealizesOnProj
        ((progFwdCircuit hmPay rComb p cur h61 hend hwf).eval.1 * P *
          (progFwdCircuit hmPay rComb p cur h61 hend hwf).eval.1ᴴ)
        ((progFwdCircuit hmPay rComb p cur h61 hend hwf).eval.1 * U *
          (progFwdCircuit hmPay rComb p cur h61 hend hwf).eval.1ᴴ)
        dHole →
      RealizesOnProj P U (progToDynWrap v hmPay rComb p cur h61 hend hwf dHole)
  | [], _, _, _, _, P, U, _, _, _, _, hdHole => by
      simpa [progFwdCircuit, progToDynWrap] using hdHole
  | s :: rest, cur, h61, hend, hwf, P, U, dHole, hP, hP_tail, hU_tail, hdHole => by
      have hw : s.wellFormed cur = true ∧ progWellFormed (s.nextCur cur) rest = true := by
        simpa only [progWellFormed, Bool.and_eq_true] using hwf
      have hnext_le : s.nextCur cur ≤ 61 + 106 :=
        le_trans (progEndCur_mono rest (s.nextCur cur)) hend
      have hcur_le : cur ≤ 61 + 106 := by
        have h1 : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        exact le_trans h1 hnext_le
      have h61' : 61 ≤ s.nextCur cur := by cases s <;> simp only [DecStep.nextCur] <;> omega
      let c_s := stepFwdCircuit hmPay rComb cur h61 hcur_le s hw.1 hnext_le
      let c_rest := progFwdCircuit hmPay rComb rest (s.nextCur cur) h61' hend hw.2
      let V_s := c_s.eval
      let P' := V_s.1 * P * V_s.1ᴴ
      let U' := V_s.1 * U * V_s.1ᴴ
      have hVs_unit : V_s.1ᴴ * V_s.1 = 1 := by
        simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_star_mul_self V_s
      have hP'_herm : P'ᴴ = P' := by
        simp [P', Matrix.conjTranspose_mul, hP, Matrix.mul_assoc]
      have hUP' : U' * P' = V_s.1 * (U * P) * V_s.1ᴴ := by
        calc (V_s.1 * U * V_s.1ᴴ) * (V_s.1 * P * V_s.1ᴴ)
            = V_s.1 * U * (V_s.1ᴴ * V_s.1) * P * V_s.1ᴴ := by simp only [Matrix.mul_assoc]
          _ = V_s.1 * (U * P) * V_s.1ᴴ := by simp only [hVs_unit, Matrix.mul_one, Matrix.mul_assoc]
      have hcur_mono : fullSysCoreWires mPayload + 8 + (cur - 61) ≤
          fullSysCoreWires mPayload + 8 + (s.nextCur cur - 61) := by
        have : cur ≤ s.nextCur cur := by cases s <;> simp [DecStep.nextCur]
        omega
      have hP'_tail : HasCleanTailFrom rComb (fullSysCoreWires mPayload + 8 + (s.nextCur cur -
        61)) P' :=
        HasCleanTailFrom.conj_perm V_s _ (stepFwdCircuit_ket hmPay rComb cur h61 hcur_le s hw.1
          hnext_le)
          (stepFwdCircuit_fixes_above hmPay rComb cur h61 hcur_le s hw.1 hnext_le) hcur_mono hP_tail
      have hU'_tail : HasCleanTailFrom rComb (fullSysCoreWires mPayload + 8 + (s.nextCur cur -
        61)) (U' * P') := by
        rw [hUP']
        exact HasCleanTailFrom.conj_perm V_s _ (stepFwdCircuit_ket hmPay rComb cur h61 hcur_le s
          hw.1 hnext_le)
          (stepFwdCircuit_fixes_above hmPay rComb cur h61 hcur_le s hw.1 hnext_le) hcur_mono hU_tail
      have hdHole' : RealizesOnProj (c_rest.eval.1 * P' * c_rest.eval.1ᴴ)
          (c_rest.eval.1 * U' * c_rest.eval.1ᴴ) dHole := by
        have hev : (progFwdCircuit hmPay rComb (s :: rest) cur h61 hend hwf).eval.1 =
            c_rest.eval.1 * V_s.1 := by
          dsimp only [progFwdCircuit]
          rw [Circuit.eval_seq]
          rfl
        have hP_eq : c_rest.eval.1 * P' * c_rest.eval.1ᴴ =
            (progFwdCircuit hmPay rComb (s :: rest) cur h61 hend hwf).eval.1 * P *
              (progFwdCircuit hmPay rComb (s :: rest) cur h61 hend hwf).eval.1ᴴ := by
          rw [hev]; simp only [P', Matrix.conjTranspose_mul, Matrix.mul_assoc]
        have hU_eq : c_rest.eval.1 * U' * c_rest.eval.1ᴴ =
            (progFwdCircuit hmPay rComb (s :: rest) cur h61 hend hwf).eval.1 * U *
              (progFwdCircuit hmPay rComb (s :: rest) cur h61 hend hwf).eval.1ᴴ := by
          rw [hev]; simp only [U', Matrix.conjTranspose_mul, Matrix.mul_assoc]
        rw [hP_eq, hU_eq]
        exact hdHole
      have hRest := progToDynWrap_realizes v hmPay rComb rest (s.nextCur cur) h61' hend hw.2
        hP'_herm hP'_tail hU'_tail hdHole'
      dsimp only [progToDynWrap]
      cases s with
      | allocZero =>
          simpa [stepToDynWrap, stepFwdCircuit, P', U', V_s, c_s] using hRest
      | x q =>
          exact RealizesOnProj.withConjCircuit _ _ (x_eval_inv _) hRest
      | cnot src dst =>
          exact RealizesOnProj.withConjCircuit _ _ (cnot_eval_inv _ _ _) hRest
      | andAlloc a b =>
          let pos := fullSysCoreWires mPayload + 8 + (cur - 61)
          have hpos : pos + 1 ≤ fullSysCoreWires mPayload + 8 + 106 := by
            dsimp [pos, DecStep.nextCur] at hnext_le ⊢; omega
          have hsq : V_s * V_s = 1 := by
            dsimp only [V_s, c_s, stepFwdCircuit]
            exact toffoli_eval_sq _ _ _ _ _ _
          have hTherm : V_s.1ᴴ = V_s.1 := by
            have hinv : V_s⁻¹ = V_s := mul_eq_one_iff_inv_eq.mp hsq
            rw [← Matrix.star_eq_conjTranspose, ← Unitary.coe_star, Unitary.star_eq_inv, hinv]
          have hRest_toff : RealizesOnProj (V_s.1 * P * V_s.1) (V_s.1 * U * V_s.1)
              (progToDynWrap v hmPay rComb rest ((.andAlloc a b : DecStep).nextCur cur) h61' hend
                hw.2 dHole) := by
            simpa only [P', U', hTherm] using hRest
          exact RealizesOnProj.withTempAnd v _ _ (rComb ⟨pos, hpos⟩) _ _ _ hP
            (hP_tail ⟨pos, hpos⟩ le_rfl) (hU_tail ⟨pos, hpos⟩ le_rfl) hRest_toff
theorem progLoadInternal68_end_le : progEndCur 61 progLoadInternal68 ≤ 61 + 106 := by
