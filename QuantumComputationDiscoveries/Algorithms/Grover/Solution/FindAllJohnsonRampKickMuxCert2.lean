private def rkmAtF : List Bool → Bool
  | [] => true
  | true :: bs => rkmAtF bs
  | false :: _ => false
private theorem rkm_hd_b {b : Bool} {s : List Bool} (h : rkmAtF (b :: s) = true) :
    b = true := by
  cases b with
  | false => exact Bool.noConfusion h
  | true => rfl
private theorem rkm_tl1 {b : Bool} {s : List Bool} (h : rkmAtF (b :: s) = true) :
    rkmAtF s = true := by
  cases b with
  | false => exact Bool.noConfusion h
  | true => exact h
private theorem rkm_tl2 {a b : Bool} {s : List Bool}
    (h : rkmAtF (a :: b :: s) = true) : rkmAtF s = true :=
  rkm_tl1 (rkm_tl1 h)
private theorem rkm_tl4 {a b c d : Bool} {s : List Bool}
    (h : rkmAtF (a :: b :: c :: d :: s) = true) : rkmAtF s = true :=
  rkm_tl2 (rkm_tl2 h)
private theorem rkm_tl8 {a b c d e f g i : Bool} {s : List Bool}
    (h : rkmAtF (a :: b :: c :: d :: e :: f :: g :: i :: s) = true) : rkmAtF s = true :=
  rkm_tl4 (rkm_tl4 h)
private theorem rkm_anc_app {m0 lMax : ℕ} :
    ∀ {xs ys : List RampKickAnchor},
      RampKickAnchorsSound m0 lMax xs → RampKickAnchorsSound m0 lMax ys →
      RampKickAnchorsSound m0 lMax (xs ++ ys)
  | [], _, _, hy => hy
  | _ :: _, _, ⟨hx0, hxs⟩, hy => ⟨hx0, rkm_anc_app hxs hy⟩
private def rkmRevOnto : List ℕ → List ℕ → List ℕ
  | [], acc => acc
  | x :: xs, acc => rkmRevOnto xs (x :: acc)
private def rkmCapEnd : ℕ → List ℕ → ℕ
  | vc, [] => vc
  | vc, x :: xs => rkmCapEnd (cond (primNatBlt vc x) x vc) xs
private def rkmTailGeB (n : ℕ) : List RampKickAnchor → Bool
  | [] => true
  | b :: _ => n.ble b.rAct
private def rkmHead2Eq (v1 : ℕ) : List ℕ → Bool
  | a :: b :: _ => a.beq 0 && b.beq v1
  | _ => false
private theorem rkm_beq_eq {a b : ℕ} (h : a.beq b = true) : a = b :=
  Nat.beq_eq.mp h
private theorem rkm_head2_append {v1 : ℕ} :
    ∀ (xs ys : List ℕ),
      rkmHead2Eq v1 xs = true →
      xs ++ ys = 0 :: v1 :: (xs.drop 2 ++ ys)
  | a :: b :: _, _, h => by
    dsimp only [rkmHead2Eq] at h
    cases ha : a.beq 0 with
    | false => rw [ha] at h; exact Bool.noConfusion h
    | true =>
      rw [ha] at h
      have hb : b = v1 := rkm_beq_eq h
      rw [rkm_beq_eq ha, hb]
      rfl
  | [], _, h => Bool.noConfusion h
  | [_], _, h => Bool.noConfusion h
private theorem rkm_le_of_ble : ∀ {a b : ℕ}, a.ble b = true → a ≤ b
  | 0, _, _ => Nat.zero_le _
  | _ + 1, 0, h => Bool.noConfusion h
  | _ + 1, _ + 1, h => Nat.succ_le_succ (rkm_le_of_ble h)
private theorem rkm_blt_false_of_le {a b : ℕ} (h : a ≤ b) : primNatBlt b a = false := by
  unfold primNatBlt
  rw [← Bool.not_eq_true]
  intro ht
  have hle : Nat.add b 1 ≤ a := rkm_le_of_ble ht
  change b + 1 ≤ a at hle
  omega
private theorem rkm_nat_beq_false {a b : ℕ} (h : a ≠ b) : a.beq b = false := by
  rw [← Bool.not_eq_true, Nat.beq_eq]
  exact h
private theorem rkm_cond_imp_right {c t1 t2 : Bool}
    (h : cond c t1 false = true) (ht : t1 = true → t2 = true) :
    cond c t2 false = true := by
  cases c with
  | false => exact Bool.noConfusion h
  | true => exact ht h
private theorem rkm_cond_imp_left_false {c b1 b2 : Bool}
    (h : cond c false b1 = true) (hb : b1 = true → b2 = true) :
    cond c false b2 = true := by
  cases c with
  | false => exact hb h
  | true => exact Bool.noConfusion h
private theorem rkm_cond_imp_both {c a1 a2 b1 b2 : Bool}
    (h : cond c a1 b1 = true) (ha : a1 = true → a2 = true) (hb : b1 = true → b2 = true) :
    cond c a2 b2 = true := by
  cases c with
  | false => exact hb h
  | true => exact ha h
private theorem rkm_cond_skip2_imp {c1 c2 d f t1 t2 : Bool}
    (hc1 : c1 = false) (hc2 : c2 = false)
    (h : cond f t1 false = true) (ht : t1 = true → t2 = true) :
    cond c1 false (cond c2 d (cond f t2 false)) = true := by
  rw [hc1, hc2]
  exact rkm_cond_imp_right h ht
private theorem rkm_aux_split (m lMax : ℕ) (uc : Bool) :
    ∀ (xs ys : List ℕ) (r r' vc vc' : ℕ) (vh : List ℕ) (as bs : List RampKickAnchor),
      Nat.add r (altListLen xs) = r' →
      rkmCapEnd vc xs = vc' →
      rkmTailGeB r' bs = true →
      rkmCheckTableAux m lMax uc xs r vc vh as = true →
      rkmCheckTableAux m lMax uc ys r' vc' (rkmRevOnto xs vh) bs = true →
      rkmCheckTableAux m lMax uc (xs ++ ys) r vc vh (as ++ bs) = true
  | [], _, r, r', vc, vc', _, as, _, hr, hvc, _, hx, hy => by
    cases as with
    | nil =>
      have hr0 : r = r' := hr
      have hvc0 : vc = vc' := hvc
      subst hr0
      subst hvc0
      exact hy
    | cons _ _ => exact Bool.noConfusion hx
  | vR :: xRest, ys, r, r', vc, vc', vh, as, bs, hr, hvc, hbs, hx, hy => by
    cases vh with
    | nil => exact Bool.noConfusion hx
    | cons vPrev vhRest =>
      change r + (altListLen xRest + 1) = r' at hr
      have hr' : Nat.add (Nat.add r 1) (altListLen xRest) = r' := by
        change (r + 1) + altListLen xRest = r'
        omega
      dsimp only [List.cons_append]
      unfold rkmCheckTableAux at hx ⊢
      dsimp only at hx ⊢
      rw [rkmb_forceNat_eq] at hx ⊢
      cases as with
      | cons a aRest =>
        dsimp only [List.cons_append] at hx ⊢
        refine rkm_cond_imp_left_false hx fun hx1 => ?_
        refine rkm_cond_imp_both hx1 (fun hx_dr => ?_) (fun hx_fb => ?_)
        · refine rkm_cond_imp_right hx_dr fun hrec => ?_
          exact rkm_aux_split m lMax uc xRest ys (Nat.add r 1) r'
            (cond (primNatBlt vc vR) vR vc) vc' (vR :: vPrev :: vhRest)
            aRest bs hr' hvc hbs hrec hy
        · refine rkm_cond_imp_right hx_fb fun hrec => ?_
          exact rkm_aux_split m lMax uc xRest ys (Nat.add r 1) r'
            (cond (primNatBlt vc vR) vR vc) vc' (vR :: vPrev :: vhRest)
            (a :: aRest) bs hr' hvc hbs hrec hy
      | nil =>
        dsimp only [List.nil_append] at hx ⊢
        cases bs with
        | nil =>
          dsimp only
          refine rkm_cond_imp_right hx fun hrec => ?_
          exact rkm_aux_split m lMax uc xRest ys (Nat.add r 1) r'
            (cond (primNatBlt vc vR) vR vc) vc' (vR :: vPrev :: vhRest)
            [] [] hr' hvc rfl hrec hy
        | cons b bsRest =>
          dsimp only
          have hb_ge : r' ≤ b.rAct := rkm_le_of_ble hbs
          have hlt : primNatBlt b.rAct r = false := rkm_blt_false_of_le (by omega)
          have heq : b.rAct.beq r = false := rkm_nat_beq_false (by omega)
          refine rkm_cond_skip2_imp hlt heq hx fun hrec => ?_
          exact rkm_aux_split m lMax uc xRest ys (Nat.add r 1) r'
            (cond (primNatBlt vc vR) vR vc) vc' (vR :: vPrev :: vhRest)
            [] (b :: bsRest) hr' hvc hbs hrec hy
private theorem rkm_table_of_parts (m lMax v1 : ℕ) (vPot vRest : List ℕ)
    (anc : List RampKickAnchor)
