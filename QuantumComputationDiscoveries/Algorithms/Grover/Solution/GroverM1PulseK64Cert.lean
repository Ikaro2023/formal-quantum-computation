private abbrev k64P : ℕ → ℤ := Int.ofNat
private abbrev k64N : ℕ → ℤ := Int.negSucc
private abbrev K64St := List ℤ × ℕ × ℕ × ℤ
private def k64NatEq (x y : ℕ) : Bool := Bool.and (Nat.ble x y) (Nat.ble y x)
private theorem k64NatEq_eq {x y : ℕ} (h : k64NatEq x y = true) : x = y := by
  unfold k64NatEq at h; rw [Bool.and_eq_true, Nat.ble_eq, Nat.ble_eq] at h; omega
private def k64IntEq (a b : ℤ) : Bool :=
  match a, b with
  | Int.ofNat x, Int.ofNat y => k64NatEq x y
  | Int.negSucc x, Int.negSucc y => k64NatEq x y
  | _, _ => false
private theorem k64IntEq_eq {a b : ℤ} (h : k64IntEq a b = true) : a = b := by
  cases a with
  | ofNat x =>
    cases b with | ofNat y => exact congrArg Int.ofNat (k64NatEq_eq h) | negSucc _ => cases h
  | negSucc x =>
    cases b with | ofNat _ => cases h | negSucc y => exact congrArg Int.negSucc (k64NatEq_eq h)
private def k64IntListEq (xs ys : List ℤ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (k64IntEq x y) (k64IntListEq xr yr) false
  | _, _ => false
private theorem k64IntListEq_eq {xs ys : List ℤ} (h : k64IntListEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil => cases ys with | nil => rfl | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with | nil => cases h | cons y yr =>
      dsimp only [k64IntListEq] at h; cases hxy : k64IntEq x y with
      | false => rw [hxy] at h; cases h
      | true => rw [hxy] at h; exact congrArg₂ List.cons (k64IntEq_eq hxy) (ih h)
private def k64StateEq (s1 s2 : K64St) : Bool :=
  Bool.and (k64IntListEq s1.1 s2.1) (Bool.and (k64NatEq s1.2.1 s2.2.1)
    (Bool.and (k64NatEq s1.2.2.1 s2.2.2.1) (k64IntEq s1.2.2.2 s2.2.2.2)))
private theorem k64StateEq_eq {s1 s2 : K64St} (h : k64StateEq s1 s2 = true) : s1 = s2 := by
  rcases s1 with ⟨c1, h1, r1, v1⟩; rcases s2 with ⟨c2, h2, r2, v2⟩
  unfold k64StateEq at h; simp only [Bool.and_eq_true] at h
  rw [k64IntListEq_eq h.1, k64NatEq_eq h.2.1, k64NatEq_eq h.2.2.1, k64IntEq_eq h.2.2.2]
private def k64InitSt : K64St := ([SchurWeylLCert.swScale, 0], 1, 0, 0)
private def k64RunSegEq (L uvDen : ℕ)
    (trigIvs : List (SchurWeylLCert.IvInt × SchurWeylLCert.IvInt))
    (c : List PulseM1.SolSparsePulse) (sIn sOut : K64St) : Bool :=
  k64StateEq (PulseM1.solEvolutionL2Seg L uvDen trigIvs sIn.1 sIn.2.1 sIn.2.2.1 sIn.2.2.2 c) sOut
private theorem k64EvolLast {L uvDen : ℕ}
    {trigIvs : List (SchurWeylLCert.IvInt × SchurWeylLCert.IvInt)}
    {c : List PulseM1.SolSparsePulse} {sIn sOut : K64St}
    (h : k64RunSegEq L uvDen trigIvs c sIn sOut = true) :
    PulseM1.solEvolutionL2Aux L uvDen trigIvs sIn.1 sIn.2.1 sIn.2.2.1 sIn.2.2.2 c =
      (sOut.1, sOut.2.2.1, sOut.2.2.2) := by
  rw [PulseM1.solEvolutionL2Aux_eq_seg]; dsimp only; rw [k64StateEq_eq h]
private theorem k64EvolStep {L uvDen : ℕ}
    {trigIvs : List (SchurWeylLCert.IvInt × SchurWeylLCert.IvInt)}
    {c rest : List PulseM1.SolSparsePulse} {sIn sMid sOut : K64St}
    (h1 : k64RunSegEq L uvDen trigIvs c sIn sMid = true)
    (h2 : PulseM1.solEvolutionL2Aux L uvDen trigIvs
      sMid.1 sMid.2.1 sMid.2.2.1 sMid.2.2.2 rest = (sOut.1, sOut.2.2.1, sOut.2.2.2)) :
    PulseM1.solEvolutionL2Aux L uvDen trigIvs
      sIn.1 sIn.2.1 sIn.2.2.1 sIn.2.2.2 (c ++ rest) = (sOut.1, sOut.2.2.1, sOut.2.2.2) := by
  rcases sMid with ⟨c1, h1', rh1, sv1⟩
  rw [PulseM1.solEvolutionL2Aux_append L uvDen trigIvs c rest
    sIn.1 sIn.2.1 sIn.2.2.1 sIn.2.2.2 (k64StateEq_eq h1)]
  exact h2
private theorem k64EvolStart {L uvDen : ℕ}
    {trigIvs : List (SchurWeylLCert.IvInt × SchurWeylLCert.IvInt)}
    {c rest : List PulseM1.SolSparsePulse} {sMid sOut : K64St}
    (h1 : k64RunSegEq L uvDen trigIvs c k64InitSt sMid = true)
    (h2 : PulseM1.solEvolutionL2Aux L uvDen trigIvs
      sMid.1 sMid.2.1 sMid.2.2.1 sMid.2.2.2 rest = (sOut.1, sOut.2.2.1, sOut.2.2.2)) :
    PulseM1.solEvolutionL2 L uvDen trigIvs (c ++ rest) = (sOut.1, sOut.2.2.1, sOut.2.2.2) := by
  unfold PulseM1.solEvolutionL2; rw [PulseM1.solWithTrigList_eq]; exact k64EvolStep h1 h2
private def k64CheckTerm (L rMin rMax tauNum tauDen uvDen : ℕ)
    (ratios : List SchurWeylLCert.IvInt)
    (trigIvs : List (SchurWeylLCert.IvInt × SchurWeylLCert.IvInt))
    (sps : List PulseM1.SolSparsePulse) (sEnd : K64St)
    (certP0Lb : ℤ) (certTailLbs : List ℤ) (certSurvUb : ℤ) : Bool :=
  Nat.ble 2 L && Nat.ble L 1024 && Nat.ble L rMin && Nat.ble rMin rMax &&
  Nat.ble rMax 1024 && Nat.ble 1 uvDen && Nat.ble 1 sps.length && Nat.ble sps.length 5120 &&
  Nat.beq certTailLbs.length L && sps.all PulseM1.solSparsePulseValid &&
  PulseM1.checkPulseBucketAngles L rMin rMax tauNum tauDen ratios trigIvs &&
  match PulseM1.solTerminalBoundsL2 L sEnd.1 sEnd.2.2.1 sEnd.2.2.2 with
  | (p0Lb, tailLbs, sUb) =>
      Nat.beq tailLbs.length L &&
      PulseM1.solBleZ 0 certP0Lb && PulseM1.solBleZ certP0Lb p0Lb &&
      PulseM1.solBleZ 0 certSurvUb && PulseM1.solBleZ sUb certSurvUb &&
      PulseM1.solBleZ 1 (certTailLbs.getD 0 0) &&
      PulseM1.solBleZ (certTailLbs.getD 0 0) SchurWeylLCert.swScale &&
      PulseM1.solBleZ 0 (certTailLbs.getD (Nat.sub L 1) 0) &&
      PulseM1.solAllLeZip certTailLbs tailLbs
private theorem k64BucketCert_of_evol {L rMin rMax tauNum tauDen uvDen : ℕ}
    {ratios : List SchurWeylLCert.IvInt}
    {trigIvs : List (SchurWeylLCert.IvInt × SchurWeylLCert.IvInt)}
    {sps : List PulseM1.SolSparsePulse} {sEnd : K64St}
    {certP0Lb : ℤ} {certTailLbs : List ℤ} {certSurvUb : ℤ}
    (hev : PulseM1.solEvolutionL2 L uvDen trigIvs sps = (sEnd.1, sEnd.2.2.1, sEnd.2.2.2))
    (hterm : k64CheckTerm L rMin rMax tauNum tauDen uvDen ratios trigIvs sps sEnd
      certP0Lb certTailLbs certSurvUb = true) :
    PulseM1.checkPulseBucketCertL2 L rMin rMax tauNum tauDen uvDen ratios trigIvs sps
      certP0Lb certTailLbs certSurvUb = true := by
  unfold PulseM1.checkPulseBucketCertL2 k64CheckTerm at *
  rw [PulseM1.solWithPulseList_eq]; dsimp only; rw [hev]; dsimp only; exact hterm

