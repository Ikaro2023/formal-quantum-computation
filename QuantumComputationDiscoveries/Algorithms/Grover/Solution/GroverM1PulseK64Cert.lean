/-
# `m = 1, k = 64` Multi-Pulse Certificate (`GroverM1PulseK64Cert`)

QHL-verified `m = 1, k = 64` module chaining the `PulseM1` schedule (`r = 32` `L = 32`
and `r = 64` `L = 64` explicit conveyors totaling `50,944` sparse-pulse steps plus
`r = 34..63` `L2` cascade-table buckets) over the certified `r ≤ 31` prefix
`GroverM1PulseTable.solM1VTable16` (`kMax = 64`), certifying
`(1, 64) = 1641721138905847 / 2500000000000000`.
-/

@[expose] public section

namespace QuantumComputation.Specs.GroverFindAll.GroverM1PulseK64Cert

open scoped NNReal NNRat

/-- Supported `(m, k)` cell (`m = 1`, `k = 64`). -/
def isGroverM1PulseK64CertCell (m k : ℕ) : Bool :=
  if m == 1 then
    if k == 64 then true
    else false
  else false

/-- Total register qubit budget `(n + 1) * m + n * k + 1` (`= findAllQubits n m k`). -/
abbrev groverM1PulseK64CertQubits (n m k : ℕ) : ℕ :=
  GroverFindAll.findAllQubits n m k

/-- Certified relative-cost profile `c(1, 64) = 1641721138905847 / 2500000000000000`. -/
def relCostGroverM1PulseK64Cert (m k : ℕ) : ℚ≥0 :=
  if m == 1 && k == 64 then NNRat.divNat 1641721138905847 2500000000000000
  else 1

/-- Compositional `FindAllCostProfile` for `(1, 64)` (`n₀ = 1152`). -/
def groverM1PulseK64CertProfile : GroverFindAll.FindAllCostProfile where
  validCell := isGroverM1PulseK64CertCell
  relCost := relCostGroverM1PulseK64Cert
  n0 _ _ := 1152

/-- Every cell accepted by `isGroverM1PulseK64CertCell` lies on `groverGrid × groverGrid`. -/
theorem isGroverM1PulseK64CertCell_isGridCell {m k : ℕ}
    (h : isGroverM1PulseK64CertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isGroverM1PulseK64CertCell at h
  by_cases hm : m = 1
  · subst hm
    by_cases hk : k = 64
    · subst hk; rfl
    · simp [hk] at h
  · simp [hm] at h

end QuantumComputation.Specs.GroverFindAll.GroverM1PulseK64Cert

end

