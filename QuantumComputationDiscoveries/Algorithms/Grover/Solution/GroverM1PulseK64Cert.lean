private theorem solK64StageProp_of_le_31 {n r : ℕ} {s : PulseM1.PulseM1StageSpec}
    (hr31 : r ≤ 31)
    (h : GroverM1PulseTable.PulseStageTableProp n r s GroverM1PulseTable.solM1VTable16) :
    GroverM1PulseTable.PulseStageTableProp n r s solK64VTable := by
  rcases h with ⟨hL2, hL1024, hLr, hp, hM⟩
  refine ⟨hL2, hL1024, hLr, hp, fun M hMov ↦ ?_⟩
  rcases hM M hMov with ⟨hpSucc, hbell⟩
  refine ⟨hpSucc, ?_⟩
  dsimp only at hbell ⊢
  set K_blk := SchurWeylLCert.swLKBlk n r s.tauNum s.tauDen
  set cs : Fin s.L → ℝ × ℝ := fun w ↦
    (Real.cos ((K_blk : ℝ) * SchurWeylLCert.swLThetaShiftReal (2 ^ n) r w.1),
     Real.sin ((K_blk : ℝ) * SchurWeylLCert.swLThetaShiftReal (2 ^ n) r w.1))
  set out := SchurWeylLCert.swLEvolutionReal s.L hL2 cs s.pulses
  set p : ℕ → ℝ := SchurWeylLCert.swLAttemptProbReal s.L hL2 M out.1 out.2.1
  have hsum :
      (∑ h ∈ Finset.Icc 1 s.L,
        p h * (((solK64VTable (r - h) : ℝ) / (SchurWeylLCert.multiUnitScale : ℝ)) *
          √(2 ^ n : ℝ))) =
      (∑ h ∈ Finset.Icc 1 s.L,
        p h * (((GroverM1PulseTable.solM1VTable16 (r - h) : ℝ) /
          (SchurWeylLCert.multiUnitScale : ℝ)) * √(2 ^ n : ℝ))) :=
    Finset.sum_congr rfl fun h _ ↦ by rw [solK64VTable_eq_of_le_31 (by omega)]
  rw [hsum, solK64VTable_eq_of_le_31 hr31]; exact hbell

private def K64StageBundleProp (n r : ℕ) (s : PulseM1.PulseM1StageSpec) : Prop :=
  ∃ (hL2 : 2 ≤ s.L),
    s.L ≤ 1024 ∧ s.L ≤ r ∧
    s.pulses.all SchurWeylLCert.swLPulseValid = true ∧
    ∀ (M : Fin (2 * s.L) → Fin (2 * s.L) → ℝ),
      SchurWeylLCert.IsValidSwLOverlap M →
      let K_blk := GroverFindAll.hdistLKBlk n r s.tauNum s.tauDen
      let cs : Fin s.L → ℝ × ℝ := fun w ↦
        (Real.cos ((K_blk : ℝ) * SchurWeylLCert.swLThetaShiftReal (2 ^ n) r w.1),
         Real.sin ((K_blk : ℝ) * SchurWeylLCert.swLThetaShiftReal (2 ^ n) r w.1))
      let out := GroverFindAll.hdistLEvolutionReal s.L hL2 cs s.pulses
      let p : ℕ → ℝ := SchurWeylLCert.swLAttemptProbReal s.L hL2 M out.1 out.2.1
      let pSucc : ℝ := ∑ h ∈ Finset.Icc 1 s.L, p h
      let V : ℕ → ℝ := fun j ↦
        ((solK64VTable j : ℝ) / (SchurWeylLCert.multiUnitScale : ℝ)) * √(2 ^ n : ℝ)
      0 < pSucc ∧
      (out.2.2 * (K_blk : ℝ) + (s.L : ℝ) +
        ∑ h ∈ Finset.Icc 1 s.L, p h * V (r - h)) / pSucc ≤ V r

