  · intro m k _hgrid hvalid
    dsimp only [groverM1PulseK64CertProfile] at hvalid
    unfold isGroverM1PulseK64CertCell at hvalid
    by_cases hm : m = 1
    · subst hm
      by_cases hk : k = 64
      · subst hk
        refine ⟨rfl, by omega, by change 64 ≤ 64; omega, le_rfl,
          ⟨6, 1641721138905847, 2500000000000000, rfl, ?_, k64Batch17_ok.2⟩⟩
        unfold groverM1PulseK64CertProfile relCostGroverM1PulseK64Cert
