theorem solM1VTable16_eq_of_le_31 {r : ℕ} (hr : r ≤ 31) :
    solM1VTable16_ref r = solM1VTable16 r := by
  have hb (k) (hk : r ≤ k) : Nat.ble r k = true := (natBle_eq_decide r k).trans (decide_eq_true hk)
  simp only [solM1VTable16_ref, solM1VTable16, solM1VTblB0_ref, hb 511 (by omega),
    hb 255 (by omega), hb 127 (by omega), hb 63 (by omega), hb 31 hr, Bool.cond_true]
theorem pulseStageTableProp_of_le_31 {n r : ℕ} {s : PulseM1StageSpec} (hr31 : r ≤ 31)
    (h : PulseStageTableProp n r s solM1VTable16) :
    PulseStageTableProp n r s solM1VTable16_ref := by
  rcases h with ⟨hL2, hL1024, hLr, hp, hM⟩; refine ⟨hL2, hL1024, hLr, hp, fun M hvalid ↦ ?_⟩
  have hpair := hM M hvalid; dsimp only at hpair ⊢; rcases hpair with ⟨hpSucc, hcost⟩
  refine ⟨hpSucc, ?_⟩; set K_blk := SchurWeylLCert.swLKBlk n r s.tauNum s.tauDen
  set cs : Fin s.L → ℝ × ℝ := fun w ↦
    (Real.cos ((K_blk : ℝ) * SchurWeylLCert.swLThetaShiftReal (2 ^ n) r w.1),
     Real.sin ((K_blk : ℝ) * SchurWeylLCert.swLThetaShiftReal (2 ^ n) r w.1))
  let out := SchurWeylLCert.swLEvolutionReal s.L hL2 cs s.pulses
  set p : ℕ → ℝ := SchurWeylLCert.swLAttemptProbReal s.L hL2 M out.1 out.2.1
  have hsum : (∑ h ∈ Finset.Icc 1 s.L, p h * (((solM1VTable16 (r - h) : ℝ) /
      (SchurWeylLCert.multiUnitScale : ℝ)) * √(2 ^ n : ℝ))) = ∑ h ∈ Finset.Icc 1 s.L, p h *
      (((solM1VTable16_ref (r - h) : ℝ) / (SchurWeylLCert.multiUnitScale : ℝ)) * √(2 ^ n : ℝ)) :=
    Finset.sum_congr rfl fun h _ ↦ by
      rw [solM1VTable16_eq_of_le_31 ((Nat.sub_le r h).trans hr31)]
  rwa [hsum, (solM1VTable16_eq_of_le_31 hr31).symm] at hcost
theorem checkPulseL2RangeBucket_sound {n r rMin rMax len tauNum tauDen uvDen : ℕ}
    {ratios : List IvInt} {trigIvs : List (IvInt × IvInt)} {sps : List SolSparsePulse}
    {p0Lb : ℤ} {tailLbs : List ℤ} {survUb : ℤ} (hn96 : 96 ≤ n) (hmin : rMin ≤ r) (hmax : r ≤ rMax)
    (hlt : r < rMin + len) (hbktBase : checkPulseL2RangeBucketTable rMin rMax len tauNum tauDen
      uvDen ratios trigIvs sps p0Lb tailLbs survUb solM1VTable16 = true)
    (hstepRef : solAllBelow len rMin (fun r' ↦ checkPulseCascadeStepTable 2 r' tauNum tauDen
      survUb p0Lb tailLbs solM1VTable16_ref) = true) :
    PulseStageTableProp n r ⟨2, tauNum, tauDen, solToSwLPulses 2 uvDen sps⟩ solM1VTable16_ref := by
  unfold checkPulseL2RangeBucketTable at hbktBase; rw [Bool.and_eq_true] at hbktBase
  exact checkPulseStageTable_sound hn96 hmin hmax hbktBase.1 (solAllBelow_true hstepRef r hmin hlt)
theorem checkPulseWkbStep_sound {n r : ℕ} {q : SolWkbSched} {ratios : List IvInt}
    {trigIvs : List (IvInt × IvInt)} {cEnd : List ℤ} {hEnd rhoEnd : ℕ} {survEnd p0Lb : ℤ}
    {tailLbs : List ℤ} {survUb : ℤ} (hn96 : 96 ≤ n)
    (hrun : SolWkbRunPrefix q trigIvs q.K cEnd hEnd rhoEnd survEnd)
    (htermBase : checkPulseWkbTerminalTable r q ratios trigIvs cEnd rhoEnd survEnd p0Lb tailLbs
      survUb solM1VTable16 = true) (hstepRef : checkPulseCascadeStepTable q.L r q.tauNum q.tauDen
      survUb p0Lb tailLbs solM1VTable16_ref = true) :
    PulseStageTableProp n r ⟨q.L, q.tauNum, q.tauDen, solWkbToSwLPulses q⟩ solM1VTable16_ref := by
  unfold checkPulseWkbTerminalTable at htermBase; rw [Bool.and_eq_true] at htermBase
  exact checkPulseStageTable_sound hn96 le_rfl le_rfl
    (checkPulseWkbBucketCertL2_of_runPrefix hrun htermBase.1) hstepRef
