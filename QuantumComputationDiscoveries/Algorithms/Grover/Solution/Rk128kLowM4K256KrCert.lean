private theorem lm4Row256Sound :
    DickeSol.rkm128kEvalRowLo12 4 120 256 lm4SegsR256 = lm4RowR256 := by
  apply lm4CertSplit (lm4_hd (lm4_tl2 lm4Batch0)); unfold lm4SegsR256
  exact lm4TailStep lm4Batch4 (lm4TailStep lm4Batch5 (lm4TailStep lm4Batch6
    (lm4TailStep lm4Batch7 (lm4TailStep lm4Batch8 (lm4TailStep lm4Batch9
      (lm4TailStep lm4Batch10 (lm4TailStep lm4Batch11 (lm4TailEnd lm4Batch12))))))))
