    DickeSol.RampKick128kAnchorsSound 4 120 lm4k256Anchors :=
  lm4ChkAnchors_append (lm4_hd (lm4_tl1 (lm4_tl2 lm4Batch0)))
    (lm4ChkAnchors_append lm4Batch1 (lm4ChkAnchors_append lm4Batch2
      (lm4ChkAnchors_append lm4Batch3 ⟨lm4Row256Sound, trivial⟩)))
private theorem lm4k256Valid :
    DickeSol.RampKick128kTableValid 4 256 120 true lm4k256VPot lm4k256Anchors :=
