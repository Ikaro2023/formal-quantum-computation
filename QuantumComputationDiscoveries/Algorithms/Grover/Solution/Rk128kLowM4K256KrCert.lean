/-
# Krotov `(4, 256)` Certificate (`Rk128kLowM4K256KrCert`)

QHL-verified module packaging cell `(4, 256)` over `45` anchors (`438,290` F1272 /
`446,941` Horner coord-ops at `lTableMax = 120`, `useColdR2 = true`).
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kLowM4K256KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported (m, k) cell (m = 4, k = 256, 1 cell). -/
def isLowM4K256KrotovCertCell (m k : ℕ) : Bool :=
  if m == 4 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor L_max(4, 256) = 120 (120 * 4 = 480 <= 65536). -/
def lowM4K256KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 4 then
    if k == 256 then 120
    else 1
  else 1

/-- Total register qubit budget (lowM4K256KrotovCertCellLMax m k * m) * (n + 1) + k * n. -/
abbrev lowM4K256KrotovCertQubits (n m k : ℕ) : ℕ :=
  (lowM4K256KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile c(4, 256): ℚ≥0. -/
def relCostLowM4K256KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 4 then
    if k == 256 then NNRat.divNat 173119777922821 500000000000000
    else 1
  else 1

/-- Cost profile metadata (n0 = 80000, constructive threshold). -/
def lowM4K256KrotovCertProfile : FindAllCostProfile :=
  ⟨isLowM4K256KrotovCertCell, relCostLowM4K256KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kLowM4K256KrCert` cell lies on groverGrid × groverGrid. -/
theorem isLowM4K256KrotovCertCell_isGridCell {m k : ℕ}
    (h : isLowM4K256KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isLowM4K256KrotovCertCell at h
  split_ifs at h with hm4 hk256
  simp only [beq_iff_eq] at hm4 hk256
  subst hm4 hk256; rfl

end

