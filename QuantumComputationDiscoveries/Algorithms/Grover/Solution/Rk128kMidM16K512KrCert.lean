/-
# 128-Segment Krotov `(16, 512)` Slice-3 & 4-Part Stitcher (`Rk128kMidM16K512KrCert`)

QHL-verified module certifying Slice 3 (`r = 512` segments `108..127` plus
`rkm128kFinalizeState`, `257,013` Horner coord-ops at `lTableMax = 62`, `cellLMax = 62`)
and chaining `Rk128kMidM16K512KrPt0..2` for `(16, 512) = 85405926376537 / 500000000000000`.
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kMidM16K512KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported `(m, k)` cell (`m = 16, k = 512`, `1` cell). -/
def isMidM16K512KrotovCertCell (m k : ℕ) : Bool :=
  if m == 16 then
    if k == 512 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor `L_{\max}(16, 512) = 62` matching router budget. -/
def midM16K512KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 16 then
    if k == 512 then 62
    else 1
  else 1

/-- Total register qubit budget `(midM16K512KrotovCertCellLMax m k * m) * (n + 1) + k * n`. -/
abbrev midM16K512KrotovCertQubits (n m k : ℕ) : ℕ :=
  (midM16K512KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified relative-cost profile `c(16, 512): ℚ≥0` (`85405926376537 / 500000000000000`). -/
def relCostMidM16K512KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 16 then
    if k == 512 then NNRat.divNat 85405926376537 500000000000000
    else 1
  else 1

/-- Cost profile metadata (`n0 = 80000`, constructive threshold). -/
def midM16K512KrotovCertProfile : FindAllCostProfile :=
  ⟨isMidM16K512KrotovCertCell, relCostMidM16K512KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kMidM16K512KrCert` cell lies on `groverGrid × groverGrid`. -/
theorem isMidM16K512KrotovCertCell_isGridCell {m k : ℕ}
    (h : isMidM16K512KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isMidM16K512KrotovCertCell at h
  split_ifs at h with hm16 hk512
  all_goals simp only [beq_iff_eq] at *
  subst hm16 hk512; rfl

end

