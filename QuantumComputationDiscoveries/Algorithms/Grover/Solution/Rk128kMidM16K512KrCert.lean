/-- Exact probability-`1` recovery of `S` on the `(16, 512)` cell. -/
theorem midM16K512KrotovCert_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isMidM16K512KrotovCertCell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ ⊤ ⦄
    (QProg.qSet ;;
      (findAllJohnsonRampKick128kMidM16K512KrotovCertCircuit res n m k).compile QProg.qAssign
        (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  have hS' : S ∈ DickeSol.groverTargetSets n k := by rwa [mm16k512kr_targetSets_eq]
  have hp := mm16k512kr_all_props hcell
  rw [mm16k512kr_circuit_eq res n hcell, ← mm16k512kr_oracle_eq]
  exact DickeSol.rkm128kCell_correctness res hp.hmG hp.hkG mm16k512krVPot mm16k512krAnchors
    hp.hk512 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm hp.htab hp.hlmax hn hkN hS'

