    change (match Nat.add 1 n with
      | 0 =>
        match xs with
        | [] => [Int.ofNat 0]
        | h :: t => Int.ofNat 0 :: h :: t
      | v + 1 =>
        match xs with
        | [] => [Int.ofNat v]
        | h :: t => Int.ofNat v :: h :: t) = Int.ofNat n :: xs
    rw [n1a]; cases xs <;> rfl
  | negSucc n =>
    change (match Nat.add 1 n with
      | 0 =>
        match xs with
        | [] => [Int.negSucc 0]
        | h :: t => Int.negSucc 0 :: h :: t
      | v + 1 =>
        match xs with
        | [] => [Int.negSucc v]
        | h :: t => Int.negSucc v :: h :: t) = Int.negSucc n :: xs
