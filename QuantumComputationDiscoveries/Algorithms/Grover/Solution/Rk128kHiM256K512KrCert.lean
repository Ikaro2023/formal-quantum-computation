/-
# 128-Segment Krotov `(256, 512)` Slice-3 & 4-Part Stitcher (`Rk128kHiM256K512KrCert`)

QHL-verified module certifying Slice 3 (`r = 512` segments `123..127` plus
`rkm128kFinalizeState`, `64,000` F1272 / `64,125` Horner coord-ops at `lTableMax = 4`,
`cellLMax = 4`, `useColdR2 = true`) and chaining `Rk128kHiM256K512KrPt0..2` for
`(256, 512) = 45375054238433 / 1000000000000000`.
-/

namespace QuantumComputation.Specs.GroverFindAll
namespace Rk128kHiM256K512KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported (m, k) cell (m = 256, k = 512, 1 cell). -/
def isHiTailM256K512KrotovCertCell (m k : ℕ) : Bool :=
  if m == 256 then
    if k == 512 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor L_max(256, 512) = 4 (4 * 256 = 1024 <= 65536). -/
def hiTailM256K512KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 256 then
    if k == 512 then 4
    else 1
  else 1

/-- Total register qubit budget (hiTailM256K512KrotovCertCellLMax m k * m) * (n + 1) + k *
  n. -/
abbrev hiTailM256K512KrotovCertQubits (n m k : ℕ) : ℕ :=
  (hiTailM256K512KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile c(256, 512): ℚ≥0 (45375054238433 / 10^15). -/
def relCostHiTailM256K512KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 256 then
    if k == 512 then NNRat.divNat 45375054238433 1000000000000000
    else 1
  else 1

/-- Cost profile metadata (n0 = 80000, constructive threshold). -/
def hiTailM256K512KrotovCertProfile : FindAllCostProfile :=
  ⟨isHiTailM256K512KrotovCertCell, relCostHiTailM256K512KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kHiM256K512KrCert` cell lies on groverGrid × groverGrid. -/
theorem isHiTailM256K512KrotovCertCell_isGridCell {m k : ℕ}
    (h : isHiTailM256K512KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isHiTailM256K512KrotovCertCell at h
  split_ifs at h with hm256 hk512
  all_goals simp only [beq_iff_eq] at *
  subst hm256 hk512; rfl

end

