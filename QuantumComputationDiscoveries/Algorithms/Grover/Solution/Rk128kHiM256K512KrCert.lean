private theorem hm256k512krCellChecks {m k : ℕ}
    (h : isHiTailM256K512KrotovCertCell m k = true) :
    DickeSol.rkm128kCheckAnchorsLMax k (hiTailM256K512KrotovCertCellLMax m k)
        hm256k512krAnchors = true ∧
      ∃ num den : ℕ, relCostHiTailM256K512KrotovCert m k = NNRat.divNat num den ∧
        DickeSol.checkAltBound12 m k (hm256k512krVPot.getD k 0) num den = true := by
  unfold isHiTailM256K512KrotovCertCell at h
  split_ifs at h with hm256 hk512
  all_goals simp only [beq_iff_eq] at *
  subst hm256 hk512; have hm := mm_hd (mm_tl1 mm_meta)
  exact ⟨mm_and_l hm, 45375054238433, 1000000000000000, rfl, mm_and_r hm⟩

private lemma hm256k512kr_oracle_eq {n : ℕ} (m : ℕ) (S : Finset (Fin (2 ^ n))) :
    DickeSol.groverParallelMarkingOracle m S = GroverFindAll.parallelMarkingOracle m S := by
  unfold DickeSol.groverParallelMarkingOracle DickeSol.groverSetMarkingOracle
    GroverFindAll.parallelMarkingOracle GroverFindAll.setMarkingOracle; rfl

private lemma hm256k512kr_targetSets_eq (n k : ℕ) :
    DickeSol.groverTargetSets n k = (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k := rfl

private lemma hm256k512kr_vanilla_eq (n m k : ℕ) : DickeSol.vanillaFindAllCost n m k =
    (π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m) := rfl

private lemma hm256k512kr_le_of_add {a b d : ℕ} (h : a + d = b) : a ≤ b := h ▸ Nat.le_add_right a d

private lemma hm256k512kr_mem_grid (j d : ℕ) (h : (j + 1) + d = 11) :
    2 ^ j ∈ DickeSol.groverGrid :=
  Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr (hm256k512kr_le_of_add h), rfl⟩

private structure Hm256k512krCellProps (m k : ℕ) : Prop where
  hmG : m ∈ DickeSol.groverGrid
  hkG : k ∈ DickeSol.groverGrid
  hk512 : k ≤ 512
  hm2 : 2 ≤ m
  hl2 : 2 ≤ hiTailM256K512KrotovCertCellLMax m k
  hl1 : 1 ≤ hiTailM256K512KrotovCertCellLMax m k
  hlm : hiTailM256K512KrotovCertCellLMax m k * m ≤ 65536
  htab : DickeSol.RampKick128kTableValid m 512 4 true hm256k512krVPot hm256k512krAnchors
  hlmax : DickeSol.rkm128kCheckAnchorsLMax k (hiTailM256K512KrotovCertCellLMax m k)
    hm256k512krAnchors = true
  hcost : ∃ num den : ℕ, relCostHiTailM256K512KrotovCert m k = NNRat.divNat num den ∧
    DickeSol.checkAltBound12 m k (hm256k512krVPot.getD k 0) num den = true

private theorem hm256k512kr_all_props {m k : ℕ}
    (h : isHiTailM256K512KrotovCertCell m k = true) :
    Hm256k512krCellProps m k := by
  rcases hm256k512krCellChecks h with ⟨hlmax, hcost⟩
  unfold isHiTailM256K512KrotovCertCell at h
  split_ifs at h with hm256 hk512
  all_goals simp only [beq_iff_eq] at *
  subst hm256 hk512
  exact ⟨hm256k512kr_mem_grid 8 2 rfl, hm256k512kr_mem_grid 9 1 rfl,
    hm256k512kr_le_of_add (d := 0) rfl, hm256k512kr_le_of_add (d := 254) rfl,
    hm256k512kr_le_of_add (d := 2) rfl, hm256k512kr_le_of_add (d := 3) rfl,
    hm256k512kr_le_of_add (d := 64512) rfl, hm256k512krValid, hlmax, hcost⟩

private noncomputable def hiTailM256K512KrotovCertCircuitImpl {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ hiTailM256K512KrotovCertQubits n m k)) Var
      (hiTailM256K512KrotovCertQubits n m k) ((n + 1) * m) :=
  if h : isHiTailM256K512KrotovCertCell m k = true then
    let p := hm256k512kr_all_props h
    DickeSol.rkm128kCellCircuit res p.hmG p.hkG hm256k512krVPot hm256k512krAnchors p.hk512
      (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n
  else .skip

/-- Dynamic parallel query-model circuit for the (256, 512) cell. -/
noncomputable def findAllJohnsonRampKick128kHiTailM256K512KrotovCertCircuit
    {Var : Type} [DecidableEq Var] (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ hiTailM256K512KrotovCertQubits n m k)) Var
      (hiTailM256K512KrotovCertQubits n m k) ((n + 1) * m) :=
  hiTailM256K512KrotovCertCircuitImpl res n m k

private lemma hm256k512kr_circuit_eq {Var : Type} [DecidableEq Var] (res : Var) (n : ℕ)
    {m k : ℕ} (h : isHiTailM256K512KrotovCertCell m k = true) :
    findAllJohnsonRampKick128kHiTailM256K512KrotovCertCircuit res n m k =
      let p := hm256k512kr_all_props h
      DickeSol.rkm128kCellCircuit res p.hmG p.hkG hm256k512krVPot hm256k512krAnchors p.hk512
        (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n := by
  unfold findAllJohnsonRampKick128kHiTailM256K512KrotovCertCircuit
    hiTailM256K512KrotovCertCircuitImpl
  exact dite_eq_left h

/-- Exact probability-1 recovery of S on the (256, 512) cell. -/
theorem hiTailM256K512KrotovCert_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isHiTailM256K512KrotovCertCell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ ⊤ ⦄
    (QProg.qSet ;;
      (findAllJohnsonRampKick128kHiTailM256K512KrotovCertCircuit res n m k).compile QProg.qAssign
        (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  have hS' : S ∈ DickeSol.groverTargetSets n k := by rwa [hm256k512kr_targetSets_eq]
  have hp := hm256k512kr_all_props hcell
  rw [hm256k512kr_circuit_eq res n hcell, ← hm256k512kr_oracle_eq]
  exact DickeSol.rkm128kCell_correctness res hp.hmG hp.hkG hm256k512krVPot hm256k512krAnchors
    hp.hk512 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm hp.htab hp.hlmax hn hkN hS'

/-- Asymptotic uniform-average relative-cost bound on the (256, 512) cell. -/
theorem hiTailM256K512KrotovCert_relCost {Var : Type} [DecidableEq Var] (res : Var)
    {m k : ℕ} (hcell : isHiTailM256K512KrotovCertCell m k = true) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, k ≤ 2 ^ n →
      ∃ q : Finset (Fin (2 ^ n)) → ℝ≥0,
        (∀ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k,
          CostBound
            (CostModel.ofEmbeddedOracle (GroverFindAll.parallelMarkingOracle m S))
            (QProg.qSet ;;
              (findAllJohnsonRampKick128kHiTailM256K512KrotovCertCircuit res n m k).compile
                QProg.qAssign (GroverFindAll.parallelMarkingOracle m S)) (q S)) ∧
        (∑ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k, (q S : ℝ)) /
            ((Finset.univ : Finset (Fin (2 ^ n))).powersetCard k).card ≤
          ((relCostHiTailM256K512KrotovCert m k : ℚ≥0) : ℝ) *
            ((π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m)) := by
  have hp := hm256k512kr_all_props hcell
  obtain ⟨n₁, hn₁⟩ := DickeSol.rkm128kCell_rel_cost (Var := Var) res hp.hmG hp.hkG
    hm256k512krVPot hm256k512krAnchors hp.hk512 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm
    hp.htab hp.hlmax hp.hcost
  refine ⟨n₁, fun n hn hkN ↦ ?_⟩; obtain ⟨q, hq, hsum⟩ := hn₁ n hn hkN
  refine ⟨q, fun S hS ↦ ?_, ?_⟩
  · rw [hm256k512kr_circuit_eq res n hcell, ← hm256k512kr_oracle_eq]
    exact hq S (by rwa [hm256k512kr_targetSets_eq])
  · rw [← hm256k512kr_targetSets_eq, ← hm256k512kr_vanilla_eq]; exact hsum

