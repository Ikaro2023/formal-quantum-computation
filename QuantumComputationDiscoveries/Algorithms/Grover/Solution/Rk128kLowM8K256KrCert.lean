/-
# Krotov `(8, 256)` Certificate (`Rk128kLowM8K256KrCert`)

QHL-verified module packaging cell `(8, 256)` over `21` anchors (`443,513` F1272 /
`449,467` Horner coord-ops at `lTableMax = 63`, `useColdR2 = true`).
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kLowM8K256KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported (m, k) cell (m = 8, k = 256, 1 cell). -/
def isLowM8K256KrotovCertCell (m k : ℕ) : Bool :=
  if m == 8 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor L_max(8, 256) = 63 (63 * 8 = 504 <= 65536). -/
def lowM8K256KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 8 then
    if k == 256 then 63
    else 1
  else 1

/-- Total register qubit budget (lowM8K256KrotovCertCellLMax m k * m) * (n + 1) + k * n. -/
abbrev lowM8K256KrotovCertQubits (n m k : ℕ) : ℕ :=
  (lowM8K256KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile c(8, 256): ℚ≥0. -/
def relCostLowM8K256KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 8 then
    if k == 256 then NNRat.divNat 245114394396743 1000000000000000
    else 1
  else 1

/-- Cost profile metadata (n0 = 80000, constructive threshold). -/
def lowM8K256KrotovCertProfile : FindAllCostProfile :=
  ⟨isLowM8K256KrotovCertCell, relCostLowM8K256KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kLowM8K256KrCert` cell lies on groverGrid × groverGrid. -/
theorem isLowM8K256KrotovCertCell_isGridCell {m k : ℕ}
    (h : isLowM8K256KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isLowM8K256KrotovCertCell at h
  split_ifs at h with hm8 hk256
  simp only [beq_iff_eq] at hm8 hk256
  subst hm8 hk256; rfl

end

