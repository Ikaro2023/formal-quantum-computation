private def lm8NatEq (x y : ℕ) : Bool := Bool.and (Nat.ble x y) (Nat.ble y x)
private theorem lm8NatEq_eq {x y : ℕ} (h : lm8NatEq x y = true) : x = y := by
  unfold lm8NatEq at h; rw [Bool.and_eq_true, Nat.ble_eq, Nat.ble_eq] at h; omega
private def lm8IntEq (a b : ℤ) : Bool :=
  match a, b with
  | Int.ofNat m, Int.ofNat n => lm8NatEq m n
  | Int.negSucc m, Int.negSucc n => lm8NatEq m n
  | _, _ => false
private theorem lm8IntEq_eq {a b : ℤ} (h : lm8IntEq a b = true) : a = b := by
  cases a with
  | ofNat m =>
    cases b with
    | ofNat n => dsimp only [lm8IntEq] at h; exact congrArg Int.ofNat (lm8NatEq_eq h)
    | negSucc _ => cases h
  | negSucc m =>
    cases b with
    | ofNat _ => cases h
    | negSucc n => dsimp only [lm8IntEq] at h; exact congrArg Int.negSucc (lm8NatEq_eq h)
private def lm8ListEq {α : Type} (eqF : α → α → Bool) (xs ys : List α) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (eqF x y) (lm8ListEq eqF xr yr) false
  | _, _ => false
private theorem lm8ListEq_eq {α : Type} {eqF : α → α → Bool}
    (heq : ∀ {a b : α}, eqF a b = true → a = b) {xs ys : List α}
    (h : lm8ListEq eqF xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with
    | nil => cases h
    | cons y yr =>
      dsimp only [lm8ListEq] at h; cases hxy : eqF x y with
      | false => rw [hxy] at h; cases h
      | true => rw [hxy] at h; exact congrArg₂ List.cons (heq hxy) (ih h)
private abbrev Lm8St := ℕ × ℕ × ℕ × List ℤ
private def lm8StEq (a b : Lm8St) : Bool :=
  match a, b with
  | (a1, a2, a3, av), (b1, b2, b3, bv) =>
    cond (lm8NatEq a1 b1)
      (cond (lm8NatEq a2 b2) (cond (lm8NatEq a3 b3) (lm8ListEq lm8IntEq av bv) false) false) false
private theorem lm8StEq_eq {a b : Lm8St} (h : lm8StEq a b = true) : a = b := by
  rcases a with ⟨a1, a2, a3, av⟩; rcases b with ⟨b1, b2, b3, bv⟩; dsimp only [lm8StEq] at h
  cases h1 : lm8NatEq a1 b1 with
  | false => rw [h1] at h; cases h
  | true =>
    rw [h1] at h; dsimp only [cond] at h; cases h2 : lm8NatEq a2 b2 with
    | false => rw [h2] at h; cases h
    | true =>
      rw [h2] at h; dsimp only [cond] at h; cases h3 : lm8NatEq a3 b3 with
      | false => rw [h3] at h; cases h
      | true =>
        rw [h3] at h; dsimp only [cond] at h
        exact Prod.ext (lm8NatEq_eq h1)
          (Prod.ext (lm8NatEq_eq h2) (Prod.ext (lm8NatEq_eq h3) (lm8ListEq_eq (@lm8IntEq_eq) h)))
private def lm8AtF (bs : List Bool) : Bool :=
  match bs with
  | [] => true
  | b :: rest => cond b (lm8AtF rest) false
private theorem lm8_hd {b : Bool} {bs : List Bool} (h : lm8AtF (b :: bs) = true) : b = true := by
  unfold lm8AtF at h; cases b with
  | false => cases h
  | true => rfl
private theorem lm8_tl1 {b : Bool} {s : List Bool} (h : lm8AtF (b :: s) = true) :
    lm8AtF s = true := by
  unfold lm8AtF at h; cases b with
  | false => cases h
  | true => exact h
private theorem lm8_tl2 {b1 b2 : Bool} {bs : List Bool}
    (h : lm8AtF (b1 :: b2 :: bs) = true) : lm8AtF bs = true := lm8_tl1 (lm8_tl1 h)
private theorem lm8_and_l {a b : Bool} (h : Bool.and a b = true) : a = true := by
  cases a with
  | false => cases h
  | true => rfl
private theorem lm8_and_r {a b : Bool} (h : Bool.and a b = true) : b = true := by
  cases a with
  | false => cases h
  | true =>
    cases b with
    | false => cases h
    | true => rfl
private abbrev lm8M (l t n d r : ℕ) (w : List ℕ) : DickeSol.Rkm128kSeg :=
  ⟨l, t, n, d, DickeSol.rkm128kMask56 r w⟩
private def lm8ChkRow (r : ℕ) (s : List DickeSol.Rkm128kSeg) (ro : List ℕ) : Bool :=
  lm8ListEq lm8NatEq (DickeSol.rkm128kEvalRowLo12 8 63 r s) ro
private def lm8ChkAnchors (xs : List DickeSol.RampKick128kAnchor) : Bool :=
  match xs with
  | [] => true
  | a :: rest =>
    match a with
    | ⟨rAct, segs, row⟩ => cond (lm8ChkRow rAct segs row) (lm8ChkAnchors rest) false
private theorem lm8ChkAnchors_append {xs rest : List DickeSol.RampKick128kAnchor}
    (hxs : lm8ChkAnchors xs = true) (hrest : DickeSol.RampKick128kAnchorsSound 8 63 rest) :
    DickeSol.RampKick128kAnchorsSound 8 63 (xs ++ rest) := by
  induction xs with
  | nil => exact hrest
  | cons a tl ih =>
    rcases a with ⟨rAct, segs, row⟩; rw [List.cons_append]
    dsimp only [lm8ChkAnchors, DickeSol.RampKick128kAnchorsSound] at hxs ⊢
    cases ha : lm8ChkRow rAct segs row with
    | false => rw [ha] at hxs; cases hxs
    | true =>
      rw [ha] at hxs; dsimp only [cond] at hxs; exact ⟨lm8ListEq_eq (@lm8NatEq_eq) ha, ih hxs⟩
private def lm8ChkSeg (r : ℕ) (s : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (st1 : Lm8St) : Bool := lm8StEq (DickeSol.rkm128kRunSegs 8 63 r s l0 d0 p0 v0) st1
private def lm8ChkFin (r : ℕ) (s : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (ro : List ℕ) : Bool :=
  lm8ListEq lm8NatEq (DickeSol.rkm128kFinalizeState
    (DickeSol.rkm128kRunSegs 8 63 r s l0 d0 p0 v0)) ro
private def lm8SegBds (r : ℕ) (s : List DickeSol.Rkm128kSeg) : Bool :=
  Bool.and (Nat.ble 1 (DickeSol.rkm128kSegListLen s))
    (Bool.and (Nat.ble (DickeSol.rkm128kSegListLen s) 128)
      (Bool.and (Nat.ble 2 r) (Nat.ble r 1024)))
private def lm8TailOk (r : ℕ) (rest : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (ro : List ℕ) : Prop :=
  ∃ st, DickeSol.rkm128kRunSegs 8 63 r rest l0 d0 p0 v0 = st ∧
    DickeSol.rkm128kFinalizeState st = ro
private theorem lm8TailEnd {r : ℕ} {cLast : List DickeSol.Rkm128kSeg} {l0 d0 p0 : ℕ} {v0 : List ℤ}
    {ro : List ℕ} (h : lm8ChkFin r cLast l0 d0 p0 v0 ro = true) :
    lm8TailOk r cLast l0 d0 p0 v0 ro := ⟨_, rfl, lm8ListEq_eq (@lm8NatEq_eq) h⟩
private theorem lm8TailStep {r : ℕ} {cCur rest : List DickeSol.Rkm128kSeg}
    {l0 d0 p0 l1 d1 p1 : ℕ} {v0 v1 : List ℤ} {ro : List ℕ}
    (h1 : lm8ChkSeg r cCur l0 d0 p0 v0 (l1, d1, p1, v1) = true)
    (h2 : lm8TailOk r rest l1 d1 p1 v1 ro) : lm8TailOk r (cCur ++ rest) l0 d0 p0 v0 ro := by
  rcases h2 with ⟨st, hr, hf⟩; refine ⟨st, ?_, hf⟩
  unfold lm8ChkSeg at h1; rw [DickeSol.rkm128kRunSegs_append, lm8StEq_eq h1]; exact hr
private theorem lm8CertSplit {r : ℕ} {segs : List DickeSol.Rkm128kSeg} {ro : List ℕ}
    (hb : lm8SegBds r segs = true) (ht : lm8TailOk r segs 1 0 1 [Int.ofNat DickeSol.wdScale] ro) :
    DickeSol.rkm128kEvalRowLo12 8 63 r segs = ro := by
  rcases ht with ⟨st, hr, hf⟩; exact DickeSol.rkm128kCertRow_of_runSegs hb hr hf
private def lm8ChkCell (k lm n d : ℕ) (v : List ℕ) (a : List DickeSol.RampKick128kAnchor) : Bool :=
  Bool.and (DickeSol.rkm128kCheckAnchorsLMax k lm a)
    (DickeSol.checkAltBound12 8 k (v.getD k 0) n d)

