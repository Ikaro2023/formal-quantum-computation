private def _drT : ℕ → List (IvInt × IvInt) → List (IvInt × IvInt)
  | 0, xs => xs
  | _ + 1, [] => []
  | k + 1, _ :: xs => _drT k xs
private def _drZ : ℕ → List ℤ → List ℤ
  | 0, xs => xs
  | _ + 1, [] => []
  | k + 1, _ :: xs => _drZ k xs
private def _mCS (a b c d : ℤ) : ℤ × ℤ :=
  solKeepZ (solGmpDivScale (solGmpSubZ (solGmpMulZ a c) (solGmpMulZ b d)))
    fun re ↦ solKeepZ (solGmpDivScale (solGmpAddZ (solGmpMulZ a d)
      (solGmpMulZ b c))) fun im ↦ (re, im)
private def _pCS : ℕ → ℕ → ℤ → ℤ → ℤ → ℤ → ℤ × ℤ
  | 0, _, ra, rb, _, _ => (ra, rb)
  | f + 1, k, ra, rb, ba, bb =>
      match cond (Nat.ble 1 (Nat.mod k 2)) (_mCS ra rb ba bb) (ra, rb) with
      | (ra', rb') => solLitNat (Nat.div k 2) fun k' ↦
          cond (Nat.ble 1 k') (match _mCS ba bb ba bb with
            | (ba', bb') => _pCS f k' ra' rb' ba' bb') (ra', rb')
private def _rCh (fwd : Bool) (dt rad bias r2 : ℕ) :
    ℕ → ℕ → List (IvInt × IvInt) → List ℤ → List ℤ → List ℤ
  | 0, _, _, _, tail => tail
  | m + 1, pk, ts, cs, tail => match ts, cs with
      | (cw, sw) :: ts', ae :: ao :: cs' =>
          let c1 := solGmpDiv2 (solGmpAddZ cw.1 cw.2)
          let s0 := solGmpDiv2 (solGmpAddZ sw.1 sw.2)
          let s1 := cond fwd s0 (solGmpNegZ s0)
          match _pCS 10 dt (Int.ofNat 1000000000) (Int.ofNat 0) c1 s1 with
          | (ck, sk) => match _mCS ck sk ae ao with
              | (pe, po) =>
                  let de := solGmpSubNat (Nat.mod pk rad) bias
                  let do0 := solGmpSubNat (Nat.mod (Nat.div pk rad) rad) bias
                  solLitNat (Nat.div pk r2) fun pk' ↦
                    solKeepZ (solGmpAddZ pe de) fun xe ↦
                      solKeepZ (solGmpAddZ po do0) fun xo ↦
                        xe :: xo :: _rCh fwd dt rad bias r2 m pk' ts' cs' tail
      | _, _ => tail
private def _rLp (fwd : Bool) (dt rad bias pCnt r2 : ℕ) :
    List ℕ → ℕ → List (IvInt × IvInt) → List ℤ → List ℤ → List ℤ
  | [], _, _, _, tail => tail
  | pk :: rest, rem, ts, cs, tail =>
      let cnt := solMinNat pCnt rem
      _rCh fwd dt rad bias r2 cnt pk ts cs
        (_rLp fwd dt rad bias pCnt r2 rest (Nat.sub rem cnt)
          (_drT cnt ts) (_drZ (Nat.mul 2 cnt) cs) tail)
private def _uR (trg : List (IvInt × IvInt)) (fwd : Bool) (dt rad bias pCnt nRot : ℕ)
