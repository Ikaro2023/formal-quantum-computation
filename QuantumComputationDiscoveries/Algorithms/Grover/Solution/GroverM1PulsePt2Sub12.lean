  solLitNat (Nat.mul rad rad) fun r2 ↦ solWithTrigList trg fun ts0 ↦
    solWithIntList anc fun cs0 ↦ _rLp fwd dt rad bias pCnt r2 rPks nRot ts0 cs0 tail
