private def _uZg (u : ℕ) : ℤ :=
  match Nat.mod u 2 with
  | 0 => solLitNat (Nat.div u 2) Int.ofNat
  | _ => solLitNat (Nat.div u 2) Int.negSucc
private def _uStep (w : ℕ) (tl : List ℤ) : List ℤ :=
  match Nat.ble 287296000000000000 w with
  | true => solKeepZ (_uZg (Nat.sub w 287296000000000000)) fun z ↦ z :: tl
  | false =>
      solKeepZ (_uZg (Nat.mod w 536000000)) fun a ↦
        solKeepZ (_uZg (Nat.div w 536000000)) fun b ↦ a :: b :: tl
private def _uPk : List ℕ → List ℤ
  | [] => []
  | w :: ws => _uStep w (_uPk ws)
private def _wkbPair (q : SolWkbSched) (trig : List (IvInt × IvInt))
    (t0 d0 t1 d1 : ℕ) (c0 : List ℤ) (h0 r0 : ℕ) (s0 : ℤ)
    (c1 : List ℤ) (h1 r1 : ℕ) (s1 : ℤ) (c2 : List ℤ) (h2 r2 : ℕ) (s2 : ℤ) : Bool :=
  match solFastCheckWkbSliceZc q t0 d0 trig c0 h0 r0 s0 c1 h1 r1 s1 with
  | true => solFastCheckWkbSliceZc q t1 d1 trig c1 h1 r1 s1 c2 h2 r2 s2
  | false => false
private theorem _ws2 {q : SolWkbSched} {trig : List (IvInt × IvInt)}
    (t0 d0 t1 d1 t2 : ℕ) {c0 c1 c2 : List ℤ} {h0 r0 h1 r1 h2 r2 : ℕ}
    {s0 s1 s2 : ℤ} (ha : t0 + d0 = t1) (hb : t1 + d1 = t2)
    (hp : SolWkbRunPrefix q trig t0 c0 h0 r0 s0)
    (hc : _wkbPair q trig t0 d0 t1 d1 c0 h0 r0 s0 c1 h1 r1 s1 c2 h2 r2 s2 = true) :
    SolWkbRunPrefix q trig t2 c2 h2 r2 s2 := by
  unfold _wkbPair at hc; revert hc
  cases h1c : solFastCheckWkbSliceZc q t0 d0 trig c0 h0 r0 s0 c1 h1 r1 s1
  · intro hc; cases hc
  · intro hc; exact solFastWkbStepZc_eq hb (solFastWkbStepZc_eq ha hp h1c) hc
