/-
# 64-Segment 128k `(32, 256)` Certificate (`Rk128kMidM32L64HiCert`)

QHL-verified module packaging cell `(32, 256)` (`lTableMax = 14`, `L <= 64`, `18` active
anchors, `520,395` Horner coord-ops).
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kMidM32L64HiCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported `(m, k)` cell (`m = 32, k = 256`, `1` cell). -/
def isMidM32L64HiCertCell (m k : ℕ) : Bool :=
  if m == 32 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor `L_{\max}(32, 256) = 14` on `(32, 256)`. -/
def midM32L64HiCertCellLMax (m k : ℕ) : ℕ :=
  if m == 32 then
    if k == 256 then 14
    else 1
  else 1

/-- Total register qubit budget `(midM32L64HiCertCellLMax m k * m) * (n + 1) + k * n`. -/
abbrev midM32L64HiCertQubits (n m k : ℕ) : ℕ :=
  (midM32L64HiCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified relative-cost profile `c(m, k): ℚ≥0` on `(32, 256)`. -/
def relCostMidM32L64HiCert (m k : ℕ) : ℚ≥0 :=
  if m == 32 then
    if k == 256 then NNRat.divNat 24981916805399 200000000000000
    else 1
  else 1

/-- Cost profile metadata (`n0 = 80000`, constructive threshold). -/
def midM32L64HiCertProfile : FindAllCostProfile :=
  ⟨isMidM32L64HiCertCell, relCostMidM32L64HiCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kMidM32L64HiCert` cell lies on `groverGrid × groverGrid`. -/
theorem isMidM32L64HiCertCell_isGridCell {m k : ℕ}
    (h : isMidM32L64HiCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isMidM32L64HiCertCell at h
  split_ifs at h with hm32 hk256
  simp only [beq_iff_eq] at hm32 hk256
  subst hm32 hk256; rfl

end

