private def m3hNatEq (x y : ℕ) : Bool := Bool.and (Nat.ble x y) (Nat.ble y x)
private def m3hListNatEq (xs ys : List ℕ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (m3hNatEq x y) (m3hListNatEq xr yr) false
  | _, _ => false
private lemma m3hNatEq_eq {x y : ℕ} (h : m3hNatEq x y = true) : x = y := by
  unfold m3hNatEq at h; simp only [Bool.and_eq_true, Nat.ble_eq] at h; omega
private lemma m3hListNatEq_eq {xs ys : List ℕ} (h : m3hListNatEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil => cases ys with | nil => rfl | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with | nil => cases h | cons y yr =>
      change cond (m3hNatEq x y) (m3hListNatEq xr yr) false = true at h
      cases hxy : m3hNatEq x y <;> rw [hxy] at h <;> [cases h; rw [m3hNatEq_eq hxy, ih h]]
private def m3hUnzz (xs : List ℕ) : List ℤ :=
  match xs with
  | [] => []
  | u :: rest =>
    cond (Nat.ble (Nat.mod u 2) 0)
      (Int.ofNat (Nat.div u 2)) (Int.negSucc (Nat.div u 2)) :: m3hUnzz rest
private def m3hIntEq (x y : ℤ) : Bool :=
  match x, y with
  | Int.ofNat a, Int.ofNat b => m3hNatEq a b
  | Int.negSucc a, Int.negSucc b => m3hNatEq a b
  | _, _ => false
private lemma m3hIntEq_eq {x y : ℤ} (h : m3hIntEq x y = true) : x = y := by
  cases x <;> cases y <;> simp only [m3hIntEq] at h <;> first | cases h | rw [m3hNatEq_eq h]
private def m3hListIntEq (xs ys : List ℤ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (m3hIntEq x y) (m3hListIntEq xr yr) false
  | _, _ => false
private lemma m3hListIntEq_eq {xs ys : List ℤ} (h : m3hListIntEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil => cases ys with | nil => rfl | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with | nil => cases h | cons y yr =>
      change cond (m3hIntEq x y) (m3hListIntEq xr yr) false = true at h
      cases hxy : m3hIntEq x y <;> rw [hxy] at h <;> [cases h; rw [m3hIntEq_eq hxy, ih h]]
private lemma m3h_and_l {a b : Bool} (h : Bool.and a b = true) : a = true := by
  cases a <;> cases h; rfl
private lemma m3h_and_r {a b : Bool} (h : Bool.and a b = true) : b = true := by
  cases a <;> cases b <;> cases h; rfl
private def m3hStEq (a b : ℕ × ℕ × ℕ × List ℤ) : Bool :=
  Bool.and (m3hNatEq a.1 b.1) (Bool.and (m3hNatEq a.2.1 b.2.1)
    (Bool.and (m3hNatEq a.2.2.1 b.2.2.1) (m3hListIntEq a.2.2.2 b.2.2.2)))
private lemma m3hStEq_eq {a b : ℕ × ℕ × ℕ × List ℤ} (h : m3hStEq a b = true) : a = b := by
  rcases a with ⟨l1, d1, p1, v1⟩; rcases b with ⟨l2, d2, p2, v2⟩
  unfold m3hStEq at h; have h2 := m3h_and_r h; have h3 := m3h_and_r h2
  rw [m3hNatEq_eq (x := l1) (y := l2) (m3h_and_l h),
    m3hNatEq_eq (x := d1) (y := d2) (m3h_and_l h2),
    m3hNatEq_eq (x := p1) (y := p2) (m3h_and_l h3),
    m3hListIntEq_eq (xs := v1) (ys := v2) (m3h_and_r h3)]
private def m3hAtF (bs : List Bool) : Bool :=
  match bs with | [] => true | b :: rest => cond b (m3hAtF rest) false
private lemma m3h_hd {b : Bool} {bs : List Bool} (h : m3hAtF (b :: bs) = true) : b = true := by
  unfold m3hAtF at h; cases b <;> first | cases h | rfl
private lemma m3h_tl1 {b : Bool} {s : List Bool}
    (h : m3hAtF (b :: s) = true) : m3hAtF s = true := by
  unfold m3hAtF at h; cases b <;> first | cases h | exact h
private lemma m3h_tl2 {b1 b2 : Bool} {bs : List Bool}
    (h : m3hAtF (b1 :: b2 :: bs) = true) : m3hAtF bs = true := m3h_tl1 (m3h_tl1 h)
private lemma m3h_tl4 {b1 b2 b3 b4 : Bool} {bs : List Bool}
    (h : m3hAtF (b1 :: b2 :: b3 :: b4 :: bs) = true) : m3hAtF bs = true := m3h_tl2 (m3h_tl2 h)
private abbrev m3hM (l t n d r : ℕ) (w : List ℕ) : DickeSol.Rkm128kSeg :=
  ⟨l, t, n, d, DickeSol.rkm128kMask56 r w⟩
private abbrev m3hChkRow (r : ℕ) (s : List DickeSol.Rkm128kSeg) (ro : List ℕ) : Bool :=
  m3hListNatEq (DickeSol.rkm128kEvalRowLo12 32 14 r s) ro
private abbrev m3hChkSeg (r : ℕ) (s : List DickeSol.Rkm128kSeg)
    (s0 s1 : ℕ × ℕ × ℕ × List ℤ) : Bool :=
  m3hStEq (DickeSol.rkm128kRunSegs 32 14 r s s0.1 s0.2.1 s0.2.2.1 s0.2.2.2) s1
private abbrev m3hChkFin (r : ℕ) (s : List DickeSol.Rkm128kSeg)
    (s0 : ℕ × ℕ × ℕ × List ℤ) (ro : List ℕ) : Bool :=
  m3hListNatEq (DickeSol.rkm128kFinalizeState
    (DickeSol.rkm128kRunSegs 32 14 r s s0.1 s0.2.1 s0.2.2.1 s0.2.2.2)) ro
private abbrev m3hSegBds (r : ℕ) (s : List DickeSol.Rkm128kSeg) : Bool :=
  Bool.and (Nat.ble 1 (DickeSol.rkm128kSegListLen s))
    (Bool.and (Nat.ble (DickeSol.rkm128kSegListLen s) 128)
      (Bool.and (Nat.ble 2 r) (Nat.ble r 1024)))
private def m3hInitSt : ℕ × ℕ × ℕ × List ℤ := (1, 0, 1, [Int.ofNat DickeSol.wdScale])
private def m3hTailOk (r : ℕ) (rest : List DickeSol.Rkm128kSeg)
    (sIn : ℕ × ℕ × ℕ × List ℤ) (ro : List ℕ) : Prop :=
  ∃ st, DickeSol.rkm128kRunSegs 32 14 r rest sIn.1 sIn.2.1 sIn.2.2.1 sIn.2.2.2 = st ∧
    DickeSol.rkm128kFinalizeState st = ro
private lemma m3hTailEnd {r : ℕ} {cLast : List DickeSol.Rkm128kSeg}
    {sIn : ℕ × ℕ × ℕ × List ℤ} {ro : List ℕ}
    (h : m3hChkFin r cLast sIn ro = true) : m3hTailOk r cLast sIn ro :=
  ⟨_, rfl, m3hListNatEq_eq h⟩
private lemma m3hTailStep {r : ℕ} {cCur rest : List DickeSol.Rkm128kSeg}
    {sIn sMid : ℕ × ℕ × ℕ × List ℤ} {ro : List ℕ}
    (h1 : m3hChkSeg r cCur sIn sMid = true) (h2 : m3hTailOk r rest sMid ro) :
    m3hTailOk r (cCur ++ rest) sIn ro := by
  rcases h2 with ⟨st, hr, hf⟩
  have hm : DickeSol.rkm128kRunSegs 32 14 r cCur sIn.1 sIn.2.1 sIn.2.2.1 sIn.2.2.2 = sMid :=
    m3hStEq_eq h1
  refine ⟨st, ?_, hf⟩
  rw [DickeSol.rkm128kRunSegs_append]; dsimp only; rw [hm]; exact hr
private lemma m3hCertSplit {r : ℕ} {segs : List DickeSol.Rkm128kSeg} {ro : List ℕ}
    (hb : m3hSegBds r segs = true) (ht : m3hTailOk r segs m3hInitSt ro) :
    DickeSol.rkm128kEvalRowLo12 32 14 r segs = ro := by
  rcases ht with ⟨st, hr, hf⟩
  unfold m3hInitSt at hr
  exact DickeSol.rkm128kCertRow_of_runSegs hb hr hf
private abbrev m3hChkCell (k lm n d : ℕ) (v : List ℕ)
    (a : List DickeSol.RampKick128kAnchor) : Bool :=
  Bool.and (DickeSol.rkm128kCheckAnchorsLMax k lm a)
    (DickeSol.checkAltBound12 32 k (v.getD k 0) n d)

