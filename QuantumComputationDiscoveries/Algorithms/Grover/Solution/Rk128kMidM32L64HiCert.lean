private lemma mm32L64Hi_oracle_eq {n : ℕ} (m : ℕ) (S : Finset (Fin (2 ^ n))) :
    DickeSol.groverParallelMarkingOracle m S = GroverFindAll.parallelMarkingOracle m S := by
  unfold DickeSol.groverParallelMarkingOracle DickeSol.groverSetMarkingOracle
    GroverFindAll.parallelMarkingOracle GroverFindAll.setMarkingOracle; rfl

private lemma mm32L64Hi_targetSets_eq (n k : ℕ) :
    DickeSol.groverTargetSets n k = (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k := rfl

private lemma mm32L64Hi_vanilla_eq (n m k : ℕ) : DickeSol.vanillaFindAllCost n m k =
    (π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m) := rfl

private abbrev Mm32L64HiCellCert (m k : ℕ) : Prop :=
  2 ≤ midM32L64HiCertCellLMax m k ∧ 1 ≤ midM32L64HiCertCellLMax m k ∧
    midM32L64HiCertCellLMax m k * m ≤ 65536 ∧
    DickeSol.rkm128kCheckAnchorsLMax k (midM32L64HiCertCellLMax m k) mm32L64HiAnchors = true ∧
    ∃ num den : ℕ, relCostMidM32L64HiCert m k = NNRat.divNat num den ∧
      DickeSol.checkAltBound12 m k (mm32L64HiVPot.getD k 0) num den = true

private lemma mm32L64Hi_le_of_add {a b d : ℕ} (h : a + d = b) : a ≤ b := h ▸ Nat.le_add_right a d

private lemma mm32L64Hi_mem_grid (j d : ℕ) (h : (j + 1) + d = 11) : 2 ^ j ∈ DickeSol.groverGrid :=
  Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr (mm32L64Hi_le_of_add h), rfl⟩

private lemma mm32L64Hi_mk_cell {k dl dm : ℕ}
    (hchk : DickeSol.rkm128kCheckAnchorsLMax k (midM32L64HiCertCellLMax 32 k)
        mm32L64HiAnchors = true ∧
      ∃ num den : ℕ, relCostMidM32L64HiCert 32 k = NNRat.divNat num den ∧
        DickeSol.checkAltBound12 32 k (mm32L64HiVPot.getD k 0) num den = true)
    (h2 : 2 + dl = midM32L64HiCertCellLMax 32 k)
    (hm : midM32L64HiCertCellLMax 32 k * 32 + dm = 65536) :
    Mm32L64HiCellCert 32 k :=
  have hle2 : 2 ≤ midM32L64HiCertCellLMax 32 k := mm32L64Hi_le_of_add h2
  ⟨hle2, Nat.le_trans (mm32L64Hi_le_of_add (d := 1) rfl) hle2, mm32L64Hi_le_of_add hm,
    hchk.1, hchk.2⟩

private lemma mm32L64Hi_all_props {m k : ℕ} (h : isMidM32L64HiCertCell m k = true) :
    m ∈ DickeSol.groverGrid ∧ k ∈ DickeSol.groverGrid ∧ k ≤ 256 ∧ 2 ≤ m ∧
      DickeSol.RampKick128kTableValid m 256 14 true mm32L64HiVPot mm32L64HiAnchors ∧
      Mm32L64HiCellCert m k := by
  have hchk := mm32L64HiCellChecks h
  unfold isMidM32L64HiCertCell at h
  split_ifs at h with hm32 hk256
  simp only [beq_iff_eq] at hm32 hk256
  subst hm32 hk256
  exact ⟨mm32L64Hi_mem_grid 5 5 rfl, mm32L64Hi_mem_grid 8 2 rfl, mm32L64Hi_le_of_add (d := 0) rfl,
    mm32L64Hi_le_of_add (d := 30) rfl, mm32L64HiValid,
    mm32L64Hi_mk_cell (dl := 12) (dm := 65088) hchk rfl rfl⟩

private noncomputable def midM32L64HiCertCircuitImpl {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) : OracleDynamicCircuit (Unitary (2 ^ midM32L64HiCertQubits n m k)) Var
      (midM32L64HiCertQubits n m k) ((n + 1) * m) :=
  if h : isMidM32L64HiCertCell m k = true then
    let p := mm32L64Hi_all_props h
    DickeSol.rkm128kCellCircuit res p.1 p.2.1 mm32L64HiVPot mm32L64HiAnchors p.2.2.1
      (fun _ ↦ p.2.2.2.1) (fun _ ↦ p.2.2.2.2.2.1) p.2.2.2.2.2.2.1 p.2.2.2.2.2.2.2.1 p.2.2.2.2.1
      p.2.2.2.2.2.2.2.2.1 n
  else .skip

/-- Dynamic parallel query-model circuit for the supported `(32, 256)` cell. -/
noncomputable def findAllJohnsonRampKick128kMidM32L64HiCertCircuit {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ midM32L64HiCertQubits n m k)) Var
      (midM32L64HiCertQubits n m k) ((n + 1) * m) :=
  midM32L64HiCertCircuitImpl res n m k

private lemma mm32L64Hi_circuit_eq {Var : Type} [DecidableEq Var] (res : Var) (n : ℕ)
    {m k : ℕ} (h : isMidM32L64HiCertCell m k = true) :
    findAllJohnsonRampKick128kMidM32L64HiCertCircuit res n m k =
      let p := mm32L64Hi_all_props h
      DickeSol.rkm128kCellCircuit res p.1 p.2.1 mm32L64HiVPot mm32L64HiAnchors p.2.2.1
        (fun _ ↦ p.2.2.2.1) (fun _ ↦ p.2.2.2.2.2.1) p.2.2.2.2.2.2.1 p.2.2.2.2.2.2.2.1 p.2.2.2.2.1
        p.2.2.2.2.2.2.2.2.1 n := by
  unfold findAllJohnsonRampKick128kMidM32L64HiCertCircuit midM32L64HiCertCircuitImpl
  exact dite_eq_left h

/-- Exact probability-`1` recovery of `S` on the supported `(32, 256)` cell. -/
theorem midM32L64HiCert_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isMidM32L64HiCertCell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ (⊤ : CQAssertion (Store Var) (2 ^ midM32L64HiCertQubits n m k)) ⦄
    (QProg.qSet ;;
      (findAllJohnsonRampKick128kMidM32L64HiCertCircuit res n m k).compile QProg.qAssign
        (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  have hS' : S ∈ DickeSol.groverTargetSets n k := by rwa [mm32L64Hi_targetSets_eq]
  have hp := mm32L64Hi_all_props hcell
  rw [mm32L64Hi_circuit_eq res n hcell, ← mm32L64Hi_oracle_eq]
  exact DickeSol.rkm128kCell_correctness res hp.1 hp.2.1 mm32L64HiVPot mm32L64HiAnchors hp.2.2.1
    (fun _ ↦ hp.2.2.2.1) (fun _ ↦ hp.2.2.2.2.2.1) hp.2.2.2.2.2.2.1 hp.2.2.2.2.2.2.2.1
    hp.2.2.2.2.1 hp.2.2.2.2.2.2.2.2.1 hn hkN hS'

/-- Asymptotic uniform-average relative-cost bound on the supported `(32, 256)` cell. -/
theorem midM32L64HiCert_relCost {Var : Type} [DecidableEq Var] (res : Var)
    {m k : ℕ} (hcell : isMidM32L64HiCertCell m k = true) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, k ≤ 2 ^ n →
      ∃ q : Finset (Fin (2 ^ n)) → ℝ≥0,
        (∀ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k,
          CostBound
            (CostModel.ofEmbeddedOracle (GroverFindAll.parallelMarkingOracle m S))
            (QProg.qSet ;;
              (findAllJohnsonRampKick128kMidM32L64HiCertCircuit res n m k).compile QProg.qAssign
                (GroverFindAll.parallelMarkingOracle m S)) (q S)) ∧
        (∑ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k, (q S : ℝ)) /
            ((Finset.univ : Finset (Fin (2 ^ n))).powersetCard k).card ≤
          ((relCostMidM32L64HiCert m k : ℚ≥0) : ℝ) *
            ((π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m)) := by
  have hp := mm32L64Hi_all_props hcell
  obtain ⟨n₁, hn₁⟩ := DickeSol.rkm128kCell_rel_cost (Var := Var) res hp.1 hp.2.1 mm32L64HiVPot
    mm32L64HiAnchors hp.2.2.1 (fun _ ↦ hp.2.2.2.1) (fun _ ↦ hp.2.2.2.2.2.1) hp.2.2.2.2.2.2.1
    hp.2.2.2.2.2.2.2.1 hp.2.2.2.2.1 hp.2.2.2.2.2.2.2.2.1 hp.2.2.2.2.2.2.2.2.2
  refine ⟨n₁, fun n hn hkN ↦ ?_⟩; obtain ⟨q, hq, hsum⟩ := hn₁ n hn hkN
  refine ⟨q, fun S hS ↦ ?_, ?_⟩
  · rw [mm32L64Hi_circuit_eq res n hcell, ← mm32L64Hi_oracle_eq]
    exact hq S (by rwa [mm32L64Hi_targetSets_eq])
  · rw [← mm32L64Hi_targetSets_eq, ← mm32L64Hi_vanilla_eq]; exact hsum

