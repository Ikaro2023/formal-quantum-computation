/-
# Krotov `m = 128` `degP ≤ 64` `k = 256` Certificate (`Rk128kHiM128K256KrCert`)

QHL-verified module packaging cell `(128, 256)` over `16` anchors
`r ∈ {3..7, 9, 11, 12, 14, 20, 22, 25, 29, 33, 45, 256}` (`302` segments,
`445,840` Horner coord-ops at `lTableMax = 5`, `useColdR2 = true`).
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kHiM128K256KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported `(m, k)` cell (`m = 128, k = 256`, `1` cell). -/
def isHiTailM128K256KrotovCertCell (m k : ℕ) : Bool :=
  if m == 128 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor `L_{\max}(128, 256) = 5` (`5 * 128 = 640 ≤
  65536`). -/
def hiTailM128K256KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 128 then
    if k == 256 then 5
    else 1
  else 1

/-- Total register qubit budget `(hiTailM128K256KrotovCertCellLMax m k * m) * (n + 1) + k *
  n`. -/
abbrev hiTailM128K256KrotovCertQubits (n m k : ℕ) : ℕ :=
  (hiTailM128K256KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile `c(128, 256): ℚ≥0`. -/
def relCostHiTailM128K256KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 128 then
    if k == 256 then NNRat.divNat 405547717793 6250000000000
    else 1
  else 1

/-- Cost profile metadata (`n0 = 80000`, constructive threshold). -/
def hiTailM128K256KrotovCertProfile : FindAllCostProfile :=
  ⟨isHiTailM128K256KrotovCertCell, relCostHiTailM128K256KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kHiM128K256KrCert` cell lies on `groverGrid × groverGrid`. -/
theorem isHiTailM128K256KrotovCertCell_isGridCell {m k : ℕ}
    (h : isHiTailM128K256KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isHiTailM128K256KrotovCertCell at h
  split_ifs at h with hm128 hk256
  simp only [beq_iff_eq] at hm128 hk256
  subst hm128 hk256; rfl

end

