    DickeSol.RampKick128kAnchorsSound 128 5 htm128k256Anchors :=
  htmChkAnchors_append (htm_hd (htm_tl1 (htm_tl2 htmBatch0)))
    (htmChkAnchors_append htmBatch1 ⟨htmRow256Sound, trivial⟩)
private theorem htm128k256Valid :
    DickeSol.RampKick128kTableValid 128 256 5 true htm128k256VPot htm128k256Anchors :=
  DickeSol.rkm128kCheckTable_sound htmAncSound (htm_hd htmBatch0)
private theorem htm128k256CellChecks {m k : ℕ}
    (h : isHiTailM128K256KrotovCertCell m k = true) :
    DickeSol.rkm128kCheckAnchorsLMax k (hiTailM128K256KrotovCertCellLMax m k)
        htm128k256Anchors = true ∧
      ∃ num den : ℕ, relCostHiTailM128K256KrotovCert m k = NNRat.divNat num den ∧
        DickeSol.checkAltBound12 m k (htm128k256VPot.getD k 0) num den = true := by
  unfold isHiTailM128K256KrotovCertCell at h
  split_ifs at h with hm128 hk256
  simp only [beq_iff_eq] at hm128 hk256; subst hm128 hk256
  have hm := htm_hd (htm_tl1 htmBatch0)
  exact ⟨htm_and_l hm, 405547717793, 6250000000000, rfl, htm_and_r hm⟩

private lemma htm128k256_oracle_eq {n : ℕ} (m : ℕ) (S : Finset (Fin (2 ^ n))) :
    DickeSol.groverParallelMarkingOracle m S = GroverFindAll.parallelMarkingOracle m S := by
  unfold DickeSol.groverParallelMarkingOracle DickeSol.groverSetMarkingOracle
    GroverFindAll.parallelMarkingOracle GroverFindAll.setMarkingOracle; rfl
private lemma htm128k256_targetSets_eq (n k : ℕ) :
    DickeSol.groverTargetSets n k = (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k := rfl
private lemma htm128k256_vanilla_eq (n m k : ℕ) : DickeSol.vanillaFindAllCost n m k =
    (π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m) := rfl
private lemma htm128k256_le_of_add {a b d : ℕ} (h : a + d = b) : a ≤ b := h ▸ Nat.le_add_right a d
private lemma htm128k256_mem_grid (j d : ℕ) (h : (j + 1) + d = 11) : 2 ^ j ∈ DickeSol.groverGrid :=
  Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr (htm128k256_le_of_add h), rfl⟩

private structure Htm128k256CellProps (m k : ℕ) : Prop where
  hmG : m ∈ DickeSol.groverGrid
  hkG : k ∈ DickeSol.groverGrid
  hk256 : k ≤ 256
  hm2 : 2 ≤ m
  hl2 : 2 ≤ hiTailM128K256KrotovCertCellLMax m k
  hl1 : 1 ≤ hiTailM128K256KrotovCertCellLMax m k
  hlm : hiTailM128K256KrotovCertCellLMax m k * m ≤ 65536
  htab : DickeSol.RampKick128kTableValid m 256 5 true htm128k256VPot htm128k256Anchors
  hlmax : DickeSol.rkm128kCheckAnchorsLMax k (hiTailM128K256KrotovCertCellLMax m k)
    htm128k256Anchors = true
  hcost : ∃ num den : ℕ, relCostHiTailM128K256KrotovCert m k = NNRat.divNat num den ∧
    DickeSol.checkAltBound12 m k (htm128k256VPot.getD k 0) num den = true

private theorem htm128k256_all_props {m k : ℕ}
    (h : isHiTailM128K256KrotovCertCell m k = true) : Htm128k256CellProps m k := by
  rcases htm128k256CellChecks h with ⟨hlmax, hcost⟩; unfold isHiTailM128K256KrotovCertCell at h
  split_ifs at h with hm128 hk256
  simp only [beq_iff_eq] at hm128 hk256
  subst hm128 hk256
  exact ⟨htm128k256_mem_grid 7 3 rfl, htm128k256_mem_grid 8 2 rfl,
    @htm128k256_le_of_add 256 256 0 rfl, @htm128k256_le_of_add 2 128 126 rfl,
    @htm128k256_le_of_add 2 5 3 rfl, @htm128k256_le_of_add 1 5 4 rfl,
    @htm128k256_le_of_add 640 65536 64896 rfl, htm128k256Valid, hlmax, hcost⟩

private noncomputable def hiTailM128K256KrotovCertCircuitImpl {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ hiTailM128K256KrotovCertQubits n m k)) Var
      (hiTailM128K256KrotovCertQubits n m k) ((n + 1) * m) :=
  if h : isHiTailM128K256KrotovCertCell m k = true then
    let p := htm128k256_all_props h
    DickeSol.rkm128kCellCircuit res p.hmG p.hkG htm128k256VPot htm128k256Anchors p.hk256
      (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n
  else .skip

/-- Dynamic parallel query-model circuit for the supported `(128, 256)` cell. -/
noncomputable def findAllJohnsonRampKick128kHiTailM128K256KrotovCertCircuit
    {Var : Type} [DecidableEq Var] (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ hiTailM128K256KrotovCertQubits n m k)) Var
      (hiTailM128K256KrotovCertQubits n m k) ((n + 1) * m) :=
  hiTailM128K256KrotovCertCircuitImpl res n m k

private lemma htm128k256_circuit_eq {Var : Type} [DecidableEq Var] (res : Var) (n : ℕ)
    {m k : ℕ} (h : isHiTailM128K256KrotovCertCell m k = true) :
    findAllJohnsonRampKick128kHiTailM128K256KrotovCertCircuit res n m k =
      let p := htm128k256_all_props h
      DickeSol.rkm128kCellCircuit res p.hmG p.hkG htm128k256VPot htm128k256Anchors p.hk256
        (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n := by
  unfold findAllJohnsonRampKick128kHiTailM128K256KrotovCertCircuit
    hiTailM128K256KrotovCertCircuitImpl
  exact dite_eq_left h

/-- Exact probability-`1` recovery of `S` on the supported `(128, 256)` cell. -/
theorem hiTailM128K256KrotovCert_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isHiTailM128K256KrotovCertCell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ ⊤ ⦄
    (QProg.qSet ;;
      (findAllJohnsonRampKick128kHiTailM128K256KrotovCertCircuit res n m k).compile QProg.qAssign
        (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  have hS' : S ∈ DickeSol.groverTargetSets n k := by rwa [htm128k256_targetSets_eq]
  have hp := htm128k256_all_props hcell
  rw [htm128k256_circuit_eq res n hcell, ← htm128k256_oracle_eq]
  exact DickeSol.rkm128kCell_correctness res hp.hmG hp.hkG htm128k256VPot htm128k256Anchors
    hp.hk256 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm hp.htab hp.hlmax hn hkN hS'

/-- Asymptotic uniform-average relative-cost bound on the supported `(128, 256)` cell. -/
theorem hiTailM128K256KrotovCert_relCost {Var : Type} [DecidableEq Var] (res : Var)
    {m k : ℕ} (hcell : isHiTailM128K256KrotovCertCell m k = true) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, k ≤ 2 ^ n →
      ∃ q : Finset (Fin (2 ^ n)) → ℝ≥0,
        (∀ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k,
          CostBound
            (CostModel.ofEmbeddedOracle (GroverFindAll.parallelMarkingOracle m S))
            (QProg.qSet ;;
              (findAllJohnsonRampKick128kHiTailM128K256KrotovCertCircuit res n m k).compile
                QProg.qAssign (GroverFindAll.parallelMarkingOracle m S)) (q S)) ∧
        (∑ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k, (q S : ℝ)) /
            ((Finset.univ : Finset (Fin (2 ^ n))).powersetCard k).card ≤
          ((relCostHiTailM128K256KrotovCert m k : ℚ≥0) : ℝ) *
            ((π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m)) := by
  have hp := htm128k256_all_props hcell
  obtain ⟨n₁, hn₁⟩ := DickeSol.rkm128kCell_rel_cost (Var := Var) res hp.hmG hp.hkG
    htm128k256VPot htm128k256Anchors hp.hk256 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm
    hp.htab hp.hlmax hp.hcost
  refine ⟨n₁, fun n hn hkN ↦ ?_⟩; obtain ⟨q, hq, hsum⟩ := hn₁ n hn hkN
  refine ⟨q, fun S hS ↦ ?_, ?_⟩
  · rw [htm128k256_circuit_eq res n hcell, ← htm128k256_oracle_eq]
    exact hq S (by rwa [htm128k256_targetSets_eq])
  · rw [← htm128k256_targetSets_eq, ← htm128k256_vanilla_eq]; exact hsum

