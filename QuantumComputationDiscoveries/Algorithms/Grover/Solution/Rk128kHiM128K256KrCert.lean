private def htmNatEq (x y : ℕ) : Bool := Bool.and (Nat.ble x y) (Nat.ble y x)
private theorem htmNatEq_eq {x y : ℕ} (h : htmNatEq x y = true) : x = y := by
  unfold htmNatEq at h; rw [Bool.and_eq_true, Nat.ble_eq, Nat.ble_eq] at h; omega
private def htmIntEq (a b : ℤ) : Bool :=
  match a, b with
  | Int.ofNat m, Int.ofNat n => htmNatEq m n
  | Int.negSucc m, Int.negSucc n => htmNatEq m n
  | _, _ => false
private theorem htmIntEq_eq {a b : ℤ} (h : htmIntEq a b = true) : a = b := by
  cases a with
  | ofNat m =>
    cases b with
    | ofNat n => dsimp only [htmIntEq] at h; exact congrArg Int.ofNat (htmNatEq_eq h)
    | negSucc _ => cases h
  | negSucc m =>
    cases b with
    | ofNat _ => cases h
    | negSucc n => dsimp only [htmIntEq] at h; exact congrArg Int.negSucc (htmNatEq_eq h)
private def htmListEq {α : Type} (eqF : α → α → Bool) (xs ys : List α) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (eqF x y) (htmListEq eqF xr yr) false
  | _, _ => false
private theorem htmListEq_eq {α : Type} {eqF : α → α → Bool}
    (heq : ∀ {a b : α}, eqF a b = true → a = b) {xs ys : List α}
    (h : htmListEq eqF xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with
    | nil => cases h
    | cons y yr =>
      dsimp only [htmListEq] at h; cases hxy : eqF x y with
      | false => rw [hxy] at h; cases h
      | true => rw [hxy] at h; exact congrArg₂ List.cons (heq hxy) (ih h)
private abbrev HtmSt := ℕ × ℕ × ℕ × List ℤ
private def htmStEq (a b : HtmSt) : Bool :=
  match a, b with
  | (a1, a2, a3, av), (b1, b2, b3, bv) =>
    cond (htmNatEq a1 b1)
      (cond (htmNatEq a2 b2) (cond (htmNatEq a3 b3) (htmListEq htmIntEq av bv) false) false)
      false
private theorem htmStEq_eq {a b : HtmSt} (h : htmStEq a b = true) : a = b := by
  rcases a with ⟨a1, a2, a3, av⟩; rcases b with ⟨b1, b2, b3, bv⟩; dsimp only [htmStEq] at h
  cases h1 : htmNatEq a1 b1 with
  | false => rw [h1] at h; cases h
  | true =>
    rw [h1] at h; dsimp only [cond] at h; cases h2 : htmNatEq a2 b2 with
    | false => rw [h2] at h; cases h
    | true =>
      rw [h2] at h; dsimp only [cond] at h; cases h3 : htmNatEq a3 b3 with
      | false => rw [h3] at h; cases h
      | true =>
        rw [h3] at h; dsimp only [cond] at h
        exact Prod.ext (htmNatEq_eq h1) (Prod.ext (htmNatEq_eq h2)
          (Prod.ext (htmNatEq_eq h3) (htmListEq_eq (@htmIntEq_eq) h)))
private def htmAtF (bs : List Bool) : Bool :=
  match bs with
  | [] => true
  | b :: rest => cond b (htmAtF rest) false
private theorem htm_hd {b : Bool} {bs : List Bool} (h : htmAtF (b :: bs) = true) : b = true := by
  unfold htmAtF at h; cases b with
  | false => cases h
  | true => rfl
private theorem htm_tl1 {b : Bool} {s : List Bool} (h : htmAtF (b :: s) = true) :
    htmAtF s = true := by
  unfold htmAtF at h; cases b with
  | false => cases h
  | true => exact h
private theorem htm_tl2 {b1 b2 : Bool} {bs : List Bool}
    (h : htmAtF (b1 :: b2 :: bs) = true) : htmAtF bs = true := htm_tl1 (htm_tl1 h)
private theorem htm_and_l {a b : Bool} (h : Bool.and a b = true) : a = true := by
  cases a with
  | false => cases h
  | true => rfl
private theorem htm_and_r {a b : Bool} (h : Bool.and a b = true) : b = true := by
  cases a with
  | false => cases h
  | true =>
    cases b with
    | false => cases h
    | true => rfl
private abbrev htmM (l t n d r : ℕ) (w : List ℕ) : DickeSol.Rkm128kSeg :=
  ⟨l, t, n, d, DickeSol.rkm128kMask56 r w⟩
private def htmChkRow (r : ℕ) (s : List DickeSol.Rkm128kSeg) (ro : List ℕ) : Bool :=
  htmListEq htmNatEq (DickeSol.rkm128kEvalRowLo12 128 5 r s) ro
private def htmChkAnchors (xs : List DickeSol.RampKick128kAnchor) : Bool :=
  match xs with
  | [] => true
  | a :: rest =>
    match a with
    | ⟨rAct, segs, row⟩ => cond (htmChkRow rAct segs row) (htmChkAnchors rest) false
private theorem htmChkAnchors_append {xs rest : List DickeSol.RampKick128kAnchor}
    (hxs : htmChkAnchors xs = true) (hrest : DickeSol.RampKick128kAnchorsSound 128 5 rest) :
    DickeSol.RampKick128kAnchorsSound 128 5 (xs ++ rest) := by
  induction xs with
  | nil => exact hrest
  | cons a tl ih =>
    rcases a with ⟨rAct, segs, row⟩; rw [List.cons_append]
    dsimp only [htmChkAnchors, DickeSol.RampKick128kAnchorsSound] at hxs ⊢
    cases ha : htmChkRow rAct segs row with
    | false => rw [ha] at hxs; cases hxs
    | true =>
      rw [ha] at hxs; dsimp only [cond] at hxs; exact ⟨htmListEq_eq (@htmNatEq_eq) ha, ih hxs⟩
private def htmChkSeg (r : ℕ) (s : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (st1 : HtmSt) : Bool := htmStEq (DickeSol.rkm128kRunSegs 128 5 r s l0 d0 p0 v0) st1
private def htmChkFin (r : ℕ) (s : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (ro : List ℕ) : Bool :=
  htmListEq htmNatEq (DickeSol.rkm128kFinalizeState
    (DickeSol.rkm128kRunSegs 128 5 r s l0 d0 p0 v0)) ro
private def htmSegBds (r : ℕ) (s : List DickeSol.Rkm128kSeg) : Bool :=
  Bool.and (Nat.ble 1 (DickeSol.rkm128kSegListLen s))
    (Bool.and (Nat.ble (DickeSol.rkm128kSegListLen s) 128)
      (Bool.and (Nat.ble 2 r) (Nat.ble r 1024)))
private def htmTailOk (r : ℕ) (rest : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (ro : List ℕ) : Prop :=
  ∃ st, DickeSol.rkm128kRunSegs 128 5 r rest l0 d0 p0 v0 = st ∧
    DickeSol.rkm128kFinalizeState st = ro
private theorem htmTailEnd {r : ℕ} {cLast : List DickeSol.Rkm128kSeg} {l0 d0 p0 : ℕ} {v0 : List ℤ}
    {ro : List ℕ} (h : htmChkFin r cLast l0 d0 p0 v0 ro = true) :
    htmTailOk r cLast l0 d0 p0 v0 ro := ⟨_, rfl, htmListEq_eq (@htmNatEq_eq) h⟩
private theorem htmTailStep {r : ℕ} {cCur rest : List DickeSol.Rkm128kSeg}
    {l0 d0 p0 l1 d1 p1 : ℕ} {v0 v1 : List ℤ} {ro : List ℕ}
    (h1 : htmChkSeg r cCur l0 d0 p0 v0 (l1, d1, p1, v1) = true)
    (h2 : htmTailOk r rest l1 d1 p1 v1 ro) : htmTailOk r (cCur ++ rest) l0 d0 p0 v0 ro := by
  rcases h2 with ⟨st, hr, hf⟩; refine ⟨st, ?_, hf⟩
  unfold htmChkSeg at h1; rw [DickeSol.rkm128kRunSegs_append, htmStEq_eq h1]; exact hr
private theorem htmCertSplit {r : ℕ} {segs : List DickeSol.Rkm128kSeg} {ro : List ℕ}
    (hb : htmSegBds r segs = true) (ht : htmTailOk r segs 1 0 1 [Int.ofNat DickeSol.wdScale] ro) :
    DickeSol.rkm128kEvalRowLo12 128 5 r segs = ro := by
  rcases ht with ⟨st, hr, hf⟩; exact DickeSol.rkm128kCertRow_of_runSegs hb hr hf
private def htmChkCell (k lm n d : ℕ) (v : List ℕ) (a : List DickeSol.RampKick128kAnchor) : Bool :=
  Bool.and (DickeSol.rkm128kCheckAnchorsLMax k lm a)
    (DickeSol.checkAltBound12 128 k (v.getD k 0) n d)

