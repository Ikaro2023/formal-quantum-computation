/-
# Krotov `(16, 256)` Certificate (`Rk128kMidM16K256KrCert`)

QHL-verified module packaging cell `(16, 256)` over `14` anchors (`443,382` F1272 /
`447,876` Horner coord-ops at `lTableMax = 32`, `useColdR2 = true`).
-/

namespace QuantumComputation.Specs.GroverFindAll
namespace Rk128kMidM16K256KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported (m, k) cell (m = 16, k = 256, 1 cell). -/
def isMidM16K256KrotovCertCell (m k : ℕ) : Bool :=
  if m == 16 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor L_max(16, 256) = 32 (32 * 16 = 512 <= 65536). -/
def midM16K256KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 16 then
    if k == 256 then 32
    else 1
  else 1

/-- Total register qubit budget (midM16K256KrotovCertCellLMax m k * m) * (n + 1) + k * n. -/
abbrev midM16K256KrotovCertQubits (n m k : ℕ) : ℕ :=
  (midM16K256KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile c(16, 256): ℚ≥0. -/
def relCostMidM16K256KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 16 then
    if k == 256 then NNRat.divNat 34749072739993 200000000000000
    else 1
  else 1

/-- Cost profile metadata (n0 = 80000, constructive threshold). -/
def midM16K256KrotovCertProfile : FindAllCostProfile :=
  ⟨isMidM16K256KrotovCertCell, relCostMidM16K256KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kMidM16K256KrCert` cell lies on groverGrid × groverGrid. -/
theorem isMidM16K256KrotovCertCell_isGridCell {m k : ℕ}
    (h : isMidM16K256KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isMidM16K256KrotovCertCell at h
  split_ifs at h with hm16 hk256
  simp only [beq_iff_eq] at hm16 hk256
  subst hm16 hk256; rfl

end

