private theorem mm16k256CellChecks {m k : ℕ}
    (h : isMidM16K256KrotovCertCell m k = true) :
    DickeSol.rkm128kCheckAnchorsLMax k (midM16K256KrotovCertCellLMax m k)
        mm16k256Anchors = true ∧
      ∃ num den : ℕ, relCostMidM16K256KrotovCert m k = NNRat.divNat num den ∧
        DickeSol.checkAltBound12 m k (mm16k256VPot.getD k 0) num den = true := by
  unfold isMidM16K256KrotovCertCell at h
  split_ifs at h with hm16 hk256
  simp only [beq_iff_eq] at hm16 hk256
  subst hm16 hk256; have hm := mm16_hd (mm16_tl1 mm16Batch0)
  exact ⟨mm16_and_l hm, 34749072739993, 200000000000000, rfl, mm16_and_r hm⟩

private lemma mm16k256_oracle_eq {n : ℕ} (m : ℕ) (S : Finset (Fin (2 ^ n))) :
    DickeSol.groverParallelMarkingOracle m S = GroverFindAll.parallelMarkingOracle m S := by
  unfold DickeSol.groverParallelMarkingOracle DickeSol.groverSetMarkingOracle
    GroverFindAll.parallelMarkingOracle GroverFindAll.setMarkingOracle; rfl

private lemma mm16k256_targetSets_eq (n k : ℕ) :
    DickeSol.groverTargetSets n k = (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k := rfl

private lemma mm16k256_vanilla_eq (n m k : ℕ) : DickeSol.vanillaFindAllCost n m k =
    (π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m) := rfl

private lemma mm16k256_le_of_add {a b d : ℕ} (h : a + d = b) : a ≤ b := h ▸ Nat.le_add_right a d

private lemma mm16k256_mem_grid (j d : ℕ) (h : (j + 1) + d = 11) :
    2 ^ j ∈ DickeSol.groverGrid :=
  Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr (mm16k256_le_of_add h), rfl⟩

private structure Mm16k256CellProps (m k : ℕ) : Prop where
  hmG : m ∈ DickeSol.groverGrid
  hkG : k ∈ DickeSol.groverGrid
  hk256 : k ≤ 256
  hm2 : 2 ≤ m
  hl2 : 2 ≤ midM16K256KrotovCertCellLMax m k
  hl1 : 1 ≤ midM16K256KrotovCertCellLMax m k
  hlm : midM16K256KrotovCertCellLMax m k * m ≤ 65536
  htab : DickeSol.RampKick128kTableValid m 256 32 true mm16k256VPot mm16k256Anchors
  hlmax : DickeSol.rkm128kCheckAnchorsLMax k (midM16K256KrotovCertCellLMax m k)
    mm16k256Anchors = true
  hcost : ∃ num den : ℕ, relCostMidM16K256KrotovCert m k = NNRat.divNat num den ∧
    DickeSol.checkAltBound12 m k (mm16k256VPot.getD k 0) num den = true

private lemma mm16k256_mk {k : ℕ} (j d1 dk dl2 dl1 dlm : ℕ) (hj : (j + 1) + d1 = 11)
    (h256 : k + dk = 256) (hl2 : 2 + dl2 = midM16K256KrotovCertCellLMax 16 k)
    (hl1 : 1 + dl1 = midM16K256KrotovCertCellLMax 16 k)
    (hlm : midM16K256KrotovCertCellLMax 16 k * 16 + dlm = 65536) (hk : 2 ^ j = k)
    (hlmax : DickeSol.rkm128kCheckAnchorsLMax k (midM16K256KrotovCertCellLMax 16 k)
      mm16k256Anchors = true)
    (hcost : ∃ num den : ℕ, relCostMidM16K256KrotovCert 16 k = NNRat.divNat num den ∧
      DickeSol.checkAltBound12 16 k (mm16k256VPot.getD k 0) num den = true) :
    Mm16k256CellProps 16 k :=
  ⟨mm16k256_mem_grid 4 6 rfl, hk ▸ mm16k256_mem_grid j d1 hj, mm16k256_le_of_add h256,
    mm16k256_le_of_add (rfl : 2 + 14 = 16), mm16k256_le_of_add hl2, mm16k256_le_of_add hl1,
    mm16k256_le_of_add hlm, mm16k256Valid, hlmax, hcost⟩

private theorem mm16k256_all_props {m k : ℕ}
    (h : isMidM16K256KrotovCertCell m k = true) :
    Mm16k256CellProps m k := by
  rcases mm16k256CellChecks h with ⟨hlmax, hcost⟩; unfold isMidM16K256KrotovCertCell at h
  split_ifs at h with hm16 hk256
  simp only [beq_iff_eq] at hm16 hk256
  subst hm16 hk256; exact mm16k256_mk 8 2 0 30 31 65024 rfl rfl rfl rfl rfl rfl hlmax hcost

private noncomputable def midM16K256KrotovCertCircuitImpl {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ midM16K256KrotovCertQubits n m k)) Var
      (midM16K256KrotovCertQubits n m k) ((n + 1) * m) :=
  if h : isMidM16K256KrotovCertCell m k = true then
    let p := mm16k256_all_props h
    DickeSol.rkm128kCellCircuit res p.hmG p.hkG mm16k256VPot mm16k256Anchors p.hk256
      (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n
  else .skip

/-- Dynamic parallel query-model circuit on the supported (16, 256) cell. -/
noncomputable def findAllJohnsonRampKick128kMidM16K256KrotovCertCircuit
    {Var : Type} [DecidableEq Var] (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ midM16K256KrotovCertQubits n m k)) Var
      (midM16K256KrotovCertQubits n m k) ((n + 1) * m) :=
  midM16K256KrotovCertCircuitImpl res n m k

private lemma mm16k256_circuit_eq {Var : Type} [DecidableEq Var] (res : Var) (n : ℕ)
    {m k : ℕ} (h : isMidM16K256KrotovCertCell m k = true) :
    findAllJohnsonRampKick128kMidM16K256KrotovCertCircuit res n m k =
      let p := mm16k256_all_props h
      DickeSol.rkm128kCellCircuit res p.hmG p.hkG mm16k256VPot mm16k256Anchors p.hk256
        (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n := by
  unfold findAllJohnsonRampKick128kMidM16K256KrotovCertCircuit
    midM16K256KrotovCertCircuitImpl
  exact dite_eq_left h

/-- Exact probability-1 recovery of S on the supported (16, 256) cell. -/
theorem midM16K256KrotovCert_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isMidM16K256KrotovCertCell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ ⊤ ⦄
    (QProg.qSet ;;
      (findAllJohnsonRampKick128kMidM16K256KrotovCertCircuit res n m k).compile QProg.qAssign
        (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  have hS' : S ∈ DickeSol.groverTargetSets n k := by rwa [mm16k256_targetSets_eq]
  have hp := mm16k256_all_props hcell
  rw [mm16k256_circuit_eq res n hcell, ← mm16k256_oracle_eq]
  exact DickeSol.rkm128kCell_correctness res hp.hmG hp.hkG mm16k256VPot mm16k256Anchors hp.hk256
    (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm hp.htab hp.hlmax hn hkN hS'

/-- Asymptotic uniform-average relative-cost bound on the supported (16, 256) cell. -/
theorem midM16K256KrotovCert_relCost {Var : Type} [DecidableEq Var] (res : Var)
    {m k : ℕ} (hcell : isMidM16K256KrotovCertCell m k = true) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, k ≤ 2 ^ n →
      ∃ q : Finset (Fin (2 ^ n)) → ℝ≥0,
        (∀ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k,
          CostBound
            (CostModel.ofEmbeddedOracle (GroverFindAll.parallelMarkingOracle m S))
            (QProg.qSet ;;
              (findAllJohnsonRampKick128kMidM16K256KrotovCertCircuit res n m k).compile
                QProg.qAssign (GroverFindAll.parallelMarkingOracle m S)) (q S)) ∧
        (∑ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k, (q S : ℝ)) /
            ((Finset.univ : Finset (Fin (2 ^ n))).powersetCard k).card ≤
          ((relCostMidM16K256KrotovCert m k : ℚ≥0) : ℝ) *
            ((π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m)) := by
  have hp := mm16k256_all_props hcell
  obtain ⟨n₁, hn₁⟩ := DickeSol.rkm128kCell_rel_cost (Var := Var) res hp.hmG hp.hkG mm16k256VPot
    mm16k256Anchors hp.hk256 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm hp.htab hp.hlmax
    hp.hcost
  refine ⟨n₁, fun n hn hkN ↦ ?_⟩; obtain ⟨q, hq, hsum⟩ := hn₁ n hn hkN
  refine ⟨q, fun S hS ↦ ?_, ?_⟩
  · rw [mm16k256_circuit_eq res n hcell, ← mm16k256_oracle_eq]
    exact hq S (by rwa [mm16k256_targetSets_eq])
  · rw [← mm16k256_targetSets_eq, ← mm16k256_vanilla_eq]; exact hsum

end

