    let p := lm4k512l248kr_all_props h
    DickeSol.rkm128kCellCircuit res p.hmG p.hkG lm4k512l248krVPot lm4k512l248krAnchors p.hk512
      (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n
  else .skip

