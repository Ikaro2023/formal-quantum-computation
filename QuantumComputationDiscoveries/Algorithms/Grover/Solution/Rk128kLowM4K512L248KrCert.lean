/-
# 128-Segment Krotov `(4, 512)` Slice-3 & 4-Part Stitcher (`Rk128kLowM4K512L248KrCert`)

QHL-verified module certifying Slice 3 (`r = 512` segments `96..127` plus
`rkm128kFinalizeState`, `427,842` Horner coord-ops at `lTableMax = 248`, `cellLMax = 248`)
and chaining `Rk128kLowM4K512L248KrPt0..2` for `(4, 512) = 42044243815911 / 125000000000000`.
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kLowM4K512L248KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported `(m, k)` cell (`m = 4, k = 512`, `1` cell). -/
def isLowM4K512L248KrotovCertCell (m k : ℕ) : Bool :=
  if m == 4 then
    if k == 512 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor `L_{\max}(4, 512) = 248` matching router budget. -/
def lowM4K512L248KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 4 then
    if k == 512 then 248
    else 1
  else 1

/-- Total register qubit budget `(lowM4K512L248KrotovCertCellLMax m k * m) * (n + 1) + k *
  n`. -/
abbrev lowM4K512L248KrotovCertQubits (n m k : ℕ) : ℕ :=
  (lowM4K512L248KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified relative-cost profile `c(4, 512): ℚ≥0` (`42044243815911 / 125000000000000`). -/
def relCostLowM4K512L248KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 4 then
    if k == 512 then NNRat.divNat 42044243815911 125000000000000
    else 1
  else 1

/-- Cost profile metadata (`n0 = 80000`, constructive threshold). -/
def lowM4K512L248KrotovCertProfile : FindAllCostProfile :=
  ⟨isLowM4K512L248KrotovCertCell, relCostLowM4K512L248KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kLowM4K512L248KrCert` cell lies on `groverGrid × groverGrid`. -/
theorem isLowM4K512L248KrotovCertCell_isGridCell {m k : ℕ}
    (h : isLowM4K512L248KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isLowM4K512L248KrotovCertCell at h
  split_ifs at h with hm4 hk512
  all_goals simp only [beq_iff_eq] at *
  subst hm4 hk512; rfl

end

