private abbrev lmP : ℕ → ℤ := Int.ofNat
private abbrev lmN : ℕ → ℤ := Int.negSucc
private def lmNatEq (x y : ℕ) : Bool := Bool.and (Nat.ble x y) (Nat.ble y x)
private theorem lmNatEq_eq {x y : ℕ} (h : lmNatEq x y = true) : x = y := by
  unfold lmNatEq at h; simp only [Bool.and_eq_true, Nat.ble_eq] at h; omega
private def lmNatListEq (xs ys : List ℕ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (lmNatEq x y) (lmNatListEq xr yr) false
  | _, _ => false
private theorem lmNatListEq_eq {xs ys : List ℕ}
    (h : lmNatListEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with
    | nil => cases h
    | cons y yr =>
      change cond (lmNatEq x y) (lmNatListEq xr yr) false = true at h
      cases hxy : lmNatEq x y with
      | false => rw [hxy] at h; cases h
      | true => rw [hxy] at h; exact congrArg₂ List.cons (lmNatEq_eq hxy) (ih h)
private def lmIntEq (a b : ℤ) : Bool :=
  match a, b with
  | Int.ofNat x, Int.ofNat y => lmNatEq x y
  | Int.negSucc x, Int.negSucc y => lmNatEq x y
  | _, _ => false
private theorem lmIntEq_eq {a b : ℤ} (h : lmIntEq a b = true) : a = b := by
  cases a with
  | ofNat x =>
    cases b with
    | ofNat y => exact congrArg Int.ofNat (lmNatEq_eq h)
    | negSucc _ => cases h
  | negSucc x =>
    cases b with
    | ofNat _ => cases h
    | negSucc y => exact congrArg Int.negSucc (lmNatEq_eq h)
private def lmIntListEq (xs ys : List ℤ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (lmIntEq x y) (lmIntListEq xr yr) false
  | _, _ => false
private theorem lmIntListEq_eq {xs ys : List ℤ}
    (h : lmIntListEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with
    | nil => cases h
    | cons y yr =>
      change cond (lmIntEq x y) (lmIntListEq xr yr) false = true at h
      cases hxy : lmIntEq x y with
      | false => rw [hxy] at h; cases h
      | true => rw [hxy] at h; exact congrArg₂ List.cons (lmIntEq_eq hxy) (ih h)
private theorem lm_and_l {a b : Bool} (h : Bool.and a b = true) : a = true := by
  rw [Bool.and_eq_true] at h; exact And.left h
private theorem lm_and_r {a b : Bool} (h : Bool.and a b = true) : b = true := by
  rw [Bool.and_eq_true] at h; exact And.right h
private def lmStAt (st : ℕ × ℕ × ℕ × List ℤ) (l d p : ℕ) (v : List ℤ) : Bool :=
  match st with
  | (ls, ds, ps, vs) =>
    Bool.and (lmNatEq ls l)
      (Bool.and (lmNatEq ds d) (Bool.and (lmNatEq ps p) (lmIntListEq vs v)))
private theorem lmStAt_eq {st : ℕ × ℕ × ℕ × List ℤ} {l d p : ℕ} {v : List ℤ}
    (h : lmStAt st l d p v = true) : st = (l, d, p, v) := by
  rcases st with ⟨ls, ds, ps, vs⟩
  unfold lmStAt at h
  have h2 := lm_and_r h; have h3 := lm_and_r h2
  rw [lmNatEq_eq (lm_and_l h), lmNatEq_eq (lm_and_l h2),
    lmNatEq_eq (lm_and_l h3), lmIntListEq_eq (lm_and_r h3)]
private theorem lmStepGlue {r : ℕ} {a b : List DickeSol.Rkm128kSeg}
    {l0 d0 p0 l1 d1 p1 l1' d1' p1' l2 d2 p2 : ℕ} {v0 v1 v1' v2 : List ℤ}
    (h1 : DickeSol.rkm128kRunSegs 4 248 r a l0 d0 p0 v0 = (l1, d1, p1, v1))
    (hl : l1 = l1') (hd : d1 = d1') (hp : p1 = p1') (hv : v1 = v1')
    (h2 : DickeSol.rkm128kRunSegs 4 248 r b l1' d1' p1' v1' = (l2, d2, p2, v2)) :
    DickeSol.rkm128kRunSegs 4 248 r (a ++ b) l0 d0 p0 v0 = (l2, d2, p2, v2) := by
  rw [DickeSol.rkm128kRunSegs_append]; try dsimp only
  rw [h1]; try dsimp only
  rw [hl, hd, hp, hv]; exact h2
private def lmAtF (bs : List Bool) : Bool :=
  match bs with
  | [] => true
  | b :: rest => cond b (lmAtF rest) false
private theorem lm_hd {b : Bool} {bs : List Bool}
    (h : lmAtF (b :: bs) = true) : b = true := by
  unfold lmAtF at h
  cases b with
  | false => cases h
  | true => rfl
private theorem lm_tl1 {b : Bool} {s : List Bool}
    (h : lmAtF (b :: s) = true) : lmAtF s = true := by
  unfold lmAtF at h
  cases b with
  | false => cases h
  | true => exact h
private theorem lm_tl2 {b1 b2 : Bool} {bs : List Bool}
    (h : lmAtF (b1 :: b2 :: bs) = true) : lmAtF bs = true := lm_tl1 (lm_tl1 h)
private theorem lm_tl4 {b1 b2 b3 b4 : Bool} {bs : List Bool}
    (h : lmAtF (b1 :: b2 :: b3 :: b4 :: bs) = true) : lmAtF bs = true := lm_tl2 (lm_tl2 h)
private abbrev lmM (l t n d r : ℕ) (w : List ℕ) : DickeSol.Rkm128kSeg :=
  ⟨l, t, n, d, DickeSol.rkm128kMask56 r w⟩
private abbrev lmChkRun (r : ℕ) (s : List DickeSol.Rkm128kSeg)
    (l0 d0 p0 : ℕ) (v0 : List ℤ) (l1 d1 p1 : ℕ) (v1 : List ℤ) : Bool :=
  lmStAt (DickeSol.rkm128kRunSegs 4 248 r s l0 d0 p0 v0) l1 d1 p1 v1
private abbrev lmSegBds (r : ℕ) (s : List DickeSol.Rkm128kSeg) : Bool :=
  Bool.and (Nat.ble 1 (DickeSol.rkm128kSegListLen s))
    (Bool.and (Nat.ble (DickeSol.rkm128kSegListLen s) 128)
      (Bool.and (Nat.ble 2 r) (Nat.ble r 1024)))
private abbrev lmChkCell (k lm n d : ℕ) (v : List ℕ)
    (a : List DickeSol.RampKick128kAnchor) : Bool :=
  Bool.and (DickeSol.rkm128kCheckAnchorsLMax k lm a)
    (DickeSol.checkAltBound12 4 k (v.getD k 0) n d)

