    {Var : Type} [DecidableEq Var] (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ lowM4K512L248KrotovCertQubits n m k)) Var
      (lowM4K512L248KrotovCertQubits n m k) ((n + 1) * m) :=
  lowM4K512L248KrotovCertCircuitImpl res n m k

private lemma lm4k512l248kr_circuit_eq {Var : Type} [DecidableEq Var] (res : Var) (n : ℕ)
    {m k : ℕ} (h : isLowM4K512L248KrotovCertCell m k = true) :
