private def _mCS (a b c d : ℤ) : ℤ × ℤ :=
  solKeepZ (solGmpDivScale (solGmpSubZ (solGmpMulZ a c) (solGmpMulZ b d)))
    fun re ↦ solKeepZ (solGmpDivScale (solGmpAddZ (solGmpMulZ a d)
