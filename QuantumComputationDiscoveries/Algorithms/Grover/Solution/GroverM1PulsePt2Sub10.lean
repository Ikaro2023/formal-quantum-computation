private def _pCS : ℕ → ℕ → ℤ → ℤ → ℤ → ℤ → ℤ × ℤ
  | 0, _, ra, rb, _, _ => (ra, rb)
  | f + 1, k, ra, rb, ba, bb =>
      match cond (Nat.ble 1 (Nat.mod k 2)) (_mCS ra rb ba bb) (ra, rb) with
      | (ra', rb') => solLitNat (Nat.div k 2) fun k' ↦
          cond (Nat.ble 1 k') (match _mCS ba bb ba bb with
            | (ba', bb') => _pCS f k' ra' rb' ba' bb') (ra', rb')
