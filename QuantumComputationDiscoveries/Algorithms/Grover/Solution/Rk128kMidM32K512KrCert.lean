/-
# 128-Segment Krotov `(32, 512)` Slice-3 & 4-Part Stitcher (`Rk128kMidM32K512KrCert`)

QHL-verified module certifying Slice 3 (`r = 512` segments `105..127` plus
`rkm128kFinalizeState`, `309,339` Horner coord-ops at `lTableMax = 32`, `cellLMax = 32`)
and chaining `Rk128kMidM32K512KrPt0..2` for `(32, 512) = 121373469087091 / 1000000000000000`.
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kMidM32K512KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported `(m, k)` cell (`m = 32, k = 512`, `1` cell). -/
def isMidM32K512KrotovCertCell (m k : ℕ) : Bool :=
  if m == 32 then
    if k == 512 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor `L_{\max}(32, 512) = 32` matching router budget. -/
def midM32K512KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 32 then
    if k == 512 then 32
    else 1
  else 1

/-- Total register qubit budget `(midM32K512KrotovCertCellLMax m k * m) * (n + 1) + k * n`. -/
abbrev midM32K512KrotovCertQubits (n m k : ℕ) : ℕ :=
  (midM32K512KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified relative-cost profile `c(32, 512): ℚ≥0` (`121373469087091 /
  1000000000000000`). -/
def relCostMidM32K512KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 32 then
    if k == 512 then NNRat.divNat 121373469087091 1000000000000000
    else 1
  else 1

/-- Cost profile metadata (`n0 = 80000`, constructive threshold). -/
def midM32K512KrotovCertProfile : FindAllCostProfile :=
  ⟨isMidM32K512KrotovCertCell, relCostMidM32K512KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kMidM32K512KrCert` cell lies on `groverGrid × groverGrid`. -/
theorem isMidM32K512KrotovCertCell_isGridCell {m k : ℕ}
    (h : isMidM32K512KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isMidM32K512KrotovCertCell at h
  split_ifs at h with hm32 hk512
  all_goals simp only [beq_iff_eq] at *
  subst hm32 hk512; rfl

end

