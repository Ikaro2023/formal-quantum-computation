private abbrev mmP : ℕ → ℤ := Int.ofNat
private abbrev mmN : ℕ → ℤ := Int.negSucc
private def mmNatEq (x y : ℕ) : Bool := Bool.and (Nat.ble x y) (Nat.ble y x)
private theorem mmNatEq_eq {x y : ℕ} (h : mmNatEq x y = true) : x = y := by
  unfold mmNatEq at h; rw [Bool.and_eq_true, Nat.ble_eq, Nat.ble_eq] at h; omega
private def mmNatListEq (xs ys : List ℕ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (mmNatEq x y) (mmNatListEq xr yr) false
  | _, _ => false
private theorem mmNatListEq_eq {xs ys : List ℕ}
    (h : mmNatListEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with
    | nil => cases h
    | cons y yr =>
      dsimp only [mmNatListEq] at h
      cases hxy : mmNatEq x y with
      | false => rw [hxy] at h; cases h
      | true => rw [hxy] at h; exact congrArg₂ List.cons (mmNatEq_eq hxy) (ih h)
private def mmIntEq (a b : ℤ) : Bool :=
  match a, b with
  | Int.ofNat x, Int.ofNat y => mmNatEq x y
  | Int.negSucc x, Int.negSucc y => mmNatEq x y
  | _, _ => false
private theorem mmIntEq_eq {a b : ℤ} (h : mmIntEq a b = true) : a = b := by
  cases a with
  | ofNat x =>
    cases b with
    | ofNat y => exact congrArg Int.ofNat (mmNatEq_eq h)
    | negSucc _ => cases h
  | negSucc x =>
    cases b with
    | ofNat _ => cases h
    | negSucc y => exact congrArg Int.negSucc (mmNatEq_eq h)
private def mmIntListEq (xs ys : List ℤ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (mmIntEq x y) (mmIntListEq xr yr) false
  | _, _ => false
private theorem mmIntListEq_eq {xs ys : List ℤ}
    (h : mmIntListEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with
    | nil => cases h
    | cons y yr =>
      dsimp only [mmIntListEq] at h
      cases hxy : mmIntEq x y with
      | false => rw [hxy] at h; cases h
      | true => rw [hxy] at h; exact congrArg₂ List.cons (mmIntEq_eq hxy) (ih h)
private theorem mm_and_l {a b : Bool} (h : Bool.and a b = true) : a = true := by
  rw [Bool.and_eq_true] at h; exact And.left h
private theorem mm_and_r {a b : Bool} (h : Bool.and a b = true) : b = true := by
  rw [Bool.and_eq_true] at h; exact And.right h
private def mmStAt (st : ℕ × ℕ × ℕ × List ℤ) (l d p : ℕ) (v : List ℤ) : Bool :=
  match st with
  | (ls, ds, ps, vs) =>
    Bool.and (mmNatEq ls l)
      (Bool.and (mmNatEq ds d) (Bool.and (mmNatEq ps p) (mmIntListEq vs v)))
private theorem mmStAt_eq {st : ℕ × ℕ × ℕ × List ℤ} {l d p : ℕ} {v : List ℤ}
    (h : mmStAt st l d p v = true) : st = (l, d, p, v) := by
  rcases st with ⟨ls, ds, ps, vs⟩
  unfold mmStAt at h; dsimp only at h
  have h2 := mm_and_r h; have h3 := mm_and_r h2
  rw [mmNatEq_eq (mm_and_l h), mmNatEq_eq (mm_and_l h2),
    mmNatEq_eq (mm_and_l h3), mmIntListEq_eq (mm_and_r h3)]
private theorem mmStepGlue {r : ℕ} {a b : List DickeSol.Rkm128kSeg}
    {l0 d0 p0 l1 d1 p1 l1' d1' p1' l2 d2 p2 : ℕ} {v0 v1 v1' v2 : List ℤ}
    (h1 : DickeSol.rkm128kRunSegs 32 32 r a l0 d0 p0 v0 = (l1, d1, p1, v1))
    (hl : l1 = l1') (hd : d1 = d1') (hp : p1 = p1') (hv : v1 = v1')
    (h2 : DickeSol.rkm128kRunSegs 32 32 r b l1' d1' p1' v1' = (l2, d2, p2, v2)) :
    DickeSol.rkm128kRunSegs 32 32 r (a ++ b) l0 d0 p0 v0 = (l2, d2, p2, v2) := by
  rw [DickeSol.rkm128kRunSegs_append]; dsimp only
  rw [h1]; dsimp only; rw [hl, hd, hp, hv]; exact h2
private def mmAtF (bs : List Bool) : Bool :=
  match bs with
  | [] => true
  | b :: rest => cond b (mmAtF rest) false
private theorem mm_hd {b : Bool} {bs : List Bool}
    (h : mmAtF (b :: bs) = true) : b = true := by
  unfold mmAtF at h
  cases b with
  | false => cases h
  | true => rfl
private theorem mm_tl1 {b : Bool} {s : List Bool}
    (h : mmAtF (b :: s) = true) : mmAtF s = true := by
  unfold mmAtF at h
  cases b with
  | false => cases h
  | true => exact h
private theorem mm_tl2 {b1 b2 : Bool} {bs : List Bool}
    (h : mmAtF (b1 :: b2 :: bs) = true) : mmAtF bs = true := mm_tl1 (mm_tl1 h)
private theorem mm_tl4 {b1 b2 b3 b4 : Bool} {bs : List Bool}
    (h : mmAtF (b1 :: b2 :: b3 :: b4 :: bs) = true) : mmAtF bs = true := mm_tl2 (mm_tl2 h)
private abbrev mmM (l t n d r : ℕ) (w : List ℕ) : DickeSol.Rkm128kSeg :=
  ⟨l, t, n, d, DickeSol.rkm128kMask56 r w⟩
private abbrev mmChkRun (r : ℕ) (s : List DickeSol.Rkm128kSeg)
    (l0 d0 p0 : ℕ) (v0 : List ℤ) (l1 d1 p1 : ℕ) (v1 : List ℤ) : Bool :=
  mmStAt (DickeSol.rkm128kRunSegs 32 32 r s l0 d0 p0 v0) l1 d1 p1 v1
private abbrev mmSegBds (r : ℕ) (s : List DickeSol.Rkm128kSeg) : Bool :=
  Bool.and (Nat.ble 1 (DickeSol.rkm128kSegListLen s))
    (Bool.and (Nat.ble (DickeSol.rkm128kSegListLen s) 128)
      (Bool.and (Nat.ble 2 r) (Nat.ble r 1024)))
private abbrev mmChkCell (k lm n d : ℕ) (v : List ℕ)
    (a : List DickeSol.RampKick128kAnchor) : Bool :=
  Bool.and (DickeSol.rkm128kCheckAnchorsLMax k lm a)
    (DickeSol.checkAltBound12 32 k (v.getD k 0) n d)

