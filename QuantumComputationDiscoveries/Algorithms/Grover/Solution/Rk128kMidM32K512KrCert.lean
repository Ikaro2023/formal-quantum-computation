private lemma mm32k512kr_oracle_eq {n : ℕ} (m : ℕ) (S : Finset (Fin (2 ^ n))) :
    DickeSol.groverParallelMarkingOracle m S = GroverFindAll.parallelMarkingOracle m S := by
  unfold DickeSol.groverParallelMarkingOracle DickeSol.groverSetMarkingOracle
    GroverFindAll.parallelMarkingOracle GroverFindAll.setMarkingOracle; rfl

private lemma mm32k512kr_targetSets_eq (n k : ℕ) :
    DickeSol.groverTargetSets n k = (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k := rfl

private lemma mm32k512kr_vanilla_eq (n m k : ℕ) : DickeSol.vanillaFindAllCost n m k =
    (π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m) := rfl

private lemma mm32k512kr_le_of_add {a b d : ℕ} (h : a + d = b) : a ≤ b := h ▸ Nat.le_add_right a d

private lemma mm32k512kr_mem_grid (j d : ℕ) (h : (j + 1) + d = 11) :
    2 ^ j ∈ DickeSol.groverGrid :=
  Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr (mm32k512kr_le_of_add h), rfl⟩

private structure Mm32k512krCellProps (m k : ℕ) : Prop where
  hmG : m ∈ DickeSol.groverGrid
  hkG : k ∈ DickeSol.groverGrid
  hk512 : k ≤ 512
  hm2 : 2 ≤ m
  hl2 : 2 ≤ midM32K512KrotovCertCellLMax m k
  hl1 : 1 ≤ midM32K512KrotovCertCellLMax m k
  hlm : midM32K512KrotovCertCellLMax m k * m ≤ 65536
  htab : DickeSol.RampKick128kTableValid m 512 32 true mm32k512krVPot mm32k512krAnchors
  hlmax : DickeSol.rkm128kCheckAnchorsLMax k (midM32K512KrotovCertCellLMax m k)
    mm32k512krAnchors = true
  hcost : ∃ num den : ℕ, relCostMidM32K512KrotovCert m k = NNRat.divNat num den ∧
    DickeSol.checkAltBound12 m k (mm32k512krVPot.getD k 0) num den = true

private theorem mm32k512kr_all_props {m k : ℕ}
    (h : isMidM32K512KrotovCertCell m k = true) :
    Mm32k512krCellProps m k := by
  rcases mm32k512krCellChecks h with ⟨hlmax, hcost⟩
  unfold isMidM32K512KrotovCertCell at h
  split_ifs at h with hm32 hk512
  all_goals simp only [beq_iff_eq] at *
  subst hm32 hk512
  exact ⟨mm32k512kr_mem_grid 5 5 rfl, mm32k512kr_mem_grid 9 1 rfl,
    mm32k512kr_le_of_add (d := 0) rfl, mm32k512kr_le_of_add (d := 30) rfl,
    mm32k512kr_le_of_add (d := 30) rfl, mm32k512kr_le_of_add (d := 31) rfl,
    mm32k512kr_le_of_add (d := 64512) rfl, mm32k512krValid, hlmax, hcost⟩

private noncomputable def midM32K512KrotovCertCircuitImpl {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ midM32K512KrotovCertQubits n m k)) Var
      (midM32K512KrotovCertQubits n m k) ((n + 1) * m) :=
  if h : isMidM32K512KrotovCertCell m k = true then
    let p := mm32k512kr_all_props h
    DickeSol.rkm128kCellCircuit res p.hmG p.hkG mm32k512krVPot mm32k512krAnchors p.hk512
      (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n
  else .skip

/-- Dynamic parallel query-model circuit for the `(32, 512)` cell. -/
noncomputable def findAllJohnsonRampKick128kMidM32K512KrotovCertCircuit
    {Var : Type} [DecidableEq Var] (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ midM32K512KrotovCertQubits n m k)) Var
      (midM32K512KrotovCertQubits n m k) ((n + 1) * m) :=
  midM32K512KrotovCertCircuitImpl res n m k

private lemma mm32k512kr_circuit_eq {Var : Type} [DecidableEq Var] (res : Var) (n : ℕ)
    {m k : ℕ} (h : isMidM32K512KrotovCertCell m k = true) :
    findAllJohnsonRampKick128kMidM32K512KrotovCertCircuit res n m k =
      let p := mm32k512kr_all_props h
      DickeSol.rkm128kCellCircuit res p.hmG p.hkG mm32k512krVPot mm32k512krAnchors p.hk512
        (fun _ ↦ p.hm2) (fun _ ↦ p.hl2) p.hl1 p.hlm p.htab p.hlmax n := by
  unfold findAllJohnsonRampKick128kMidM32K512KrotovCertCircuit
    midM32K512KrotovCertCircuitImpl
  exact dite_eq_left h

/-- Exact probability-`1` recovery of `S` on the `(32, 512)` cell. -/
theorem midM32K512KrotovCert_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isMidM32K512KrotovCertCell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ ⊤ ⦄
    (QProg.qSet ;;
      (findAllJohnsonRampKick128kMidM32K512KrotovCertCircuit res n m k).compile QProg.qAssign
        (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  have hS' : S ∈ DickeSol.groverTargetSets n k := by rwa [mm32k512kr_targetSets_eq]
  have hp := mm32k512kr_all_props hcell
  rw [mm32k512kr_circuit_eq res n hcell, ← mm32k512kr_oracle_eq]
  exact DickeSol.rkm128kCell_correctness res hp.hmG hp.hkG mm32k512krVPot mm32k512krAnchors
    hp.hk512 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm hp.htab hp.hlmax hn hkN hS'

/-- Asymptotic uniform-average relative-cost bound on the `(32, 512)` cell. -/
theorem midM32K512KrotovCert_relCost {Var : Type} [DecidableEq Var] (res : Var)
    {m k : ℕ} (hcell : isMidM32K512KrotovCertCell m k = true) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, k ≤ 2 ^ n →
      ∃ q : Finset (Fin (2 ^ n)) → ℝ≥0,
        (∀ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k,
          CostBound
            (CostModel.ofEmbeddedOracle (GroverFindAll.parallelMarkingOracle m S))
            (QProg.qSet ;;
              (findAllJohnsonRampKick128kMidM32K512KrotovCertCircuit res n m k).compile
                QProg.qAssign (GroverFindAll.parallelMarkingOracle m S)) (q S)) ∧
        (∑ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k, (q S : ℝ)) /
            ((Finset.univ : Finset (Fin (2 ^ n))).powersetCard k).card ≤
          ((relCostMidM32K512KrotovCert m k : ℚ≥0) : ℝ) *
            ((π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m)) := by
  have hp := mm32k512kr_all_props hcell
  obtain ⟨n₁, hn₁⟩ := DickeSol.rkm128kCell_rel_cost (Var := Var) res hp.hmG hp.hkG mm32k512krVPot
    mm32k512krAnchors hp.hk512 (fun _ ↦ hp.hm2) (fun _ ↦ hp.hl2) hp.hl1 hp.hlm hp.htab hp.hlmax
    hp.hcost
  refine ⟨n₁, fun n hn hkN ↦ ?_⟩; obtain ⟨q, hq, hsum⟩ := hn₁ n hn hkN
  refine ⟨q, fun S hS ↦ ?_, ?_⟩
  · rw [mm32k512kr_circuit_eq res n hcell, ← mm32k512kr_oracle_eq]
    exact hq S (by rwa [mm32k512kr_targetSets_eq])
  · rw [← mm32k512kr_targetSets_eq, ← mm32k512kr_vanilla_eq]; exact hsum

