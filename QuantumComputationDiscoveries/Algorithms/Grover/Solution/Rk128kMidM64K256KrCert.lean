/-
# Krotov `(64, 256)` Certificate (`Rk128kMidM64K256KrCert`)

QHL-verified module packaging cell `(64, 256)` over `13` anchors (`445,274` F1272 /
`449,791` Horner coord-ops at `lTableMax = 8`, `useColdR2 = true`).
-/

namespace QuantumComputation.Specs.GroverFindAll.Rk128kMidM64K256KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported (m, k) cell (m = 64, k = 256, 1 cell). -/
def isMidM64K256KrotovCertCell (m k : ℕ) : Bool :=
  if m == 64 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor L_max(64, 256) = 8 (8 * 64 = 512 <= 65536). -/
def midM64K256KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 64 then
    if k == 256 then 8
    else 1
  else 1

/-- Total register qubit budget (midM64K256KrotovCertCellLMax m k * m) * (n + 1) + k * n. -/
abbrev midM64K256KrotovCertQubits (n m k : ℕ) : ℕ :=
  (midM64K256KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile c(64, 256): ℚ≥0. -/
def relCostMidM64K256KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 64 then
    if k == 256 then NNRat.divNat 89475475950707 1000000000000000
    else 1
  else 1

/-- Cost profile metadata (n0 = 80000, constructive threshold). -/
def midM64K256KrotovCertProfile : FindAllCostProfile :=
  ⟨isMidM64K256KrotovCertCell, relCostMidM64K256KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kMidM64K256KrCert` cell lies on groverGrid × groverGrid. -/
theorem isMidM64K256KrotovCertCell_isGridCell {m k : ℕ}
    (h : isMidM64K256KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isMidM64K256KrotovCertCell at h
  split_ifs at h with hm64 hk256
  simp only [beq_iff_eq] at hm64 hk256
  subst hm64 hk256; rfl

end

