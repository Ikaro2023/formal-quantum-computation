private def htkNatEq (x y : ℕ) : Bool := Bool.and (Nat.ble x y) (Nat.ble y x)
private def htkListNatEq (xs ys : List ℕ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (htkNatEq x y) (htkListNatEq xr yr) false
  | _, _ => false
private lemma htkNatEq_eq {x y : ℕ} (h : htkNatEq x y = true) : x = y := by
  unfold htkNatEq at h; simp only [Bool.and_eq_true, Nat.ble_eq] at h; omega
private lemma htkListNatEq_eq {xs ys : List ℕ}
    (h : htkListNatEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil => cases ys with | nil => rfl | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with | nil => cases h | cons y yr =>
      change cond (htkNatEq x y) (htkListNatEq xr yr) false = true at h
      cases hxy : htkNatEq x y <;> rw [hxy] at h <;> [cases h; rw [htkNatEq_eq hxy, ih h]]
private def htkUnzz (xs : List ℕ) : List ℤ :=
  match xs with
  | [] => []
  | u :: rest =>
    cond (Nat.ble (Nat.mod u 2) 0) (Int.ofNat (Nat.div u 2))
      (Int.negSucc (Nat.div u 2)) :: htkUnzz rest
private def htkIntEq (x y : ℤ) : Bool :=
  match x, y with
  | Int.ofNat a, Int.ofNat b => htkNatEq a b
  | Int.negSucc a, Int.negSucc b => htkNatEq a b
  | _, _ => false
private lemma htkIntEq_eq {x y : ℤ} (h : htkIntEq x y = true) : x = y := by
  cases x <;> cases y <;> simp only [htkIntEq] at h <;> first | cases h | rw [htkNatEq_eq h]
private def htkListIntEq (xs ys : List ℤ) : Bool :=
  match xs, ys with
  | [], [] => true
  | x :: xr, y :: yr => cond (htkIntEq x y) (htkListIntEq xr yr) false
  | _, _ => false
private lemma htkListIntEq_eq {xs ys : List ℤ}
    (h : htkListIntEq xs ys = true) : xs = ys := by
  induction xs generalizing ys with
  | nil => cases ys with | nil => rfl | cons _ _ => cases h
  | cons x xr ih =>
    cases ys with | nil => cases h | cons y yr =>
      change cond (htkIntEq x y) (htkListIntEq xr yr) false = true at h
      cases hxy : htkIntEq x y <;> rw [hxy] at h <;> [cases h; rw [htkIntEq_eq hxy, ih h]]
private lemma htk_and_l {a b : Bool} (h : Bool.and a b = true) : a = true := by
  cases a <;> cases h; rfl
private lemma htk_and_r {a b : Bool} (h : Bool.and a b = true) : b = true := by
  cases a <;> cases b <;> cases h; rfl
private def htkStEq (a b : ℕ × ℕ × ℕ × List ℤ) : Bool :=
  match a, b with
  | (l1, d1, p1, v1), (l2, d2, p2, v2) =>
    Bool.and (htkNatEq l1 l2)
      (Bool.and (htkNatEq d1 d2) (Bool.and (htkNatEq p1 p2) (htkListIntEq v1 v2)))
private lemma htkStEq_eq {a b : ℕ × ℕ × ℕ × List ℤ} (h : htkStEq a b = true) : a = b := by
  rcases a with ⟨l1, d1, p1, v1⟩; rcases b with ⟨l2, d2, p2, v2⟩
  unfold htkStEq at h; have h2 := htk_and_r h; have h3 := htk_and_r h2
  rw [htkNatEq_eq (x := l1) (y := l2) (htk_and_l h), htkNatEq_eq (x := d1) (y := d2) (htk_and_l h2),
    htkNatEq_eq (x := p1) (y := p2) (htk_and_l h3),
    htkListIntEq_eq (xs := v1) (ys := v2) (htk_and_r h3)]
private def htkAtF (bs : List Bool) : Bool :=
  match bs with | [] => true | b :: rest => cond b (htkAtF rest) false
private lemma htk_hd {b : Bool} {bs : List Bool} (h : htkAtF (b :: bs) = true) : b = true := by
  unfold htkAtF at h; cases b <;> first | cases h | rfl
private lemma htk_tl1 {b : Bool} {s : List Bool}
    (h : htkAtF (b :: s) = true) : htkAtF s = true := by
  unfold htkAtF at h; cases b <;> first | cases h | exact h
private lemma htk_tl2 {b1 b2 : Bool} {bs : List Bool}
    (h : htkAtF (b1 :: b2 :: bs) = true) : htkAtF bs = true := htk_tl1 (htk_tl1 h)
private lemma htk_tl4 {b1 b2 b3 b4 : Bool} {bs : List Bool}
    (h : htkAtF (b1 :: b2 :: b3 :: b4 :: bs) = true) : htkAtF bs = true := htk_tl2 (htk_tl2 h)
private abbrev htkM (l t n d r : ℕ) (w : List ℕ) : DickeSol.Rkm128kSeg :=
  ⟨l, t, n, d, DickeSol.rkm128kMask56 r w⟩
private abbrev htkChkRow (r : ℕ) (s : List DickeSol.Rkm128kSeg) (ro : List ℕ) : Bool :=
  htkListNatEq (DickeSol.rkm128kEvalRowLo12 512 2 r s) ro
private abbrev htkChkSeg (s : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (l1 d1 p1 : ℕ) (v1 : List ℤ) : Bool :=
  htkStEq (DickeSol.rkm128kRunSegs 512 2 256 s l0 d0 p0 v0) (l1, d1, p1, v1)
private def htkInitVec : List ℤ := [Int.ofNat DickeSol.wdScale]
private def htkRunOk (rest : List DickeSol.Rkm128kSeg) (l0 d0 p0 : ℕ) (v0 : List ℤ)
    (stEnd : ℕ × ℕ × ℕ × List ℤ) : Prop :=
  DickeSol.rkm128kRunSegs 512 2 256 rest l0 d0 p0 v0 = stEnd
private lemma htkRunStep {cCur rest : List DickeSol.Rkm128kSeg} {l0 d0 p0 l1 d1 p1 : ℕ}
    {v0 v1 : List ℤ} {stEnd : ℕ × ℕ × ℕ × List ℤ}
    (h1 : htkChkSeg cCur l0 d0 p0 v0 l1 d1 p1 v1 = true)
    (h2 : htkRunOk rest l1 d1 p1 v1 stEnd) : htkRunOk (cCur ++ rest) l0 d0 p0 v0 stEnd := by
  unfold htkRunOk at h2 ⊢
  have hm : DickeSol.rkm128kRunSegs 512 2 256 cCur l0 d0 p0 v0 = (l1, d1, p1, v1) := htkStEq_eq h1
  rw [DickeSol.rkm128kRunSegs_append]; dsimp only; rw [hm]; dsimp only; exact h2
private abbrev htkSegsGuard (r : ℕ) (segs : List DickeSol.Rkm128kSeg) : Bool :=
  Bool.and (Nat.ble 1 (DickeSol.rkm128kSegListLen segs))
    (Bool.and (Nat.ble (DickeSol.rkm128kSegListLen segs) 128)
      (Bool.and (Nat.ble 2 r) (Nat.ble r 1024)))
private abbrev htkFinGuard (st : ℕ × ℕ × ℕ × List ℤ) (ro : List ℕ) : Bool :=
  htkListNatEq (DickeSol.rkm128kFinalizeState st) ro
private abbrev htkChkCell (k lm n d : ℕ) (v : List ℕ)
    (a : List DickeSol.RampKick128kAnchor) : Bool :=
  Bool.and (DickeSol.rkm128kCheckAnchorsLMax k lm a)
    (DickeSol.checkAltBound12 512 k (v.getD k 0) n d)

