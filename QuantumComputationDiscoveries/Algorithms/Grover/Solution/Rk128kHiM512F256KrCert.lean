/-
# Krotov `(512, 256)` `degP ≤ 64` Certificate (`Rk128kHiM512F256KrCert`)

QHL-verified module packaging cell `(512, 256)` over `15` anchors
`r ∈ {3..12, 14, 16, 20, 24, 256}` (`131` segments, `428,856` Horner coord-ops at
`lTableMax = 2`, `useColdR2 = true`).
-/

namespace QuantumComputation.Specs.GroverFindAll
namespace Rk128kHiM512F256KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported `(m, k)` cell (`m = 512, k = 256`, `1` cell). -/
def isHiTailM512Full256KrotovCertCell (m k : ℕ) : Bool :=
  if m == 512 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor `L_{\max}(512, 256) = 2` (`2 * 512 = 1024 <=
  65536`). -/
def hiTailM512Full256KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 512 then
    if k == 256 then 2
    else 1
  else 1

/-- Total register qubit budget
  `(hiTailM512Full256KrotovCertCellLMax m k * m) * (n + 1) + k * n`. -/
abbrev hiTailM512Full256KrotovCertQubits (n m k : ℕ) : ℕ :=
  (hiTailM512Full256KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile `c(512, 256): ℚ≥0`. -/
def relCostHiTailM512Full256KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 512 then
    if k == 256 then NNRat.divNat 309925658397 8000000000000
    else 1
  else 1

/-- Cost profile metadata (`n0 = 80000`, constructive threshold). -/
def hiTailM512Full256KrotovCertProfile : FindAllCostProfile :=
  ⟨isHiTailM512Full256KrotovCertCell, relCostHiTailM512Full256KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kHiM512F256KrCert` cell lies on `groverGrid × groverGrid`. -/
theorem isHiTailM512Full256KrotovCertCell_isGridCell {m k : ℕ}
    (h : isHiTailM512Full256KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isHiTailM512Full256KrotovCertCell at h
  split_ifs at h with hm512 hk256
  simp only [beq_iff_eq] at hm512 hk256
  subst hm512 hk256; rfl

end

