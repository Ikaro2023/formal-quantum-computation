    (hc : _wkbPair t0 d0 t1 d1 c0 h0 r0 s0 c1 h1 r1 s1 c2 h2 r2 s2 = true) :
    SolWkbRunPrefix solWkbSched_r512 solTrigIvs_r512 t2 c2 h2 r2 s2 := by
  unfold _wkbPair at hc
  revert hc
  cases h1c : solFastCheckWkbSliceZc solWkbSched_r512 t0 d0 solTrigIvs_r512
      c0 h0 r0 s0 c1 h1 r1 s1
