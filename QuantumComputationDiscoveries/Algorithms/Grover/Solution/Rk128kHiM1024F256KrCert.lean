private lemma htk_oracle_eq {n : ℕ} (m : ℕ) (S : Finset (Fin (2 ^ n))) :
    DickeSol.groverParallelMarkingOracle m S = GroverFindAll.parallelMarkingOracle m S := by
  unfold DickeSol.groverParallelMarkingOracle DickeSol.groverSetMarkingOracle
    GroverFindAll.parallelMarkingOracle GroverFindAll.setMarkingOracle; rfl
private lemma htk_targetSets_eq (n k : ℕ) :
    DickeSol.groverTargetSets n k = (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k := rfl
private lemma htk_vanilla_eq (n m k : ℕ) : DickeSol.vanillaFindAllCost n m k =
    (π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m) := rfl
private lemma htk_le_of_add {a b d : ℕ} (h : a + d = b) : a ≤ b := h ▸ Nat.le_add_right a d
private lemma htk_mem_grid (j d : ℕ) (h : (j + 1) + d = 11) : 2 ^ j ∈ DickeSol.groverGrid :=
  Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr (htk_le_of_add h), rfl⟩

private structure HtkCellProps (m k : ℕ) : Prop where
  mem_m : m ∈ DickeSol.groverGrid
  mem_k : k ∈ DickeSol.groverGrid
  k_le : k ≤ 256
  m_ge : 2 ≤ m
  lmax_ge2 : 2 ≤ hiTailM1024Full256KrotovCertCellLMax m k
  lmax_ge1 : 1 ≤ hiTailM1024Full256KrotovCertCellLMax m k
  lmax_mul : hiTailM1024Full256KrotovCertCellLMax m k * m ≤ 65536
  valid : DickeSol.RampKick128kTableValid m 256 2 true htkVPot htkAnchors
  anc_lmax : DickeSol.rkm128kCheckAnchorsLMax k
    (hiTailM1024Full256KrotovCertCellLMax m k) htkAnchors = true
  bound : ∃ num den : ℕ, relCostHiTailM1024Full256KrotovCert m k = NNRat.divNat num den ∧
    DickeSol.checkAltBound12 m k (htkVPot.getD k 0) num den = true
private lemma htk_all_props {m k : ℕ} (h : isHiTailM1024Full256KrotovCertCell m k = true) :
    HtkCellProps m k := by
  unfold isHiTailM1024Full256KrotovCertCell at h; split_ifs at h with hm1024 hk256
  simp only [beq_iff_eq] at hm1024 hk256; subst hm1024 hk256
  have hm := htk_hd (htk_tl1 htk_meta)
  exact ⟨htk_mem_grid 10 0 rfl, htk_mem_grid 8 2 rfl,
    htk_le_of_add (d := 0) rfl, htk_le_of_add (d := 1022) rfl,
    htk_le_of_add (d := 0) rfl, htk_le_of_add (d := 1) rfl, htk_le_of_add (d := 63488) rfl,
    htkValid, htk_and_l hm, ⟨35121342710887, 1000000000000000, rfl, htk_and_r hm⟩⟩

private noncomputable def hiTailM1024Full256KrotovCertCircuitImpl {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ hiTailM1024Full256KrotovCertQubits n m k)) Var
      (hiTailM1024Full256KrotovCertQubits n m k) ((n + 1) * m) :=
  if h : isHiTailM1024Full256KrotovCertCell m k = true then
    let p := htk_all_props h
    DickeSol.rkm128kCellCircuit res p.mem_m p.mem_k htkVPot htkAnchors p.k_le
      (fun _ ↦ p.m_ge) (fun _ ↦ p.lmax_ge2) p.lmax_ge1 p.lmax_mul p.valid p.anc_lmax n
  else .skip

/-- Dynamic parallel query-model circuit for the supported `(1024, 256)` cell. -/
noncomputable def findAllJohnsonRampKick128kHiTailM1024Full256KrotovCertCircuit
    {Var : Type} [DecidableEq Var] (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ hiTailM1024Full256KrotovCertQubits n m k)) Var
      (hiTailM1024Full256KrotovCertQubits n m k) ((n + 1) * m) :=
  hiTailM1024Full256KrotovCertCircuitImpl res n m k

private lemma htk_circuit_eq {Var : Type} [DecidableEq Var] (res : Var) (n : ℕ)
    {m k : ℕ} (h : isHiTailM1024Full256KrotovCertCell m k = true) :
    findAllJohnsonRampKick128kHiTailM1024Full256KrotovCertCircuit res n m k =
      let p := htk_all_props h
      DickeSol.rkm128kCellCircuit res p.mem_m p.mem_k htkVPot htkAnchors p.k_le
        (fun _ ↦ p.m_ge) (fun _ ↦ p.lmax_ge2) p.lmax_ge1 p.lmax_mul p.valid p.anc_lmax n := by
  unfold findAllJohnsonRampKick128kHiTailM1024Full256KrotovCertCircuit
    hiTailM1024Full256KrotovCertCircuitImpl; exact dite_eq_left h

/-- Exact probability-`1` recovery of `S` on the supported `(1024, 256)` cell. -/
theorem hiTailM1024Full256KrotovCert_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isHiTailM1024Full256KrotovCertCell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ ⊤ ⦄
    (QProg.qSet ;;
      (findAllJohnsonRampKick128kHiTailM1024Full256KrotovCertCircuit res n m k).compile
        QProg.qAssign (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  have hS' : S ∈ DickeSol.groverTargetSets n k := by rwa [htk_targetSets_eq]
  have hp := htk_all_props hcell; rw [htk_circuit_eq res n hcell, ← htk_oracle_eq]
  exact DickeSol.rkm128kCell_correctness res hp.mem_m hp.mem_k htkVPot htkAnchors hp.k_le
    (fun _ ↦ hp.m_ge) (fun _ ↦ hp.lmax_ge2) hp.lmax_ge1 hp.lmax_mul hp.valid hp.anc_lmax hn hkN hS'

/-- Asymptotic uniform-average relative-cost bound on the supported `(1024, 256)` cell. -/
theorem hiTailM1024Full256KrotovCert_relCost {Var : Type} [DecidableEq Var] (res : Var)
    {m k : ℕ} (hcell : isHiTailM1024Full256KrotovCertCell m k = true) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, k ≤ 2 ^ n →
      ∃ q : Finset (Fin (2 ^ n)) → ℝ≥0,
        (∀ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k,
          CostBound
            (CostModel.ofEmbeddedOracle (GroverFindAll.parallelMarkingOracle m S))
            (QProg.qSet ;;
              (findAllJohnsonRampKick128kHiTailM1024Full256KrotovCertCircuit res n m k).compile
                QProg.qAssign (GroverFindAll.parallelMarkingOracle m S)) (q S)) ∧
        (∑ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k, (q S : ℝ)) /
            ((Finset.univ : Finset (Fin (2 ^ n))).powersetCard k).card ≤
          ((relCostHiTailM1024Full256KrotovCert m k : ℚ≥0) : ℝ) *
            ((π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m)) := by
  have hp := htk_all_props hcell
  obtain ⟨n₁, hn₁⟩ := DickeSol.rkm128kCell_rel_cost (Var := Var) res hp.mem_m hp.mem_k htkVPot
    htkAnchors hp.k_le (fun _ ↦ hp.m_ge) (fun _ ↦ hp.lmax_ge2) hp.lmax_ge1 hp.lmax_mul
    hp.valid hp.anc_lmax hp.bound
  refine ⟨n₁, fun n hn hkN ↦ ?_⟩; obtain ⟨q, hq, hsum⟩ := hn₁ n hn hkN
  refine ⟨q, fun S hS ↦ ?_, ?_⟩
  · rw [htk_circuit_eq res n hcell, ← htk_oracle_eq]; exact hq S (by rwa [htk_targetSets_eq])
  · rw [← htk_targetSets_eq, ← htk_vanilla_eq]; exact hsum

end

