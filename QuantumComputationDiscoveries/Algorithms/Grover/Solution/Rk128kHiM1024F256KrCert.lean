/-
# Krotov `(1024, 256)` `degP ≤ 64` Certificate (`Rk128kHiM1024F256KrCert`)

QHL-verified module packaging cell `(1024, 256)` over `15` anchors
`r ∈ {3..12, 14, 16, 20, 24, 256}` (`90` segments, `375,643` Horner coord-ops at
`lTableMax = 2`, `useColdR2 = true`).
-/

namespace QuantumComputation.Specs.GroverFindAll
namespace Rk128kHiM1024F256KrCert

@[expose] public section

open Operator ResourceCounting Real QProg QProg.Notation
open scoped Matrix ComplexOrder MatrixOrder NNReal NNRat ENNReal
open QuantumComputation.Specs

/-- Supported `(m, k)` cell (`m = 1024, k = 256`, `1` cell). -/
def isHiTailM1024Full256KrotovCertCell (m k : ℕ) : Bool :=
  if m == 1024 then
    if k == 256 then true
    else false
  else false

/-- Per-cell workspace multiplexing factor `LMax(1024, 256) = 2` (`2 * 1024 = 2048 <=
  65536`). -/
def hiTailM1024Full256KrotovCertCellLMax (m k : ℕ) : ℕ :=
  if m == 1024 then
    if k == 256 then 2
    else 1
  else 1

/-- Total register qubit budget
  `(hiTailM1024Full256KrotovCertCellLMax m k * m) * (n + 1) + k * n`. -/
abbrev hiTailM1024Full256KrotovCertQubits (n m k : ℕ) : ℕ :=
  (hiTailM1024Full256KrotovCertCellLMax m k * m) * (n + 1) + k * n

/-- Certified coprime relative-cost profile `c(1024, 256): ℚ≥0`. -/
def relCostHiTailM1024Full256KrotovCert (m k : ℕ) : ℚ≥0 :=
  if m == 1024 then
    if k == 256 then NNRat.divNat 35121342710887 1000000000000000
    else 1
  else 1

/-- Cost profile metadata (`n0 = 80000`, constructive threshold). -/
def hiTailM1024Full256KrotovCertProfile : FindAllCostProfile :=
  ⟨isHiTailM1024Full256KrotovCertCell, relCostHiTailM1024Full256KrotovCert, fun _ _ ↦ 80000⟩

/-- Every supported `Rk128kHiM1024F256KrCert` cell lies on `groverGrid × groverGrid`. -/
theorem isHiTailM1024Full256KrotovCertCell_isGridCell {m k : ℕ}
    (h : isHiTailM1024Full256KrotovCertCell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isHiTailM1024Full256KrotovCertCell at h
  split_ifs at h with hm1024 hk256
  simp only [beq_iff_eq] at hm1024 hk256
  subst hm1024 hk256; rfl

end

