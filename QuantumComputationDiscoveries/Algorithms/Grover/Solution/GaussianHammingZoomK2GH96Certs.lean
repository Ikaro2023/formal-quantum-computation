open scoped NNReal NNRat

/-
8-Cell Gaussian-Hamming Zoom `k = 2` Certificates (`m ∈ 8..1024`).
-/
def isGaussianHammingZoomK2GH96Cell (m k : ℕ) : Bool :=
  (k == 2) && ((m == 8) || (m == 16) || (m == 32) || (m == 64)
    || (m == 128) || (m == 256) || (m == 512) || (m == 1024))

/-- Register width `m * (n + 1) + k * n` matching `masterWDZoomQubits`. -/
abbrev gaussianHammingZoomK2GH96Qubits (n m k : ℕ) : ℕ :=
  m * (n + 1) + k * n

/-- Exact coprime asymptotic relative-cost table across all 8 active `k = 2` cells. -/
def relCostGaussianHammingZoomK2GH96 (m k : ℕ) : ℚ≥0 :=
  if m == 8 && k == 2 then NNRat.divNat 964677786 1707106781
  else if m == 16 && k == 2 then NNRat.divNat 919063107 1707106781
  else if m == 32 && k == 2 then NNRat.divNat 895540993 1707106781
  else if m == 64 && k == 2 then NNRat.divNat 882921566 1707106781
  else if m == 128 && k == 2 then NNRat.divNat 875993251 1707106781
  else if m == 256 && k == 2 then NNRat.divNat 872139413 1707106781
  else if m == 512 && k == 2 then NNRat.divNat 869996454 1707106781
  else if m == 1024 && k == 2 then NNRat.divNat 868800736 1707106781
  else 1

/-- Every covered `GaussianHammingZoomK2GH96` cell lies on `groverGrid × groverGrid`. -/
theorem isGaussianHammingZoomK2GH96Cell_isGridCell {m k : ℕ}
    (h : isGaussianHammingZoomK2GH96Cell m k = true) :
    GroverFindAll.isGridCell m k = true := by
  unfold isGaussianHammingZoomK2GH96Cell at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, or_assoc] at h
  rcases h with ⟨rfl, rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl⟩ <;> rfl

end QuantumComputation.Specs.GroverFindAll.GaussianHammingZoomK2GH96

