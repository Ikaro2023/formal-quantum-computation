private def gh96ZoomK2Lookup (m k : ℕ) : Option GHZoomCellCert :=
  if k = 2 then
    if m = 8 then some gh96ZoomCert8k2
    else if m = 16 then some gh96ZoomCert16k2
    else if m = 32 then some gh96ZoomCert32k2
    else if m = 64 then some gh96ZoomCert64k2
    else if m = 128 then some gh96ZoomCert128k2
    else if m = 256 then some gh96ZoomCert256k2
    else if m = 512 then some gh96ZoomCert512k2
    else if m = 1024 then some gh96ZoomCert1024k2
    else none
  else
    none

private lemma gh96ZoomK2Lookup_isSome {m k : ℕ}
    (h : isGaussianHammingZoomK2GH96Cell m k = true) :
    (gh96ZoomK2Lookup m k).isSome = true := by
  unfold isGaussianHammingZoomK2GH96Cell at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, or_assoc] at h
  rcases h with ⟨rfl, rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl⟩ <;>
    simp [gh96ZoomK2Lookup]

private lemma gh96Zoom_stage1_cell {m p : ℕ} (hp : p < 11) (hm : 2 ^ p = m) :
    Stage1.cells m 2 = true := by
  simp only [Stage1.cells, gridCells, Bool.and_eq_true, decide_eq_true_eq, groverGrid,
    Finset.mem_image, Finset.mem_range]
  exact ⟨⟨p, hp, hm⟩, ⟨1, by omega, rfl⟩⟩

private lemma gh96ZoomK2Lookup_props {m k : ℕ} {c : GHZoomCellCert}
    (h : gh96ZoomK2Lookup m k = some c) :
    Stage1.cells m k = true ∧ 2 ≤ m ∧ 2 ≤ k ∧ k = 2 ∧ c.W ≤ 16 ∧
      checkGHZoomSchedule m c.W c.rowSpec c.vSeq c.num c.den = true ∧
      relCostGaussianHammingZoomK2GH96 m k = (c.num : ℚ≥0) / (c.den : ℚ≥0) := by
  unfold gh96ZoomK2Lookup at h
  by_cases hk2 : k = 2
  · rw [ite_eq_left hk2] at h; subst hk2
    by_cases hm8 : m = 8
    · rw [ite_eq_left hm8] at h; cases h; subst hm8
      exact ⟨gh96Zoom_stage1_cell (p := 3) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert8k2]; omega, gh96ZoomCert8_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert8k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm8] at h
    by_cases hm16 : m = 16
    · rw [ite_eq_left hm16] at h; cases h; subst hm16
      exact ⟨gh96Zoom_stage1_cell (p := 4) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert16k2]; omega, gh96ZoomCert16_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert16k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm16] at h
    by_cases hm32 : m = 32
    · rw [ite_eq_left hm32] at h; cases h; subst hm32
      exact ⟨gh96Zoom_stage1_cell (p := 5) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert32k2]; omega, gh96ZoomCert32_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert32k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm32] at h
    by_cases hm64 : m = 64
    · rw [ite_eq_left hm64] at h; cases h; subst hm64
      exact ⟨gh96Zoom_stage1_cell (p := 6) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert64k2]; omega, gh96ZoomCert64_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert64k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm64] at h
    by_cases hm128 : m = 128
    · rw [ite_eq_left hm128] at h; cases h; subst hm128
      exact ⟨gh96Zoom_stage1_cell (p := 7) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert128k2]; omega, gh96ZoomCert128_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert128k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm128] at h
    by_cases hm256 : m = 256
    · rw [ite_eq_left hm256] at h; cases h; subst hm256
      exact ⟨gh96Zoom_stage1_cell (p := 8) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert256k2]; omega, gh96ZoomCert256_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert256k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm256] at h
    by_cases hm512 : m = 512
    · rw [ite_eq_left hm512] at h; cases h; subst hm512
      exact ⟨gh96Zoom_stage1_cell (p := 9) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert512k2]; omega, gh96ZoomCert512_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert512k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm512] at h
    by_cases hm1024 : m = 1024
    · rw [ite_eq_left hm1024] at h; cases h; subst hm1024
      exact ⟨gh96Zoom_stage1_cell (p := 10) (by omega) (by norm_num), by omega, by omega, rfl,
        by dsimp [gh96ZoomCert1024k2]; omega, gh96ZoomCert1024_2_ok, by
          dsimp only [relCostGaussianHammingZoomK2GH96, gh96ZoomCert1024k2]
          simp [NNRat.divNat_eq_div]⟩
    rw [ite_eq_right hm1024] at h
    cases h
  · rw [ite_eq_right hk2] at h; cases h

private lemma gh96ZoomK2_oracle_eq {n : ℕ} (m : ℕ) (S : Finset (Fin (2 ^ n))) :
    DickeSol.groverParallelMarkingOracle m S =
      GroverFindAll.parallelMarkingOracle m S := by
  unfold DickeSol.groverParallelMarkingOracle DickeSol.groverSetMarkingOracle
    GroverFindAll.parallelMarkingOracle GroverFindAll.setMarkingOracle
  rfl

private lemma gh96ZoomK2_targetSets_eq (n k : ℕ) :
    DickeSol.groverTargetSets n k =
      (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k :=
  rfl

private lemma gh96ZoomK2_vanilla_eq (n m k : ℕ) :
    DickeSol.vanillaFindAllCost n m k =
      (π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m) :=
  rfl

