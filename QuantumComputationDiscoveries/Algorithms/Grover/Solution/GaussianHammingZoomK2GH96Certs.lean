/-- Dynamic circuit dispatching all 8 `k = 2` cells to `DickeSol.ghZoomCertCircuit`. -/
noncomputable def findAllGaussianHammingZoomK2GH96Circuit {Var : Type} [DecidableEq Var]
    (res : Var) (n m k : ℕ) :
    OracleDynamicCircuit (Unitary (2 ^ gaussianHammingZoomK2GH96Qubits n m k)) Var
      (gaussianHammingZoomK2GH96Qubits n m k) ((n + 1) * m) :=
  match hlook : gh96ZoomK2Lookup m k with
  | some c =>
      let hv := gh96ZoomK2Lookup_props hlook
      DickeSol.ghZoomCertCircuit res (DickeSol.Stage1.cells_mem_grid hv.1).1
        (DickeSol.Stage1.cells_mem_grid hv.1).2 hv.2.1 hv.2.2.1 c.W c.rowSpec hv.2.2.2.2.1 n
  | none => .skip

/-- Exact probability-`1` recovery of `S` on every certified `GaussianHammingZoomK2GH96`
  cell. -/
theorem gaussianHammingZoomK2GH96_correctness {Var : Type} [DecidableEq Var] (res : Var)
    {n m k : ℕ} {S : Finset (Fin (2 ^ n))} (hn : 1 ≤ n)
    (hcell : isGaussianHammingZoomK2GH96Cell m k = true) (hkN : k ≤ 2 ^ n)
    (hS : S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k) :
    ⦃ (⊤ : CQAssertion (Store Var) (2 ^ gaussianHammingZoomK2GH96Qubits n m k)) ⦄
    (QProg.qSet ;; (findAllGaussianHammingZoomK2GH96Circuit res n m k).compile QProg.qAssign
      (GroverFindAll.parallelMarkingOracle m S))
    ⦃ liftPureProp (fun σ ↦ GroverFindAll.decodeTargetsLocal n k (σ res) = S) ⦄ := by
  cases hlook : gh96ZoomK2Lookup m k with
  | none =>
      have his := gh96ZoomK2Lookup_isSome hcell
      rw [hlook] at his; cases his
  | some c =>
      have hv := gh96ZoomK2Lookup_props hlook
      have hcirc : findAllGaussianHammingZoomK2GH96Circuit (Var := Var) res n m k =
          DickeSol.ghZoomCertCircuit res (DickeSol.Stage1.cells_mem_grid hv.1).1
            (DickeSol.Stage1.cells_mem_grid hv.1).2 hv.2.1 hv.2.2.1 c.W c.rowSpec
            hv.2.2.2.2.1 n := by
        unfold findAllGaussianHammingZoomK2GH96Circuit
        split
        · next _ h => rw [hlook] at h; cases h; rfl
        · next h => rw [hlook] at h; cases h
      have hS_t : S ∈ DickeSol.groverTargetSets n k := by
        rw [gh96ZoomK2_targetSets_eq]; exact hS
      rw [hcirc, ← gh96ZoomK2_oracle_eq]
      have hcorr :=
        DickeSol.ghZoomCert_correctness res hn hv.1 hv.2.1 hv.2.2.1 hv.2.2.2.1 hkN
          c.W c.rowSpec hv.2.2.2.2.1 hS_t
      dsimp only [gaussianHammingZoomK2GH96Qubits, DickeSol.Stage1.qubits] at hcorr ⊢
      exact hcorr

/-- Asymptotic uniform-average relative oracle query cost across all 8 `k = 2` cells. -/
theorem gaussianHammingZoomK2GH96_relCost {Var : Type} [DecidableEq Var] (res : Var)
    {m k : ℕ} (hcell : isGaussianHammingZoomK2GH96Cell m k = true) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, k ≤ 2 ^ n →
      ∃ q : Finset (Fin (2 ^ n)) → ℝ≥0,
        (∀ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k,
          CostBound (CostModel.ofEmbeddedOracle (GroverFindAll.parallelMarkingOracle m S))
            (QProg.qSet ;; (findAllGaussianHammingZoomK2GH96Circuit res n m k).compile QProg.qAssign
              (GroverFindAll.parallelMarkingOracle m S)) (q S)) ∧
        (∑ S ∈ (Finset.univ : Finset (Fin (2 ^ n))).powersetCard k, (q S : ℝ)) /
            ((Finset.univ : Finset (Fin (2 ^ n))).powersetCard k).card ≤
          ((relCostGaussianHammingZoomK2GH96 m k : ℚ≥0) : ℝ) *
            ((π / 4) * (∑ r ∈ Finset.Icc 1 k, 1 / √(r : ℝ)) * √((2 ^ n : ℝ) / m)) := by
  cases hlook : gh96ZoomK2Lookup m k with
  | none =>
      have his := gh96ZoomK2Lookup_isSome hcell
      rw [hlook] at his; cases his
  | some c =>
      have hv := gh96ZoomK2Lookup_props hlook
      have hgrid := DickeSol.Stage1.cells_mem_grid hv.1
      obtain ⟨n₀, hn₀⟩ := DickeSol.ghZoomCert_relCost (Var := Var) res hgrid.1 hgrid.2
        hv.2.1 hv.2.2.1 hv.2.2.2.1 c.W c.rowSpec hv.2.2.2.2.1 c.vSeq c.num c.den
        hv.2.2.2.2.2.1
      refine ⟨n₀, fun n hn hkN ↦ ?_⟩
      have hcirc : findAllGaussianHammingZoomK2GH96Circuit (Var := Var) res n m k =
          DickeSol.ghZoomCertCircuit res hgrid.1 hgrid.2 hv.2.1 hv.2.2.1 c.W c.rowSpec
            hv.2.2.2.2.1 n := by
        unfold findAllGaussianHammingZoomK2GH96Circuit
        split
        · next _ h => rw [hlook] at h; cases h; rfl
        · next h => rw [hlook] at h; cases h
      obtain ⟨q, hq, hsum⟩ := hn₀ n hn hkN
      refine ⟨q, fun S hS ↦ ?_, ?_⟩
      · rw [hcirc, ← gh96ZoomK2_oracle_eq]
        have hqS := hq S (by rw [gh96ZoomK2_targetSets_eq]; exact hS)
        dsimp only [gaussianHammingZoomK2GH96Qubits, DickeSol.Stage1.qubits] at hqS ⊢
        exact hqS
      · rw [← gh96ZoomK2_targetSets_eq, ← gh96ZoomK2_vanilla_eq, hv.2.2.2.2.2.2]
        exact hsum

end QuantumComputation.Specs.GroverFindAll.GaussianHammingZoomK2GH96

